+int On_TDLS_Dis_Req(_adapter *padapter, union recv_frame *precv_frame)
+{
+	struct rx_pkt_attrib	*prx_pkt_attrib =3D &precv_frame->u.hdr.attrib;
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+	struct sta_info *psta_ap;
+	u8 *ptr =3D precv_frame->u.hdr.rx_data;
+	sint parsing_length;	/* Frame body length, without icv_len */
+	PNDIS_802_11_VARIABLE_IEs	pIE;
+	u8 FIXED_IE =3D 3, *dst;
+	u16 j;
+	struct tdls_txmgmt txmgmt;
+	int ret =3D _SUCCESS;
+
+	if (rtw_tdls_is_driver_setup(padapter) =3D=3D false)
+		goto exit;
+
+	memset(&txmgmt, 0x00, sizeof(struct tdls_txmgmt));
+	ptr +=3D prx_pkt_attrib->hdrlen + prx_pkt_attrib->iv_len + LLC_HEADER_SIZ=
E + ETH_TYPE_LEN + PAYLOAD_TYPE_LEN;
+	txmgmt.dialog_token =3D *(ptr + 2);
+	memcpy(&txmgmt.peer, precv_frame->u.hdr.attrib.src, ETH_ALEN);
+	txmgmt.action_code =3D TDLS_DISCOVERY_RESPONSE;
+	parsing_length =3D ((union recv_frame *)precv_frame)->u.hdr.len
+			 - prx_pkt_attrib->hdrlen
+			 - prx_pkt_attrib->iv_len
+			 - prx_pkt_attrib->icv_len
+			 - LLC_HEADER_SIZE
+			 - ETH_TYPE_LEN
+			 - PAYLOAD_TYPE_LEN
+			 - FIXED_IE;
+
+	/* Parsing information element */
+	for (j =3D FIXED_IE; j < parsing_length;) {
+
+		pIE =3D (PNDIS_802_11_VARIABLE_IEs)(ptr + j);
+
+		switch (pIE->ElementID) {
+		case _LINK_ID_IE_:
+			psta_ap =3D rtw_get_stainfo(pstapriv, pIE->data);
+			if (psta_ap =3D=3D NULL)
+				goto exit;
+			dst =3D pIE->data + 12;
+			if (MacAddr_isBcst(dst) =3D=3D false && (!memcmp(adapter_mac_addr(padap=
ter), dst, 6) =3D=3D false))
+				goto exit;
+			break;
+		default:
+			break;
+		}
+
+		j +=3D (pIE->Length + 2);
+
+	}
+
+	issue_tdls_dis_rsp(padapter, &txmgmt, prx_pkt_attrib->privacy);
+
+exit:
+	return ret;
+
+}
