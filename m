+			   "public key: %d", (int) GetLastError());
+		os_free(tmp);
+		return -1;
+	}
+
+	*outlen =3D clen;
+
+	/* Reverse the output */
+	for (i =3D 0; i < *outlen; i++)
+		out[i] =3D tmp[*outlen - 1 - i];
