+u8 rtw_mp_cmd(_adapter *adapter, u8 mp_cmd_id, u8 flags)
+{
+	struct cmd_obj *cmdobj;
+	struct drvextra_cmd_parm *parm;
+	struct cmd_priv *pcmdpriv =3D &adapter->cmdpriv;
+	struct submit_ctx sctx;
+	u8 res =3D _SUCCESS;
+
+	parm =3D (struct drvextra_cmd_parm *)rtw_zmalloc(sizeof(struct drvextra_c=
md_parm));
+	if (!parm) {
+		res =3D _FAIL;
+		goto exit;
+	}
+
+	parm->ec_id =3D MP_CMD_WK_CID;
+	parm->type =3D mp_cmd_id;
+	parm->size =3D 0;
+	parm->pbuf =3D NULL;
+
+	if (flags & RTW_CMDF_DIRECTLY) {
+		/* no need to enqueue, do the cmd hdl directly and free cmd parameter */
+		if (rtw_mp_cmd_hdl(adapter, mp_cmd_id) !=3D H2C_SUCCESS)
+			res =3D _FAIL;
+		rtw_mfree((u8 *)parm, sizeof(*parm));
+	} else {
+		/* need enqueue, prepare cmd_obj and enqueue */
+		cmdobj =3D (struct cmd_obj *)rtw_zmalloc(sizeof(*cmdobj));
+		if (cmdobj =3D=3D NULL) {
+			res =3D _FAIL;
+			rtw_mfree((u8 *)parm, sizeof(*parm));
+			goto exit;
+		}
+
+		init_h2fwcmd_w_parm_no_rsp(cmdobj, parm, GEN_CMD_CODE(_Set_Drv_Extra));
+
+		if (flags & RTW_CMDF_WAIT_ACK) {
+			cmdobj->sctx =3D &sctx;
+			rtw_sctx_init(&sctx, 10 * 1000);
+		}
+
+		res =3D rtw_enqueue_cmd(pcmdpriv, cmdobj);
+
+		if (res =3D=3D _SUCCESS && (flags & RTW_CMDF_WAIT_ACK)) {
+			rtw_sctx_wait(&sctx, __func__);
+			_enter_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+			if (sctx.status =3D=3D RTW_SCTX_SUBMITTED)
+				cmdobj->sctx =3D NULL;
+			_exit_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+			if (sctx.status !=3D RTW_SCTX_DONE_SUCCESS)
+				res =3D _FAIL;
+		}
+	}
+
+exit:
+	return res;
+}
