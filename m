+void update_sta_info_apmode(_adapter *padapter, struct sta_info *psta)
+{
+	unsigned long	irqL;
+	struct mlme_priv *pmlmepriv =3D &(padapter->mlmepriv);
+	struct security_priv *psecuritypriv =3D &padapter->securitypriv;
+	struct mlme_ext_priv	*pmlmeext =3D &(padapter->mlmeextpriv);
+	struct ht_priv	*phtpriv_ap =3D &pmlmepriv->htpriv;
+	struct ht_priv	*phtpriv_sta =3D &psta->htpriv;
+	u8	cur_ldpc_cap =3D 0, cur_stbc_cap =3D 0, cur_beamform_cap =3D 0;
+	/* set intf_tag to if1 */
+	/* psta->intf_tag =3D 0; */
+
+	RTW_INFO("%s\n", __func__);
+
+	/*alloc macid when call rtw_alloc_stainfo(),release macid when call rtw_f=
ree_stainfo()*/
+
+	/* ap mode */
+	rtw_hal_set_odm_var(padapter, HAL_ODM_STA_INFO, psta, true);
+
+	if (psecuritypriv->dot11AuthAlgrthm =3D=3D dot11AuthAlgrthm_8021X)
+		psta->ieee8021x_blocked =3D true;
+	else
+		psta->ieee8021x_blocked =3D false;
+
+
+	/* update sta's cap */
+
+	/* ERP */
+	VCS_update(padapter, psta);
+	/* HT related cap */
+	if (phtpriv_sta->ht_option) {
+		/* check if sta supports rx ampdu */
+		phtpriv_sta->ampdu_enable =3D phtpriv_ap->ampdu_enable;
+
+		phtpriv_sta->rx_ampdu_min_spacing =3D (phtpriv_sta->ht_cap.ampdu_params_=
info & IEEE80211_HT_CAP_AMPDU_DENSITY) >> 2;
+
+		/* bwmode */
+		if ((phtpriv_sta->ht_cap.cap_info & phtpriv_ap->ht_cap.cap_info) & cpu_t=
o_le16(IEEE80211_HT_CAP_SUP_WIDTH))
+			psta->bw_mode =3D CHANNEL_WIDTH_40;
+		else
+			psta->bw_mode =3D CHANNEL_WIDTH_20;
+
+		if (psta->ht_40mhz_intolerant)
+			psta->bw_mode =3D CHANNEL_WIDTH_20;
+
+		if (pmlmeext->cur_bwmode < psta->bw_mode)
+			psta->bw_mode =3D pmlmeext->cur_bwmode;
+
+		phtpriv_sta->ch_offset =3D pmlmeext->cur_ch_offset;
+
+
+		/* check if sta support s Short GI 20M */
+		if ((phtpriv_sta->ht_cap.cap_info & phtpriv_ap->ht_cap.cap_info) & cpu_t=
o_le16(IEEE80211_HT_CAP_SGI_20))
+			phtpriv_sta->sgi_20m =3D true;
+
+		/* check if sta support s Short GI 40M */
+		if ((phtpriv_sta->ht_cap.cap_info & phtpriv_ap->ht_cap.cap_info) & cpu_t=
o_le16(IEEE80211_HT_CAP_SGI_40)) {
+			if (psta->bw_mode =3D=3D CHANNEL_WIDTH_40) /* according to psta->bw_mod=
e */
+				phtpriv_sta->sgi_40m =3D true;
+			else
+				phtpriv_sta->sgi_40m =3D false;
+		}
+
+		psta->qos_option =3D true;
+
+		/* B0 Config LDPC Coding Capability */
+		if (TEST_FLAG(phtpriv_ap->ldpc_cap, LDPC_HT_ENABLE_TX) &&
+		    GET_HT_CAP_ELE_LDPC_CAP((u8 *)(&phtpriv_sta->ht_cap))) {
+			SET_FLAG(cur_ldpc_cap, (LDPC_HT_ENABLE_TX | LDPC_HT_CAP_TX));
+			RTW_INFO("Enable HT Tx LDPC for STA(%d)\n", psta->aid);
+		}
+
+		/* B7 B8 B9 Config STBC setting */
+		if (TEST_FLAG(phtpriv_ap->stbc_cap, STBC_HT_ENABLE_TX) &&
+		    GET_HT_CAP_ELE_RX_STBC((u8 *)(&phtpriv_sta->ht_cap))) {
+			SET_FLAG(cur_stbc_cap, (STBC_HT_ENABLE_TX | STBC_HT_CAP_TX));
+			RTW_INFO("Enable HT Tx STBC for STA(%d)\n", psta->aid);
+		}
+
+#ifdef CONFIG_BEAMFORMING
+		/*Config Tx beamforming setting*/
+		if (TEST_FLAG(phtpriv_ap->beamform_cap, BEAMFORMING_HT_BEAMFORMEE_ENABLE=
) &&
+		    GET_HT_CAP_TXBF_EXPLICIT_COMP_STEERING_CAP((u8 *)(&phtpriv_sta->ht_c=
ap))) {
+			SET_FLAG(cur_beamform_cap, BEAMFORMING_HT_BEAMFORMER_ENABLE);
+			/*Shift to BEAMFORMING_HT_BEAMFORMEE_CHNL_EST_CAP*/
+			SET_FLAG(cur_beamform_cap, GET_HT_CAP_TXBF_CHNL_ESTIMATION_NUM_ANTENNAS=
((u8 *)(&phtpriv_sta->ht_cap)) << 6);
+		}
+
+		if (TEST_FLAG(phtpriv_ap->beamform_cap, BEAMFORMING_HT_BEAMFORMER_ENABLE=
) &&
+		    GET_HT_CAP_TXBF_EXPLICIT_COMP_FEEDBACK_CAP((u8 *)(&phtpriv_sta->ht_c=
ap))) {
+			SET_FLAG(cur_beamform_cap, BEAMFORMING_HT_BEAMFORMEE_ENABLE);
+			/*Shift to BEAMFORMING_HT_BEAMFORMER_STEER_NUM*/
+			SET_FLAG(cur_beamform_cap, GET_HT_CAP_TXBF_COMP_STEERING_NUM_ANTENNAS((=
u8 *)(&phtpriv_sta->ht_cap)) << 4);
+		}
+		if (cur_beamform_cap)
+			RTW_INFO("Client STA(%d) HT Beamforming Cap =3D 0x%02X\n", psta->aid, c=
ur_beamform_cap);
+#endif /*CONFIG_BEAMFORMING*/
+	} else {
+		phtpriv_sta->ampdu_enable =3D false;
+
+		phtpriv_sta->sgi_20m =3D false;
+		phtpriv_sta->sgi_40m =3D false;
+		psta->bw_mode =3D CHANNEL_WIDTH_20;
+		phtpriv_sta->ch_offset =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+	}
+
+	phtpriv_sta->ldpc_cap =3D cur_ldpc_cap;
+	phtpriv_sta->stbc_cap =3D cur_stbc_cap;
+	phtpriv_sta->beamform_cap =3D cur_beamform_cap;
+
+	/* Rx AMPDU */
+	send_delba(padapter, 0, psta->hwaddr);/* recipient */
+
+	/* TX AMPDU */
+	send_delba(padapter, 1, psta->hwaddr);/*  */ /* originator */
+	phtpriv_sta->agg_enable_bitmap =3D 0x0;/* reset */
+	phtpriv_sta->candidate_tid_bitmap =3D 0x0;/* reset */
+
+	update_ldpc_stbc_cap(psta);
+
+	/* todo: init other variables */
+
+	memset((void *)&psta->sta_stats, 0, sizeof(struct stainfo_stats));
+
+	_enter_critical_bh(&psta->lock, &irqL);
+	psta->state |=3D _FW_LINKED;
+	_exit_critical_bh(&psta->lock, &irqL);
+
+
+}
