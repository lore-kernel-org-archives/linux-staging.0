+static u8
+phydm_rate_to_num_ss(
+	struct PHY_DM_STRUCT		*p_dm_odm,
+	u8			data_rate
+)
+{
+	u8	num_ss =3D 1;
+
+	if (data_rate  <=3D ODM_RATE54M)
+		num_ss =3D 1;
+	else if (data_rate  <=3D ODM_RATEMCS31)
+		num_ss =3D ((data_rate  - ODM_RATEMCS0) >> 3) + 1;
+	else if (data_rate  <=3D ODM_RATEVHTSS1MCS9)
+		num_ss =3D 1;
+	else if (data_rate  <=3D ODM_RATEVHTSS2MCS9)
+		num_ss =3D 2;
+	else if (data_rate  <=3D ODM_RATEVHTSS3MCS9)
+		num_ss =3D 3;
+	else if (data_rate  <=3D ODM_RATEVHTSS4MCS9)
+		num_ss =3D 4;
+
+	return num_ss;
+}
