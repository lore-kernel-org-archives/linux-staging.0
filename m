+static void wpa_send_eapol_timeout(void *eloop_ctx, void *timeout_ctx)
+{
+	struct wpa_authenticator *wpa_auth =3D eloop_ctx;
+	struct wpa_state_machine *sm =3D timeout_ctx;
+
+	sm->pending_1_of_4_timeout =3D 0;
+	wpa_auth_logger(wpa_auth, sm->addr, LOGGER_DEBUG, "EAPOL-Key timeout");
+	sm->TimeoutEvt =3D TRUE;
+	wpa_sm_step(sm);
+}
