+		if (d =3D=3D NULL)
+			return -1;
+		d->next =3D reg->devices;
+		reg->devices =3D d;
+	}
+
+	wps_device_clone_data(&d->dev, dev);
+	os_memcpy(d->uuid, uuid, WPS_UUID_LEN);
+
+	return 0;
