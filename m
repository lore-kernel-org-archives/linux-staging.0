+void
+phydm_search_pwdb_lower_bound(
+	void		*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _ADAPTIVITY_STATISTICS	*adaptivity =3D (struct _ADAPTIVITY_STATIST=
ICS *)phydm_get_structure(p_dm_odm, PHYDM_ADAPTIVITY);
+	u32			value32 =3D 0, reg_value32 =3D 0;
+	u8			cnt, try_count =3D 0;
+	u8			tx_edcca1 =3D 0, tx_edcca0 =3D 0;
+	bool			is_adjust =3D true;
+	s8			th_l2h_dmc, th_h2l_dmc, igi_target =3D 0x32;
+	s8			diff;
+	u8			IGI =3D adaptivity->igi_base + 30 + (u8)p_dm_odm->th_l2h_ini - (u8)p=
_dm_odm->th_edcca_hl_diff;
+
+	if (p_dm_odm->support_ic_type & (ODM_RTL8723B | ODM_RTL8188E | ODM_RTL819=
2E | ODM_RTL8812 | ODM_RTL8821 | ODM_RTL8881A))
+		phydm_set_lna(p_dm_odm, phydm_disable_lna);
+	else {
+		phydm_set_trx_mux(p_dm_odm, phydm_standby_mode, phydm_standby_mode);
+		odm_pause_dig(p_dm_odm, PHYDM_PAUSE, PHYDM_PAUSE_LEVEL_0, 0x7e);
+	}
+
+	diff =3D igi_target - (s8)IGI;
+	th_l2h_dmc =3D p_dm_odm->th_l2h_ini + diff;
+	if (th_l2h_dmc > 10)
+		th_l2h_dmc =3D 10;
+	th_h2l_dmc =3D th_l2h_dmc - p_dm_odm->th_edcca_hl_diff;
+
+	phydm_set_edcca_threshold(p_dm_odm, th_h2l_dmc, th_l2h_dmc);
+	ODM_delay_ms(30);
+
+	while (is_adjust) {
+		if (p_dm_odm->support_ic_type & ODM_IC_11N_SERIES) {
+			odm_set_bb_reg(p_dm_odm, ODM_REG_DBG_RPT_11N, MASKDWORD, 0x0);
+			reg_value32 =3D odm_get_bb_reg(p_dm_odm, ODM_REG_RPT_11N, MASKDWORD);
+		} else if (p_dm_odm->support_ic_type & ODM_IC_11AC_SERIES) {
+			odm_set_bb_reg(p_dm_odm, ODM_REG_DBG_RPT_11AC, MASKDWORD, 0x0);
+			reg_value32 =3D odm_get_bb_reg(p_dm_odm, ODM_REG_RPT_11AC, MASKDWORD);
+		}
+		while (reg_value32 & BIT(3) && try_count < 3) {
+			try_count =3D try_count + 1;
+			ODM_delay_ms(3);
+			if (p_dm_odm->support_ic_type & ODM_IC_11N_SERIES)
+				reg_value32 =3D odm_get_bb_reg(p_dm_odm, ODM_REG_RPT_11N, MASKDWORD);
+			else if (p_dm_odm->support_ic_type & ODM_IC_11AC_SERIES)
+				reg_value32 =3D odm_get_bb_reg(p_dm_odm, ODM_REG_RPT_11AC, MASKDWORD);
+		}
+		try_count =3D 0;
+
+		for (cnt =3D 0; cnt < 20; cnt++) {
+			if (p_dm_odm->support_ic_type & ODM_IC_11N_SERIES) {
+				odm_set_bb_reg(p_dm_odm, ODM_REG_DBG_RPT_11N, MASKDWORD, 0x208);
+				value32 =3D odm_get_bb_reg(p_dm_odm, ODM_REG_RPT_11N, MASKDWORD);
+			} else if (p_dm_odm->support_ic_type & ODM_IC_11AC_SERIES) {
+				odm_set_bb_reg(p_dm_odm, ODM_REG_DBG_RPT_11AC, MASKDWORD, 0x209);
+				value32 =3D odm_get_bb_reg(p_dm_odm, ODM_REG_RPT_11AC, MASKDWORD);
+			}
+			if (value32 & BIT(30) && (p_dm_odm->support_ic_type & (ODM_RTL8723B | O=
DM_RTL8188E)))
+				tx_edcca1 =3D tx_edcca1 + 1;
+			else if (value32 & BIT(29))
+				tx_edcca1 =3D tx_edcca1 + 1;
+			else
+				tx_edcca0 =3D tx_edcca0 + 1;
+		}
+
+		if (tx_edcca1 > 1) {
+			IGI =3D IGI - 1;
+			th_l2h_dmc =3D th_l2h_dmc + 1;
+			if (th_l2h_dmc > 10)
+				th_l2h_dmc =3D 10;
+			th_h2l_dmc =3D th_l2h_dmc - p_dm_odm->th_edcca_hl_diff;
+
+			phydm_set_edcca_threshold(p_dm_odm, th_h2l_dmc, th_l2h_dmc);
+			if (th_l2h_dmc =3D=3D 10) {
+				is_adjust =3D false;
+				adaptivity->h2l_lb =3D th_h2l_dmc;
+				adaptivity->l2h_lb =3D th_l2h_dmc;
+				p_dm_odm->adaptivity_igi_upper =3D IGI;
+			}
+
+			tx_edcca1 =3D 0;
+			tx_edcca0 =3D 0;
+
+		} else {
+			is_adjust =3D false;
+			adaptivity->h2l_lb =3D th_h2l_dmc;
+			adaptivity->l2h_lb =3D th_l2h_dmc;
+			p_dm_odm->adaptivity_igi_upper =3D IGI;
+			tx_edcca1 =3D 0;
+			tx_edcca0 =3D 0;
+		}
+	}
+
+	p_dm_odm->adaptivity_igi_upper =3D p_dm_odm->adaptivity_igi_upper - p_dm_=
odm->dc_backoff;
+	adaptivity->h2l_lb =3D adaptivity->h2l_lb + p_dm_odm->dc_backoff;
+	adaptivity->l2h_lb =3D adaptivity->l2h_lb + p_dm_odm->dc_backoff;
+
+	if (p_dm_odm->support_ic_type & (ODM_RTL8723B | ODM_RTL8188E | ODM_RTL819=
2E | ODM_RTL8812 | ODM_RTL8821 | ODM_RTL8881A))
+		phydm_set_lna(p_dm_odm, phydm_enable_lna);
+	else {
+		phydm_set_trx_mux(p_dm_odm, phydm_tx_mode, phydm_rx_mode);
+		odm_pause_dig(p_dm_odm, PHYDM_RESUME, PHYDM_PAUSE_LEVEL_0, NONE);
+	}
+
+	phydm_set_edcca_threshold(p_dm_odm, 0x7f, 0x7f);				/*resume to no link s=
tate*/
+}
