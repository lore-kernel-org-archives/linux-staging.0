+	(cp)[6] =3D (value) >> 48;					\
+	(cp)[5] =3D (value) >> 40;					\
+	(cp)[4] =3D (value) >> 32;					\
+	(cp)[3] =3D (value) >> 24;					\
+	(cp)[2] =3D (value) >> 16;					\
+	(cp)[1] =3D (value) >> 8;						\
+	(cp)[0] =3D (value); } while (0)
+
