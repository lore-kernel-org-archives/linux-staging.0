+static int rtw_os_ndevs_alloc(struct dvobj_priv *dvobj)
+{
+	int i, status =3D _SUCCESS;
+	_adapter *adapter;
+
+#if defined(CONFIG_IOCTL_CFG80211)
+	if (rtw_cfg80211_dev_res_alloc(dvobj) !=3D _SUCCESS) {
+		rtw_warn_on(1);
+		status =3D _FAIL;
+		goto exit;
+	}
+#endif
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+
+		if (i >=3D CONFIG_IFACE_NUMBER) {
+			RTW_ERR("%s %d >=3D CONFIG_IFACE_NUMBER(%d)\n", __func__, i, CONFIG_IFA=
CE_NUMBER);
+			rtw_warn_on(1);
+			continue;
+		}
+
+		adapter =3D dvobj->padapters[i];
+		if (adapter && !adapter->pnetdev) {
+
+			#ifdef CONFIG_RTW_DYNAMIC_NDEV
+			if (!is_primary_adapter(adapter))
+				continue;
+			#endif
+
+			status =3D rtw_os_ndev_alloc(adapter);
+			if (status !=3D _SUCCESS) {
+				rtw_warn_on(1);
+				break;
+			}
+		}
+	}
+
+	if (status !=3D _SUCCESS) {
+		for (; i >=3D 0; i--) {
+			adapter =3D dvobj->padapters[i];
+			if (adapter && adapter->pnetdev)
+				rtw_os_ndev_free(adapter);
+		}
+	}
+
+#if defined(CONFIG_IOCTL_CFG80211)
+	if (status !=3D _SUCCESS)
+		rtw_cfg80211_dev_res_free(dvobj);
+#endif
+exit:
+	return status;
+}
+
+static void rtw_os_ndevs_free(struct dvobj_priv *dvobj)
+{
+	int i;
+	_adapter *adapter =3D NULL;
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+
+		if (i >=3D CONFIG_IFACE_NUMBER) {
+			RTW_ERR("%s %d >=3D CONFIG_IFACE_NUMBER(%d)\n", __func__, i, CONFIG_IFA=
CE_NUMBER);
+			rtw_warn_on(1);
+			continue;
+		}
+
+		adapter =3D dvobj->padapters[i];
+
+		if (adapter =3D=3D NULL)
+			continue;
+
+		rtw_os_ndev_free(adapter);
+	}
+
+#if defined(CONFIG_IOCTL_CFG80211)
+	rtw_cfg80211_dev_res_free(dvobj);
+#endif
+}
