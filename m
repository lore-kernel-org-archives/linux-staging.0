, 0x60);
+
+
+
+		p_dm_odm->rf_calibrate_info.tm_trigger =3D 1;
+		return;
+	} else {
+
+		odm_txpowertracking_callback_thermal_meter(adapter);
+		p_dm_odm->rf_calibrate_info.tm_trigger =3D 0;
+	}
