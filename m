+static u32
+phydm_trans_platform_wireless_mode(
+	void		*p_dm_void,
+	u32		wireless_mode
+)
+{
+	if (wireless_mode =3D=3D WIRELESS_11A)
+		wireless_mode =3D PHYDM_WIRELESS_MODE_A;
+
+	else if (wireless_mode =3D=3D WIRELESS_11B)
+		wireless_mode =3D PHYDM_WIRELESS_MODE_B;
+
+	else if ((wireless_mode =3D=3D WIRELESS_11G) || (wireless_mode =3D=3D WIR=
ELESS_11BG))
+		wireless_mode =3D PHYDM_WIRELESS_MODE_G;
+
+	else if (wireless_mode =3D=3D WIRELESS_AUTO)
+		wireless_mode =3D PHYDM_WIRELESS_MODE_AUTO;
+
+	else if ((wireless_mode =3D=3D WIRELESS_11_24N) ||
+		 (wireless_mode =3D=3D WIRELESS_11G_24N) ||
+		 (wireless_mode =3D=3D WIRELESS_11B_24N) ||
+		 (wireless_mode =3D=3D WIRELESS_11BG_24N) ||
+		 (wireless_mode =3D=3D WIRELESS_MODE_24G) ||
+		 (wireless_mode =3D=3D WIRELESS_11ABGN) ||
+		 (wireless_mode =3D=3D WIRELESS_11AGN))
+		wireless_mode =3D PHYDM_WIRELESS_MODE_N_24G;
+
+	else if ((wireless_mode =3D=3D WIRELESS_11_5N) || (wireless_mode =3D=3D W=
IRELESS_11A_5N))
+		wireless_mode =3D PHYDM_WIRELESS_MODE_N_5G;
+
+	else if ((wireless_mode =3D=3D WIRELESS_11AC) || (wireless_mode =3D=3D WI=
RELESS_11_5AC) || (wireless_mode =3D=3D WIRELESS_MODE_5G))
+		wireless_mode =3D PHYDM_WIRELESS_MODE_AC_5G;
+
+	else if (wireless_mode =3D=3D WIRELESS_11_24AC)
+		wireless_mode =3D PHYDM_WIRELESS_MODE_AC_24G;
+
+	else if (wireless_mode =3D=3D WIRELESS_11AC)
+		wireless_mode =3D PHYDM_WIRELESS_MODE_AC_ONLY;
+
+	else if (wireless_mode =3D=3D WIRELESS_MODE_MAX)
+		wireless_mode =3D PHYDM_WIRELESS_MODE_MAX;
+	else
+		wireless_mode =3D PHYDM_WIRELESS_MODE_UNKNOWN;
+
+	return wireless_mode;
+}
