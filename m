+/**
+ * radius_server_get_mib - Get RADIUS server MIB information
+ * @data: RADIUS server context from radius_server_init()
+ * @buf: Buffer for returning the MIB data in text format
+ * @buflen: buf length in octets
+ * Returns: Number of octets written into buf
+ */
+int radius_server_get_mib(struct radius_server_data *data, char *buf,
+			  size_t buflen)
+{
+	int ret, uptime;
+	unsigned int idx;
+	char *end, *pos;
+	struct os_time now;
+	struct radius_client *cli;
+
+	/* RFC 2619 - RADIUS Authentication Server MIB */
+
+	if (data =3D=3D NULL || buflen =3D=3D 0)
+		return 0;
+
+	pos =3D buf;
+	end =3D buf + buflen;
+
+	os_get_time(&now);
+	uptime =3D (now.sec - data->start_time.sec) * 100 +
+		((now.usec - data->start_time.usec) / 10000) % 100;
+	ret =3D os_snprintf(pos, end - pos,
+			  "RADIUS-AUTH-SERVER-MIB\n"
+			  "radiusAuthServIdent=3Dhostapd\n"
+			  "radiusAuthServUpTime=3D%d\n"
+			  "radiusAuthServResetTime=3D0\n"
+			  "radiusAuthServConfigReset=3D4\n",
+			  uptime);
+	if (ret < 0 || ret >=3D end - pos) {
+		*pos =3D '\0';
+		return pos - buf;
+	}
+	pos +=3D ret;
+
+	ret =3D os_snprintf(pos, end - pos,
+			  "radiusAuthServTotalAccessRequests=3D%u\n"
+			  "radiusAuthServTotalInvalidRequests=3D%u\n"
+			  "radiusAuthServTotalDupAccessRequests=3D%u\n"
+			  "radiusAuthServTotalAccessAccepts=3D%u\n"
+			  "radiusAuthServTotalAccessRejects=3D%u\n"
+			  "radiusAuthServTotalAccessChallenges=3D%u\n"
+			  "radiusAuthServTotalMalformedAccessRequests=3D%u\n"
+			  "radiusAuthServTotalBadAuthenticators=3D%u\n"
+			  "radiusAuthServTotalPacketsDropped=3D%u\n"
+			  "radiusAuthServTotalUnknownTypes=3D%u\n",
+			  data->counters.access_requests,
+			  data->counters.invalid_requests,
+			  data->counters.dup_access_requests,
+			  data->counters.access_accepts,
+			  data->counters.access_rejects,
+			  data->counters.access_challenges,
+			  data->counters.malformed_access_requests,
+			  data->counters.bad_authenticators,
+			  data->counters.packets_dropped,
+			  data->counters.unknown_types);
+	if (ret < 0 || ret >=3D end - pos) {
+		*pos =3D '\0';
+		return pos - buf;
+	}
+	pos +=3D ret;
+
+	for (cli =3D data->clients, idx =3D 0; cli; cli =3D cli->next, idx++) {
+		char abuf[50], mbuf[50];
+#ifdef CONFIG_IPV6
+		if (data->ipv6) {
+			if (inet_ntop(AF_INET6, &cli->addr6, abuf,
+				      sizeof(abuf)) =3D=3D NULL)
+				abuf[0] =3D '\0';
+			if (inet_ntop(AF_INET6, &cli->mask6, abuf,
+				      sizeof(mbuf)) =3D=3D NULL)
+				mbuf[0] =3D '\0';
+		}
+#endif /* CONFIG_IPV6 */
+		if (!data->ipv6) {
+			os_strlcpy(abuf, inet_ntoa(cli->addr), sizeof(abuf));
+			os_strlcpy(mbuf, inet_ntoa(cli->mask), sizeof(mbuf));
+		}
+
+		ret =3D os_snprintf(pos, end - pos,
+				  "radiusAuthClientIndex=3D%u\n"
+				  "radiusAuthClientAddress=3D%s/%s\n"
+				  "radiusAuthServAccessRequests=3D%u\n"
+				  "radiusAuthServDupAccessRequests=3D%u\n"
+				  "radiusAuthServAccessAccepts=3D%u\n"
+				  "radiusAuthServAccessRejects=3D%u\n"
+				  "radiusAuthServAccessChallenges=3D%u\n"
+				  "radiusAuthServMalformedAccessRequests=3D%u\n"
+				  "radiusAuthServBadAuthenticators=3D%u\n"
+				  "radiusAuthServPacketsDropped=3D%u\n"
+				  "radiusAuthServUnknownTypes=3D%u\n",
+				  idx,
+				  abuf, mbuf,
+				  cli->counters.access_requests,
+				  cli->counters.dup_access_requests,
+				  cli->counters.access_accepts,
+				  cli->counters.access_rejects,
+				  cli->counters.access_challenges,
+				  cli->counters.malformed_access_requests,
+				  cli->counters.bad_authenticators,
+				  cli->counters.packets_dropped,
+				  cli->counters.unknown_types);
+		if (ret < 0 || ret >=3D end - pos) {
+			*pos =3D '\0';
+			return pos - buf;
+		}
+		pos +=3D ret;
+	}
+
+	return pos - buf;
+}
