+/*
+ * !IMPORTANT!
+ *	Before call this function, caller should acquire "GLBtcBtMpOperLock"!
+ *	Othrewise there will be racing problem and something may go wrong.
+ */
+static u8 _btmpoper_cmd(PBTC_COEXIST pBtCoexist, u8 opcode, u8 opcodever, =
u8 *cmd, u8 size)
+{
+	PADAPTER padapter;
+	u8 buf[H2C_BTMP_OPER_LEN] =3D {0};
+	u8 buflen;
+	u8 seq;
+	u8 timer_cancelled;
+	s32 ret;
+
+
+	if (!cmd && size)
+		size =3D 0;
+	if ((size + 2) > H2C_BTMP_OPER_LEN)
+		return BT_STATUS_H2C_LENGTH_EXCEEDED;
+	buflen =3D size + 2;
+
+	seq =3D GLBtcBtMpOperSeq & 0xF;
+	GLBtcBtMpOperSeq++;
+
+	buf[0] =3D (opcodever & 0xF) | (seq << 4);
+	buf[1] =3D opcode;
+	if (cmd && size)
+		memcpy(buf + 2, cmd, size);
+
+	GLBtcBtMpRptWait =3D 1;
+	GLBtcBtMpRptWiFiOK =3D 0;
+	GLBtcBtMpRptBTOK =3D 0;
+	GLBtcBtMpRptStatus =3D 0;
+	padapter =3D pBtCoexist->Adapter;
+	_set_timer(&GLBtcBtMpOperTimer, BTC_MPOPER_TIMEOUT);
+	if (rtw_hal_fill_h2c_cmd(padapter, H2C_BT_MP_OPER, buflen, buf) =3D=3D _F=
AIL) {
+		_cancel_timer(&GLBtcBtMpOperTimer, &timer_cancelled);
+		ret =3D BT_STATUS_H2C_FAIL;
+		goto exit;
+	}
+
+	_rtw_down_sema(&GLBtcBtMpRptSema);
+	/* GLBtcBtMpRptWait should be 0 here*/
+
+	if (!GLBtcBtMpRptWiFiOK) {
+		RTW_ERR("%s: Didn't get H2C Rsp Event!\n", __func__);
+		ret =3D BT_STATUS_H2C_TIMTOUT;
+		goto exit;
+	}
+	if (!GLBtcBtMpRptBTOK) {
+		RTW_ERR("%s: Didn't get BT response!\n", __func__);
+		ret =3D BT_STATUS_H2C_BT_NO_RSP;
+		goto exit;
+	}
+	if (seq !=3D GLBtcBtMpRptSeq) {
+		RTW_ERR("%s: Sequence number not match!(%d!=3D%d)!\n",
+			 __func__, seq, GLBtcBtMpRptSeq);
+		ret =3D BT_STATUS_C2H_REQNUM_MISMATCH;
+		goto exit;
+	}
+
+	switch (GLBtcBtMpRptStatus) {
+	/* Examine the status reported from C2H */
+	case BT_STATUS_OK:
+		ret =3D BT_STATUS_BT_OP_SUCCESS;
+		RTW_DBG("%s: C2H status =3D BT_STATUS_BT_OP_SUCCESS\n", __func__);
+		break;
+	case BT_STATUS_VERSION_MISMATCH:
+		ret =3D BT_STATUS_OPCODE_L_VERSION_MISMATCH;
+		RTW_DBG("%s: C2H status =3D BT_STATUS_OPCODE_L_VERSION_MISMATCH\n", __fu=
nc__);
+		break;
+	case BT_STATUS_UNKNOWN_OPCODE:
+		ret =3D BT_STATUS_UNKNOWN_OPCODE_L;
+		RTW_DBG("%s: C2H status =3D MP_BT_STATUS_UNKNOWN_OPCODE_L\n", __func__);
+		break;
+	case BT_STATUS_ERROR_PARAMETER:
+		ret =3D BT_STATUS_PARAMETER_FORMAT_ERROR_L;
+		RTW_DBG("%s: C2H status =3D MP_BT_STATUS_PARAMETER_FORMAT_ERROR_L\n", __=
func__);
+		break;
+	default:
+		ret =3D BT_STATUS_UNKNOWN_STATUS_L;
+		RTW_DBG("%s: C2H status =3D MP_BT_STATUS_UNKNOWN_STATUS_L\n", __func__);
+		break;
+	}
+
+exit:
+	return ret;
+}
