+u8
+phydm_rate_id_mapping(
+	void			*p_dm_void,
+	u32			wireless_mode,
+	u8			rf_type,
+	u8			bw
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u8			rate_id_idx =3D 0;
+	u8			phydm_BW;
+	u8			phydm_rf_type;
+
+	phydm_BW =3D phydm_trans_platform_bw(p_dm_odm, bw);
+	phydm_rf_type =3D phydm_trans_platform_rf_type(p_dm_odm, rf_type);
+	wireless_mode =3D phydm_trans_platform_wireless_mode(p_dm_odm, wireless_m=
ode);
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("wireless_mode=3D=
 (( 0x%x )), rf_type =3D (( 0x%x )), BW =3D (( 0x%x ))\n",
+			wireless_mode, phydm_rf_type, phydm_BW));
+
+
+	switch (wireless_mode) {
+
+	case PHYDM_WIRELESS_MODE_N_24G:
+	{
+
+		if (phydm_BW =3D=3D PHYDM_BW_40) {
+
+			if (phydm_rf_type =3D=3D PHYDM_RF_1T1R)
+				rate_id_idx =3D PHYDM_BGN_40M_1SS;
+			else if (phydm_rf_type =3D=3D PHYDM_RF_2T2R)
+				rate_id_idx =3D PHYDM_BGN_40M_2SS;
+			else
+				rate_id_idx =3D PHYDM_ARFR5_N_3SS;
+
+		} else {
+
+			if (phydm_rf_type =3D=3D PHYDM_RF_1T1R)
+				rate_id_idx =3D PHYDM_BGN_20M_1SS;
+			else if (phydm_rf_type =3D=3D PHYDM_RF_2T2R)
+				rate_id_idx =3D PHYDM_BGN_20M_2SS;
+			else
+				rate_id_idx =3D PHYDM_ARFR5_N_3SS;
+		}
+	}
+	break;
+
+	case PHYDM_WIRELESS_MODE_N_5G:
+	{
+		if (phydm_rf_type =3D=3D PHYDM_RF_1T1R)
+			rate_id_idx =3D PHYDM_GN_N1SS;
+		else if (phydm_rf_type =3D=3D PHYDM_RF_2T2R)
+			rate_id_idx =3D PHYDM_GN_N2SS;
+		else
+			rate_id_idx =3D PHYDM_ARFR5_N_3SS;
+	}
+
+	break;
+
+	case PHYDM_WIRELESS_MODE_G:
+		rate_id_idx =3D PHYDM_BG;
+		break;
+
+	case PHYDM_WIRELESS_MODE_A:
+		rate_id_idx =3D PHYDM_G;
+		break;
+
+	case PHYDM_WIRELESS_MODE_B:
+		rate_id_idx =3D PHYDM_B_20M;
+		break;
+
+
+	case PHYDM_WIRELESS_MODE_AC_5G:
+	case PHYDM_WIRELESS_MODE_AC_ONLY:
+	{
+		if (phydm_rf_type =3D=3D PHYDM_RF_1T1R)
+			rate_id_idx =3D PHYDM_ARFR1_AC_1SS;
+		else if (phydm_rf_type =3D=3D PHYDM_RF_2T2R)
+			rate_id_idx =3D PHYDM_ARFR0_AC_2SS;
+		else
+			rate_id_idx =3D PHYDM_ARFR4_AC_3SS;
+	}
+	break;
+
+	case PHYDM_WIRELESS_MODE_AC_24G:
+	{
+		/*Becareful to set "Lowest rate" while using PHYDM_ARFR4_AC_3SS in 2.4G/=
5G*/
+		if (phydm_BW >=3D PHYDM_BW_80) {
+			if (phydm_rf_type =3D=3D PHYDM_RF_1T1R)
+				rate_id_idx =3D PHYDM_ARFR1_AC_1SS;
+			else if (phydm_rf_type =3D=3D PHYDM_RF_2T2R)
+				rate_id_idx =3D PHYDM_ARFR0_AC_2SS;
+			else
+				rate_id_idx =3D PHYDM_ARFR4_AC_3SS;
+		} else {
+
+			if (phydm_rf_type =3D=3D PHYDM_RF_1T1R)
+				rate_id_idx =3D PHYDM_ARFR2_AC_2G_1SS;
+			else if (phydm_rf_type =3D=3D PHYDM_RF_2T2R)
+				rate_id_idx =3D PHYDM_ARFR3_AC_2G_2SS;
+			else
+				rate_id_idx =3D PHYDM_ARFR4_AC_3SS;
+		}
+	}
+	break;
+
+	default:
+		rate_id_idx =3D 0;
+		break;
+	}
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("RA rate ID =3D (=
( 0x%x ))\n", rate_id_idx));
+
+	return rate_id_idx;
+}
