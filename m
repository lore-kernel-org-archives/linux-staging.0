+static void ieee802_1x_learn_identity(struct hostapd_data *hapd,
+				      struct eapol_state_machine *sm,
+				      const u8 *eap, size_t len)
+{
+	const u8 *identity;
+	size_t identity_len;
+
+	if (len <=3D sizeof(struct eap_hdr) ||
+	    eap[sizeof(struct eap_hdr)] !=3D EAP_TYPE_IDENTITY)
+		return;
+
+	identity =3D eap_get_identity(sm->eap, &identity_len);
+	if (identity =3D=3D NULL)
+		return;
+
+	/* Save station identity for future RADIUS packets */
+	os_free(sm->identity);
+	sm->identity =3D os_malloc(identity_len + 1);
+	if (sm->identity =3D=3D NULL) {
+		sm->identity_len =3D 0;
+		return;
+	}
+
+	os_memcpy(sm->identity, identity, identity_len);
+	sm->identity_len =3D identity_len;
+	sm->identity[identity_len] =3D '\0';
+	hostapd_logger(hapd, sm->addr, HOSTAPD_MODULE_IEEE8021X,
+		       HOSTAPD_LEVEL_DEBUG, "STA identity '%s'", sm->identity);
+	sm->dot1xAuthEapolRespIdFramesRx++;
+}
