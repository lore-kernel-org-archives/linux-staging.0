+u32 LDPC_parameter_generator(
+	u32 N_pld_int,
+	u32 N_CBPSS,
+	u32 N_SS,
+	u32 R,
+	u32 m_STBC,
+	u32 N_TCB_int
+)
+{
+	double	CR =3D 0.;
+	double	N_pld =3D (double)N_pld_int;
+	double	N_TCB =3D (double)N_TCB_int;
+	double	N_CW =3D 0., N_shrt =3D 0., N_spcw =3D 0., N_fshrt =3D 0.;
+	double	L_LDPC =3D 0., K_LDPC =3D 0., L_LDPC_info =3D 0.;
+	double	N_punc =3D 0., N_ppcw =3D 0., N_fpunc =3D 0., N_rep =3D 0., N_rpcw=
 =3D 0., N_frep =3D 0.;
+	double	R_eff =3D 0.;
+	u32	VHTSIGA2B3  =3D 0;/* extra symbol from VHT-SIG-A2 Bit 3*/
+
+	if (R =3D=3D 0)
+		CR	=3D 0.5;
+	else if (R =3D=3D 1)
+		CR =3D 2. / 3.;
+	else if (R =3D=3D 2)
+		CR =3D 3. / 4.;
+	else if (R =3D=3D 3)
+		CR =3D 5. / 6.;
+
+	if (N_TCB <=3D 648.) {
+		N_CW	=3D 1.;
+		if (N_TCB >=3D N_pld + 912.*(1. - CR))
+			L_LDPC	=3D 1296.;
+		else
+			L_LDPC	=3D 648.;
+	} else if (N_TCB <=3D 1296.) {
+		N_CW	=3D 1.;
+		if (N_TCB >=3D (double)N_pld + 1464.*(1. - CR))
+			L_LDPC	=3D 1944.;
+		else
+			L_LDPC	=3D 1296.;
+	} else if	(N_TCB <=3D 1944.) {
+		N_CW	=3D 1.;
+		L_LDPC	=3D 1944.;
+	} else if (N_TCB <=3D 2592.) {
+		N_CW	=3D 2.;
+		if (N_TCB >=3D N_pld + 2916.*(1. - CR))
+			L_LDPC	=3D 1944.;
+		else
+			L_LDPC	=3D 1296.;
+	} else {
+		N_CW =3D ceil(N_pld / 1944. / CR);
+		L_LDPC	=3D 1944.;
+	}
+	/*	Number of information bits per CW*/
+	K_LDPC =3D L_LDPC * CR;
+	/*	Number of shortening bits					max(0, (N_CW * L_LDPC * R) - N_pld)*/
+	N_shrt =3D (N_CW * K_LDPC - N_pld) > 0. ? (N_CW * K_LDPC - N_pld) : 0.;
+	/*	Number of shortening bits per CW			N_spcw =3D rtfloor(N_shrt/N_CW)*/
+	N_spcw =3D rtfloor(N_shrt / N_CW);
+	/*	The first N_fshrt CWs shorten 1 bit more*/
+	N_fshrt =3D (double)((int)N_shrt % (int)N_CW);
+	/*	Number of data bits for the last N_CW-N_fshrt CWs*/
+	L_LDPC_info =3D K_LDPC - N_spcw;
+	/*	Number of puncturing bits*/
+	N_punc =3D (N_CW * L_LDPC - N_TCB - N_shrt) > 0. ? (N_CW * L_LDPC - N_TCB=
 - N_shrt) : 0.;
+	if (((N_punc > .1 * N_CW * L_LDPC * (1. - CR)) && (N_shrt < 1.2 * N_punc =
* CR / (1. - CR))) ||
+	    (N_punc > 0.3 * N_CW * L_LDPC * (1. - CR))) {
+		/*cout << "*** N_TCB and N_punc are Recomputed ***" << endl;*/
+		VHTSIGA2B3 =3D 1;
+		N_TCB +=3D (double)N_CBPSS * N_SS * m_STBC;
+		N_punc =3D (N_CW * L_LDPC - N_TCB - N_shrt) > 0. ? (N_CW * L_LDPC - N_TC=
B - N_shrt) : 0.;
+	} else
+		VHTSIGA2B3 =3D 0;
+
+	return VHTSIGA2B3;
+}	/* function end of LDPC_parameter_generator */
