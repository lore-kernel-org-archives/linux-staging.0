+
+/* reverse an array, used for radix code */
+static void bn_reverse (unsigned char *s, int len)
+{
+  int     ix, iy;
+  unsigned char t;
+
+  ix =3D 0;
+  iy =3D len - 1;
+  while (ix < iy) {
+    t     =3D s[ix];
+    s[ix] =3D s[iy];
+    s[iy] =3D t;
+    ++ix;
+    --iy;
+  }
+}
+
+
+/* low level addition, based on HAC pp.594, Algorithm 14.7 */
+static int s_mp_add (mp_int * a, mp_int * b, mp_int * c)
+{
+  mp_int *x;
+  int     olduse, res, min, max;
+
+  /* find sizes, we let |a| <=3D |b| which means we have to sort
+   * them.  "x" will point to the input with the most digits
+   */
+  if (a->used > b->used) {
+    min =3D b->used;
+    max =3D a->used;
+    x =3D a;
+  } else {
+    min =3D a->used;
+    max =3D b->used;
+    x =3D b;
+  }
+
+  /* init result */
+  if (c->alloc < max + 1) {
+    if ((res =3D mp_grow (c, max + 1)) !=3D MP_OKAY) {
+      return res;
+    }
+  }
+
+  /* get old used digit count and set new one */
+  olduse =3D c->used;
+  c->used =3D max + 1;
+
+  {
+    register mp_digit u, *tmpa, *tmpb, *tmpc;
+    register int i;
+
+    /* alias for digit pointers */
+
+    /* first input */
+    tmpa =3D a->dp;
+
+    /* second input */
+    tmpb =3D b->dp;
+
+    /* destination */
+    tmpc =3D c->dp;
+
+    /* zero the carry */
+    u =3D 0;
+    for (i =3D 0; i < min; i++) {
+      /* Compute the sum at one digit, T[i] =3D A[i] + B[i] + U */
+      *tmpc =3D *tmpa++ + *tmpb++ + u;
+
+      /* U =3D carry bit of T[i] */
+      u =3D *tmpc >> ((mp_digit)DIGIT_BIT);
+
+      /* take away carry bit from T[i] */
+      *tmpc++ &=3D MP_MASK;
+    }
+
+    /* now copy higher words if any, that is in A+B=20
+     * if A or B has more digits add those in=20
+     */
+    if (min !=3D max) {
+      for (; i < max; i++) {
+        /* T[i] =3D X[i] + U */
+        *tmpc =3D x->dp[i] + u;
+
+        /* U =3D carry bit of T[i] */
+        u =3D *tmpc >> ((mp_digit)DIGIT_BIT);
+
+        /* take away carry bit from T[i] */
+        *tmpc++ &=3D MP_MASK;
+      }
+    }
+
+    /* add carry */
+    *tmpc++ =3D u;
+
+    /* clear digits above oldused */
+    for (i =3D c->used; i < olduse; i++) {
+      *tmpc++ =3D 0;
+    }
+  }
+
+  mp_clamp (c);
+  return MP_OKAY;
+}
+
+
+/* low level subtraction (assumes |a| > |b|), HAC pp.595 Algorithm 14.9 */
+static int s_mp_sub (mp_int * a, mp_int * b, mp_int * c)
+{
+  int     olduse, res, min, max;
+
+  /* find sizes */
+  min =3D b->used;
+  max =3D a->used;
+
+  /* init result */
+  if (c->alloc < max) {
+    if ((res =3D mp_grow (c, max)) !=3D MP_OKAY) {
+      return res;
+    }
+  }
+  olduse =3D c->used;
+  c->used =3D max;
+
+  {
+    register mp_digit u, *tmpa, *tmpb, *tmpc;
+    register int i;
+
+    /* alias for digit pointers */
+    tmpa =3D a->dp;
+    tmpb =3D b->dp;
+    tmpc =3D c->dp;
+
+    /* set carry to zero */
+    u =3D 0;
+    for (i =3D 0; i < min; i++) {
+      /* T[i] =3D A[i] - B[i] - U */
+      *tmpc =3D *tmpa++ - *tmpb++ - u;
+
+      /* U =3D carry bit of T[i]
+       * Note this saves performing an AND operation since
+       * if a carry does occur it will propagate all the way to the
+       * MSB.  As a result a single shift is enough to get the carry
+       */
+      u =3D *tmpc >> ((mp_digit)(CHAR_BIT * sizeof (mp_digit) - 1));
+
+      /* Clear carry from T[i] */
+      *tmpc++ &=3D MP_MASK;
+    }
+
+    /* now copy higher words if any, e.g. if A has more digits than B  */
+    for (; i < max; i++) {
+      /* T[i] =3D A[i] - U */
+      *tmpc =3D *tmpa++ - u;
+
+      /* U =3D carry bit of T[i] */
+      u =3D *tmpc >> ((mp_digit)(CHAR_BIT * sizeof (mp_digit) - 1));
+
+      /* Clear carry from T[i] */
+      *tmpc++ &=3D MP_MASK;
+    }
+
+    /* clear digits above used (since we may not have grown result above) =
*/
+    for (i =3D c->used; i < olduse; i++) {
+      *tmpc++ =3D 0;
+    }
+  }
+
+  mp_clamp (c);
+  return MP_OKAY;
+}
+
+
+/* init a new mp_int */
+static int mp_init (mp_int * a)
+{
+  int i;
+
+  /* allocate memory required and clear it */
+  a->dp =3D OPT_CAST(mp_digit) XMALLOC (sizeof (mp_digit) * MP_PREC);
+  if (a->dp =3D=3D NULL) {
+    return MP_MEM;
+  }
+
+  /* set the digits to zero */
+  for (i =3D 0; i < MP_PREC; i++) {
+      a->dp[i] =3D 0;
+  }
+
+  /* set the used to zero, allocated digits to the default precision
+   * and sign to positive */
+  a->used  =3D 0;
+  a->alloc =3D MP_PREC;
+  a->sign  =3D MP_ZPOS;
+
+  return MP_OKAY;
+}
+
+
+/* clear one (frees)  */
+static void mp_clear (mp_int * a)
+{
+  int i;
+
+  /* only do anything if a hasn't been freed previously */
+  if (a->dp !=3D NULL) {
+    /* first zero the digits */
+    for (i =3D 0; i < a->used; i++) {
+        a->dp[i] =3D 0;
+    }
+
+    /* free ram */
+    XFREE(a->dp);
+
+    /* reset members to make debugging easier */
+    a->dp    =3D NULL;
+    a->alloc =3D a->used =3D 0;
+    a->sign  =3D MP_ZPOS;
+  }
+}
+
+
+/* high level addition (handles signs) */
+static int mp_add (mp_int * a, mp_int * b, mp_int * c)
+{
+  int     sa, sb, res;
+
+  /* get sign of both inputs */
+  sa =3D a->sign;
+  sb =3D b->sign;
+
+  /* handle two cases, not four */
+  if (sa =3D=3D sb) {
+    /* both positive or both negative */
+    /* add their magnitudes, copy the sign */
+    c->sign =3D sa;
+    res =3D s_mp_add (a, b, c);
+  } else {
+    /* one positive, the other negative */
+    /* subtract the one with the greater magnitude from */
+    /* the one of the lesser magnitude.  The result gets */
+    /* the sign of the one with the greater magnitude. */
+    if (mp_cmp_mag (a, b) =3D=3D MP_LT) {
+      c->sign =3D sb;
+      res =3D s_mp_sub (b, a, c);
+    } else {
+      c->sign =3D sa;
+      res =3D s_mp_sub (a, b, c);
+    }
+  }
+  return res;
+}
+
