+u8 rtw_efuse_file_read(PADAPTER padapter, u8 *filepatch, u8 *buf, u32 len)
+{
+	char *ptmpbuf =3D NULL, *ptr;
+	u8 val8;
+	u32 count, i, j;
+	int err;
+	u32 bufsize =3D 4096;
+
+	ptmpbuf =3D rtw_zmalloc(bufsize);
+	if (ptmpbuf =3D=3D NULL)
+		return false;
+
+	count =3D rtw_retrieve_from_file(filepatch, ptmpbuf, bufsize);
+	if (count <=3D 100) {
+		rtw_mfree(ptmpbuf, bufsize);
+		RTW_ERR("%s, filepatch %s, size=3D%d, FAIL!!\n", __func__, filepatch, co=
unt);
+		return false;
+	}
+
+	i =3D 0;
+	j =3D 0;
+	ptr =3D ptmpbuf;
+	while ((j < len) && (i < count)) {
+		if (ptmpbuf[i] =3D=3D '\0')
+			break;
+=09
+		ptr =3D strpbrk(&ptmpbuf[i], " \t\n\r");
+		if (ptr) {
+			if (ptr =3D=3D &ptmpbuf[i]) {
+				i++;
+				continue;
+			}
+
+			/* Add string terminating null */
+			*ptr =3D 0;
+		} else {
+			ptr =3D &ptmpbuf[count-1];
+		}
+
+		err =3D sscanf(&ptmpbuf[i], "%hhx", &val8);
+		if (err !=3D 1) {
+			RTW_WARN("Something wrong to parse efuse file, string=3D%s\n", &ptmpbuf=
[i]);
+		} else {
+			buf[j] =3D val8;
+			RTW_DBG("i=3D%d, j=3D%d, 0x%02x\n", i, j, buf[j]);
+			j++;
+		}
+
+		i =3D ptr - ptmpbuf + 1;
+	}
+
+	rtw_mfree(ptmpbuf, bufsize);
+	RTW_INFO("%s, filepatch %s, size=3D%d, done\n", __func__, filepatch, coun=
t);
+	return true;
+}
