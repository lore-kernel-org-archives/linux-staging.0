+s32 rtw_tdls_do_ch_sw(_adapter *padapter, struct sta_info *ptdls_sta, u8 c=
hnl_type, u8 channel, u8 channel_offset, u16 bwmode, u16 ch_switch_time)
+{
+	HAL_DATA_TYPE *pHalData =3D GET_HAL_DATA(padapter);
+	u8 center_ch, chnl_offset80 =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+	u32 ch_sw_time_start, ch_sw_time_spent, wait_time;
+	u8 take_care_iqk;
+	s32 ret =3D _FAIL;
+
+	ch_sw_time_start =3D rtw_systime_to_ms(jiffies);
+
+	rtw_tdls_chsw_oper_init(padapter, TDLS_CH_SWITCH_OPER_OFFLOAD_TIMEOUT);
+
+	/* set mac_id sleep before channel switch */
+	rtw_hal_macid_sleep(padapter, ptdls_sta->mac_id);
+
+	/* channel switch IOs offload to FW */
+	if (rtw_hal_ch_sw_oper_offload(padapter, channel, channel_offset, bwmode)=
 =3D=3D _SUCCESS) {
+		if (rtw_tdls_chsw_oper_wait(padapter) =3D=3D _SUCCESS) {
+			/* set channel and bw related variables in driver */
+			_enter_critical_mutex(&(adapter_to_dvobj(padapter)->setch_mutex), NULL);
+
+			rtw_set_oper_ch(padapter, channel);
+			rtw_set_oper_choffset(padapter, channel_offset);
+			rtw_set_oper_bw(padapter, bwmode);
+
+			center_ch =3D rtw_get_center_ch(channel, bwmode, channel_offset);
+			pHalData->current_channel =3D center_ch;
+			pHalData->CurrentCenterFrequencyIndex1 =3D center_ch;
+			pHalData->current_channel_bw =3D bwmode;
+			pHalData->nCur40MhzPrimeSC =3D channel_offset;
+
+			if (bwmode =3D=3D CHANNEL_WIDTH_80) {
+				if (center_ch > channel)
+					chnl_offset80 =3D HAL_PRIME_CHNL_OFFSET_LOWER;
+				else if (center_ch < channel)
+					chnl_offset80 =3D HAL_PRIME_CHNL_OFFSET_UPPER;
+				else
+					chnl_offset80 =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+			}
+			pHalData->nCur80MhzPrimeSC =3D chnl_offset80;
+
+			pHalData->CurrentCenterFrequencyIndex1 =3D center_ch;
+
+			_exit_critical_mutex(&(adapter_to_dvobj(padapter)->setch_mutex), NULL);
+
+			rtw_hal_get_hwreg(padapter, HW_VAR_CH_SW_NEED_TO_TAKE_CARE_IQK_INFO, &t=
ake_care_iqk);
+			if (take_care_iqk =3D=3D true)
+				rtw_hal_ch_sw_iqk_info_restore(padapter, CH_SW_USE_CASE_TDLS);
+
+			ch_sw_time_spent =3D rtw_systime_to_ms(jiffies) - ch_sw_time_start;
+
+			if (chnl_type =3D=3D TDLS_CH_SW_OFF_CHNL) {
+				if ((u32)ch_switch_time / 1000 > ch_sw_time_spent)
+					wait_time =3D (u32)ch_switch_time / 1000 - ch_sw_time_spent;
+				else
+					wait_time =3D 0;
+
+				if (wait_time > 0)
+					rtw_msleep_os(wait_time);
+			}
+
+			ret =3D _SUCCESS;
+		} else
+			RTW_INFO("[TDLS] chsw oper wait fail !!\n");
+	}
+
+	/* set mac_id wakeup after channel switch */
+	rtw_hal_macid_wakeup(padapter, ptdls_sta->mac_id);
+
+	return ret;
+}
