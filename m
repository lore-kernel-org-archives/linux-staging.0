MUX_CFG) & ~(BIT3));
+		val8 =3D rtw_read8(pAdapter, REG_GPIO_IO_SEL);
+		RTW_INFO("GPIO_IN=3D%02x\n", val8);
+		rfpowerstate =3D (val8 & BIT3) ? rf_on : rf_off;
+	}
+	return rfpowerstate;
