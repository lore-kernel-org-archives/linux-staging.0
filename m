+static void eap_ttls_phase2_select_eap_method(struct eap_ttls_data *data,
+					      u8 method)
+{
+	size_t i;
+	for (i =3D 0; i < data->num_phase2_eap_types; i++) {
+		if (data->phase2_eap_types[i].vendor !=3D EAP_VENDOR_IETF ||
+		    data->phase2_eap_types[i].method !=3D method)
+			continue;
+
+		data->phase2_eap_type.vendor =3D
+			data->phase2_eap_types[i].vendor;
+		data->phase2_eap_type.method =3D
+			data->phase2_eap_types[i].method;
+		wpa_printf(MSG_DEBUG, "EAP-TTLS: Selected "
+			   "Phase 2 EAP vendor %d method %d",
+			   data->phase2_eap_type.vendor,
+			   data->phase2_eap_type.method);
+		break;
+	}
+}
