+static int eap_fast_phase2_request(struct eap_sm *sm,
+				   struct eap_fast_data *data,
+				   struct eap_method_ret *ret,
+				   struct eap_hdr *hdr,
+				   struct wpabuf **resp)
+{
+	size_t len =3D be_to_host16(hdr->length);
+	u8 *pos;
+	struct eap_method_ret iret;
+	struct eap_peer_config *config =3D eap_get_config(sm);
+	struct wpabuf msg;
+
+	if (len <=3D sizeof(struct eap_hdr)) {
+		wpa_printf(MSG_INFO, "EAP-FAST: too short "
+			   "Phase 2 request (len=3D%lu)", (unsigned long) len);
+		return -1;
+	}
+	pos =3D (u8 *) (hdr + 1);
+	wpa_printf(MSG_DEBUG, "EAP-FAST: Phase 2 Request: type=3D%d", *pos);
+	if (*pos =3D=3D EAP_TYPE_IDENTITY) {
+		*resp =3D eap_sm_buildIdentity(sm, hdr->identifier, 1);
+		return 0;
+	}
+
+	if (data->phase2_priv && data->phase2_method &&
+	    *pos !=3D data->phase2_type.method) {
+		wpa_printf(MSG_DEBUG, "EAP-FAST: Phase 2 EAP sequence - "
+			   "deinitialize previous method");
+		data->phase2_method->deinit(sm, data->phase2_priv);
+		data->phase2_method =3D NULL;
+		data->phase2_priv =3D NULL;
+		data->phase2_type.vendor =3D EAP_VENDOR_IETF;
+		data->phase2_type.method =3D EAP_TYPE_NONE;
+	}
+
+	if (data->phase2_type.vendor =3D=3D EAP_VENDOR_IETF &&
+	    data->phase2_type.method =3D=3D EAP_TYPE_NONE &&
+	    eap_fast_select_phase2_method(data, *pos) < 0) {
+		if (eap_peer_tls_phase2_nak(data->phase2_types,
+					    data->num_phase2_types,
+					    hdr, resp))
+			return -1;
+		return 0;
+	}
+
+	if (data->phase2_priv =3D=3D NULL &&
+	    eap_fast_init_phase2_method(sm, data) < 0) {
+		wpa_printf(MSG_INFO, "EAP-FAST: Failed to initialize "
+			   "Phase 2 EAP method %d", *pos);
+		ret->methodState =3D METHOD_DONE;
+		ret->decision =3D DECISION_FAIL;
+		return -1;
+	}
+
+	os_memset(&iret, 0, sizeof(iret));
+	wpabuf_set(&msg, hdr, len);
+	*resp =3D data->phase2_method->process(sm, data->phase2_priv, &iret,
+					     &msg);
+	if (*resp =3D=3D NULL ||
+	    (iret.methodState =3D=3D METHOD_DONE &&
+	     iret.decision =3D=3D DECISION_FAIL)) {
+		ret->methodState =3D METHOD_DONE;
+		ret->decision =3D DECISION_FAIL;
+	} else if ((iret.methodState =3D=3D METHOD_DONE ||
+		    iret.methodState =3D=3D METHOD_MAY_CONT) &&
+		   (iret.decision =3D=3D DECISION_UNCOND_SUCC ||
+		    iret.decision =3D=3D DECISION_COND_SUCC)) {
+		data->phase2_success =3D 1;
+	}
+
+	if (*resp =3D=3D NULL && config &&
+	    (config->pending_req_identity || config->pending_req_password ||
+	     config->pending_req_otp || config->pending_req_new_password)) {
+		wpabuf_free(data->pending_phase2_req);
+		data->pending_phase2_req =3D wpabuf_alloc_copy(hdr, len);
+	} else if (*resp =3D=3D NULL)
+		return -1;
+
+	return 0;
+}
