+	l2->pcap =3D pcap_open_live(l2->ifname, 2500, 0, 10, pcap_err);
+	if (l2->pcap =3D=3D NULL) {
+		fprintf(stderr, "pcap_open_live: %s\n", pcap_err);
+		fprintf(stderr, "ifname=3D'%s'\n", l2->ifname);
+		return -1;
+	}
+	if (pcap_datalink(l2->pcap) !=3D DLT_EN10MB &&
+	    pcap_set_datalink(l2->pcap, DLT_EN10MB) < 0) {
+		fprintf(stderr, "pcap_set_datalink(DLT_EN10MB): %s\n",
+			pcap_geterr(l2->pcap));
+		return -1;
+	}
