+void
+phydm_process_rssi_for_dm_new_type(
+	struct PHY_DM_STRUCT					*p_dm_odm,
+	struct _odm_phy_status_info_			*p_phy_info,
+	struct _odm_per_pkt_info_			*p_pktinfo
+)
+{
+	s32				undecorated_smoothed_pwdb, accumulate_pwdb;
+	u32				rssi_ave;
+	u8				i;
+	struct sta_info			*p_entry;
+	u8				scaling_factor =3D 4;
+
+	if (p_pktinfo->station_id >=3D ODM_ASSOCIATE_ENTRY_NUM)
+		return;
+
+	p_entry =3D p_dm_odm->p_odm_sta_info[p_pktinfo->station_id];
+
+	if (!IS_STA_VALID(p_entry))
+		return;
+
+	if ((!p_pktinfo->is_packet_match_bssid))/*data frame only*/
+		return;
+
+	if (p_pktinfo->is_packet_beacon)
+		p_dm_odm->phy_dbg_info.num_qry_beacon_pkt++;
+
+#if (defined(CONFIG_PHYDM_ANTENNA_DIVERSITY))
+	if (p_dm_odm->support_ability & ODM_BB_ANT_DIV)
+		odm_process_rssi_for_ant_div(p_dm_odm, p_phy_info, p_pktinfo);
+#endif
+
+#if (CONFIG_DYNAMIC_RX_PATH =3D=3D 1)
+	phydm_process_phy_status_for_dynamic_rx_path(p_dm_odm, p_phy_info, p_pkti=
nfo);
+	dbg_print("=3D=3D=3D=3D>\n");
+#endif
+
+	if (p_pktinfo->is_packet_to_self || p_pktinfo->is_packet_beacon) {
+		u32 RSSI_linear =3D 0;
+
+		p_dm_odm->rx_rate =3D p_pktinfo->data_rate;
+		undecorated_smoothed_pwdb =3D p_entry->rssi_stat.undecorated_smoothed_pw=
db;
+		accumulate_pwdb =3D p_dm_odm->accumulate_pwdb[p_pktinfo->station_id];
+		p_dm_odm->RSSI_A =3D p_phy_info->rx_mimo_signal_strength[ODM_RF_PATH_A];
+		p_dm_odm->RSSI_B =3D p_phy_info->rx_mimo_signal_strength[ODM_RF_PATH_B];
+		p_dm_odm->RSSI_C =3D p_phy_info->rx_mimo_signal_strength[ODM_RF_PATH_C];
+		p_dm_odm->RSSI_D =3D p_phy_info->rx_mimo_signal_strength[ODM_RF_PATH_D];
+
+		for (i =3D ODM_RF_PATH_A; i < ODM_RF_PATH_MAX_JAGUAR; i++) {
+			if (p_phy_info->rx_mimo_signal_strength[i] !=3D 0)
+				RSSI_linear +=3D odm_convert_to_linear(p_phy_info->rx_mimo_signal_stre=
ngth[i]);
+		}
+
+		switch (p_phy_info->rx_count + 1) {
+		case 2:
+			RSSI_linear =3D (RSSI_linear >> 1);
+			break;
+		case 3:
+			RSSI_linear =3D ((RSSI_linear) + (RSSI_linear << 1) + (RSSI_linear << 3=
)) >> 5;	/* RSSI_linear/3 ~ RSSI_linear*11/32 */
+			break;
+		case 4:
+			RSSI_linear =3D (RSSI_linear >> 2);
+			break;
+		}
+		rssi_ave =3D odm_convert_to_db(RSSI_linear);
+
+		if (undecorated_smoothed_pwdb <=3D 0) {
+			accumulate_pwdb =3D (p_phy_info->rx_pwdb_all << scaling_factor);
+			undecorated_smoothed_pwdb =3D p_phy_info->rx_pwdb_all;
+		} else {
+			accumulate_pwdb =3D accumulate_pwdb - (accumulate_pwdb >> scaling_facto=
r) + rssi_ave;
+			undecorated_smoothed_pwdb =3D (accumulate_pwdb + (1 << (scaling_factor =
- 1))) >> scaling_factor;
+		}
+
+		if (p_entry->rssi_stat.undecorated_smoothed_pwdb =3D=3D -1)
+			phydm_ra_rssi_rpt_wk(p_dm_odm);
+		p_entry->rssi_stat.undecorated_smoothed_pwdb =3D undecorated_smoothed_pw=
db;
+		p_dm_odm->accumulate_pwdb[p_pktinfo->station_id] =3D accumulate_pwdb;
+	}
+}
