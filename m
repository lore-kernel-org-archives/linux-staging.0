+		pframe =3D rtw_set_ie(pframe, EID_BSSCoexistence,  1, &iedata, &(pattrib=
->pktlen));
+
+	}
+
+
+	/*  */
+	memset(ICS, 0, sizeof(ICS));
+	if (pmlmepriv->num_sta_no_ht > 0) {
+		int i;
+
+		_enter_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+
+		phead =3D get_list_head(queue);
+		plist =3D get_next(phead);
+
+		while (1) {
+			int len;
+			u8 *p;
+			WLAN_BSSID_EX *pbss_network;
+
+			if (rtw_end_of_queue_search(phead, plist))
+				break;
+
+			pnetwork =3D LIST_CONTAINOR(plist, struct wlan_network, list);
+
+			plist =3D get_next(plist);
+
+			pbss_network =3D (WLAN_BSSID_EX *)&pnetwork->network;
+
+			p =3D rtw_get_ie(pbss_network->IEs + _FIXED_IE_LENGTH_, _HT_CAPABILITY_=
IE_, &len, pbss_network->IELength - _FIXED_IE_LENGTH_);
+			if ((p =3D=3D NULL) || (len =3D=3D 0)) { /* non-HT */
+				if ((pbss_network->Configuration.DSConfig <=3D 0) || (pbss_network->Co=
nfiguration.DSConfig > 14))
+					continue;
+
+				ICS[0][pbss_network->Configuration.DSConfig] =3D 1;
+
+				if (ICS[0][0] =3D=3D 0)
+					ICS[0][0] =3D 1;
+			}
+
+		}
+
+		_exit_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+
+
+		for (i =3D 0; i < 8; i++) {
+			if (ICS[i][0] =3D=3D 1) {
+				int j, k =3D 0;
+
+				InfoContent[k] =3D i;
+				/* SET_BSS_INTOLERANT_ELE_REG_CLASS(InfoContent,i); */
+				k++;
+
+				for (j =3D 1; j <=3D 14; j++) {
+					if (ICS[i][j] =3D=3D 1) {
+						if (k < 16) {
+							InfoContent[k] =3D j; /* channel number */
+							/* SET_BSS_INTOLERANT_ELE_CHANNEL(InfoContent+k, j); */
+							k++;
+						}
+					}
+				}
+
+				pframe =3D rtw_set_ie(pframe, EID_BSSIntolerantChlReport, k, InfoConte=
nt, &(pattrib->pktlen));
+
+			}
+
+		}
+
+
+	}
+
+
+	pattrib->last_txcmdsz =3D pattrib->pktlen;
+
+	dump_mgntframe(padapter, pmgntframe);
+}
