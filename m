+static Boolean eap_pwd_check(struct eap_sm *sm, void *priv,
+			     struct wpabuf *respData)
+{
+	struct eap_pwd_data *data =3D priv;
+	const u8 *pos;
+	size_t len;
+
+	pos =3D eap_hdr_validate(EAP_VENDOR_IETF, EAP_TYPE_PWD, respData, &len);
+	if (pos =3D=3D NULL || len < 1) {
+		wpa_printf(MSG_INFO, "EAP-pwd: Invalid frame");
+		return TRUE;
+	}
+
+	wpa_printf(MSG_DEBUG, "EAP-pwd: Received frame: opcode=3D%d", *pos);
+
+	if (data->state =3D=3D PWD_ID_Req && *pos =3D=3D EAP_PWD_OPCODE_ID_EXCH)
+		return FALSE;
+
+	if (data->state =3D=3D PWD_Commit_Req &&
+	    *pos =3D=3D EAP_PWD_OPCODE_COMMIT_EXCH)
+		return FALSE;
+
+	if (data->state =3D=3D PWD_Confirm_Req &&
+	    *pos =3D=3D EAP_PWD_OPCODE_CONFIRM_EXCH)
+		return FALSE;
+
+	wpa_printf(MSG_INFO, "EAP-pwd: Unexpected opcode=3D%d in state=3D%d",
+		   *pos, data->state);
+
+	return TRUE;
+}
