+int fips186_2_prf(const u8 *seed, size_t seed_len, u8 *x, size_t xlen)
+{
+	u8 xkey[64];
+	u32 t[5], _t[5];
+	int i, j, m, k;
+	u8 *xpos =3D x;
+	u32 carry;
+
+	if (seed_len > sizeof(xkey))
+		seed_len =3D sizeof(xkey);
+
+	/* FIPS 186-2 + change notice 1 */
+
+	os_memcpy(xkey, seed, seed_len);
+	os_memset(xkey + seed_len, 0, 64 - seed_len);
+	t[0] =3D 0x67452301;
+	t[1] =3D 0xEFCDAB89;
+	t[2] =3D 0x98BADCFE;
+	t[3] =3D 0x10325476;
+	t[4] =3D 0xC3D2E1F0;
+
+	m =3D xlen / 40;
+	for (j =3D 0; j < m; j++) {
+		/* XSEED_j =3D 0 */
+		for (i =3D 0; i < 2; i++) {
+			/* XVAL =3D (XKEY + XSEED_j) mod 2^b */
+
+			/* w_i =3D G(t, XVAL) */
+			os_memcpy(_t, t, 20);
+			SHA1Transform(_t, xkey);
+			_t[0] =3D host_to_be32(_t[0]);
+			_t[1] =3D host_to_be32(_t[1]);
+			_t[2] =3D host_to_be32(_t[2]);
+			_t[3] =3D host_to_be32(_t[3]);
+			_t[4] =3D host_to_be32(_t[4]);
+			os_memcpy(xpos, _t, 20);
+
+			/* XKEY =3D (1 + XKEY + w_i) mod 2^b */
+			carry =3D 1;
+			for (k =3D 19; k >=3D 0; k--) {
+				carry +=3D xkey[k] + xpos[k];
+				xkey[k] =3D carry & 0xff;
+				carry >>=3D 8;
+			}
+
+			xpos +=3D SHA1_MAC_LEN;
+		}
+		/* x_j =3D w_0|w_1 */
+	}
+
+	return 0;
+}
