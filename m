+int rtw_mp_ctx(struct net_device *dev,
+	       struct iw_request_info *info,
+	       struct iw_point *wrqu, char *extra)
+{
+	u32 pkTx =3D 1;
+	int countPkTx =3D 1, cotuTx =3D 1, CarrSprTx =3D 1, scTx =3D 1, sgleTx =
=3D 1, stop =3D 1;
+	u32 bStartTest =3D 1;
+	u32 count =3D 0, pktinterval =3D 0, pktlen =3D 0;
+	u8 status;
+	struct mp_priv *pmp_priv;
+	struct pkt_attrib *pattrib;
+	PADAPTER padapter =3D rtw_netdev_priv(dev);
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(padapter);
+
+	pmp_priv =3D &padapter->mppriv;
+	pattrib =3D &pmp_priv->tx.attrib;
+
+	if (copy_from_user(extra, wrqu->pointer, wrqu->length))
+		return -EFAULT;
+
+	RTW_INFO("%s: in=3D%s\n", __func__, extra);
+#ifdef CONFIG_CONCURRENT_MODE
+	if (!is_primary_adapter(padapter)) {
+		sprintf(extra, "Error: MP mode can't support Virtual Adapter, Please to =
use main Adapter.\n");
+		wrqu->length =3D strlen(extra);
+		return 0;
+	}
+#endif
+	countPkTx =3D strncmp(extra, "count=3D", 5); /* strncmp true is 0*/
+	cotuTx =3D strncmp(extra, "background", 20);
+	CarrSprTx =3D strncmp(extra, "background,cs", 20);
+	scTx =3D strncmp(extra, "background,sc", 20);
+	sgleTx =3D strncmp(extra, "background,stone", 20);
+	pkTx =3D strncmp(extra, "background,pkt", 20);
+	stop =3D strncmp(extra, "stop", 4);
+	if (sscanf(extra, "count=3D%d,pkt", &count) > 0)
+		RTW_INFO("count=3D %d\n", count);
+	if (sscanf(extra, "pktinterval=3D%d", &pktinterval) > 0)
+		RTW_INFO("pktinterval=3D %d\n", pktinterval);
+
+	if (sscanf(extra, "pktlen=3D%d", &pktlen) > 0)
+		RTW_INFO("pktlen=3D %d\n", pktlen);
+
+	if (!memcmp(extra, "destmac=3D", 8)) {
+		wrqu->length -=3D 8;
+		rtw_set_ctx_destAddr(dev, info, wrqu, &extra[8]);
+		sprintf(extra, "Set dest mac OK !\n");
+		return 0;
+	}
+
+	/*RTW_INFO("%s: count=3D%d countPkTx=3D%d cotuTx=3D%d CarrSprTx=3D%d scTx=
=3D%d sgleTx=3D%d pkTx=3D%d stop=3D%d\n", __func__, count, countPkTx, cotuT=
x, CarrSprTx, pkTx, sgleTx, scTx, stop);*/
+	memset(extra, '\0', strlen(extra));
+
+	if (pktinterval !=3D 0) {
+		sprintf(extra, "Pkt Interval =3D %d", pktinterval);
+		padapter->mppriv.pktInterval =3D pktinterval;
+		wrqu->length =3D strlen(extra);
+		return 0;
+	}
+	if (pktlen !=3D 0) {
+		sprintf(extra, "Pkt len =3D %d", pktlen);
+		pattrib->pktlen =3D pktlen;
+		wrqu->length =3D strlen(extra);
+		return 0;
+	}
+	if (stop =3D=3D 0) {
+		bStartTest =3D 0; /* To set Stop*/
+		pmp_priv->tx.stop =3D 1;
+		sprintf(extra, "Stop continuous Tx");
+		odm_write_dig(&pHalData->odmpriv, 0x20);
+	} else {
+		bStartTest =3D 1;
+		odm_write_dig(&pHalData->odmpriv, 0x7f);
+		if (pmp_priv->mode !=3D MP_ON) {
+			if (pmp_priv->tx.stop !=3D 1) {
+				RTW_INFO("%s: MP_MODE !=3D ON %d\n", __func__, pmp_priv->mode);
+				return	-EFAULT;
+			}
+		}
+	}
+
+	pmp_priv->tx.count =3D count;
+
+	if (pkTx =3D=3D 0 || countPkTx =3D=3D 0)
+		pmp_priv->mode =3D MP_PACKET_TX;
+	if (sgleTx =3D=3D 0)
+		pmp_priv->mode =3D MP_SINGLE_TONE_TX;
+	if (cotuTx =3D=3D 0)
+		pmp_priv->mode =3D MP_CONTINUOUS_TX;
+	if (CarrSprTx =3D=3D 0)
+		pmp_priv->mode =3D MP_CARRIER_SUPPRISSION_TX;
+	if (scTx =3D=3D 0)
+		pmp_priv->mode =3D MP_SINGLE_CARRIER_TX;
+
+	status =3D rtw_mp_pretx_proc(padapter, bStartTest, extra);
+
+	wrqu->length =3D strlen(extra);
+	return status;
+}
