+wpa_driver_privsep_get_scan_results2(void *priv)
+{
+	struct wpa_driver_privsep_data *drv =3D priv;
+	int res, num;
+	u8 *buf, *pos, *end;
+	size_t reply_len =3D 60000;
+	struct wpa_scan_results *results;
+	struct wpa_scan_res *r;
+
+	buf =3D os_malloc(reply_len);
+	if (buf =3D=3D NULL)
+		return NULL;
+	res =3D wpa_priv_cmd(drv, PRIVSEP_CMD_GET_SCAN_RESULTS,
+			   NULL, 0, buf, &reply_len);
+	if (res < 0) {
+		os_free(buf);
+		return NULL;
+	}
+
+	wpa_printf(MSG_DEBUG, "privsep: Received %lu bytes of scan results",
+		   (unsigned long) reply_len);
+	if (reply_len < sizeof(int)) {
+		wpa_printf(MSG_DEBUG, "privsep: Invalid scan result len %lu",
+			   (unsigned long) reply_len);
+		os_free(buf);
+		return NULL;
+	}
+
+	pos =3D buf;
+	end =3D buf + reply_len;
+	os_memcpy(&num, pos, sizeof(int));
+	if (num < 0 || num > 1000) {
+		os_free(buf);
+		return NULL;
+	}
+	pos +=3D sizeof(int);
+
+	results =3D os_zalloc(sizeof(*results));
+	if (results =3D=3D NULL) {
+		os_free(buf);
+		return NULL;
+	}
+
+	results->res =3D os_zalloc(num * sizeof(struct wpa_scan_res *));
+	if (results->res =3D=3D NULL) {
+		os_free(results);
+		os_free(buf);
+		return NULL;
+	}
+
+	while (results->num < (size_t) num && pos + sizeof(int) < end) {
+		int len;
+		os_memcpy(&len, pos, sizeof(int));
+		pos +=3D sizeof(int);
+		if (len < 0 || len > 10000 || pos + len > end)
+			break;
+
+		r =3D os_malloc(len);
+		if (r =3D=3D NULL)
+			break;
+		os_memcpy(r, pos, len);
+		pos +=3D len;
+		if (sizeof(*r) + r->ie_len > (size_t) len) {
+			os_free(r);
+			break;
+		}
+
+		results->res[results->num++] =3D r;
+	}
+
+	os_free(buf);
+	return results;
+}
