+#if (RA_MASK_PHYDMLIZE_CE || RA_MASK_PHYDMLIZE_AP || RA_MASK_PHYDMLIZE_WIN)
+
+bool
+odm_ra_state_check(
+	void			*p_dm_void,
+	s32			RSSI,
+	bool			is_force_update,
+	u8			*p_ra_tr_state
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _ODM_RATE_ADAPTIVE *p_ra =3D &p_dm_odm->rate_adaptive;
+	const u8 go_up_gap =3D 5;
+	u8 high_rssi_thresh_for_ra =3D p_ra->high_rssi_thresh;
+	u8 low_rssi_thresh_for_ra =3D p_ra->low_rssi_thresh;
+	u8 ratr_state;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("RSSI=3D (( %d ))=
, Current_RSSI_level =3D (( %d ))\n", RSSI, *p_ra_tr_state));
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("[Ori RA RSSI Thr=
esh]  High=3D (( %d )), Low =3D (( %d ))\n", high_rssi_thresh_for_ra, low_r=
ssi_thresh_for_ra));
+	/* threshold Adjustment:*/
+	/* when RSSI state trends to go up one or two levels, make sure RSSI is h=
igh enough.*/
+	/* Here go_up_gap is added to solve the boundary's level alternation issu=
e.*/
+	switch (*p_ra_tr_state) {
+	case DM_RATR_STA_INIT:
+	case DM_RATR_STA_HIGH:
+		break;
+	case DM_RATR_STA_MIDDLE:
+		high_rssi_thresh_for_ra +=3D go_up_gap;
+		break;
+	case DM_RATR_STA_LOW:
+		high_rssi_thresh_for_ra +=3D go_up_gap;
+		low_rssi_thresh_for_ra +=3D go_up_gap;
+		break;
+	default:
+		ODM_RT_ASSERT(p_dm_odm, false, ("wrong rssi level setting %d !", *p_ra_t=
r_state));
+		break;
+	}
+
+	/* Decide ratr_state by RSSI.*/
+	if (RSSI > high_rssi_thresh_for_ra)
+		ratr_state =3D DM_RATR_STA_HIGH;
+	else if (RSSI > low_rssi_thresh_for_ra)
+		ratr_state =3D DM_RATR_STA_MIDDLE;
+
+	else
+		ratr_state =3D DM_RATR_STA_LOW;
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("[Mod RA RSSI Thr=
esh]  High=3D (( %d )), Low =3D (( %d ))\n", high_rssi_thresh_for_ra, low_r=
ssi_thresh_for_ra));
+	if (*p_ra_tr_state !=3D ratr_state || is_force_update) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("[RSSI Level Upd=
ate] %d->%d\n", *p_ra_tr_state, ratr_state));
+		*p_ra_tr_state =3D ratr_state;
+		return true;
+	}
+
+	return false;
+}
