+static int
+atheros_wireless_event_init(struct atheros_driver_data *drv)
+{
+	struct netlink_config *cfg;
+
+	atheros_get_we_version(drv);
+
+	cfg =3D os_zalloc(sizeof(*cfg));
+	if (cfg =3D=3D NULL)
+		return -1;
+	cfg->ctx =3D drv;
+	cfg->newlink_cb =3D atheros_wireless_event_rtm_newlink;
+	drv->netlink =3D netlink_init(cfg);
+	if (drv->netlink =3D=3D NULL) {
+		os_free(cfg);
+		return -1;
+	}
+
+	return 0;
+}
