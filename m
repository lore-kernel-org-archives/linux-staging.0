+static s8 _phy_get_txpwr_lmt(
+	PADAPTER			Adapter,
+	u32					RegPwrTblSel,
+	BAND_TYPE			Band,
+	CHANNEL_WIDTH		Bandwidth,
+	u8					RfPath,
+	u8					DataRate,
+	u8					Channel,
+	bool no_sc
+)
+{
+	struct dvobj_priv *dvobj =3D adapter_to_dvobj(Adapter);
+	HAL_DATA_TYPE *hal_data =3D GET_HAL_DATA(Adapter);
+	s8 regulation =3D -1, bw =3D -1, rs =3D -1;
+	u8 cch =3D 0;
+	u8 bw_bmp =3D 0;
+	s8 min_lmt =3D MAX_POWER_INDEX;
+	s8 tmp_lmt;
+	u8 final_bw =3D Bandwidth, final_cch =3D Channel;
+
+	if ((Adapter->registrypriv.RegEnableTxPowerLimit =3D=3D 2 && hal_data->EE=
PROMRegulatory !=3D 1) ||
+		Adapter->registrypriv.RegEnableTxPowerLimit =3D=3D 0)
+		goto exit;
+
+	switch (RegPwrTblSel) {
+	case 1:
+		regulation =3D TXPWR_LMT_ETSI;
+		break;
+	case 2:
+		regulation =3D TXPWR_LMT_MKK;
+		break;
+	case 3:
+		regulation =3D TXPWR_LMT_FCC;
+		break;
+	case 4:
+		regulation =3D TXPWR_LMT_WW;
+		break;
+	default:
+		regulation =3D (Band =3D=3D BAND_ON_2_4G) ? hal_data->Regulation2_4G : h=
al_data->Regulation5G;
+		break;
+	}
+
+	if (Band !=3D BAND_ON_2_4G && Band !=3D BAND_ON_5G) {
+		RTW_ERR("%s invalid band:%u\n", __func__, Band);
+		rtw_warn_on(1);
+		goto exit;
+	}
+
+	if (IS_CCK_RATE(DataRate))
+		rs =3D CCK;
+	else if (IS_OFDM_RATE(DataRate))
+		rs =3D OFDM;
+	else if (IS_HT1SS_RATE(DataRate))
+		rs =3D HT_1SS;
+	else if (IS_HT2SS_RATE(DataRate))
+		rs =3D HT_2SS;
+	else if (IS_HT3SS_RATE(DataRate))
+		rs =3D HT_3SS;
+	else if (IS_HT4SS_RATE(DataRate))
+		rs =3D HT_4SS;
+	else if (IS_VHT1SS_RATE(DataRate))
+		rs =3D VHT_1SS;
+	else if (IS_VHT2SS_RATE(DataRate))
+		rs =3D VHT_2SS;
+	else if (IS_VHT3SS_RATE(DataRate))
+		rs =3D VHT_3SS;
+	else if (IS_VHT4SS_RATE(DataRate))
+		rs =3D VHT_4SS;
+	else {
+		RTW_ERR("%s invalid rate 0x%x\n", __func__, DataRate);
+		rtw_warn_on(1);
+		goto exit;
+	}
+
+	if (Band =3D=3D BAND_ON_5G  && rs =3D=3D CCK) {
+		RTW_ERR("Wrong rate No CCK(0x%x) in 5G Band\n", DataRate);
+		goto exit;
+	}
+
+	if (no_sc =3D=3D true) {
+		/* use the input center channel and bandwidth directly */
+		cch =3D Channel;
+		bw_bmp =3D ch_width_to_bw_cap(Bandwidth);
+	} else {
+		/*
+		* find the possible tx bandwidth bmp for this rate, and then will get ce=
nter channel for each bandwidth
+		* if no possible tx bandwidth bmp, select valid bandwidth up to current =
RF bandwidth into bmp
+		*/
+		if (rs =3D=3D CCK || rs =3D=3D OFDM)
+			bw_bmp =3D BW_CAP_20M; /* CCK, OFDM only BW 20M */
+		else if (IS_HT_RATE_SECTION(rs)) {
+			bw_bmp =3D rtw_get_tx_bw_bmp_of_ht_rate(dvobj, DataRate, Bandwidth);
+			if (bw_bmp =3D=3D 0)
+				bw_bmp =3D ch_width_to_bw_cap(Bandwidth > CHANNEL_WIDTH_40 ? CHANNEL_W=
IDTH_40 : Bandwidth);
+		} else if (IS_VHT_RATE_SECTION(rs)) {
+			bw_bmp =3D rtw_get_tx_bw_bmp_of_vht_rate(dvobj, DataRate, Bandwidth);
+			if (bw_bmp =3D=3D 0)
+				bw_bmp =3D ch_width_to_bw_cap(Bandwidth > CHANNEL_WIDTH_160 ? CHANNEL_=
WIDTH_160 : Bandwidth);
+		} else
+			rtw_warn_on(1);
+	}
+
+	if (bw_bmp =3D=3D 0)
+		goto exit;
+
+	/* loop for each possible tx bandwidth to find minimum limit */
+	for (bw =3D CHANNEL_WIDTH_20; bw <=3D Bandwidth; bw++) {
+		s8 ch_idx;
+
+		if (!(ch_width_to_bw_cap(bw) & bw_bmp))
+			continue;
+
+		if (no_sc =3D=3D false) {
+			if (bw =3D=3D CHANNEL_WIDTH_20)
+				cch =3D hal_data->cch_20;
+			else if (bw =3D=3D CHANNEL_WIDTH_40)
+				cch =3D hal_data->cch_40;
+			else if (bw =3D=3D CHANNEL_WIDTH_80)
+				cch =3D hal_data->cch_80;
+			else {
+				cch =3D 0;
+				rtw_warn_on(1);
+			}
+		}
+
+		ch_idx =3D phy_GetChannelIndexOfTxPowerLimit(Band, cch);
+		if (ch_idx =3D=3D -1)
+			continue;
+
+		if (Band =3D=3D BAND_ON_2_4G) {
+			s8 limits[MAX_REGULATION_NUM] =3D {0};
+			u8 i =3D 0;
+
+			for (i =3D 0; i < MAX_REGULATION_NUM; ++i)
+				limits[i] =3D hal_data->TxPwrLimit_2_4G[i][bw][rs][ch_idx][RfPath];
+
+			tmp_lmt =3D (regulation =3D=3D TXPWR_LMT_WW) ? phy_GetWorldWideLimit(li=
mits) :
+				hal_data->TxPwrLimit_2_4G[regulation][bw][rs][ch_idx][RfPath];
+
+		} else if (Band =3D=3D BAND_ON_5G) {
+			s8 limits[MAX_REGULATION_NUM] =3D {0};
+			u8 i =3D 0;
+
+			for (i =3D 0; i < MAX_REGULATION_NUM; ++i)
+				limits[i] =3D hal_data->TxPwrLimit_5G[i][bw][rs][ch_idx][RfPath];
+
+			tmp_lmt =3D (regulation =3D=3D TXPWR_LMT_WW) ? phy_GetWorldWideLimit(li=
mits) :
+				hal_data->TxPwrLimit_5G[regulation][bw][rs][ch_idx][RfPath];
+		} else
+			continue;
+
+		if (min_lmt >=3D tmp_lmt) {
+			min_lmt =3D tmp_lmt;
+			final_cch =3D cch;
+			final_bw =3D bw;
+		}
+	}
+
+exit:
+	return min_lmt;
+}
