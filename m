+static int route_dump(u32 *gw_addr , int *gw_index)
+{
+	int err =3D 0;
+	struct socket *sock;
+	struct {
+		struct nlmsghdr nlh;
+		struct rtgenmsg g;
+	} req;
+	struct msghdr msg;
+	struct iovec iov;
+	struct sockaddr_nl nladdr;
+	mm_segment_t oldfs;
+	char *pg;
+	int size =3D 0;
+
+	err =3D sock_create(AF_NETLINK, SOCK_DGRAM, NETLINK_ROUTE, &sock);
+	if (err) {
+		printk(": Could not create a datagram socket, error =3D %d\n", -ENXIO);
+		return err;
+	}
+
+	memset(&nladdr, 0, sizeof(nladdr));
+	nladdr.nl_family =3D AF_NETLINK;
+
+	req.nlh.nlmsg_len =3D sizeof(req);
+	req.nlh.nlmsg_type =3D RTM_GETROUTE;
+	req.nlh.nlmsg_flags =3D NLM_F_ROOT | NLM_F_MATCH | NLM_F_REQUEST;
+	req.nlh.nlmsg_pid =3D 0;
+	req.g.rtgen_family =3D AF_INET;
+
+	iov.iov_base =3D &req;
+	iov.iov_len =3D sizeof(req);
+
+	msg.msg_name =3D &nladdr;
+	msg.msg_namelen =3D sizeof(nladdr);
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(3, 19, 0))
+	/* referece:sock_xmit in kernel code
+	 * WRITE for sock_sendmsg, READ for sock_recvmsg
+	 * third parameter for msg_iovlen
+	 * last parameter for iov_len
+	 */
+	iov_iter_init(&msg.msg_iter, WRITE, &iov, 1, sizeof(req));
+#else
+	msg.msg_iov =3D &iov;
+	msg.msg_iovlen =3D 1;
+#endif
+	msg.msg_control =3D NULL;
+	msg.msg_controllen =3D 0;
+	msg.msg_flags =3D MSG_DONTWAIT;
+
+	oldfs =3D get_fs();
+	set_fs(KERNEL_DS);
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(4, 1, 0))
+	err =3D sock_sendmsg(sock, &msg);
+#else
+	err =3D sock_sendmsg(sock, &msg, sizeof(req));
+#endif
+	set_fs(oldfs);
+
+	if (err < 0)
+		goto out_sock;
+
+	pg =3D (char *) __get_free_page(GFP_KERNEL);
+	if (pg =3D=3D NULL) {
+		err =3D -ENOMEM;
+		goto out_sock;
+	}
+
+#if defined(CONFIG_IPV6) || defined(CONFIG_IPV6_MODULE)
+restart:
+#endif
+
+	for (;;) {
+		struct nlmsghdr *h;
+
+		iov.iov_base =3D pg;
+		iov.iov_len =3D PAGE_SIZE;
+
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(3, 19, 0))
+		iov_iter_init(&msg.msg_iter, READ, &iov, 1, PAGE_SIZE);
+#endif
+
+		oldfs =3D get_fs();
+		set_fs(KERNEL_DS);
+		err =3D sock_recvmsg(sock, &msg, PAGE_SIZE, MSG_DONTWAIT);
+		set_fs(oldfs);
+
+		if (err < 0)
+			goto out_sock_pg;
+
+		if (msg.msg_flags & MSG_TRUNC) {
+			err =3D -ENOBUFS;
+			goto out_sock_pg;
+		}
+
+		h =3D (struct nlmsghdr *) pg;
+
+		while (NLMSG_OK(h, err)) {
+			struct route_info rt_info;
+			if (h->nlmsg_type =3D=3D NLMSG_DONE) {
+				err =3D 0;
+				goto done;
+			}
+
+			if (h->nlmsg_type =3D=3D NLMSG_ERROR) {
+				struct nlmsgerr *errm =3D (struct nlmsgerr *) NLMSG_DATA(h);
+				err =3D errm->error;
+				printk("NLMSG error: %d\n", errm->error);
+				goto done;
+			}
+
+			if (h->nlmsg_type =3D=3D RTM_GETROUTE)
+				printk("RTM_GETROUTE: NLMSG: %d\n", h->nlmsg_type);
+			if (h->nlmsg_type !=3D RTM_NEWROUTE) {
+				printk("NLMSG: %d\n", h->nlmsg_type);
+				err =3D -EINVAL;
+				goto done;
+			}
+
+			memset(&rt_info, 0, sizeof(struct route_info));
+			parse_routes(h, &rt_info);
+			if (!rt_info.dst_addr.s_addr && rt_info.gateway.s_addr && rt_info.dev_i=
ndex) {
+				*gw_addr =3D rt_info.gateway.s_addr;
+				*gw_index =3D rt_info.dev_index;
+
+			}
+			h =3D NLMSG_NEXT(h, err);
+		}
+
+		if (err) {
+			printk("!!!Remnant of size %d %d %d\n", err, h->nlmsg_len, h->nlmsg_typ=
e);
+			err =3D -EINVAL;
+			break;
+		}
+	}
+
+done:
+#if defined(CONFIG_IPV6) || defined(CONFIG_IPV6_MODULE)
+	if (!err && req.g.rtgen_family =3D=3D AF_INET) {
+		req.g.rtgen_family =3D AF_INET6;
+
+		iov.iov_base =3D &req;
+		iov.iov_len =3D sizeof(req);
+
+		msg.msg_name =3D &nladdr;
+		msg.msg_namelen =3D sizeof(nladdr);
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(3, 19, 0))
+		iov_iter_init(&msg.msg_iter, WRITE, &iov, 1, sizeof(req));
+#else
+		msg.msg_iov =3D &iov;
+		msg.msg_iovlen =3D 1;
+#endif
+		msg.msg_control =3D NULL;
+		msg.msg_controllen =3D 0;
+		msg.msg_flags =3D MSG_DONTWAIT;
+
+		oldfs =3D get_fs();
+		set_fs(KERNEL_DS);
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(4, 1, 0))
+		err =3D sock_sendmsg(sock, &msg);
+#else
+		err =3D sock_sendmsg(sock, &msg, sizeof(req));
+#endif
+		set_fs(oldfs);
+
+		if (err > 0)
+			goto restart;
+	}
+#endif
+
+out_sock_pg:
+	free_page((unsigned long) pg);
+
+out_sock:
+	sock_release(sock);
+	return err;
+}
