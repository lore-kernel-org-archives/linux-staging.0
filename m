+	if (c < 4) /* Upper double word */
+		result =3D (maskfileBuffer[r] & (0x10 << c));
+	else
+		result =3D (maskfileBuffer[r] & (0x01 << (c - 4)));
+
+	return (result > 0) ? 0 : 1;
