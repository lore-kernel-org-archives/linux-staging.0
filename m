+int wpa_ft_is_completed(struct wpa_sm *sm)
+{
+	if (sm =3D=3D NULL)
+		return 0;
+
+	if (sm->key_mgmt !=3D WPA_KEY_MGMT_FT_IEEE8021X &&
+	    sm->key_mgmt !=3D WPA_KEY_MGMT_FT_PSK)
+		return 0;
+
+	return sm->ft_completed;
+}
