+
+
+	pHalData =3D GET_HAL_DATA(padapter);
+
+	pHalData->RegBcnCtrlVal |=3D SetBits;
+	pHalData->RegBcnCtrlVal &=3D ~ClearBits;
+
+	rtw_write8(padapter, REG_BCN_CTRL, (u8)pHalData->RegBcnCtrlVal);
+}
