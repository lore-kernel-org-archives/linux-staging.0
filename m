+		if (check_fwstate(pmlmepriv, WIFI_AP_STATE)) {
+			_pkt *pskb2 =3D NULL;
+			struct sta_info *psta =3D NULL;
+			struct sta_priv *pstapriv =3D &padapter->stapriv;
+			int bmcast =3D IS_MCAST(pattrib->dst);
+
+			if (!memcmp(pattrib->dst, adapter_mac_addr(padapter), ETH_ALEN) =3D=3D =
false) {
+				if (bmcast) {
+					psta =3D rtw_get_bcmc_stainfo(padapter);
+					pskb2 =3D rtw_skb_clone(pkt);
+				} else
+					psta =3D rtw_get_stainfo(pstapriv, pattrib->dst);
+
+				if (psta) {
+					struct net_device *pnetdev =3D (struct net_device *)padapter->pnetdev;
+
+					pkt->dev =3D pnetdev;
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 35))
+					skb_set_queue_mapping(pkt, rtw_recv_select_queue(pkt));
+#endif /* LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 35) */
+
+					_rtw_xmit_entry(pkt, pnetdev);
+
+					if (bmcast && (pskb2 !=3D NULL)) {
+						pkt =3D pskb2;
+						DBG_COUNTER(padapter->rx_logs.os_indicate_ap_mcast);
+					} else {
+						DBG_COUNTER(padapter->rx_logs.os_indicate_ap_forward);
+						return;
+					}
+				}
+			} else { /* to APself */
+				DBG_COUNTER(padapter->rx_logs.os_indicate_ap_self);
+			}
+		}
+
+#ifdef CONFIG_BR_EXT
+		/* Insert NAT2.5 RX here! */
+#if (LINUX_VERSION_CODE <=3D KERNEL_VERSION(2, 6, 35))
+		br_port =3D padapter->pnetdev->br_port;
+#else   /* (LINUX_VERSION_CODE <=3D KERNEL_VERSION(2, 6, 35)) */
+		rcu_read_lock();
+		br_port =3D rcu_dereference(padapter->pnetdev->rx_handler_data);
+		rcu_read_unlock();
+#endif /* (LINUX_VERSION_CODE <=3D KERNEL_VERSION(2, 6, 35)) */
+
+#endif /* CONFIG_BR_EXT */
+		if (precvpriv->sink_udpport > 0)
+			rtw_sink_rtp_seq_dbg(padapter, pkt);
+#ifdef DBG_UDP_PKT_LOSE_11AC
+		/* After eth_type_trans process , pkt->data pointer will move from ethrn=
et header to ip header ,
+		 * we have to check ethernet type , so this debug must be print before e=
th_type_trans
+		 */
+		if (*((unsigned short *)(pkt->data + ETH_ALEN * 2)) =3D=3D htons(ETH_P_A=
RP)) {
+			/* ARP Payload length will be 42bytes or 42+18(tailer)=3D60bytes*/
+			if (pkt->len !=3D 42 && pkt->len !=3D 60)
+				RTW_INFO("Error !!%s,ARP Payload length %u not correct\n",
+					 __func__, pkt->len);
+		} else if (*((unsigned short *)(pkt->data + ETH_ALEN * 2)) =3D=3D htons(=
ETH_P_IP)) {
+			if (be16_to_cpu(*((u16 *)(pkt->data + PAYLOAD_LEN_LOC_OF_IP_HDR))) !=3D
+					(pkt->len) - ETH_HLEN) {
+				RTW_INFO("Error !!%s,Payload length not correct\n", __func__);
+				RTW_INFO("%s, IP header describe Total length=3D%u\n",
+					 __func__, be16_to_cpu(*((u16 *)(pkt->data +
+							       PAYLOAD_LEN_LOC_OF_IP_HDR))));
+				RTW_INFO("%s, Pkt real length=3D%u\n", __func__,
+					 (pkt->len) - ETH_HLEN);
+			}
+		}
+#endif
+		/* After eth_type_trans process , pkt->data pointer will move from ethrn=
et header to ip header */
+		pkt->protocol =3D eth_type_trans(pkt, padapter->pnetdev);
+		pkt->dev =3D padapter->pnetdev;
+
+#ifdef CONFIG_TCP_CSUM_OFFLOAD_RX
+		if ((pattrib->tcpchk_valid =3D=3D 1) && (pattrib->tcp_chkrpt =3D=3D 1))
+			pkt->ip_summed =3D CHECKSUM_UNNECESSARY;
+		else
+			pkt->ip_summed =3D CHECKSUM_NONE;
+#else /* !CONFIG_TCP_CSUM_OFFLOAD_RX */
+		pkt->ip_summed =3D CHECKSUM_NONE;
+#endif /* CONFIG_TCP_CSUM_OFFLOAD_RX */
+
+#ifdef CONFIG_RTW_NAPI
+		if (pregistrypriv->en_napi) {
+			skb_queue_tail(&precvpriv->rx_napi_skb_queue, pkt);
+			napi_schedule(&padapter->napi);
+			return;
+		}
+#endif /* CONFIG_RTW_NAPI */
+
+		ret =3D rtw_netif_rx(padapter->pnetdev, pkt);
+		if (ret =3D=3D NET_RX_SUCCESS)
+			DBG_COUNTER(padapter->rx_logs.os_netif_ok);
+		else
+			DBG_COUNTER(padapter->rx_logs.os_netif_err);
+	}
+}
