+
+static int wps_for_each(struct hostapd_iface *iface, void *ctx)
+{
+	struct wps_for_each_data *data =3D ctx;
+	size_t j;
+
+	if (iface =3D=3D NULL)
+		return 0;
+	for (j =3D 0; j < iface->num_bss; j++) {
+		struct hostapd_data *hapd =3D iface->bss[j];
+		int ret =3D data->func(hapd, data->ctx);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
