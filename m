+			upper =3D pwr_info_5g->IndexBW40_Base[rfpath][group];
+			lower =3D pwr_info_5g->IndexBW40_Base[rfpath][group + 1];
+			hal_data->Index5G_BW80_Base[rfpath][ch_idx] =3D (upper + lower) / 2;
+		}
+
+		/* 5G diff */
+		for (tx_idx =3D 0; tx_idx < MAX_TX_COUNT; tx_idx++) {
+			if (tx_idx >=3D max_tx_cnt)
+				break;
+
+			hal_data->OFDM_5G_Diff[rfpath][tx_idx] =3D pwr_info_5g->OFDM_Diff[rfpat=
h][tx_idx];
