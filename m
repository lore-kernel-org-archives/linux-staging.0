+#include "includes.h"
+
+#include "common.h"
+#include "crypto/sha1.h"
+#include "eap_peap_common.h"
+
+void peap_prfplus(int version, const u8 *key, size_t key_len,
+		  const char *label, const u8 *seed, size_t seed_len,
+		  u8 *buf, size_t buf_len)
+{
+	unsigned char counter =3D 0;
+	size_t pos, plen;
+	u8 hash[SHA1_MAC_LEN];
+	size_t label_len =3D os_strlen(label);
+	u8 extra[2];
+	const unsigned char *addr[5];
+	size_t len[5];
+
+	addr[0] =3D hash;
+	len[0] =3D 0;
+	addr[1] =3D (unsigned char *) label;
+	len[1] =3D label_len;
+	addr[2] =3D seed;
+	len[2] =3D seed_len;
+
+	if (version =3D=3D 0) {
+		/*
+		 * PRF+(K, S, LEN) =3D T1 | T2 | ... | Tn
+		 * T1 =3D HMAC-SHA1(K, S | 0x01 | 0x00 | 0x00)
+		 * T2 =3D HMAC-SHA1(K, T1 | S | 0x02 | 0x00 | 0x00)
+		 * ...
+		 * Tn =3D HMAC-SHA1(K, Tn-1 | S | n | 0x00 | 0x00)
+		 */
+
+		extra[0] =3D 0;
+		extra[1] =3D 0;
+
+		addr[3] =3D &counter;
+		len[3] =3D 1;
+		addr[4] =3D extra;
+		len[4] =3D 2;
+	} else {
+		/*
+		 * PRF (K,S,LEN) =3D T1 | T2 | T3 | T4 | ... where:
+		 * T1 =3D HMAC-SHA1(K, S | LEN | 0x01)
+		 * T2 =3D HMAC-SHA1 (K, T1 | S | LEN | 0x02)
+		 * T3 =3D HMAC-SHA1 (K, T2 | S | LEN | 0x03)
+		 * T4 =3D HMAC-SHA1 (K, T3 | S | LEN | 0x04)
+		 *   ...
+		 */
+
+		extra[0] =3D buf_len & 0xff;
+
+		addr[3] =3D extra;
+		len[3] =3D 1;
+		addr[4] =3D &counter;
+		len[4] =3D 1;
+	}
+
+	pos =3D 0;
+	while (pos < buf_len) {
+		counter++;
+		plen =3D buf_len - pos;
+		hmac_sha1_vector(key, key_len, 5, addr, len, hash);
+		if (plen >=3D SHA1_MAC_LEN) {
+			os_memcpy(&buf[pos], hash, SHA1_MAC_LEN);
+			pos +=3D SHA1_MAC_LEN;
+		} else {
+			os_memcpy(&buf[pos], hash, plen);
+			break;
+		}
+		len[0] =3D SHA1_MAC_LEN;
+	}
+}
