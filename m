+void wps_kdf(const u8 *key, const u8 *label_prefix, size_t label_prefix_le=
n,
+	     const char *label, u8 *res, size_t res_len)
+{
+	u8 i_buf[4], key_bits[4];
+	const u8 *addr[4];
+	size_t len[4];
+	int i, iter;
+	u8 hash[SHA256_MAC_LEN], *opos;
+	size_t left;
+
+	WPA_PUT_BE32(key_bits, res_len * 8);
+
+	addr[0] =3D i_buf;
+	len[0] =3D sizeof(i_buf);
+	addr[1] =3D label_prefix;
+	len[1] =3D label_prefix_len;
+	addr[2] =3D (const u8 *) label;
+	len[2] =3D os_strlen(label);
+	addr[3] =3D key_bits;
+	len[3] =3D sizeof(key_bits);
+
+	iter =3D (res_len + SHA256_MAC_LEN - 1) / SHA256_MAC_LEN;
+	opos =3D res;
+	left =3D res_len;
+
+	for (i =3D 1; i <=3D iter; i++) {
+		WPA_PUT_BE32(i_buf, i);
+		hmac_sha256_vector(key, SHA256_MAC_LEN, 4, addr, len, hash);
+		if (i < iter) {
+			os_memcpy(opos, hash, SHA256_MAC_LEN);
+			opos +=3D SHA256_MAC_LEN;
+			left -=3D SHA256_MAC_LEN;
+		} else
+			os_memcpy(opos, hash, left);
+	}
+}
