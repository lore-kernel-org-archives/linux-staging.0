+int process_p2p_cross_connect_ie(PADAPTER padapter, u8 *IEs, u32 IELength)
+{
+	int ret =3D true;
+	u8 *ies;
+	u32 ies_len;
+	u8 *p2p_ie;
+	u32	p2p_ielen =3D 0;
+	u8	p2p_attr[MAX_P2P_IE_LEN] =3D { 0x00 };/* NoA length should be n*(13) +=
 2 */
+	u32	attr_contentlen =3D 0;
+
+	struct wifidirect_info	*pwdinfo =3D &(padapter->wdinfo);
+
+
+	if (IELength <=3D _BEACON_IE_OFFSET_)
+		return ret;
+
+	ies =3D IEs + _BEACON_IE_OFFSET_;
+	ies_len =3D IELength - _BEACON_IE_OFFSET_;
+
+	p2p_ie =3D rtw_get_p2p_ie(ies, ies_len, NULL, &p2p_ielen);
+
+	while (p2p_ie) {
+		/* Get P2P Manageability IE. */
+		if (rtw_get_p2p_attr_content(p2p_ie, p2p_ielen, P2P_ATTR_MANAGEABILITY, =
p2p_attr, &attr_contentlen)) {
+			if ((p2p_attr[0] & (BIT(0) | BIT(1))) =3D=3D 0x01)
+				ret =3D false;
+			break;
+		}
+		/* Get the next P2P IE */
+		p2p_ie =3D rtw_get_p2p_ie(p2p_ie + p2p_ielen, ies_len - (p2p_ie - ies + =
p2p_ielen), NULL, &p2p_ielen);
+	}
+
+	return ret;
+}
