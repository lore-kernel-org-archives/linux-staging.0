+#endif
+					tx_chk =3D issue_nulldata_in_interrupt(padapter, NULL, from_timer ? 1=
 : 0);
+				}
+			}
+
+			if (rx_chk =3D=3D _FAIL) {
+				pmlmeext->retry++;
+				if (pmlmeext->retry > rx_chk_limit) {
+					RTW_PRINT(FUNC_ADPT_FMT" disconnect or roaming\n",
