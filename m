+int hal_read_mac_hidden_rpt(_adapter *adapter)
+{
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(adapter);
+	int ret =3D _FAIL;
+	int ret_fwdl;
+	u8 mac_hidden_rpt[MAC_HIDDEN_RPT_LEN + MAC_HIDDEN_RPT_2_LEN] =3D {0};
+	u32 start =3D jiffies;
+	u32 cnt =3D 0;
+	u32 timeout_ms =3D 800;
+	u32 min_cnt =3D 10;
+	u8 id =3D C2H_DEFEATURE_RSVD;
+	int i;
+
+	u8 hci_type =3D rtw_get_intf_type(adapter);
+
+	if ((hci_type =3D=3D RTW_USB || hci_type =3D=3D RTW_PCIE)
+		&& !rtw_is_hw_init_completed(adapter))
+		rtw_hal_power_on(adapter);
+
+	/* inform FW mac hidden rpt from reg is needed */
+	rtw_write8(adapter, REG_C2HEVT_MSG_NORMAL, C2H_DEFEATURE_RSVD);
+
+	/* download FW */
+	pHalData->not_xmitframe_fw_dl =3D 1;
+	ret_fwdl =3D rtw_hal_fw_dl(adapter, false);
+	pHalData->not_xmitframe_fw_dl =3D 0;
+	if (ret_fwdl !=3D _SUCCESS)
+		goto mac_hidden_rpt_hdl;
+
+	/* polling for data ready */
+	start =3D jiffies;
+	do {
+		cnt++;
+		id =3D rtw_read8(adapter, REG_C2HEVT_MSG_NORMAL);
+		if (id =3D=3D C2H_MAC_HIDDEN_RPT || RTW_CANNOT_IO(adapter))
+			break;
+		rtw_msleep_os(10);
+	} while (rtw_get_passing_time_ms(start) < timeout_ms || cnt < min_cnt);
+
+	if (id =3D=3D C2H_MAC_HIDDEN_RPT) {
+		/* read data */
+		for (i =3D 0; i < MAC_HIDDEN_RPT_LEN + MAC_HIDDEN_RPT_2_LEN; i++)
+			mac_hidden_rpt[i] =3D rtw_read8(adapter, REG_C2HEVT_MSG_NORMAL + 2 + i);
+	}
+
+	/* inform FW mac hidden rpt has read */
+	rtw_write8(adapter, REG_C2HEVT_MSG_NORMAL, C2H_DBG);
+
+mac_hidden_rpt_hdl:
+	c2h_mac_hidden_rpt_hdl(adapter, mac_hidden_rpt, MAC_HIDDEN_RPT_LEN);
+	c2h_mac_hidden_rpt_2_hdl(adapter, mac_hidden_rpt + MAC_HIDDEN_RPT_LEN, MA=
C_HIDDEN_RPT_2_LEN);
+
+	if (ret_fwdl =3D=3D _SUCCESS && id =3D=3D C2H_MAC_HIDDEN_RPT)
+		ret =3D _SUCCESS;
+
+exit:
+
+	if ((hci_type =3D=3D RTW_USB || hci_type =3D=3D RTW_PCIE)
+		&& !rtw_is_hw_init_completed(adapter))
+		rtw_hal_power_off(adapter);
+
+	RTW_INFO("%s %s! (%u, %dms), fwdl:%d, id:0x%02x\n", __func__
+		, (ret =3D=3D _SUCCESS) ? "OK" : "Fail", cnt, rtw_get_passing_time_ms(st=
art), ret_fwdl, id);
+
+	return ret;
+}
