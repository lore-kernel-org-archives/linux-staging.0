+int wps_er_pbc(struct wps_er *er, const u8 *uuid)
+{
+	int res;
+	struct wps_er_ap *ap;
+
+	if (er =3D=3D NULL || er->wps =3D=3D NULL)
+		return -1;
+
+	if (wps_registrar_pbc_overlap(er->wps->registrar, NULL, NULL)) {
+		wpa_printf(MSG_DEBUG, "WPS ER: PBC overlap - do not start PBC "
+			   "mode");
+		return -2;
+	}
+
+	ap =3D wps_er_ap_get(er, NULL, uuid);
+	if (ap =3D=3D NULL) {
+		struct wps_er_sta *sta =3D NULL;
+		dl_list_for_each(ap, &er->ap, struct wps_er_ap, list) {
+			sta =3D wps_er_sta_get(ap, NULL, uuid);
+			if (sta) {
+				uuid =3D ap->uuid;
+				break;
+			}
+		}
+		if (sta =3D=3D NULL)
+			return -3; /* Unknown UUID */
+	}
+
+	if (ap->ap_settings =3D=3D NULL) {
