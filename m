+static void wpa_driver_wext_add_scan_entry(struct wpa_scan_results *res,
+					   struct wext_scan_data *data)
+{
+	struct wpa_scan_res **tmp;
+	struct wpa_scan_res *r;
+	size_t extra_len;
+	u8 *pos, *end, *ssid_ie =3D NULL, *rate_ie =3D NULL;
+
+	/* Figure out whether we need to fake any IEs */
+	pos =3D data->ie;
+	end =3D pos + data->ie_len;
+	while (pos && pos + 1 < end) {
+		if (pos + 2 + pos[1] > end)
+			break;
+		if (pos[0] =3D=3D WLAN_EID_SSID)
+			ssid_ie =3D pos;
+		else if (pos[0] =3D=3D WLAN_EID_SUPP_RATES)
+			rate_ie =3D pos;
+		else if (pos[0] =3D=3D WLAN_EID_EXT_SUPP_RATES)
+			rate_ie =3D pos;
+		pos +=3D 2 + pos[1];
+	}
+
+	extra_len =3D 0;
+	if (ssid_ie =3D=3D NULL)
+		extra_len +=3D 2 + data->ssid_len;
+	if (rate_ie =3D=3D NULL && data->maxrate)
+		extra_len +=3D 3;
+
+	r =3D os_zalloc(sizeof(*r) + extra_len + data->ie_len);
+	if (r =3D=3D NULL)
+		return;
+	os_memcpy(r, &data->res, sizeof(*r));
+	r->ie_len =3D extra_len + data->ie_len;
+	pos =3D (u8 *) (r + 1);
+	if (ssid_ie =3D=3D NULL) {
+		/*
+		 * Generate a fake SSID IE since the driver did not report
+		 * a full IE list.
+		 */
+		*pos++ =3D WLAN_EID_SSID;
+		*pos++ =3D data->ssid_len;
+		os_memcpy(pos, data->ssid, data->ssid_len);
+		pos +=3D data->ssid_len;
+	}
+	if (rate_ie =3D=3D NULL && data->maxrate) {
+		/*
+		 * Generate a fake Supported Rates IE since the driver did not
+		 * report a full IE list.
+		 */
+		*pos++ =3D WLAN_EID_SUPP_RATES;
+		*pos++ =3D 1;
+		*pos++ =3D data->maxrate;
+	}
+	if (data->ie)
+		os_memcpy(pos, data->ie, data->ie_len);
+
+	tmp =3D os_realloc(res->res,
+			 (res->num + 1) * sizeof(struct wpa_scan_res *));
+	if (tmp =3D=3D NULL) {
+		os_free(r);
+		return;
+	}
+	tmp[res->num++] =3D r;
+	res->res =3D tmp;
+}
