+static void mlme_event_remain_on_channel(struct wpa_driver_nl80211_data *d=
rv,
+					 int cancel_event, struct nlattr *tb[])
+{
+	unsigned int freq, chan_type, duration;
+	union wpa_event_data data;
+	u64 cookie;
+
+	if (tb[NL80211_ATTR_WIPHY_FREQ])
+		freq =3D nla_get_u32(tb[NL80211_ATTR_WIPHY_FREQ]);
+	else
+		freq =3D 0;
+
+	if (tb[NL80211_ATTR_WIPHY_CHANNEL_TYPE])
+		chan_type =3D nla_get_u32(tb[NL80211_ATTR_WIPHY_CHANNEL_TYPE]);
+	else
+		chan_type =3D 0;
+
+	if (tb[NL80211_ATTR_DURATION])
+		duration =3D nla_get_u32(tb[NL80211_ATTR_DURATION]);
+	else
+		duration =3D 0;
+
+	if (tb[NL80211_ATTR_COOKIE])
+		cookie =3D nla_get_u64(tb[NL80211_ATTR_COOKIE]);
+	else
+		cookie =3D 0;
+
+	wpa_printf(MSG_DEBUG, "nl80211: Remain-on-channel event (cancel=3D%d "
+		   "freq=3D%u channel_type=3D%u duration=3D%u cookie=3D0x%llx (%s))",
+		   cancel_event, freq, chan_type, duration,
+		   (long long unsigned int) cookie,
+		   cookie =3D=3D drv->remain_on_chan_cookie ? "match" : "unknown");
+
+	if (cookie !=3D drv->remain_on_chan_cookie)
+		return; /* not for us */
+
+	drv->pending_remain_on_chan =3D !cancel_event;
+
+	os_memset(&data, 0, sizeof(data));
+	data.remain_on_channel.freq =3D freq;
+	data.remain_on_channel.duration =3D duration;
+	wpa_supplicant_event(drv->ctx, cancel_event ?
+			     EVENT_CANCEL_REMAIN_ON_CHANNEL :
+			     EVENT_REMAIN_ON_CHANNEL, &data);
+}
