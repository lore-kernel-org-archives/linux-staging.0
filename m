+void rtw_dev_unload(_adapter *padapter)
+{
+	struct net_device *pnetdev =3D (struct net_device *)padapter->pnetdev;
+	struct pwrctrl_priv *pwrctl =3D adapter_to_pwrctl(padapter);
+	struct dvobj_priv *pobjpriv =3D padapter->dvobj;
+	struct debug_priv *pdbgpriv =3D &pobjpriv->drv_dbg;
+	struct cmd_priv *pcmdpriv =3D &padapter->cmdpriv;
+	u8 cnt =3D 0;
+
+
+	if (padapter->bup =3D=3D true) {
+		RTW_INFO("=3D=3D> "FUNC_ADPT_FMT"\n", FUNC_ADPT_ARG(padapter));
+
+		rtw_set_drv_stopped(padapter);
+#ifdef CONFIG_XMIT_ACK
+		if (padapter->xmitpriv.ack_tx)
+			rtw_ack_tx_done(&padapter->xmitpriv, RTW_SCTX_DONE_DRV_STOP);
+#endif
+
+		rtw_intf_stop(padapter);
+
+
+		if (!pwrctl->bInternalAutoSuspend)
+			rtw_stop_drv_threads(padapter);
+
+		while (ATOMIC_READ(&(pcmdpriv->cmdthd_running)) =3D=3D true) {
+			if (cnt > 5) {
+				RTW_INFO("stop cmdthd timeout\n");
+				break;
+			} else {
+				cnt++;
+				RTW_INFO("cmdthd is running(%d)\n", cnt);
+				rtw_msleep_os(10);
+			}
+		}
+
+
+		/* check the status of IPS */
+		if (rtw_hal_check_ips_status(padapter) =3D=3D true || pwrctl->rf_pwrstat=
e =3D=3D rf_off) { /* check HW status and SW state */
+			RTW_INFO("%s: driver in IPS-FWLPS\n", __func__);
+			pdbgpriv->dbg_dev_unload_inIPS_cnt++;
+		} else
+			RTW_INFO("%s: driver not in IPS\n", __func__);
+
+		if (!rtw_is_surprise_removed(padapter)) {
+#ifdef CONFIG_BT_COEXIST
+			rtw_btcoex_IpsNotify(padapter, pwrctl->ips_mode_req);
+#endif
+#ifdef CONFIG_WOWLAN
+			if (pwrctl->bSupportRemoteWakeup =3D=3D true &&
+			    pwrctl->wowlan_mode =3D=3D true)
+				RTW_INFO("%s bSupportRemoteWakeup=3D=3Dtrue  do not run rtw_hal_deinit=
()\n", __func__);
+			else
+#endif
+			{
+				/* amy modify 20120221 for power seq is different between driver open =
and ips */
+				rtw_hal_deinit(padapter);
+			}
+			rtw_set_surprise_removed(padapter);
+		}
+
+		padapter->bup =3D false;
+
+		RTW_INFO("<=3D=3D "FUNC_ADPT_FMT"\n", FUNC_ADPT_ARG(padapter));
+	} else {
+		RTW_INFO("%s: bup=3D=3Dfalse\n", __func__);
+	}
+	rtw_cancel_all_timer(padapter);
+}
