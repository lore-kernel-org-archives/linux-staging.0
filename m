+static void fill_txdesc_vcs(struct pkt_attrib *pattrib, __le32 *pdw)
+{
+	/* RTW_INFO("cvs_mode=3D%d\n", pattrib->vcs_mode);	 */
+
+	switch (pattrib->vcs_mode) {
+	case RTS_CTS:
+		*pdw |=3D cpu_to_le32(RTS_EN);
+		break;
+	case CTS_TO_SELF:
+		*pdw |=3D cpu_to_le32(CTS_2_SELF);
+		break;
+	case NONE_VCS:
+	default:
+		break;
+	}
+
+	if (pattrib->vcs_mode) {
+		*pdw |=3D cpu_to_le32(HW_RTS_EN);
+
+		/* Set RTS BW */
+		if (pattrib->ht_en) {
+			*pdw |=3D (pattrib->bwmode & CHANNEL_WIDTH_40) ?	cpu_to_le32(BIT(27)) :=
 0;
+
+			if (pattrib->ch_offset =3D=3D HAL_PRIME_CHNL_OFFSET_LOWER)
+				*pdw |=3D cpu_to_le32((0x01 << 28) & 0x30000000);
+			else if (pattrib->ch_offset =3D=3D HAL_PRIME_CHNL_OFFSET_UPPER)
+				*pdw |=3D cpu_to_le32((0x02 << 28) & 0x30000000);
+			else if (pattrib->ch_offset =3D=3D HAL_PRIME_CHNL_OFFSET_DONT_CARE)
+				*pdw |=3D 0;
+			else
+				*pdw |=3D cpu_to_le32((0x03 << 28) & 0x30000000);
+		}
+	}
+}
+
+static void fill_txdesc_phy(struct pkt_attrib *pattrib, __le32 *pdw)
+{
+	/* RTW_INFO("bwmode=3D%d, ch_off=3D%d\n", pattrib->bwmode, pattrib->ch_of=
fset); */
+
+	if (pattrib->ht_en) {
+		*pdw |=3D (pattrib->bwmode & CHANNEL_WIDTH_40) ?	cpu_to_le32(BIT(25)) : =
0;
+
+		if (pattrib->ch_offset =3D=3D HAL_PRIME_CHNL_OFFSET_LOWER)
+			*pdw |=3D cpu_to_le32((0x01 << DATA_SC_SHT) & 0x003f0000);
+		else if (pattrib->ch_offset =3D=3D HAL_PRIME_CHNL_OFFSET_UPPER)
+			*pdw |=3D cpu_to_le32((0x02 << DATA_SC_SHT) & 0x003f0000);
+		else if (pattrib->ch_offset =3D=3D HAL_PRIME_CHNL_OFFSET_DONT_CARE)
+			*pdw |=3D 0;
+		else
+			*pdw |=3D cpu_to_le32((0x03 << DATA_SC_SHT) & 0x003f0000);
+	}
+}
+
+
+static s32 update_txdesc(struct xmit_frame *pxmitframe, u8 *pmem, s32 sz ,=
 u8 bagg_pkt)
+{
+	int	pull =3D 0;
+	uint	qsel;
+	bool sgi =3D 0;
+	u8 data_rate =3D 0, pwr_status, offset;
+	_adapter			*padapter =3D pxmitframe->padapter;
+	struct mlme_priv	*pmlmepriv =3D &padapter->mlmepriv;
+	struct pkt_attrib	*pattrib =3D &pxmitframe->attrib;
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(padapter);
+
+	struct tx_desc	*ptxdesc =3D (struct tx_desc *)pmem;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	sint	bmcst =3D IS_MCAST(pattrib->ra);
+#ifdef CONFIG_P2P
+	struct wifidirect_info	*pwdinfo =3D &padapter->wdinfo;
+#endif /* CONFIG_P2P */
+
+#ifndef CONFIG_USE_USB_BUFFER_ALLOC_TX
+	if (padapter->registrypriv.mp_mode =3D=3D 0) {
+		/* if((!bagg_pkt) &&(urb_zero_packet_chk(padapter, sz)=3D=3D0)) */ /* (s=
z %512) !=3D 0 */
+		if ((PACKET_OFFSET_SZ !=3D 0) && (!bagg_pkt) && (rtw_usb_bulk_size_bound=
ary(padapter, TXDESC_SIZE + sz) =3D=3D false)) {
+			ptxdesc =3D (struct tx_desc *)(pmem + PACKET_OFFSET_SZ);
+			/* RTW_INFO("=3D=3D> non-agg-pkt,shift pointer...\n"); */
+			pull =3D 1;
+		}
+	}
+#endif /* CONFIG_USE_USB_BUFFER_ALLOC_TX */
+
+	memset(ptxdesc, 0, sizeof(struct tx_desc));
+
+	/* 4 offset 0 */
+	ptxdesc->txdw0 |=3D cpu_to_le32(OWN | FSG | LSG);
+	/* RTW_INFO("%s=3D=3D> pkt_len=3D%d,bagg_pkt=3D%02x\n",__func__,sz,bagg_p=
kt); */
+	ptxdesc->txdw0 |=3D cpu_to_le32(sz & 0x0000ffff);/* update TXPKTSIZE */
+
+	offset =3D TXDESC_SIZE + OFFSET_SZ;
+
+#ifdef CONFIG_TX_EARLY_MODE
+	if (bagg_pkt) {
+		offset +=3D EARLY_MODE_INFO_SIZE ;/* 0x28			 */
+	}
+#endif
+	/* RTW_INFO("%s=3D=3D>offset(0x%02x)\n",__func__,offset); */
+	ptxdesc->txdw0 |=3D cpu_to_le32(((offset) << OFFSET_SHT) & 0x00ff0000);/*=
 32 bytes for TX Desc */
+
+	if (bmcst)
+		ptxdesc->txdw0 |=3D cpu_to_le32(BMC);
+
+#ifndef CONFIG_USE_USB_BUFFER_ALLOC_TX
+	if (padapter->registrypriv.mp_mode =3D=3D 0) {
+		if ((PACKET_OFFSET_SZ !=3D 0) && (!bagg_pkt)) {
+			if ((pull) && (pxmitframe->pkt_offset > 0))
+				pxmitframe->pkt_offset =3D pxmitframe->pkt_offset - 1;
+		}
+	}
+#endif
+	/* RTW_INFO("%s, pkt_offset=3D0x%02x\n",__func__,pxmitframe->pkt_offset);=
 */
+
+	/* pkt_offset, unit:8 bytes padding */
+	if (pxmitframe->pkt_offset > 0)
+		ptxdesc->txdw1 |=3D cpu_to_le32((pxmitframe->pkt_offset << 26) & 0x7c000=
000);
+
+	if ((pxmitframe->frame_tag & 0x0f) =3D=3D DATA_FRAMETAG) {
+		/* RTW_INFO("pxmitframe->frame_tag =3D=3D DATA_FRAMETAG\n");		 */
+
+		/* offset 4 */
+		ptxdesc->txdw1 |=3D cpu_to_le32(pattrib->mac_id & 0x3F);
+
+		qsel =3D (uint)(pattrib->qsel & 0x0000001f);
+		/* RTW_INFO("=3D=3D> macid(%d) qsel:0x%02x\n",pattrib->mac_id,qsel); */
+		ptxdesc->txdw1 |=3D cpu_to_le32((qsel << QSEL_SHT) & 0x00001f00);
+
+		ptxdesc->txdw1 |=3D cpu_to_le32((pattrib->raid << RATE_ID_SHT) & 0x000F0=
000);
+
+		fill_txdesc_sectype(pattrib, ptxdesc);
+
+#if defined(CONFIG_CONCURRENT_MODE)
+		if (bmcst)
+			fill_txdesc_force_bmc_camid(pattrib, ptxdesc);
+#endif
+
+		if (pattrib->ampdu_en =3D=3D true) {
+			ptxdesc->txdw2 |=3D cpu_to_le32(AGG_EN);/* AGG EN */
+			ptxdesc->txdw2 |=3D cpu_to_le32((pattrib->ampdu_spacing <<
+						      AMPDU_DENSITY_SHT) & 0x00700000);
+
+			/* SET_TX_DESC_MAX_AGG_NUM_88E(pDesc, 0x1F); */
+			/* SET_TX_DESC_MCSG1_MAX_LEN_88E(pDesc, 0x6); */
+			/* SET_TX_DESC_MCSG2_MAX_LEN_88E(pDesc, 0x6); */
+			/* SET_TX_DESC_MCSG3_MAX_LEN_88E(pDesc, 0x6); */
+			/* SET_TX_DESC_MCS7_SGI_MAX_LEN_88E(pDesc, 0x6); */
+			ptxdesc->txdw6 =3D cpu_to_le32(0x6666f800);
+		} else {
+			ptxdesc->txdw2 |=3D cpu_to_le32(AGG_BK);/* AGG BK */
+		}
+
+		/* offset 8 */
+
+
+		/* offset 12 */
+		ptxdesc->txdw3 |=3D cpu_to_le32((pattrib->seqnum << SEQ_SHT) & 0x0FFF000=
0);
+
+
+		/* offset 16 , offset 20 */
+		if (pattrib->qos_en)
+			ptxdesc->txdw4 |=3D cpu_to_le32(QOS);/* QoS */
+
+		/* offset 20 */
+#ifdef CONFIG_USB_TX_AGGREGATION
+		if (pxmitframe->agg_num > 1) {
+			/* RTW_INFO("%s agg_num:%d\n",__func__,pxmitframe->agg_num ); */
+			ptxdesc->txdw5 |=3D cpu_to_le32((pxmitframe->agg_num << USB_TXAGG_NUM_S=
HT) & 0xFF000000);
+		}
+#endif
+
+		if ((pattrib->ether_type !=3D 0x888e) &&
+		    (pattrib->ether_type !=3D 0x0806) &&
+		    (pattrib->ether_type !=3D 0x88b4) &&
+		    (pattrib->dhcp_pkt !=3D 1)) {
+			/* Non EAP & ARP & DHCP type data packet */
+
+			fill_txdesc_vcs(pattrib, &ptxdesc->txdw4);
+			fill_txdesc_phy(pattrib, &ptxdesc->txdw4);
+
+			ptxdesc->txdw4 |=3D cpu_to_le32(0x00000008);/* RTS Rate=3D24M */
+			ptxdesc->txdw5 |=3D cpu_to_le32(0x0001ff00);/* DATA/RTS  Rate FB LMT			=
 */
+
+#if (RATE_ADAPTIVE_SUPPORT =3D=3D 1)
+			if (pHalData->fw_ractrl =3D=3D false) {
+				/* driver-based RA*/
+				/* driver uses rate */
+				ptxdesc->txdw4 |=3D cpu_to_le32(USERATE);/* rate control always by dri=
ver */
+				if (pattrib->ht_en)
+					sgi =3D odm_ra_get_sgi_8188e(&pHalData->odmpriv, pattrib->mac_id);
+
+				data_rate =3D odm_ra_get_decision_rate_8188e(&pHalData->odmpriv, pattr=
ib->mac_id);
+
+#if (POWER_TRAINING_ACTIVE =3D=3D 1)
+				pwr_status =3D odm_ra_get_hw_pwr_status_8188e(&pHalData->odmpriv, patt=
rib->mac_id);
+				ptxdesc->txdw4 |=3D cpu_to_le32((pwr_status & 0x7) << PWR_STATUS_SHT);
+#endif
+			} else
+#endif/* if (RATE_ADAPTIVE_SUPPORT =3D=3D 1) */
+			{
+				/* FW-based RA, TODO */
+				if (pattrib->ht_en)
+					sgi =3D 1;
+
+				data_rate =3D 0x13; /* default rate: MCS7 */
+			}
+
+			if (padapter->fix_rate !=3D 0xFF) {
+				data_rate =3D padapter->fix_rate;
+				ptxdesc->txdw4 |=3D cpu_to_le32(USERATE);
+				if (!padapter->data_fb)
+					ptxdesc->txdw4 |=3D cpu_to_le32(DISDATAFB);
+				sgi =3D (padapter->fix_rate & BIT(7)) ? 1 : 0;
+			}
+
+			if (sgi)
+				ptxdesc->txdw5 |=3D cpu_to_le32(SGI);
+
+			ptxdesc->txdw5 |=3D cpu_to_le32(data_rate & 0x3F);
+		} else {
+			/* EAP data packet and ARP packet and DHCP. */
+			/* Use the 1M data rate to send the EAP/ARP packet. */
+			/* This will maybe make the handshake smooth. */
+
+			/* driver uses rate */
+			ptxdesc->txdw4 |=3D cpu_to_le32(USERATE);/* rate control always by driv=
er */
+			ptxdesc->txdw2 |=3D cpu_to_le32(AGG_BK);/* AGG BK		   */
+
+			if (pmlmeinfo->preamble_mode =3D=3D PREAMBLE_SHORT)
+				ptxdesc->txdw4 |=3D cpu_to_le32(BIT(24));/* DATA_SHORT */
+
+			ptxdesc->txdw5 |=3D cpu_to_le32(MRateToHwRate(pmlmeext->tx_rate));
+		}
+
+#ifdef CONFIG_TCP_CSUM_OFFLOAD_TX
+		/* offset 24 */
+		if (pattrib->hw_tcp_csum =3D=3D 1) {
+			/* ptxdesc->txdw6 =3D 0; */ /* clear TCP_CHECKSUM and IP_CHECKSUM. It's=
 zero already!! */
+			u8 ip_hdr_offset =3D 32 + pattrib->hdrlen + pattrib->iv_len + 8;
+			ptxdesc->txdw7 =3D (1 << 31) | (ip_hdr_offset << 16);
+			RTW_INFO("ptxdesc->txdw7 =3D %08x\n", ptxdesc->txdw7);
+		}
+#endif
+
+#ifdef CONFIG_TDLS
+#ifdef CONFIG_XMIT_ACK
+		/* CCX-TXRPT ack for xmit mgmt frames. */
+		if (pxmitframe->ack_report) {
+#ifdef DBG_CCX
+			static u16 ccx_sw =3D 0x123;
+
+			ptxdesc->txdw7 |=3D cpu_to_le32(((ccx_sw) << 16) & 0x0fff0000);
+			RTW_INFO("%s set ccx, sw:0x%03x\n", __func__, ccx_sw);
+			ccx_sw =3D (ccx_sw + 1) % 0xfff;
+#endif
+			ptxdesc->txdw2 |=3D cpu_to_le32(BIT(19));
+		}
+#endif /* CONFIG_XMIT_ACK */
+#endif
+	} else if ((pxmitframe->frame_tag & 0x0f) =3D=3D MGNT_FRAMETAG) {
+		/* RTW_INFO("pxmitframe->frame_tag =3D=3D MGNT_FRAMETAG\n");	 */
+		/* driver uses rate */
+		ptxdesc->txdw4 |=3D cpu_to_le32(USERATE);/* rate control always by drive=
r */
+
+		/* offset 4		 */
+		ptxdesc->txdw1 |=3D cpu_to_le32(pattrib->mac_id & 0x3f);
+
+		qsel =3D (uint)(pattrib->qsel & 0x0000001f);
+		ptxdesc->txdw1 |=3D cpu_to_le32((qsel << QSEL_SHT) & 0x00001f00);
+
+		ptxdesc->txdw1 |=3D cpu_to_le32((pattrib->raid << RATE_ID_SHT) & 0x000f0=
000);
+
+		/* fill_txdesc_sectype(pattrib, ptxdesc); */
+
+		/* offset 8		 */
+#ifdef CONFIG_XMIT_ACK
+		/* CCX-TXRPT ack for xmit mgmt frames. */
+		if (pxmitframe->ack_report) {
+#ifdef DBG_CCX
+			static u16 ccx_sw =3D 0x123;
+			ptxdesc->txdw7 |=3D cpu_to_le32(((ccx_sw) << 16) & 0x0fff0000);
+			RTW_INFO("%s set ccx, sw:0x%03x\n", __func__, ccx_sw);
+			ccx_sw =3D (ccx_sw + 1) % 0xfff;
+#endif
+			ptxdesc->txdw2 |=3D cpu_to_le32(BIT(19));
+		}
+#endif /* CONFIG_XMIT_ACK */
+
+		/* offset 12 */
+		ptxdesc->txdw3 |=3D cpu_to_le32((pattrib->seqnum << SEQ_SHT) & 0x0FFF000=
0);
+
+		/* offset 20 */
+		ptxdesc->txdw5 |=3D cpu_to_le32(RTY_LMT_EN);/* retry limit enable */
+		if (pattrib->retry_ctrl =3D=3D true)
+			ptxdesc->txdw5 |=3D cpu_to_le32(0x00180000);/* retry limit =3D 6 */
+		else
+			ptxdesc->txdw5 |=3D cpu_to_le32(0x00300000);/* retry limit =3D 12 */
+
+		ptxdesc->txdw5 |=3D cpu_to_le32(MRateToHwRate(pattrib->rate));
+
+	} else if ((pxmitframe->frame_tag & 0x0f) =3D=3D TXAGG_FRAMETAG)
+		RTW_INFO("pxmitframe->frame_tag =3D=3D TXAGG_FRAMETAG\n");
+#ifdef CONFIG_MP_INCLUDED
+	else if (((pxmitframe->frame_tag & 0x0f) =3D=3D MP_FRAMETAG) &&
+		 (padapter->registrypriv.mp_mode =3D=3D 1))
+		fill_txdesc_for_mp(padapter, (u8 *)ptxdesc);
+#endif
+	else {
+		RTW_INFO("pxmitframe->frame_tag =3D %d\n", pxmitframe->frame_tag);
+
+		/* offset 4	 */
+		ptxdesc->txdw1 |=3D cpu_to_le32((4) & 0x3f); /* CAM_ID(MAC_ID) */
+
+		ptxdesc->txdw1 |=3D cpu_to_le32((6 << RATE_ID_SHT) & 0x000f0000); /* rai=
d */
+
+		/* offset 8		 */
+
+		/* offset 12 */
+		ptxdesc->txdw3 |=3D cpu_to_le32((pattrib->seqnum << SEQ_SHT) & 0x0fff000=
0);
+
+		/* offset 20 */
+		ptxdesc->txdw5 |=3D cpu_to_le32(MRateToHwRate(pmlmeext->tx_rate));
+	}
+
+	/* 2009.11.05. tynli_test. Suggested by SD4 Filen for FW LPS. */
+	/* (1) The sequence number of each non-Qos frame / broadcast / multicast =
/ */
+	/* mgnt frame should be controled by Hw because Fw will also send null da=
ta */
+	/* which we cannot control when Fw LPS enable. */
+	/* --> default enable non-Qos data sequense number. 2010.06.23. by tynli.=
 */
+	/* (2) Enable HW SEQ control for beacon packet, because we use Hw beacon.=
 */
+	/* (3) Use HW Qos SEQ to control the seq num of Ext port non-Qos packets.=
 */
+	/* 2010.06.23. Added by tynli. */
+	if (!pattrib->qos_en) {
+		/* ptxdesc->txdw4 |=3D cpu_to_le32(BIT(7)); */ /* Hw set sequence number=
 */
+		/* ptxdesc->txdw3 |=3D cpu_to_le32((8 <<28)); */ /* set bit3 to 1. Suuge=
sted by TimChen. 2009.12.29. */
+
+		ptxdesc->txdw3 |=3D cpu_to_le32(EN_HWSEQ); /* Hw set sequence number */
+		ptxdesc->txdw4 |=3D cpu_to_le32(HW_SSN);	/* Hw set sequence number */
+
+	}
+
+#ifdef CONFIG_ANTENNA_DIVERSITY
+	odm_set_tx_ant_by_tx_info(&pHalData->odmpriv, pmem, pattrib->mac_id);
+#endif
+
+	rtl8188eu_cal_txdesc_chksum(ptxdesc);
+	_dbg_dump_tx_info(padapter, pxmitframe->frame_tag, ptxdesc);
+	return pull;
+
+}
