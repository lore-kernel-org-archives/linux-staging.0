+bool rtw_write_to_frame_mask(_adapter *adapter, u8 idx,
+			     struct  rtl_wow_pattern *context)
+{
+	u32 data =3D 0, rx_dma_buff_sz =3D 0, page_sz =3D 0;
+	u16 offset, rx_buf_ptr =3D 0;
+	u16 cam_start_offset =3D 0;
+	u16 ctrl_l =3D 0, ctrl_h =3D 0;
+	u8 count =3D 0, tmp =3D 0;
+	int res =3D 0, i =3D 0;
+
+	if (idx > MAX_WKFM_CAM_NUM) {
+		RTW_INFO("[Error]: %s, pattern index is out of range\n",
+			 __func__);
+		return false;
+	}
+
+	rtw_hal_get_def_var(adapter, HAL_DEF_RX_DMA_SZ_WOW,
+			    (u8 *)&rx_dma_buff_sz);
+
+	if (rx_dma_buff_sz =3D=3D 0) {
+		RTW_INFO("[Error]: %s, rx_dma_buff_sz is 0!!\n", __func__);
+		return false;
+	}
+
+	rtw_hal_get_def_var(adapter, HAL_DEF_RX_PAGE_SIZE, (u8 *)&page_sz);
+
+	if (page_sz =3D=3D 0) {
+		RTW_INFO("[Error]: %s, page_sz is 0!!\n", __func__);
+		return false;
+	}
+
+	offset =3D (u16)PageNum(rx_dma_buff_sz, page_sz);
+
+	cam_start_offset =3D offset * page_sz;
+
+	if (IS_HARDWARE_TYPE_8188E(adapter)) {
+		ctrl_l =3D 0x0001;
+		ctrl_h =3D 0x0001;
+	} else {
+		ctrl_l =3D 0x0f01;
+		ctrl_h =3D 0xf001;
+	}
+
+	/* Enable RX packet buffer access */
+	rtw_write8(adapter, REG_PKT_BUFF_ACCESS_CTRL, RXPKT_BUF_SELECT);
+
+	/* Write the WKFM CAM */
+	for (i =3D 0; i < WKFMCAM_ADDR_NUM; i++) {
+		/*
+		 * Set Rx packet buffer offset.
+		 * RxBufer pointer increases 1, we can access 8 bytes in Rx packet buffe=
r.
+		 * CAM start offset (unit: 1 byte) =3D  Index*WKFMCAM_SIZE
+		 * RxBufer pointer addr =3D (CAM start offset + per entry offset of a WK=
FMCAM)/8
+		 * * Index: The index of the wake up frame mask
+		 * * WKFMCAM_SIZE: the total size of one WKFM CAM
+		 * * per entry offset of a WKFM CAM: Addr i * 4 bytes
+		 */
+		rx_buf_ptr =3D
+			(cam_start_offset + idx * WKFMCAM_SIZE + i * 4) >> 3;
+		rtw_write16(adapter, REG_PKTBUF_DBG_CTRL, rx_buf_ptr);
+
+		if (i =3D=3D 0) {
+			if (context->type =3D=3D PATTERN_VALID)
+				data =3D BIT(31);
+			else if (context->type =3D=3D PATTERN_BROADCAST)
+				data =3D BIT(31) | BIT(26);
+			else if (context->type =3D=3D PATTERN_MULTICAST)
+				data =3D BIT(31) | BIT(25);
+			else if (context->type =3D=3D PATTERN_UNICAST)
+				data =3D BIT(31) | BIT(24);
+
+			if (context->crc !=3D 0)
+				data |=3D context->crc;
+
+			rtw_write32(adapter, REG_PKTBUF_DBG_DATA_L, data);
+			rtw_write16(adapter, REG_RXPKTBUF_CTRL, ctrl_l);
+		} else if (i =3D=3D 1) {
+			data =3D 0;
+			rtw_write32(adapter, REG_PKTBUF_DBG_DATA_H, data);
+			rtw_write16(adapter, REG_RXPKTBUF_CTRL, ctrl_h);
+		} else if (i =3D=3D 2 || i =3D=3D 4) {
+			data =3D context->mask[i - 2];
+			rtw_write32(adapter, REG_PKTBUF_DBG_DATA_L, data);
+			/* write to RX packet buffer*/
+			rtw_write16(adapter, REG_RXPKTBUF_CTRL, ctrl_l);
+		} else if (i =3D=3D 3 || i =3D=3D 5) {
+			data =3D context->mask[i - 2];
+			rtw_write32(adapter, REG_PKTBUF_DBG_DATA_H, data);
+			/* write to RX packet buffer*/
+			rtw_write16(adapter, REG_RXPKTBUF_CTRL, ctrl_h);
+		}
+
+		count =3D 0;
+		do {
+			tmp =3D rtw_read8(adapter, REG_RXPKTBUF_CTRL);
+			rtw_udelay_os(2);
+			count++;
+		} while (tmp && count < 100);
+
+		if (count >=3D 100)
+			res =3D false;
+		else
+			res =3D true;
+	}
+
+	/* Disable RX packet buffer access */
+	rtw_write8(adapter, REG_PKT_BUFF_ACCESS_CTRL,
+		   DISABLE_TRXPKT_BUF_ACCESS);
+
+	return res;
+}
+void rtw_clean_pattern(_adapter *adapter)
+{
+	struct pwrctrl_priv *pwrctl =3D adapter_to_pwrctl(adapter);
+	struct rtl_wow_pattern zero_pattern;
+	int i =3D 0;
+
+	memset(&zero_pattern, 0, sizeof(struct rtl_wow_pattern));
+
+	zero_pattern.type =3D PATTERN_INVALID;
+
+	for (i =3D 0; i < MAX_WKFM_CAM_NUM; i++)
+		rtw_write_to_frame_mask(adapter, i, &zero_pattern);
+
+	rtw_write8(adapter, REG_WKFMCAM_NUM, 0);
+}
+static int rtw_hal_set_pattern(_adapter *adapter, u8 *pattern,
+			       u8 len, u8 *mask, u8 idx)
+{
+	struct pwrctrl_priv *pwrctl =3D adapter_to_pwrctl(adapter);
+	struct mlme_ext_priv *pmlmeext =3D NULL;
+	struct mlme_ext_info *pmlmeinfo =3D NULL;
+	struct rtl_wow_pattern wow_pattern;
+	u8 mask_hw[MAX_WKFM_SIZE] =3D {0};
+	u8 content[MAX_WKFM_PATTERN_SIZE] =3D {0};
+	u8 broadcast_addr[6] =3D {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+	u8 multicast_addr1[2] =3D {0x33, 0x33};
+	u8 multicast_addr2[3] =3D {0x01, 0x00, 0x5e};
+	u8 res =3D false, index =3D 0, mask_len =3D 0;
+	u8 mac_addr[ETH_ALEN] =3D {0};
+	u16 count =3D 0;
+	int i, j;
+
+	if (pwrctl->wowlan_pattern_idx > MAX_WKFM_CAM_NUM) {
+		RTW_INFO("%s pattern_idx is more than MAX_FMC_NUM: %d\n",
+			 __func__, MAX_WKFM_CAM_NUM);
+		return false;
+	}
+
+	pmlmeext =3D &adapter->mlmeextpriv;
+	pmlmeinfo =3D &pmlmeext->mlmext_info;
+	memcpy(mac_addr, adapter_mac_addr(adapter), ETH_ALEN);
+	memset(&wow_pattern, 0, sizeof(struct rtl_wow_pattern));
+
+	mask_len =3D DIV_ROUND_UP(len, 8);
+
+	/* 1. setup A1 table */
+	if (memcmp(pattern, broadcast_addr, ETH_ALEN) =3D=3D 0)
+		wow_pattern.type =3D PATTERN_BROADCAST;
+	else if (memcmp(pattern, multicast_addr1, 2) =3D=3D 0)
+		wow_pattern.type =3D PATTERN_MULTICAST;
+	else if (memcmp(pattern, multicast_addr2, 3) =3D=3D 0)
+		wow_pattern.type =3D PATTERN_MULTICAST;
+	else if (memcmp(pattern, mac_addr, ETH_ALEN) =3D=3D 0)
+		wow_pattern.type =3D PATTERN_UNICAST;
+	else
+		wow_pattern.type =3D PATTERN_INVALID;
+
+	/* translate mask from os to mask for hw */
+
+/*************************************************************************=
*****
+ * pattern from OS uses 'ethenet frame', like this:
+
+	|    6   |    6   |   2  |     20    |  Variable  |  4  |
+	|--------+--------+------+-----------+------------+-----|
+	|    802.3 Mac Header    | IP Header | TCP Packet | FCS |
+	|   DA   |   SA   | Type |
+
+ * BUT, packet catched by our HW is in '802.11 frame', begin from LLC,
+
+	|     24 or 30      |    6   |   2  |     20    |  Variable  |  4  |
+	|-------------------+--------+------+-----------+------------+-----|
+	| 802.11 MAC Header |       LLC     | IP Header | TCP Packet | FCS |
+			    | Others | Tpye |
+
+ * Therefore, we need translate mask_from_OS to mask_to_hw.
+ * We should left-shift mask by 6 bits, then set the new bit[0~5] =3D 0,
+ * because new mask[0~5] means 'SA', but our HW packet begins from LLC,
+ * bit[0~5] corresponds to first 6 Bytes in LLC, they just don't match.
+ *************************************************************************=
*****/
+	/* Shift 6 bits */
+	for (i =3D 0; i < mask_len - 1; i++) {
+		mask_hw[i] =3D mask[i] >> 6;
+		mask_hw[i] |=3D (mask[i + 1] & 0x3F) << 2;
+	}
+
+	mask_hw[i] =3D (mask[i] >> 6) & 0x3F;
+	/* Set bit 0-5 to zero */
+	mask_hw[0] &=3D 0xC0;
+
+	for (i =3D 0; i < (MAX_WKFM_SIZE / 4); i++) {
+		wow_pattern.mask[i] =3D mask_hw[i * 4];
+		wow_pattern.mask[i] |=3D (mask_hw[i * 4 + 1] << 8);
+		wow_pattern.mask[i] |=3D (mask_hw[i * 4 + 2] << 16);
+		wow_pattern.mask[i] |=3D (mask_hw[i * 4 + 3] << 24);
+	}
+
+	/* To get the wake up pattern from the mask.
+	 * We do not count first 12 bits which means
+	 * DA[6] and SA[6] in the pattern to match HW design. */
+	count =3D 0;
+	for (i =3D 12; i < len; i++) {
+		if ((mask[i / 8] >> (i % 8)) & 0x01) {
+			content[count] =3D pattern[i];
+			count++;
+		}
+	}
+
+	wow_pattern.crc =3D rtw_calc_crc(content, count);
+
+	if (wow_pattern.crc !=3D 0) {
+		if (wow_pattern.type =3D=3D PATTERN_INVALID)
+			wow_pattern.type =3D PATTERN_VALID;
+	}
+
+	index =3D idx;
+
+	if (!pwrctl->bInSuspend)
+		index +=3D 2;
+
+	/* write pattern */
+	res =3D rtw_write_to_frame_mask(adapter, index, &wow_pattern);
+
+	if (res =3D=3D false)
+		RTW_INFO("%s: ERROR!! idx: %d write_to_frame_mask_cam fail\n",
+			 __func__, idx);
+
+	return res;
+}
