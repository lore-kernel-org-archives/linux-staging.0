+ * license.
+ *
+ * See README and COPYING for more details.
+ */
+
+#include "includes.h"
+
+#include "common.h"
+#include "aes.h"
+#include "aes_wrap.h"
+
+/**
+ * aes_wrap - Wrap keys with AES Key Wrap Algorithm (128-bit KEK) (RFC3394)
+ * @kek: 16-octet Key encryption key (KEK)
+ * @n: Length of the plaintext key in 64-bit units; e.g., 2 =3D 128-bit =
=3D 16
+ * bytes
+ * @plain: Plaintext key to be wrapped, n * 64 bits
+ * @cipher: Wrapped key, (n + 1) * 64 bits
+ * Returns: 0 on success, -1 on failure
+ */
+int aes_wrap(const u8 *kek, int n, const u8 *plain, u8 *cipher)
+{
+	u8 *a, *r, b[16];
+	int i, j;
+	void *ctx;
+
+	a =3D cipher;
+	r =3D cipher + 8;
+
+	/* 1) Initialize variables. */
+	os_memset(a, 0xa6, 8);
+	os_memcpy(r, plain, 8 * n);
+
+	ctx =3D aes_encrypt_init(kek, 16);
+	if (ctx =3D=3D NULL)
+		return -1;
+
+	/* 2) Calculate intermediate values.
+	 * For j =3D 0 to 5
+	 *     For i=3D1 to n
+	 *         B =3D AES(K, A | R[i])
+	 *         A =3D MSB(64, B) ^ t where t =3D (n*j)+i
+	 *         R[i] =3D LSB(64, B)
+	 */
+	for (j =3D 0; j <=3D 5; j++) {
+		r =3D cipher + 8;
+		for (i =3D 1; i <=3D n; i++) {
+			os_memcpy(b, a, 8);
+			os_memcpy(b + 8, r, 8);
+			aes_encrypt(ctx, b, b);
+			os_memcpy(a, b, 8);
+			a[7] ^=3D n * j + i;
+			os_memcpy(r, b + 8, 8);
+			r +=3D 8;
+		}
+	}
+	aes_encrypt_deinit(ctx);
+
+	/* 3) Output the results.
+	 *
+	 * These are already in @cipher due to the location of temporary
+	 * variables.
+	 */
+
+	return 0;
+}
