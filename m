+void rtw_add_bcn_ie(_adapter *padapter, WLAN_BSSID_EX *pnetwork, u8 index,=
 u8 *data, u8 len)
+{
+	PNDIS_802_11_VARIABLE_IEs	pIE;
+	u8	bmatch =3D false;
+	u8	*pie =3D pnetwork->IEs;
+	u8	*p =3D NULL, *dst_ie =3D NULL, *premainder_ie =3D NULL, *pbackup_remai=
nder_ie =3D NULL;
+	u32	i, offset, ielen, ie_offset, remainder_ielen =3D 0;
+
+	for (i =3D sizeof(NDIS_802_11_FIXED_IEs); i < pnetwork->IELength;) {
+		pIE =3D (PNDIS_802_11_VARIABLE_IEs)(pnetwork->IEs + i);
+
+		if (pIE->ElementID > index)
+			break;
+		else if (pIE->ElementID =3D=3D index) { /* already exist the same IE */
+			p =3D (u8 *)pIE;
+			ielen =3D pIE->Length;
+			bmatch =3D true;
+			break;
+		}
+
+		p =3D (u8 *)pIE;
+		ielen =3D pIE->Length;
+		i +=3D (pIE->Length + 2);
+	}
+
+	if (p !=3D NULL && ielen > 0) {
+		ielen +=3D 2;
+
+		premainder_ie =3D p + ielen;
+
+		ie_offset =3D (sint)(p - pie);
+
+		remainder_ielen =3D pnetwork->IELength - ie_offset - ielen;
+
+		if (bmatch)
+			dst_ie =3D p;
+		else
+			dst_ie =3D (p + ielen);
+	}
+
+	if (dst_ie =3D=3D NULL)
+		return;
+
+	if (remainder_ielen > 0) {
+		pbackup_remainder_ie =3D rtw_malloc(remainder_ielen);
+		if (pbackup_remainder_ie && premainder_ie)
+			memcpy(pbackup_remainder_ie, premainder_ie, remainder_ielen);
+	}
+
+	*dst_ie++ =3D index;
+	*dst_ie++ =3D len;
+
+	memcpy(dst_ie, data, len);
+	dst_ie +=3D len;
+
+	/* copy remainder IE */
+	if (pbackup_remainder_ie) {
+		memcpy(dst_ie, pbackup_remainder_ie, remainder_ielen);
+
+		rtw_mfree(pbackup_remainder_ie, remainder_ielen);
+	}
+
+	offset =3D (uint)(dst_ie - pie);
+	pnetwork->IELength =3D offset + remainder_ielen;
+}
