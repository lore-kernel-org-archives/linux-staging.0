+int rtw_mp_pretx_proc(PADAPTER padapter, u8 bStartTest, char *extra)
+{
+	HAL_DATA_TYPE	*pHalData	=3D GET_HAL_DATA(padapter);
+	struct mp_priv *pmp_priv =3D &padapter->mppriv;
+	PMPT_CONTEXT		pMptCtx =3D &(padapter->mppriv.mpt_ctx);
+
+	switch (pmp_priv->mode) {
+
+	case MP_PACKET_TX:
+		if (bStartTest =3D=3D 0) {
+			pmp_priv->tx.stop =3D 1;
+			pmp_priv->mode =3D MP_ON;
+			sprintf(extra, "Stop continuous Tx");
+		} else if (pmp_priv->tx.stop =3D=3D 1) {
+			sprintf(extra + strlen(extra), "\nStart continuous DA=3Dffffffffffff le=
n=3D1500 count=3D%u\n", pmp_priv->tx.count);
+			pmp_priv->tx.stop =3D 0;
+			SetPacketTx(padapter);
+		} else
+			return -EFAULT;
+		return 0;
+	case MP_SINGLE_TONE_TX:
+		if (bStartTest !=3D 0)
+			sprintf(extra + strlen(extra), "\nStart continuous DA=3Dffffffffffff le=
n=3D1500\n infinite=3Dyes.");
+		SetSingleToneTx(padapter, (u8)bStartTest);
+		break;
+	case MP_CONTINUOUS_TX:
+		if (bStartTest !=3D 0)
+			sprintf(extra + strlen(extra), "\nStart continuous DA=3Dffffffffffff le=
n=3D1500\n infinite=3Dyes.");
+		SetContinuousTx(padapter, (u8)bStartTest);
+		break;
+	case MP_CARRIER_SUPPRISSION_TX:
+		if (bStartTest !=3D 0) {
+			if (HwRateToMPTRate(pmp_priv->rateidx) <=3D MPT_RATE_11M)
+				sprintf(extra + strlen(extra), "\nStart continuous DA=3Dffffffffffff l=
en=3D1500\n infinite=3Dyes.");
+			else
+				sprintf(extra + strlen(extra), "\nSpecify carrier suppression but not =
CCK rate");
+		}
+		SetCarrierSuppressionTx(padapter, (u8)bStartTest);
+		break;
+	case MP_SINGLE_CARRIER_TX:
+		if (bStartTest !=3D 0)
+			sprintf(extra + strlen(extra), "\nStart continuous DA=3Dffffffffffff le=
n=3D1500\n infinite=3Dyes.");
+		SetSingleCarrierTx(padapter, (u8)bStartTest);
+		break;
+
+	default:
+		sprintf(extra, "Error! Continuous-Tx is not on-going.");
+		return -EFAULT;
+	}
+
+	if (bStartTest =3D=3D 1 && pmp_priv->mode !=3D MP_ON) {
+		struct mp_priv *pmp_priv =3D &padapter->mppriv;
+
+		if (pmp_priv->tx.stop =3D=3D 0) {
+			pmp_priv->tx.stop =3D 1;
+			rtw_msleep_os(5);
+		}
+		pmp_priv->tx.attrib.ht_en =3D 1;
+		pmp_priv->tx.stop =3D 0;
+		pmp_priv->tx.count =3D 1;
+		SetPacketTx(padapter);
+	} else
+		pmp_priv->mode =3D MP_ON;
+
+	return 0;
+}
