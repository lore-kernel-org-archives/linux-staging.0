+	int len =3D 0, ret;
+	u32 pairwise =3D 0;
+
+	if (sm =3D=3D NULL)
+		return 0;
+
+	/* TODO: FF-FF-FF-FF-FF-FF entry for broadcast/multicast stats */
+
+	/* dot11RSNAStatsEntry */
+
+	if (sm->wpa =3D=3D WPA_VERSION_WPA) {
+		if (sm->pairwise =3D=3D WPA_CIPHER_CCMP)
+			pairwise =3D WPA_CIPHER_SUITE_CCMP;
+		else if (sm->pairwise =3D=3D WPA_CIPHER_TKIP)
+			pairwise =3D WPA_CIPHER_SUITE_TKIP;
+		else if (sm->pairwise =3D=3D WPA_CIPHER_WEP104)
+			pairwise =3D WPA_CIPHER_SUITE_WEP104;
+		else if (sm->pairwise =3D=3D WPA_CIPHER_WEP40)
+			pairwise =3D WPA_CIPHER_SUITE_WEP40;
+		else if (sm->pairwise =3D=3D WPA_CIPHER_NONE)
+			pairwise =3D WPA_CIPHER_SUITE_NONE;
+	} else if (sm->wpa =3D=3D WPA_VERSION_WPA2) {
+		if (sm->pairwise =3D=3D WPA_CIPHER_CCMP)
+			pairwise =3D RSN_CIPHER_SUITE_CCMP;
+		else if (sm->pairwise =3D=3D WPA_CIPHER_TKIP)
+			pairwise =3D RSN_CIPHER_SUITE_TKIP;
+		else if (sm->pairwise =3D=3D WPA_CIPHER_WEP104)
+			pairwise =3D RSN_CIPHER_SUITE_WEP104;
+		else if (sm->pairwise =3D=3D WPA_CIPHER_WEP40)
+			pairwise =3D RSN_CIPHER_SUITE_WEP40;
+		else if (sm->pairwise =3D=3D WPA_CIPHER_NONE)
+			pairwise =3D RSN_CIPHER_SUITE_NONE;
+	} else
+		return 0;
+
+	ret =3D os_snprintf(
+		buf + len, buflen - len,
+		/* TODO: dot11RSNAStatsIndex */
+		"dot11RSNAStatsSTAAddress=3D" MACSTR "\n"
+		"dot11RSNAStatsVersion=3D1\n"
+		"dot11RSNAStatsSelectedPairwiseCipher=3D" RSN_SUITE "\n"
+		/* TODO: dot11RSNAStatsTKIPICVErrors */
+		"dot11RSNAStatsTKIPLocalMICFailures=3D%u\n"
+		"dot11RSNAStatsTKIPRemoteMICFailures=3D%u\n"
+		/* TODO: dot11RSNAStatsCCMPReplays */
+		/* TODO: dot11RSNAStatsCCMPDecryptErrors */
+		/* TODO: dot11RSNAStatsTKIPReplays */,
+		MAC2STR(sm->addr),
+		RSN_SUITE_ARG(pairwise),
+		sm->dot11RSNAStatsTKIPLocalMICFailures,
+		sm->dot11RSNAStatsTKIPRemoteMICFailures);
+	if (ret < 0 || (size_t) ret >=3D buflen - len)
+		return len;
+	len +=3D ret;
+
+	/* Private MIB */
+	ret =3D os_snprintf(buf + len, buflen - len,
+			  "hostapdWPAPTKState=3D%d\n"
+			  "hostapdWPAPTKGroupState=3D%d\n",
+			  sm->wpa_ptk_state,
+			  sm->wpa_ptk_group_state);
+	if (ret < 0 || (size_t) ret >=3D buflen - len)
+		return len;
+	len +=3D ret;
+
+	return len;
