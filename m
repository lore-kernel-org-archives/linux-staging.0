+static int hostapd_ctrl_iface_wps_check_pin(
+	struct hostapd_data *hapd, char *cmd, char *buf, size_t buflen)
+{
+	char pin[9];
+	size_t len;
+	char *pos;
+	int ret;
+
+	wpa_hexdump_ascii_key(MSG_DEBUG, "WPS_CHECK_PIN",
+			      (u8 *) cmd, os_strlen(cmd));
+	for (pos =3D cmd, len =3D 0; *pos !=3D '\0'; pos++) {
+		if (*pos < '0' || *pos > '9')
+			continue;
+		pin[len++] =3D *pos;
+		if (len =3D=3D 9) {
+			wpa_printf(MSG_DEBUG, "WPS: Too long PIN");
+			return -1;
+		}
+	}
+	if (len !=3D 4 && len !=3D 8) {
+		wpa_printf(MSG_DEBUG, "WPS: Invalid PIN length %d", (int) len);
+		return -1;
+	}
+	pin[len] =3D '\0';
+
+	if (len =3D=3D 8) {
+		unsigned int pin_val;
+		pin_val =3D atoi(pin);
+		if (!wps_pin_valid(pin_val)) {
+			wpa_printf(MSG_DEBUG, "WPS: Invalid checksum digit");
+			ret =3D os_snprintf(buf, buflen, "FAIL-CHECKSUM\n");
+			if (ret < 0 || (size_t) ret >=3D buflen)
+				return -1;
+			return ret;
+		}
+	}
+
+	ret =3D os_snprintf(buf, buflen, "%s", pin);
+	if (ret < 0 || (size_t) ret >=3D buflen)
+		return -1;
+
+	return ret;
+}
