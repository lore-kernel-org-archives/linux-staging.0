+
+	addr =3D ((base)*page_size) / 8;
+	for (i =3D 0 ; i < page_num * count ; i +=3D 2) {
+		rtw_write32(padapter, 0x140, addr + i);
+		printk(" %08x %08x ", rtw_read32(padapter, 0x144), rtw_read32(padapter, =
0x148));
