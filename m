+	if (ret < 0 || (size_t) ret >=3D buflen - len)
+		return len;
+	len +=3D ret;
+
+	/* dot1xAuthDiagTable */
+	ret =3D os_snprintf(buf + len, buflen - len,
+			  "dot1xAuthEntersConnecting=3D%u\n"
+			  "dot1xAuthEapLogoffsWhileConnecting=3D%u\n"
+			  "dot1xAuthEntersAuthenticating=3D%u\n"
+			  "dot1xAuthAuthSuccessesWhileAuthenticating=3D%u\n"
+			  "dot1xAuthAuthTimeoutsWhileAuthenticating=3D%u\n"
+			  "dot1xAuthAuthFailWhileAuthenticating=3D%u\n"
+			  "dot1xAuthAuthEapStartsWhileAuthenticating=3D%u\n"
+			  "dot1xAuthAuthEapLogoffWhileAuthenticating=3D%u\n"
+			  "dot1xAuthAuthReauthsWhileAuthenticated=3D%u\n"
+			  "dot1xAuthAuthEapStartsWhileAuthenticated=3D%u\n"
+			  "dot1xAuthAuthEapLogoffWhileAuthenticated=3D%u\n"
+			  "dot1xAuthBackendResponses=3D%u\n"
