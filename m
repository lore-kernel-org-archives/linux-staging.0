+u8 rtw_hal_dl_mcc_fw_rsvd_page(_adapter *adapter, u8 *pframe, u16 *index,
+	u8 tx_desc, u32 page_size, u8 *page_num, u32 *total_pkt_len,
+		RSVDPAGE_LOC *rsvd_page_loc)
+{
+	u32 len =3D 0;
+	_adapter *iface =3D NULL;
+	struct dvobj_priv *dvobj =3D adapter_to_dvobj(adapter);
+	struct mcc_obj_priv *pmccobjpriv =3D &(dvobj->mcc_objpriv);
+	struct mlme_ext_info *pmlmeinfo =3D NULL;
+	struct mlme_ext_priv *pmlmeext =3D NULL;
+	u8 ret =3D _SUCCESS, i =3D 0, order =3D 0, CurtPktPageNum =3D 0;
+	u8 bssid[ETH_ALEN] =3D {0};
+
+	/* check proccess mcc start setting */
+	if (!rtw_hal_check_mcc_status(adapter, MCC_STATUS_PROCESS_MCC_START_SETTI=
NG)) {
+		ret =3D _FAIL;
+		goto exit;
+	}
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+		iface =3D dvobj->padapters[i];
+		if (iface =3D=3D NULL)
+			continue;
+
+		order =3D iface->mcc_adapterpriv.order;
+		dvobj->mcc_objpriv.mcc_loc_rsvd_paga[order] =3D *page_num;
+
+		switch (iface->mcc_adapterpriv.role) {
+		case MCC_ROLE_STA:
+		case MCC_ROLE_GC:
+			/* Build NULL DATA */
+			RTW_INFO("LocNull(order:%d): %d\n"
+				, order, dvobj->mcc_objpriv.mcc_loc_rsvd_paga[order]);
+			len =3D 0;
+			pmlmeext =3D &iface->mlmeextpriv;
+			pmlmeinfo =3D &pmlmeext->mlmext_info;
+
+			memcpy(bssid, get_my_bssid(&pmlmeinfo->network), ETH_ALEN);
+			rtw_hal_construct_NullFunctionData(iface
+				, &pframe[*index], &len, bssid, false, 0, 0, false);
+			rtw_hal_fill_fake_txdesc(iface, &pframe[*index-tx_desc],
+				len, false, false, false);
+
+			CurtPktPageNum =3D (u8)PageNum(tx_desc + len, page_size);
+			*page_num +=3D CurtPktPageNum;
+			*index +=3D (CurtPktPageNum * page_size);
+			*total_pkt_len =3D *index + len;
+			break;
+		case MCC_ROLE_AP:
+			/* Bulid CTS */
+			RTW_INFO("LocCTS(order:%d): %d\n"
+				, order, dvobj->mcc_objpriv.mcc_loc_rsvd_paga[order]);
+
+			len =3D 0;
+			rtw_hal_construct_CTS(iface, &pframe[*index], &len);
+			rtw_hal_fill_fake_txdesc(iface, &pframe[*index-tx_desc],
+				len, false, false, false);
+
+			CurtPktPageNum =3D (u8)PageNum(tx_desc + len, page_size);
+			*page_num +=3D CurtPktPageNum;
+			*index +=3D (CurtPktPageNum * page_size);
+			*total_pkt_len =3D *index + len;
+			break;
+		case MCC_ROLE_GO:
+		/* To DO */
+			break;
+		}
+	}
+exit:
+	return ret;
+}
