+/**
+ * x509_name_string - Convert an X.509 certificate name into a string
+ * @name: Name to convert
+ * @buf: Buffer for the string
+ * @len: Maximum buffer length
+ */
+void x509_name_string(struct x509_name *name, char *buf, size_t len)
+{
+	char *pos, *end;
+	int ret;
+	size_t i;
+
+	if (len =3D=3D 0)
+		return;
+
+	pos =3D buf;
+	end =3D buf + len;
+
+	for (i =3D 0; i < name->num_attr; i++) {
+		ret =3D os_snprintf(pos, end - pos, "%s=3D%s, ",
+				  x509_name_attr_str(name->attr[i].type),
+				  name->attr[i].value);
+		if (ret < 0 || ret >=3D end - pos)
+			goto done;
+		pos +=3D ret;
+	}
+
+	if (pos > buf + 1 && pos[-1] =3D=3D ' ' && pos[-2] =3D=3D ',') {
+		pos--;
+		*pos =3D '\0';
+		pos--;
+		*pos =3D '\0';
+	}
+
+	if (name->email) {
+		ret =3D os_snprintf(pos, end - pos, "/emailAddress=3D%s",
+				  name->email);
+		if (ret < 0 || ret >=3D end - pos)
+			goto done;
+		pos +=3D ret;
+	}
+
+done:
+	end[-1] =3D '\0';
+}
