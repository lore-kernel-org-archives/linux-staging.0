+
+static int scard_get_record_len(struct scard_data *scard, unsigned char re=
cnum,
+				unsigned char mode)
+{
+	unsigned char buf[255];
+	unsigned char cmd[5] =3D { SIM_CMD_READ_RECORD /* , len */ };
+	size_t blen;
+	long ret;
+
+	if (scard->sim_type =3D=3D SCARD_USIM)
+		cmd[0] =3D USIM_CLA;
+	cmd[2] =3D recnum;
+	cmd[3] =3D mode;
+	cmd[4] =3D sizeof(buf);
+
+	blen =3D sizeof(buf);
+	ret =3D scard_transmit(scard, cmd, sizeof(cmd), buf, &blen);
+	if (ret !=3D SCARD_S_SUCCESS) {
+		wpa_printf(MSG_DEBUG, "SCARD: failed to determine file "
+			   "length for record %d", recnum);
+		return -1;
+	}
+
+	wpa_hexdump(MSG_DEBUG, "SCARD: file length determination response",
+		    buf, blen);
+
+	if (blen < 2 || buf[0] !=3D 0x6c) {
+		wpa_printf(MSG_DEBUG, "SCARD: unexpected response to file "
+			   "length determination");
+		return -1;
+	}
+
+	return buf[1];
+}
+
+
+static int scard_read_record(struct scard_data *scard,
+			     unsigned char *data, size_t len,
+			     unsigned char recnum, unsigned char mode)
+{
+	unsigned char cmd[5] =3D { SIM_CMD_READ_RECORD /* , len */ };
+	size_t blen =3D len + 3;
+	unsigned char *buf;
+	long ret;
+
+	if (scard->sim_type =3D=3D SCARD_USIM)
+		cmd[0] =3D USIM_CLA;
+	cmd[2] =3D recnum;
+	cmd[3] =3D mode;
+	cmd[4] =3D len;
+
+	buf =3D os_malloc(blen);
+	if (buf =3D=3D NULL)
+		return -1;
+
+	ret =3D scard_transmit(scard, cmd, sizeof(cmd), buf, &blen);
+	if (ret !=3D SCARD_S_SUCCESS) {
+		os_free(buf);
+		return -2;
+	}
+	if (blen !=3D len + 2) {
+		wpa_printf(MSG_DEBUG, "SCARD: record read returned unexpected "
+			   "length %ld (expected %ld)",
+			   (long) blen, (long) len + 2);
+		os_free(buf);
+		return -3;
+	}
+
+	if (buf[len] !=3D 0x90 || buf[len + 1] !=3D 0x00) {
+		wpa_printf(MSG_DEBUG, "SCARD: record read returned unexpected "
+			   "status %02x %02x (expected 90 00)",
+			   buf[len], buf[len + 1]);
+		os_free(buf);
+		return -4;
+	}
+
+	os_memcpy(data, buf, len);
+	os_free(buf);
+
+	return 0;
+}
+
+
+static int scard_read_file(struct scard_data *scard,
+			   unsigned char *data, size_t len)
+{
+	unsigned char cmd[5] =3D { SIM_CMD_READ_BIN /* , len */ };
+	size_t blen =3D len + 3;
+	unsigned char *buf;
+	long ret;
+
+	cmd[4] =3D len;
+
+	buf =3D os_malloc(blen);
+	if (buf =3D=3D NULL)
+		return -1;
+
+	if (scard->sim_type =3D=3D SCARD_USIM)
+		cmd[0] =3D USIM_CLA;
+	ret =3D scard_transmit(scard, cmd, sizeof(cmd), buf, &blen);
+	if (ret !=3D SCARD_S_SUCCESS) {
+		os_free(buf);
+		return -2;
+	}
+	if (blen !=3D len + 2) {
+		wpa_printf(MSG_DEBUG, "SCARD: file read returned unexpected "
+			   "length %ld (expected %ld)",
+			   (long) blen, (long) len + 2);
+		os_free(buf);
+		return -3;
+	}
+
+	if (buf[len] !=3D 0x90 || buf[len + 1] !=3D 0x00) {
+		wpa_printf(MSG_DEBUG, "SCARD: file read returned unexpected "
+			   "status %02x %02x (expected 90 00)",
+			   buf[len], buf[len + 1]);
+		os_free(buf);
+		return -4;
+	}
+
+	os_memcpy(data, buf, len);
+	os_free(buf);
+
+	return 0;
+}
+
+
+static int scard_verify_pin(struct scard_data *scard, const char *pin)
+{
+	long ret;
+	unsigned char resp[3];
+	unsigned char cmd[5 + 8] =3D { SIM_CMD_VERIFY_CHV1 };
+	size_t len;
+
+	wpa_printf(MSG_DEBUG, "SCARD: verifying PIN");
+
+	if (pin =3D=3D NULL || os_strlen(pin) > 8)
+		return -1;
+
+	if (scard->sim_type =3D=3D SCARD_USIM)
+		cmd[0] =3D USIM_CLA;
+	os_memcpy(cmd + 5, pin, os_strlen(pin));
+	os_memset(cmd + 5 + os_strlen(pin), 0xff, 8 - os_strlen(pin));
+
+	len =3D sizeof(resp);
+	ret =3D scard_transmit(scard, cmd, sizeof(cmd), resp, &len);
+	if (ret !=3D SCARD_S_SUCCESS)
+		return -2;
+
+	if (len !=3D 2 || resp[0] !=3D 0x90 || resp[1] !=3D 0x00) {
+		wpa_printf(MSG_WARNING, "SCARD: PIN verification failed");
+		return -1;
+	}
+
+	wpa_printf(MSG_DEBUG, "SCARD: PIN verified successfully");
+	return 0;
+}
+
+
+/**
+ * scard_get_imsi - Read IMSI from SIM/USIM card
+ * @scard: Pointer to private data from scard_init()
+ * @imsi: Buffer for IMSI
+ * @len: Length of imsi buffer; set to IMSI length on success
+ * Returns: 0 on success, -1 if IMSI file cannot be selected, -2 if IMSI f=
ile
+ * selection returns invalid result code, -3 if parsing FSP template file =
fails
+ * (USIM only), -4 if IMSI does not fit in the provided imsi buffer (len i=
s set
+ * to needed length), -5 if reading IMSI file fails.
+ *
+ * This function can be used to read IMSI from the SIM/USIM card. If the I=
MSI
+ * file is PIN protected, scard_set_pin() must have been used to set the
+ * correct PIN code before calling scard_get_imsi().
+ */
+int scard_get_imsi(struct scard_data *scard, char *imsi, size_t *len)
+{
+	unsigned char buf[100];
+	size_t blen, imsilen, i;
+	char *pos;
+
+	wpa_printf(MSG_DEBUG, "SCARD: reading IMSI from (GSM) EF-IMSI");
+	blen =3D sizeof(buf);
+	if (scard_select_file(scard, SCARD_FILE_GSM_EF_IMSI, buf, &blen))
+		return -1;
+	if (blen < 4) {
+		wpa_printf(MSG_WARNING, "SCARD: too short (GSM) EF-IMSI "
+			   "header (len=3D%ld)", (long) blen);
+		return -2;
+	}
+
+	if (scard->sim_type =3D=3D SCARD_GSM_SIM) {
+		blen =3D (buf[2] << 8) | buf[3];
+	} else {
+		int file_size;
+		if (scard_parse_fsp_templ(buf, blen, NULL, &file_size))
+			return -3;
+		blen =3D file_size;
+	}
+	if (blen < 2 || blen > sizeof(buf)) {
+		wpa_printf(MSG_DEBUG, "SCARD: invalid IMSI file length=3D%ld",
+			   (long) blen);
+		return -3;
+	}
+
+	imsilen =3D (blen - 2) * 2 + 1;
+	wpa_printf(MSG_DEBUG, "SCARD: IMSI file length=3D%ld imsilen=3D%ld",
+		   (long) blen, (long) imsilen);
+	if (blen < 2 || imsilen > *len) {
+		*len =3D imsilen;
+		return -4;
+	}
+
+	if (scard_read_file(scard, buf, blen))
+		return -5;
+
+	pos =3D imsi;
+	*pos++ =3D '0' + (buf[1] >> 4 & 0x0f);
+	for (i =3D 2; i < blen; i++) {
+		unsigned char digit;
+
+		digit =3D buf[i] & 0x0f;
+		if (digit < 10)
+			*pos++ =3D '0' + digit;
+		else
+			imsilen--;
+
+		digit =3D buf[i] >> 4 & 0x0f;
+		if (digit < 10)
+			*pos++ =3D '0' + digit;
+		else
+			imsilen--;
+	}
+	*len =3D imsilen;
+
+	return 0;
+}
+
+
+/**
+ * scard_gsm_auth - Run GSM authentication command on SIM card
+ * @scard: Pointer to private data from scard_init()
+ * @_rand: 16-byte RAND value from HLR/AuC
+ * @sres: 4-byte buffer for SRES
+ * @kc: 8-byte buffer for Kc
+ * Returns: 0 on success, -1 if SIM/USIM connection has not been initializ=
ed,
+ * -2 if authentication command execution fails, -3 if unknown response co=
de
+ * for authentication command is received, -4 if reading of response fails,
+ * -5 if if response data is of unexpected length
+ *
+ * This function performs GSM authentication using SIM/USIM card and the
+ * provided RAND value from HLR/AuC. If authentication command can be comp=
leted
+ * successfully, SRES and Kc values will be written into sres and kc buffe=
rs.
+ */
+int scard_gsm_auth(struct scard_data *scard, const unsigned char *_rand,
+		   unsigned char *sres, unsigned char *kc)
+{
+	unsigned char cmd[5 + 1 + 16] =3D { SIM_CMD_RUN_GSM_ALG };
+	int cmdlen;
+	unsigned char get_resp[5] =3D { SIM_CMD_GET_RESPONSE };
+	unsigned char resp[3], buf[12 + 3 + 2];
+	size_t len;
+	long ret;
+
+	if (scard =3D=3D NULL)
+		return -1;
+
+	wpa_hexdump(MSG_DEBUG, "SCARD: GSM auth - RAND", _rand, 16);
+	if (scard->sim_type =3D=3D SCARD_GSM_SIM) {
+		cmdlen =3D 5 + 16;
+		os_memcpy(cmd + 5, _rand, 16);
+	} else {
+		cmdlen =3D 5 + 1 + 16;
+		cmd[0] =3D USIM_CLA;
+		cmd[3] =3D 0x80;
+		cmd[4] =3D 17;
+		cmd[5] =3D 16;
+		os_memcpy(cmd + 6, _rand, 16);
+	}
+	len =3D sizeof(resp);
+	ret =3D scard_transmit(scard, cmd, cmdlen, resp, &len);
+	if (ret !=3D SCARD_S_SUCCESS)
+		return -2;
+
+	if ((scard->sim_type =3D=3D SCARD_GSM_SIM &&
+	     (len !=3D 2 || resp[0] !=3D 0x9f || resp[1] !=3D 0x0c)) ||
+	    (scard->sim_type =3D=3D SCARD_USIM &&
+	     (len !=3D 2 || resp[0] !=3D 0x61 || resp[1] !=3D 0x0e))) {
+		wpa_printf(MSG_WARNING, "SCARD: unexpected response for GSM "
+			   "auth request (len=3D%ld resp=3D%02x %02x)",
+			   (long) len, resp[0], resp[1]);
+		return -3;
+	}
+	get_resp[4] =3D resp[1];
+
+	len =3D sizeof(buf);
+	ret =3D scard_transmit(scard, get_resp, sizeof(get_resp), buf, &len);
+	if (ret !=3D SCARD_S_SUCCESS)
+		return -4;
+
+	if (scard->sim_type =3D=3D SCARD_GSM_SIM) {
+		if (len !=3D 4 + 8 + 2) {
+			wpa_printf(MSG_WARNING, "SCARD: unexpected data "
+				   "length for GSM auth (len=3D%ld, expected 14)",
+				   (long) len);
+			return -5;
+		}
+		os_memcpy(sres, buf, 4);
+		os_memcpy(kc, buf + 4, 8);
+	} else {
+		if (len !=3D 1 + 4 + 1 + 8 + 2) {
+			wpa_printf(MSG_WARNING, "SCARD: unexpected data "
+				   "length for USIM auth (len=3D%ld, "
+				   "expected 16)", (long) len);
+			return -5;
+		}
+		if (buf[0] !=3D 4 || buf[5] !=3D 8) {
+			wpa_printf(MSG_WARNING, "SCARD: unexpected SREC/Kc "
+				   "length (%d %d, expected 4 8)",
+				   buf[0], buf[5]);
+		}
+		os_memcpy(sres, buf + 1, 4);
+		os_memcpy(kc, buf + 6, 8);
+	}
+
+	wpa_hexdump(MSG_DEBUG, "SCARD: GSM auth - SRES", sres, 4);
+	wpa_hexdump(MSG_DEBUG, "SCARD: GSM auth - Kc", kc, 8);
+
+	return 0;
+}
+
+
+/**
+ * scard_umts_auth - Run UMTS authentication command on USIM card
+ * @scard: Pointer to private data from scard_init()
+ * @_rand: 16-byte RAND value from HLR/AuC
+ * @autn: 16-byte AUTN value from HLR/AuC
+ * @res: 16-byte buffer for RES
+ * @res_len: Variable that will be set to RES length
+ * @ik: 16-byte buffer for IK
+ * @ck: 16-byte buffer for CK
+ * @auts: 14-byte buffer for AUTS
+ * Returns: 0 on success, -1 on failure, or -2 if USIM reports synchroniza=
tion
+ * failure
+ *
+ * This function performs AKA authentication using USIM card and the provi=
ded
+ * RAND and AUTN values from HLR/AuC. If authentication command can be
+ * completed successfully, RES, IK, and CK values will be written into pro=
vided
+ * buffers and res_len is set to length of received RES value. If USIM rep=
orts
+ * synchronization failure, the received AUTS value will be written into a=
uts
+ * buffer. In this case, RES, IK, and CK are not valid.
+ */
+int scard_umts_auth(struct scard_data *scard, const unsigned char *_rand,
+		    const unsigned char *autn,
+		    unsigned char *res, size_t *res_len,
+		    unsigned char *ik, unsigned char *ck, unsigned char *auts)
+{
+	unsigned char cmd[5 + 1 + AKA_RAND_LEN + 1 + AKA_AUTN_LEN] =3D
+		{ USIM_CMD_RUN_UMTS_ALG };
+	unsigned char get_resp[5] =3D { USIM_CMD_GET_RESPONSE };
+	unsigned char resp[3], buf[64], *pos, *end;
+	size_t len;
+	long ret;
+
+	if (scard =3D=3D NULL)
+		return -1;
+
+	if (scard->sim_type =3D=3D SCARD_GSM_SIM) {
+		wpa_printf(MSG_ERROR, "SCARD: Non-USIM card - cannot do UMTS "
+			   "auth");
+		return -1;
+	}
+
+	wpa_hexdump(MSG_DEBUG, "SCARD: UMTS auth - RAND", _rand, AKA_RAND_LEN);
+	wpa_hexdump(MSG_DEBUG, "SCARD: UMTS auth - AUTN", autn, AKA_AUTN_LEN);
+	cmd[5] =3D AKA_RAND_LEN;
+	os_memcpy(cmd + 6, _rand, AKA_RAND_LEN);
+	cmd[6 + AKA_RAND_LEN] =3D AKA_AUTN_LEN;
+	os_memcpy(cmd + 6 + AKA_RAND_LEN + 1, autn, AKA_AUTN_LEN);
+
+	len =3D sizeof(resp);
+	ret =3D scard_transmit(scard, cmd, sizeof(cmd), resp, &len);
+	if (ret !=3D SCARD_S_SUCCESS)
+		return -1;
+
+	if (len <=3D sizeof(resp))
+		wpa_hexdump(MSG_DEBUG, "SCARD: UMTS alg response", resp, len);
+
+	if (len =3D=3D 2 && resp[0] =3D=3D 0x98 && resp[1] =3D=3D 0x62) {
+		wpa_printf(MSG_WARNING, "SCARD: UMTS auth failed - "
+			   "MAC !=3D XMAC");
+		return -1;
+	} else if (len !=3D 2 || resp[0] !=3D 0x61) {
+		wpa_printf(MSG_WARNING, "SCARD: unexpected response for UMTS "
+			   "auth request (len=3D%ld resp=3D%02x %02x)",
+			   (long) len, resp[0], resp[1]);
+		return -1;
+	}
+	get_resp[4] =3D resp[1];
+
+	len =3D sizeof(buf);
+	ret =3D scard_transmit(scard, get_resp, sizeof(get_resp), buf, &len);
+	if (ret !=3D SCARD_S_SUCCESS || len > sizeof(buf))
+		return -1;
+
+	wpa_hexdump(MSG_DEBUG, "SCARD: UMTS get response result", buf, len);
+	if (len >=3D 2 + AKA_AUTS_LEN && buf[0] =3D=3D 0xdc &&
+	    buf[1] =3D=3D AKA_AUTS_LEN) {
+		wpa_printf(MSG_DEBUG, "SCARD: UMTS Synchronization-Failure");
+		os_memcpy(auts, buf + 2, AKA_AUTS_LEN);
+		wpa_hexdump(MSG_DEBUG, "SCARD: AUTS", auts, AKA_AUTS_LEN);
+		return -2;
+	} else if (len >=3D 6 + IK_LEN + CK_LEN && buf[0] =3D=3D 0xdb) {
+		pos =3D buf + 1;
+		end =3D buf + len;
+
+		/* RES */
+		if (pos[0] > RES_MAX_LEN || pos + pos[0] > end) {
+			wpa_printf(MSG_DEBUG, "SCARD: Invalid RES");
+			return -1;
+		}
+		*res_len =3D *pos++;
+		os_memcpy(res, pos, *res_len);
+		pos +=3D *res_len;
+		wpa_hexdump(MSG_DEBUG, "SCARD: RES", res, *res_len);
+
+		/* CK */
+		if (pos[0] !=3D CK_LEN || pos + CK_LEN > end) {
+			wpa_printf(MSG_DEBUG, "SCARD: Invalid CK");
+			return -1;
+		}
+		pos++;
+		os_memcpy(ck, pos, CK_LEN);
+		pos +=3D CK_LEN;
+		wpa_hexdump(MSG_DEBUG, "SCARD: CK", ck, CK_LEN);
+
+		/* IK */
+		if (pos[0] !=3D IK_LEN || pos + IK_LEN > end) {
+			wpa_printf(MSG_DEBUG, "SCARD: Invalid IK");
+			return -1;
+		}
+		pos++;
+		os_memcpy(ik, pos, IK_LEN);
+		pos +=3D IK_LEN;
+		wpa_hexdump(MSG_DEBUG, "SCARD: IK", ik, IK_LEN);
+
+		return 0;
+	}
+
+	wpa_printf(MSG_DEBUG, "SCARD: Unrecognized response");
+	return -1;
+}
