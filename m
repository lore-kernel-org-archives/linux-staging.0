+static u8 * eap_pwd_getkey(struct eap_sm *sm, void *priv, size_t *len)
+{
+	struct eap_pwd_data *data =3D priv;
+	u8 *key;
+
+	if (data->state !=3D SUCCESS)
+		return NULL;
+
+	key =3D os_malloc(EAP_MSK_LEN);
+	if (key =3D=3D NULL)
+		return NULL;
+
+	os_memcpy(key, data->msk, EAP_MSK_LEN);
+	*len =3D EAP_MSK_LEN;
+
+	return key;
+}
