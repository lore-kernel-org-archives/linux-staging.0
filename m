+	ap->event_sub_url =3D http_link_update(
+		xml_get_first_item(data, "eventSubURL"), ap->location);
+	wpa_printf(MSG_DEBUG, "WPS ER: eventSubURL=3D'%s'", ap->event_sub_url);
