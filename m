+
+	/*	P2P IE Section. */
+
+	/*	P2P OUI */
+	p2pielen =3D 0;
+	p2pie[p2pielen++] =3D 0x50;
+	p2pie[p2pielen++] =3D 0x6F;
+	p2pie[p2pielen++] =3D 0x9A;
+	p2pie[p2pielen++] =3D 0x09;	/*	WFA P2P v1.0 */
+
+	/*	Commented by Albert 20101005 */
+	/*	According to the P2P Specification, the P2P Invitation response frame =
should contain 5 P2P attributes */
+	/*	1. Status */
+	/*	2. Configuration Timeout */
+	/*	3. Operating Channel	( Only GO ) */
+	/*	4. P2P Group BSSID	( Only GO ) */
+	/*	5. Channel List */
+
+	/*	P2P Status */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_STATUS;
+
+	/*	Length: */
+	*(u16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0001);
+	p2pielen +=3D 2;
+
+	/*	Value: filled by FW, defult value is FAIL INFO UNAVAILABLE */
+	p2pie[p2pielen++] =3D P2P_STATUS_FAIL_INFO_UNAVAILABLE;
+
+	/*	Configuration Timeout */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_CONF_TIMEOUT;
+
+	/*	Length: */
+	*(u16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0002);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	p2pie[p2pielen++] =3D 200;	/*	2 seconds needed to be the P2P GO */
+	p2pie[p2pielen++] =3D 200;	/*	2 seconds needed to be the P2P Client */
+
+	/* due to defult value is FAIL INFO UNAVAILABLE, so the following IE is n=
ot needed */
+	pframe =3D rtw_set_ie(pframe, _VENDOR_SPECIFIC_IE_, p2pielen, (unsigned c=
har *) p2pie, &pktlen);
+
+#ifdef CONFIG_WFD
+	wfdielen =3D build_invitation_resp_wfd_ie(pwdinfo, pframe);
+	pframe +=3D wfdielen;
+	pktlen +=3D wfdielen;
