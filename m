+static int hostapd_config_read_maclist(const char *fname,
+				       struct mac_acl_entry **acl, int *num)
+{
+	FILE *f;
+	char buf[128], *pos;
+	int line =3D 0;
+	u8 addr[ETH_ALEN];
+	struct mac_acl_entry *newacl;
+	int vlan_id;
+
+	if (!fname)
+		return 0;
+
+	f =3D fopen(fname, "r");
+	if (!f) {
+		wpa_printf(MSG_ERROR, "MAC list file '%s' not found.", fname);
+		return -1;
+	}
+
+	while (fgets(buf, sizeof(buf), f)) {
+		line++;
+
+		if (buf[0] =3D=3D '#')
+			continue;
+		pos =3D buf;
+		while (*pos !=3D '\0') {
+			if (*pos =3D=3D '\n') {
+				*pos =3D '\0';
+				break;
+			}
+			pos++;
+		}
+		if (buf[0] =3D=3D '\0')
+			continue;
+
+		if (hwaddr_aton(buf, addr)) {
+			wpa_printf(MSG_ERROR, "Invalid MAC address '%s' at "
+				   "line %d in '%s'", buf, line, fname);
+			fclose(f);
+			return -1;
+		}
+
+		vlan_id =3D 0;
+		pos =3D buf;
+		while (*pos !=3D '\0' && *pos !=3D ' ' && *pos !=3D '\t')
+			pos++;
+		while (*pos =3D=3D ' ' || *pos =3D=3D '\t')
+			pos++;
+		if (*pos !=3D '\0')
+			vlan_id =3D atoi(pos);
+
+		newacl =3D os_realloc(*acl, (*num + 1) * sizeof(**acl));
+		if (newacl =3D=3D NULL) {
+			wpa_printf(MSG_ERROR, "MAC list reallocation failed");
+			fclose(f);
+			return -1;
+		}
+
+		*acl =3D newacl;
+		os_memcpy((*acl)[*num].addr, addr, ETH_ALEN);
+		(*acl)[*num].vlan_id =3D vlan_id;
+		(*num)++;
+	}
+
+	fclose(f);
+
+	qsort(*acl, *num, sizeof(**acl), hostapd_acl_comp);
+
+	return 0;
+}
