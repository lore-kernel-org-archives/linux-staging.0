+int wpa_ft_action_rx(struct wpa_state_machine *sm, const u8 *data, size_t =
len)
+{
+	const u8 *sta_addr, *target_ap;
+	const u8 *ies;
+	size_t ies_len;
+	u8 action;
+	struct ft_rrb_frame *frame;
+
+	if (sm =3D=3D NULL)
+		return -1;
+
+	/*
+	 * data: Category[1] Action[1] STA_Address[6] Target_AP_Address[6]
+	 * FT Request action frame body[variable]
+	 */
+
+	if (len < 14) {
+		wpa_printf(MSG_DEBUG, "FT: Too short FT Action frame "
+			   "(len=3D%lu)", (unsigned long) len);
+		return -1;
+	}
+
+	action =3D data[1];
+	sta_addr =3D data + 2;
+	target_ap =3D data + 8;
+	ies =3D data + 14;
+	ies_len =3D len - 14;
+
+	wpa_printf(MSG_DEBUG, "FT: Received FT Action frame (STA=3D" MACSTR
+		   " Target AP=3D" MACSTR " Action=3D%d)",
+		   MAC2STR(sta_addr), MAC2STR(target_ap), action);
+
+	if (os_memcmp(sta_addr, sm->addr, ETH_ALEN) !=3D 0) {
+		wpa_printf(MSG_DEBUG, "FT: Mismatch in FT Action STA address: "
+			   "STA=3D" MACSTR " STA-Address=3D" MACSTR,
+			   MAC2STR(sm->addr), MAC2STR(sta_addr));
+		return -1;
+	}
+
+	/*
+	 * Do some sanity checking on the target AP address (not own and not
+	 * broadcast. This could be extended to filter based on a list of known
+	 * APs in the MD (if such a list were configured).
+	 */
+	if ((target_ap[0] & 0x01) ||
+	    os_memcmp(target_ap, sm->wpa_auth->addr, ETH_ALEN) =3D=3D 0) {
+		wpa_printf(MSG_DEBUG, "FT: Invalid Target AP in FT Action "
+			   "frame");
+		return -1;
+	}
+
+	wpa_hexdump(MSG_MSGDUMP, "FT: Action frame body", ies, ies_len);
+
+	/* RRB - Forward action frame to the target AP */
+	frame =3D os_malloc(sizeof(*frame) + len);
+	frame->frame_type =3D RSN_REMOTE_FRAME_TYPE_FT_RRB;
+	frame->packet_type =3D FT_PACKET_REQUEST;
+	frame->action_length =3D host_to_le16(len);
+	os_memcpy(frame->ap_address, sm->wpa_auth->addr, ETH_ALEN);
+	os_memcpy(frame + 1, data, len);
+
+	wpa_ft_rrb_send(sm->wpa_auth, target_ap, (u8 *) frame,
+			sizeof(*frame) + len);
+	os_free(frame);
+
+	return 0;
+}
+
+
+static int wpa_ft_rrb_rx_request(struct wpa_authenticator *wpa_auth,
+				 const u8 *current_ap, const u8 *sta_addr,
+				 const u8 *body, size_t len)
+{
+	struct wpa_state_machine *sm;
+	u16 status;
+	u8 *resp_ies, *pos;
+	size_t resp_ies_len, rlen;
+	struct ft_rrb_frame *frame;
+
+	sm =3D wpa_ft_add_sta(wpa_auth, sta_addr);
+	if (sm =3D=3D NULL) {
+		wpa_printf(MSG_DEBUG, "FT: Failed to add new STA based on "
+			   "RRB Request");
+		return -1;
+	}
+
+	wpa_hexdump(MSG_MSGDUMP, "FT: RRB Request Frame body", body, len);
+
+	status =3D wpa_ft_process_auth_req(sm, body, len, &resp_ies,
+					 &resp_ies_len);
+
+	wpa_printf(MSG_DEBUG, "FT: RRB authentication response: STA=3D" MACSTR
+		   " CurrentAP=3D" MACSTR " status=3D%d",
+		   MAC2STR(sm->addr), MAC2STR(current_ap), status);
+	wpa_hexdump(MSG_DEBUG, "FT: Response IEs", resp_ies, resp_ies_len);
+
+	/* RRB - Forward action frame response to the Current AP */
+
+	/*
+	 * data: Category[1] Action[1] STA_Address[6] Target_AP_Address[6]
+	 * Status_Code[2] FT Request action frame body[variable]
+	 */
+	rlen =3D 2 + 2 * ETH_ALEN + 2 + resp_ies_len;
+
+	frame =3D os_malloc(sizeof(*frame) + rlen);
+	frame->frame_type =3D RSN_REMOTE_FRAME_TYPE_FT_RRB;
+	frame->packet_type =3D FT_PACKET_RESPONSE;
+	frame->action_length =3D host_to_le16(rlen);
+	os_memcpy(frame->ap_address, wpa_auth->addr, ETH_ALEN);
+	pos =3D (u8 *) (frame + 1);
+	*pos++ =3D WLAN_ACTION_FT;
+	*pos++ =3D 2; /* Action: Response */
+	os_memcpy(pos, sta_addr, ETH_ALEN);
+	pos +=3D ETH_ALEN;
+	os_memcpy(pos, wpa_auth->addr, ETH_ALEN);
+	pos +=3D ETH_ALEN;
+	WPA_PUT_LE16(pos, status);
+	pos +=3D 2;
+	if (resp_ies) {
+		os_memcpy(pos, resp_ies, resp_ies_len);
+		os_free(resp_ies);
+	}
+
+	wpa_ft_rrb_send(wpa_auth, current_ap, (u8 *) frame,
+			sizeof(*frame) + rlen);
+	os_free(frame);
+
+	return 0;
+}
