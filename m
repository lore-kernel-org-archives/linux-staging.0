+void
+phydm_update_hal_ra_mask(
+	void			*p_dm_void,
+	u32			wireless_mode,
+	u8			rf_type,
+	u8			BW,
+	u8			mimo_ps_enable,
+	u8			disable_cck_rate,
+	u32			*ratr_bitmap_msb_in,
+	u32			*ratr_bitmap_lsb_in,
+	u8			tx_rate_level
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u32			mask_rate_threshold;
+	u8			phydm_rf_type;
+	u8			phydm_BW;
+	u32			ratr_bitmap =3D *ratr_bitmap_lsb_in, ratr_bitmap_msb =3D *ratr_bitm=
ap_msb_in;
+
+	wireless_mode =3D phydm_trans_platform_wireless_mode(p_dm_odm, wireless_m=
ode);
+
+	phydm_rf_type =3D phydm_trans_platform_rf_type(p_dm_odm, rf_type);
+	phydm_BW =3D phydm_trans_platform_bw(p_dm_odm, BW);
+
+	/*ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("phydm_rf_type =
=3D (( %x )), rf_type =3D (( %x ))\n", phydm_rf_type, rf_type));*/
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("Platfoem origina=
l RA Mask =3D (( 0x %x | %x ))\n", ratr_bitmap_msb, ratr_bitmap));
+
+	switch (wireless_mode) {
+
+	case PHYDM_WIRELESS_MODE_B:
+	{
+		ratr_bitmap &=3D 0x0000000f;
+	}
+	break;
+
+	case PHYDM_WIRELESS_MODE_G:
+	{
+		ratr_bitmap &=3D 0x00000ff5;
+	}
+	break;
+
+	case PHYDM_WIRELESS_MODE_A:
+	{
+		ratr_bitmap &=3D 0x00000ff0;
+	}
+	break;
+
+	case PHYDM_WIRELESS_MODE_N_24G:
+	case PHYDM_WIRELESS_MODE_N_5G:
+	{
+		if (mimo_ps_enable)
+			phydm_rf_type =3D PHYDM_RF_1T1R;
+
+		if (phydm_rf_type =3D=3D PHYDM_RF_1T1R) {
+
+			if (phydm_BW =3D=3D PHYDM_BW_40)
+				ratr_bitmap &=3D 0x000ff015;
+			else
+				ratr_bitmap &=3D 0x000ff005;
+		} else if (phydm_rf_type =3D=3D PHYDM_RF_2T2R || phydm_rf_type =3D=3D PH=
YDM_RF_2T4R || phydm_rf_type =3D=3D PHYDM_RF_2T3R) {
+
+			if (phydm_BW =3D=3D PHYDM_BW_40)
+				ratr_bitmap &=3D 0x0ffff015;
+			else
+				ratr_bitmap &=3D 0x0ffff005;
+		} else { /*3T*/
+
+			ratr_bitmap &=3D 0xfffff015;
+			ratr_bitmap_msb &=3D 0xf;
+		}
+	}
+	break;
+
+	case PHYDM_WIRELESS_MODE_AC_24G:
+	{
+		if (phydm_rf_type =3D=3D PHYDM_RF_1T1R)
+			ratr_bitmap &=3D 0x003ff015;
+		else if (phydm_rf_type =3D=3D PHYDM_RF_2T2R || phydm_rf_type =3D=3D PHYD=
M_RF_2T4R || phydm_rf_type =3D=3D PHYDM_RF_2T3R)
+			ratr_bitmap &=3D 0xfffff015;
+		else {/*3T*/
+
+			ratr_bitmap &=3D 0xfffff010;
+			ratr_bitmap_msb &=3D 0x3ff;
+		}
+
+		if (phydm_BW =3D=3D PHYDM_BW_20) {/* AC 20MHz doesn't support MCS9 */
+			ratr_bitmap &=3D 0x7fdfffff;
+			ratr_bitmap_msb &=3D 0x1ff;
+		}
+	}
+	break;
+
+	case PHYDM_WIRELESS_MODE_AC_5G:
+	{
+		if (phydm_rf_type =3D=3D PHYDM_RF_1T1R)
+			ratr_bitmap &=3D 0x003ff010;
+		else if (phydm_rf_type =3D=3D PHYDM_RF_2T2R || phydm_rf_type =3D=3D PHYD=
M_RF_2T4R || phydm_rf_type =3D=3D PHYDM_RF_2T3R)
+			ratr_bitmap &=3D 0xfffff010;
+		else {/*3T*/
+
+			ratr_bitmap &=3D 0xfffff010;
+			ratr_bitmap_msb &=3D 0x3ff;
+		}
+
+		if (phydm_BW =3D=3D PHYDM_BW_20) {/* AC 20MHz doesn't support MCS9 */
+			ratr_bitmap &=3D 0x7fdfffff;
+			ratr_bitmap_msb &=3D 0x1ff;
+		}
+	}
+	break;
+
+	default:
+		break;
+	}
+
+	if (wireless_mode !=3D PHYDM_WIRELESS_MODE_B) {
+
+		if (tx_rate_level =3D=3D 0)
+			ratr_bitmap &=3D  0xffffffff;
+		else if (tx_rate_level =3D=3D 1)
+			ratr_bitmap &=3D  0xfffffff0;
+		else if (tx_rate_level =3D=3D 2)
+			ratr_bitmap &=3D  0xffffefe0;
+		else if (tx_rate_level =3D=3D 3)
+			ratr_bitmap &=3D  0xffffcfc0;
+		else if (tx_rate_level =3D=3D 4)
+			ratr_bitmap &=3D  0xffff8f80;
+		else if (tx_rate_level >=3D 5)
+			ratr_bitmap &=3D  0xffff0f00;
+
+	}
+
+	if (disable_cck_rate)
+		ratr_bitmap &=3D 0xfffffff0;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("wireless_mode=3D=
 (( 0x%x )), rf_type =3D (( 0x%x )), BW =3D (( 0x%x )), MimoPs_en =3D (( %d=
 )), tx_rate_level=3D (( 0x%x ))\n",
+		wireless_mode, phydm_rf_type, phydm_BW, mimo_ps_enable, tx_rate_level));
+
+	/*ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("111 Phydm modi=
fied RA Mask =3D (( 0x %x | %x ))\n", ratr_bitmap_msb, ratr_bitmap));*/
+
+	*ratr_bitmap_lsb_in =3D ratr_bitmap;
+	*ratr_bitmap_msb_in =3D ratr_bitmap_msb;
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("Phydm modified R=
