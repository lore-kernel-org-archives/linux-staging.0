+static void eap_sim_db_receive(int sock, void *eloop_ctx, void *sock_ctx)
+{
+	struct eap_sim_db_data *data =3D eloop_ctx;
+	char buf[1000], *pos, *cmd, *imsi;
+	int res;
+
+	res =3D recv(sock, buf, sizeof(buf), 0);
+	if (res < 0)
+		return;
+	wpa_hexdump_ascii_key(MSG_MSGDUMP, "EAP-SIM DB: Received from an "
+			      "external source", (u8 *) buf, res);
+	if (res =3D=3D 0)
+		return;
+	if (res >=3D (int) sizeof(buf))
+		res =3D sizeof(buf) - 1;
+	buf[res] =3D '\0';
+
+	if (data->get_complete_cb =3D=3D NULL) {
+		wpa_printf(MSG_DEBUG, "EAP-SIM DB: No get_complete_cb "
+			   "registered");
+		return;
+	}
+
+	/* <cmd> <IMSI> ... */
+
+	cmd =3D buf;
+	pos =3D os_strchr(cmd, ' ');
+	if (pos =3D=3D NULL)
+		goto parse_fail;
+	*pos =3D '\0';
+	imsi =3D pos + 1;
+	pos =3D os_strchr(imsi, ' ');
+	if (pos =3D=3D NULL)
+		goto parse_fail;
+	*pos =3D '\0';
+	wpa_printf(MSG_DEBUG, "EAP-SIM DB: External response=3D%s for IMSI %s",
+		   cmd, imsi);
+
+	if (os_strcmp(cmd, "SIM-RESP-AUTH") =3D=3D 0)
+		eap_sim_db_sim_resp_auth(data, imsi, pos + 1);
+	else if (os_strcmp(cmd, "AKA-RESP-AUTH") =3D=3D 0)
+		eap_sim_db_aka_resp_auth(data, imsi, pos + 1);
+	else
+		wpa_printf(MSG_INFO, "EAP-SIM DB: Unknown external response "
+			   "'%s'", cmd);
+	return;
+
+parse_fail:
+	wpa_printf(MSG_DEBUG, "EAP-SIM DB: Failed to parse response string");
+}
