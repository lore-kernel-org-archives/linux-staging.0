+static u8 pktcmp(PADAPTER padapter, u8 *txbuf, u32 txsz, u8 *rxbuf, u32 rx=
sz)
+{
+	PHAL_DATA_TYPE phal;
+	struct recv_stat *prxstat;
+	struct recv_stat report;
+	PRXREPORT prxreport;
+	u32 drvinfosize;
+	u32 rxpktsize;
+	u8 fcssize;
+	u8 ret =3D false;
+
+	prxstat =3D (struct recv_stat *)rxbuf;
+	report.rxdw0 =3D le32_to_cpu(prxstat->rxdw0);
+	report.rxdw1 =3D le32_to_cpu(prxstat->rxdw1);
+	report.rxdw2 =3D le32_to_cpu(prxstat->rxdw2);
+	report.rxdw3 =3D le32_to_cpu(prxstat->rxdw3);
+	report.rxdw4 =3D le32_to_cpu(prxstat->rxdw4);
+	report.rxdw5 =3D le32_to_cpu(prxstat->rxdw5);
+
+	prxreport =3D (PRXREPORT)&report;
+	drvinfosize =3D prxreport->drvinfosize << 3;
+	rxpktsize =3D prxreport->pktlen;
+
+	phal =3D GET_HAL_DATA(padapter);
+	if (phal->ReceiveConfig & RCR_APPFCS)
+		fcssize =3D IEEE80211_FCS_LEN;
+	else
+		fcssize =3D 0;
+
+	if ((txsz - TXDESC_SIZE) !=3D (rxpktsize - fcssize)) {
+		RTW_INFO("%s: ERROR! size not match tx/rx=3D%d/%d !\n",
+			 __func__, txsz - TXDESC_SIZE, rxpktsize - fcssize);
+		ret =3D false;
+	} else {
+		ret =3D !memcmp(txbuf + TXDESC_SIZE, \
+				  rxbuf + RXDESC_SIZE + drvinfosize, \
+				  txsz - TXDESC_SIZE);
+		if (ret =3D=3D false)
+			RTW_INFO("%s: ERROR! pkt content mismatch!\n", __func__);
+	}
+
+	if (ret =3D=3D false) {
+		RTW_INFO("\n%s: TX PKT total=3D%d, desc=3D%d, content=3D%d\n",
+			 __func__, txsz, TXDESC_SIZE, txsz - TXDESC_SIZE);
+		RTW_INFO("%s: TX DESC size=3D%d\n", __func__, TXDESC_SIZE);
+		printdata(txbuf, TXDESC_SIZE);
+		RTW_INFO("%s: TX content size=3D%d\n", __func__, txsz - TXDESC_SIZE);
+		printdata(txbuf + TXDESC_SIZE, txsz - TXDESC_SIZE);
+
+		RTW_INFO("\n%s: RX PKT read=3D%d offset=3D%d(%d,%d) content=3D%d\n",
+			__func__, rxsz, RXDESC_SIZE + drvinfosize, RXDESC_SIZE, drvinfosize, rx=
pktsize);
+		if (rxpktsize !=3D 0) {
+			RTW_INFO("%s: RX DESC size=3D%d\n", __func__, RXDESC_SIZE);
+			printdata(rxbuf, RXDESC_SIZE);
+			RTW_INFO("%s: RX drvinfo size=3D%d\n", __func__, drvinfosize);
+			printdata(rxbuf + RXDESC_SIZE, drvinfosize);
+			RTW_INFO("%s: RX content size=3D%d\n", __func__, rxpktsize);
+			printdata(rxbuf + RXDESC_SIZE + drvinfosize, rxpktsize);
+		} else {
+			RTW_INFO("%s: RX data size=3D%d\n", __func__, rxsz);
+			printdata(rxbuf, rxsz);
+		}
+	}
+
+	return ret;
+}
