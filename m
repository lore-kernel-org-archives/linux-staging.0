+		/* ! \todo Send a H2C Command to Firmware for removing this Key in CAM E=
ntry. */
+
+	} else {
+
+		pbssid =3D get_bssid(&padapter->mlmepriv);
+		stainfo =3D rtw_get_stainfo(&padapter->stapriv , pbssid);
+		if (stainfo !=3D NULL) {
