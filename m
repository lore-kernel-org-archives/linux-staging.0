+				 int (*cb)(void *ctx, const u8 *sa,
+					   const u8 *ie, size_t ie_len),
+				 void *ctx)
+{
+	struct hostapd_probereq_cb *n;
+
+	n =3D os_realloc(hapd->probereq_cb, (hapd->num_probereq_cb + 1) *
+		       sizeof(struct hostapd_probereq_cb));
+	if (n =3D=3D NULL)
+		return -1;
+
+	hapd->probereq_cb =3D n;
+	n =3D &hapd->probereq_cb[hapd->num_probereq_cb];
