+void rtw_os_ndev_unregister(_adapter *adapter)
+{
+	struct net_device *netdev =3D NULL;
+
+	if (adapter =3D=3D NULL || adapter->registered =3D=3D 0)
+		return;
+
+	adapter->ndev_unregistering =3D 1;
+
+	netdev =3D adapter->pnetdev;
+
+#if defined(CONFIG_IOCTL_CFG80211)
+	rtw_cfg80211_ndev_res_unregister(adapter);
+#endif
+
+	if ((adapter->DriverState !=3D DRIVER_DISAPPEAR) && netdev) {
+		struct dvobj_priv *dvobj =3D adapter_to_dvobj(adapter);
+		u8 rtnl_lock_needed =3D rtw_rtnl_lock_needed(dvobj);
+
+		if (rtnl_lock_needed)
+			unregister_netdev(netdev);
+		else
+			unregister_netdevice(netdev);
+	}
+
+#if defined(CONFIG_IOCTL_CFG80211) && !defined(RTW_SINGLE_WIPHY)
+#ifdef CONFIG_RFKILL_POLL
+	rtw_cfg80211_deinit_rfkill(adapter_to_wiphy(adapter));
+#endif
+	rtw_wiphy_unregister(adapter_to_wiphy(adapter));
+#endif
+
+#ifdef CONFIG_RTW_NAPI
+	if (adapter->napi_state =3D=3D NAPI_ENABLE) {
+		napi_disable(&adapter->napi);
+		adapter->napi_state =3D NAPI_DISABLE;
+	}
+	netif_napi_del(&adapter->napi);
