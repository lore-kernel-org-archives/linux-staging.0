+static struct eap_sim_db_pending *
+eap_sim_db_get_pending(struct eap_sim_db_data *data, const u8 *imsi,
+		       size_t imsi_len, int aka)
+{
+	struct eap_sim_db_pending *entry, *prev =3D NULL;
+
+	entry =3D data->pending;
+	while (entry) {
+		if (entry->aka =3D=3D aka && entry->imsi_len =3D=3D imsi_len &&
+		    os_memcmp(entry->imsi, imsi, imsi_len) =3D=3D 0) {
+			if (prev)
+				prev->next =3D entry->next;
+			else
+				data->pending =3D entry->next;
+			break;
+		}
+		prev =3D entry;
+		entry =3D entry->next;
+	}
+	return entry;
+}
+
+
+static void eap_sim_db_add_pending(struct eap_sim_db_data *data,
+				   struct eap_sim_db_pending *entry)
+{
