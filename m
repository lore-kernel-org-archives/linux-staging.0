+static u8
+phydm_calculate_fc(
+	void		*p_dm_void,
+	u32		channel,
+	u32		bw,
+	u32		second_ch,
+	u32		*fc_in
+)
+{
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u32		fc =3D *fc_in;
+	u32		start_ch_per_40m[NUM_START_CH_40M] =3D {36, 44, 52, 60, 100, 108, 11=
6, 124, 132, 140, 149, 157, 165, 173};
+	u32		start_ch_per_80m[NUM_START_CH_80M] =3D {36, 52, 100, 116, 132, 149, =
165};
+	u32		*p_start_ch =3D &(start_ch_per_40m[0]);
+	u32		num_start_channel =3D NUM_START_CH_40M;
+	u32		channel_offset =3D 0;
+	u32		i;
+
+	/*2.4G*/
+	if (channel <=3D 14 && channel > 0) {
+
+		if (bw =3D=3D 80)
+			return	SET_ERROR;
+
+		fc =3D 2412 + (channel - 1) * 5;
+
+		if (bw =3D=3D 40 && (second_ch =3D=3D PHYDM_ABOVE)) {
+
+			if (channel >=3D 10) {
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("CH =3D ((%d)), Sc=
nd_CH =3D ((%d)) Error setting\n", channel, second_ch));
+				return	SET_ERROR;
+			}
+			fc +=3D 10;
+		} else if (bw =3D=3D 40 && (second_ch =3D=3D PHYDM_BELOW)) {
+
+			if (channel <=3D 2) {
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("CH =3D ((%d)), Sc=
nd_CH =3D ((%d)) Error setting\n", channel, second_ch));
+				return	SET_ERROR;
+			}
+			fc -=3D 10;
+		}
+	}
+	/*5G*/
+	else if (channel >=3D 36 && channel <=3D 177) {
+
+		if (bw !=3D 20) {
+
+			if (bw =3D=3D 40) {
+				num_start_channel =3D NUM_START_CH_40M;
+				p_start_ch =3D &(start_ch_per_40m[0]);
+				channel_offset =3D CH_OFFSET_40M;
+			} else if (bw =3D=3D 80) {
+				num_start_channel =3D NUM_START_CH_80M;
+				p_start_ch =3D &(start_ch_per_80m[0]);
+				channel_offset =3D CH_OFFSET_80M;
+			}
+
+			for (i =3D 0; i < num_start_channel; i++) {
+
+				if (channel < p_start_ch[i + 1]) {
+					channel =3D p_start_ch[i] + channel_offset;
+					break;
+				}
+			}
+			ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("Mod_CH =3D ((%d))\=
n", channel));
+		}
+
+		fc =3D 5180 + (channel - 36) * 5;
+
+	} else {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("CH =3D ((%d)) Error=
 setting\n", channel));
+		return	SET_ERROR;
+	}
+
+	*fc_in =3D fc;
+
+	return SET_SUCCESS;
+}
+
+
+static u8
+phydm_calculate_intf_distance(
+	void		*p_dm_void,
+	u32		bw,
+	u32		fc,
+	u32		f_interference,
+	u32		*p_tone_idx_tmp_in
+)
+{
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u32		bw_up, bw_low;
+	u32		int_distance;
+	u32		tone_idx_tmp;
+	u8		set_result =3D SET_NO_NEED;
+
+	bw_up =3D fc + bw / 2;
+	bw_low =3D fc - bw / 2;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("[f_l, fc, fh] =3D [ =
%d, %d, %d ], f_int =3D ((%d))\n", bw_low, fc, bw_up, f_interference));
+
+	if ((f_interference >=3D bw_low) && (f_interference <=3D bw_up)) {
+
+		int_distance =3D (fc >=3D f_interference) ? (fc - f_interference) : (f_i=
nterference - fc);
+		tone_idx_tmp =3D (int_distance << 5); /* =3D10*(int_distance /0.3125) */
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("int_distance =3D ((=
%d MHz)) Mhz, tone_idx_tmp =3D ((%d.%d))\n", int_distance, (tone_idx_tmp / =
10), (tone_idx_tmp % 10)));
+		*p_tone_idx_tmp_in =3D tone_idx_tmp;
+		set_result =3D SET_SUCCESS;
+	}
+
+	return	set_result;
+
+}
