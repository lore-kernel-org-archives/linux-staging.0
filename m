+#ifdef CONFIG_80211D
+static void process_80211d(PADAPTER padapter, WLAN_BSSID_EX *bssid)
+{
+	struct registry_priv *pregistrypriv;
+	struct mlme_ext_priv *pmlmeext;
+	RT_CHANNEL_INFO *chplan_new;
+	u8 channel;
+	u8 i;
+
+
+	pregistrypriv =3D &padapter->registrypriv;
+	pmlmeext =3D &padapter->mlmeextpriv;
+
+	/* Adjust channel plan by AP Country IE */
+	if (pregistrypriv->enable80211d
+	    && (!pmlmeext->update_channel_plan_by_ap_done)) {
+		u8 *ie, *p;
+		u32 len;
+		RT_CHANNEL_PLAN chplan_ap;
+		RT_CHANNEL_INFO chplan_sta[MAX_CHANNEL_NUM];
+		u8 country[4];
+		u8 fcn; /* first channel number */
+		u8 noc; /* number of channel */
+		u8 j, k;
+
+		ie =3D rtw_get_ie(bssid->IEs + _FIXED_IE_LENGTH_, _COUNTRY_IE_, &len, bs=
sid->IELength - _FIXED_IE_LENGTH_);
+		if (!ie)
+			return;
+		if (len < 6)
+			return;
+
+		ie +=3D 2;
+		p =3D ie;
+		ie +=3D len;
+
+		memset(country, 0, 4);
+		memcpy(country, p, 3);
+		p +=3D 3;
+		RTW_INFO("%s: 802.11d country=3D%s\n", __func__, country);
+
+		i =3D 0;
+		while ((ie - p) >=3D 3) {
+			fcn =3D *(p++);
+			noc =3D *(p++);
+			p++;
+
+			for (j =3D 0; j < noc; j++) {
+				if (fcn <=3D 14)
+					channel =3D fcn + j; /* 2.4 GHz */
+				else
+					channel =3D fcn + j * 4; /* 5 GHz */
+
+				chplan_ap.Channel[i++] =3D channel;
+			}
+		}
+		chplan_ap.Len =3D i;
+
+#ifdef CONFIG_RTW_DEBUG
+		i =3D 0;
+		RTW_INFO("%s: AP[%s] channel plan {", __func__, bssid->Ssid.Ssid);
+		while ((i < chplan_ap.Len) && (chplan_ap.Channel[i] !=3D 0)) {
+			_RTW_INFO("%02d,", chplan_ap.Channel[i]);
+			i++;
+		}
+		_RTW_INFO("}\n");
+#endif
+
+		memcpy(chplan_sta, pmlmeext->channel_set, sizeof(chplan_sta));
+#ifdef CONFIG_RTW_DEBUG
+		i =3D 0;
+		RTW_INFO("%s: STA channel plan {", __func__);
+		while ((i < MAX_CHANNEL_NUM) && (chplan_sta[i].ChannelNum !=3D 0)) {
+			_RTW_INFO("%02d(%c),", chplan_sta[i].ChannelNum, chplan_sta[i].ScanType=
 =3D=3D SCAN_PASSIVE ? 'p' : 'a');
+			i++;
+		}
+		_RTW_INFO("}\n");
+#endif
+
+		memset(pmlmeext->channel_set, 0, sizeof(pmlmeext->channel_set));
+		chplan_new =3D pmlmeext->channel_set;
+
+		i =3D j =3D k =3D 0;
+		if (pregistrypriv->wireless_mode & WIRELESS_11G) {
+			do {
+				if ((i =3D=3D MAX_CHANNEL_NUM)
+				    || (chplan_sta[i].ChannelNum =3D=3D 0)
+				    || (chplan_sta[i].ChannelNum > 14))
+					break;
+
+				if ((j =3D=3D chplan_ap.Len) || (chplan_ap.Channel[j] > 14))
+					break;
+
+				if (chplan_sta[i].ChannelNum =3D=3D chplan_ap.Channel[j]) {
+					chplan_new[k].ChannelNum =3D chplan_ap.Channel[j];
+					chplan_new[k].ScanType =3D SCAN_ACTIVE;
+					i++;
+					j++;
+					k++;
+				} else if (chplan_sta[i].ChannelNum < chplan_ap.Channel[j]) {
+					chplan_new[k].ChannelNum =3D chplan_sta[i].ChannelNum;
+					chplan_new[k].ScanType =3D SCAN_PASSIVE;
+					i++;
+					k++;
+				} else if (chplan_sta[i].ChannelNum > chplan_ap.Channel[j]) {
+					chplan_new[k].ChannelNum =3D chplan_ap.Channel[j];
+					chplan_new[k].ScanType =3D SCAN_ACTIVE;
+					j++;
+					k++;
+				}
+			} while (1);
+
+			/* change AP not support channel to Passive scan */
+			while ((i < MAX_CHANNEL_NUM)
+			       && (chplan_sta[i].ChannelNum !=3D 0)
+			       && (chplan_sta[i].ChannelNum <=3D 14)) {
+				chplan_new[k].ChannelNum =3D chplan_sta[i].ChannelNum;
+				chplan_new[k].ScanType =3D SCAN_PASSIVE;
+				i++;
+				k++;
+			}
+
+			/* add channel AP supported */
+			while ((j < chplan_ap.Len) && (chplan_ap.Channel[j] <=3D 14)) {
+				chplan_new[k].ChannelNum =3D chplan_ap.Channel[j];
+				chplan_new[k].ScanType =3D SCAN_ACTIVE;
+				j++;
+				k++;
+			}
+		} else {
+			/* keep original STA 2.4G channel plan */
+			while ((i < MAX_CHANNEL_NUM)
+			       && (chplan_sta[i].ChannelNum !=3D 0)
+			       && (chplan_sta[i].ChannelNum <=3D 14)) {
+				chplan_new[k].ChannelNum =3D chplan_sta[i].ChannelNum;
+				chplan_new[k].ScanType =3D chplan_sta[i].ScanType;
+				i++;
+				k++;
+			}
+
+			/* skip AP 2.4G channel plan */
+			while ((j < chplan_ap.Len) && (chplan_ap.Channel[j] <=3D 14))
+				j++;
+		}
+
+		if (pregistrypriv->wireless_mode & WIRELESS_11A) {
+			do {
+				if ((i >=3D MAX_CHANNEL_NUM)
+				    || (chplan_sta[i].ChannelNum =3D=3D 0))
+					break;
+
+				if ((j =3D=3D chplan_ap.Len) || (chplan_ap.Channel[j] =3D=3D 0))
+					break;
+
+				if (chplan_sta[i].ChannelNum =3D=3D chplan_ap.Channel[j]) {
+					chplan_new[k].ChannelNum =3D chplan_ap.Channel[j];
+					chplan_new[k].ScanType =3D SCAN_ACTIVE;
+					i++;
+					j++;
+					k++;
+				} else if (chplan_sta[i].ChannelNum < chplan_ap.Channel[j]) {
+					chplan_new[k].ChannelNum =3D chplan_sta[i].ChannelNum;
+					chplan_new[k].ScanType =3D SCAN_PASSIVE;
+					i++;
+					k++;
+				} else if (chplan_sta[i].ChannelNum > chplan_ap.Channel[j]) {
+					chplan_new[k].ChannelNum =3D chplan_ap.Channel[j];
+					chplan_new[k].ScanType =3D SCAN_ACTIVE;
+					j++;
+					k++;
+				}
+			} while (1);
+
+			/* change AP not support channel to Passive scan */
+			while ((i < MAX_CHANNEL_NUM) && (chplan_sta[i].ChannelNum !=3D 0)) {
+				chplan_new[k].ChannelNum =3D chplan_sta[i].ChannelNum;
+				chplan_new[k].ScanType =3D SCAN_PASSIVE;
+				i++;
+				k++;
+			}
+
+			/* add channel AP supported */
+			while ((j < chplan_ap.Len) && (chplan_ap.Channel[j] !=3D 0)) {
+				chplan_new[k].ChannelNum =3D chplan_ap.Channel[j];
+				chplan_new[k].ScanType =3D SCAN_ACTIVE;
+				j++;
+				k++;
+			}
+		} else {
+			/* keep original STA 5G channel plan */
+			while ((i < MAX_CHANNEL_NUM) && (chplan_sta[i].ChannelNum !=3D 0)) {
+				chplan_new[k].ChannelNum =3D chplan_sta[i].ChannelNum;
+				chplan_new[k].ScanType =3D chplan_sta[i].ScanType;
+				i++;
+				k++;
+			}
+		}
+
+		pmlmeext->update_channel_plan_by_ap_done =3D 1;
+
+#ifdef CONFIG_RTW_DEBUG
+		k =3D 0;
+		RTW_INFO("%s: new STA channel plan {", __func__);
+		while ((k < MAX_CHANNEL_NUM) && (chplan_new[k].ChannelNum !=3D 0)) {
+			_RTW_INFO("%02d(%c),", chplan_new[k].ChannelNum, chplan_new[k].ScanType=
 =3D=3D SCAN_PASSIVE ? 'p' : 'c');
+			k++;
+		}
+		_RTW_INFO("}\n");
+#endif
+	}
+
+	/* If channel is used by AP, set channel scan type to active */
+	channel =3D bssid->Configuration.DSConfig;
+	chplan_new =3D pmlmeext->channel_set;
+	i =3D 0;
+	while ((i < MAX_CHANNEL_NUM) && (chplan_new[i].ChannelNum !=3D 0)) {
+		if (chplan_new[i].ChannelNum =3D=3D channel) {
+			if (chplan_new[i].ScanType =3D=3D SCAN_PASSIVE) {
+				/* 5G Bnad 2, 3 (DFS) doesn't change to active scan */
+				if (channel >=3D 52 && channel <=3D 144)
+					break;
+
+				chplan_new[i].ScanType =3D SCAN_ACTIVE;
+				RTW_INFO("%s: change channel %d scan type from passive to active\n",
+					 __func__, channel);
+			}
+			break;
+		}
+		i++;
+	}
+}
+#endif
