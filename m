+u32 rtw_get_ff_hwaddr(struct xmit_frame *pxmitframe)
+{
+	u32 addr;
+	struct pkt_attrib *pattrib =3D &pxmitframe->attrib;
+
+	switch (pattrib->qsel) {
+	case 0:
+	case 3:
+		addr =3D BE_QUEUE_INX;
+		break;
+	case 1:
+	case 2:
+		addr =3D BK_QUEUE_INX;
+		break;
+	case 4:
+	case 5:
+		addr =3D VI_QUEUE_INX;
+		break;
+	case 6:
+	case 7:
+		addr =3D VO_QUEUE_INX;
+		break;
+	case 0x10:
+		addr =3D BCN_QUEUE_INX;
+		break;
+	case 0x11: /* BC/MC in PS (HIQ) */
+		addr =3D HIGH_QUEUE_INX;
+		break;
+	case 0x13:
+		addr =3D TXCMD_QUEUE_INX;
+		break;
+	case 0x12:
+	default:
+		addr =3D MGT_QUEUE_INX;
+		break;
+
+	}
+
+	return addr;
+
+}
