+/**
+ * radius_server_init - Initialize RADIUS server
+ * @conf: Configuration for the RADIUS server
+ * Returns: Pointer to private RADIUS server context or %NULL on failure
+ *
+ * This initializes a RADIUS server instance and returns a context pointer=
 that
+ * will be used in other calls to the RADIUS server module. The server can=
 be
+ * deinitialize by calling radius_server_deinit().
+ */
+struct radius_server_data *
+radius_server_init(struct radius_server_conf *conf)
+{
+	struct radius_server_data *data;
+
+#ifndef CONFIG_IPV6
+	if (conf->ipv6) {
+		fprintf(stderr, "RADIUS server compiled without IPv6 "
+			"support.\n");
+		return NULL;
+	}
+#endif /* CONFIG_IPV6 */
+
+	data =3D os_zalloc(sizeof(*data));
+	if (data =3D=3D NULL)
+		return NULL;
+
+	os_get_time(&data->start_time);
+	data->conf_ctx =3D conf->conf_ctx;
+	data->eap_sim_db_priv =3D conf->eap_sim_db_priv;
+	data->ssl_ctx =3D conf->ssl_ctx;
+	data->msg_ctx =3D conf->msg_ctx;
+	data->ipv6 =3D conf->ipv6;
+	if (conf->pac_opaque_encr_key) {
+		data->pac_opaque_encr_key =3D os_malloc(16);
+		os_memcpy(data->pac_opaque_encr_key, conf->pac_opaque_encr_key,
+			  16);
+	}
+	if (conf->eap_fast_a_id) {
+		data->eap_fast_a_id =3D os_malloc(conf->eap_fast_a_id_len);
+		if (data->eap_fast_a_id) {
+			os_memcpy(data->eap_fast_a_id, conf->eap_fast_a_id,
+				  conf->eap_fast_a_id_len);
+			data->eap_fast_a_id_len =3D conf->eap_fast_a_id_len;
+		}
+	}
+	if (conf->eap_fast_a_id_info)
+		data->eap_fast_a_id_info =3D os_strdup(conf->eap_fast_a_id_info);
+	data->eap_fast_prov =3D conf->eap_fast_prov;
+	data->pac_key_lifetime =3D conf->pac_key_lifetime;
+	data->pac_key_refresh_time =3D conf->pac_key_refresh_time;
+	data->get_eap_user =3D conf->get_eap_user;
+	data->eap_sim_aka_result_ind =3D conf->eap_sim_aka_result_ind;
+	data->tnc =3D conf->tnc;
+	data->wps =3D conf->wps;
+	data->pwd_group =3D conf->pwd_group;
+	if (conf->eap_req_id_text) {
+		data->eap_req_id_text =3D os_malloc(conf->eap_req_id_text_len);
+		if (data->eap_req_id_text) {
+			os_memcpy(data->eap_req_id_text, conf->eap_req_id_text,
+				  conf->eap_req_id_text_len);
+			data->eap_req_id_text_len =3D conf->eap_req_id_text_len;
+		}
+	}
+
+	data->clients =3D radius_server_read_clients(conf->client_file,
+						   conf->ipv6);
+	if (data->clients =3D=3D NULL) {
+		printf("No RADIUS clients configured.\n");
+		radius_server_deinit(data);
+		return NULL;
+	}
+
+#ifdef CONFIG_IPV6
+	if (conf->ipv6)
+		data->auth_sock =3D radius_server_open_socket6(conf->auth_port);
+	else
+#endif /* CONFIG_IPV6 */
+	data->auth_sock =3D radius_server_open_socket(conf->auth_port);
+	if (data->auth_sock < 0) {
+		printf("Failed to open UDP socket for RADIUS authentication "
+		       "server\n");
+		radius_server_deinit(data);
+		return NULL;
+	}
+	if (eloop_register_read_sock(data->auth_sock,
+				     radius_server_receive_auth,
+				     data, NULL)) {
+		radius_server_deinit(data);
+		return NULL;
+	}
+
+	return data;
+}
