+
+		u64 zero_1:1;
+		/**
+		 * the group that the work queue entry will be scheduled to
+		 */
+		u64 grp:6;
+		u64 zero_2:3;
+		u64 tag_type:2;
+		u64 tag:32;
+#else
+		u64 tag:32;
+		u64 tag_type:2;
+		u64 zero_2:3;
+		u64 grp:6;
+		u64 zero_1:1;
+		u64 qos:3;
