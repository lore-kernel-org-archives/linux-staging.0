+static void tls_log_func(int level, const char *msg)
+{
+	char *s, *pos;
+	if (level =3D=3D 6 || level =3D=3D 7) {
+		/* These levels seem to be mostly I/O debug and msg dumps */
+		return;
+	}
+
+	s =3D os_strdup(msg);
+	if (s =3D=3D NULL)
+		return;
+
+	pos =3D s;
+	while (*pos !=3D '\0') {
+		if (*pos =3D=3D '\n') {
+			*pos =3D '\0';
+			break;
+		}
+		pos++;
+	}
+	wpa_printf(level > 3 ? MSG_MSGDUMP : MSG_DEBUG,
+		   "gnutls<%d> %s", level, s);
+	os_free(s);
