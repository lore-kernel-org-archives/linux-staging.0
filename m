+/* Initialize the hash state */
+static void sha256_init(struct sha256_state_rtk *md)
+{
+	md->curlen =3D 0;
+	md->length =3D 0;
+	md->state[0] =3D 0x6A09E667UL;
+	md->state[1] =3D 0xBB67AE85UL;
+	md->state[2] =3D 0x3C6EF372UL;
+	md->state[3] =3D 0xA54FF53AUL;
+	md->state[4] =3D 0x510E527FUL;
+	md->state[5] =3D 0x9B05688CUL;
+	md->state[6] =3D 0x1F83D9ABUL;
+	md->state[7] =3D 0x5BE0CD19UL;
+}
