+enum tncc_process_res tncc_process_if_tnccs(struct tncc_data *tncc,
+					    const u8 *msg, size_t len)
+{
+	char *buf, *start, *end, *pos, *pos2, *payload;
+	unsigned int batch_id;
+	unsigned char *decoded;
+	size_t decoded_len;
+	enum tncc_process_res res =3D TNCCS_PROCESS_OK_NO_RECOMMENDATION;
+	int recommendation_msg =3D 0;
+
+	buf =3D os_malloc(len + 1);
+	if (buf =3D=3D NULL)
+		return TNCCS_PROCESS_ERROR;
+
+	os_memcpy(buf, msg, len);
+	buf[len] =3D '\0';
+	start =3D os_strstr(buf, "<TNCCS-Batch ");
+	end =3D os_strstr(buf, "</TNCCS-Batch>");
+	if (start =3D=3D NULL || end =3D=3D NULL || start > end) {
+		os_free(buf);
+		return TNCCS_PROCESS_ERROR;
+	}
+
+	start +=3D 13;
+	while (*start =3D=3D ' ')
+		start++;
+	*end =3D '\0';
+
+	pos =3D os_strstr(start, "BatchId=3D");
+	if (pos =3D=3D NULL) {
+		os_free(buf);
+		return TNCCS_PROCESS_ERROR;
+	}
+
+	pos +=3D 8;
+	if (*pos =3D=3D '"')
+		pos++;
+	batch_id =3D atoi(pos);
+	wpa_printf(MSG_DEBUG, "TNC: Received IF-TNCCS BatchId=3D%u",
+		   batch_id);
+	if (batch_id !=3D tncc->last_batchid + 1) {
+		wpa_printf(MSG_DEBUG, "TNC: Unexpected IF-TNCCS BatchId "
+			   "%u (expected %u)",
+			   batch_id, tncc->last_batchid + 1);
+		os_free(buf);
+		return TNCCS_PROCESS_ERROR;
+	}
+	tncc->last_batchid =3D batch_id;
+
+	while (*pos !=3D '\0' && *pos !=3D '>')
+		pos++;
+	if (*pos =3D=3D '\0') {
+		os_free(buf);
+		return TNCCS_PROCESS_ERROR;
+	}
+	pos++;
+	payload =3D start;
+
+	/*
+	 * <IMC-IMV-Message>
+	 * <Type>01234567</Type>
+	 * <Base64>foo=3D=3D</Base64>
+	 * </IMC-IMV-Message>
+	 */
+
+	while (*start) {
+		char *endpos;
+		unsigned int type;
+
+		pos =3D os_strstr(start, "<IMC-IMV-Message>");
+		if (pos =3D=3D NULL)
+			break;
+		start =3D pos + 17;
+		end =3D os_strstr(start, "</IMC-IMV-Message>");
+		if (end =3D=3D NULL)
+			break;
+		*end =3D '\0';
+		endpos =3D end;
+		end +=3D 18;
+
+		if (tncc_get_type(start, &type) < 0) {
+			*endpos =3D '<';
+			start =3D end;
+			continue;
+		}
+		wpa_printf(MSG_DEBUG, "TNC: IMC-IMV-Message Type 0x%x", type);
+
+		decoded =3D tncc_get_base64(start, &decoded_len);
+		if (decoded =3D=3D NULL) {
+			*endpos =3D '<';
+			start =3D end;
+			continue;
+		}
+
+		tncc_send_to_imcs(tncc, type, decoded, decoded_len);
+
+		os_free(decoded);
+
+		start =3D end;
+	}
+
+	/*
+	 * <TNCC-TNCS-Message>
+	 * <Type>01234567</Type>
+	 * <XML><TNCCS-Foo type=3D"foo"></TNCCS-Foo></XML>
+	 * <Base64>foo=3D=3D</Base64>
+	 * </TNCC-TNCS-Message>
+	 */
+
+	start =3D payload;
+	while (*start) {
+		unsigned int type;
+		char *xml, *xmlend, *endpos;
+
+		pos =3D os_strstr(start, "<TNCC-TNCS-Message>");
+		if (pos =3D=3D NULL)
+			break;
+		start =3D pos + 19;
+		end =3D os_strstr(start, "</TNCC-TNCS-Message>");
+		if (end =3D=3D NULL)
+			break;
+		*end =3D '\0';
+		endpos =3D end;
+		end +=3D 20;
+
+		if (tncc_get_type(start, &type) < 0) {
+			*endpos =3D '<';
+			start =3D end;
+			continue;
+		}
+		wpa_printf(MSG_DEBUG, "TNC: TNCC-TNCS-Message Type 0x%x",
+			   type);
+
+		/* Base64 OR XML */
+		decoded =3D NULL;
+		xml =3D NULL;
+		xmlend =3D NULL;
+		pos =3D os_strstr(start, "<XML>");
+		if (pos) {
+			pos +=3D 5;
+			pos2 =3D os_strstr(pos, "</XML>");
+			if (pos2 =3D=3D NULL) {
+				*endpos =3D '<';
+				start =3D end;
+				continue;
+			}
+			xmlend =3D pos2;
+			xml =3D pos;
+		} else {
+			decoded =3D tncc_get_base64(start, &decoded_len);
+			if (decoded =3D=3D NULL) {
+				*endpos =3D '<';
+				start =3D end;
+				continue;
+			}
+		}
+
+		if (decoded) {
+			wpa_hexdump_ascii(MSG_MSGDUMP,
+					  "TNC: TNCC-TNCS-Message Base64",
+					  decoded, decoded_len);
+			os_free(decoded);
+		}
+
+		if (xml) {
+			wpa_hexdump_ascii(MSG_MSGDUMP,
+					  "TNC: TNCC-TNCS-Message XML",
+					  (unsigned char *) xml,
+					  xmlend - xml);
+		}
+
+		if (type =3D=3D TNC_TNCCS_RECOMMENDATION && xml) {
+			/*
+			 * <TNCCS-Recommendation type=3D"allow">
+			 * </TNCCS-Recommendation>
+			 */
+			*xmlend =3D '\0';
+			res =3D tncc_get_recommendation(xml);
+			*xmlend =3D '<';
+			recommendation_msg =3D 1;
+		}
+
+		start =3D end;
+	}
+
+	os_free(buf);
+
+	if (recommendation_msg)
+		tncc_notify_recommendation(tncc, res);
+
+	return res;
+}
