pattrib->pktlen));
+			le_val =3D cpu_to_le16(status);
+			pframe =3D rtw_set_fixed_ie(pframe, 2, (unsigned char *)(&(le_val)), &(=
pattrib->pktlen));
+			break;
+		default:
+			break;
+		}
+	}
+
+	pattrib->last_txcmdsz =3D pattrib->pktlen;
+
+	if (wait_ack)
+		ret =3D dump_mgntframe_and_wait_ack(padapter, pmgntframe);
+	else {
+		dump_mgntframe(padapter, pmgntframe);
+		ret =3D _SUCCESS;
+	}
+
+exit:
+	return ret;
+}
