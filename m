+
+	if (conn =3D=3D NULL || !conn->eap_tls_prf_set || server_random_first ||
+	    os_strcmp(label, "client EAP encryption") !=3D 0 ||
+	    out_len > sizeof(conn->eap_tls_prf))
+		return -1;
+
