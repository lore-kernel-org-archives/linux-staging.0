+static int hostapd_broadcast_wep_set(struct hostapd_data *hapd)
+{
+	int errors =3D 0, idx;
+	struct hostapd_ssid *ssid =3D &hapd->conf->ssid;
+
+	idx =3D ssid->wep.idx;
+	if (ssid->wep.default_len &&
+	    hostapd_drv_set_key(hapd->conf->iface,
+				hapd, WPA_ALG_WEP, broadcast_ether_addr, idx,
+				1, NULL, 0, ssid->wep.key[idx],
+				ssid->wep.len[idx])) {
+		wpa_printf(MSG_WARNING, "Could not set WEP encryption.");
+		errors++;
+	}
+
+	if (ssid->dyn_vlan_keys) {
+		size_t i;
+		for (i =3D 0; i <=3D ssid->max_dyn_vlan_keys; i++) {
+			const char *ifname;
+			struct hostapd_wep_keys *key =3D ssid->dyn_vlan_keys[i];
+			if (key =3D=3D NULL)
+				continue;
+			ifname =3D hostapd_get_vlan_id_ifname(hapd->conf->vlan,
+							    i);
+			if (ifname =3D=3D NULL)
+				continue;
+
+			idx =3D key->idx;
+			if (hostapd_drv_set_key(ifname, hapd, WPA_ALG_WEP,
+						broadcast_ether_addr, idx, 1,
+						NULL, 0, key->key[idx],
+						key->len[idx])) {
+				wpa_printf(MSG_WARNING, "Could not set "
+					   "dynamic VLAN WEP encryption.");
+				errors++;
+			}
+		}
+	}
+
+	return errors;
