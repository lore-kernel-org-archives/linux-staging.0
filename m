+/**
+ * rtw_sync_chbw - obey g_ch, adjust g_bw, g_offset, bw, offset
+ * @req_ch: pointer of the request ch, may be modified further
+ * @req_bw: pointer of the request bw, may be modified further
+ * @req_offset: pointer of the request offset, may be modified further
+ * @g_ch: pointer of the ongoing group ch
+ * @g_bw: pointer of the ongoing group bw, may be modified further
+ * @g_offset: pointer of the ongoing group offset, may be modified further
+ */
+void rtw_sync_chbw(u8 *req_ch, u8 *req_bw, u8 *req_offset
+		   , u8 *g_ch, u8 *g_bw, u8 *g_offset)
+{
+
+	*req_ch =3D *g_ch;
+
+	if (*req_bw =3D=3D CHANNEL_WIDTH_80 && *g_ch <=3D 14) {
+		/*2.4G ch, downgrade to 40Mhz */
+		*req_bw =3D CHANNEL_WIDTH_40;
+	}
+
+	switch (*req_bw) {
+	case CHANNEL_WIDTH_80:
+		if (*g_bw =3D=3D CHANNEL_WIDTH_40 || *g_bw =3D=3D CHANNEL_WIDTH_80)
+			*req_offset =3D *g_offset;
+		else if (*g_bw =3D=3D CHANNEL_WIDTH_20)
+			*req_offset =3D rtw_get_offset_by_ch(*req_ch);
+
+		if (*req_offset =3D=3D HAL_PRIME_CHNL_OFFSET_DONT_CARE) {
+			RTW_ERR("%s req 80MHz BW without offset, down to 20MHz\n", __func__);
+			rtw_warn_on(1);
+			*req_bw =3D CHANNEL_WIDTH_20;
+		}
+		break;
+	case CHANNEL_WIDTH_40:
+		if (*g_bw =3D=3D CHANNEL_WIDTH_40 || *g_bw =3D=3D CHANNEL_WIDTH_80)
+			*req_offset =3D *g_offset;
+		else if (*g_bw =3D=3D CHANNEL_WIDTH_20)
+			*req_offset =3D rtw_get_offset_by_ch(*req_ch);
+
+		if (*req_offset =3D=3D HAL_PRIME_CHNL_OFFSET_DONT_CARE) {
+			RTW_ERR("%s req 40MHz BW without offset, down to 20MHz\n", __func__);
+			rtw_warn_on(1);
+			*req_bw =3D CHANNEL_WIDTH_20;
+		}
+		break;
+	case CHANNEL_WIDTH_20:
+		*req_offset =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+		break;
+	default:
+		RTW_ERR("%s req unsupported BW:%u\n", __func__, *req_bw);
+		rtw_warn_on(1);
+	}
+
+	if (*req_bw > *g_bw) {
+		*g_bw =3D *req_bw;
+		*g_offset =3D *req_offset;
+	}
+}
