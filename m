+		if ((info->bEnableSUTxBFWorkAround)
+		    && (entry =3D=3D info->TargetSUBFee)) {
+			entry->bSuspendSUCap =3D true;
+			info->TargetSUBFee =3D NULL;
+			memset(&info->TargetCSIInfo, 0, sizeof(struct _RT_CSI_INFO));
+			rtw_bf_cmd(adapter, BEAMFORMING_CTRL_SET_CSI_REPORT, (u8*)&info->Target=
CSIInfo, sizeof(struct _RT_CSI_INFO), 0);
