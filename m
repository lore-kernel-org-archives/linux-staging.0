+		fprintf(out_file, "%s - hexdump_ascii(len=3D%lu):\n",
+			title, (unsigned long) len);
+		while (len) {
+			llen =3D len > line_len ? line_len : len;
+			fprintf(out_file, "    ");
+			for (i =3D 0; i < llen; i++)
+				fprintf(out_file, " %02x", pos[i]);
+			for (i =3D llen; i < line_len; i++)
+				fprintf(out_file, "   ");
+			fprintf(out_file, "   ");
+			for (i =3D 0; i < llen; i++) {
