w.. */
+	pLed->bLedWPSBlinkInProgress =3D false;
+
+	pLed->BlinkTimes =3D 0; /*  Number of times to toggle led state for blink=
ing. */
+	pLed->BlinkingLedState =3D LED_UNKNOWN; /*  Next state for blinking, eith=
er RTW_LED_ON or RTW_LED_OFF are. */
