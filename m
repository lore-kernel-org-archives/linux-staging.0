+	/* Check how many bytes we already have and how many more we need. */
+	have =3D (size_t)((ctx->count >> 3) & (MD4_BLOCK_LENGTH - 1));
+	need =3D MD4_BLOCK_LENGTH - have;
+
+	/* Update bitcount */
+	ctx->count +=3D (u64)len << 3;
+
+	if (len >=3D need) {
+		if (have !=3D 0) {
+			os_memcpy(ctx->buffer + have, input, need);
+			MD4Transform(ctx->state, ctx->buffer);
+			input +=3D need;
+			len -=3D need;
+			have =3D 0;
+		}
+
+		/* Process data in MD4_BLOCK_LENGTH-byte chunks. */
+		while (len >=3D MD4_BLOCK_LENGTH) {
+			MD4Transform(ctx->state, input);
+			input +=3D MD4_BLOCK_LENGTH;
+			len -=3D MD4_BLOCK_LENGTH;
+		}
+	}
+
+	/* Handle any remaining bytes of data. */
+	if (len !=3D 0)
