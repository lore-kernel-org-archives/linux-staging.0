+    if (mode =3D=3D 1 && y =3D=3D 0) {
+      if ((err =3D mp_sqr (&res, &res)) !=3D MP_OKAY) {
+        goto LBL_RES;
+      }
+      if ((err =3D redux (&res, P, mp)) !=3D MP_OKAY) {
+        goto LBL_RES;
+      }
+      continue;
+    }
+
+    /* else we add it to the window */
+    bitbuf |=3D (y << (winsize - ++bitcpy));
+    mode    =3D 2;
+
+    if (bitcpy =3D=3D winsize) {
+      /* ok window is filled so square as required and multiply  */
+      /* square first */
+      for (x =3D 0; x < winsize; x++) {
+        if ((err =3D mp_sqr (&res, &res)) !=3D MP_OKAY) {
+          goto LBL_RES;
+        }
+        if ((err =3D redux (&res, P, mp)) !=3D MP_OKAY) {
+          goto LBL_RES;
+        }
+      }
+
+      /* then multiply */
+      if ((err =3D mp_mul (&res, &M[bitbuf], &res)) !=3D MP_OKAY) {
+        goto LBL_RES;
+      }
+      if ((err =3D redux (&res, P, mp)) !=3D MP_OKAY) {
+        goto LBL_RES;
+      }
+
+      /* empty window and reset */
+      bitcpy =3D 0;
+      bitbuf =3D 0;
+      mode   =3D 1;
+    }
+  }
+
+  /* if bits remain then square/multiply */
+  if (mode =3D=3D 2 && bitcpy > 0) {
+    /* square then multiply if the bit is set */
+    for (x =3D 0; x < bitcpy; x++) {
+      if ((err =3D mp_sqr (&res, &res)) !=3D MP_OKAY) {
+        goto LBL_RES;
+      }
+      if ((err =3D redux (&res, P, mp)) !=3D MP_OKAY) {
+        goto LBL_RES;
+      }
+
+      /* get next bit of the window */
+      bitbuf <<=3D 1;
+      if ((bitbuf & (1 << winsize)) !=3D 0) {
+        /* then multiply */
+        if ((err =3D mp_mul (&res, &M[1], &res)) !=3D MP_OKAY) {
+          goto LBL_RES;
+        }
+        if ((err =3D redux (&res, P, mp)) !=3D MP_OKAY) {
+          goto LBL_RES;
+        }
+      }
+    }
+  }
+
+  if (redmode =3D=3D 0) {
+     /* fixup result if Montgomery reduction is used
+      * recall that any value in a Montgomery system is
+      * actually multiplied by R mod n.  So we have
+      * to reduce one more time to cancel out the factor
+      * of R.
+      */
+     if ((err =3D redux(&res, P, mp)) !=3D MP_OKAY) {
+       goto LBL_RES;
+     }
+  }
+
+  /* swap res with Y */
+  mp_exch (&res, Y);
+  err =3D MP_OKAY;
+LBL_RES:mp_clear (&res);
+LBL_M:
+  mp_clear(&M[1]);
+  for (x =3D 1<<(winsize-1); x < (1 << winsize); x++) {
+    mp_clear (&M[x]);
+  }
+  return err;
+}
+#endif
+
+
+#ifdef BN_FAST_S_MP_SQR_C
+/* the jist of squaring...
+ * you do like mult except the offset of the tmpx [one that=20
+ * starts closer to zero] can't equal the offset of tmpy.=20=20
+ * So basically you set up iy like before then you min it with
+ * (ty-tx) so that it never happens.  You double all those=20
+ * you add in the inner loop
+
+After that loop you do the squares and add them in.
+*/
+
+static int fast_s_mp_sqr (mp_int * a, mp_int * b)
+{
+  int       olduse, res, pa, ix, iz;
+  mp_digit   W[MP_WARRAY], *tmpx;
+  mp_word   W1;
+
+  /* grow the destination as required */
+  pa =3D a->used + a->used;
+  if (b->alloc < pa) {
+    if ((res =3D mp_grow (b, pa)) !=3D MP_OKAY) {
+      return res;
+    }
+  }
+
+  /* number of output digits to produce */
+  W1 =3D 0;
+  for (ix =3D 0; ix < pa; ix++) {=20
+      int      tx, ty, iy;
+      mp_word  _W;
+      mp_digit *tmpy;
+
+      /* clear counter */
+      _W =3D 0;
+
+      /* get offsets into the two bignums */
+      ty =3D MIN(a->used-1, ix);
+      tx =3D ix - ty;
+
+      /* setup temp aliases */
+      tmpx =3D a->dp + tx;
+      tmpy =3D a->dp + ty;
+
+      /* this is the number of times the loop will iterrate, essentially
+         while (tx++ < a->used && ty-- >=3D 0) { ... }
+       */
+      iy =3D MIN(a->used-tx, ty+1);
+
+      /* now for squaring tx can never equal ty=20
+       * we halve the distance since they approach at a rate of 2x
+       * and we have to round because odd cases need to be executed
+       */
+      iy =3D MIN(iy, (ty-tx+1)>>1);
+
+      /* execute loop */
+      for (iz =3D 0; iz < iy; iz++) {
+         _W +=3D ((mp_word)*tmpx++)*((mp_word)*tmpy--);
+      }
+
+      /* double the inner product and add carry */
+      _W =3D _W + _W + W1;
+
+      /* even columns have the square term in them */
+      if ((ix&1) =3D=3D 0) {
+         _W +=3D ((mp_word)a->dp[ix>>1])*((mp_word)a->dp[ix>>1]);
+      }
+
+      /* store it */
+      W[ix] =3D (mp_digit)(_W & MP_MASK);
+
+      /* make next carry */
+      W1 =3D _W >> ((mp_word)DIGIT_BIT);
+  }
+
+  /* setup dest */
+  olduse  =3D b->used;
+  b->used =3D a->used+a->used;
+
+  {
+    mp_digit *tmpb;
+    tmpb =3D b->dp;
+    for (ix =3D 0; ix < pa; ix++) {
+      *tmpb++ =3D W[ix] & MP_MASK;
+    }
+
+    /* clear unused digits [that existed in the old copy of c] */
+    for (; ix < olduse; ix++) {
+      *tmpb++ =3D 0;
+    }
+  }
+  mp_clamp (b);
+  return MP_OKAY;
+}
+#endif
+
+
+#ifdef BN_MP_MUL_D_C
+/* multiply by a digit */
+static int
+mp_mul_d (mp_int * a, mp_digit b, mp_int * c)
+{
+  mp_digit u, *tmpa, *tmpc;
+  mp_word  r;
+  int      ix, res, olduse;
+
+  /* make sure c is big enough to hold a*b */
+  if (c->alloc < a->used + 1) {
+    if ((res =3D mp_grow (c, a->used + 1)) !=3D MP_OKAY) {
+      return res;
+    }
+  }
+
+  /* get the original destinations used count */
+  olduse =3D c->used;
+
+  /* set the sign */
+  c->sign =3D a->sign;
+
+  /* alias for a->dp [source] */
+  tmpa =3D a->dp;
+
+  /* alias for c->dp [dest] */
+  tmpc =3D c->dp;
+
+  /* zero carry */
+  u =3D 0;
+
+  /* compute columns */
+  for (ix =3D 0; ix < a->used; ix++) {
+    /* compute product and carry sum for this term */
+    r       =3D ((mp_word) u) + ((mp_word)*tmpa++) * ((mp_word)b);
+
+    /* mask off higher bits to get a single digit */
+    *tmpc++ =3D (mp_digit) (r & ((mp_word) MP_MASK));
+
+    /* send carry into next iteration */
+    u       =3D (mp_digit) (r >> ((mp_word) DIGIT_BIT));
+  }
+
+  /* store final carry [if any] and increment ix offset  */
+  *tmpc++ =3D u;
+  ++ix;
+
+  /* now zero digits above the top */
+  while (ix++ < olduse) {
+     *tmpc++ =3D 0;
+  }
+
+  /* set used count */
+  c->used =3D a->used + 1;
+  mp_clamp(c);
+
+  return MP_OKAY;
+}
+#endif
