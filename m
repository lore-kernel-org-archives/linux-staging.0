+#ifdef CONFIG_NATIVE_WINDOWS
+static int tncc_read_config_reg(struct tncc_data *tncc, HKEY hive)
+{
+	HKEY hk, hk2;
+	LONG ret;
+	DWORD i;
+	struct tnc_if_imc *imc, *last;
+	int j;
+
+	last =3D tncc->imc;
+	while (last && last->next)
+		last =3D last->next;
+
+	ret =3D RegOpenKeyEx(hive, TNC_WINREG_PATH, 0, KEY_ENUMERATE_SUB_KEYS,
+			   &hk);
+	if (ret !=3D ERROR_SUCCESS)
+		return 0;
+
+	for (i =3D 0; ; i++) {
+		TCHAR name[255], *val;
+		DWORD namelen, buflen;
+
+		namelen =3D 255;
+		ret =3D RegEnumKeyEx(hk, i, name, &namelen, NULL, NULL, NULL,
+				   NULL);
+
+		if (ret =3D=3D ERROR_NO_MORE_ITEMS)
+			break;
+
+		if (ret !=3D ERROR_SUCCESS) {
+			wpa_printf(MSG_DEBUG, "TNC: RegEnumKeyEx failed: 0x%x",
+				   (unsigned int) ret);
+			break;
+		}
+
+		if (namelen >=3D 255)
+			namelen =3D 255 - 1;
+		name[namelen] =3D '\0';
+
+		wpa_printf(MSG_DEBUG, "TNC: IMC '" TSTR "'", name);
+
+		ret =3D RegOpenKeyEx(hk, name, 0, KEY_QUERY_VALUE, &hk2);
+		if (ret !=3D ERROR_SUCCESS) {
+			wpa_printf(MSG_DEBUG, "Could not open IMC key '" TSTR
+				   "'", name);
+			continue;
+		}
+
+		ret =3D RegQueryValueEx(hk2, TEXT("Path"), NULL, NULL, NULL,
+				      &buflen);
+		if (ret !=3D ERROR_SUCCESS) {
+			wpa_printf(MSG_DEBUG, "TNC: Could not read Path from "
+				   "IMC key '" TSTR "'", name);
+			RegCloseKey(hk2);
+			continue;
+		}
+
+		val =3D os_malloc(buflen);
+		if (val =3D=3D NULL) {
+			RegCloseKey(hk2);
+			continue;
+		}
+
+		ret =3D RegQueryValueEx(hk2, TEXT("Path"), NULL, NULL,
+				      (LPBYTE) val, &buflen);
+		if (ret !=3D ERROR_SUCCESS) {
+			os_free(val);
+			RegCloseKey(hk2);
+			continue;
+		}
+
+		RegCloseKey(hk2);
+
+		wpa_unicode2ascii_inplace(val);
+		wpa_printf(MSG_DEBUG, "TNC: IMC Path '%s'", (char *) val);
+
+		for (j =3D 0; j < TNC_MAX_IMC_ID; j++) {
+			if (tnc_imc[j] =3D=3D NULL)
+				break;
+		}
+		if (j >=3D TNC_MAX_IMC_ID) {
+			wpa_printf(MSG_DEBUG, "TNC: Too many IMCs");
+			os_free(val);
+			continue;
+		}
+
+		imc =3D os_zalloc(sizeof(*imc));
+		if (imc =3D=3D NULL) {
+			os_free(val);
+			break;
+		}
+
+		imc->imcID =3D j;
+
+		wpa_unicode2ascii_inplace(name);
+		imc->name =3D os_strdup((char *) name);
+		imc->path =3D os_strdup((char *) val);
+
+		os_free(val);
+
+		if (last =3D=3D NULL)
+			tncc->imc =3D imc;
+		else
+			last->next =3D imc;
+		last =3D imc;
+
+		tnc_imc[imc->imcID] =3D imc;
+	}
+
+	RegCloseKey(hk);
+
+	return 0;
+}
