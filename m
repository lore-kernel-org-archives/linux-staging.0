+static void bwmode_update_check(_adapter *padapter, PNDIS_802_11_VARIABLE_=
IEs pIE)
+{
+	unsigned char	 new_bwmode;
+	unsigned char  new_ch_offset;
+	struct HT_info_element	*pHT_info;
+	struct mlme_priv	*pmlmepriv =3D &(padapter->mlmepriv);
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	struct registry_priv *pregistrypriv =3D &padapter->registrypriv;
+	struct ht_priv			*phtpriv =3D &pmlmepriv->htpriv;
+	u8	cbw40_enable =3D 0;
+
+	if (!pIE)
+		return;
+
+	if (phtpriv->ht_option =3D=3D false)
+		return;
+
+	if (pmlmeext->cur_bwmode >=3D CHANNEL_WIDTH_80)
+		return;
+
+	if (pIE->Length > sizeof(struct HT_info_element))
+		return;
+
+	pHT_info =3D (struct HT_info_element *)pIE->data;
+
+	if (hal_chk_bw_cap(padapter, BW_CAP_40M)) {
+		if (pmlmeext->cur_channel > 14) {
+			if (REGSTY_IS_BW_5G_SUPPORT(pregistrypriv, CHANNEL_WIDTH_40))
+				cbw40_enable =3D 1;
+		} else {
+			if (REGSTY_IS_BW_2G_SUPPORT(pregistrypriv, CHANNEL_WIDTH_40))
+				cbw40_enable =3D 1;
+		}
+	}
+
+	if ((pHT_info->infos[0] & BIT(2)) && cbw40_enable) {
+		new_bwmode =3D CHANNEL_WIDTH_40;
+
+		switch (pHT_info->infos[0] & 0x3) {
+		case 1:
+			new_ch_offset =3D HAL_PRIME_CHNL_OFFSET_LOWER;
+			break;
+
+		case 3:
+			new_ch_offset =3D HAL_PRIME_CHNL_OFFSET_UPPER;
+			break;
+
+		default:
+			new_bwmode =3D CHANNEL_WIDTH_20;
+			new_ch_offset =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+			break;
+		}
+	} else {
+		new_bwmode =3D CHANNEL_WIDTH_20;
+		new_ch_offset =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+	}
+
+
+	if ((new_bwmode !=3D pmlmeext->cur_bwmode || new_ch_offset !=3D pmlmeext-=
>cur_ch_offset)
+	    && new_bwmode < pmlmeext->cur_bwmode
+	   ) {
+		pmlmeinfo->bwmode_updated =3D true;
+
+		pmlmeext->cur_bwmode =3D new_bwmode;
+		pmlmeext->cur_ch_offset =3D new_ch_offset;
+
+		/* update HT info also */
+		HT_info_handler(padapter, pIE);
+	} else
+		pmlmeinfo->bwmode_updated =3D false;
+
+
+	if (pmlmeinfo->bwmode_updated) {
+		struct sta_info *psta;
+		WLAN_BSSID_EX	*cur_network =3D &(pmlmeinfo->network);
+		struct sta_priv	*pstapriv =3D &padapter->stapriv;
+
+		/* set_channel_bwmode(padapter, pmlmeext->cur_channel, pmlmeext->cur_ch_=
offset, pmlmeext->cur_bwmode); */
+
+
+		/* update ap's stainfo */
+		psta =3D rtw_get_stainfo(pstapriv, cur_network->MacAddress);
+		if (psta) {
+			struct ht_priv	*phtpriv_sta =3D &psta->htpriv;
+
+			if (phtpriv_sta->ht_option) {
+				/* bwmode				 */
+				psta->bw_mode =3D pmlmeext->cur_bwmode;
+				phtpriv_sta->ch_offset =3D pmlmeext->cur_ch_offset;
+			} else {
+				psta->bw_mode =3D CHANNEL_WIDTH_20;
+				phtpriv_sta->ch_offset =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+			}
+
+			rtw_dm_ra_mask_wk_cmd(padapter, (u8 *)psta);
+		}
+
+		/* pmlmeinfo->bwmode_updated =3D false; */ /* bwmode_updated done, reset=
 it! */
+	}
+}
