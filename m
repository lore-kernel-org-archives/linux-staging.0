+static void do_queue_select(_adapter	*padapter, struct pkt_attrib *pattrib)
+{
+	u8 qsel;
+
+	qsel =3D pattrib->priority;
+
+#ifdef CONFIG_CONCURRENT_MODE
+	/*	if (check_fwstate(&padapter->mlmepriv, WIFI_AP_STATE))
+	 *		qsel =3D 7; */
+#endif
+
+#ifdef CONFIG_MCC_MODE
+	if (MCC_EN(padapter)) {
+		/* Under MCC */
+		if (rtw_hal_check_mcc_status(padapter, MCC_STATUS_NEED_MCC)) {
+			if (padapter->mcc_adapterpriv.role =3D=3D MCC_ROLE_GO
+			    || padapter->mcc_adapterpriv.role =3D=3D MCC_ROLE_AP) {
+				pattrib->qsel =3D QSLT_VO; /* AP interface VO queue */
+			} else {
+				pattrib->qsel =3D QSLT_BE; /* STA interface BE queue */
+			}
+		} else
+			/* Not Under MCC */
+			pattrib->qsel =3D qsel;
+	} else
+		/* Not enable MCC */
+		pattrib->qsel =3D qsel;
+#else /* !CONFIG_MCC_MODE */
+	pattrib->qsel =3D qsel;
+#endif /* CONFIG_MCC_MODE */
+}
