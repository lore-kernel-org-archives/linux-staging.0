+static int _rtw_ioctl_wext_private(struct net_device *dev, union iwreq_dat=
a *wrq_data)
+{
+	int err =3D 0;
+	u8 *input =3D NULL;
+	u32 input_len =3D 0;
+	const char delim[] =3D " ";
+	u8 *output =3D NULL;
+	u32 output_len =3D 0;
+	u32 count =3D 0;
+	u8 *buffer =3D NULL;
+	u32 buffer_len =3D 0;
+	char *ptr =3D NULL;
+	u8 cmdname[17] =3D {0}; /* IFNAMSIZ+1 */
+	u32 cmdlen;
+	s32 len;
+	u8 *extra =3D NULL;
+	u32 extra_size =3D 0;
+
+	s32 k;
+	const iw_handler *priv;		/* Private ioctl */
+	const struct iw_priv_args *priv_args;	/* Private ioctl description */
+	const struct iw_priv_args *mp_priv_args;	/*MP Private ioctl description */
+	const struct iw_priv_args *sel_priv_args;	/*Selected Private ioctl descri=
ption */
+	u32 num_priv;				/* Number of ioctl */
+	u32 num_priv_args;			/* Number of descriptions */
+	u32 num_mp_priv_args;			/*Number of MP descriptions */
+	u32 num_sel_priv_args;			/*Number of Selected descriptions */
+	iw_handler handler;
+	int temp;
+	int subcmd =3D 0;				/* sub-ioctl index */
+	int offset =3D 0;				/* Space for sub-ioctl index */
+
+	union iwreq_data wdata;
+
+	memcpy(&wdata, wrq_data, sizeof(wdata));
+
+	input_len =3D wdata.data.length;
+	if (!input_len)
+		return -EINVAL;
+	input =3D rtw_zmalloc(input_len);
+	if (NULL =3D=3D input)
+		return -ENOMEM;
+	if (copy_from_user(input, wdata.data.pointer, input_len)) {
+		err =3D -EFAULT;
+		goto exit;
+	}
+	input[input_len - 1] =3D '\0';
+	ptr =3D input;
+	len =3D input_len;
+
+	if (ptr =3D=3D NULL) {
+		err =3D -EOPNOTSUPP;
+		goto exit;
+	}
+
+	sscanf(ptr, "%16s", cmdname);
+	cmdlen =3D strlen(cmdname);
+	RTW_INFO("%s: cmd=3D%s\n", __func__, cmdname);
+
+	/* skip command string */
+	if (cmdlen > 0)
+		cmdlen +=3D 1; /* skip one space */
+	ptr +=3D cmdlen;
+	len -=3D cmdlen;
+	RTW_INFO("%s: parameters=3D%s\n", __func__, ptr);
