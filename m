+void HT_caps_handler(_adapter *padapter, PNDIS_802_11_VARIABLE_IEs pIE)
+{
+	unsigned int	i;
+	u8	rf_type =3D RF_1T1R;
+	u8	max_AMPDU_len, min_MPDU_spacing;
+	u8	cur_ldpc_cap =3D 0, cur_stbc_cap =3D 0, cur_beamform_cap =3D 0, tx_nss=
 =3D 0;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	struct mlme_priv		*pmlmepriv =3D &padapter->mlmepriv;
+	struct ht_priv			*phtpriv =3D &pmlmepriv->htpriv;
+	struct registry_priv	*pregistrypriv =3D &padapter->registrypriv;
+	struct hal_spec_t *hal_spec =3D GET_HAL_SPEC(padapter);
+
+	if (pIE =3D=3D NULL)
+		return;
+
+	if (phtpriv->ht_option =3D=3D false)
+		return;
+
+	pmlmeinfo->HT_caps_enable =3D 1;
+
+	for (i =3D 0; i < (pIE->Length); i++) {
+		if (i !=3D 2) {
+			/*	Commented by Albert 2010/07/12 */
+			/*	Got the endian issue here. */
+			pmlmeinfo->HT_caps.u.HT_cap[i] &=3D (pIE->data[i]);
+		} else {
+			/* AMPDU Parameters field */
+
+			/* Get MIN of MAX AMPDU Length Exp */
+			if ((pmlmeinfo->HT_caps.u.HT_cap_element.AMPDU_para & 0x3) > (pIE->data=
[i] & 0x3))
+				max_AMPDU_len =3D (pIE->data[i] & 0x3);
+			else
+				max_AMPDU_len =3D (pmlmeinfo->HT_caps.u.HT_cap_element.AMPDU_para & 0x=
3);
+
+			/* Get MAX of MIN MPDU Start Spacing */
+			if ((pmlmeinfo->HT_caps.u.HT_cap_element.AMPDU_para & 0x1c) > (pIE->dat=
a[i] & 0x1c))
+				min_MPDU_spacing =3D (pmlmeinfo->HT_caps.u.HT_cap_element.AMPDU_para &=
 0x1c);
+			else
+				min_MPDU_spacing =3D (pIE->data[i] & 0x1c);
+
+			pmlmeinfo->HT_caps.u.HT_cap_element.AMPDU_para =3D max_AMPDU_len | min_=
MPDU_spacing;
+		}
+	}
+
+	/*	Commented by Albert 2010/07/12 */
+	/*	Have to handle the endian issue after copying. */
+	/*	HT_ext_caps didn't be used yet.	 */
+	pmlmeinfo->HT_caps.u.HT_cap_element.HT_caps_info =3D pmlmeinfo->HT_caps.u=
.HT_cap_element.HT_caps_info;
+	pmlmeinfo->HT_caps.u.HT_cap_element.HT_ext_caps =3D pmlmeinfo->HT_caps.u.=
HT_cap_element.HT_ext_caps;
+
+	/* update the MCS set */
+	for (i =3D 0; i < 16; i++)
+		pmlmeinfo->HT_caps.u.HT_cap_element.MCS_rate[i] &=3D pmlmeext->default_s=
upported_mcs_set[i];
+
+	rtw_hal_get_hwreg(padapter, HW_VAR_RF_TYPE, (u8 *)(&rf_type));
+	tx_nss =3D rtw_min(rf_type_to_rf_tx_cnt(rf_type), hal_spec->tx_nss_num);
+
+	switch (tx_nss) {
+	case 1:
+		set_mcs_rate_by_mask(pmlmeinfo->HT_caps.u.HT_cap_element.MCS_rate, MCS_R=
ATE_1R);
+		break;
+	case 2:
+		#ifdef CONFIG_DISABLE_MCS13TO15
+		if (pmlmeext->cur_bwmode =3D=3D CHANNEL_WIDTH_40 && pregistrypriv->wifi_=
spec !=3D 1)
+			set_mcs_rate_by_mask(pmlmeinfo->HT_caps.u.HT_cap_element.MCS_rate, MCS_=
RATE_2R_13TO15_OFF);
+		else
+		#endif
+			set_mcs_rate_by_mask(pmlmeinfo->HT_caps.u.HT_cap_element.MCS_rate, MCS_=
RATE_2R);
+		break;
+	case 3:
