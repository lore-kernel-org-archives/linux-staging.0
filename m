+{
+	struct hostap_driver_data *drv =3D priv;
+	struct prism2_hostapd_param *param;
+	u8 *buf;
+	size_t blen;
+	int ret =3D 0;
+
+	blen =3D sizeof(*param) + 32;
+	buf =3D os_zalloc(blen);
+	if (buf =3D=3D NULL)
+		return -1;
+
+	param =3D (struct prism2_hostapd_param *) buf;
+	param->cmd =3D PRISM2_GET_ENCRYPTION;
+	if (addr =3D=3D NULL)
+		memset(param->sta_addr, 0xff, ETH_ALEN);
+	else
+		memcpy(param->sta_addr, addr, ETH_ALEN);
+	param->u.crypt.idx =3D idx;
+
+	if (hostapd_ioctl(drv, param, blen)) {
+		printf("Failed to get encryption.\n");
+		ret =3D -1;
+	} else {
