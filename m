+int hostapd_mode_init(_adapter *padapter)
+{
+	unsigned char mac[ETH_ALEN];
+	struct hostapd_priv *phostapdpriv;
+	struct net_device *pnetdev;
+
+	pnetdev =3D rtw_alloc_etherdev(sizeof(struct hostapd_priv));
+	if (!pnetdev)
+		return -ENOMEM;
+
+	/* SET_MODULE_OWNER(pnetdev); */
+	ether_setup(pnetdev);
+
+	/* pnetdev->type =3D ARPHRD_IEEE80211; */
+
+	phostapdpriv =3D rtw_netdev_priv(pnetdev);
+	phostapdpriv->pmgnt_netdev =3D pnetdev;
+	phostapdpriv->padapter =3D padapter;
+	padapter->phostapdpriv =3D phostapdpriv;
+
+	/* pnetdev->init =3D NULL; */
+
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 29))
+
+	RTW_INFO("register rtl871x_mgnt_netdev_ops to netdev_ops\n");
+
+	pnetdev->netdev_ops =3D &rtl871x_mgnt_netdev_ops;
+
+#else
+
+	pnetdev->open =3D mgnt_netdev_open;
+
+	pnetdev->stop =3D mgnt_netdev_close;
+
+	pnetdev->hard_start_xmit =3D mgnt_xmit_entry;
+
+	/* pnetdev->set_mac_address =3D r871x_net_set_mac_address; */
+
+	/* pnetdev->get_stats =3D r871x_net_get_stats; */
+
+	/* pnetdev->do_ioctl =3D r871x_mp_ioctl; */
+
+#endif
+
+	pnetdev->watchdog_timeo =3D HZ; /* 1 second timeout */
+
+	/* pnetdev->wireless_handlers =3D NULL; */
+
+#ifdef CONFIG_TCP_CSUM_OFFLOAD_TX
+	pnetdev->features |=3D NETIF_F_IP_CSUM;
+#endif
+
+
+
+	if (dev_alloc_name(pnetdev, "mgnt.wlan%d") < 0)
+		RTW_INFO("hostapd_mode_init(): dev_alloc_name, fail!\n");
+
+
+	/* SET_NETDEV_DEV(pnetdev, pintfpriv->udev); */
+
+
+	mac[0] =3D 0x00;
+	mac[1] =3D 0xe0;
+	mac[2] =3D 0x4c;
+	mac[3] =3D 0x87;
+	mac[4] =3D 0x11;
+	mac[5] =3D 0x12;
+
+	memcpy(pnetdev->dev_addr, mac, ETH_ALEN);
+
+
+	netif_carrier_off(pnetdev);
+
+
+	/* Tell the network stack we exist */
+	if (register_netdev(pnetdev) !=3D 0) {
+		RTW_INFO("hostapd_mode_init(): register_netdev fail!\n");
+
+		if (pnetdev)
+			rtw_free_netdev(pnetdev);
+	}
+
+	return 0;
+
+}
