+
+	res =3D tlsv1_server_handshake(conn->server, wpabuf_head(in_data),
+				     wpabuf_len(in_data), &res_len);
+	if (res =3D=3D NULL && tlsv1_server_established(conn->server))
+		return wpabuf_alloc(0);
+	if (res =3D=3D NULL)
+		return NULL;
+	out =3D wpabuf_alloc_ext_data(res, res_len);
+	if (out =3D=3D NULL) {
