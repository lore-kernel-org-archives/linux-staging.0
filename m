+static int tls_match_altsubject(X509 *cert, const char *match)
+{
+	int type;
+	const char *pos, *end;
+	size_t len;
+
+	pos =3D match;
+	do {
+		if (os_strncmp(pos, "EMAIL:", 6) =3D=3D 0) {
+			type =3D GEN_EMAIL;
+			pos +=3D 6;
+		} else if (os_strncmp(pos, "DNS:", 4) =3D=3D 0) {
+			type =3D GEN_DNS;
+			pos +=3D 4;
+		} else if (os_strncmp(pos, "URI:", 4) =3D=3D 0) {
+			type =3D GEN_URI;
+			pos +=3D 4;
+		} else {
+			wpa_printf(MSG_INFO, "TLS: Invalid altSubjectName "
+				   "match '%s'", pos);
+			return 0;
+		}
+		end =3D os_strchr(pos, ';');
+		while (end) {
+			if (os_strncmp(end + 1, "EMAIL:", 6) =3D=3D 0 ||
+			    os_strncmp(end + 1, "DNS:", 4) =3D=3D 0 ||
+			    os_strncmp(end + 1, "URI:", 4) =3D=3D 0)
+				break;
+			end =3D os_strchr(end + 1, ';');
+		}
+		if (end)
+			len =3D end - pos;
+		else
+			len =3D os_strlen(pos);
+		if (tls_match_altsubject_component(cert, type, pos, len) > 0)
+			return 1;
+		pos =3D end + 1;
+	} while (end);
