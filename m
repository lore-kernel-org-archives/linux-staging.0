+		printf("Failed to get station stats information element.\n");
+		return -1;
+	}
+
+	data->rx_packets =3D stats.is_stats.ns_rx_data;
+	data->rx_bytes =3D stats.is_stats.ns_rx_bytes;
+	data->tx_packets =3D stats.is_stats.ns_tx_data;
+	data->tx_bytes =3D stats.is_stats.ns_tx_bytes;
