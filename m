+			rlen =3D rtw_retrieve_from_file(rtw_phy_para_file_path, pHalData->para_=
file_buf, MAX_PARA_FILE_BUF_LEN);
+			if (rlen > 0) {
+				rtStatus =3D _SUCCESS;
+				pBuf =3D rtw_zvmalloc(rlen);
+				if (pBuf) {
+					memcpy(pBuf, pHalData->para_file_buf, rlen);
+					*pBufLen =3D rlen;
+
+					switch (eRFPath) {
+					case ODM_RF_PATH_A:
+						pHalData->rf_radio_a =3D pBuf;
+						break;
+					case ODM_RF_PATH_B:
+						pHalData->rf_radio_b =3D pBuf;
+						break;
+					}
+				} else
+					RTW_INFO("%s(): eRFPath=3D%d  alloc fail !\n", __func__, eRFPath);
+			}
+		}
+	} else {
+		if ((pBufLen !=3D NULL) && (*pBufLen !=3D 0) && (pBuf !=3D NULL)) {
+			memcpy(pHalData->para_file_buf, pBuf, *pBufLen);
+			rtStatus =3D _SUCCESS;
+		} else
+			RTW_INFO("%s(): Critical Error !!!\n", __func__);
+	}
+
+	if (rtStatus =3D=3D _SUCCESS) {
+		/* RTW_INFO("%s(): read %s successfully\n", __func__, pFileName); */
+
+		ptmp =3D pHalData->para_file_buf;
+		for (szLine =3D GetLineFromBuffer(ptmp); szLine !=3D NULL; szLine =3D Ge=
tLineFromBuffer(ptmp)) {
+			if (!IsCommentString(szLine)) {
+				/* Get 1st hex value as register offset. */
+				if (GetHexValueFromString(szLine, &u4bRegOffset, &u4bMove)) {
+					if (u4bRegOffset =3D=3D 0xfe || u4bRegOffset =3D=3D 0xffe) {
+						/* Deay specific ms. Only RF configuration require delay.											=
	 */
+#ifdef CONFIG_LONG_DELAY_ISSUE
+						rtw_msleep_os(50);
+#else
+						rtw_mdelay_os(50);
+#endif
+					} else if (u4bRegOffset =3D=3D 0xfd) {
+						/* delay_ms(5); */
+						for (i =3D 0; i < 100; i++)
+							rtw_udelay_os(MAX_STALL_TIME);
+					} else if (u4bRegOffset =3D=3D 0xfc) {
+						/* delay_ms(1); */
+						for (i =3D 0; i < 20; i++)
+							rtw_udelay_os(MAX_STALL_TIME);
+					} else if (u4bRegOffset =3D=3D 0xfb)
+						rtw_udelay_os(50);
+					else if (u4bRegOffset =3D=3D 0xfa)
+						rtw_udelay_os(5);
+					else if (u4bRegOffset =3D=3D 0xf9)
+						rtw_udelay_os(1);
+					else if (u4bRegOffset =3D=3D 0xffff)
+						break;
+
+					/* Get 2nd hex value as register value. */
+					szLine +=3D u4bMove;
+					if (GetHexValueFromString(szLine, &u4bRegValue, &u4bMove)) {
+						phy_set_rf_reg(Adapter, eRFPath, u4bRegOffset, bRFRegOffsetMask, u4b=
RegValue);
+
+						/* Temp add, for frequency lock, if no delay, that may cause */
+						/* frequency shift, ex: 2412MHz =3D> 2417MHz */
+						/* If frequency shift, the following action may works. */
+						/* Fractional-N table in radio_a.txt */
+						/* 0x2a 0x00001		 */ /* channel 1 */
+						/* 0x2b 0x00808		frequency divider. */
+						/* 0x2b 0x53333 */
+						/* 0x2c 0x0000c */
+						rtw_udelay_os(1);
+					}
+				}
+			}
+		}
+	} else
+		RTW_INFO("%s(): No File %s, Load from HWImg Array!\n", __func__, pFileNa=
me);
+
+	return rtStatus;
+}
