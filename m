+	for (tx_num =3D 0; tx_num < TX_PWR_BY_RATE_NUM_RF; tx_num++) {
+		if (tx_num >=3D hal_spec->max_tx_cnt || tx_num >=3D hal_spec->tx_nss_num)
+			goto exit;
