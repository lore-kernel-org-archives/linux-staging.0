+struct wpabuf * tls_connection_encrypt(void *tls_ctx,
+				       struct tls_connection *conn,
+				       const struct wpabuf *in_data)
+{
+	struct tls_global *global =3D tls_ctx;
+	SECURITY_STATUS status;
+	SecBufferDesc buf;
+	SecBuffer bufs[4];
+	SecPkgContext_StreamSizes sizes;
+	int i;
+	struct wpabuf *out;
+
+	status =3D global->sspi->QueryContextAttributes(&conn->context,
+						      SECPKG_ATTR_STREAM_SIZES,
+						      &sizes);
+	if (status !=3D SEC_E_OK) {
+		wpa_printf(MSG_DEBUG, "%s: QueryContextAttributes failed",
+			   __func__);
+		return NULL;
+	}
+	wpa_printf(MSG_DEBUG, "%s: Stream sizes: header=3D%u trailer=3D%u",
+		   __func__,
+		   (unsigned int) sizes.cbHeader,
+		   (unsigned int) sizes.cbTrailer);
+
+	out =3D wpabuf_alloc(sizes.cbHeader + wpabuf_len(in_data) +
+			   sizes.cbTrailer);
+
+	os_memset(&bufs, 0, sizeof(bufs));
+	bufs[0].pvBuffer =3D wpabuf_put(out, sizes.cbHeader);
+	bufs[0].cbBuffer =3D sizes.cbHeader;
+	bufs[0].BufferType =3D SECBUFFER_STREAM_HEADER;
+
+	bufs[1].pvBuffer =3D wpabuf_put(out, 0);
+	wpabuf_put_buf(out, in_data);
+	bufs[1].cbBuffer =3D wpabuf_len(in_data);
+	bufs[1].BufferType =3D SECBUFFER_DATA;
+
+	bufs[2].pvBuffer =3D wpabuf_put(out, sizes.cbTrailer);
+	bufs[2].cbBuffer =3D sizes.cbTrailer;
+	bufs[2].BufferType =3D SECBUFFER_STREAM_TRAILER;
+
+	buf.ulVersion =3D SECBUFFER_VERSION;
+	buf.cBuffers =3D 3;
+	buf.pBuffers =3D bufs;
+
+	status =3D global->sspi->EncryptMessage(&conn->context, 0, &buf, 0);
+
+	wpa_printf(MSG_MSGDUMP, "Schannel: EncryptMessage -> "
+		   "status=3D%d len[0]=3D%d type[0]=3D%d len[1]=3D%d type[1]=3D%d "
+		   "len[2]=3D%d type[2]=3D%d",
+		   (int) status,
+		   (int) bufs[0].cbBuffer, (int) bufs[0].BufferType,
+		   (int) bufs[1].cbBuffer, (int) bufs[1].BufferType,
+		   (int) bufs[2].cbBuffer, (int) bufs[2].BufferType);
+	wpa_printf(MSG_MSGDUMP, "Schannel: EncryptMessage pointers: "
+		   "out_data=3D%p bufs %p %p %p",
+		   wpabuf_head(out), bufs[0].pvBuffer, bufs[1].pvBuffer,
+		   bufs[2].pvBuffer);
+
+	for (i =3D 0; i < 3; i++) {
+		if (bufs[i].pvBuffer && bufs[i].BufferType !=3D SECBUFFER_EMPTY)
+		{
+			wpa_hexdump(MSG_MSGDUMP, "SChannel: bufs",
+				    bufs[i].pvBuffer, bufs[i].cbBuffer);
+		}
+	}
+
+	if (status =3D=3D SEC_E_OK) {
+		wpa_printf(MSG_DEBUG, "%s: SEC_E_OK", __func__);
+		wpa_hexdump_buf_key(MSG_MSGDUMP, "Schannel: Encrypted data "
+				    "from EncryptMessage", out);
+		return out;
+	}
+
+	wpa_printf(MSG_DEBUG, "%s: Failed - status=3D%d",
+		   __func__, (int) status);
+	wpabuf_free(out);
+	return NULL;
+}
+
+
+struct wpabuf * tls_connection_decrypt(void *tls_ctx,
+				       struct tls_connection *conn,
+				       const struct wpabuf *in_data)
+{
+	struct tls_global *global =3D tls_ctx;
+	SECURITY_STATUS status;
+	SecBufferDesc buf;
+	SecBuffer bufs[4];
+	int i;
+	struct wpabuf *out, *tmp;
+
+	wpa_hexdump_buf(MSG_MSGDUMP,
+			"Schannel: Encrypted data to DecryptMessage", in_data);
+	os_memset(&bufs, 0, sizeof(bufs));
+	tmp =3D wpabuf_dup(in_data);
+	if (tmp =3D=3D NULL)
+		return NULL;
+	bufs[0].pvBuffer =3D wpabuf_mhead(tmp);
+	bufs[0].cbBuffer =3D wpabuf_len(in_data);
+	bufs[0].BufferType =3D SECBUFFER_DATA;
+
+	bufs[1].BufferType =3D SECBUFFER_EMPTY;
+	bufs[2].BufferType =3D SECBUFFER_EMPTY;
+	bufs[3].BufferType =3D SECBUFFER_EMPTY;
+
+	buf.ulVersion =3D SECBUFFER_VERSION;
+	buf.cBuffers =3D 4;
+	buf.pBuffers =3D bufs;
+
+	status =3D global->sspi->DecryptMessage(&conn->context, &buf, 0,
+						    NULL);
+	wpa_printf(MSG_MSGDUMP, "Schannel: DecryptMessage -> "
+		   "status=3D%d len[0]=3D%d type[0]=3D%d len[1]=3D%d type[1]=3D%d "
+		   "len[2]=3D%d type[2]=3D%d len[3]=3D%d type[3]=3D%d",
+		   (int) status,
+		   (int) bufs[0].cbBuffer, (int) bufs[0].BufferType,
+		   (int) bufs[1].cbBuffer, (int) bufs[1].BufferType,
+		   (int) bufs[2].cbBuffer, (int) bufs[2].BufferType,
+		   (int) bufs[3].cbBuffer, (int) bufs[3].BufferType);
+	wpa_printf(MSG_MSGDUMP, "Schannel: DecryptMessage pointers: "
+		   "out_data=3D%p bufs %p %p %p %p",
+		   wpabuf_head(tmp), bufs[0].pvBuffer, bufs[1].pvBuffer,
+		   bufs[2].pvBuffer, bufs[3].pvBuffer);
+
+	switch (status) {
+	case SEC_E_INCOMPLETE_MESSAGE:
+		wpa_printf(MSG_DEBUG, "%s: SEC_E_INCOMPLETE_MESSAGE",
+			   __func__);
+		break;
+	case SEC_E_OK:
+		wpa_printf(MSG_DEBUG, "%s: SEC_E_OK", __func__);
+		for (i =3D 0; i < 4; i++) {
+			if (bufs[i].BufferType =3D=3D SECBUFFER_DATA)
+				break;
+		}
+		if (i =3D=3D 4) {
+			wpa_printf(MSG_DEBUG, "%s: No output data from "
+				   "DecryptMessage", __func__);
+			wpabuf_free(tmp);
+			return NULL;
+		}
+		wpa_hexdump_key(MSG_MSGDUMP, "Schannel: Decrypted data from "
+				"DecryptMessage",
+				bufs[i].pvBuffer, bufs[i].cbBuffer);
+		out =3D wpabuf_alloc_copy(bufs[i].pvBuffer, bufs[i].cbBuffer);
+		wpabuf_free(tmp);
+		return out;
+	}
+
+	wpa_printf(MSG_DEBUG, "%s: Failed - status=3D%d",
+		   __func__, (int) status);
+	wpabuf_free(tmp);
+	return NULL;
+}
