+static int p2p_get_next_prog_freq(struct p2p_data *p2p)
+{
+	struct p2p_channels *c;
+	struct p2p_reg_class *cla;
+	size_t cl, ch;
+	int found =3D 0;
+	u8 reg_class;
+	u8 channel;
+	int freq;
+
+	c =3D &p2p->cfg->channels;
+	for (cl =3D 0; cl < c->reg_classes; cl++) {
+		cla =3D &c->reg_class[cl];
+		if (cla->reg_class !=3D p2p->last_prog_scan_class)
+			continue;
+		for (ch =3D 0; ch < cla->channels; ch++) {
+			if (cla->channel[ch] =3D=3D p2p->last_prog_scan_chan) {
+				found =3D 1;
+				break;
+			}
+		}
+		if (found)
+			break;
+	}
+
+	if (!found) {
+		/* Start from beginning */
+		reg_class =3D c->reg_class[0].reg_class;
+		channel =3D c->reg_class[0].channel[0];
+	} else {
+		/* Pick the next channel */
+		ch++;
+		if (ch =3D=3D cla->channels) {
+			cl++;
+			if (cl =3D=3D c->reg_classes)
+				cl =3D 0;
+			ch =3D 0;
+		}
+		reg_class =3D c->reg_class[cl].reg_class;
+		channel =3D c->reg_class[cl].channel[ch];
+	}
+
+	freq =3D p2p_channel_to_freq(p2p->cfg->country, reg_class, channel);
+	wpa_msg(p2p->cfg->msg_ctx, MSG_DEBUG, "P2P: Next progressive search "
+		"channel: reg_class %u channel %u -> %d MHz",
+		reg_class, channel, freq);
+	p2p->last_prog_scan_class =3D reg_class;
+	p2p->last_prog_scan_chan =3D channel;
+
+	if (freq =3D=3D 2412 || freq =3D=3D 2437 || freq =3D=3D 2462)
+		return 0; /* No need to add social channels */
+	return freq;
+}
