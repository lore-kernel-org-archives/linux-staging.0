+void rtl8188e_sreset_xmit_status_check(_adapter *padapter)
+{
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(padapter);
+	struct sreset_priv *psrtpriv =3D &pHalData->srestpriv;
+
+	unsigned long current_time;
+	struct xmit_priv	*pxmitpriv =3D &padapter->xmitpriv;
+	unsigned int diff_time;
+	u32 txdma_status;
+
+	txdma_status =3D rtw_read32(padapter, REG_TXDMA_STATUS);
+	if (txdma_status !=3D 0x00 && txdma_status !=3D 0xeaeaeaea) {
+		RTW_INFO("%s REG_TXDMA_STATUS:0x%08x\n", __func__, txdma_status);
+		rtw_hal_sreset_reset(padapter);
+	}
+	current_time =3D jiffies;
+
+	if (0 =3D=3D pxmitpriv->free_xmitbuf_cnt || 0 =3D=3D pxmitpriv->free_xmit=
_extbuf_cnt) {
+
+		diff_time =3D rtw_get_passing_time_ms(psrtpriv->last_tx_time);
+
+		if (diff_time > 2000) {
+			if (psrtpriv->last_tx_complete_time =3D=3D 0)
+				psrtpriv->last_tx_complete_time =3D current_time;
+			else {
+				diff_time =3D rtw_get_passing_time_ms(psrtpriv->last_tx_complete_time);
+				if (diff_time > 4000) {
+					u32 ability =3D 0;
+
+					/* padapter->Wifi_Error_Status =3D WIFI_TX_HANG; */
+					ability =3D rtw_phydm_ability_get(padapter);
+					RTW_INFO("%s tx hang %s\n", __func__,
+						(ability & ODM_BB_ADAPTIVITY) ? "ODM_BB_ADAPTIVITY" : "");
+
+					if (!(ability & ODM_BB_ADAPTIVITY))
+						rtw_hal_sreset_reset(padapter);
+				}
+			}
+		}
+	}
+
+	if (psrtpriv->dbg_trigger_point =3D=3D SRESET_TGP_XMIT_STATUS) {
+		psrtpriv->dbg_trigger_point =3D SRESET_TGP_NULL;
+		rtw_hal_sreset_reset(padapter);
+		return;
+	}
+}
