+#ifdef CONFIG_TDLS
+sint xmitframe_enqueue_for_tdls_sleeping_sta(_adapter *padapter, struct xm=
it_frame *pxmitframe)
+{
+	sint ret =3D false;
+
+	unsigned long irqL;
+	struct sta_info *ptdls_sta =3D NULL;
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+	struct pkt_attrib *pattrib =3D &pxmitframe->attrib;
+	struct mlme_ext_priv	*pmlmeext =3D &(padapter->mlmeextpriv);
+	int i;
+
+	ptdls_sta =3D rtw_get_stainfo(pstapriv, pattrib->dst);
+	if (ptdls_sta =3D=3D NULL)
+		return ret;
+	else if (ptdls_sta->tdls_sta_state & TDLS_LINKED_STATE) {
+
+		if (pattrib->triggered =3D=3D 1) {
+			ret =3D true;
+			return ret;
+		}
+
+		_enter_critical_bh(&ptdls_sta->sleep_q.lock, &irqL);
+
+		if (ptdls_sta->state & WIFI_SLEEP_STATE) {
+			list_del_init(&pxmitframe->list);
+
+			/* _enter_critical_bh(&psta->sleep_q.lock, &irqL);	 */
+
+			list_add_tail(&pxmitframe->list, get_list_head(&ptdls_sta->sleep_q));
+
+			ptdls_sta->sleepq_len++;
+			ptdls_sta->sleepq_ac_len++;
+
+			/* indicate 4-AC queue bit in TDLS peer traffic indication */
+			switch (pattrib->priority) {
+			case 1:
+			case 2:
+				ptdls_sta->uapsd_bk |=3D BIT(1);
+				break;
+			case 4:
+			case 5:
+				ptdls_sta->uapsd_vi |=3D BIT(1);
+				break;
+			case 6:
+			case 7:
+				ptdls_sta->uapsd_vo |=3D BIT(1);
+				break;
+			case 0:
+			case 3:
+			default:
+				ptdls_sta->uapsd_be |=3D BIT(1);
+				break;
+			}
+
+			/* Transmit TDLS PTI via AP */
+			if (ptdls_sta->sleepq_len =3D=3D 1)
+				rtw_tdls_cmd(padapter, ptdls_sta->hwaddr, TDLS_ISSUE_PTI);
+
+			ret =3D true;
+		}
+
+		_exit_critical_bh(&ptdls_sta->sleep_q.lock, &irqL);
+	}
+
+	return ret;
+
+}
