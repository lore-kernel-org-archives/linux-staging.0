+static int x509_id_ce_oid(struct asn1_oid *oid)
+{
+	/* id-ce arc from X.509 for standard X.509v3 extensions */
+	return oid->len >=3D 4 &&
+		oid->oid[0] =3D=3D 2 /* joint-iso-ccitt */ &&
+		oid->oid[1] =3D=3D 5 /* ds */ &&
+		oid->oid[2] =3D=3D 29 /* id-ce */;
+}
