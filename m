+	u32	*p_value,
+	u32	*rank_idx,
+	u32	*p_idx_out,
+	u8	seq_length
+)
+{
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u8		i =3D 0, j =3D 0;
+	u32		tmp_a, tmp_b;
+	u32		tmp_idx_a, tmp_idx_b;
+
+	for (i =3D 0; i < seq_length; i++) {
+		rank_idx[i] =3D i;
+		/**/
+	}
+
+	for (i =3D 0; i < (seq_length - 1); i++) {
+
+		for (j =3D 0; j < (seq_length - 1 - i); j++) {
+
+			tmp_a =3D p_value[j];
+			tmp_b =3D p_value[j + 1];
+
+			tmp_idx_a =3D rank_idx[j];
+			tmp_idx_b =3D rank_idx[j + 1];
+
+			if (tmp_a < tmp_b) {
+				p_value[j] =3D tmp_b;
+				p_value[j + 1] =3D tmp_a;
+
+				rank_idx[j] =3D tmp_idx_b;
+				rank_idx[j + 1] =3D tmp_idx_a;
+			}
+		}
+	}
+
+	for (i =3D 0; i < seq_length; i++) {
+		p_idx_out[rank_idx[i]] =3D i + 1;
+		/**/
+	}
