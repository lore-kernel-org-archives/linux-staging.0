+static int phy_ParsePowerLimitTableFile(
+	PADAPTER		Adapter,
+	char			*buffer
+)
+{
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(Adapter);
+	struct PHY_DM_STRUCT	*pDM_Odm =3D &(pHalData->odmpriv);
+	u32	i =3D 0, forCnt =3D 0;
+	u8	loadingStage =3D 0, limitValue =3D 0, fraction =3D 0;
+	char	*szLine, *ptmp;
+	int	rtStatus =3D _SUCCESS;
+	char band[10], bandwidth[10], rateSection[10],
+	     regulation[TXPWR_LMT_MAX_REGULATION_NUM][10], rfPath[10], colNumBuf[=
10];
+	u8	colNum =3D 0;
+
+	RTW_INFO("=3D=3D=3D>phy_ParsePowerLimitTableFile()\n");
+
+	if (Adapter->registrypriv.RegDecryptCustomFile =3D=3D 1)
+		phy_DecryptBBPgParaFile(Adapter, buffer);
+
+	ptmp =3D buffer;
+	for (szLine =3D GetLineFromBuffer(ptmp); szLine !=3D NULL; szLine =3D Get=
LineFromBuffer(ptmp)) {
+		if (isAllSpaceOrTab(szLine, sizeof(*szLine)))
+			continue;
+
+		/* skip comment */
+		if (IsCommentString(szLine))
+			continue;
+
+		if (loadingStage =3D=3D 0) {
+			for (forCnt =3D 0; forCnt < TXPWR_LMT_MAX_REGULATION_NUM; ++forCnt)
+				memset((void *) regulation[forCnt], 0, 10);
+			memset((void *) band, 0, 10);
+			memset((void *) bandwidth, 0, 10);
+			memset((void *) rateSection, 0, 10);
+			memset((void *) rfPath, 0, 10);
+			memset((void *) colNumBuf, 0, 10);
+
+			if (szLine[0] !=3D '#' || szLine[1] !=3D '#')
+				continue;
+
+			/* skip the space */
+			i =3D 2;
+			while (szLine[i] =3D=3D ' ' || szLine[i] =3D=3D '\t')
+				++i;
+
+			szLine[--i] =3D ' '; /* return the space in front of the regulation inf=
o */
+
+			/* Parse the label of the table */
+			if (!ParseQualifiedString(szLine, &i, band, ' ', ',')) {
+				RTW_INFO("Fail to parse band!\n");
+				return _FAIL;
+			}
+			if (!ParseQualifiedString(szLine, &i, bandwidth, ' ', ',')) {
+				RTW_INFO("Fail to parse bandwidth!\n");
+				return _FAIL;
+			}
+			if (!ParseQualifiedString(szLine, &i, rfPath, ' ', ',')) {
+				RTW_INFO("Fail to parse rf path!\n");
+				return _FAIL;
+			}
+			if (!ParseQualifiedString(szLine, &i, rateSection, ' ', ',')) {
+				RTW_INFO("Fail to parse rate!\n");
+				return _FAIL;
+			}
+
+			loadingStage =3D 1;
+		} else if (loadingStage =3D=3D 1) {
+			if (szLine[0] !=3D '#' || szLine[1] !=3D '#')
+				continue;
+
+			/* skip the space */
+			i =3D 2;
+			while (szLine[i] =3D=3D ' ' || szLine[i] =3D=3D '\t')
+				++i;
+
+			if (!eqNByte((u8 *)(szLine + i), (u8 *)("START"), 5)) {
+				RTW_INFO("Lost \"##   START\" label\n");
+				return _FAIL;
+			}
+
+			loadingStage =3D 2;
+		} else if (loadingStage =3D=3D 2) {
+			if (szLine[0] !=3D '#' || szLine[1] !=3D '#')
+				continue;
+
+			/* skip the space */
+			i =3D 2;
+			while (szLine[i] =3D=3D ' ' || szLine[i] =3D=3D '\t')
+				++i;
+
+			if (!ParseQualifiedString(szLine, &i, colNumBuf, '#', '#')) {
+				RTW_INFO("Fail to parse column number!\n");
+				return _FAIL;
+			}
+
+			if (!GetU1ByteIntegerFromStringInDecimal(colNumBuf, &colNum))
+				return _FAIL;
+
+			if (colNum > TXPWR_LMT_MAX_REGULATION_NUM) {
+				RTW_INFO("unvalid col number %d (greater than max %d)\n",
+					 colNum, TXPWR_LMT_MAX_REGULATION_NUM);
+				return _FAIL;
+			}
+
+			for (forCnt =3D 0; forCnt < colNum; ++forCnt) {
+				u8	regulation_name_cnt =3D 0;
+
+				/* skip the space */
+				while (szLine[i] =3D=3D ' ' || szLine[i] =3D=3D '\t')
+					++i;
+
+				while (szLine[i] !=3D ' ' && szLine[i] !=3D '\t' && szLine[i] !=3D '\0=
')
+					regulation[forCnt][regulation_name_cnt++] =3D szLine[i++];
+				/* RTW_INFO("regulation %s!\n", regulation[forCnt]); */
+
+				if (regulation_name_cnt =3D=3D 0) {
+					RTW_INFO("unvalid number of regulation!\n");
+					return _FAIL;
+				}
+			}
+
+			loadingStage =3D 3;
+		} else if (loadingStage =3D=3D 3) {
+			char	channel[10] =3D {0}, powerLimit[10] =3D {0};
+			u8	cnt =3D 0;
+
+			/* the table ends */
+			if (szLine[0] =3D=3D '#' && szLine[1] =3D=3D '#') {
+				i =3D 2;
+				while (szLine[i] =3D=3D ' ' || szLine[i] =3D=3D '\t')
+					++i;
+
+				if (eqNByte((u8 *)(szLine + i), (u8 *)("END"), 3)) {
+					loadingStage =3D 0;
+					continue;
+				} else {
+					RTW_INFO("Wrong format\n");
+					RTW_INFO("<=3D=3D=3D=3D=3D phy_ParsePowerLimitTableFile()\n");
+					return _FAIL;
+				}
+			}
+
+			if ((szLine[0] !=3D 'c' && szLine[0] !=3D 'C') ||
+			    (szLine[1] !=3D 'h' && szLine[1] !=3D 'H')) {
+				RTW_INFO("Meet wrong channel =3D> power limt pair '%c','%c'(%d,%d)\n",=
 szLine[0], szLine[1], szLine[0], szLine[1]);
+				continue;
+			}
+			i =3D 2;/* move to the  location behind 'h' */
+
+			/* load the channel number */
+			cnt =3D 0;
+			while (szLine[i] >=3D '0' && szLine[i] <=3D '9') {
+				channel[cnt] =3D szLine[i];
+				++cnt;
+				++i;
+			}
+			/* RTW_INFO("chnl %s!\n", channel); */
+
+			for (forCnt =3D 0; forCnt < colNum; ++forCnt) {
+				/* skip the space between channel number and the power limit value */
+				while (szLine[i] =3D=3D ' ' || szLine[i] =3D=3D '\t')
+					++i;
+
+				/* load the power limit value */
+				cnt =3D 0;
+				fraction =3D 0;
+				memset((void *) powerLimit, 0, 10);
+				while ((szLine[i] >=3D '0' && szLine[i] <=3D '9') || szLine[i] =3D=3D =
'.') {
+					if (szLine[i] =3D=3D '.') {
+						if ((szLine[i + 1] >=3D '0' && szLine[i + 1] <=3D '9')) {
+							fraction =3D szLine[i + 1];
+							i +=3D 2;
+						} else {
+							RTW_INFO("Wrong fraction in TXPWR_LMT.txt\n");
+							return _FAIL;
+						}
+
+						break;
+					}
+
+					powerLimit[cnt] =3D szLine[i];
+					++cnt;
+					++i;
+				}
+
+				if (powerLimit[0] =3D=3D '\0') {
+					powerLimit[0] =3D '6';
+					powerLimit[1] =3D '3';
+					i +=3D 2;
+				} else {
+					if (!GetU1ByteIntegerFromStringInDecimal(powerLimit, &limitValue))
+						return _FAIL;
+
+					limitValue *=3D 2;
+					cnt =3D 0;
+					if (fraction =3D=3D '5')
+						++limitValue;
+
+					/* the value is greater or equal to 100 */
+					if (limitValue >=3D 100) {
+						powerLimit[cnt++] =3D limitValue / 100 + '0';
+						limitValue %=3D 100;
+
+						if (limitValue >=3D 10) {
+							powerLimit[cnt++] =3D limitValue / 10 + '0';
+							limitValue %=3D 10;
+						} else
+							powerLimit[cnt++] =3D '0';
+
+						powerLimit[cnt++] =3D limitValue + '0';
+					}
+					/* the value is greater or equal to 10 */
+					else if (limitValue >=3D 10) {
+						powerLimit[cnt++] =3D limitValue / 10 + '0';
+						limitValue %=3D 10;
+						powerLimit[cnt++] =3D limitValue + '0';
+					}
+					/* the value is less than 10 */
+					else
+						powerLimit[cnt++] =3D limitValue + '0';
+
+					powerLimit[cnt] =3D '\0';
+				}
+
+				/* RTW_INFO("ch%s =3D> %s\n", channel, powerLimit); */
+
+				/* store the power limit value */
+				phy_set_tx_power_limit(pDM_Odm, (u8 *)regulation[forCnt], (u8 *)band,
+					(u8 *)bandwidth, (u8 *)rateSection, (u8 *)rfPath, (u8 *)channel, (u8 =
*)powerLimit);
+
+			}
+		} else {
+			RTW_INFO("Abnormal loading stage in phy_ParsePowerLimitTableFile()!\n");
+			rtStatus =3D _FAIL;
+			break;
+		}
+	}
+
+	RTW_INFO("<=3D=3D=3Dphy_ParsePowerLimitTableFile()\n");
+	return rtStatus;
+}
