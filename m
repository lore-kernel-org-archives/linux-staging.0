+static s32 rtw_mp_cmd_hdl(_adapter *padapter, u8 mp_cmd_id)
+{
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(padapter);
+	int ret =3D H2C_SUCCESS;
+	u8 rfreg0;
+
+	if (mp_cmd_id =3D=3D MP_START) {
+		if (padapter->registrypriv.mp_mode =3D=3D 0) {
+			rtw_hal_deinit(padapter);
+			padapter->registrypriv.mp_mode =3D 1;
+#ifdef CONFIG_RF_POWER_TRIM
+			if (!IS_HARDWARE_TYPE_8814A(padapter) && !IS_HARDWARE_TYPE_8822B(padapt=
er)) {
+				padapter->registrypriv.RegPwrTrimEnable =3D 1;
+				rtw_hal_read_chip_info(padapter);
+			}
+#endif /*CONFIG_RF_POWER_TRIM*/
+			rtw_hal_init(padapter);
+#ifdef RTW_HALMAC /*for New IC*/
+			MPT_InitializeAdapter(padapter, 1);
+#endif /* CONFIG_MP_INCLUDED */
+		}
+
+		if (padapter->registrypriv.mp_mode =3D=3D 0) {
+			ret =3D H2C_REJECTED;
+			goto exit;
+		}
+
+		if (padapter->mppriv.mode =3D=3D MP_OFF) {
+			if (mp_start_test(padapter) =3D=3D _FAIL) {
+				ret =3D H2C_REJECTED;
+				goto exit;
+			}
+			padapter->mppriv.mode =3D MP_ON;
+			MPT_PwrCtlDM(padapter, 0);
+		}
+		padapter->mppriv.bmac_filter =3D false;
+		odm_write_dig(&pHalData->odmpriv, 0x20);
+	} else if (mp_cmd_id =3D=3D MP_STOP) {
+		if (padapter->registrypriv.mp_mode =3D=3D 1) {
+			MPT_DeInitAdapter(padapter);
+			rtw_hal_deinit(padapter);
+			padapter->registrypriv.mp_mode =3D 0;
+			rtw_hal_init(padapter);
+		}
+
+		if (padapter->mppriv.mode !=3D MP_OFF) {
+			mp_stop_test(padapter);
+			padapter->mppriv.mode =3D MP_OFF;
+		}
+	} else {
+		RTW_INFO(FUNC_ADPT_FMT"invalid id:%d\n", FUNC_ADPT_ARG(padapter), mp_cmd=
_id);
+		ret =3D H2C_PARAMETERS_ERROR;
+		rtw_warn_on(1);
+	}
+
+exit:
+	return ret;
+}
