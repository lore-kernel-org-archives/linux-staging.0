E + ETH_TYPE_LEN + PAYLOAD_TYPE_LEN;
+	parsing_length =3D ((union recv_frame *)precv_frame)->u.hdr.len
+			 - prx_pkt_attrib->hdrlen
+			 - prx_pkt_attrib->iv_len
+			 - prx_pkt_attrib->icv_len
+			 - LLC_HEADER_SIZE
+			 - ETH_TYPE_LEN
+			 - PAYLOAD_TYPE_LEN
+			 - FIXED_IE;
+
+	pchsw_info->off_ch_num =3D *(ptr + 2);
+
+	if ((*(ptr + 2) =3D=3D 2) && (hal_is_band_support(padapter, BAND_ON_5G)))
+		pchsw_info->off_ch_num =3D 44;
+
+	if (pchsw_info->off_ch_num !=3D pmlmeext->cur_channel)
+		pchsw_info->delay_switch_back =3D false;
+
+	/* Parsing information element */
+	for (j =3D FIXED_IE; j < parsing_length;) {
+		pIE =3D (PNDIS_802_11_VARIABLE_IEs)(ptr + j);
+
+		switch (pIE->ElementID) {
+		case EID_SecondaryChnlOffset:
+			switch (*(pIE->data)) {
+			case EXTCHNL_OFFSET_UPPER:
+				pchsw_info->ch_offset =3D HAL_PRIME_CHNL_OFFSET_LOWER;
