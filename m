+/*
+ * Calculate wlan 802.11 packet MAX size from pkt_attrib
+ * This function doesn't consider fragment case
+ */
+u32 rtw_calculate_wlan_pkt_size_by_attribue(struct pkt_attrib *pattrib)
+{
+	u32	len =3D 0;
+
+	len =3D pattrib->hdrlen + pattrib->iv_len; /* WLAN Header and IV */
+	len +=3D SNAP_SIZE + sizeof(u16); /* LLC */
+	len +=3D pattrib->pktlen;
+	if (pattrib->encrypt =3D=3D _TKIP_)
+		len +=3D 8; /* MIC */
+	len +=3D ((pattrib->bswenc) ? pattrib->icv_len : 0); /* ICV */
+
+	return len;
+}
