+	len[1] =3D MD5_MAC_LEN;
+	addr[2] =3D wpabuf_head_u8(msg->buf) + sizeof(struct radius_hdr);
+	len[2] =3D wpabuf_len(msg->buf) - sizeof(struct radius_hdr);
