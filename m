+int wps_process_oob(struct wps_context *wps, struct oob_device_data *oob_d=
ev,
+		    int registrar)
+{
+	struct wpabuf *data;
+	int ret, write_f, oob_method =3D wps->oob_conf.oob_method;
+	void *oob_priv;
+
+	write_f =3D oob_method =3D=3D OOB_METHOD_DEV_PWD_E ? !registrar : registr=
ar;
+
+	oob_priv =3D oob_dev->init_func(wps, oob_dev, registrar);
+	if (oob_priv =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "WPS: Failed to initialize OOB device");
+		return -1;
+	}
+
+	if (write_f) {
+		if (oob_method =3D=3D OOB_METHOD_CRED)
+			data =3D wps_get_oob_cred(wps);
+		else
+			data =3D wps_get_oob_dev_pwd(wps);
+
+		ret =3D 0;
+		if (data =3D=3D NULL || oob_dev->write_func(oob_priv, data) < 0)
+			ret =3D -1;
+	} else {
+		data =3D oob_dev->read_func(oob_priv);
+		if (data =3D=3D NULL)
+			ret =3D -1;
+		else {
+			if (oob_method =3D=3D OOB_METHOD_CRED)
+				ret =3D wps_parse_oob_cred(wps, data);
+			else
+				ret =3D wps_parse_oob_dev_pwd(wps, data);
+		}
+	}
+	wpabuf_free(data);
+	oob_dev->deinit_func(oob_priv);
+
+	if (ret < 0) {
+		wpa_printf(MSG_ERROR, "WPS: Failed to process OOB data");
+		return -1;
+	}
+
+	return 0;
