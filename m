+int rtw_recv_monitor(_adapter *padapter, union recv_frame *precv_frame)
+{
+	int ret =3D _FAIL;
+	struct recv_priv *precvpriv;
+	_queue	*pfree_recv_queue;
+	_pkt *skb;
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+	struct rx_pkt_attrib *pattrib;
+
+	if (!precv_frame)
+		goto _recv_drop;
+
+	pattrib =3D &precv_frame->u.hdr.attrib;
+	precvpriv =3D &(padapter->recvpriv);
+	pfree_recv_queue =3D &(precvpriv->free_recv_queue);
+
+	skb =3D precv_frame->u.hdr.pkt;
+	if (!skb) {
+		RTW_INFO("%s :skb=3D=3DNULL something wrong!!!!\n", __func__);
+		goto _recv_drop;
+	}
+
+	skb->data =3D precv_frame->u.hdr.rx_data;
+	skb_set_tail_pointer(skb, precv_frame->u.hdr.len);
+	skb->len =3D precv_frame->u.hdr.len;
+	skb->ip_summed =3D CHECKSUM_NONE;
+	skb->pkt_type =3D PACKET_OTHERHOST;
+	skb->protocol =3D htons(0x0019); /* ETH_P_80211_RAW */
+
+	rtw_netif_rx(padapter->pnetdev, skb);
+
+	/* pointers to NULL before rtw_free_recvframe() */
+	precv_frame->u.hdr.pkt =3D NULL;
+
+	ret =3D _SUCCESS;
+
+_recv_drop:
+
+	/* enqueue back to free_recv_queue */
+	if (precv_frame)
+		rtw_free_recvframe(precv_frame, pfree_recv_queue);
+
+	return ret;
+}
