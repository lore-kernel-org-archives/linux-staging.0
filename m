+	if (*pos =3D=3D '"')
+		pos++;
+
+	pos2 =3D pos;
+	while (*pos2 !=3D '\0' && *pos2 !=3D '"' && *pos2 !=3D '>')
+		pos2++;
+
+	if (*pos2 =3D=3D '\0')
+		return TNCCS_RECOMMENDATION_ERROR;
+
+	saved =3D *pos2;
+	*pos2 =3D '\0';
+	wpa_printf(MSG_DEBUG, "TNC: TNCCS-Recommendation: '%s'", pos);
+
+	recom =3D TNCCS_RECOMMENDATION_ERROR;
+	if (os_strcmp(pos, "allow") =3D=3D 0)
+		recom =3D TNCCS_RECOMMENDATION_ALLOW;
+	else if (os_strcmp(pos, "none") =3D=3D 0)
