+static void hostapd_ctrl_iface_receive(int sock, void *eloop_ctx,
+				       void *sock_ctx)
+{
+	struct hostapd_data *hapd =3D eloop_ctx;
+	char buf[256];
+	int res;
+	struct sockaddr_un from;
+	socklen_t fromlen =3D sizeof(from);
+	char *reply;
+	const int reply_size =3D 4096;
+	int reply_len;
+	int level =3D MSG_DEBUG;
+
+	res =3D recvfrom(sock, buf, sizeof(buf) - 1, 0,
+		       (struct sockaddr *) &from, &fromlen);
+	if (res < 0) {
+		perror("recvfrom(ctrl_iface)");
+		return;
+	}
+	buf[res] =3D '\0';
+	if (os_strcmp(buf, "PING") =3D=3D 0)
+		level =3D MSG_EXCESSIVE;
+	wpa_hexdump_ascii(level, "RX ctrl_iface", (u8 *) buf, res);
+
+	reply =3D os_malloc(reply_size);
+	if (reply =3D=3D NULL) {
+		sendto(sock, "FAIL\n", 5, 0, (struct sockaddr *) &from,
+		       fromlen);
+		return;
+	}
+
+	os_memcpy(reply, "OK\n", 3);
+	reply_len =3D 3;
+
+	if (os_strcmp(buf, "PING") =3D=3D 0) {
+		os_memcpy(reply, "PONG\n", 5);
+		reply_len =3D 5;
+	} else if (os_strncmp(buf, "RELOG", 5) =3D=3D 0) {
+		if (wpa_debug_reopen_file() < 0)
+			reply_len =3D -1;
+	} else if (os_strcmp(buf, "MIB") =3D=3D 0) {
+		reply_len =3D ieee802_11_get_mib(hapd, reply, reply_size);
+		if (reply_len >=3D 0) {
+			res =3D wpa_get_mib(hapd->wpa_auth, reply + reply_len,
+					  reply_size - reply_len);
+			if (res < 0)
+				reply_len =3D -1;
+			else
+				reply_len +=3D res;
+		}
+		if (reply_len >=3D 0) {
+			res =3D ieee802_1x_get_mib(hapd, reply + reply_len,
+						 reply_size - reply_len);
+			if (res < 0)
+				reply_len =3D -1;
+			else
+				reply_len +=3D res;
+		}
+#ifndef CONFIG_NO_RADIUS
+		if (reply_len >=3D 0) {
+			res =3D radius_client_get_mib(hapd->radius,
+						    reply + reply_len,
+						    reply_size - reply_len);
+			if (res < 0)
+				reply_len =3D -1;
+			else
+				reply_len +=3D res;
+		}
+#endif /* CONFIG_NO_RADIUS */
+	} else if (os_strcmp(buf, "STA-FIRST") =3D=3D 0) {
+		reply_len =3D hostapd_ctrl_iface_sta_first(hapd, reply,
+							 reply_size);
+	} else if (os_strncmp(buf, "STA ", 4) =3D=3D 0) {
+		reply_len =3D hostapd_ctrl_iface_sta(hapd, buf + 4, reply,
+						   reply_size);
+	} else if (os_strncmp(buf, "STA-NEXT ", 9) =3D=3D 0) {
+		reply_len =3D hostapd_ctrl_iface_sta_next(hapd, buf + 9, reply,
+							reply_size);
+	} else if (os_strcmp(buf, "ATTACH") =3D=3D 0) {
+		if (hostapd_ctrl_iface_attach(hapd, &from, fromlen))
+			reply_len =3D -1;
+	} else if (os_strcmp(buf, "DETACH") =3D=3D 0) {
+		if (hostapd_ctrl_iface_detach(hapd, &from, fromlen))
+			reply_len =3D -1;
+	} else if (os_strncmp(buf, "LEVEL ", 6) =3D=3D 0) {
+		if (hostapd_ctrl_iface_level(hapd, &from, fromlen,
+						    buf + 6))
+			reply_len =3D -1;
+	} else if (os_strncmp(buf, "NEW_STA ", 8) =3D=3D 0) {
+		if (hostapd_ctrl_iface_new_sta(hapd, buf + 8))
+			reply_len =3D -1;
+	} else if (os_strncmp(buf, "DEAUTHENTICATE ", 15) =3D=3D 0) {
+		if (hostapd_ctrl_iface_deauthenticate(hapd, buf + 15))
+			reply_len =3D -1;
+	} else if (os_strncmp(buf, "DISASSOCIATE ", 13) =3D=3D 0) {
+		if (hostapd_ctrl_iface_disassociate(hapd, buf + 13))
+			reply_len =3D -1;
+#ifdef CONFIG_IEEE80211W
+#ifdef NEED_AP_MLME
+	} else if (os_strncmp(buf, "SA_QUERY ", 9) =3D=3D 0) {
+		if (hostapd_ctrl_iface_sa_query(hapd, buf + 9))
+			reply_len =3D -1;
+#endif /* NEED_AP_MLME */
+#endif /* CONFIG_IEEE80211W */
+#ifdef CONFIG_WPS
+	} else if (os_strncmp(buf, "WPS_PIN ", 8) =3D=3D 0) {
+		if (hostapd_ctrl_iface_wps_pin(hapd, buf + 8))
+			reply_len =3D -1;
+	} else if (os_strncmp(buf, "WPS_CHECK_PIN ", 14) =3D=3D 0) {
+		reply_len =3D hostapd_ctrl_iface_wps_check_pin(
+			hapd, buf + 14, reply, reply_size);
+	} else if (os_strcmp(buf, "WPS_PBC") =3D=3D 0) {
+		if (hostapd_wps_button_pushed(hapd, NULL))
+			reply_len =3D -1;
+#ifdef CONFIG_WPS_OOB
+	} else if (os_strncmp(buf, "WPS_OOB ", 8) =3D=3D 0) {
+		if (hostapd_ctrl_iface_wps_oob(hapd, buf + 8))
+			reply_len =3D -1;
+#endif /* CONFIG_WPS_OOB */
+	} else if (os_strncmp(buf, "WPS_AP_PIN ", 11) =3D=3D 0) {
+		reply_len =3D hostapd_ctrl_iface_wps_ap_pin(hapd, buf + 11,
+							  reply, reply_size);
+	} else if (os_strncmp(buf, "WPS_CONFIG ", 11) =3D=3D 0) {
+		if (hostapd_ctrl_iface_wps_config(hapd, buf + 11) < 0)
+			reply_len =3D -1;
+#endif /* CONFIG_WPS */
+	} else if (os_strcmp(buf, "GET_CONFIG") =3D=3D 0) {
+		reply_len =3D hostapd_ctrl_iface_get_config(hapd, reply,
+							  reply_size);
+	} else if (os_strncmp(buf, "SET ", 4) =3D=3D 0) {
+		if (hostapd_ctrl_iface_set(hapd, buf + 4))
+			reply_len =3D -1;
+	} else if (os_strncmp(buf, "GET ", 4) =3D=3D 0) {
+		reply_len =3D hostapd_ctrl_iface_get(hapd, buf + 4, reply,
+						   reply_size);
+	} else {
+		os_memcpy(reply, "UNKNOWN COMMAND\n", 16);
+		reply_len =3D 16;
+	}
+
+	if (reply_len < 0) {
+		os_memcpy(reply, "FAIL\n", 5);
+		reply_len =3D 5;
+	}
+	sendto(sock, reply, reply_len, 0, (struct sockaddr *) &from, fromlen);
+	os_free(reply);
+}
