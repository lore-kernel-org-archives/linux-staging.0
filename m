+static void openssl_tls_cert_event(struct tls_connection *conn,
+				   X509 *err_cert, int depth,
+				   const char *subject)
+{
+	struct wpabuf *cert =3D NULL;
+	union tls_event_data ev;
+#ifdef CONFIG_SHA256
+	u8 hash[32];
+#endif /* CONFIG_SHA256 */
+
+	if (tls_global->event_cb =3D=3D NULL)
+		return;
+
+	os_memset(&ev, 0, sizeof(ev));
+	if (conn->cert_probe) {
+		cert =3D get_x509_cert(err_cert);
+		ev.peer_cert.cert =3D cert;
+	}
+#ifdef CONFIG_SHA256
+	if (cert) {
+		const u8 *addr[1];
+		size_t len[1];
+		addr[0] =3D wpabuf_head(cert);
+		len[0] =3D wpabuf_len(cert);
+		if (sha256_vector(1, addr, len, hash) =3D=3D 0) {
+			ev.peer_cert.hash =3D hash;
+			ev.peer_cert.hash_len =3D sizeof(hash);
+		}
+	}
+#endif /* CONFIG_SHA256 */
+	ev.peer_cert.depth =3D depth;
+	ev.peer_cert.subject =3D subject;
+	tls_global->event_cb(tls_global->cb_ctx, TLS_PEER_CERTIFICATE, &ev);
+	wpabuf_free(cert);
+}
