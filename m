+void
+odm_set_ant_config(
+	void	*p_dm_void,
+	u8		ant_setting	/* 0=3DA, 1=3DB, 2=3DC, .... */
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8723B) {
+		if (ant_setting =3D=3D 0)		/* ant A*/
+			odm_set_bb_reg(p_dm_odm, 0x948, MASKDWORD, 0x00000000);
+		else if (ant_setting =3D=3D 1)
