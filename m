+static u8
+phydm_csi_mask_setting(
+	void		*p_dm_void,
+	u32		enable,
+	u32		channel,
+	u32		bw,
+	u32		f_interference,
+	u32		second_ch
+)
+{
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u32		fc;
+	u32		int_distance;
+	u8		tone_direction;
+	u32		tone_idx_tmp;
+	u8		set_result =3D SET_SUCCESS;
+
+	if (enable =3D=3D CSI_MASK_DISABLE) {
+		set_result =3D SET_SUCCESS;
+		phydm_clean_all_csi_mask(p_dm_odm);
+
+	} else {
+
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("[Set CSI MASK_] CH =
=3D ((%d)), BW =3D ((%d)), f_intf =3D ((%d)), Scnd_CH =3D ((%s))\n",
+			channel, bw, f_interference, (((bw =3D=3D 20) || (channel > 14)) ? "Don=
't care" : (second_ch =3D=3D PHYDM_ABOVE) ? "H" : "L")));
+
+		/*calculate fc*/
+		if (phydm_calculate_fc(p_dm_odm, channel, bw, second_ch, &fc) =3D=3D SET=
_ERROR)
+			set_result =3D SET_ERROR;
+
+		else {
+			/*calculate interference distance*/
+			if (phydm_calculate_intf_distance(p_dm_odm, bw, fc, f_interference, &to=
ne_idx_tmp) =3D=3D SET_SUCCESS) {
+
+				tone_direction =3D (f_interference >=3D fc) ? FREQ_POSITIVE : FREQ_NEG=
ATIVE;
+				phydm_set_csi_mask_reg(p_dm_odm, tone_idx_tmp, tone_direction);
+				set_result =3D SET_SUCCESS;
+			} else
+				set_result =3D SET_NO_NEED;
+		}
+	}
+
+	if (set_result =3D=3D SET_SUCCESS)
+		phydm_csi_mask_enable(p_dm_odm, enable);
+	else
+		phydm_csi_mask_enable(p_dm_odm, CSI_MASK_DISABLE);
+
+	return	set_result;
+}
