+static int x509_parse_name(const u8 *buf, size_t len, struct x509_name *na=
me,
+			   const u8 **next)
+{
+	struct asn1_hdr hdr;
+	const u8 *pos, *end, *set_pos, *set_end, *seq_pos, *seq_end;
+	struct asn1_oid oid;
+	char *val;
+
+	/*
+	 * Name ::=3D CHOICE { RDNSequence }
+	 * RDNSequence ::=3D SEQUENCE OF RelativeDistinguishedName
+	 * RelativeDistinguishedName ::=3D SET OF AttributeTypeAndValue
+	 * AttributeTypeAndValue ::=3D SEQUENCE {
+	 *     type     AttributeType,
+	 *     value    AttributeValue
+	 * }
+	 * AttributeType ::=3D OBJECT IDENTIFIER
+	 * AttributeValue ::=3D ANY DEFINED BY AttributeType
+	 */
+
+	if (asn1_get_next(buf, len, &hdr) < 0 ||
+	    hdr.class !=3D ASN1_CLASS_UNIVERSAL ||
+	    hdr.tag !=3D ASN1_TAG_SEQUENCE) {
+		wpa_printf(MSG_DEBUG, "X509: Expected SEQUENCE "
+			   "(Name / RDNSequencer) - found class %d tag 0x%x",
+			   hdr.class, hdr.tag);
+		return -1;
+	}
+	pos =3D hdr.payload;
+
+	if (pos + hdr.length > buf + len)
+		return -1;
+
+	end =3D *next =3D pos + hdr.length;
+
+	while (pos < end) {
+		enum x509_name_attr_type type;
+
+		if (asn1_get_next(pos, end - pos, &hdr) < 0 ||
+		    hdr.class !=3D ASN1_CLASS_UNIVERSAL ||
+		    hdr.tag !=3D ASN1_TAG_SET) {
+			wpa_printf(MSG_DEBUG, "X509: Expected SET "
+				   "(RelativeDistinguishedName) - found class "
+				   "%d tag 0x%x", hdr.class, hdr.tag);
+			x509_free_name(name);
+			return -1;
+		}
+
+		set_pos =3D hdr.payload;
+		pos =3D set_end =3D hdr.payload + hdr.length;
+
+		if (asn1_get_next(set_pos, set_end - set_pos, &hdr) < 0 ||
+		    hdr.class !=3D ASN1_CLASS_UNIVERSAL ||
+		    hdr.tag !=3D ASN1_TAG_SEQUENCE) {
+			wpa_printf(MSG_DEBUG, "X509: Expected SEQUENCE "
+				   "(AttributeTypeAndValue) - found class %d "
+				   "tag 0x%x", hdr.class, hdr.tag);
+			x509_free_name(name);
+			return -1;
+		}
+
+		seq_pos =3D hdr.payload;
+		seq_end =3D hdr.payload + hdr.length;
+
+		if (asn1_get_oid(seq_pos, seq_end - seq_pos, &oid, &seq_pos)) {
+			x509_free_name(name);
+			return -1;
+		}
+
+		if (asn1_get_next(seq_pos, seq_end - seq_pos, &hdr) < 0 ||
+		    hdr.class !=3D ASN1_CLASS_UNIVERSAL) {
+			wpa_printf(MSG_DEBUG, "X509: Failed to parse "
+				   "AttributeValue");
+			x509_free_name(name);
+			return -1;
+		}
+
+		/* RFC 3280:
+		 * MUST: country, organization, organizational-unit,
+		 * distinguished name qualifier, state or province name,
+		 * common name, serial number.
+		 * SHOULD: locality, title, surname, given name, initials,
+		 * pseudonym, generation qualifier.
+		 * MUST: domainComponent (RFC 2247).
+		 */
+		type =3D X509_NAME_ATTR_NOT_USED;
+		if (oid.len =3D=3D 4 &&
+		    oid.oid[0] =3D=3D 2 && oid.oid[1] =3D=3D 5 && oid.oid[2] =3D=3D 4) {
+			/* id-at ::=3D 2.5.4 */
+			switch (oid.oid[3]) {
+			case 3:
+				/* commonName */
+				type =3D X509_NAME_ATTR_CN;
+				break;
+			case 6:
+				/*  countryName */
+				type =3D X509_NAME_ATTR_C;
+				break;
+			case 7:
+				/* localityName */
+				type =3D X509_NAME_ATTR_L;
+				break;
+			case 8:
+				/* stateOrProvinceName */
+				type =3D X509_NAME_ATTR_ST;
+				break;
+			case 10:
+				/* organizationName */
+				type =3D X509_NAME_ATTR_O;
+				break;
+			case 11:
+				/* organizationalUnitName */
+				type =3D X509_NAME_ATTR_OU;
+				break;
+			}
+		} else if (oid.len =3D=3D 7 &&
+			   oid.oid[0] =3D=3D 1 && oid.oid[1] =3D=3D 2 &&
+			   oid.oid[2] =3D=3D 840 && oid.oid[3] =3D=3D 113549 &&
+			   oid.oid[4] =3D=3D 1 && oid.oid[5] =3D=3D 9 &&
+			   oid.oid[6] =3D=3D 1) {
+			/* 1.2.840.113549.1.9.1 - e-mailAddress */
+			os_free(name->email);
+			name->email =3D os_malloc(hdr.length + 1);
+			if (name->email =3D=3D NULL) {
+				x509_free_name(name);
+				return -1;
+			}
+			os_memcpy(name->email, hdr.payload, hdr.length);
+			name->email[hdr.length] =3D '\0';
+			continue;
+		} else if (oid.len =3D=3D 7 &&
+			   oid.oid[0] =3D=3D 0 && oid.oid[1] =3D=3D 9 &&
+			   oid.oid[2] =3D=3D 2342 && oid.oid[3] =3D=3D 19200300 &&
+			   oid.oid[4] =3D=3D 100 && oid.oid[5] =3D=3D 1 &&
+			   oid.oid[6] =3D=3D 25) {
+			/* 0.9.2342.19200300.100.1.25 - domainComponent */
+			type =3D X509_NAME_ATTR_DC;
+		}
+
+		if (type =3D=3D X509_NAME_ATTR_NOT_USED) {
+			wpa_hexdump(MSG_DEBUG, "X509: Unrecognized OID",
+				    (u8 *) oid.oid,
+				    oid.len * sizeof(oid.oid[0]));
+			wpa_hexdump_ascii(MSG_MSGDUMP, "X509: Attribute Data",
+					  hdr.payload, hdr.length);
+			continue;
+		}
+
+		if (name->num_attr =3D=3D X509_MAX_NAME_ATTRIBUTES) {
+			wpa_printf(MSG_INFO, "X509: Too many Name attributes");
+			x509_free_name(name);
+			return -1;
+		}
+
+		val =3D os_malloc(hdr.length + 1);
+		if (val =3D=3D NULL) {
+			x509_free_name(name);
+			return -1;
+		}
+		os_memcpy(val, hdr.payload, hdr.length);
+		val[hdr.length] =3D '\0';
+		if (os_strlen(val) !=3D hdr.length) {
+			wpa_printf(MSG_INFO, "X509: Reject certificate with "
+				   "embedded NUL byte in a string (%s[NUL])",
+				   val);
+			x509_free_name(name);
+			return -1;
+		}
+
+		name->attr[name->num_attr].type =3D type;
+		name->attr[name->num_attr].value =3D val;
+		name->num_attr++;
+	}
+
+	return 0;
+}
+
