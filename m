+void
+odm_parsing_cfo(
+	void			*p_dm_void,
+	void			*p_pktinfo_void,
+	s8			*pcfotail,
+	u8			num_ss
+)
+{
+	struct PHY_DM_STRUCT				*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _odm_per_pkt_info_		*p_pktinfo =3D (struct _odm_per_pkt_info_ *)p_=
pktinfo_void;
+	struct _CFO_TRACKING_			*p_cfo_track =3D (struct _CFO_TRACKING_ *)phydm_g=
et_structure(p_dm_odm, PHYDM_CFOTRACK);
+	u8					i;
+
+	if (!(p_dm_odm->support_ability & ODM_BB_CFO_TRACKING))
+		return;
+
+	if (p_pktinfo->is_packet_match_bssid) {
+		if (num_ss > p_dm_odm->num_rf_path) /*For fool proof*/
+			num_ss =3D p_dm_odm->num_rf_path;
+
+		/* 3 Update CFO report for path-A & path-B */
+		/* Only paht-A and path-B have CFO tail and short CFO */
+		for (i =3D 0; i < num_ss; i++) {
+			p_cfo_track->CFO_tail[i] +=3D pcfotail[i];
+			p_cfo_track->CFO_cnt[i]++;
+			/*ODM_RT_TRACE(p_dm_odm, ODM_COMP_CFO_TRACKING, ODM_DBG_LOUD, ("[ID %d]=
[path %d][rate 0x%x] CFO_tail =3D ((%d)), CFO_tail_sum =3D ((%d)), CFO_cnt =
=3D ((%d))\n",
+				p_pktinfo->station_id, i, p_pktinfo->data_rate, pcfotail[i], p_cfo_tra=
ck->CFO_tail[i], p_cfo_track->CFO_cnt[i]));
+			*/
+		}
+
+		/* 3 Update packet counter */
+		if (p_cfo_track->packet_count =3D=3D 0xffffffff)
+			p_cfo_track->packet_count =3D 0;
+		else
+			p_cfo_track->packet_count++;
+	}
+}
