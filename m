+void hostapd_wps_ap_pin_disable(struct hostapd_data *hapd)
+{
+	wpa_printf(MSG_DEBUG, "WPS: Disabling AP PIN");
+	hostapd_wps_for_each(hapd, wps_ap_pin_disable, NULL);
+}
+
+
+struct wps_ap_pin_data {
+	char pin_txt[9];
+	int timeout;
+};
+
+
+static int wps_ap_pin_set(struct hostapd_data *hapd, void *ctx)
+{
+	struct wps_ap_pin_data *data =3D ctx;
+	os_free(hapd->conf->ap_pin);
+	hapd->conf->ap_pin =3D os_strdup(data->pin_txt);
+#ifdef CONFIG_WPS_UPNP
+	upnp_wps_set_ap_pin(hapd->wps_upnp, data->pin_txt);
+#endif /* CONFIG_WPS_UPNP */
+	hostapd_wps_ap_pin_enable(hapd, data->timeout);
+	return 0;
+}
+
+
+const char * hostapd_wps_ap_pin_random(struct hostapd_data *hapd, int time=
out)
+{
+	unsigned int pin;
+	struct wps_ap_pin_data data;
+
+	pin =3D wps_generate_pin();
+	os_snprintf(data.pin_txt, sizeof(data.pin_txt), "%u", pin);
+	data.timeout =3D timeout;
+	hostapd_wps_for_each(hapd, wps_ap_pin_set, &data);
+	return hapd->conf->ap_pin;
+}
+
+
+const char * hostapd_wps_ap_pin_get(struct hostapd_data *hapd)
+{
+	return hapd->conf->ap_pin;
+}
+
+
+int hostapd_wps_ap_pin_set(struct hostapd_data *hapd, const char *pin,
+			   int timeout)
+{
+	struct wps_ap_pin_data data;
+	int ret;
+
+	ret =3D os_snprintf(data.pin_txt, sizeof(data.pin_txt), "%s", pin);
+	if (ret < 0 || ret >=3D (int) sizeof(data.pin_txt))
+		return -1;
+	data.timeout =3D timeout;
+	return hostapd_wps_for_each(hapd, wps_ap_pin_set, &data);
+}
+
+
+static int wps_update_ie(struct hostapd_data *hapd, void *ctx)
+{
+	if (hapd->wps)
+		wps_registrar_update_ie(hapd->wps->registrar);
+	return 0;
+}
+
+
+void hostapd_wps_update_ie(struct hostapd_data *hapd)
+{
+	hostapd_wps_for_each(hapd, wps_update_ie, NULL);
+}
+
+
+int hostapd_wps_config_ap(struct hostapd_data *hapd, const char *ssid,
+			  const char *auth, const char *encr, const char *key)
+{
+	struct wps_credential cred;
+	size_t len;
+
+	os_memset(&cred, 0, sizeof(cred));
+
+	len =3D os_strlen(ssid);
+	if ((len & 1) || len > 2 * sizeof(cred.ssid) ||
+	    hexstr2bin(ssid, cred.ssid, len / 2))
+		return -1;
+	cred.ssid_len =3D len / 2;
+
+	if (os_strncmp(auth, "OPEN", 4) =3D=3D 0)
+		cred.auth_type =3D WPS_AUTH_OPEN;
+	else if (os_strncmp(auth, "WPAPSK", 6) =3D=3D 0)
+		cred.auth_type =3D WPS_AUTH_WPAPSK;
+	else if (os_strncmp(auth, "WPA2PSK", 7) =3D=3D 0)
+		cred.auth_type =3D WPS_AUTH_WPA2PSK;
+	else
+		return -1;
+
+	if (encr) {
+		if (os_strncmp(encr, "NONE", 4) =3D=3D 0)
+			cred.encr_type =3D WPS_ENCR_NONE;
+		else if (os_strncmp(encr, "WEP", 3) =3D=3D 0)
+			cred.encr_type =3D WPS_ENCR_WEP;
+		else if (os_strncmp(encr, "TKIP", 4) =3D=3D 0)
+			cred.encr_type =3D WPS_ENCR_TKIP;
+		else if (os_strncmp(encr, "CCMP", 4) =3D=3D 0)
+			cred.encr_type =3D WPS_ENCR_AES;
+		else
+			return -1;
+	} else
+		cred.encr_type =3D WPS_ENCR_NONE;
+
+	if (key) {
+		len =3D os_strlen(key);
+		if ((len & 1) || len > 2 * sizeof(cred.key) ||
+		    hexstr2bin(key, cred.key, len / 2))
+			return -1;
+		cred.key_len =3D len / 2;
+	}
+
+	return wps_registrar_config_ap(hapd->wps->registrar, &cred);
+}
