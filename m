+static void mlme_event_deauth_disassoc(struct wpa_driver_nl80211_data *drv,
+				       enum wpa_event_type type,
+				       const u8 *frame, size_t len)
+{
+	const struct ieee80211_mgmt *mgmt;
+	union wpa_event_data event;
+	const u8 *bssid =3D NULL;
+	u16 reason_code =3D 0;
+
+	mgmt =3D (const struct ieee80211_mgmt *) frame;
+	if (len >=3D 24) {
+		bssid =3D mgmt->bssid;
+
+		if (drv->associated !=3D 0 &&
+		    os_memcmp(bssid, drv->bssid, ETH_ALEN) !=3D 0 &&
+		    os_memcmp(bssid, drv->auth_bssid, ETH_ALEN) !=3D 0) {
+			/*
+			 * We have presumably received this deauth as a
+			 * response to a clear_state_mismatch() outgoing
+			 * deauth.  Don't let it take us offline!
+			 */
+			wpa_printf(MSG_DEBUG, "nl80211: Deauth received "
+				   "from Unknown BSSID " MACSTR " -- ignoring",
+				   MAC2STR(bssid));
+			return;
+		}
+	}
+
+	drv->associated =3D 0;
+	os_memset(&event, 0, sizeof(event));
+
+	/* Note: Same offset for Reason Code in both frame subtypes */
+	if (len >=3D 24 + sizeof(mgmt->u.deauth))
+		reason_code =3D le_to_host16(mgmt->u.deauth.reason_code);
+
+	if (type =3D=3D EVENT_DISASSOC) {
+		event.disassoc_info.addr =3D bssid;
+		event.disassoc_info.reason_code =3D reason_code;
+		if (frame + len > mgmt->u.disassoc.variable) {
+			event.disassoc_info.ie =3D mgmt->u.disassoc.variable;
+			event.disassoc_info.ie_len =3D frame + len -
+				mgmt->u.disassoc.variable;
+		}
+	} else {
+		event.deauth_info.addr =3D bssid;
+		event.deauth_info.reason_code =3D reason_code;
+		if (frame + len > mgmt->u.deauth.variable) {
+			event.deauth_info.ie =3D mgmt->u.deauth.variable;
+			event.deauth_info.ie_len =3D frame + len -
+				mgmt->u.deauth.variable;
+		}
+	}
+
+	wpa_supplicant_event(drv->ctx, type, &event);
+}
