+u32
+odm_get_rate_bitmap(
+	void		*p_dm_void,
+	u32		macid,
+	u32		ra_mask,
+	u8		rssi_level
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct sta_info	*p_entry;
+	u32	rate_bitmap =3D 0;
+	u8	wireless_mode;
+	/* u8 	wireless_mode =3D*(p_dm_odm->p_wireless_mode); */
+
+
+	p_entry =3D p_dm_odm->p_odm_sta_info[macid];
+	if (!IS_STA_VALID(p_entry))
+		return ra_mask;
+
+	wireless_mode =3D p_entry->wireless_mode;
+
+	switch (wireless_mode) {
+	case ODM_WM_B:
+		if (ra_mask & 0x0000000c)		/* 11M or 5.5M enable */
+			rate_bitmap =3D 0x0000000d;
+		else
+			rate_bitmap =3D 0x0000000f;
+		break;
+
+	case (ODM_WM_G):
+	case (ODM_WM_A):
+		if (rssi_level =3D=3D DM_RATR_STA_HIGH)
+			rate_bitmap =3D 0x00000f00;
+		else
+			rate_bitmap =3D 0x00000ff0;
+		break;
+
+	case (ODM_WM_B|ODM_WM_G):
+		if (rssi_level =3D=3D DM_RATR_STA_HIGH)
+			rate_bitmap =3D 0x00000f00;
+		else if (rssi_level =3D=3D DM_RATR_STA_MIDDLE)
+			rate_bitmap =3D 0x00000ff0;
+		else
+			rate_bitmap =3D 0x00000ff5;
+		break;
+
+	case (ODM_WM_B|ODM_WM_G|ODM_WM_N24G):
+	case (ODM_WM_B|ODM_WM_N24G):
+	case (ODM_WM_G|ODM_WM_N24G):
+	case (ODM_WM_A|ODM_WM_N5G):
+	{
+		if (p_dm_odm->rf_type =3D=3D ODM_1T2R || p_dm_odm->rf_type =3D=3D ODM_1T=
1R) {
+			if (rssi_level =3D=3D DM_RATR_STA_HIGH)
+				rate_bitmap =3D 0x000f0000;
+			else if (rssi_level =3D=3D DM_RATR_STA_MIDDLE)
+				rate_bitmap =3D 0x000ff000;
+			else {
+				if (*(p_dm_odm->p_band_width) =3D=3D ODM_BW40M)
+					rate_bitmap =3D 0x000ff015;
+				else
+					rate_bitmap =3D 0x000ff005;
+			}
+		} else {
+			if (rssi_level =3D=3D DM_RATR_STA_HIGH)
+				rate_bitmap =3D 0x0f8f0000;
+			else if (rssi_level =3D=3D DM_RATR_STA_MIDDLE)
+				rate_bitmap =3D 0x0f8ff000;
+			else {
+				if (*(p_dm_odm->p_band_width) =3D=3D ODM_BW40M)
+					rate_bitmap =3D 0x0f8ff015;
+				else
+					rate_bitmap =3D 0x0f8ff005;
+			}
+		}
+	}
+	break;
+
+	case (ODM_WM_AC|ODM_WM_G):
+		if (rssi_level =3D=3D 1)
+			rate_bitmap =3D 0xfc3f0000;
+		else if (rssi_level =3D=3D 2)
+			rate_bitmap =3D 0xfffff000;
+		else
+			rate_bitmap =3D 0xffffffff;
+		break;
+
+	case (ODM_WM_AC|ODM_WM_A):
+
+		if (p_dm_odm->rf_type =3D=3D RF_1T1R) {
+			if (rssi_level =3D=3D 1)				/* add by Gary for ac-series */
+				rate_bitmap =3D 0x003f8000;
+			else if (rssi_level =3D=3D 2)
+				rate_bitmap =3D 0x003ff000;
+			else
+				rate_bitmap =3D 0x003ff010;
+		} else {
+			if (rssi_level =3D=3D 1)				/* add by Gary for ac-series */
+				rate_bitmap =3D 0xfe3f8000;       /* VHT 2SS MCS3~9 */
+			else if (rssi_level =3D=3D 2)
+				rate_bitmap =3D 0xfffff000;       /* VHT 2SS MCS0~9 */
+			else
+				rate_bitmap =3D 0xfffff010;       /* All */
+		}
+		break;
+
+	default:
+		if (p_dm_odm->rf_type =3D=3D RF_1T2R)
+			rate_bitmap =3D 0x000fffff;
+		else
+			rate_bitmap =3D 0x0fffffff;
+		break;
+
+	}
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RATE_ADAPTIVE, ODM_DBG_LOUD, ("%s =3D=3D>=
 rssi_level:0x%02x, wireless_mode:0x%02x, rate_bitmap:0x%08x\n", __func__, =
rssi_level, wireless_mode, rate_bitmap));
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, (" =3D=3D> rssi_le=
vel:0x%02x, wireless_mode:0x%02x, rate_bitmap:0x%08x\n", rssi_level, wirele=
ss_mode, rate_bitmap));
+
+	return ra_mask & rate_bitmap;
+
+}
