+			bssid->Configuration.DSConfig =3D padapter->mlmeextpriv.cur_channel;
+			RTW_INFO("%s()-%d: Cannot get p2p_ie. set DSconfig to op_ch(%d)\n", __f=
unc__, __LINE__, bssid->Configuration.DSConfig);
