+	char *buf;
+	wl_scan_results_t *wsr;
+	wl_bss_info_t *wbi;
+	size_t ap_num;
+	struct wpa_scan_results *res;
+
+	buf =3D os_malloc(WLC_IOCTL_MAXLEN);
+	if (buf =3D=3D NULL)
+		return NULL;
+
+	wsr =3D (wl_scan_results_t *) buf;
+
+	wsr->buflen =3D WLC_IOCTL_MAXLEN - sizeof(wsr);
+	wsr->version =3D 107;
+	wsr->count =3D 0;
+
+	if (broadcom_ioctl(drv, WLC_SCAN_RESULTS, buf, WLC_IOCTL_MAXLEN) < 0) {
+		os_free(buf);
+		return NULL;
+	}
+
+	res =3D os_zalloc(sizeof(*res));
+	if (res =3D=3D NULL) {
+		os_free(buf);
+		return NULL;
+	}
+
+	res->res =3D os_zalloc(wsr->count * sizeof(struct wpa_scan_res *));
+	if (res->res =3D=3D NULL) {
+		os_free(res);
+		os_free(buf);
+		return NULL;
+	}
+
+	for (ap_num =3D 0, wbi =3D wsr->bss_info; ap_num < wsr->count; ++ap_num) {
+		struct wpa_scan_res *r;
+		r =3D os_malloc(sizeof(*r) + wbi->ie_length);
+		if (r =3D=3D NULL)
+			break;
+		res->res[res->num++] =3D r;
+
+		os_memcpy(r->bssid, &wbi->BSSID, ETH_ALEN);
+		r->freq =3D frequency_list[wbi->channel - 1];
+		/* get ie's */
+		os_memcpy(r + 1, wbi + 1, wbi->ie_length);
+		r->ie_len =3D wbi->ie_length;
+
+		wbi =3D (wl_bss_info_t *) ((u8 *) wbi + wbi->length);
+	}
+
+	wpa_printf(MSG_MSGDUMP, "Received %d bytes of scan results (%lu "
+		   "BSSes)",
+		   wsr->buflen, (unsigned long) ap_num);
+=09
+	os_free(buf);
+	return res;
+	}
