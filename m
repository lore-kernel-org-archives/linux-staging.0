+int rtw_ch2freq(int chan)
+{
+	/* see 802.11 17.3.8.3.2 and Annex J
+	* there are overlapping channel numbers in 5GHz and 2GHz bands */
+
+	/*
+	* RTK: don't consider the overlapping channel numbers: 5G channel <=3D 14,
+	* because we don't support it. simply judge from channel number
+	*/
+
+	if (chan >=3D 1 && chan <=3D 14) {
+		if (chan =3D=3D 14)
+			return 2484;
+		else if (chan < 14)
+			return 2407 + chan * 5;
+	} else if (chan >=3D 36 && chan <=3D 177)
+		return 5000 + chan * 5;
+
+	return 0; /* not supported */
+}
+
+int rtw_freq2ch(int freq)
+{
+	/* see 802.11 17.3.8.3.2 and Annex J */
+	if (freq =3D=3D 2484)
+		return 14;
+	else if (freq < 2484)
+		return (freq - 2407) / 5;
+	else if (freq >=3D 4910 && freq <=3D 4980)
+		return (freq - 4000) / 5;
+	else if (freq <=3D 45000) /* DMG band lower limit */
+		return (freq - 5000) / 5;
+	else if (freq >=3D 58320 && freq <=3D 64800)
+		return (freq - 56160) / 2160;
+	else
+		return 0;
+}
