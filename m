+union recv_frame *recvframe_chk_defrag(PADAPTER padapter, union recv_frame=
 *precv_frame);
+
+static sint validate_recv_mgnt_frame(PADAPTER padapter, union recv_frame *=
precv_frame)
+{
+	precv_frame =3D recvframe_chk_defrag(padapter, precv_frame);
+	if (precv_frame =3D=3D NULL) {
+		return _SUCCESS;
+	}
+
+	{
+		/* for rx pkt statistics */
+		struct sta_info *psta =3D rtw_get_stainfo(&padapter->stapriv, get_addr2_=
ptr(precv_frame->u.hdr.rx_data));
+		if (psta) {
