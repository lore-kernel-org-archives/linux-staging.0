+
+void __wpa_send_eapol(struct wpa_authenticator *wpa_auth,
+		      struct wpa_state_machine *sm, int key_info,
+		      const u8 *key_rsc, const u8 *nonce,
+		      const u8 *kde, size_t kde_len,
+		      int keyidx, int encr, int force_version)
+{
+	struct ieee802_1x_hdr *hdr;
+	struct wpa_eapol_key *key;
+	size_t len;
+	int alg;
+	int key_data_len, pad_len =3D 0;
+	u8 *buf, *pos;
+	int version, pairwise;
+	int i;
+
+	len =3D sizeof(struct ieee802_1x_hdr) + sizeof(struct wpa_eapol_key);
+
+	if (force_version)
+		version =3D force_version;
+	else if (wpa_use_aes_cmac(sm))
+		version =3D WPA_KEY_INFO_TYPE_AES_128_CMAC;
+	else if (sm->pairwise =3D=3D WPA_CIPHER_CCMP)
+		version =3D WPA_KEY_INFO_TYPE_HMAC_SHA1_AES;
+	else
+		version =3D WPA_KEY_INFO_TYPE_HMAC_MD5_RC4;
+
+	pairwise =3D key_info & WPA_KEY_INFO_KEY_TYPE;
+
+	wpa_printf(MSG_DEBUG, "WPA: Send EAPOL(version=3D%d secure=3D%d mic=3D%d "
+		   "ack=3D%d install=3D%d pairwise=3D%d kde_len=3D%lu keyidx=3D%d "
+		   "encr=3D%d)",
+		   version,
+		   (key_info & WPA_KEY_INFO_SECURE) ? 1 : 0,
+		   (key_info & WPA_KEY_INFO_MIC) ? 1 : 0,
+		   (key_info & WPA_KEY_INFO_ACK) ? 1 : 0,
+		   (key_info & WPA_KEY_INFO_INSTALL) ? 1 : 0,
+		   pairwise, (unsigned long) kde_len, keyidx, encr);
+
+	key_data_len =3D kde_len;
+
+	if ((version =3D=3D WPA_KEY_INFO_TYPE_HMAC_SHA1_AES ||
+	     version =3D=3D WPA_KEY_INFO_TYPE_AES_128_CMAC) && encr) {
+		pad_len =3D key_data_len % 8;
+		if (pad_len)
+			pad_len =3D 8 - pad_len;
+		key_data_len +=3D pad_len + 8;
+	}
+
+	len +=3D key_data_len;
+
+	hdr =3D os_zalloc(len);
+	if (hdr =3D=3D NULL)
+		return;
+	hdr->version =3D wpa_auth->conf.eapol_version;
+	hdr->type =3D IEEE802_1X_TYPE_EAPOL_KEY;
+	hdr->length =3D host_to_be16(len  - sizeof(*hdr));
+	key =3D (struct wpa_eapol_key *) (hdr + 1);
+
+	key->type =3D sm->wpa =3D=3D WPA_VERSION_WPA2 ?
+		EAPOL_KEY_TYPE_RSN : EAPOL_KEY_TYPE_WPA;
+	key_info |=3D version;
+	if (encr && sm->wpa =3D=3D WPA_VERSION_WPA2)
+		key_info |=3D WPA_KEY_INFO_ENCR_KEY_DATA;
+	if (sm->wpa !=3D WPA_VERSION_WPA2)
+		key_info |=3D keyidx << WPA_KEY_INFO_KEY_INDEX_SHIFT;
+	WPA_PUT_BE16(key->key_info, key_info);
+
+	alg =3D pairwise ? sm->pairwise : wpa_auth->conf.wpa_group;
+	switch (alg) {
+	case WPA_CIPHER_CCMP:
+		WPA_PUT_BE16(key->key_length, 16);
+		break;
+	case WPA_CIPHER_TKIP:
+		WPA_PUT_BE16(key->key_length, 32);
+		break;
+	case WPA_CIPHER_WEP40:
+		WPA_PUT_BE16(key->key_length, 5);
+		break;
+	case WPA_CIPHER_WEP104:
+		WPA_PUT_BE16(key->key_length, 13);
+		break;
+	}
+	if (key_info & WPA_KEY_INFO_SMK_MESSAGE)
+		WPA_PUT_BE16(key->key_length, 0);
+
+	/* FIX: STSL: what to use as key_replay_counter? */
+	for (i =3D RSNA_MAX_EAPOL_RETRIES - 1; i > 0; i--) {
+		sm->key_replay[i].valid =3D sm->key_replay[i - 1].valid;
+		os_memcpy(sm->key_replay[i].counter,
+			  sm->key_replay[i - 1].counter,
+			  WPA_REPLAY_COUNTER_LEN);
+	}
+	inc_byte_array(sm->key_replay[0].counter, WPA_REPLAY_COUNTER_LEN);
+	os_memcpy(key->replay_counter, sm->key_replay[0].counter,
+		  WPA_REPLAY_COUNTER_LEN);
+	sm->key_replay[0].valid =3D TRUE;
+
+	if (nonce)
+		os_memcpy(key->key_nonce, nonce, WPA_NONCE_LEN);
+
+	if (key_rsc)
+		os_memcpy(key->key_rsc, key_rsc, WPA_KEY_RSC_LEN);
+
+	if (kde && !encr) {
+		os_memcpy(key + 1, kde, kde_len);
+		WPA_PUT_BE16(key->key_data_length, kde_len);
+	} else if (encr && kde) {
+		buf =3D os_zalloc(key_data_len);
+		if (buf =3D=3D NULL) {
+			os_free(hdr);
+			return;
+		}
+		pos =3D buf;
+		os_memcpy(pos, kde, kde_len);
+		pos +=3D kde_len;
+
+		if (pad_len)
+			*pos++ =3D 0xdd;
+
+		wpa_hexdump_key(MSG_DEBUG, "Plaintext EAPOL-Key Key Data",
+				buf, key_data_len);
+		if (version =3D=3D WPA_KEY_INFO_TYPE_HMAC_SHA1_AES ||
+		    version =3D=3D WPA_KEY_INFO_TYPE_AES_128_CMAC) {
+			if (aes_wrap(sm->PTK.kek, (key_data_len - 8) / 8, buf,
+				     (u8 *) (key + 1))) {
+				os_free(hdr);
+				os_free(buf);
+				return;
+			}
+			WPA_PUT_BE16(key->key_data_length, key_data_len);
+		} else {
+			u8 ek[32];
+			os_memcpy(key->key_iv,
+				  sm->group->Counter + WPA_NONCE_LEN - 16, 16);
+			inc_byte_array(sm->group->Counter, WPA_NONCE_LEN);
+			os_memcpy(ek, key->key_iv, 16);
+			os_memcpy(ek + 16, sm->PTK.kek, 16);
+			os_memcpy(key + 1, buf, key_data_len);
+			rc4_skip(ek, 32, 256, (u8 *) (key + 1), key_data_len);
+			WPA_PUT_BE16(key->key_data_length, key_data_len);
+		}
+		os_free(buf);
+	}
+
+	if (key_info & WPA_KEY_INFO_MIC) {
+		if (!sm->PTK_valid) {
+			wpa_auth_logger(wpa_auth, sm->addr, LOGGER_DEBUG,
+					"PTK not valid when sending EAPOL-Key "
+					"frame");
+			os_free(hdr);
+			return;
+		}
+		wpa_eapol_key_mic(sm->PTK.kck, version, (u8 *) hdr, len,
+				  key->key_mic);
+	}
+
+	wpa_auth_set_eapol(sm->wpa_auth, sm->addr, WPA_EAPOL_inc_EapolFramesTx,
+			   1);
+	wpa_auth_send_eapol(wpa_auth, sm->addr, (u8 *) hdr, len,
+			    sm->pairwise_set);
+	os_free(hdr);
+}
+
+
+static void wpa_send_eapol(struct wpa_authenticator *wpa_auth,
+			   struct wpa_state_machine *sm, int key_info,
+			   const u8 *key_rsc, const u8 *nonce,
+			   const u8 *kde, size_t kde_len,
+			   int keyidx, int encr)
+{
+	int timeout_ms;
+	int pairwise =3D key_info & WPA_KEY_INFO_KEY_TYPE;
+	int ctr;
+
+	if (sm =3D=3D NULL)
+		return;
+
+	__wpa_send_eapol(wpa_auth, sm, key_info, key_rsc, nonce, kde, kde_len,
+			 keyidx, encr, 0);
+
+	ctr =3D pairwise ? sm->TimeoutCtr : sm->GTimeoutCtr;
+	if (ctr =3D=3D 1 && wpa_auth->conf.tx_status)
+		timeout_ms =3D eapol_key_timeout_first;
+	else
+		timeout_ms =3D eapol_key_timeout_subseq;
+	if (pairwise && ctr =3D=3D 1 && !(key_info & WPA_KEY_INFO_MIC))
+		sm->pending_1_of_4_timeout =3D 1;
+	wpa_printf(MSG_DEBUG, "WPA: Use EAPOL-Key timeout of %u ms (retry "
+		   "counter %d)", timeout_ms, ctr);
+	eloop_register_timeout(timeout_ms / 1000, (timeout_ms % 1000) * 1000,
+			       wpa_send_eapol_timeout, wpa_auth, sm);
+}
+
+
+static int wpa_verify_key_mic(struct wpa_ptk *PTK, u8 *data, size_t data_l=
en)
+{
+	struct ieee802_1x_hdr *hdr;
+	struct wpa_eapol_key *key;
+	u16 key_info;
+	int ret =3D 0;
+	u8 mic[16];
+
+	if (data_len < sizeof(*hdr) + sizeof(*key))
+		return -1;
+
+	hdr =3D (struct ieee802_1x_hdr *) data;
+	key =3D (struct wpa_eapol_key *) (hdr + 1);
+	key_info =3D WPA_GET_BE16(key->key_info);
+	os_memcpy(mic, key->key_mic, 16);
+	os_memset(key->key_mic, 0, 16);
+	if (wpa_eapol_key_mic(PTK->kck, key_info & WPA_KEY_INFO_TYPE_MASK,
+			      data, data_len, key->key_mic) ||
+	    os_memcmp(mic, key->key_mic, 16) !=3D 0)
+		ret =3D -1;
+	os_memcpy(key->key_mic, mic, 16);
+	return ret;
+}
