+	eap->buildReq =3D eap_identity_buildReq;
+	eap->check =3D eap_identity_check;
+	eap->process =3D eap_identity_process;
+	eap->isDone =3D eap_identity_isDone;
+	eap->isSuccess =3D eap_identity_isSuccess;
+
+	ret =3D eap_server_method_register(eap);
+	if (ret)
