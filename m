+static int eap_ttls_avp_parse(struct wpabuf *buf, struct eap_ttls_avp *par=
se)
+{
+	struct ttls_avp *avp;
+	u8 *pos;
+	int left;
+
+	pos =3D wpabuf_mhead(buf);
+	left =3D wpabuf_len(buf);
+	os_memset(parse, 0, sizeof(*parse));
+
+	while (left > 0) {
+		u32 avp_code, avp_length, vendor_id =3D 0;
+		u8 avp_flags, *dpos;
+		size_t pad, dlen;
+		avp =3D (struct ttls_avp *) pos;
+		avp_code =3D be_to_host32(avp->avp_code);
+		avp_length =3D be_to_host32(avp->avp_length);
+		avp_flags =3D (avp_length >> 24) & 0xff;
+		avp_length &=3D 0xffffff;
+		wpa_printf(MSG_DEBUG, "EAP-TTLS: AVP: code=3D%d flags=3D0x%02x "
+			   "length=3D%d", (int) avp_code, avp_flags,
+			   (int) avp_length);
+		if ((int) avp_length > left) {
+			wpa_printf(MSG_WARNING, "EAP-TTLS: AVP overflow "
+				   "(len=3D%d, left=3D%d) - dropped",
+				   (int) avp_length, left);
+			goto fail;
+		}
+		if (avp_length < sizeof(*avp)) {
+			wpa_printf(MSG_WARNING, "EAP-TTLS: Invalid AVP length "
+				   "%d", avp_length);
+			goto fail;
+		}
+		dpos =3D (u8 *) (avp + 1);
+		dlen =3D avp_length - sizeof(*avp);
+		if (avp_flags & AVP_FLAGS_VENDOR) {
+			if (dlen < 4) {
+				wpa_printf(MSG_WARNING, "EAP-TTLS: vendor AVP "
+					   "underflow");
+				goto fail;
+			}
+			vendor_id =3D be_to_host32(* (be32 *) dpos);
+			wpa_printf(MSG_DEBUG, "EAP-TTLS: AVP vendor_id %d",
+				   (int) vendor_id);
+			dpos +=3D 4;
+			dlen -=3D 4;
+		}
+
+		wpa_hexdump(MSG_DEBUG, "EAP-TTLS: AVP data", dpos, dlen);
+
+		if (vendor_id =3D=3D 0 && avp_code =3D=3D RADIUS_ATTR_EAP_MESSAGE) {
+			wpa_printf(MSG_DEBUG, "EAP-TTLS: AVP - EAP Message");
+			if (parse->eap =3D=3D NULL) {
+				parse->eap =3D os_malloc(dlen);
+				if (parse->eap =3D=3D NULL) {
+					wpa_printf(MSG_WARNING, "EAP-TTLS: "
+						   "failed to allocate memory "
+						   "for Phase 2 EAP data");
+					goto fail;
+				}
+				os_memcpy(parse->eap, dpos, dlen);
+				parse->eap_len =3D dlen;
+			} else {
+				u8 *neweap =3D os_realloc(parse->eap,
+							parse->eap_len + dlen);
+				if (neweap =3D=3D NULL) {
+					wpa_printf(MSG_WARNING, "EAP-TTLS: "
+						   "failed to allocate memory "
+						   "for Phase 2 EAP data");
+					goto fail;
+				}
+				os_memcpy(neweap + parse->eap_len, dpos, dlen);
+				parse->eap =3D neweap;
+				parse->eap_len +=3D dlen;
+			}
+		} else if (vendor_id =3D=3D 0 &&
+			   avp_code =3D=3D RADIUS_ATTR_USER_NAME) {
+			wpa_hexdump_ascii(MSG_DEBUG, "EAP-TTLS: User-Name",
+					  dpos, dlen);
+			parse->user_name =3D dpos;
+			parse->user_name_len =3D dlen;
+		} else if (vendor_id =3D=3D 0 &&
+			   avp_code =3D=3D RADIUS_ATTR_USER_PASSWORD) {
+			u8 *password =3D dpos;
+			size_t password_len =3D dlen;
+			while (password_len > 0 &&
+			       password[password_len - 1] =3D=3D '\0') {
+				password_len--;
+			}
+			wpa_hexdump_ascii_key(MSG_DEBUG, "EAP-TTLS: "
+					      "User-Password (PAP)",
+					      password, password_len);
+			parse->user_password =3D password;
+			parse->user_password_len =3D password_len;
+		} else if (vendor_id =3D=3D 0 &&
+			   avp_code =3D=3D RADIUS_ATTR_CHAP_CHALLENGE) {
+			wpa_hexdump(MSG_DEBUG,
+				    "EAP-TTLS: CHAP-Challenge (CHAP)",
+				    dpos, dlen);
+			parse->chap_challenge =3D dpos;
+			parse->chap_challenge_len =3D dlen;
+		} else if (vendor_id =3D=3D 0 &&
+			   avp_code =3D=3D RADIUS_ATTR_CHAP_PASSWORD) {
+			wpa_hexdump(MSG_DEBUG,
+				    "EAP-TTLS: CHAP-Password (CHAP)",
+				    dpos, dlen);
+			parse->chap_password =3D dpos;
+			parse->chap_password_len =3D dlen;
+		} else if (vendor_id =3D=3D RADIUS_VENDOR_ID_MICROSOFT &&
+			   avp_code =3D=3D RADIUS_ATTR_MS_CHAP_CHALLENGE) {
+			wpa_hexdump(MSG_DEBUG,
+				    "EAP-TTLS: MS-CHAP-Challenge",
+				    dpos, dlen);
+			parse->mschap_challenge =3D dpos;
+			parse->mschap_challenge_len =3D dlen;
+		} else if (vendor_id =3D=3D RADIUS_VENDOR_ID_MICROSOFT &&
+			   avp_code =3D=3D RADIUS_ATTR_MS_CHAP_RESPONSE) {
+			wpa_hexdump(MSG_DEBUG,
+				    "EAP-TTLS: MS-CHAP-Response (MSCHAP)",
+				    dpos, dlen);
+			parse->mschap_response =3D dpos;
+			parse->mschap_response_len =3D dlen;
+		} else if (vendor_id =3D=3D RADIUS_VENDOR_ID_MICROSOFT &&
+			   avp_code =3D=3D RADIUS_ATTR_MS_CHAP2_RESPONSE) {
+			wpa_hexdump(MSG_DEBUG,
+				    "EAP-TTLS: MS-CHAP2-Response (MSCHAPV2)",
+				    dpos, dlen);
+			parse->mschap2_response =3D dpos;
+			parse->mschap2_response_len =3D dlen;
+		} else if (avp_flags & AVP_FLAGS_MANDATORY) {
+			wpa_printf(MSG_WARNING, "EAP-TTLS: Unsupported "
+				   "mandatory AVP code %d vendor_id %d - "
+				   "dropped", (int) avp_code, (int) vendor_id);
