+	pos =3D eap_hdr_validate(EAP_VENDOR_IETF, EAP_TYPE_SIM, reqData, &len);
+	if (pos =3D=3D NULL || len < 1) {
+		ret->ignore =3D TRUE;
+		return NULL;
+	}
+	req =3D wpabuf_head(reqData);
+	id =3D req->identifier;
+	len =3D be_to_host16(req->length);
