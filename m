+static int wpa_driver_nl80211_send_action(void *priv, unsigned int freq,
+					  unsigned int wait_time,
+					  const u8 *dst, const u8 *src,
+					  const u8 *bssid,
+					  const u8 *data, size_t data_len)
+{
+	struct i802_bss *bss =3D priv;
+	struct wpa_driver_nl80211_data *drv =3D bss->drv;
+	int ret =3D -1;
+	u8 *buf;
+	struct ieee80211_hdr *hdr;
+
+	wpa_printf(MSG_DEBUG, "nl80211: Send Action frame (ifindex=3D%d, "
+		   "wait=3D%d ms)", drv->ifindex, wait_time);
+
+	buf =3D os_zalloc(24 + data_len);
+	if (buf =3D=3D NULL)
+		return ret;
+	os_memcpy(buf + 24, data, data_len);
+	hdr =3D (struct ieee80211_hdr *) buf;
+	hdr->frame_control =3D
+		IEEE80211_FC(WLAN_FC_TYPE_MGMT, WLAN_FC_STYPE_ACTION);
+	os_memcpy(hdr->addr1, dst, ETH_ALEN);
+	os_memcpy(hdr->addr2, src, ETH_ALEN);
+	os_memcpy(hdr->addr3, bssid, ETH_ALEN);
+
+	if (drv->nlmode =3D=3D NL80211_IFTYPE_AP)
+		ret =3D wpa_driver_nl80211_send_mlme(priv, buf, 24 + data_len);
+	else
+		ret =3D nl80211_send_frame_cmd(drv, freq, wait_time, buf,
+					     24 + data_len,
+					     &drv->send_action_cookie);
+
+	os_free(buf);
+	return ret;
+}
