+static void * test_driver_init(struct hostapd_data *hapd,
+			       struct wpa_init_params *params)
+{
+	struct wpa_driver_test_data *drv;
+	struct sockaddr_un addr_un;
+	struct sockaddr_in addr_in;
+	struct sockaddr *addr;
+	socklen_t alen;
+	struct test_driver_bss *bss;
+
+	drv =3D test_alloc_data(hapd, params->ifname);
+	if (drv =3D=3D NULL)
+		return NULL;
+	drv->ap =3D 1;
+	bss =3D dl_list_first(&drv->bss, struct test_driver_bss, list);
+
+	bss->bss_ctx =3D hapd;
+	os_memcpy(bss->bssid, drv->own_addr, ETH_ALEN);
+	os_memcpy(params->own_addr, drv->own_addr, ETH_ALEN);
+
+	if (params->test_socket) {
+		if (os_strlen(params->test_socket) >=3D
+		    sizeof(addr_un.sun_path)) {
+			printf("Too long test_socket path\n");
+			wpa_driver_test_deinit(bss);
+			return NULL;
+		}
+		if (strncmp(params->test_socket, "DIR:", 4) =3D=3D 0) {
+			size_t len =3D strlen(params->test_socket) + 30;
+			drv->test_dir =3D os_strdup(params->test_socket + 4);
+			drv->own_socket_path =3D os_malloc(len);
+			if (drv->own_socket_path) {
+				snprintf(drv->own_socket_path, len,
+					 "%s/AP-" MACSTR,
+					 params->test_socket + 4,
+					 MAC2STR(params->own_addr));
+			}
+		} else if (strncmp(params->test_socket, "UDP:", 4) =3D=3D 0) {
+			drv->udp_port =3D atoi(params->test_socket + 4);
+		} else {
+			drv->own_socket_path =3D os_strdup(params->test_socket);
+		}
+		if (drv->own_socket_path =3D=3D NULL && drv->udp_port =3D=3D 0) {
+			wpa_driver_test_deinit(bss);
+			return NULL;
+		}
+
+		drv->test_socket =3D socket(drv->udp_port ? PF_INET : PF_UNIX,
+					  SOCK_DGRAM, 0);
+		if (drv->test_socket < 0) {
+			perror("socket");
+			wpa_driver_test_deinit(bss);
+			return NULL;
+		}
+
+		if (drv->udp_port) {
+			os_memset(&addr_in, 0, sizeof(addr_in));
+			addr_in.sin_family =3D AF_INET;
+			addr_in.sin_port =3D htons(drv->udp_port);
+			addr =3D (struct sockaddr *) &addr_in;
+			alen =3D sizeof(addr_in);
+		} else {
+			os_memset(&addr_un, 0, sizeof(addr_un));
+			addr_un.sun_family =3D AF_UNIX;
+			os_strlcpy(addr_un.sun_path, drv->own_socket_path,
+				   sizeof(addr_un.sun_path));
+			addr =3D (struct sockaddr *) &addr_un;
+			alen =3D sizeof(addr_un);
+		}
+		if (bind(drv->test_socket, addr, alen) < 0) {
+			perror("bind(PF_UNIX)");
+			close(drv->test_socket);
+			if (drv->own_socket_path)
+				unlink(drv->own_socket_path);
+			wpa_driver_test_deinit(bss);
+			return NULL;
+		}
+		eloop_register_read_sock(drv->test_socket,
+					 test_driver_receive_unix, drv, NULL);
+	} else
+		drv->test_socket =3D -1;
+
+	return bss;
+}
