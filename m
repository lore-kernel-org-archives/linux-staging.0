+		if (drv_proc_hdls[i].type =3D=3D RTW_PROC_HDL_TYPE_SEQ)
+			entry =3D rtw_proc_create_entry(drv_proc_hdls[i].name, rtw_proc, &rtw_d=
rv_proc_seq_fops, (void *)i);
