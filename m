+static int tncs_imv_resolve_funcs(struct tnc_if_imv *imv)
+{
+	void *handle =3D imv->dlhandle;
+
+	/* Mandatory IMV functions */
+	imv->Initialize =3D tncs_get_sym(handle, "TNC_IMV_Initialize");
+	if (imv->Initialize =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "TNC: IMV does not export "
+			   "TNC_IMV_Initialize");
+		return -1;
+	}
+
+	imv->SolicitRecommendation =3D tncs_get_sym(
+		handle, "TNC_IMV_SolicitRecommendation");
+	if (imv->SolicitRecommendation =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "TNC: IMV does not export "
+			   "TNC_IMV_SolicitRecommendation");
+		return -1;
+	}
+
+	imv->ProvideBindFunction =3D
+		tncs_get_sym(handle, "TNC_IMV_ProvideBindFunction");
+	if (imv->ProvideBindFunction =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "TNC: IMV does not export "
+			   "TNC_IMV_ProvideBindFunction");
+		return -1;
+	}
+
+	/* Optional IMV functions */
+	imv->NotifyConnectionChange =3D
+		tncs_get_sym(handle, "TNC_IMV_NotifyConnectionChange");
+	imv->ReceiveMessage =3D tncs_get_sym(handle, "TNC_IMV_ReceiveMessage");
+	imv->BatchEnding =3D tncs_get_sym(handle, "TNC_IMV_BatchEnding");
+	imv->Terminate =3D tncs_get_sym(handle, "TNC_IMV_Terminate");
+
+	return 0;
+}
