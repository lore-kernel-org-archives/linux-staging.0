+	PRErrorCode err;
+	CERTCertificate *cert;
+	char *subject, *issuer;
+
+	err =3D PR_GetError();
+	if (IS_SEC_ERROR(err))
+		wpa_printf(MSG_DEBUG, "NSS: Bad Server Certificate (sec err "
+			   "%d)", err - SEC_ERROR_BASE);
+	else
+		wpa_printf(MSG_DEBUG, "NSS: Bad Server Certificate (err %d)",
+			   err);
+	cert =3D SSL_PeerCertificate(fd);
+	subject =3D CERT_NameToAscii(&cert->subject);
+	issuer =3D CERT_NameToAscii(&cert->issuer);
+	wpa_printf(MSG_DEBUG, "NSS: Peer certificate subject=3D'%s' issuer=3D'%s'=
",
+		   subject, issuer);
+	CERT_DestroyCertificate(cert);
+	PR_Free(subject);
+	PR_Free(issuer);
+	if (conn->verify_peer)
+		res =3D SECFailure;
+
+	return res;
