+
+#define S_SWAP(a,b) do { u8 t =3D S[a]; S[a] =3D S[b]; S[b] =3D t; } while=
(0)
+
+int rc4_skip(const u8 *key, size_t keylen, size_t skip,
+	     u8 *data, size_t data_len)
+{
+	u32 i, j, k;
+	u8 S[256], *pos;
+	size_t kpos;
+
+	/* Setup RC4 state */
+	for (i =3D 0; i < 256; i++)
+		S[i] =3D i;
+	j =3D 0;
+	kpos =3D 0;
+	for (i =3D 0; i < 256; i++) {
+		j =3D (j + S[i] + key[kpos]) & 0xff;
+		kpos++;
+		if (kpos >=3D keylen)
+			kpos =3D 0;
+		S_SWAP(i, j);
+	}
+
+	/* Skip the start of the stream */
+	i =3D j =3D 0;
+	for (k =3D 0; k < skip; k++) {
+		i =3D (i + 1) & 0xff;
+		j =3D (j + S[i]) & 0xff;
+		S_SWAP(i, j);
+	}
+
+	/* Apply RC4 to data */
+	pos =3D data;
+	for (k =3D 0; k < data_len; k++) {
+		i =3D (i + 1) & 0xff;
+		j =3D (j + S[i]) & 0xff;
+		S_SWAP(i, j);
+		*pos++ ^=3D S[(S[i] + S[j]) & 0xff];
+	}
+
+	return 0;
+}
