+/*
+ * ATTENTION:
+ *	rtw_ps_processor() doesn't handle LPS.
+ */
+void rtw_ps_processor(_adapter *padapter)
+{
+#ifdef CONFIG_P2P
+	struct wifidirect_info	*pwdinfo =3D &(padapter->wdinfo);
+#endif /* CONFIG_P2P */
+	struct pwrctrl_priv *pwrpriv =3D adapter_to_pwrctl(padapter);
+	struct mlme_priv *pmlmepriv =3D &(padapter->mlmepriv);
+	struct dvobj_priv *psdpriv =3D padapter->dvobj;
+	struct debug_priv *pdbgpriv =3D &psdpriv->drv_dbg;
+#ifdef SUPPORT_HW_RFOFF_DETECTED
+	rt_rf_power_state rfpwrstate;
+#endif /* SUPPORT_HW_RFOFF_DETECTED */
+	u32 ps_deny =3D 0;
+
+	_enter_pwrlock(&adapter_to_pwrctl(padapter)->lock);
+	ps_deny =3D rtw_ps_deny_get(padapter);
+	_exit_pwrlock(&adapter_to_pwrctl(padapter)->lock);
+	if (ps_deny !=3D 0) {
+		RTW_INFO(FUNC_ADPT_FMT ": ps_deny=3D0x%08X, skip power save!\n",
+			 FUNC_ADPT_ARG(padapter), ps_deny);
+		goto exit;
+	}
+
+	if (pwrpriv->bInSuspend =3D=3D true) { /* system suspend or autosuspend */
+		pdbgpriv->dbg_ps_insuspend_cnt++;
+		RTW_INFO("%s, pwrpriv->bInSuspend =3D=3D true ignore this process\n", __=
func__);
+		return;
+	}
+
+	pwrpriv->ps_processing =3D true;
+
+#ifdef SUPPORT_HW_RFOFF_DETECTED
+	if (pwrpriv->bips_processing =3D=3D true)
+		goto exit;
+
+	/* RTW_INFO("=3D=3D> fw report state(0x%x)\n",rtw_read8(padapter,0x1ca));=
	 */
+	if (pwrpriv->bHWPwrPindetect) {
+#ifdef CONFIG_AUTOSUSPEND
+		if (padapter->registrypriv.usbss_enable) {
+			if (pwrpriv->rf_pwrstate =3D=3D rf_on) {
+				if (padapter->net_closed =3D=3D true)
+					pwrpriv->ps_flag =3D true;
+
+				rfpwrstate =3D RfOnOffDetect(padapter);
+				RTW_INFO("@@@@- #1  %s=3D=3D> rfstate:%s\n", __func__, (rfpwrstate =3D=
=3D rf_on) ? "rf_on" : "rf_off");
+				if (rfpwrstate !=3D pwrpriv->rf_pwrstate) {
+					if (rfpwrstate =3D=3D rf_off) {
+						pwrpriv->change_rfpwrstate =3D rf_off;
+
+						pwrpriv->bkeepfwalive =3D true;
+						pwrpriv->brfoffbyhw =3D true;
+
+						autosuspend_enter(padapter);
+					}
+				}
+			}
+		} else
+#endif /* CONFIG_AUTOSUSPEND */
+		{
+			rfpwrstate =3D RfOnOffDetect(padapter);
+			RTW_INFO("@@@@- #2  %s=3D=3D> rfstate:%s\n", __func__, (rfpwrstate =3D=
=3D rf_on) ? "rf_on" : "rf_off");
+
+			if (rfpwrstate !=3D pwrpriv->rf_pwrstate) {
+				if (rfpwrstate =3D=3D rf_off) {
+					pwrpriv->change_rfpwrstate =3D rf_off;
+					pwrpriv->brfoffbyhw =3D true;
+					rtw_hw_suspend(padapter);
+				} else {
+					pwrpriv->change_rfpwrstate =3D rf_on;
+					rtw_hw_resume(padapter);
+				}
+				RTW_INFO("current rf_pwrstate(%s)\n", (pwrpriv->rf_pwrstate =3D=3D rf_=
off) ? "rf_off" : "rf_on");
+			}
+		}
+		pwrpriv->pwr_state_check_cnts++;
+	}
+#endif /* SUPPORT_HW_RFOFF_DETECTED */
+
+	if (pwrpriv->ips_mode_req =3D=3D IPS_NONE)
+		goto exit;
+
+	if (rtw_pwr_unassociated_idle(padapter) =3D=3D false)
+		goto exit;
+
+	if ((pwrpriv->rf_pwrstate =3D=3D rf_on) && ((pwrpriv->pwr_state_check_cnt=
s % 4) =3D=3D 0)) {
+		RTW_INFO("=3D=3D>%s .fw_state(%x)\n", __func__, get_fwstate(pmlmepriv));
+#if defined(CONFIG_BT_COEXIST) && defined (CONFIG_AUTOSUSPEND)
+#else
+		pwrpriv->change_rfpwrstate =3D rf_off;
+#endif
+#ifdef CONFIG_AUTOSUSPEND
+		if (padapter->registrypriv.usbss_enable) {
+			if (pwrpriv->bHWPwrPindetect)
+				pwrpriv->bkeepfwalive =3D true;
+
+			if (padapter->net_closed =3D=3D true)
+				pwrpriv->ps_flag =3D true;
+
+#if defined(CONFIG_BT_COEXIST) && defined (CONFIG_AUTOSUSPEND)
+			if (pwrpriv->bInternalAutoSuspend)
+				RTW_INFO("<=3D=3D%s .pwrpriv->bInternalAutoSuspend)(%x)\n", __func__, =
pwrpriv->bInternalAutoSuspend);
+			else {
+				pwrpriv->change_rfpwrstate =3D rf_off;
+				RTW_INFO("<=3D=3D%s .pwrpriv->bInternalAutoSuspend)(%x) call autosuspe=
nd_enter\n", __func__, pwrpriv->bInternalAutoSuspend);
+				autosuspend_enter(padapter);
+			}
+#else
+			autosuspend_enter(padapter);
+#endif	/* if defined (CONFIG_BT_COEXIST)&& defined (CONFIG_AUTOSUSPEND) */
+		} else if (pwrpriv->bHWPwrPindetect) {
+		} else
+#endif /* CONFIG_AUTOSUSPEND */
+		{
+#if defined(CONFIG_BT_COEXIST) && defined (CONFIG_AUTOSUSPEND)
+			pwrpriv->change_rfpwrstate =3D rf_off;
+#endif	/* defined (CONFIG_BT_COEXIST)&& defined (CONFIG_AUTOSUSPEND) */
+
+#ifdef CONFIG_IPS
+			ips_enter(padapter);
+#endif
+		}
+	}
+exit:
+#ifndef CONFIG_IPS_CHECK_IN_WD
+	rtw_set_pwr_state_check_timer(pwrpriv);
+#endif
+	pwrpriv->ps_processing =3D false;
+	return;
+}
