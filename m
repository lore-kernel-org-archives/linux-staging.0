+		return;
+	}
+	if (buf =3D=3D NULL) {
+		printf("%s - hexdump_ascii(len=3D%lu): [NULL]\n",
+		       title, (unsigned long) len);
+		return;
+	}
+	printf("%s - hexdump_ascii(len=3D%lu):\n", title, (unsigned long) len);
+	while (len) {
+		llen =3D len > line_len ? line_len : len;
+		printf("    ");
+		for (i =3D 0; i < llen; i++)
+			printf(" %02x", pos[i]);
+		for (i =3D llen; i < line_len; i++)
