+bool rtw_chbw_to_freq_range(u8 ch, u8 bw, u8 offset, u32 *hi, u32 *lo)
+{
+	u8 c_ch;
+	u32 freq;
+	u32 hi_ret =3D 0, lo_ret =3D 0;
+	int i;
+	bool valid =3D false;
+
+	if (hi)
+		*hi =3D 0;
+	if (lo)
+		*lo =3D 0;
+
+	c_ch =3D rtw_get_center_ch(ch, bw, offset);
+	freq =3D rtw_ch2freq(c_ch);
+
+	if (!freq) {
+		rtw_warn_on(1);
+		goto exit;
+	}
+
+	if (bw =3D=3D CHANNEL_WIDTH_80) {
+		hi_ret =3D freq + 40;
+		lo_ret =3D freq - 40;
+	} else if (bw =3D=3D CHANNEL_WIDTH_40) {
+		hi_ret =3D freq + 20;
+		lo_ret =3D freq - 20;
+	} else if (bw =3D=3D CHANNEL_WIDTH_20) {
+		hi_ret =3D freq + 10;
+		lo_ret =3D freq - 10;
+	} else
+		rtw_warn_on(1);
+
+	if (hi)
+		*hi =3D hi_ret;
+	if (lo)
+		*lo =3D lo_ret;
+
+	valid =3D true;
+
+exit:
+	return valid;
+}
