+	p_dm_odm->noisy_decision_smooth =3D (p_dm_odm->noisy_decision_smooth >> 1=
) + (score << 2);
+
+	/* Round the noisy_decision_smooth: +"3" comes from (2^3)/2-1 */
+	score_smooth =3D (total_cca_cnt >=3D 300) ? ((p_dm_odm->noisy_decision_sm=
ooth + 3) >> 3) : 0;
+
+	p_dm_odm->noisy_decision =3D (score_smooth >=3D 3) ? 1 : 0;
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_NOISY_DETECT, ODM_DBG_LOUD,
