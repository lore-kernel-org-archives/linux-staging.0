+void
+phydm_check_environment(
+	void	*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _ADAPTIVITY_STATISTICS	*adaptivity =3D (struct _ADAPTIVITY_STATIST=
ICS *)phydm_get_structure(p_dm_odm, PHYDM_ADAPTIVITY);
+	bool	is_clean_environment =3D false;
+
+	if (adaptivity->is_first_link =3D=3D true) {
+		if (p_dm_odm->support_ic_type & (ODM_IC_11AC_GAIN_IDX_EDCCA | ODM_IC_11N=
_GAIN_IDX_EDCCA))
+			p_dm_odm->adaptivity_flag =3D false;
+		else
+			p_dm_odm->adaptivity_flag =3D true;
+
+		adaptivity->is_first_link =3D false;
+		return;
+	} else {
+		if (adaptivity->nhm_wait < 3) {		/*Start enter NHM after 4 nhm_wait*/
+			adaptivity->nhm_wait++;
+			phydm_nhm_counter_statistics(p_dm_odm);
+			return;
+		} else {
+			phydm_nhm_counter_statistics(p_dm_odm);
+			is_clean_environment =3D phydm_cal_nhm_cnt(p_dm_odm);
+			if (is_clean_environment =3D=3D true) {
+				p_dm_odm->th_l2h_ini =3D adaptivity->th_l2h_ini_backup;			/*adaptivity=
 mode*/
+				p_dm_odm->th_edcca_hl_diff =3D adaptivity->th_edcca_hl_diff_backup;
+
+				p_dm_odm->adaptivity_enable =3D true;
+
+				if (p_dm_odm->support_ic_type & (ODM_IC_11AC_GAIN_IDX_EDCCA | ODM_IC_1=
1N_GAIN_IDX_EDCCA))
+					p_dm_odm->adaptivity_flag =3D false;
+				else
+					p_dm_odm->adaptivity_flag =3D true;
+			} else {
+				if (!adaptivity->acs_for_adaptivity) {
+					p_dm_odm->th_l2h_ini =3D p_dm_odm->th_l2h_ini_mode2;			/*mode2*/
+					p_dm_odm->th_edcca_hl_diff =3D p_dm_odm->th_edcca_hl_diff_mode2;
+
+					p_dm_odm->adaptivity_flag =3D false;
+					p_dm_odm->adaptivity_enable =3D false;
+				}
+			}
+			adaptivity->nhm_wait =3D 0;
+			adaptivity->is_first_link =3D true;
+			adaptivity->is_check =3D true;
+		}
+
+	}
+
