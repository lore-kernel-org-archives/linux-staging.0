+_adapter *rtw_drv_add_vir_if(_adapter *primary_padapter,
+	void (*set_intf_ops)(_adapter *primary_padapter, struct _io_ops *pops))
+{
+	int res =3D _FAIL;
+	_adapter *padapter =3D NULL;
+	struct dvobj_priv *pdvobjpriv;
+	u8 mac[ETH_ALEN];
+
+	/****** init adapter ******/
+	padapter =3D (_adapter *)rtw_zvmalloc(sizeof(*padapter));
+	if (padapter =3D=3D NULL)
+		goto exit;
+
+	if (loadparam(padapter) !=3D _SUCCESS)
+		goto free_adapter;
+
+	memcpy(padapter, primary_padapter, sizeof(_adapter));
+
+	/*  */
+	padapter->bup =3D false;
+	padapter->net_closed =3D true;
+	padapter->dir_dev =3D NULL;
+	padapter->dir_odm =3D NULL;
+
+	/*set adapter_type/iface type*/
+	padapter->isprimary =3D false;
+	padapter->adapter_type =3D VIRTUAL_ADAPTER;
+
+#ifdef CONFIG_MI_WITH_MBSSID_CAM
+	padapter->hw_port =3D HW_PORT0;
+#else
+	padapter->hw_port =3D HW_PORT1;
+#endif
+
+
+	/****** hook vir if into dvobj ******/
+	pdvobjpriv =3D adapter_to_dvobj(padapter);
+	padapter->iface_id =3D pdvobjpriv->iface_nums;
+	pdvobjpriv->padapters[pdvobjpriv->iface_nums++] =3D padapter;
+
+	padapter->intf_start =3D primary_padapter->intf_start;
+	padapter->intf_stop =3D primary_padapter->intf_stop;
+
+	/* step init_io_priv */
+	if ((rtw_init_io_priv(padapter, set_intf_ops)) =3D=3D _FAIL) {
+		goto free_adapter;
+	}
+
+	/*init drv data*/
+	if (rtw_init_drv_sw(padapter) !=3D _SUCCESS)
+		goto free_drv_sw;
+
+
+	/*get mac address from primary_padapter*/
+	memcpy(mac, adapter_mac_addr(primary_padapter), ETH_ALEN);
+
+	/*
+	* If the BIT1 is 0, the address is universally administered.
+	* If it is 1, the address is locally administered
+	*/
+	mac[0] |=3D BIT(1);
+	if (padapter->iface_id > IFACE_ID1)
+		mac[4] ^=3D BIT(padapter->iface_id);
+
+	memcpy(adapter_mac_addr(padapter), mac, ETH_ALEN);
+	/* update mac-address to mbsid-cam cache*/
+#ifdef CONFIG_MI_WITH_MBSSID_CAM
+	rtw_mbid_camid_alloc(padapter, adapter_mac_addr(padapter));
+#endif
+	RTW_INFO("%s if%d mac_addr : "MAC_FMT"\n", __func__, padapter->iface_id +=
 1, MAC_ARG(adapter_mac_addr(padapter)));
+#ifdef CONFIG_P2P
+	rtw_init_wifidirect_addrs(padapter, adapter_mac_addr(padapter), adapter_m=
ac_addr(padapter));
+#endif
+	res =3D _SUCCESS;
+
+free_drv_sw:
+	if (res !=3D _SUCCESS && padapter)
+		rtw_free_drv_sw(padapter);
+free_adapter:
+	if (res !=3D _SUCCESS && padapter) {
+		rtw_vmfree((u8 *)padapter, sizeof(*padapter));
+		padapter =3D NULL;
+	}
+exit:
+	return padapter;
+}
