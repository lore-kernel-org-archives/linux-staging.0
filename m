+				ptdlsinfo->ap_prohibited =3D true;
+			if (check_ap_tdls_ch_switching_prohibited(pIE->data, pIE->Length))
+				ptdlsinfo->ch_switch_prohibited =3D true;
+			break;
+#endif /* CONFIG_TDLS */
