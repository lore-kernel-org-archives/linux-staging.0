+		close(drv->cmd_socket);
+		drv->cmd_socket =3D -1;
+		unlink(drv->own_cmd_path);
+		os_free(drv->own_cmd_path);
+		drv->own_cmd_path =3D NULL;
+		return -1;
+	}
