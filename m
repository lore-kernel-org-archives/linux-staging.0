+	/*	Type: */
+	wfdie[wfdielen++] =3D WFD_ATTR_COUPLED_SINK_INFO;
+
+	/*	Length: */
+	/*	Note: In the WFD specification, the size of length field is 2. */
+	RTW_PUT_BE16(wfdie + wfdielen, 0x0007);
+	wfdielen +=3D 2;
+
+	/*	Value: */
+	/*	Coupled Sink Status bitmap */
+	/*	Not coupled/available for Coupling */
+	wfdie[wfdielen++] =3D 0;
+	/* MAC Addr. */
+	wfdie[wfdielen++] =3D 0;
+	wfdie[wfdielen++] =3D 0;
+	wfdie[wfdielen++] =3D 0;
+	wfdie[wfdielen++] =3D 0;
+	wfdie[wfdielen++] =3D 0;
+	wfdie[wfdielen++] =3D 0;
+
+	rtw_set_ie(pbuf, _VENDOR_SPECIFIC_IE_, wfdielen, (unsigned char *) wfdie,=
 &len);
+
+exit:
+	return len;
+}
