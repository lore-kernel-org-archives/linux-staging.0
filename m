+{
+	int ret =3D 0;
+#ifdef set_fs
+	mm_segment_t oldfs;
+#endif
+	struct file *fp;
+
+	if (path && buf) {
+		ret =3D openFile(&fp, path, O_CREAT | O_WRONLY, 0666);
+		if (0 =3D=3D ret) {
+			RTW_INFO("%s openFile path:%s fp=3D%p\n", __func__, path , fp);
+
+#ifdef set_fs
+			oldfs =3D get_fs();
+			set_fs(KERNEL_DS);
+#endif
+			ret =3D writeFile(fp, buf, sz);
+#ifdef set_fs
+			set_fs(oldfs);
+#endif
+			closeFile(fp);
+
+			RTW_INFO("%s writeFile, ret:%d\n", __func__, ret);
