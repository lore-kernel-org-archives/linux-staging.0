+static int wpa_priv_cmd(struct wpa_driver_privsep_data *drv, int cmd,
+			const void *data, size_t data_len,
+			void *reply, size_t *reply_len)
+{
+	struct msghdr msg;
+	struct iovec io[2];
+
+	io[0].iov_base =3D &cmd;
+	io[0].iov_len =3D sizeof(cmd);
+	io[1].iov_base =3D (u8 *) data;
+	io[1].iov_len =3D data_len;
+
+	os_memset(&msg, 0, sizeof(msg));
+	msg.msg_iov =3D io;
+	msg.msg_iovlen =3D data ? 2 : 1;
+	msg.msg_name =3D &drv->priv_addr;
+	msg.msg_namelen =3D sizeof(drv->priv_addr);
+
+	if (sendmsg(drv->cmd_socket, &msg, 0) < 0) {
+		perror("sendmsg(cmd_socket)");
+		return -1;
+	}
+
+	if (reply) {
+		fd_set rfds;
+		struct timeval tv;
+		int res;
+
+		FD_ZERO(&rfds);
+		FD_SET(drv->cmd_socket, &rfds);
+		tv.tv_sec =3D 5;
+		tv.tv_usec =3D 0;
+		res =3D select(drv->cmd_socket + 1, &rfds, NULL, NULL, &tv);
+		if (res < 0 && errno !=3D EINTR) {
+			perror("select");
+			return -1;
+		}
+
+		if (FD_ISSET(drv->cmd_socket, &rfds)) {
+			res =3D recv(drv->cmd_socket, reply, *reply_len, 0);
+			if (res < 0) {
+				perror("recv");
+				return -1;
+			}
+			*reply_len =3D res;
+		} else {
+			wpa_printf(MSG_DEBUG, "PRIVSEP: Timeout while waiting "
+				   "for reply (cmd=3D%d)", cmd);
+			return -1;
+		}
+	}
+
+	return 0;
+}
