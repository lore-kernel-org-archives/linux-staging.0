+
+		for (i =3D 0; i < 9; i++) {
+			pmlmeext->bcn_delay_ratio[i] =3D (pmlmeext->bcn_delay_cnt[i] * 100) / p=
mlmeext->bcn_cnt;
+
+
+			/* RTW_INFO("%s():bcn_delay_cnt[%d]=3D%d,  bcn_delay_ratio[%d]=3D%d\n",=
 __func__, i,  */
+			/*	pmlmeext->bcn_delay_cnt[i] , i, pmlmeext->bcn_delay_ratio[i]); */
+
+			ratio_20_delay +=3D pmlmeext->bcn_delay_ratio[i];
+			ratio_80_delay +=3D pmlmeext->bcn_delay_ratio[i];
+
+			if (ratio_20_delay > 20 && DrvBcnEarly =3D=3D 0xff) {
+				DrvBcnEarly =3D i;
+				/* RTW_INFO("%s(): DrvBcnEarly =3D %d\n", __func__, DrvBcnEarly); */
+			}
+
+			if (ratio_80_delay > 80 && DrvBcnTimeOut =3D=3D 0xff) {
