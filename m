+struct p2p_sd_query * p2p_pending_sd_req(struct p2p_data *p2p,
+					 struct p2p_device *dev)
+{
+	struct p2p_sd_query *q;
+
+	if (!(dev->info.dev_capab & P2P_DEV_CAPAB_SERVICE_DISCOVERY))
+		return 0; /* peer does not support SD */
+
+	for (q =3D p2p->sd_queries; q; q =3D q->next) {
+		if (q->for_all_peers && !(dev->flags & P2P_DEV_SD_INFO))
+			return q;
+		if (!q->for_all_peers &&
+		    os_memcmp(q->peer, dev->info.p2p_device_addr, ETH_ALEN) =3D=3D
+		    0)
+			return q;
+	}
+
+	return NULL;
+}
+
+
+static int p2p_unlink_sd_query(struct p2p_data *p2p,
+			       struct p2p_sd_query *query)
+{
+	struct p2p_sd_query *q, *prev;
+	q =3D p2p->sd_queries;
+	prev =3D NULL;
+	while (q) {
+		if (q =3D=3D query) {
+			if (prev)
+				prev->next =3D q->next;
+			else
+				p2p->sd_queries =3D q->next;
+			if (p2p->sd_query =3D=3D query)
+				p2p->sd_query =3D NULL;
+			return 1;
+		}
+		prev =3D q;
+		q =3D q->next;
+	}
+	return 0;
+}
+
+
+static void p2p_free_sd_query(struct p2p_sd_query *q)
+{
+	if (q =3D=3D NULL)
+		return;
+	wpabuf_free(q->tlvs);
+	os_free(q);
+}
+
+
+void p2p_free_sd_queries(struct p2p_data *p2p)
+{
+	struct p2p_sd_query *q, *prev;
+	q =3D p2p->sd_queries;
+	p2p->sd_queries =3D NULL;
+	while (q) {
+		prev =3D q;
+		q =3D q->next;
+		p2p_free_sd_query(prev);
+	}
+}
