+static s32 rtw_action_public_decache(union recv_frame *rframe, u8 token_of=
fset)
+{
+	_adapter *adapter =3D rframe->u.hdr.adapter;
+	struct mlme_ext_priv *mlmeext =3D &(adapter->mlmeextpriv);
+	u8 *frame =3D rframe->u.hdr.rx_data;
+	u16 seq_ctrl =3D ((le16_to_cpu(rframe->u.hdr.attrib.seq_num) & 0xffff) <<=
 4) |
+			((rframe->u.hdr.attrib.frag_num) & 0xf);
+	u8 token =3D *(rframe->u.hdr.rx_data + sizeof(struct rtw_ieee80211_hdr_3a=
ddr) + token_offset);
+
+	if (GetRetry(frame)) {
+		if ((seq_ctrl =3D=3D mlmeext->action_public_rxseq)
+		    && (token =3D=3D mlmeext->action_public_dialog_token)
+		   ) {
+			RTW_INFO(FUNC_ADPT_FMT" seq_ctrl=3D0x%x, rxseq=3D0x%x, token:%d\n",
+				FUNC_ADPT_ARG(adapter), seq_ctrl, mlmeext->action_public_rxseq, token);
+			return _FAIL;
+		}
+	}
+
+	/* TODO: per sta seq & token */
+	mlmeext->action_public_rxseq =3D seq_ctrl;
+	mlmeext->action_public_dialog_token =3D token;
+
+	return _SUCCESS;
+}
