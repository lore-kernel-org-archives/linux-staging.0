+int radius_msg_count_attr(struct radius_msg *msg, u8 type, int min_len)
+{
+	size_t i;
+	int count;
+
+	for (count =3D 0, i =3D 0; i < msg->attr_used; i++) {
+		struct radius_attr_hdr *attr =3D radius_get_attr_hdr(msg, i);
+		if (attr->type =3D=3D type &&
+		    attr->length >=3D sizeof(struct radius_attr_hdr) + min_len)
+			count++;
+	}
+
+	return count;
+}
