+static void read_mbssid_cam(_adapter *padapter, u8 cam_addr, u8 *mac)
+{
+	u8 poll =3D 1;
+	u8 cam_ready =3D false;
+	u32 cam_data1 =3D 0;
+	u16 cam_data2 =3D 0;
+
+	if (RTW_CANNOT_RUN(padapter))
+		return;
+
+	rtw_write32(padapter, REG_MBIDCAMCFG_2, BIT_MBIDCAM_POLL | ((cam_addr & M=
BIDCAM_ADDR_MASK) << MBIDCAM_ADDR_SHIFT));
+
+	do {
+		if (0 =3D=3D (rtw_read32(padapter, REG_MBIDCAMCFG_2) & BIT_MBIDCAM_POLL)=
) {
+			cam_ready =3D true;
+			break;
+		}
+		poll++;
+	} while ((poll % 10) !=3D 0 && !RTW_CANNOT_RUN(padapter));
+
+	if (cam_ready) {
+		cam_data1 =3D rtw_read32(padapter, REG_MBIDCAMCFG_1);
+		mac[0] =3D cam_data1 & 0xFF;
+		mac[1] =3D (cam_data1 >> 8) & 0xFF;
+		mac[2] =3D (cam_data1 >> 16) & 0xFF;
+		mac[3] =3D (cam_data1 >> 24) & 0xFF;
+
+		cam_data2 =3D rtw_read16(padapter, REG_MBIDCAMCFG_2);
+		mac[4] =3D cam_data2 & 0xFF;
+		mac[5] =3D (cam_data2 >> 8) & 0xFF;
+	}
+
+}
