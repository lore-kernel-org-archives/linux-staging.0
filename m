+
+/* IEEE Std 802.1X-2004, Ch. 8.2 */
+
+typedef enum { ForceUnauthorized =3D 1, ForceAuthorized =3D 3, Auto =3D 2 }
+	PortTypes;
+typedef enum { Unauthorized =3D 2, Authorized =3D 1 } PortState;
+typedef enum { Both =3D 0, In =3D 1 } ControlledDirection;
