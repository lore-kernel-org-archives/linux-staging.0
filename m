+#endif
+
+	ret =3D process_recv_indicatepkts(padapter, prframe);
+	if (ret !=3D _SUCCESS) {
+#ifdef DBG_RX_DROP_FRAME
+		RTW_INFO("DBG_RX_DROP_FRAME %s process_recv_indicatepkts fail!\n", __fun=
c__);
