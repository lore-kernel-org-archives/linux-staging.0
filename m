+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(len_channellist_attr);
+#endif
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	/*	Country String */
+	p2pie[p2pielen++] =3D 'X';
+	p2pie[p2pielen++] =3D 'X';
+
+	/*	The third byte should be set to 0x04. */
+	/*	Described in the "Operating Channel Attribute" section. */
+	p2pie[p2pielen++] =3D 0x04;
+
+	/*	Channel Entry List */
+#ifdef CONFIG_CONCURRENT_MODE
+	if (rtw_mi_check_status(padapter, MI_LINKED) && padapter->registrypriv.fu=
ll_ch_in_p2p_handshake =3D=3D 0) {
+		u8 union_ch =3D  rtw_mi_get_union_chan(padapter);
+
+		/*	Operating Class */
+		if (union_ch > 14) {
+			if (union_ch >=3D 149)
+				p2pie[p2pielen++] =3D 0x7c;
+			else
+				p2pie[p2pielen++] =3D 0x73;
+		} else
+			p2pie[p2pielen++] =3D 0x51;
+
+
+		/*	Number of Channels */
+		/*	Just support 1 channel and this channel is AP's channel */
+		p2pie[p2pielen++] =3D 1;
+
+		/*	Channel List */
+		p2pie[p2pielen++] =3D union_ch;
+	} else {
