+	enum edit_key_code ret =3D EDIT_KEY_NONE;
+
+	last =3D '\0';
+	for (pos =3D seq; *pos; pos++)
+		last =3D *pos;
+
+	if (seq[1] >=3D '0' && seq[1] <=3D '9') {
+		param1 =3D atoi(&seq[1]);
+		pos =3D os_strchr(seq, ';');
+		if (pos)
+			param2 =3D atoi(pos + 1);
+	}
+
+	if (seq[0] =3D=3D '[')
+		ret =3D esc_seq_to_key1(param1, param2, last);
+	else if (seq[0] =3D=3D 'O')
+		ret =3D esc_seq_to_key2(param1, param2, last);
+
+	if (ret !=3D EDIT_KEY_NONE)
+		return ret;
+
+	edit_clear_line();
+	printf("\rUnknown escape sequence '%s'\n", seq);
+	edit_redraw();
+	return EDIT_KEY_NONE;
+}
+
+
+static enum edit_key_code edit_read_key(int sock)
+{
+	int c;
+	unsigned char buf[1];
+	int res;
+	static int esc =3D -1;
+	static char esc_buf[7];
+
+	res =3D read(sock, buf, 1);
+	if (res < 0)
+		perror("read");
+	if (res <=3D 0)
+		return EDIT_KEY_EOF;
+
+	c =3D buf[0];
+
+	if (esc >=3D 0) {
+		if (c =3D=3D 27 /* ESC */) {
+			esc =3D 0;
+			return EDIT_KEY_NONE;
+		}
+
+		if (esc =3D=3D 6) {
+			show_esc_buf(esc_buf, c, 0);
+			esc =3D -1;
+		} else {
+			esc_buf[esc++] =3D c;
+			esc_buf[esc] =3D '\0';
+		}
+	}
+
+	if (esc =3D=3D 1) {
+		if (esc_buf[0] !=3D '[' && esc_buf[0] !=3D 'O') {
+			show_esc_buf(esc_buf, c, 1);
+			esc =3D -1;
+			return EDIT_KEY_NONE;
+		} else
+			return EDIT_KEY_NONE; /* Escape sequence continues */
+	}
+
+	if (esc > 1) {
+		if ((c >=3D '0' && c <=3D '9') || c =3D=3D ';')
+			return EDIT_KEY_NONE; /* Escape sequence continues */
+
+		if (c =3D=3D '~' || (c >=3D 'A' && c <=3D 'Z')) {
+			esc =3D -1;
+			return esc_seq_to_key(esc_buf);
+		}
+
+		show_esc_buf(esc_buf, c, 2);
+		esc =3D -1;
+		return EDIT_KEY_NONE;
+	}
+
+	switch (c) {
+	case 1:
+		return EDIT_KEY_CTRL_A;
+	case 2:
+		return EDIT_KEY_CTRL_B;
+	case 4:
+		return EDIT_KEY_CTRL_D;
+	case 5:
+		return EDIT_KEY_CTRL_E;
+	case 6:
+		return EDIT_KEY_CTRL_F;
+	case 7:
+		return EDIT_KEY_CTRL_G;
+	case 8:
+		return EDIT_KEY_CTRL_H;
+	case 9:
+		return EDIT_KEY_TAB;
+	case 10:
+		return EDIT_KEY_CTRL_J;
+	case 13: /* CR */
+		return EDIT_KEY_ENTER;
+	case 11:
+		return EDIT_KEY_CTRL_K;
+	case 12:
+		return EDIT_KEY_CTRL_L;
+	case 14:
+		return EDIT_KEY_CTRL_N;
+	case 15:
+		return EDIT_KEY_CTRL_O;
+	case 16:
+		return EDIT_KEY_CTRL_P;
+	case 18:
+		return EDIT_KEY_CTRL_R;
+	case 20:
+		return EDIT_KEY_CTRL_T;
+	case 21:
+		return EDIT_KEY_CTRL_U;
+	case 22:
+		return EDIT_KEY_CTRL_V;
+	case 23:
+		return EDIT_KEY_CTRL_W;
+	case 27: /* ESC */
+		esc =3D 0;
+		return EDIT_KEY_NONE;
+	case 127:
+		return EDIT_KEY_BACKSPACE;
+	default:
+		return c;
+	}
+}
+
+
+static char search_buf[21];
+static int search_skip;
+
+static char * search_find(void)
+{
+	struct edit_history *h;
+	size_t len =3D os_strlen(search_buf);
+	int skip =3D search_skip;
+
+	if (len =3D=3D 0)
+		return NULL;
+
+	dl_list_for_each(h, &history_list, struct edit_history, list) {
+		if (os_strstr(h->str, search_buf)) {
+			if (skip =3D=3D 0)
+				return h->str;
+			skip--;
+		}
+	}
+
+	search_skip =3D 0;
+	return NULL;
+}
+
+
+static void search_redraw(void)
+{
+	char *match =3D search_find();
+	printf("\rsearch '%s': %s" CLEAR_END_LINE,
+	       search_buf, match ? match : "");
+	printf("\rsearch '%s", search_buf);
+	fflush(stdout);
+}
+
+
+static void search_start(void)
+{
+	edit_clear_line();
+	search_buf[0] =3D '\0';
+	search_skip =3D 0;
+	search_redraw();
+}
+
+
+static void search_clear(void)
+{
+	search_redraw();
+	printf("\r" CLEAR_END_LINE);
+}
+
+
+static void search_stop(void)
+{
+	char *match =3D search_find();
+	search_buf[0] =3D '\0';
+	search_clear();
+	if (match) {
+		os_strlcpy(cmdbuf, match, CMD_BUF_LEN);
+		cmdbuf_len =3D os_strlen(cmdbuf);
+		cmdbuf_pos =3D cmdbuf_len;
+	}
+	edit_redraw();
+}
+
+
+static void search_cancel(void)
+{
+	search_buf[0] =3D '\0';
+	search_clear();
+	edit_redraw();
+}
+
+
+static void search_backspace(void)
+{
+	size_t len;
+	len =3D os_strlen(search_buf);
+	if (len =3D=3D 0)
+		return;
+	search_buf[len - 1] =3D '\0';
+	search_skip =3D 0;
+	search_redraw();
+}
+
+
+static void search_next(void)
+{
+	search_skip++;
+	search_find();
+	search_redraw();
+}
+
+
+static void search_char(char c)
+{
+	size_t len;
+	len =3D os_strlen(search_buf);
+	if (len =3D=3D sizeof(search_buf) - 1)
+		return;
+	search_buf[len] =3D c;
+	search_buf[len + 1] =3D '\0';
+	search_skip =3D 0;
+	search_redraw();
+}
+
+
+static enum edit_key_code search_key(enum edit_key_code c)
+{
+	switch (c) {
+	case EDIT_KEY_ENTER:
+	case EDIT_KEY_CTRL_J:
+	case EDIT_KEY_LEFT:
+	case EDIT_KEY_RIGHT:
+	case EDIT_KEY_HOME:
+	case EDIT_KEY_END:
+	case EDIT_KEY_CTRL_A:
+	case EDIT_KEY_CTRL_E:
+		search_stop();
+		return c;
+	case EDIT_KEY_DOWN:
+	case EDIT_KEY_UP:
+		search_cancel();
+		return EDIT_KEY_EOF;
+	case EDIT_KEY_CTRL_H:
+	case EDIT_KEY_BACKSPACE:
+		search_backspace();
+		break;
+	case EDIT_KEY_CTRL_R:
+		search_next();
+		break;
+	default:
+		if (c >=3D 32 && c <=3D 255)
+			search_char(c);
+		break;
+	}
+
+	return EDIT_KEY_NONE;
+}
+
+
+static void edit_read_char(int sock, void *eloop_ctx, void *sock_ctx)
+{
+	static int last_tab =3D 0;
+	static int search =3D 0;
+	enum edit_key_code c;
+
+	c =3D edit_read_key(sock);
+
+	if (search) {
+		c =3D search_key(c);
+		if (c =3D=3D EDIT_KEY_NONE)
+			return;
+		search =3D 0;
+		if (c =3D=3D EDIT_KEY_EOF)
+			return;
+	}
+
+	if (c !=3D EDIT_KEY_TAB && c !=3D EDIT_KEY_NONE)
+		last_tab =3D 0;
+
+	switch (c) {
+	case EDIT_KEY_NONE:
+		break;
+	case EDIT_KEY_EOF:
+		edit_eof_cb(edit_cb_ctx);
+		break;
+	case EDIT_KEY_TAB:
+		complete(last_tab);
+		last_tab =3D 1;
+		break;
+	case EDIT_KEY_UP:
+	case EDIT_KEY_CTRL_P:
+		history_prev();
+		break;
+	case EDIT_KEY_DOWN:
+	case EDIT_KEY_CTRL_N:
+		history_next();
+		break;
+	case EDIT_KEY_RIGHT:
+	case EDIT_KEY_CTRL_F:
+		move_right();
+		break;
+	case EDIT_KEY_LEFT:
+	case EDIT_KEY_CTRL_B:
+		move_left();
+		break;
+	case EDIT_KEY_CTRL_RIGHT:
+		move_word_right();
+		break;
+	case EDIT_KEY_CTRL_LEFT:
+		move_word_left();
+		break;
+	case EDIT_KEY_DELETE:
+		delete_current();
+		break;
+	case EDIT_KEY_END:
+		move_end();
+		break;
+	case EDIT_KEY_HOME:
+	case EDIT_KEY_CTRL_A:
+		move_start();
+		break;
+	case EDIT_KEY_F2:
+		history_debug_dump();
+		break;
+	case EDIT_KEY_CTRL_D:
+		if (cmdbuf_len > 0) {
+			delete_current();
+			return;
+		}
+		printf("\n");
+		edit_eof_cb(edit_cb_ctx);
+		break;
+	case EDIT_KEY_CTRL_E:
+		move_end();
+		break;
+	case EDIT_KEY_CTRL_H:
+	case EDIT_KEY_BACKSPACE:
+		delete_left();
+		break;
+	case EDIT_KEY_ENTER:
+	case EDIT_KEY_CTRL_J:
+		process_cmd();
+		break;
+	case EDIT_KEY_CTRL_K:
+		clear_right();
+		break;
+	case EDIT_KEY_CTRL_L:
+		edit_clear_line();
+		edit_redraw();
+		break;
+	case EDIT_KEY_CTRL_R:
+		search =3D 1;
+		search_start();
+		break;
+	case EDIT_KEY_CTRL_U:
+		clear_left();
+		break;
+	case EDIT_KEY_CTRL_W:
+		delete_word();
+		break;
+	default:
+		if (c >=3D 32 && c <=3D 255)
+			insert_char(c);
+		break;
+	}
+}
+
+
+int edit_init(void (*cmd_cb)(void *ctx, char *cmd),
+	      void (*eof_cb)(void *ctx),
+	      char ** (*completion_cb)(void *ctx, const char *cmd, int pos),
+	      void *ctx, const char *history_file)
+{
+	dl_list_init(&history_list);
+	history_curr =3D NULL;
+	if (history_file)
+		history_read(history_file);
+
+	edit_cb_ctx =3D ctx;
+	edit_cmd_cb =3D cmd_cb;
+	edit_eof_cb =3D eof_cb;
+	edit_completion_cb =3D completion_cb;
+
+	tcgetattr(STDIN_FILENO, &prevt);
+	newt =3D prevt;
+	newt.c_lflag &=3D ~(ICANON | ECHO);
+	tcsetattr(STDIN_FILENO, TCSANOW, &newt);
+
+	eloop_register_read_sock(STDIN_FILENO, edit_read_char, NULL, NULL);
+
+	printf("> ");
+	fflush(stdout);
+
+	return 0;
+}
+
+
+void edit_deinit(const char *history_file,
+		 int (*filter_cb)(void *ctx, const char *cmd))
+{
+	struct edit_history *h;
+	if (history_file)
+		history_write(history_file, filter_cb);
+	while ((h =3D dl_list_first(&history_list, struct edit_history, list))) {
+		dl_list_del(&h->list);
+		os_free(h);
+	}
+	edit_clear_line();
+	putchar('\r');
+	fflush(stdout);
+	eloop_unregister_read_sock(STDIN_FILENO);
+	tcsetattr(STDIN_FILENO, TCSANOW, &prevt);
+}
+
+
+void edit_redraw(void)
+{
+	char tmp;
+	cmdbuf[cmdbuf_len] =3D '\0';
+	printf("\r> %s", cmdbuf);
+	if (cmdbuf_pos !=3D cmdbuf_len) {
+		tmp =3D cmdbuf[cmdbuf_pos];
+		cmdbuf[cmdbuf_pos] =3D '\0';
+		printf("\r> %s", cmdbuf);
+		cmdbuf[cmdbuf_pos] =3D tmp;
+	}
+	fflush(stdout);
+}
