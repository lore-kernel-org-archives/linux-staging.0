 }
 
 /*
-signed int	rtw_enqueue_recvframe(union recv_frame *precvframe, struct __queue *queue)
-{
-	return rtw_free_recvframe(precvframe, queue);
-}
-*/
+ * signed int	rtw_enqueue_recvframe(union recv_frame *precvframe, struct __queue *queue)
+ * {
+ * 	return rtw_free_recvframe(precvframe, queue);
+ * }
+ */
 
 
 
 
