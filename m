+#ifdef CONFIG_WOWLAN
+u16 rtw_cal_crc16(u8 data, u16 crc)
+{
+	u8 shift_in, data_bit;
+	u8 crc_bit4, crc_bit11, crc_bit15;
+	u16 crc_result;
+	int index;
+
+	for (index =3D 0; index < 8; index++) {
+		crc_bit15 =3D ((crc & BIT15) ? 1 : 0);
+		data_bit =3D (data & (BIT0 << index) ? 1 : 0);
+		shift_in =3D crc_bit15 ^ data_bit;
+		/*printf("crc_bit15=3D%d, DataBit=3D%d, shift_in=3D%d\n",
+		 * crc_bit15, data_bit, shift_in);*/
+
+		crc_result =3D crc << 1;
+
+		if (shift_in =3D=3D 0)
+			crc_result &=3D (~BIT0);
+		else
+			crc_result |=3D BIT0;
+		/*printf("CRC =3D%x\n",CRC_Result);*/
+
+		crc_bit11 =3D ((crc & BIT11) ? 1 : 0) ^ shift_in;
+
+		if (crc_bit11 =3D=3D 0)
+			crc_result &=3D (~BIT12);
+		else
+			crc_result |=3D BIT12;
+
+		/*printf("bit12 CRC =3D%x\n",CRC_Result);*/
+
+		crc_bit4 =3D ((crc & BIT4) ? 1 : 0) ^ shift_in;
+
+		if (crc_bit4 =3D=3D 0)
+			crc_result &=3D (~BIT5);
+		else
+			crc_result |=3D BIT5;
+
+		/* printf("bit5 CRC =3D%x\n",CRC_Result); */
+		/* repeat using the last result*/
+		crc =3D crc_result;
+	}
+	return crc;
+}
+
+/*
+ * function name :rtw_calc_crc
+ *
+ * input: char* pattern , pattern size
+ *
+ */
+u16 rtw_calc_crc(u8  *pdata, int length)
+{
+	u16 crc =3D 0xffff;
+	int i;
+
+	for (i =3D 0; i < length; i++)
+		crc =3D rtw_cal_crc16(pdata[i], crc);
+	/* get 1' complement */
+	crc =3D ~crc;
+
+	return crc;
+}
