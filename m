+void
+rtl8188e_HalDmWatchDog(
+	PADAPTER	Adapter
+)
+{
+	bool		bFwCurrentInPSMode =3D false;
+	bool		bFwPSAwake =3D true;
+	PHAL_DATA_TYPE	pHalData =3D GET_HAL_DATA(Adapter);
+	struct PHY_DM_STRUCT		*pDM_Odm =3D &(pHalData->odmpriv);
+
+
+	if (!rtw_is_hw_init_completed(Adapter))
+		goto skip_dm;
