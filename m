+/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
+	SFD		SIGNAL	SERVICE	LENGTH	CRC
+	16 bit	8 bit	8 bit	16 bit	16 bit
+=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/
+void CCK_generator(
+	PRT_PMAC_TX_INFO	pPMacTxInfo,
+	PRT_PMAC_PKT_INFO	pPMacPktInfo
+)
+{
+	double	ratio =3D 0;
+	bool	crc16_in[32] =3D {0}, crc16_out[16] =3D {0};
+	bool LengthExtBit;
+	double LengthExact;
+	double LengthPSDU;
+	u8 i;
+	u32 PacketLength =3D pPMacTxInfo->PacketLength;
+
+	if (pPMacTxInfo->bSPreamble)
+		pPMacTxInfo->SFD =3D 0x05CF;
+	else
+		pPMacTxInfo->SFD =3D 0xF3A0;
+
+	switch (pPMacPktInfo->MCS) {
+	case 0:
+		pPMacTxInfo->SignalField =3D 0xA;
+		ratio =3D 8;
+		/*CRC16_in(1,0:7)=3D[0 1 0 1 0 0 0 0]*/
+		crc16_in[1] =3D crc16_in[3] =3D 1;
+		break;
+	case 1:
+		pPMacTxInfo->SignalField =3D 0x14;
+		ratio =3D 4;
+		/*CRC16_in(1,0:7)=3D[0 0 1 0 1 0 0 0];*/
+		crc16_in[2] =3D crc16_in[4] =3D 1;
+		break;
+	case 2:
+		pPMacTxInfo->SignalField =3D 0x37;
+		ratio =3D 8.0 / 5.5;
+		/*CRC16_in(1,0:7)=3D[1 1 1 0 1 1 0 0];*/
+		crc16_in[0] =3D crc16_in[1] =3D crc16_in[2] =3D crc16_in[4] =3D crc16_in=
[5] =3D 1;
+		break;
+	case 3:
+		pPMacTxInfo->SignalField =3D 0x6E;
+		ratio =3D 8.0 / 11.0;
+		/*CRC16_in(1,0:7)=3D[0 1 1 1 0 1 1 0];*/
+		crc16_in[1] =3D crc16_in[2] =3D crc16_in[3] =3D crc16_in[5] =3D crc16_in=
[6] =3D 1;
+		break;
+	}
+
+	LengthExact =3D PacketLength * ratio;
+	LengthPSDU =3D ceil(LengthExact);
+
+	if ((pPMacPktInfo->MCS =3D=3D 3) &&
+	    ((LengthPSDU - LengthExact) >=3D 0.727 || (LengthPSDU - LengthExact) =
<=3D -0.727))
+		LengthExtBit =3D 1;
+	else
+		LengthExtBit =3D 0;
+
+
+	pPMacTxInfo->LENGTH =3D (u32)LengthPSDU;
+	/* CRC16_in(1,16:31) =3D LengthPSDU[0:15]*/
+	for (i =3D 0; i < 16; i++)
+		crc16_in[i + 16] =3D (pPMacTxInfo->LENGTH >> i) & 0x1;
+
+	if (LengthExtBit =3D=3D 0) {
+		pPMacTxInfo->ServiceField =3D 0x0;
+		/* CRC16_in(1,8:15) =3D [0 0 0 0 0 0 0 0];*/
+	} else {
+		pPMacTxInfo->ServiceField =3D 0x80;
+		/*CRC16_in(1,8:15)=3D[0 0 0 0 0 0 0 1];*/
+		crc16_in[15] =3D 1;
+	}
+
+	CRC16_generator(crc16_out, crc16_in, 32);
+
+	memset(pPMacTxInfo->CRC16, 0, 2);
+	ByteToBit(pPMacTxInfo->CRC16, crc16_out, 2);
+
+}
