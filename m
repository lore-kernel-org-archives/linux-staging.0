+static int wpa_driver_ralink_add_pmkid(void *priv, const u8 *bssid,
+				       const u8 *pmkid)
+{
+	struct wpa_driver_ralink_data *drv =3D priv;
+	struct ndis_pmkid_entry *entry, *prev;
+
+	if (drv->g_driver_down =3D=3D 1)
+		return -1;
+
+	wpa_printf(MSG_DEBUG, "%s", __FUNCTION__);
+
+	if (drv->no_of_pmkid =3D=3D 0)
+		return 0;
+
+	prev =3D NULL;
+	entry =3D drv->pmkid;
+	while (entry) {
+		if (os_memcmp(entry->bssid, bssid, ETH_ALEN) =3D=3D 0)
+			break;
+		prev =3D entry;
+		entry =3D entry->next;
+	}
+
+	if (entry) {
+		/* Replace existing entry for this BSSID and move it into the
+		 * beginning of the list. */
+		os_memcpy(entry->pmkid, pmkid, 16);
+		if (prev) {
+			prev->next =3D entry->next;
+			entry->next =3D drv->pmkid;
+			drv->pmkid =3D entry;
+		}
+	} else {
+		entry =3D os_malloc(sizeof(*entry));
+		if (entry) {
+			os_memcpy(entry->bssid, bssid, ETH_ALEN);
+			os_memcpy(entry->pmkid, pmkid, 16);
+			entry->next =3D drv->pmkid;
+			drv->pmkid =3D entry;
+		}
+	}
+
+	return wpa_driver_ralink_set_pmkid(drv);
+}
