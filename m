+
+		_exit_critical_bh(&pstapriv->sta_hash_lock, &irqL);
+
+		plist =3D get_next(&dlist);
+		while (rtw_end_of_queue_search(&dlist, plist) =3D=3D false) {
+			psta =3D LIST_CONTAINOR(plist, struct sta_info, list);
