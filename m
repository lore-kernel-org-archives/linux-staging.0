+					     params->wpa_ie_len);
+
+		ralink_set_auth_mode(drv, Ndis802_11AuthModeOpen);
+
+		ralink_set_encr_type(drv, Ndis802_11EncryptionDisabled);
+	} else {
+#ifdef CONFIG_WPS
+		UCHAR enable_wpa_supplicant;
+
+		if (drv->ap_scan =3D=3D 1)
+			enable_wpa_supplicant =3D 0x01;
+		else
+			enable_wpa_supplicant =3D 0x02;
+
+		/* trigger driver support wpa_supplicant */
+		if (ralink_set_oid(drv, RT_OID_WPA_SUPPLICANT_SUPPORT,
+				   (PCHAR) &enable_wpa_supplicant,
+				   sizeof(UCHAR)) < 0) {
+			wpa_printf(MSG_DEBUG, "RALINK: Failed to set "
+				   "RT_OID_WPA_SUPPLICANT_SUPPORT (%d)",
+				   (int) enable_wpa_supplicant);
+		}
+
+		wpa_driver_ralink_set_gen_ie(priv, (u8 *) "", 0);
+#endif /* CONFIG_WPS */
+
+		if (params->wpa_ie =3D=3D NULL || params->wpa_ie_len =3D=3D 0) {
+			if (params->auth_alg & WPA_AUTH_ALG_SHARED) {
+				if (params->auth_alg & WPA_AUTH_ALG_OPEN)
+					auth_mode =3D Ndis802_11AuthModeAutoSwitch;
+				else
+					auth_mode =3D Ndis802_11AuthModeShared;
+			} else
+				auth_mode =3D Ndis802_11AuthModeOpen;
+		} else if (params->wpa_ie[0] =3D=3D WLAN_EID_RSN) {
+			if (params->key_mgmt_suite =3D=3D KEY_MGMT_PSK)
+				auth_mode =3D Ndis802_11AuthModeWPA2PSK;
+			else
+				auth_mode =3D Ndis802_11AuthModeWPA2;
+		} else {
+			if (params->key_mgmt_suite =3D=3D KEY_MGMT_WPA_NONE)
+				auth_mode =3D Ndis802_11AuthModeWPANone;
+			else if (params->key_mgmt_suite =3D=3D KEY_MGMT_PSK)
+				auth_mode =3D Ndis802_11AuthModeWPAPSK;
+			else
+				auth_mode =3D Ndis802_11AuthModeWPA;
+		}
+
+		switch (params->pairwise_suite) {
+		case CIPHER_CCMP:
+			encr =3D Ndis802_11Encryption3Enabled;
+			break;
+		case CIPHER_TKIP:
+			encr =3D Ndis802_11Encryption2Enabled;
+			break;
+		case CIPHER_WEP40:
+		case CIPHER_WEP104:
+			encr =3D Ndis802_11Encryption1Enabled;
+			break;
+		case CIPHER_NONE:
+			if (params->group_suite =3D=3D CIPHER_CCMP)
+				encr =3D Ndis802_11Encryption3Enabled;
+			else if (params->group_suite =3D=3D CIPHER_TKIP)
+				encr =3D Ndis802_11Encryption2Enabled;
+			else
+				encr =3D Ndis802_11EncryptionDisabled;
+			break;
+		default:
+			encr =3D Ndis802_11EncryptionDisabled;
+			break;
+		}
+
+		ralink_set_auth_mode(drv, auth_mode);
+
+		/* notify driver that IEEE8021x mode is enabled */
+		if (params->key_mgmt_suite =3D=3D KEY_MGMT_802_1X_NO_WPA) {
+			ieee8021xMode =3D TRUE;
+			if (drv->bAddWepKey)
+				ieee8021x_required_key =3D FALSE;
+		} else
+			ieee8021xMode =3D FALSE;
+
+		if (ralink_set_oid(drv, OID_802_11_SET_IEEE8021X_REQUIRE_KEY,
+				   (char *) &ieee8021x_required_key,
+				   sizeof(BOOLEAN)) < 0) {
+			wpa_printf(MSG_DEBUG, "ERROR: Failed to set "
+				   "OID_802_11_SET_IEEE8021X_REQUIRE_KEY(%d)",
+				   (int) ieee8021x_required_key);
+		} else {
+			wpa_printf(MSG_DEBUG, "ieee8021x_required_key is %s",
+				   ieee8021x_required_key ? "TRUE" : "FALSE");
+		}
+
+		if (ralink_set_oid(drv, OID_802_11_SET_IEEE8021X,
+				   (char *) &ieee8021xMode, sizeof(BOOLEAN)) <
+		    0) {
+			wpa_printf(MSG_DEBUG, "RALINK: Failed to set "
+				   "OID_802_11_SET_IEEE8021X(%d)",
+				   (int) ieee8021xMode);
+		}
+
+		ralink_set_encr_type(drv, encr);
+
+		if ((ieee8021xMode =3D=3D FALSE) &&
+		    (encr =3D=3D Ndis802_11Encryption1Enabled)) {
+			/* static WEP */
+			int enabled =3D 0;
+			if (ralink_set_oid(drv, OID_802_11_DROP_UNENCRYPTED,
+					   (char *) &enabled, sizeof(enabled))
+			    < 0) {
+				wpa_printf(MSG_DEBUG, "RALINK: Failed to set "
+					   "OID_802_11_DROP_UNENCRYPTED(%d)",
+					   (int) encr);
+			}
+		}
+	}
+
+	return wpa_driver_ralink_set_ssid(drv, params->ssid, params->ssid_len);
+}
