+			for (k =3D 0; k < MAX_RATE_SECTION_NUM; ++k)
+				for (m =3D 0; m < CENTER_CH_5G_ALL_NUM; ++m)
+					for (l =3D 0; l < MAX_RF_PATH; ++l)
