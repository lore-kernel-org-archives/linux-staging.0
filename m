+	crc =3D 0xffffffff;       /* preload shift register, per CRC-32 spec */
+
+	for (p =3D buf; len > 0; ++p, --len)
+		crc =3D crc32_table[(crc ^ *p) & 0xff] ^ (crc >> 8);
+	return cpu_to_le32(~crc);    /* transmit complement, per CRC-32 spec */
