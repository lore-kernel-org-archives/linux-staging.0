+static void mlme_event_mgmt(struct wpa_driver_nl80211_data *drv,
+			    struct nlattr *freq, const u8 *frame, size_t len)
+{
+	const struct ieee80211_mgmt *mgmt;
+	union wpa_event_data event;
+	u16 fc, stype;
+
+	mgmt =3D (const struct ieee80211_mgmt *) frame;
+	if (len < 24) {
+		wpa_printf(MSG_DEBUG, "nl80211: Too short action frame");
+		return;
+	}
+
+	fc =3D le_to_host16(mgmt->frame_control);
+	stype =3D WLAN_FC_GET_STYPE(fc);
+
+	os_memset(&event, 0, sizeof(event));
+	if (freq) {
+		event.rx_action.freq =3D nla_get_u32(freq);
+		drv->last_mgmt_freq =3D event.rx_action.freq;
+	}
+	if (stype =3D=3D WLAN_FC_STYPE_ACTION) {
+		event.rx_action.da =3D mgmt->da;
+		event.rx_action.sa =3D mgmt->sa;
+		event.rx_action.bssid =3D mgmt->bssid;
+		event.rx_action.category =3D mgmt->u.action.category;
+		event.rx_action.data =3D &mgmt->u.action.category + 1;
+		event.rx_action.len =3D frame + len - event.rx_action.data;
+		wpa_supplicant_event(drv->ctx, EVENT_RX_ACTION, &event);
+	} else {
+		event.rx_mgmt.frame =3D frame;
+		event.rx_mgmt.frame_len =3D len;
+		wpa_supplicant_event(drv->ctx, EVENT_RX_MGMT, &event);
+	}
+}
