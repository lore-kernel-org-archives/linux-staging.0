+/* Find union about ch, bw, ch_offset of all linked/linking interfaces */
+static int _rtw_mi_get_ch_setting_union(_adapter *adapter, u8 *ch, u8 *bw,=
 u8 *offset, bool include_self)
+{
+	struct dvobj_priv *dvobj =3D adapter_to_dvobj(adapter);
+	_adapter *iface;
+	struct mlme_ext_priv *mlmeext;
+	int i;
+	u8 ch_ret =3D 0;
+	u8 bw_ret =3D CHANNEL_WIDTH_20;
+	u8 offset_ret =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+	int num =3D 0;
+
+	if (ch)
+		*ch =3D 0;
+	if (bw)
+		*bw =3D CHANNEL_WIDTH_20;
+	if (offset)
+		*offset =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+		iface =3D dvobj->padapters[i];
+		mlmeext =3D &iface->mlmeextpriv;
+
+		if (!check_fwstate(&iface->mlmepriv, _FW_LINKED | _FW_UNDER_LINKING))
+			continue;
+
+		if (check_fwstate(&iface->mlmepriv, WIFI_OP_CH_SWITCHING))
+			continue;
+
+		if (include_self =3D=3D false && adapter =3D=3D iface)
+			continue;
+
+		if (num =3D=3D 0) {
+			ch_ret =3D mlmeext->cur_channel;
+			bw_ret =3D mlmeext->cur_bwmode;
+			offset_ret =3D mlmeext->cur_ch_offset;
+			num++;
+			continue;
+		}
+
+		if (ch_ret !=3D mlmeext->cur_channel) {
+			num =3D 0;
+			break;
+		}
+
+		if (bw_ret < mlmeext->cur_bwmode) {
+			bw_ret =3D mlmeext->cur_bwmode;
+			offset_ret =3D mlmeext->cur_ch_offset;
+		} else if (bw_ret =3D=3D mlmeext->cur_bwmode && offset_ret !=3D mlmeext-=
>cur_ch_offset) {
+			num =3D 0;
+			break;
+		}
+
+		num++;
+	}
+
+	if (num) {
+		if (ch)
+			*ch =3D ch_ret;
+		if (bw)
+			*bw =3D bw_ret;
+		if (offset)
+			*offset =3D offset_ret;
+	}
+
+	return num;
+}
