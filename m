er));
+			return -EINVAL;
+		}
+		/* This register sets the Ack time out value after Tx unicast packet. It=
 is in units of us. */
+		rtw_write8(padapter, REG_ACKTO, (u8)ack_timeout_ms);
+
+		RTW_INFO("Set ACK Timeout to %d us.\n", ack_timeout_ms);
+	}
+
+	return count;
+}
