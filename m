+		if (rtw_parse_wpa_ie(wpa_ie - 2, wpa_ie_len + 2, &group_cipher, &pairwis=
e_cipher, NULL) =3D=3D _SUCCESS) {
+			pstat->dot8021xalg =3D 1;/* psk,  todo:802.1x						 */
+			pstat->wpa_psk |=3D BIT(0);
+
+			pstat->wpa_group_cipher =3D group_cipher & psecuritypriv->wpa_group_cip=
her;
