+				if ((pmlmeext->cur_bwmode && (HTOpMode =3D=3D 2 || HTOpMode =3D=3D 3))=
 ||
+				    (!pmlmeext->cur_bwmode && HTOpMode =3D=3D 3)) {
+					pattrib->vcs_mode =3D RTS_CTS;
+					break;
+				}
+			}
+
+			/* check rts */
+			if (sz > padapter->registrypriv.rts_thresh) {
+				pattrib->vcs_mode =3D RTS_CTS;
+				break;
+			}
+
+			/* to do list: check MIMO power save condition. */
+
+			/* check AMPDU aggregation for TXOP */
+			if ((pattrib->ampdu_en)) {
+				pattrib->vcs_mode =3D RTS_CTS;
+				break;
+			}
+
+			pattrib->vcs_mode =3D NONE_VCS;
+			break;
+		}
+	}
+
+	/* for debug : force driver control vrtl_carrier_sense. */
+	if (padapter->driver_vcs_en =3D=3D 1) {
+		/* u8 driver_vcs_en; */ /* Enable=3D1, Disable=3D0 driver control vrtl_c=
arrier_sense. */
+		/* u8 driver_vcs_type; */ /* force 0:disable VCS, 1:RTS-CTS, 2:CTS-to-se=
lf when vcs_en=3D1. */
+		pattrib->vcs_mode =3D padapter->driver_vcs_type;
+	}
+
+}
