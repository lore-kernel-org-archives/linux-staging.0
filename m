+static int eap_fast_init_phase2_method(struct eap_sm *sm,
+				       struct eap_fast_data *data)
+{
+	data->phase2_method =3D
+		eap_peer_get_eap_method(data->phase2_type.vendor,
+					data->phase2_type.method);
+	if (data->phase2_method =3D=3D NULL)
+		return -1;
+
+	if (data->key_block_p) {
+		sm->auth_challenge =3D data->key_block_p->server_challenge;
+		sm->peer_challenge =3D data->key_block_p->client_challenge;
+	}
+	sm->init_phase2 =3D 1;
+	data->phase2_priv =3D data->phase2_method->init(sm);
+	sm->init_phase2 =3D 0;
+	sm->auth_challenge =3D NULL;
+	sm->peer_challenge =3D NULL;
+
+	return data->phase2_priv =3D=3D NULL ? -1 : 0;
+}
