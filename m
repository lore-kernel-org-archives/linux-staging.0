+static int mp_recv_frame(_adapter *padapter, union recv_frame *rframe)
+{
+	int ret =3D _SUCCESS;
+	struct rx_pkt_attrib *pattrib =3D &rframe->u.hdr.attrib;
+	struct recv_priv *precvpriv =3D &padapter->recvpriv;
+	_queue *pfree_recv_queue =3D &padapter->recvpriv.free_recv_queue;
+#ifdef CONFIG_MP_INCLUDED
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+	struct mp_priv *pmppriv =3D &padapter->mppriv;
+#endif /* CONFIG_MP_INCLUDED */
+	u8 type;
+	u8 *ptr =3D rframe->u.hdr.rx_data;
+	u8 *psa, *pda, *pbssid;
+	struct sta_info *psta =3D NULL;
+	DBG_COUNTER(padapter->rx_logs.core_rx_pre);
+
+	if ((check_fwstate(pmlmepriv, _FW_LINKED))) { /* &&(padapter->mppriv.chec=
k_mp_pkt =3D=3D 0)) */
+		if (pattrib->crc_err =3D=3D 1)
+			padapter->mppriv.rx_crcerrpktcount++;
+		else {
+			if (_SUCCESS =3D=3D validate_mp_recv_frame(padapter, rframe))
+				padapter->mppriv.rx_pktcount++;
+			else
+				padapter->mppriv.rx_pktcount_filter_out++;
+		}
+
+		if (pmppriv->rx_bindicatePkt =3D=3D false) {
+			ret =3D _FAIL;
+			rtw_free_recvframe(rframe, pfree_recv_queue);/* free this recv_frame */
+			goto exit;
+		} else {
+			type =3D	GetFrameType(ptr);
+			pattrib->to_fr_ds =3D get_tofr_ds(ptr);
+			pattrib->frag_num =3D GetFragNum(ptr);
+			pattrib->seq_num =3D cpu_to_le16(GetSequence(ptr));
+			pattrib->pw_save =3D GetPwrMgt(ptr);
+			pattrib->mfrag =3D GetMFrag(ptr);
+			pattrib->mdata =3D GetMData(ptr);
+			pattrib->privacy =3D GetPrivacy(ptr);
+			pattrib->order =3D GetOrder(ptr);
+
+			if (type =3D=3D WIFI_DATA_TYPE) {
+				pda =3D get_da(ptr);
+				psa =3D get_sa(ptr);
+				pbssid =3D get_hdr_bssid(ptr);
+
+				memcpy(pattrib->dst, pda, ETH_ALEN);
+				memcpy(pattrib->src, psa, ETH_ALEN);
+				memcpy(pattrib->bssid, pbssid, ETH_ALEN);
+
+				switch (pattrib->to_fr_ds) {
+				case 0:
+					memcpy(pattrib->ra, pda, ETH_ALEN);
+					memcpy(pattrib->ta, psa, ETH_ALEN);
+					ret =3D sta2sta_data_frame(padapter, rframe, &psta);
+					break;
+
+				case 1:
+
+					memcpy(pattrib->ra, pda, ETH_ALEN);
+					memcpy(pattrib->ta, pbssid, ETH_ALEN);
+					ret =3D ap2sta_data_frame(padapter, rframe, &psta);
+
+					break;
+
+				case 2:
+					memcpy(pattrib->ra, pbssid, ETH_ALEN);
+					memcpy(pattrib->ta, psa, ETH_ALEN);
+					ret =3D sta2ap_data_frame(padapter, rframe, &psta);
+					break;
+
+				case 3:
+					memcpy(pattrib->ra, GetAddr1Ptr(ptr), ETH_ALEN);
+					memcpy(pattrib->ta, get_addr2_ptr(ptr), ETH_ALEN);
+					ret =3D _FAIL;
+					break;
+
+				default:
+					ret =3D _FAIL;
+					break;
+				}
+
+				ret =3D MPwlanhdr_to_ethhdr(rframe);
+
+				if (ret !=3D _SUCCESS) {
+#ifdef DBG_RX_DROP_FRAME
+					RTW_INFO("DBG_RX_DROP_FRAME %s wlanhdr_to_ethhdr: drop pkt\n", __func=
__);
+#endif
+					rtw_free_recvframe(rframe, pfree_recv_queue);/* free this recv_frame =
*/
+					ret =3D _FAIL;
+					goto exit;
+				}
+				if (!RTW_CANNOT_RUN(padapter)) {
+					/* indicate this recv_frame */
+					ret =3D rtw_recv_indicatepkt(padapter, rframe);
+					if (ret !=3D _SUCCESS) {
+#ifdef DBG_RX_DROP_FRAME
+						RTW_INFO("DBG_RX_DROP_FRAME %s rtw_recv_indicatepkt fail!\n", __func=
__);
+#endif
+						rtw_free_recvframe(rframe, pfree_recv_queue);/* free this recv_frame=
 */
+						ret =3D _FAIL;
+
+						goto exit;
+					}
