+	L-SIG	Rate	R	Length	P	Tail
+			4b		1b	12b		1b	6b
+=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/
+
+void L_SIG_generator(
+	u32	N_SYM,		/* Max: 750*/
+	PRT_PMAC_TX_INFO	pPMacTxInfo,
+	PRT_PMAC_PKT_INFO	pPMacPktInfo)
+{
+	u8	sig_bi[24] =3D {0};	/* 24 BIT*/
+	u32	mode, LENGTH;
+	int i;
+
+	if (MPT_IS_OFDM_RATE(pPMacTxInfo->TX_RATE)) {
+		mode =3D pPMacPktInfo->MCS;
+		LENGTH =3D pPMacTxInfo->PacketLength;
+	} else {
+		u8	N_LTF;
+		double	T_data;
+		u32	OFDM_symbol;
+
+		mode =3D 0;
+
+		/*	Table 20-13 Num of HT-DLTFs request*/
+		if (pPMacPktInfo->Nsts <=3D 2)
+			N_LTF =3D pPMacPktInfo->Nsts;
+		else
+			N_LTF =3D 4;
+
+		if (pPMacTxInfo->bSGI)
+			T_data =3D 3.6;
+		else
+			T_data =3D 4.0;
+
+		/*(L-SIG, HT-SIG, HT-STF, HT-LTF....HT-LTF, Data)*/
+		if (MPT_IS_VHT_RATE(pPMacTxInfo->TX_RATE))
+			OFDM_symbol =3D (u32)ceil((double)(8 + 4 + N_LTF * 4 + N_SYM * T_data +=
 4) / 4.);
+		else
+			OFDM_symbol =3D (u32)ceil((double)(8 + 4 + N_LTF * 4 + N_SYM * T_data) =
/ 4.);
+
+		RTW_INFO("%s , OFDM_symbol =3D%d\n", __func__, OFDM_symbol);
+		LENGTH =3D OFDM_symbol * 3 - 3;
+		RTW_INFO("%s , LENGTH =3D%d\n", __func__, LENGTH);
+
+	}
+	/*	Rate Field*/
+	switch (mode) {
+	case	0:
+		sig_bi[0] =3D 1;
+		sig_bi[1] =3D 1;
+		sig_bi[2] =3D 0;
+		sig_bi[3] =3D 1;
+		break;
+	case	1:
+		sig_bi[0] =3D 1;
+		sig_bi[1] =3D 1;
+		sig_bi[2] =3D 1;
+		sig_bi[3] =3D 1;
+		break;
+	case	2:
+		sig_bi[0] =3D 0;
+		sig_bi[1] =3D 1;
+		sig_bi[2] =3D 0;
+		sig_bi[3] =3D 1;
+		break;
+	case	3:
+		sig_bi[0] =3D 0;
+		sig_bi[1] =3D 1;
+		sig_bi[2] =3D 1;
+		sig_bi[3] =3D 1;
+		break;
+	case	4:
+		sig_bi[0] =3D 1;
+		sig_bi[1] =3D 0;
+		sig_bi[2] =3D 0;
+		sig_bi[3] =3D 1;
+		break;
+	case	5:
+		sig_bi[0] =3D 1;
+		sig_bi[1] =3D 0;
+		sig_bi[2] =3D 1;
+		sig_bi[3] =3D 1;
+		break;
+	case	6:
+		sig_bi[0] =3D 0;
+		sig_bi[1] =3D 0;
+		sig_bi[2] =3D 0;
+		sig_bi[3] =3D 1;
+		break;
+	case	7:
+		sig_bi[0] =3D 0;
+		sig_bi[1] =3D 0;
+		sig_bi[2] =3D 1;
+		sig_bi[3] =3D 1;
+		break;
+	}
+	/*Reserved bit*/
+	sig_bi[4] =3D 0;
+
+	/*	Length Field*/
+	for (i =3D 0; i < 12; i++)
+		sig_bi[i + 5] =3D (LENGTH >> i) & 1;
+
+	/* Parity Bit*/
+	sig_bi[17] =3D 0;
+	for (i =3D 0; i < 17; i++)
+		sig_bi[17] =3D sig_bi[17] + sig_bi[i];
+
+	sig_bi[17] %=3D 2;
+
+	/*	Tail Field*/
+	for (i =3D 18; i < 24; i++)
+		sig_bi[i] =3D 0;
+
+	/* dump_buf(sig_bi,24);*/
+	memset(pPMacTxInfo->LSIG, 0, 3);
+	ByteToBit(pPMacTxInfo->LSIG, (bool *)sig_bi, 3);
+}
