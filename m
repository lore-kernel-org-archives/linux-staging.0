+		wpa_auth->dot11RSNAPairwiseCipherSelected =3D selector;
+
+		selector =3D WPA_CIPHER_SUITE_TKIP;
+		if (data.group_cipher & WPA_CIPHER_CCMP)
+			selector =3D WPA_CIPHER_SUITE_CCMP;
