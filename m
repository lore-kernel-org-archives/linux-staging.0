+		break;
+	case TYPE_NEW_PASSWORD:
+		field =3D "NEW_PASSWORD";
+		txt =3D "New Password";
+		config->pending_req_new_password++;
+		break;
+	case TYPE_PIN:
+		field =3D "PIN";
+		txt =3D "PIN";
+		config->pending_req_pin++;
+		break;
+	case TYPE_OTP:
+		field =3D "OTP";
+		if (msg) {
+			tmp =3D os_malloc(msglen + 3);
+			if (tmp =3D=3D NULL)
+				return;
+			tmp[0] =3D '[';
+			os_memcpy(tmp + 1, msg, msglen);
+			tmp[msglen + 1] =3D ']';
+			tmp[msglen + 2] =3D '\0';
+			txt =3D tmp;
+			os_free(config->pending_req_otp);
+			config->pending_req_otp =3D tmp;
+			config->pending_req_otp_len =3D msglen + 3;
+		} else {
+			if (config->pending_req_otp =3D=3D NULL)
+				return;
+			txt =3D config->pending_req_otp;
+		}
+		break;
+	case TYPE_PASSPHRASE:
+		field =3D "PASSPHRASE";
+		txt =3D "Private key passphrase";
+		config->pending_req_passphrase++;
+		break;
+	default:
