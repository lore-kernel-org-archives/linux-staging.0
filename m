+u8 rtw_efuse_map_write(PADAPTER padapter, u16 addr, u16 cnts, u8 *data)
+{
+#define RT_ASSERT_RET(expr)												\
+	if (!(expr)) {															\
+		RTW_INFO("Assertion failed! %s at ......\n", #expr);							\
+		RTW_INFO("      ......%s,%s, line=3D%d\n",__FILE__, __func__, __LINE__);=
	\
+		return _FAIL;	\
+	}
+
+	u8	offset, word_en;
+	u8	*map;
+	u8	newdata[PGPKT_DATA_SIZE];
+	s32	i, j, idx, chk_total_byte;
+	u8	ret =3D _SUCCESS;
+	u16	mapLen =3D 0, startAddr =3D 0, efuse_max_available_len =3D 0;
+	u32	backupRegs[4] =3D {0};
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(padapter);
+	PEFUSE_HAL	pEfuseHal =3D &pHalData->EfuseHal;
+
+
+	EFUSE_GetEfuseDefinition(padapter, EFUSE_WIFI, TYPE_EFUSE_MAP_LEN, (void =
*)&mapLen, false);
+	EFUSE_GetEfuseDefinition(padapter, EFUSE_WIFI, TYPE_AVAILABLE_EFUSE_BYTES=
_TOTAL, &efuse_max_available_len, false);
+
+	if ((addr + cnts) > mapLen)
+		return _FAIL;
+
+	RT_ASSERT_RET(PGPKT_DATA_SIZE =3D=3D 8); /* have to be 8 byte alignment */
+	RT_ASSERT_RET((mapLen & 0x7) =3D=3D 0); /* have to be PGPKT_DATA_SIZE ali=
gnment for memcpy */
+
+	map =3D rtw_zmalloc(mapLen);
+	if (map =3D=3D NULL)
+		return _FAIL;
+
+	memset(map, 0xFF, mapLen);
+
+	ret =3D rtw_efuse_map_read(padapter, 0, mapLen, map);
+	if (ret =3D=3D _FAIL)
+		goto exit;
+
+	if (padapter->registrypriv.boffefusemask =3D=3D 0) {
+		for (i =3D 0; i < cnts; i++) {
+			if (padapter->registrypriv.bFileMaskEfuse =3D=3D true) {
+				if (rtw_file_efuse_IsMasked(padapter, addr + i))	/*use file efuse mask=
. */
+					data[i] =3D map[addr + i];
+			} else {
+				if (efuse_IsMasked(padapter, addr + i))
+					data[i] =3D map[addr + i];
+			}
+			RTW_INFO("%s , data[%d] =3D %x, map[addr+i]=3D %x\n", __func__, i, data=
[i], map[addr + i]);
+		}
+	}
+	/*Efuse_PowerSwitch(padapter, true, true);*/
+
+	chk_total_byte =3D 0;
+	idx =3D 0;
+	offset =3D (addr >> 3);
+
+	while (idx < cnts) {
+		word_en =3D 0xF;
+		j =3D (addr + idx) & 0x7;
+		for (i =3D j; i < PGPKT_DATA_SIZE && idx < cnts; i++, idx++) {
+			if (data[idx] !=3D map[addr + idx])
+				word_en &=3D ~BIT(i >> 1);
+		}
+
+		if (word_en !=3D 0xF) {
+			chk_total_byte +=3D Efuse_CalculateWordCnts(word_en) * 2;
+
+			if (offset >=3D EFUSE_MAX_SECTION_BASE) /* Over EFUSE_MAX_SECTION 16 fo=
r 2 ByteHeader */
+				chk_total_byte +=3D 2;
+			else
+				chk_total_byte +=3D 1;
+		}
+
+		offset++;
+	}
+
+	RTW_INFO("Total PG bytes Count =3D %d\n", chk_total_byte);
+	rtw_hal_get_hwreg(padapter, HW_VAR_EFUSE_BYTES, (u8 *)&startAddr);
+
+	if (startAddr =3D=3D 0) {
+		startAddr =3D Efuse_GetCurrentSize(padapter, EFUSE_WIFI, false);
+		RTW_INFO("%s: Efuse_GetCurrentSize startAddr=3D%#X\n", __func__, startAd=
dr);
+	}
+	RTW_DBG("%s: startAddr=3D%#X\n", __func__, startAddr);
+
+	if ((startAddr + chk_total_byte) >=3D efuse_max_available_len) {
+		RTW_INFO("%s: startAddr(0x%X) + PG data len %d >=3D efuse_max_available_=
len(0x%X)\n",
+			 __func__, startAddr, chk_total_byte, efuse_max_available_len);
+		ret =3D _FAIL;
+		goto exit;
+	}
+
+	efuse_PreUpdateAction(padapter, backupRegs);
+
+	idx =3D 0;
+	offset =3D (addr >> 3);
+	while (idx < cnts) {
+		word_en =3D 0xF;
+		j =3D (addr + idx) & 0x7;
+		memcpy(newdata, &map[offset << 3], PGPKT_DATA_SIZE);
+		for (i =3D j; i < PGPKT_DATA_SIZE && idx < cnts; i++, idx++) {
+			if (data[idx] !=3D map[addr + idx]) {
+				word_en &=3D ~BIT(i >> 1);
+				newdata[i] =3D data[idx];
+			}
+		}
+
+		if (word_en !=3D 0xF) {
+			ret =3D Efuse_PgPacketWrite(padapter, offset, word_en, newdata, false);
+			RTW_INFO("offset=3D%x\n", offset);
+			RTW_INFO("word_en=3D%x\n", word_en);
+
+			for (i =3D 0; i < PGPKT_DATA_SIZE; i++)
+				RTW_INFO("data=3D%x \t", newdata[i]);
+			if (ret =3D=3D _FAIL)
+				break;
+		}
+
+		offset++;
+	}
+
+	/*Efuse_PowerSwitch(padapter, true, false);*/
+
+	efuse_PostUpdateAction(padapter, backupRegs);
+
+exit:
+
+	rtw_mfree(map, mapLen);
+
+	return ret;
+}
