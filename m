+int wpa_write_ftie(struct wpa_auth_config *conf, const u8 *r0kh_id,
+		   size_t r0kh_id_len,
+		   const u8 *anonce, const u8 *snonce,
+		   u8 *buf, size_t len, const u8 *subelem,
+		   size_t subelem_len)
+{
+	u8 *pos =3D buf, *ielen;
+	struct rsn_ftie *hdr;
+
+	if (len < 2 + sizeof(*hdr) + 2 + FT_R1KH_ID_LEN + 2 + r0kh_id_len +
+	    subelem_len)
+		return -1;
+
+	*pos++ =3D WLAN_EID_FAST_BSS_TRANSITION;
+	ielen =3D pos++;
+
+	hdr =3D (struct rsn_ftie *) pos;
+	os_memset(hdr, 0, sizeof(*hdr));
+	pos +=3D sizeof(*hdr);
+	WPA_PUT_LE16(hdr->mic_control, 0);
+	if (anonce)
+		os_memcpy(hdr->anonce, anonce, WPA_NONCE_LEN);
+	if (snonce)
+		os_memcpy(hdr->snonce, snonce, WPA_NONCE_LEN);
+
+	/* Optional Parameters */
+	*pos++ =3D FTIE_SUBELEM_R1KH_ID;
+	*pos++ =3D FT_R1KH_ID_LEN;
+	os_memcpy(pos, conf->r1_key_holder, FT_R1KH_ID_LEN);
+	pos +=3D FT_R1KH_ID_LEN;
+
+	if (r0kh_id) {
+		*pos++ =3D FTIE_SUBELEM_R0KH_ID;
+		*pos++ =3D r0kh_id_len;
+		os_memcpy(pos, r0kh_id, r0kh_id_len);
+		pos +=3D r0kh_id_len;
+	}
+
+	if (subelem) {
+		os_memcpy(pos, subelem, subelem_len);
+		pos +=3D subelem_len;
+	}
+
+	*ielen =3D pos - buf - 2;
+
+	return pos - buf;
