+static int bss_info_handler(struct nl_msg *msg, void *arg)
+{
+	struct nlattr *tb[NL80211_ATTR_MAX + 1];
+	struct genlmsghdr *gnlh =3D nlmsg_data(nlmsg_hdr(msg));
+	struct nlattr *bss[NL80211_BSS_MAX + 1];
+	static struct nla_policy bss_policy[NL80211_BSS_MAX + 1] =3D {
+		[NL80211_BSS_BSSID] =3D { .type =3D NLA_UNSPEC },
+		[NL80211_BSS_FREQUENCY] =3D { .type =3D NLA_U32 },
+		[NL80211_BSS_TSF] =3D { .type =3D NLA_U64 },
+		[NL80211_BSS_BEACON_INTERVAL] =3D { .type =3D NLA_U16 },
+		[NL80211_BSS_CAPABILITY] =3D { .type =3D NLA_U16 },
+		[NL80211_BSS_INFORMATION_ELEMENTS] =3D { .type =3D NLA_UNSPEC },
+		[NL80211_BSS_SIGNAL_MBM] =3D { .type =3D NLA_U32 },
+		[NL80211_BSS_SIGNAL_UNSPEC] =3D { .type =3D NLA_U8 },
+		[NL80211_BSS_STATUS] =3D { .type =3D NLA_U32 },
+		[NL80211_BSS_SEEN_MS_AGO] =3D { .type =3D NLA_U32 },
+		[NL80211_BSS_BEACON_IES] =3D { .type =3D NLA_UNSPEC },
+	};
+	struct nl80211_bss_info_arg *_arg =3D arg;
+	struct wpa_scan_results *res =3D _arg->res;
+	struct wpa_scan_res **tmp;
+	struct wpa_scan_res *r;
+	const u8 *ie, *beacon_ie;
+	size_t ie_len, beacon_ie_len;
+	u8 *pos;
+
+	nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
+		  genlmsg_attrlen(gnlh, 0), NULL);
+	if (!tb[NL80211_ATTR_BSS])
+		return NL_SKIP;
+	if (nla_parse_nested(bss, NL80211_BSS_MAX, tb[NL80211_ATTR_BSS],
+			     bss_policy))
+		return NL_SKIP;
+	if (bss[NL80211_BSS_INFORMATION_ELEMENTS]) {
+		ie =3D nla_data(bss[NL80211_BSS_INFORMATION_ELEMENTS]);
+		ie_len =3D nla_len(bss[NL80211_BSS_INFORMATION_ELEMENTS]);
+	} else {
+		ie =3D NULL;
+		ie_len =3D 0;
+	}
+	if (bss[NL80211_BSS_BEACON_IES]) {
+		beacon_ie =3D nla_data(bss[NL80211_BSS_BEACON_IES]);
+		beacon_ie_len =3D nla_len(bss[NL80211_BSS_BEACON_IES]);
+	} else {
+		beacon_ie =3D NULL;
+		beacon_ie_len =3D 0;
+	}
+
+	if (nl80211_scan_filtered(_arg->drv, ie ? ie : beacon_ie,
+				  ie ? ie_len : beacon_ie_len))
+		return NL_SKIP;
+
+	r =3D os_zalloc(sizeof(*r) + ie_len + beacon_ie_len);
+	if (r =3D=3D NULL)
+		return NL_SKIP;
+	if (bss[NL80211_BSS_BSSID])
+		os_memcpy(r->bssid, nla_data(bss[NL80211_BSS_BSSID]),
+			  ETH_ALEN);
+	if (bss[NL80211_BSS_FREQUENCY])
+		r->freq =3D nla_get_u32(bss[NL80211_BSS_FREQUENCY]);
+	if (bss[NL80211_BSS_BEACON_INTERVAL])
+		r->beacon_int =3D nla_get_u16(bss[NL80211_BSS_BEACON_INTERVAL]);
+	if (bss[NL80211_BSS_CAPABILITY])
+		r->caps =3D nla_get_u16(bss[NL80211_BSS_CAPABILITY]);
+	r->flags |=3D WPA_SCAN_NOISE_INVALID;
+	if (bss[NL80211_BSS_SIGNAL_MBM]) {
+		r->level =3D nla_get_u32(bss[NL80211_BSS_SIGNAL_MBM]);
+		r->level /=3D 100; /* mBm to dBm */
+		r->flags |=3D WPA_SCAN_LEVEL_DBM | WPA_SCAN_QUAL_INVALID;
+	} else if (bss[NL80211_BSS_SIGNAL_UNSPEC]) {
+		r->level =3D nla_get_u8(bss[NL80211_BSS_SIGNAL_UNSPEC]);
+		r->flags |=3D WPA_SCAN_LEVEL_INVALID;
+	} else
+		r->flags |=3D WPA_SCAN_LEVEL_INVALID | WPA_SCAN_QUAL_INVALID;
+	if (bss[NL80211_BSS_TSF])
+		r->tsf =3D nla_get_u64(bss[NL80211_BSS_TSF]);
+	if (bss[NL80211_BSS_SEEN_MS_AGO])
+		r->age =3D nla_get_u32(bss[NL80211_BSS_SEEN_MS_AGO]);
+	r->ie_len =3D ie_len;
+	pos =3D (u8 *) (r + 1);
+	if (ie) {
+		os_memcpy(pos, ie, ie_len);
+		pos +=3D ie_len;
+	}
+	r->beacon_ie_len =3D beacon_ie_len;
+	if (beacon_ie)
+		os_memcpy(pos, beacon_ie, beacon_ie_len);
+
+	if (bss[NL80211_BSS_STATUS]) {
+		enum nl80211_bss_status status;
+		status =3D nla_get_u32(bss[NL80211_BSS_STATUS]);
+		switch (status) {
+		case NL80211_BSS_STATUS_AUTHENTICATED:
+			r->flags |=3D WPA_SCAN_AUTHENTICATED;
+			break;
+		case NL80211_BSS_STATUS_ASSOCIATED:
+			r->flags |=3D WPA_SCAN_ASSOCIATED;
+			break;
+		default:
+			break;
+		}
+	}
+
+	tmp =3D os_realloc(res->res,
+			 (res->num + 1) * sizeof(struct wpa_scan_res *));
+	if (tmp =3D=3D NULL) {
+		os_free(r);
+		return NL_SKIP;
+	}
+	tmp[res->num++] =3D r;
+	res->res =3D tmp;
+
+	return NL_SKIP;
+}
