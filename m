+static size_t tls_client_cert_chain_der_len(struct tlsv1_client *conn)
+{
+	size_t len =3D 0;
+	struct x509_certificate *cert;
+
+	if (conn->cred =3D=3D NULL)
+		return 0;
+
+	cert =3D conn->cred->cert;
+	while (cert) {
+		len +=3D 3 + cert->cert_len;
+		if (x509_certificate_self_signed(cert))
+			break;
+		cert =3D x509_certificate_get_subject(conn->cred->trusted_certs,
+						    &cert->issuer);
+	}
+
+	return len;
+}
