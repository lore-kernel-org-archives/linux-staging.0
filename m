+	if (SOUNDING_STATE_SU_START =3D=3D sounding->state) {
+		sounding->state =3D SOUNDING_STATE_SOUNDING_TIMEOUT;
+		RTW_ERR("%s: Set to SU SOUNDING_STATE_SOUNDING_TIMEOUT\n", __func__);
+		/* SU BFee */
