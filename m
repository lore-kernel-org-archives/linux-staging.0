+static u8 rtw_hal_set_wowlan_ctrl_cmd(_adapter *adapter, u8 enable, u8 cha=
nge_unit)
+{
+	struct security_priv *psecpriv =3D &adapter->securitypriv;
+	struct pwrctrl_priv *ppwrpriv =3D adapter_to_pwrctl(adapter);
+	struct hal_ops *pHalFunc =3D &adapter->hal_func;
+
+	u8 u1H2CWoWlanCtrlParm[H2C_WOWLAN_LEN] =3D {0};
+	u8 discont_wake =3D 1, gpionum =3D 0, gpio_dur =3D 0;
+	u8 hw_unicast =3D 0, gpio_pulse_cnt =3D 0, gpio_pulse_en =3D 0;
+	u8 sdio_wakeup_enable =3D 1;
+	u8 gpio_high_active =3D 0;
+	u8 magic_pkt =3D 0;
+	u8 gpio_unit =3D 0; /*0: 64ns, 1: 8ms*/
+	u8 ret =3D _FAIL;
+
+#ifdef CONFIG_GPIO_WAKEUP
+	gpio_high_active =3D ppwrpriv->is_high_active;
+	gpionum =3D WAKEUP_GPIO_IDX;
+	sdio_wakeup_enable =3D 0;
+#endif /* CONFIG_GPIO_WAKEUP */
+
+	if (!ppwrpriv->wowlan_pno_enable)
+		magic_pkt =3D enable;
+
+	if (psecpriv->dot11PrivacyAlgrthm =3D=3D _WEP40_ || psecpriv->dot11Privac=
yAlgrthm =3D=3D _WEP104_)
+		hw_unicast =3D 1;
+	else
+		hw_unicast =3D 0;
+
+	RTW_INFO("%s(): enable=3D%d change_unit=3D%d\n", __func__,
+		 enable, change_unit);
+
+	/* time =3D (gpio_dur/2) * gpio_unit, default:256 ms */
+	if (enable && change_unit) {
+		gpio_dur =3D 0x40;
+		gpio_unit =3D 1;
+		gpio_pulse_en =3D 1;
+	}
+
+#ifdef CONFIG_PLATFORM_ARM_RK3188
+	if (enable) {
+		gpio_pulse_en =3D 1;
+		gpio_pulse_cnt =3D 0x04;
+	}
+#endif
+
+	SET_H2CCMD_WOWLAN_FUNC_ENABLE(u1H2CWoWlanCtrlParm, enable);
+	SET_H2CCMD_WOWLAN_PATTERN_MATCH_ENABLE(u1H2CWoWlanCtrlParm, enable);
+	SET_H2CCMD_WOWLAN_MAGIC_PKT_ENABLE(u1H2CWoWlanCtrlParm, magic_pkt);
+	SET_H2CCMD_WOWLAN_UNICAST_PKT_ENABLE(u1H2CWoWlanCtrlParm, hw_unicast);
+	SET_H2CCMD_WOWLAN_ALL_PKT_DROP(u1H2CWoWlanCtrlParm, 0);
+	SET_H2CCMD_WOWLAN_GPIO_ACTIVE(u1H2CWoWlanCtrlParm, gpio_high_active);
+
+#ifdef CONFIG_GTK_OL
+	/* GTK rekey only for AES, if GTK rekey is TKIP, then wake up*/
+	if (psecpriv->binstallKCK_KEK =3D=3D true)
+		SET_H2CCMD_WOWLAN_REKEY_WAKE_UP(u1H2CWoWlanCtrlParm, 0);
+	else
+		SET_H2CCMD_WOWLAN_REKEY_WAKE_UP(u1H2CWoWlanCtrlParm, 1);
+#else
+	SET_H2CCMD_WOWLAN_REKEY_WAKE_UP(u1H2CWoWlanCtrlParm, enable);
+#endif
+	SET_H2CCMD_WOWLAN_DISCONNECT_WAKE_UP(u1H2CWoWlanCtrlParm, discont_wake);
+	SET_H2CCMD_WOWLAN_GPIONUM(u1H2CWoWlanCtrlParm, gpionum);
+	SET_H2CCMD_WOWLAN_DATAPIN_WAKE_UP(u1H2CWoWlanCtrlParm, sdio_wakeup_enable=
);
+
+	SET_H2CCMD_WOWLAN_GPIO_DURATION(u1H2CWoWlanCtrlParm, gpio_dur);
+	SET_H2CCMD_WOWLAN_CHANGE_UNIT(u1H2CWoWlanCtrlParm, gpio_unit);
+
+	SET_H2CCMD_WOWLAN_GPIO_PULSE_EN(u1H2CWoWlanCtrlParm, gpio_pulse_en);
+	SET_H2CCMD_WOWLAN_GPIO_PULSE_COUNT(u1H2CWoWlanCtrlParm, gpio_pulse_cnt);
+
+	ret =3D rtw_hal_fill_h2c_cmd(adapter,
+				   H2C_WOWLAN,
+				   H2C_WOWLAN_LEN,
+				   u1H2CWoWlanCtrlParm);
+	return ret;
+}
