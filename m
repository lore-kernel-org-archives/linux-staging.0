+static int hostapd_get_aid(struct hostapd_data *hapd, struct sta_info *sta)
+{
+	int i, j =3D 32, aid;
+
+	/* get a unique AID */
+	if (sta->aid > 0) {
+		wpa_printf(MSG_DEBUG, "  old AID %d", sta->aid);
+		return 0;
+	}
+
+	for (i =3D 0; i < AID_WORDS; i++) {
+		if (hapd->sta_aid[i] =3D=3D (u32) -1)
+			continue;
+		for (j =3D 0; j < 32; j++) {
+			if (!(hapd->sta_aid[i] & BIT(j)))
+				break;
+		}
+		if (j < 32)
+			break;
+	}
+	if (j =3D=3D 32)
+		return -1;
+	aid =3D i * 32 + j + 1;
+	if (aid > 2007)
+		return -1;
+
+	sta->aid =3D aid;
+	hapd->sta_aid[i] |=3D BIT(j);
+	wpa_printf(MSG_DEBUG, "  new AID %d", sta->aid);
+	return 0;
+}
