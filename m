+bool
+HAL_IsLegalChannel(
+	PADAPTER	Adapter,
+	u32			Channel
+)
+{
+	bool bLegalChannel =3D true;
+
+	if (Channel > 14) {
+		if (is_supported_5g(Adapter->registrypriv.wireless_mode) =3D=3D false) {
+			bLegalChannel =3D false;
+			RTW_INFO("Channel > 14 but wireless_mode do not support 5G\n");
+		}
+	} else if ((Channel <=3D 14) && (Channel >=3D 1)) {
+		if (IsSupported24G(Adapter->registrypriv.wireless_mode) =3D=3D false) {
+			bLegalChannel =3D false;
+			RTW_INFO("(Channel <=3D 14) && (Channel >=3D1) but wireless_mode do not=
 support 2.4G\n");
+		}
+	} else {
+		bLegalChannel =3D false;
+		RTW_INFO("Channel is Invalid !!!\n");
+	}
+
+	return bLegalChannel;
+}
