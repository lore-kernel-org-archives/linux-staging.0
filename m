+ *   */
+s32 rtl8188e_FirmwareDownload(PADAPTER padapter, bool  bUsedWoWLANFw)
+{
+	s32	rtStatus =3D _SUCCESS;
+	u8 write_fw =3D 0;
+	u32 fwdl_start_time;
+	PHAL_DATA_TYPE	pHalData =3D GET_HAL_DATA(padapter);
+
+	PRT_FIRMWARE_8188E	pFirmware =3D NULL;
+	PRT_8188E_FIRMWARE_HDR		pFwHdr =3D NULL;
+
+	u8			*pFirmwareBuf;
+	u32			FirmwareLen, tmp_fw_len =3D 0;
+#ifdef CONFIG_FILE_FWIMG
+	u8 *fwfilepath;
+#endif /* CONFIG_FILE_FWIMG */
+
+#if defined(CONFIG_WOWLAN) || defined(CONFIG_AP_WOWLAN)
+	struct pwrctrl_priv *pwrpriv =3D adapter_to_pwrctl(padapter);
+#endif
+
+	pFirmware =3D (PRT_FIRMWARE_8188E)rtw_zmalloc(sizeof(RT_FIRMWARE_8188E));
+	if (!pFirmware) {
+		rtStatus =3D _FAIL;
+		goto exit;
+	}
+
+
+
+#ifdef CONFIG_FILE_FWIMG
+#ifdef CONFIG_WOWLAN
+	if (bUsedWoWLANFw)
+		fwfilepath =3D rtw_fw_wow_file_path;
+	else
+#endif /* CONFIG_WOWLAN */
+	{
+		fwfilepath =3D rtw_fw_file_path;
+	}
+#endif /* CONFIG_FILE_FWIMG */
+
+#ifdef CONFIG_FILE_FWIMG
+	if (rtw_is_file_readable(fwfilepath) =3D=3D true) {
+		RTW_INFO("%s accquire FW from file:%s\n", __func__, fwfilepath);
+		pFirmware->eFWSource =3D FW_SOURCE_IMG_FILE;
+	} else
+#endif /* CONFIG_FILE_FWIMG */
+	{
+		pFirmware->eFWSource =3D FW_SOURCE_HEADER_FILE;
+	}
+
+	switch (pFirmware->eFWSource) {
+	case FW_SOURCE_IMG_FILE:
+#ifdef CONFIG_FILE_FWIMG
+		rtStatus =3D rtw_retrieve_from_file(fwfilepath, FwBuffer8188E, FW_8188E_=
SIZE);
+		pFirmware->ulFwLength =3D rtStatus >=3D 0 ? rtStatus : 0;
+		pFirmware->szFwBuffer =3D FwBuffer8188E;
+#endif /* CONFIG_FILE_FWIMG */
+		break;
+	case FW_SOURCE_HEADER_FILE:
+		if (bUsedWoWLANFw) {
+#ifdef CONFIG_WOWLAN
+			if (pwrpriv->wowlan_mode) {
+	#ifdef CONFIG_SFW_SUPPORTED
+				if (IS_VENDOR_8188E_I_CUT_SERIES(padapter)) {
+					pFirmware->szFwBuffer =3D array_mp_8188e_s_fw_wowlan;
+					pFirmware->ulFwLength =3D array_length_mp_8188e_s_fw_wowlan;
+				} else
+	#endif
+				{
+					pFirmware->szFwBuffer =3D array_mp_8188e_t_fw_wowlan;
+					pFirmware->ulFwLength =3D array_length_mp_8188e_t_fw_wowlan;
+				}
+				RTW_INFO("%s fw:%s, size: %d\n", __func__,
+						"WoWLAN", pFirmware->ulFwLength);
+			}
+#endif /*CONFIG_WOWLAN*/
+
+#ifdef CONFIG_AP_WOWLAN
+			if (pwrpriv->wowlan_ap_mode) {
+					pFirmware->szFwBuffer =3D array_mp_8188e_t_fw_ap;
+					pFirmware->ulFwLength =3D array_length_mp_8188e_t_fw_ap;
+
+					RTW_INFO("%s fw: %s, size: %d\n", __func__,
+						"AP_WoWLAN", pFirmware->ulFwLength);
+			}
+#endif /*CONFIG_AP_WOWLAN*/
+		} else {
+#ifdef CONFIG_SFW_SUPPORTED
+			if (IS_VENDOR_8188E_I_CUT_SERIES(padapter)) {
+				pFirmware->szFwBuffer =3D array_mp_8188e_s_fw_nic;
+				pFirmware->ulFwLength =3D array_length_mp_8188e_s_fw_nic;
+			} else
+#endif
+			{
+				pFirmware->szFwBuffer =3D array_mp_8188e_t_fw_nic;
+				pFirmware->ulFwLength =3D array_length_mp_8188e_t_fw_nic;
+			}
+			RTW_INFO("%s fw:%s, size: %d\n", __func__, "NIC", pFirmware->ulFwLength=
);
+		}
+		break;
+	}
+
+	tmp_fw_len =3D IS_VENDOR_8188E_I_CUT_SERIES(padapter) ? FW_8188E_SIZE_2 :=
 FW_8188E_SIZE;
+
+	if ((pFirmware->ulFwLength - 32) > tmp_fw_len) {
+		rtStatus =3D _FAIL;
+		RTW_ERR("Firmware size:%u exceed %u\n", pFirmware->ulFwLength, tmp_fw_le=
n);
+		goto exit;
+	}
+
+	pFirmwareBuf =3D pFirmware->szFwBuffer;
+	FirmwareLen =3D pFirmware->ulFwLength;
+
+	/* To Check Fw header. Added by tynli. 2009.12.04. */
+	pFwHdr =3D (PRT_8188E_FIRMWARE_HDR)pFirmwareBuf;
+
+	pHalData->firmware_version =3D  le16_to_cpu(pFwHdr->Version);
+	pHalData->firmware_sub_version =3D pFwHdr->Subversion;
+	pHalData->FirmwareSignature =3D le16_to_cpu(pFwHdr->Signature);
+
+	RTW_INFO("%s: fw_ver=3D%x fw_subver=3D%04x sig=3D0x%x, Month=3D%02x, Date=
=3D%02x, Hour=3D%02x, Minute=3D%02x\n",
+		__func__, pHalData->firmware_version,
+		pHalData->firmware_sub_version, pHalData->FirmwareSignature,
+		pFwHdr->Month, pFwHdr->Date, pFwHdr->Hour, pFwHdr->Minute);
+
+	if (IS_FW_HEADER_EXIST_88E(pFwHdr)) {
+		/* Shift 32 bytes for FW header */
+		pFirmwareBuf =3D pFirmwareBuf + 32;
+		FirmwareLen =3D FirmwareLen - 32;
+	}
+
+	/* Suggested by Filen. If 8051 is running in RAM code, driver should info=
rm Fw to reset by itself, */
+	/* or it will cause download Fw fail. 2010.02.01. by tynli. */
+	if (rtw_read8(padapter, REG_MCUFWDL) & RAM_DL_SEL) { /* 8051 RAM code */
+		rtw_write8(padapter, REG_MCUFWDL, 0x00);
+		_8051Reset88E(padapter);
+	}
+
+	_FWDownloadEnable_8188E(padapter, true);
+	fwdl_start_time =3D jiffies;
+	while (!RTW_CANNOT_IO(padapter)
+	       && (write_fw++ < 3 || rtw_get_passing_time_ms(fwdl_start_time) < 5=
00)) {
+		/* reset FWDL chksum */
+		rtw_write8(padapter, REG_MCUFWDL, rtw_read8(padapter, REG_MCUFWDL) | FWD=
L_ChkSum_rpt);
+
+		rtStatus =3D _WriteFW(padapter, pFirmwareBuf, FirmwareLen);
+		if (rtStatus !=3D _SUCCESS)
+			continue;
+
+		rtStatus =3D polling_fwdl_chksum(padapter, 5, 50);
+		if (rtStatus =3D=3D _SUCCESS)
+			break;
+	}
+	_FWDownloadEnable_8188E(padapter, false);
+	if (_SUCCESS !=3D rtStatus)
+		goto fwdl_stat;
+
+	rtStatus =3D _FWFreeToGo(padapter, 10, 200);
+	if (_SUCCESS !=3D rtStatus)
+		goto fwdl_stat;
+
+fwdl_stat:
+	RTW_INFO("FWDL %s. write_fw:%u, %dms\n"
+		 , (rtStatus =3D=3D _SUCCESS) ? "success" : "fail"
+		 , write_fw
+		 , rtw_get_passing_time_ms(fwdl_start_time)
+		);
+
+exit:
+	if (pFirmware)
+		rtw_mfree((u8 *)pFirmware, sizeof(RT_FIRMWARE_8188E));
+
+	rtl8188e_InitializeFirmwareVars(padapter);
+
+	return rtStatus;
+}
