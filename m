+						  __BITFIELD_FIELD(u64 D:1,
+								   __BITFIELD_FIELD(u64 L:1,
+								   __BITFIELD_FIELD(u64 U:1,
+								   __BITFIELD_FIELD(u64 addr:32,
+								   ;))))))
