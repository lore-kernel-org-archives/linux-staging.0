+#ifdef CONFIG_WPS_UPNP
+static void wps_registrar_free_pending_m2(struct wps_context *wps)
+{
+	struct upnp_pending_message *p, *p2, *prev =3D NULL;
+	p =3D wps->upnp_msgs;
+	while (p) {
+		if (p->type =3D=3D WPS_M2 || p->type =3D=3D WPS_M2D) {
+			if (prev =3D=3D NULL)
+				wps->upnp_msgs =3D p->next;
+			else
+				prev->next =3D p->next;
+			wpa_printf(MSG_DEBUG, "WPS UPnP: Drop pending M2/M2D");
+			p2 =3D p;
+			p =3D p->next;
+			wpabuf_free(p2->msg);
+			os_free(p2);
+			continue;
+		}
+		prev =3D p;
+		p =3D p->next;
+	}
+}
+#endif /* CONFIG_WPS_UPNP */
