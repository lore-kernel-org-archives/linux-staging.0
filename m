+bool rtw_wowlan_parser_pattern_cmd(u8 *input, char *pattern,
+				   int *pattern_len, char *bit_mask)
+{
+	char *cp =3D NULL, *end =3D NULL;
+	size_t len =3D 0;
+	int pos =3D 0, mask_pos =3D 0, res =3D 0;
+	u8 member[2] =3D {0};
+
+	cp =3D strchr(input, '=3D');
+	if (cp) {
+		*cp =3D 0;
+		cp++;
+		input =3D cp;
+	}
+
+	while (1) {
+		cp =3D strchr(input, ':');
+
+		if (cp) {
+			len =3D strlen(input) - strlen(cp);
+			*cp =3D 0;
+			cp++;
+		} else
+			len =3D 2;
+
+		if (bit_mask && (strcmp(input, "-") =3D=3D 0 ||
+				 strcmp(input, "xx") =3D=3D 0 ||
+				 strcmp(input, "--") =3D=3D 0)) {
+			/* skip this byte and leave mask bit unset */
+		} else {
+			u8 hex;
+
+			strncpy(member, input, len);
+			if (!rtw_check_pattern_valid(member, sizeof(member))) {
+				RTW_INFO("%s:[ERROR] pattern is invalid!!\n",
+					 __func__);
+				goto error;
+			}
+
+			res =3D sscanf(member, "%02hhx", &hex);
+			pattern[pos] =3D hex;
+			mask_pos =3D pos / 8;
+			if (bit_mask)
+				bit_mask[mask_pos] |=3D 1 << (pos % 8);
+		}
+
+		pos++;
+		if (!cp)
+			break;
+		input =3D cp;
+	}
+
+	(*pattern_len) =3D pos;
+
+	return true;
+error:
+	return false;
