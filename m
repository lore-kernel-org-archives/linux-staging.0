+		goto exit;
+
+	/* update attribute */
+	pattrib =3D &pmgntframe->attrib;
+	update_mgntframe_attrib(padapter, pattrib);
+
+	memset(pmgntframe->buf_addr, 0, WLANHDR_OFFSET + TXDESC_OFFSET);
+
+	pframe =3D (u8 *)(pmgntframe->buf_addr) + TXDESC_OFFSET;
+	pwlanhdr =3D (struct rtw_ieee80211_hdr *)pframe;
+
+	fctrl =3D &(pwlanhdr->frame_ctl);
+	*(fctrl) =3D 0;
+
+	/* memcpy(pwlanhdr->addr1, get_my_bssid(&(pmlmeinfo->network)), ETH_ALEN)=
; */
+	memcpy(pwlanhdr->addr1, raddr, ETH_ALEN);
+	memcpy(pwlanhdr->addr2, adapter_mac_addr(padapter), ETH_ALEN);
