+int hostapd_wps_start_oob(struct hostapd_data *hapd, char *device_type,
+			  char *path, char *method, char *name)
+{
+	struct wps_context *wps =3D hapd->wps;
+	struct oob_device_data *oob_dev;
+
+	oob_dev =3D wps_get_oob_device(device_type);
+	if (oob_dev =3D=3D NULL)
+		return -1;
+	oob_dev->device_path =3D path;
+	oob_dev->device_name =3D name;
+	wps->oob_conf.oob_method =3D wps_get_oob_method(method);
+
+	if (wps->oob_conf.oob_method =3D=3D OOB_METHOD_DEV_PWD_R) {
+		/*
+		 * Use pre-configured DH keys in order to be able to write the
+		 * key hash into the OOB file.
+		 */
+		wpabuf_free(wps->dh_pubkey);
+		wpabuf_free(wps->dh_privkey);
+		wps->dh_privkey =3D NULL;
+		wps->dh_pubkey =3D dh_init(dh_groups_get(WPS_DH_GROUP),
+					 &wps->dh_privkey);
+		wps->dh_pubkey =3D wpabuf_zeropad(wps->dh_pubkey, 192);
+		if (wps->dh_pubkey =3D=3D NULL) {
+			wpa_printf(MSG_ERROR, "WPS: Failed to initialize "
+				   "Diffie-Hellman handshake");
+			return -1;
+		}
+	}
+
+	if (wps_process_oob(wps, oob_dev, 1) < 0)
+		goto error;
+
+	if ((wps->oob_conf.oob_method =3D=3D OOB_METHOD_DEV_PWD_E ||
+	     wps->oob_conf.oob_method =3D=3D OOB_METHOD_DEV_PWD_R) &&
+	    hostapd_wps_add_pin(hapd, NULL, "any",
+				wpabuf_head(wps->oob_conf.dev_password), 0) <
+	    0)
+		goto error;
+
+	return 0;
+
+error:
+	wpabuf_free(wps->dh_pubkey);
+	wps->dh_pubkey =3D NULL;
+	wpabuf_free(wps->dh_privkey);
+	wps->dh_privkey =3D NULL;
+	return -1;
+}
