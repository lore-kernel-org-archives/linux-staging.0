+static struct xmit_frame *createloopbackpkt(PADAPTER padapter, u32 size)
+{
+	struct xmit_priv *pxmitpriv;
+	struct xmit_frame *pframe;
+	struct xmit_buf *pxmitbuf;
+	struct pkt_attrib *pattrib;
+	struct tx_desc *desc;
+	u8 *pkt_start, *pkt_end, *ptr;
+	struct rtw_ieee80211_hdr *hdr;
+	s32 bmcast;
+	unsigned long irqL;
+
+
+	if ((TXDESC_SIZE + WLANHDR_OFFSET + size) > MAX_XMITBUF_SZ)
+		return NULL;
+
+	pxmitpriv =3D &padapter->xmitpriv;
+	pframe =3D NULL;
+
+	/* 2 1. allocate xmit frame */
+	pframe =3D rtw_alloc_xmitframe(pxmitpriv);
+	if (pframe =3D=3D NULL)
+		return NULL;
+	pframe->padapter =3D padapter;
+
+	/* 2 2. allocate xmit buffer */
+	_enter_critical_bh(&pxmitpriv->lock, &irqL);
+	pxmitbuf =3D rtw_alloc_xmitbuf(pxmitpriv);
+	_exit_critical_bh(&pxmitpriv->lock, &irqL);
+	if (pxmitbuf =3D=3D NULL) {
+		rtw_free_xmitframe(pxmitpriv, pframe);
+		return NULL;
+	}
+
+	pframe->pxmitbuf =3D pxmitbuf;
+	pframe->buf_addr =3D pxmitbuf->pbuf;
+	pxmitbuf->priv_data =3D pframe;
+
+	/* 2 3. update_attrib() */
+	pattrib =3D &pframe->attrib;
+
+	/* init xmitframe attribute */
+	memset(pattrib, 0, sizeof(struct pkt_attrib));
+
+	pattrib->ether_type =3D 0x8723;
+	memcpy(pattrib->src, adapter_mac_addr(padapter), ETH_ALEN);
+	memcpy(pattrib->ta, pattrib->src, ETH_ALEN);
+	memset(pattrib->dst, 0xFF, ETH_ALEN);
+	memcpy(pattrib->ra, pattrib->dst, ETH_ALEN);
+
+	/*	pattrib->dhcp_pkt =3D 0;
+	 *	pattrib->pktlen =3D 0; */
+	pattrib->ack_policy =3D 0;
+	/*	pattrib->pkt_hdrlen =3D ETH_HLEN; */
+	pattrib->hdrlen =3D WLAN_HDR_A3_LEN;
+	pattrib->subtype =3D WIFI_DATA;
+	pattrib->priority =3D 0;
+	pattrib->qsel =3D pattrib->priority;
+	/*	do_queue_select(padapter, pattrib); */
+	pattrib->nr_frags =3D 1;
+	pattrib->encrypt =3D 0;
+	pattrib->bswenc =3D false;
+	pattrib->qos_en =3D false;
+
+	bmcast =3D IS_MCAST(pattrib->ra);
+	if (bmcast) {
+		pattrib->mac_id =3D 1;
+		pattrib->psta =3D rtw_get_bcmc_stainfo(padapter);
+	} else {
+		pattrib->mac_id =3D 0;
+		pattrib->psta =3D rtw_get_stainfo(&padapter->stapriv, get_bssid(&padapte=
r->mlmepriv));
+	}
+
+	pattrib->pktlen =3D size;
+	pattrib->last_txcmdsz =3D pattrib->hdrlen + pattrib->pktlen;
+
+	/* 2 4. fill TX descriptor */
+	desc =3D (struct tx_desc *)pframe->buf_addr;
+	memset(desc, 0, TXDESC_SIZE);
+
+	fill_default_txdesc(pframe, (u8 *)desc);
+
+	/* Hw set sequence number */
+	((PTXDESC)desc)->hwseq_en =3D 0; /* HWSEQ_EN, 0:disable, 1:enable
+ * ((PTXDESC)desc)->hwseq_sel =3D 0;  */ /* HWSEQ_SEL */
+
+	((PTXDESC)desc)->disdatafb =3D 1;
+
+	/* convert to little endian */
+	desc->txdw0 =3D cpu_to_le32(desc->txdw0);
+	desc->txdw1 =3D cpu_to_le32(desc->txdw1);
+	desc->txdw2 =3D cpu_to_le32(desc->txdw2);
+	desc->txdw3 =3D cpu_to_le32(desc->txdw3);
+	desc->txdw4 =3D cpu_to_le32(desc->txdw4);
+	desc->txdw5 =3D cpu_to_le32(desc->txdw5);
+	desc->txdw6 =3D cpu_to_le32(desc->txdw6);
+	desc->txdw7 =3D cpu_to_le32(desc->txdw7);
+	cal_txdesc_chksum(desc);
+
+	/* 2 5. coalesce */
+	pkt_start =3D pframe->buf_addr + TXDESC_SIZE;
+	pkt_end =3D pkt_start + pattrib->last_txcmdsz;
+
+	/* 3 5.1. make wlan header, make_wlanhdr() */
+	hdr =3D (struct rtw_ieee80211_hdr *)pkt_start;
+	set_frame_sub_type(&hdr->frame_ctl, pattrib->subtype);
+	memcpy(hdr->addr1, pattrib->dst, ETH_ALEN); /* DA */
+	memcpy(hdr->addr2, pattrib->src, ETH_ALEN); /* SA */
+	memcpy(hdr->addr3, get_bssid(&padapter->mlmepriv), ETH_ALEN); /* RA, BSSI=
D */
+
+	/* 3 5.2. make payload */
+	ptr =3D pkt_start + pattrib->hdrlen;
+	get_random_bytes(ptr, pkt_end - ptr);
+
+	pxmitbuf->len =3D TXDESC_SIZE + pattrib->last_txcmdsz;
+	pxmitbuf->ptail +=3D pxmitbuf->len;
+
