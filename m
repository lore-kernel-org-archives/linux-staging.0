+	if (conn->pull_buf =3D=3D NULL)
+		return NULL;
+	os_memcpy(conn->pull_buf, wpabuf_head(in_data), wpabuf_len(in_data));
+	conn->pull_buf_offset =3D conn->pull_buf;
+	conn->pull_buf_len =3D wpabuf_len(in_data);
+
+	/*
+	 * Even though we try to disable TLS compression, it is possible that
+	 * this cannot be done with all TLS libraries. Add extra buffer space
+	 * to handle the possibility of the decrypted data being longer than
+	 * input data.
+	 */
+	out =3D wpabuf_alloc((wpabuf_len(in_data) + 500) * 3);
+	if (out =3D=3D NULL)
