+s32 InitLLTTable(PADAPTER padapter, u8 txpktbuf_bndy)
+{
+	s32	status =3D _FAIL;
+	u32	i;
+	u32	Last_Entry_Of_TxPktBuf =3D LAST_ENTRY_OF_TX_PKT_BUFFER_8188E(padapter=
);/* 176, 22k */
+	HAL_DATA_TYPE *pHalData	=3D GET_HAL_DATA(padapter);
+
+#if defined(CONFIG_IOL_LLT)
+	if (rtw_IOL_applied(padapter))
+		status =3D iol_InitLLTTable(padapter, txpktbuf_bndy);
+	else
+#endif
+	{
+		for (i =3D 0; i < (txpktbuf_bndy - 1); i++) {
+			status =3D _LLTWrite(padapter, i, i + 1);
+			if (_SUCCESS !=3D status)
+				return status;
+		}
+
+		/* end of list */
+		status =3D _LLTWrite(padapter, (txpktbuf_bndy - 1), 0xFF);
+		if (_SUCCESS !=3D status)
+			return status;
+
+		/* Make the other pages as ring buffer */
+		/* This ring buffer is used as beacon buffer if we config this MAC as tw=
o MAC transfer. */
+		/* Otherwise used as local loopback buffer. */
+		for (i =3D txpktbuf_bndy; i < Last_Entry_Of_TxPktBuf; i++) {
+			status =3D _LLTWrite(padapter, i, (i + 1));
+			if (_SUCCESS !=3D status)
+				return status;
+		}
+
+		/* Let last entry point to the start entry of ring buffer */
+		status =3D _LLTWrite(padapter, Last_Entry_Of_TxPktBuf, txpktbuf_bndy);
+		if (_SUCCESS !=3D status)
+			return status;
+	}
+
+	return status;
+}
