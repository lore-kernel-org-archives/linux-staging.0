+
+	conn->fd =3D PR_CreateIOLayerStub(nss_layer_id, &nss_io);
+	if (conn->fd =3D=3D NULL) {
+		os_free(conn);
+		return NULL;
+	}
+	conn->fd->secret =3D (void *) conn;
+
+	conn->fd =3D SSL_ImportFD(NULL, conn->fd);
+	if (conn->fd =3D=3D NULL) {
