+static s32 iol_execute(PADAPTER padapter, u8 control)
+{
+	s32 status =3D _FAIL;
+	u8 reg_0x88 =3D 0, reg_1c7 =3D 0;
+	u32 start =3D 0, passing_time =3D 0;
+
+	u32 t1, t2;
+	control =3D control & 0x0f;
+	reg_0x88 =3D rtw_read8(padapter, REG_HMEBOX_E0);
+	/* RTW_INFO("%s reg_0x88:0x%02x, write 0x%02x\n", __func__, reg_0x88, reg=
_0x88|control); */
+	rtw_write8(padapter, REG_HMEBOX_E0,  reg_0x88 | control);
+
+	t1 =3D start =3D jiffies;
+	while (
+		/* (reg_1c7 =3D rtw_read8(padapter, 0x1c7) >1) && */
+		(reg_0x88 =3D rtw_read8(padapter, REG_HMEBOX_E0)) & control
+		&& (passing_time =3D rtw_get_passing_time_ms(start)) < 1000
+	) {
+		/* RTW_INFO("%s polling reg_0x88:0x%02x,reg_0x1c7:0x%02x\n", __func__, r=
eg_0x88,rtw_read8(padapter, 0x1c7) ); */
+		/* rtw_udelay_os(100); */
+	}
+
+	reg_0x88 =3D rtw_read8(padapter, REG_HMEBOX_E0);
+	status =3D (reg_0x88 & control) ? _FAIL : _SUCCESS;
+	if (reg_0x88 & control << 4)
+		status =3D _FAIL;
+	t2 =3D jiffies;
+
+	return status;
+}
