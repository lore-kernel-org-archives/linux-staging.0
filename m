+static int x509_whitespace(char c)
+{
+	return c =3D=3D ' ' || c =3D=3D '\t';
+}
+
+
+static void x509_str_strip_whitespace(char *a)
+{
+	char *ipos, *opos;
+	int remove_whitespace =3D 1;
+
+	ipos =3D opos =3D a;
+
+	while (*ipos) {
+		if (remove_whitespace && x509_whitespace(*ipos))
+			ipos++;
+		else {
+			remove_whitespace =3D x509_whitespace(*ipos);
+			*opos++ =3D *ipos++;
+		}
+	}
+
+	*opos-- =3D '\0';
+	if (opos > a && x509_whitespace(*opos))
+		*opos =3D '\0';
+}
+
+
+static int x509_str_compare(const char *a, const char *b)
+{
+	char *aa, *bb;
+	int ret;
+
+	if (!a && b)
+		return -1;
+	if (a && !b)
+		return 1;
+	if (!a && !b)
+		return 0;
+
+	aa =3D os_strdup(a);
+	bb =3D os_strdup(b);
+
+	if (aa =3D=3D NULL || bb =3D=3D NULL) {
+		os_free(aa);
+		os_free(bb);
+		return os_strcasecmp(a, b);
+	}
+
+	x509_str_strip_whitespace(aa);
+	x509_str_strip_whitespace(bb);
+
+	ret =3D os_strcasecmp(aa, bb);
+
+	os_free(aa);
+	os_free(bb);
+
+	return ret;
+}
