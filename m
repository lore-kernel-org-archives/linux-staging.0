+static void eap_fast_derive_keys(struct eap_sm *sm, struct eap_fast_data *=
data)
+{
+	if (data->anon_provisioning)
+		eap_fast_derive_key_provisioning(sm, data);
+	else
+		eap_fast_derive_key_auth(sm, data);
+}
