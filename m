+static void handle_data(struct hostap_driver_data *drv, u8 *buf, size_t le=
n,
+			u16 stype)
+{
+	struct ieee80211_hdr *hdr;
+	u16 fc, ethertype;
+	u8 *pos, *sa;
+	size_t left;
+	union wpa_event_data event;
+
+	if (len < sizeof(struct ieee80211_hdr))
+		return;
+
+	hdr =3D (struct ieee80211_hdr *) buf;
+	fc =3D le_to_host16(hdr->frame_control);
+
+	if ((fc & (WLAN_FC_FROMDS | WLAN_FC_TODS)) !=3D WLAN_FC_TODS) {
+		printf("Not ToDS data frame (fc=3D0x%04x)\n", fc);
+		return;
+	}
+
+	sa =3D hdr->addr2;
+	os_memset(&event, 0, sizeof(event));
+	event.rx_from_unknown.frame =3D buf;
+	event.rx_from_unknown.len =3D len;
+	wpa_supplicant_event(drv->hapd, EVENT_RX_FROM_UNKNOWN, &event);
+
+	pos =3D (u8 *) (hdr + 1);
+	left =3D len - sizeof(*hdr);
+
+	if (left < sizeof(rfc1042_header)) {
+		printf("Too short data frame\n");
+		return;
+	}
+
+	if (memcmp(pos, rfc1042_header, sizeof(rfc1042_header)) !=3D 0) {
+		printf("Data frame with no RFC1042 header\n");
+		return;
+	}
+	pos +=3D sizeof(rfc1042_header);
+	left -=3D sizeof(rfc1042_header);
+
+	if (left < 2) {
+		printf("No ethertype in data frame\n");
+		return;
+	}
+
+	ethertype =3D WPA_GET_BE16(pos);
+	pos +=3D 2;
+	left -=3D 2;
+	switch (ethertype) {
+	case ETH_P_PAE:
+		drv_event_eapol_rx(drv->hapd, sa, pos, left);
+		break;
+
+	default:
+		printf("Unknown ethertype 0x%04x in data frame\n", ethertype);
+		break;
+	}
+}
+
+
+static void handle_tx_callback(struct hostap_driver_data *drv, u8 *buf,
+			       size_t len, int ok)
+{
+	struct ieee80211_hdr *hdr;
+	u16 fc;
+	union wpa_event_data event;
+
+	hdr =3D (struct ieee80211_hdr *) buf;
+	fc =3D le_to_host16(hdr->frame_control);
+
+	os_memset(&event, 0, sizeof(event));
+	event.tx_status.type =3D WLAN_FC_GET_TYPE(fc);
+	event.tx_status.stype =3D WLAN_FC_GET_STYPE(fc);
+	event.tx_status.dst =3D hdr->addr1;
+	event.tx_status.data =3D buf;
+	event.tx_status.data_len =3D len;
+	event.tx_status.ack =3D ok;
+	wpa_supplicant_event(drv->hapd, EVENT_TX_STATUS, &event);
+}
+
+
+static void handle_frame(struct hostap_driver_data *drv, u8 *buf, size_t l=
en)
+{
+	struct ieee80211_hdr *hdr;
+	u16 fc, extra_len, type, stype;
+	unsigned char *extra =3D NULL;
+	size_t data_len =3D len;
+	int ver;
+	union wpa_event_data event;
+
+	/* PSPOLL is only 16 bytes, but driver does not (at least yet) pass
+	 * these to user space */
+	if (len < 24) {
+		wpa_printf(MSG_MSGDUMP, "handle_frame: too short (%lu)",
+			   (unsigned long) len);
+		return;
+	}
+
+	hdr =3D (struct ieee80211_hdr *) buf;
+	fc =3D le_to_host16(hdr->frame_control);
+	type =3D WLAN_FC_GET_TYPE(fc);
+	stype =3D WLAN_FC_GET_STYPE(fc);
+
+	if (type !=3D WLAN_FC_TYPE_MGMT || stype !=3D WLAN_FC_STYPE_BEACON) {
+		wpa_hexdump(MSG_MSGDUMP, "Received management frame",
+			    buf, len);
+	}
+
+	ver =3D fc & WLAN_FC_PVER;
+
+	/* protocol version 3 is reserved for indicating extra data after the
+	 * payload, version 2 for indicating ACKed frame (TX callbacks), and
+	 * version 1 for indicating failed frame (no ACK, TX callbacks) */
+	if (ver =3D=3D 3) {
+		u8 *pos =3D buf + len - 2;
+		extra_len =3D WPA_GET_LE16(pos);
+		printf("extra data in frame (elen=3D%d)\n", extra_len);
+		if ((size_t) extra_len + 2 > len) {
+			printf("  extra data overflow\n");
+			return;
+		}
+		len -=3D extra_len + 2;
+		extra =3D buf + len;
+	} else if (ver =3D=3D 1 || ver =3D=3D 2) {
+		handle_tx_callback(drv, buf, data_len, ver =3D=3D 2 ? 1 : 0);
+		return;
+	} else if (ver !=3D 0) {
+		printf("unknown protocol version %d\n", ver);
+		return;
+	}
+
+	switch (type) {
+	case WLAN_FC_TYPE_MGMT:
+		os_memset(&event, 0, sizeof(event));
+		event.rx_mgmt.frame =3D buf;
+		event.rx_mgmt.frame_len =3D data_len;
+		wpa_supplicant_event(drv->hapd, EVENT_RX_MGMT, &event);
+		break;
+	case WLAN_FC_TYPE_CTRL:
+		wpa_printf(MSG_DEBUG, "CTRL");
+		break;
+	case WLAN_FC_TYPE_DATA:
+		wpa_printf(MSG_DEBUG, "DATA");
+		handle_data(drv, buf, data_len, stype);
+		break;
+	default:
+		wpa_printf(MSG_DEBUG, "unknown frame type %d", type);
+		break;
+	}
+}
+
+
+static void handle_read(int sock, void *eloop_ctx, void *sock_ctx)
+{
+	struct hostap_driver_data *drv =3D eloop_ctx;
+	int len;
+	unsigned char buf[3000];
+
+	len =3D recv(sock, buf, sizeof(buf), 0);
+	if (len < 0) {
+		perror("recv");
+		return;
+	}
+
+	handle_frame(drv, buf, len);
