+	.init =3D wpa_driver_ralink_init,
+	.deinit =3D wpa_driver_ralink_deinit,
+	.set_countermeasures	=3D wpa_driver_ralink_set_countermeasures,
+	.scan2 =3D wpa_driver_ralink_scan,
+	.get_scan_results2 =3D wpa_driver_ralink_get_scan_results,
+	.deauthenticate =3D wpa_driver_ralink_deauthenticate,
+	.disassociate =3D wpa_driver_ralink_disassociate,
+	.associate =3D wpa_driver_ralink_associate,
+	.add_pmkid =3D wpa_driver_ralink_add_pmkid,
+	.remove_pmkid =3D wpa_driver_ralink_remove_pmkid,
+	.flush_pmkid =3D wpa_driver_ralink_flush_pmkid,
+};
