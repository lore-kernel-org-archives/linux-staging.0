+			return -1;
+		}
+		if (os_memcmp(own_addr, new_addr, ETH_ALEN) =3D=3D 0) {
+			wpa_printf(MSG_DEBUG, "nl80211: Allocate new address "
+				   "for P2P group interface");
+			if (nl80211_p2p_interface_addr(drv, new_addr) < 0) {
+				nl80211_remove_iface(drv, ifidx);
