+				p_dm_swat_table->ANTB_ON =3D true;
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("odm_single_du=
al_antenna_detection(): Dual Antenna\n"));
+			} else if (((ant_a_report - ant_b_report >=3D TH1) && (ant_a_report - a=
nt_b_report <=3D TH2)) ||
