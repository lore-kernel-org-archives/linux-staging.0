+ * in RFC 2865, Chap. 5.2 */
+struct radius_attr_hdr *
+radius_msg_add_attr_user_password(struct radius_msg *msg,
+				  const u8 *data, size_t data_len,
+				  const u8 *secret, size_t secret_len)
+{
+	u8 buf[128];
+	int padlen, i;
+	size_t buf_len, pos;
+	const u8 *addr[2];
+	size_t len[2];
+	u8 hash[16];
+
+	if (data_len > 128)
+		return NULL;
+
+	os_memcpy(buf, data, data_len);
+	buf_len =3D data_len;
+
+	padlen =3D data_len % 16;
+	if (padlen) {
+		padlen =3D 16 - padlen;
+		os_memset(buf + data_len, 0, padlen);
+		buf_len +=3D padlen;
+	}
+
+	addr[0] =3D secret;
+	len[0] =3D secret_len;
+	addr[1] =3D msg->hdr->authenticator;
+	len[1] =3D 16;
+	md5_vector(2, addr, len, hash);
+
+	for (i =3D 0; i < 16; i++)
+		buf[i] ^=3D hash[i];
+	pos =3D 16;
+
+	while (pos < buf_len) {
+		addr[0] =3D secret;
+		len[0] =3D secret_len;
+		addr[1] =3D &buf[pos - 16];
+		len[1] =3D 16;
+		md5_vector(2, addr, len, hash);
+
+		for (i =3D 0; i < 16; i++)
+			buf[pos + i] ^=3D hash[i];
+
+		pos +=3D 16;
+	}
+
+	return radius_msg_add_attr(msg, RADIUS_ATTR_USER_PASSWORD,
+				   buf, buf_len);
+}
