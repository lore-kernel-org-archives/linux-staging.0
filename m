+static struct hostapd_hw_modes *
+wpa_driver_nl80211_add_11b(struct hostapd_hw_modes *modes, u16 *num_modes)
+{
+	u16 m;
+	struct hostapd_hw_modes *mode11g =3D NULL, *nmodes, *mode;
+	int i, mode11g_idx =3D -1;
+
+	/* If only 802.11g mode is included, use it to construct matching
+	 * 802.11b mode data. */
+
+	for (m =3D 0; m < *num_modes; m++) {
+		if (modes[m].mode =3D=3D HOSTAPD_MODE_IEEE80211B)
+			return modes; /* 802.11b already included */
+		if (modes[m].mode =3D=3D HOSTAPD_MODE_IEEE80211G)
+			mode11g_idx =3D m;
+	}
+
+	if (mode11g_idx < 0)
+		return modes; /* 2.4 GHz band not supported at all */
+
+	nmodes =3D os_realloc(modes, (*num_modes + 1) * sizeof(*nmodes));
+	if (nmodes =3D=3D NULL)
+		return modes; /* Could not add 802.11b mode */
+
+	mode =3D &nmodes[*num_modes];
+	os_memset(mode, 0, sizeof(*mode));
+	(*num_modes)++;
+	modes =3D nmodes;
+
+	mode->mode =3D HOSTAPD_MODE_IEEE80211B;
+
+	mode11g =3D &modes[mode11g_idx];
+	mode->num_channels =3D mode11g->num_channels;
+	mode->channels =3D os_malloc(mode11g->num_channels *
+				   sizeof(struct hostapd_channel_data));
+	if (mode->channels =3D=3D NULL) {
+		(*num_modes)--;
+		return modes; /* Could not add 802.11b mode */
+	}
+	os_memcpy(mode->channels, mode11g->channels,
+		  mode11g->num_channels * sizeof(struct hostapd_channel_data));
+
+	mode->num_rates =3D 0;
+	mode->rates =3D os_malloc(4 * sizeof(int));
+	if (mode->rates =3D=3D NULL) {
+		os_free(mode->channels);
+		(*num_modes)--;
+		return modes; /* Could not add 802.11b mode */
+	}
+
+	for (i =3D 0; i < mode11g->num_rates; i++) {
+		if (mode11g->rates[i] !=3D 10 && mode11g->rates[i] !=3D 20 &&
+		    mode11g->rates[i] !=3D 55 && mode11g->rates[i] !=3D 110)
+			continue;
+		mode->rates[mode->num_rates] =3D mode11g->rates[i];
+		mode->num_rates++;
+		if (mode->num_rates =3D=3D 4)
+			break;
+	}
+
+	if (mode->num_rates =3D=3D 0) {
+		os_free(mode->channels);
+		os_free(mode->rates);
+		(*num_modes)--;
+		return modes; /* No 802.11b rates */
+	}
+
+	wpa_printf(MSG_DEBUG, "nl80211: Added 802.11b mode based on 802.11g "
+		   "information");
+
+	return modes;
+}
