+void GetHwReg8188E(_adapter *adapter, u8 variable, u8 *val)
+{
+	HAL_DATA_TYPE *pHalData =3D GET_HAL_DATA(adapter);
+
+
+	switch (variable) {
+	case HW_VAR_SYS_CLKR:
+		*val =3D rtw_read8(adapter, REG_SYS_CLKR);
+		break;
+
+	case HW_VAR_TXPAUSE:
+		val[0] =3D rtw_read8(adapter, REG_TXPAUSE);
+		break;
+	case HW_VAR_BCN_VALID:
+		/* BCN_VALID, BIT16 of REG_TDECTRL =3D BIT0 of REG_TDECTRL+2 */
+		val[0] =3D (BIT0 & rtw_read8(adapter, REG_TDECTRL + 2)) ? true : false;
+		break;
+	case HW_VAR_FWLPS_RF_ON: {
+		/* When we halt NIC, we should check if FW LPS is leave. */
+		if (adapter_to_pwrctl(adapter)->rf_pwrstate =3D=3D rf_off) {
+			/* If it is in HW/SW Radio OFF or IPS state, we do not check Fw LPS Lea=
ve, */
+			/* because Fw is unload. */
+			val[0] =3D true;
+		} else {
+			u32 valRCR;
+			valRCR =3D rtw_read32(adapter, REG_RCR);
+			valRCR &=3D 0x00070000;
+			if (valRCR)
+				val[0] =3D false;
+			else
+				val[0] =3D true;
+		}
+	}
+	break;
+	case HW_VAR_EFUSE_BYTES: /* To get EFUE total used bytes, added by Roger,=
 2008.12.22. */
+		*((u16 *)(val)) =3D pHalData->EfuseUsedBytes;
+		break;
+	case HW_VAR_CHK_HI_QUEUE_EMPTY:
+		*val =3D ((rtw_read32(adapter, REG_HGQ_INFO) & 0x0000ff00) =3D=3D 0) ? t=
rue : false;
+		break;
+	case HW_VAR_DUMP_MAC_QUEUE_INFO:
+		dump_mac_qinfo_88e(val, adapter);
+		break;
+	default:
+		GetHwReg(adapter, variable, val);
+		break;
+	}
+
+}
