+static int scard_parse_fsp_templ(unsigned char *buf, size_t buf_len,
+				 int *ps_do, int *file_len)
+{
+		unsigned char *pos, *end;
+
+		if (ps_do)
+			*ps_do =3D -1;
+		if (file_len)
+			*file_len =3D -1;
+
+		pos =3D buf;
+		end =3D pos + buf_len;
+		if (*pos !=3D USIM_FSP_TEMPL_TAG) {
+			wpa_printf(MSG_DEBUG, "SCARD: file header did not "
+				   "start with FSP template tag");
+			return -1;
+		}
+		pos++;
+		if (pos >=3D end)
+			return -1;
+		if ((pos + pos[0]) < end)
+			end =3D pos + 1 + pos[0];
+		pos++;
+		wpa_hexdump(MSG_DEBUG, "SCARD: file header FSP template",
+			    pos, end - pos);
+
+		while (pos + 1 < end) {
+			wpa_printf(MSG_MSGDUMP, "SCARD: file header TLV "
+				   "0x%02x len=3D%d", pos[0], pos[1]);
+			if (pos + 2 + pos[1] > end)
+				break;
+
+			if (pos[0] =3D=3D USIM_TLV_FILE_SIZE &&
+			    (pos[1] =3D=3D 1 || pos[1] =3D=3D 2) && file_len) {
+				if (pos[1] =3D=3D 1)
+					*file_len =3D (int) pos[2];
+				else
+					*file_len =3D ((int) pos[2] << 8) |
+						(int) pos[3];
+				wpa_printf(MSG_DEBUG, "SCARD: file_size=3D%d",
+					   *file_len);
+			}
+
+			if (pos[0] =3D=3D USIM_TLV_PIN_STATUS_TEMPLATE &&
+			    pos[1] >=3D 2 && pos[2] =3D=3D USIM_PS_DO_TAG &&
+			    pos[3] >=3D 1 && ps_do) {
+				wpa_printf(MSG_DEBUG, "SCARD: PS_DO=3D0x%02x",
+					   pos[4]);
+				*ps_do =3D (int) pos[4];
+			}
+
+			pos +=3D 2 + pos[1];
+
+			if (pos =3D=3D end)
+				return 0;
+		}
+		return -1;
+}
+
+
+static int scard_pin_needed(struct scard_data *scard,
+			    unsigned char *hdr, size_t hlen)
+{
+	if (scard->sim_type =3D=3D SCARD_GSM_SIM) {
+		if (hlen > SCARD_CHV1_OFFSET &&
+		    !(hdr[SCARD_CHV1_OFFSET] & SCARD_CHV1_FLAG))
+			return 1;
+		return 0;
+	}
+
+	if (scard->sim_type =3D=3D SCARD_USIM) {
+		int ps_do;
+		if (scard_parse_fsp_templ(hdr, hlen, &ps_do, NULL))
+			return -1;
+		/* TODO: there could be more than one PS_DO entry because of
+		 * multiple PINs in key reference.. */
+		if (ps_do > 0 && (ps_do & 0x80))
+			return 1;
+		return 0;
+	}
+
+	return -1;
+}
