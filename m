+static int dev_type_match(const u8 *dev_type, const u8 *req_dev_type)
+{
+	if (os_memcmp(dev_type, req_dev_type, WPS_DEV_TYPE_LEN) =3D=3D 0)
+		return 1;
+	if (os_memcmp(dev_type, req_dev_type, 2) =3D=3D 0 &&
+	    WPA_GET_BE32(&req_dev_type[2]) =3D=3D 0 &&
+	    WPA_GET_BE16(&req_dev_type[6]) =3D=3D 0)
+		return 1; /* Category match with wildcard OUI/sub-category */
+	return 0;
+}
+
+
+int dev_type_list_match(const u8 *dev_type, const u8 *req_dev_type[],
+			size_t num_req_dev_type)
+{
+	size_t i;
+	for (i =3D 0; i < num_req_dev_type; i++) {
+		if (dev_type_match(dev_type, req_dev_type[i]))
+			return 1;
+	}
+	return 0;
+}
