+	     (WPS_CONFIG_PUSHBUTTON | WPS_CONFIG_VIRT_PUSHBUTTON |
+	      WPS_CONFIG_PHY_PUSHBUTTON)) =3D=3D WPS_CONFIG_PUSHBUTTON) {
+		wpa_printf(MSG_INFO, "WPS: Converting push_button to "
+			   "virtual_push_button for WPS 2.0 compliance");
+		wps->config_methods |=3D WPS_CONFIG_VIRT_PUSHBUTTON;
+	}
+#endif /* CONFIG_WPS2 */
+	os_memcpy(wps->dev.pri_dev_type, hapd->conf->device_type,
+		  WPS_DEV_TYPE_LEN);
+
+	if (hostapd_wps_set_vendor_ext(hapd, wps) < 0) {
+		os_free(wps);
+		return -1;
+	}
+
+	wps->dev.os_version =3D WPA_GET_BE32(hapd->conf->os_version);
+	wps->dev.rf_bands =3D hapd->iconf->hw_mode =3D=3D HOSTAPD_MODE_IEEE80211A=
 ?
+		WPS_RF_50GHZ : WPS_RF_24GHZ; /* FIX: dualband AP */
+
+	if (conf->wpa & WPA_PROTO_RSN) {
+		if (conf->wpa_key_mgmt & WPA_KEY_MGMT_PSK)
+			wps->auth_types |=3D WPS_AUTH_WPA2PSK;
+		if (conf->wpa_key_mgmt & WPA_KEY_MGMT_IEEE8021X)
+			wps->auth_types |=3D WPS_AUTH_WPA2;
+
+		if (conf->rsn_pairwise & WPA_CIPHER_CCMP)
+			wps->encr_types |=3D WPS_ENCR_AES;
+		if (conf->rsn_pairwise & WPA_CIPHER_TKIP)
+			wps->encr_types |=3D WPS_ENCR_TKIP;
+	}
+
+	if (conf->wpa & WPA_PROTO_WPA) {
+		if (conf->wpa_key_mgmt & WPA_KEY_MGMT_PSK)
+			wps->auth_types |=3D WPS_AUTH_WPAPSK;
+		if (conf->wpa_key_mgmt & WPA_KEY_MGMT_IEEE8021X)
+			wps->auth_types |=3D WPS_AUTH_WPA;
+
+		if (conf->wpa_pairwise & WPA_CIPHER_CCMP)
+			wps->encr_types |=3D WPS_ENCR_AES;
+		if (conf->wpa_pairwise & WPA_CIPHER_TKIP)
+			wps->encr_types |=3D WPS_ENCR_TKIP;
+	}
+
+	if (conf->ssid.security_policy =3D=3D SECURITY_PLAINTEXT) {
+		wps->encr_types |=3D WPS_ENCR_NONE;
+		wps->auth_types |=3D WPS_AUTH_OPEN;
+	} else if (conf->ssid.security_policy =3D=3D SECURITY_STATIC_WEP) {
+		wps->encr_types |=3D WPS_ENCR_WEP;
+		if (conf->auth_algs & WPA_AUTH_ALG_OPEN)
+			wps->auth_types |=3D WPS_AUTH_OPEN;
+		if (conf->auth_algs & WPA_AUTH_ALG_SHARED)
+			wps->auth_types |=3D WPS_AUTH_SHARED;
+	} else if (conf->ssid.security_policy =3D=3D SECURITY_IEEE_802_1X) {
+		wps->auth_types |=3D WPS_AUTH_OPEN;
+		if (conf->default_wep_key_len)
+			wps->encr_types |=3D WPS_ENCR_WEP;
+		else
+			wps->encr_types |=3D WPS_ENCR_NONE;
+	}
+
+	if (conf->ssid.wpa_psk_file) {
+		/* Use per-device PSKs */
+	} else if (conf->ssid.wpa_passphrase) {
+		wps->network_key =3D (u8 *) os_strdup(conf->ssid.wpa_passphrase);
+		wps->network_key_len =3D os_strlen(conf->ssid.wpa_passphrase);
+	} else if (conf->ssid.wpa_psk) {
+		wps->network_key =3D os_malloc(2 * PMK_LEN + 1);
+		if (wps->network_key =3D=3D NULL) {
+			os_free(wps);
+			return -1;
+		}
+		wpa_snprintf_hex((char *) wps->network_key, 2 * PMK_LEN + 1,
+				 conf->ssid.wpa_psk->psk, PMK_LEN);
+		wps->network_key_len =3D 2 * PMK_LEN;
+	} else if (conf->ssid.wep.keys_set && conf->ssid.wep.key[0]) {
+		wps->network_key =3D os_malloc(conf->ssid.wep.len[0]);
+		if (wps->network_key =3D=3D NULL) {
+			os_free(wps);
+			return -1;
+		}
+		os_memcpy(wps->network_key, conf->ssid.wep.key[0],
+			  conf->ssid.wep.len[0]);
+		wps->network_key_len =3D conf->ssid.wep.len[0];
+	}
+
+	if (conf->ssid.wpa_psk) {
+		os_memcpy(wps->psk, conf->ssid.wpa_psk->psk, PMK_LEN);
+		wps->psk_set =3D 1;
+	}
+
+	if (conf->wps_state =3D=3D WPS_STATE_NOT_CONFIGURED) {
+		/* Override parameters to enable security by default */
+		wps->auth_types =3D WPS_AUTH_WPA2PSK | WPS_AUTH_WPAPSK;
+		wps->encr_types =3D WPS_ENCR_AES | WPS_ENCR_TKIP;
+	}
+
+	wps->ap_settings =3D conf->ap_settings;
+	wps->ap_settings_len =3D conf->ap_settings_len;
+
+	cfg.new_psk_cb =3D hostapd_wps_new_psk_cb;
+	cfg.set_ie_cb =3D hostapd_wps_set_ie_cb;
+	cfg.pin_needed_cb =3D hostapd_wps_pin_needed_cb;
+	cfg.reg_success_cb =3D hostapd_wps_reg_success_cb;
+	cfg.enrollee_seen_cb =3D hostapd_wps_enrollee_seen_cb;
+	cfg.cb_ctx =3D hapd;
+	cfg.skip_cred_build =3D conf->skip_cred_build;
+	cfg.extra_cred =3D conf->extra_cred;
+	cfg.extra_cred_len =3D conf->extra_cred_len;
+	cfg.disable_auto_conf =3D (hapd->conf->wps_cred_processing =3D=3D 1) &&
+		conf->skip_cred_build;
+	if (conf->ssid.security_policy =3D=3D SECURITY_STATIC_WEP)
+		cfg.static_wep_only =3D 1;
+	cfg.dualband =3D interface_count(hapd->iface) > 1;
+	if (cfg.dualband)
+		wpa_printf(MSG_DEBUG, "WPS: Dualband AP");
+
+	wps->registrar =3D wps_registrar_init(wps, &cfg);
+	if (wps->registrar =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "Failed to initialize WPS Registrar");
+		os_free(wps->network_key);
+		os_free(wps);
+		return -1;
+	}
+
+#ifdef CONFIG_WPS_UPNP
+	wps->friendly_name =3D hapd->conf->friendly_name;
+	wps->manufacturer_url =3D hapd->conf->manufacturer_url;
+	wps->model_description =3D hapd->conf->model_description;
+	wps->model_url =3D hapd->conf->model_url;
+	wps->upc =3D hapd->conf->upc;
+
+	if (hostapd_wps_upnp_init(hapd, wps) < 0) {
+		wpa_printf(MSG_ERROR, "Failed to initialize WPS UPnP");
+		wps_registrar_deinit(wps->registrar);
+		os_free(wps->network_key);
+		os_free(wps);
+		return -1;
