+((s) >> 24) & 0xff, ((s) >> 16) & 0xff, ((s) >> 8) & 0xff, (s) & 0xff
+
+int wpa_get_mib(struct wpa_authenticator *wpa_auth, char *buf, size_t bufl=
en)
+{
+	int len =3D 0, ret;
+	char pmkid_txt[PMKID_LEN * 2 + 1];
+#ifdef CONFIG_RSN_PREAUTH
+	const int preauth =3D 1;
+#else /* CONFIG_RSN_PREAUTH */
+	const int preauth =3D 0;
+#endif /* CONFIG_RSN_PREAUTH */
+
+	if (wpa_auth =3D=3D NULL)
+		return len;
+
+	ret =3D os_snprintf(buf + len, buflen - len,
+			  "dot11RSNAOptionImplemented=3DTRUE\n"
+			  "dot11RSNAPreauthenticationImplemented=3D%s\n"
+			  "dot11RSNAEnabled=3D%s\n"
+			  "dot11RSNAPreauthenticationEnabled=3D%s\n",
+			  wpa_bool_txt(preauth),
+			  wpa_bool_txt(wpa_auth->conf.wpa & WPA_PROTO_RSN),
+			  wpa_bool_txt(wpa_auth->conf.rsn_preauth));
+	if (ret < 0 || (size_t) ret >=3D buflen - len)
+		return len;
+	len +=3D ret;
+
+	wpa_snprintf_hex(pmkid_txt, sizeof(pmkid_txt),
+			 wpa_auth->dot11RSNAPMKIDUsed, PMKID_LEN);
+
+	ret =3D os_snprintf(
+		buf + len, buflen - len,
+		"dot11RSNAConfigVersion=3D%u\n"
+		"dot11RSNAConfigPairwiseKeysSupported=3D9999\n"
+		/* FIX: dot11RSNAConfigGroupCipher */
+		/* FIX: dot11RSNAConfigGroupRekeyMethod */
+		/* FIX: dot11RSNAConfigGroupRekeyTime */
+		/* FIX: dot11RSNAConfigGroupRekeyPackets */
+		"dot11RSNAConfigGroupRekeyStrict=3D%u\n"
+		"dot11RSNAConfigGroupUpdateCount=3D%u\n"
+		"dot11RSNAConfigPairwiseUpdateCount=3D%u\n"
