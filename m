+void
+phydm_set_per_path_phy_info(
+	u8							rx_path,
+	s8							rx_pwr,
+	s8							rx_evm,
+	s8							cfo_tail,
+	s8							rx_snr,
+	struct _odm_phy_status_info_				*p_phy_info
+)
+{
+	u8			evm_dbm =3D 0;
+	u8			evm_percentage =3D 0;
+
+	/* SNR is S(8,1), EVM is S(8,1), CFO is S(8,7) */
+
+	if (rx_evm < 0) {
+		/* Calculate EVM in dBm */
+		evm_dbm =3D ((u8)(0 - rx_evm) >> 1);
+
+		/* Calculate EVM in percentage */
+		if (evm_dbm >=3D 33)
+			evm_percentage =3D 100;
+		else
+			evm_percentage =3D (evm_dbm << 1) + (evm_dbm);
+	}
+
+	p_phy_info->rx_pwr[rx_path] =3D rx_pwr;
+	p_phy_info->rx_mimo_evm_dbm[rx_path] =3D evm_dbm;
+
+	/* CFO =3D CFO_tail * 312.5 / 2^7 ~=3D CFO tail * 39/512 (kHz)*/
+	p_phy_info->cfo_tail[rx_path] =3D cfo_tail;
+	p_phy_info->cfo_tail[rx_path] =3D ((p_phy_info->cfo_tail[rx_path] << 5) +=
 (p_phy_info->cfo_tail[rx_path] << 2) +
+		(p_phy_info->cfo_tail[rx_path] << 1) + (p_phy_info->cfo_tail[rx_path])) =
>> 9;
+
+	p_phy_info->rx_mimo_signal_strength[rx_path] =3D odm_query_rx_pwr_percent=
age(rx_pwr);
+	p_phy_info->rx_mimo_signal_quality[rx_path] =3D evm_percentage;
+	p_phy_info->rx_snr[rx_path] =3D rx_snr >> 1;
+}
