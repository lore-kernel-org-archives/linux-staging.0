+		for (j =3D 0; j < pmlmeext->channel_list.reg_classes; j++) {
+			/*	Operating Class */
+			p2pie[p2pielen++] =3D pmlmeext->channel_list.reg_class[j].reg_class;
+
+			/*	Number of Channels */
+			p2pie[p2pielen++] =3D pmlmeext->channel_list.reg_class[j].channels;
+
+			/*	Channel List */
+			for (i =3D 0; i < pmlmeext->channel_list.reg_class[j].channels; i++)
+				p2pie[p2pielen++] =3D pmlmeext->channel_list.reg_class[j].channel[i];
+		}
+	}
+#endif /* CONFIG_CONCURRENT_MODE */
+
+
+	/*	Device Info */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_DEVICE_INFO;
+
+	/*	Length: */
+	/*	21->P2P Device Address (6bytes) + Config Methods (2bytes) + Primary De=
vice Type (8bytes)  */
+	/*	+ NumofSecondDevType (1byte) + WPS Device Name ID field (2bytes) + WPS=
 Device Name Len field (2bytes) */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(21 + pwdinfo->device_name_l=
en);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	/*	P2P Device Address */
+	memcpy(p2pie + p2pielen, adapter_mac_addr(padapter), ETH_ALEN);
+	p2pielen +=3D ETH_ALEN;
+
+	/*	Config Method */
+	/*	This field should be big endian. Noted by P2P specification. */
+
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(pwdinfo->supported_wps_cm);
+
+	p2pielen +=3D 2;
+
+	/*	Primary Device Type */
+	/*	Category ID */
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(WPS_PDT_CID_MULIT_MEDIA);
+	p2pielen +=3D 2;
+
+	/*	OUI */
+	*(__be32 *)(p2pie + p2pielen) =3D cpu_to_be32(WPSOUI);
+	p2pielen +=3D 4;
+
+	/*	Sub Category ID */
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(WPS_PDT_SCID_MEDIA_SERVER);
+	p2pielen +=3D 2;
+
+	/*	Number of Secondary Device Types */
+	p2pie[p2pielen++] =3D 0x00;	/*	No Secondary Device Type List */
+
+	/*	Device Name */
+	/*	Type: */
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(WPS_ATTR_DEVICE_NAME);
+	p2pielen +=3D 2;
+
+	/*	Length: */
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(pwdinfo->device_name_len);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	memcpy(p2pie + p2pielen, pwdinfo->device_name , pwdinfo->device_name_len);
+	p2pielen +=3D pwdinfo->device_name_len;
+
+	if (rtw_p2p_chk_role(pwdinfo, P2P_ROLE_GO)) {
+		/*	Group ID Attribute */
+		/*	Type: */
+		p2pie[p2pielen++] =3D P2P_ATTR_GROUP_ID;
+
+		/*	Length: */
+		*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(ETH_ALEN + pwdinfo->nego_s=
sidlen);
+		p2pielen +=3D 2;
+
+		/*	Value: */
+		/*	p2P Device Address */
+		memcpy(p2pie + p2pielen , pwdinfo->device_addr, ETH_ALEN);
+		p2pielen +=3D ETH_ALEN;
+
+		/*	SSID */
+		memcpy(p2pie + p2pielen, pwdinfo->nego_ssid, pwdinfo->nego_ssidlen);
+		p2pielen +=3D pwdinfo->nego_ssidlen;
+
+	}
+
+	pframe =3D rtw_set_ie(pframe, _VENDOR_SPECIFIC_IE_, p2pielen, (unsigned c=
har *) p2pie, &pattrib->pktlen);
+
+#ifdef CONFIG_WFD
+	wfdielen =3D build_nego_resp_wfd_ie(pwdinfo, pframe);
+	pframe +=3D wfdielen;
+	pattrib->pktlen +=3D wfdielen;
+#endif
+
+	pattrib->last_txcmdsz =3D pattrib->pktlen;
+
+	dump_mgntframe(padapter, pmgntframe);
+
+	return;
+
+}
