+			if (wfd_devinfo) {
+				if (pwdinfo->wfd_info->wfd_device_type =3D=3D WFD_DEVINFO_PSINK) {
+					/*	the first two bits will indicate the WFD device type */
+					if ((wfd_devinfo[1] & 0x03) =3D=3D WFD_DEVINFO_SOURCE) {
+						/*	If this device is Miracast PSink device, the scan reuslt should j=
ust provide the Miracast source. */
+						blnGotWFD =3D true;
+					}
+				} else if (pwdinfo->wfd_info->wfd_device_type =3D=3D WFD_DEVINFO_SOURC=
E) {
+					/*	the first two bits will indicate the WFD device type */
+					if ((wfd_devinfo[1] & 0x03) =3D=3D WFD_DEVINFO_PSINK) {
+						/*	If this device is Miracast source device, the scan reuslt should =
just provide the Miracast PSink. */
+						/*	Todo: How about the SSink?! */
+						blnGotWFD =3D true;
+					}
+				}
+			}
+		}
+
+		if (blnGotWFD =3D=3D false)
+			return false;
+	}
+#endif /* CONFIG_WFD */
+
+#endif /* CONFIG_P2P */
+	return true;
+}
