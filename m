+static void
+wpa_driver_ralink_event_wireless(struct wpa_driver_ralink_data *drv,
+				 void *ctx, char *data, int len)
+{
+	struct iw_event iwe_buf, *iwe =3D &iwe_buf;
+	char *pos, *end, *custom, *buf, *assoc_info_buf, *info_pos;
+#if 0
+	BOOLEAN ieee8021x_required_key =3D FALSE;
+#endif
+
+	wpa_printf(MSG_DEBUG, "%s", __FUNCTION__);
+
+	assoc_info_buf =3D info_pos =3D NULL;
+	pos =3D data;
+	end =3D data + len;
+
+	while (pos + IW_EV_LCP_LEN <=3D end) {
+		/* Event data may be unaligned, so make a local, aligned copy
+		 * before processing. */
+		os_memcpy(&iwe_buf, pos, IW_EV_LCP_LEN);
+		wpa_printf(MSG_DEBUG, "Wireless event: cmd=3D0x%x len=3D%d",
+			   iwe->cmd, iwe->len);
+		if (iwe->len <=3D IW_EV_LCP_LEN)
+			return;
+
+		custom =3D pos + IW_EV_POINT_LEN;
+
+		if (drv->we_version_compiled > 18 && iwe->cmd =3D=3D IWEVCUSTOM) {
+			/* WE-19 removed the pointer from struct iw_point */
+			char *dpos =3D (char *) &iwe_buf.u.data.length;
+			int dlen =3D dpos - (char *) &iwe_buf;
+			os_memcpy(dpos, pos + IW_EV_LCP_LEN,
+				  sizeof(struct iw_event) - dlen);
+		} else {
+			os_memcpy(&iwe_buf, pos, sizeof(struct iw_event));
+			custom +=3D IW_EV_POINT_OFF;
+		}
+
+		switch (iwe->cmd) {
+		case IWEVCUSTOM:
+			if (custom + iwe->u.data.length > end)
+				return;
+			buf =3D os_malloc(iwe->u.data.length + 1);
+			if (buf =3D=3D NULL)
+				return;
+			os_memcpy(buf, custom, iwe->u.data.length);
+			buf[iwe->u.data.length] =3D '\0';
+
+			if (drv->ap_scan =3D=3D 1) {
+				if ((iwe->u.data.flags =3D=3D RT_ASSOC_EVENT_FLAG)
+				    || (iwe->u.data.flags =3D=3D
+					RT_REQIE_EVENT_FLAG) ||
+				    (iwe->u.data.flags =3D=3D RT_RESPIE_EVENT_FLAG)
+				    || (iwe->u.data.flags =3D=3D
+					RT_ASSOCINFO_EVENT_FLAG)) {
+					if (drv->scanning_done =3D=3D 0) {
+						os_free(buf);
+						return;
+					}
+				}
+			}
+
+			if (iwe->u.data.flags =3D=3D RT_ASSOC_EVENT_FLAG) {
+				wpa_supplicant_event(ctx, EVENT_ASSOC, NULL);
+				wpa_printf(MSG_DEBUG, "Custom wireless event: "
+					   "receive ASSOCIATED_EVENT !!!");
+			} else if (iwe->u.data.flags =3D=3D RT_REQIE_EVENT_FLAG) {
+				wpa_printf(MSG_DEBUG, "Custom wireless event: "
+					   "receive ReqIEs !!!");
+				drv->assoc_req_ies =3D
+					os_malloc(iwe->u.data.length);
+				if (drv->assoc_req_ies =3D=3D NULL) {
+					os_free(buf);
+					return;
+				}
+
+				drv->assoc_req_ies_len =3D iwe->u.data.length;
+				os_memcpy(drv->assoc_req_ies, custom,
+					  iwe->u.data.length);
+			} else if (iwe->u.data.flags =3D=3D RT_RESPIE_EVENT_FLAG) {
+				wpa_printf(MSG_DEBUG, "Custom wireless event: "
+					   "receive RespIEs !!!");
+				drv->assoc_resp_ies =3D
+					os_malloc(iwe->u.data.length);
+				if (drv->assoc_resp_ies =3D=3D NULL) {
+					os_free(drv->assoc_req_ies);
+					drv->assoc_req_ies =3D NULL;
+					os_free(buf);
+					return;
+				}
+
+				drv->assoc_resp_ies_len =3D iwe->u.data.length;
+				os_memcpy(drv->assoc_resp_ies, custom,
+					  iwe->u.data.length);
+			} else if (iwe->u.data.flags =3D=3D
+				   RT_ASSOCINFO_EVENT_FLAG) {
+				wpa_printf(MSG_DEBUG, "Custom wireless event: "
+					   "receive ASSOCINFO_EVENT !!!");
+
+				assoc_info_buf =3D
+					os_zalloc(drv->assoc_req_ies_len +
+						  drv->assoc_resp_ies_len + 1);
+
+				if (assoc_info_buf =3D=3D NULL) {
+					os_free(drv->assoc_req_ies);
+					drv->assoc_req_ies =3D NULL;
+					os_free(drv->assoc_resp_ies);
+					drv->assoc_resp_ies =3D NULL;
+					os_free(buf);
+					return;
+				}
+
+				if (drv->assoc_req_ies) {
+					os_memcpy(assoc_info_buf,
+						  drv->assoc_req_ies,
+						  drv->assoc_req_ies_len);
+				}
+				info_pos =3D assoc_info_buf +
+					drv->assoc_req_ies_len;
+				if (drv->assoc_resp_ies) {
+					os_memcpy(info_pos,
+						  drv->assoc_resp_ies,
+						  drv->assoc_resp_ies_len);
+				}
+				assoc_info_buf[drv->assoc_req_ies_len +
+					       drv->assoc_resp_ies_len] =3D '\0';
+				wpa_driver_ralink_event_wireless_custom(
+					drv, ctx, assoc_info_buf);
+				os_free(drv->assoc_req_ies);
+				drv->assoc_req_ies =3D NULL;
+				os_free(drv->assoc_resp_ies);
+				drv->assoc_resp_ies =3D NULL;
+				os_free(assoc_info_buf);
+			} else if (iwe->u.data.flags =3D=3D RT_DISASSOC_EVENT_FLAG)
+			{
+				wpa_printf(MSG_DEBUG, "Custom wireless event: "
+					   "receive DISASSOCIATED_EVENT !!!");
+				wpa_supplicant_event(ctx, EVENT_DISASSOC,
+						     NULL);
+			} else if (iwe->u.data.flags =3D=3D RT_PMKIDCAND_FLAG) {
+				wpa_printf(MSG_DEBUG, "Custom wireless event: "
+					   "receive PMKIDCAND_EVENT !!!");
+				wpa_driver_ralink_event_pmkid(
+					drv, (const u8 *) custom,
+					iwe->u.data.length);
+			} else if (iwe->u.data.flags =3D=3D RT_INTERFACE_DOWN) {
+				drv->g_driver_down =3D 1;
+				eloop_terminate();
+			} else if (iwe->u.data.flags =3D=3D RT_INTERFACE_UP) {
+				ralink_interface_up(drv);
+			} else {
+				wpa_driver_ralink_event_wireless_custom(
+					drv, ctx, buf);
+			}
+			os_free(buf);
+			break;
+		}
+
+		pos +=3D iwe->len;
+	}
+}
