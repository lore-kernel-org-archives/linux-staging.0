+				/* RTW_INFO("%s(): DrvBcnTimeOut =3D %d\n", __func__, DrvBcnTimeOut); =
*/
+			}
+
+			/* reset adaptive_early_32k cnt */
+			pmlmeext->bcn_delay_cnt[i] =3D 0;
+			pmlmeext->bcn_delay_ratio[i] =3D 0;
+		}
+
+		pmlmeext->DrvBcnEarly =3D DrvBcnEarly;
+		pmlmeext->DrvBcnTimeOut =3D DrvBcnTimeOut;
