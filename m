+static int has_channel(RT_CHANNEL_INFO *channel_set,
+		       u8 chanset_size,
+		       u8 chan)
+{
+	int i;
+
+	for (i =3D 0; i < chanset_size; i++) {
+		if (channel_set[i].ChannelNum =3D=3D chan)
+			return 1;
+	}
+
