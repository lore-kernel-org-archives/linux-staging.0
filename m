+int wps_registrar_get_info(struct wps_registrar *reg, const u8 *addr,
+			   char *buf, size_t buflen)
+{
+	struct wps_registrar_device *d;
+	int len =3D 0, ret;
+	char uuid[40];
+	char devtype[WPS_DEV_TYPE_BUFSIZE];
+
+	d =3D wps_device_get(reg, addr);
+	if (d =3D=3D NULL)
+		return 0;
+	if (uuid_bin2str(d->uuid, uuid, sizeof(uuid)))
+		return 0;
+
+	ret =3D os_snprintf(buf + len, buflen - len,
+			  "wpsUuid=3D%s\n"
+			  "wpsPrimaryDeviceType=3D%s\n"
+			  "wpsDeviceName=3D%s\n"
+			  "wpsManufacturer=3D%s\n"
+			  "wpsModelName=3D%s\n"
+			  "wpsModelNumber=3D%s\n"
+			  "wpsSerialNumber=3D%s\n",
+			  uuid,
+			  wps_dev_type_bin2str(d->dev.pri_dev_type, devtype,
+					       sizeof(devtype)),
+			  d->dev.device_name ? d->dev.device_name : "",
+			  d->dev.manufacturer ? d->dev.manufacturer : "",
+			  d->dev.model_name ? d->dev.model_name : "",
+			  d->dev.model_number ? d->dev.model_number : "",
+			  d->dev.serial_number ? d->dev.serial_number : "");
+	if (ret < 0 || (size_t) ret >=3D buflen - len)
+		return len;
+	len +=3D ret;
+
+	return len;
+}
