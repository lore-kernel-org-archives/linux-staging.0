+static int hex2num_i(char c)
+{
+	if (c >=3D '0' && c <=3D '9')
+		return c - '0';
+	if (c >=3D 'a' && c <=3D 'f')
+		return c - 'a' + 10;
+	if (c >=3D 'A' && c <=3D 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+static int hex2byte_i(const char *hex)
+{
+	int a, b;
+	a =3D hex2num_i(*hex++);
+	if (a < 0)
+		return -1;
+	b =3D hex2num_i(*hex++);
+	if (b < 0)
+		return -1;
+	return (a << 4) | b;
+}
