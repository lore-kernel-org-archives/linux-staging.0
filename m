+#ifdef CONFIG_NEW_SIGNAL_STAT_PROCESS
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 15, 0)
+void rtw_signal_stat_timer_hdl(RTW_TIMER_HDL_ARGS)
+#else
+void rtw_signal_stat_timer_hdl(struct timer_list *t)
+#endif
+{
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 15, 0)
+	_adapter *adapter =3D (_adapter *)FunctionContext;
+#else
+	_adapter *adapter =3D from_timer(adapter, t, recvpriv.signal_stat_timer);
+#endif
+	struct recv_priv *recvpriv =3D &adapter->recvpriv;
+
+	u32 tmp_s, tmp_q;
+	u8 avg_signal_strength =3D 0;
+	u8 avg_signal_qual =3D 0;
+	u32 num_signal_strength =3D 0;
+	u32 num_signal_qual =3D 0;
+	u8 ratio_pre_stat =3D 0, ratio_curr_stat =3D 0, ratio_total =3D 0, ratio_=
profile =3D SIGNAL_STAT_CALC_PROFILE_0;
+
+	if (adapter->recvpriv.is_signal_dbg) {
+		/* update the user specific value, signal_strength_dbg, to signal_streng=
th, rssi */
+		adapter->recvpriv.signal_strength =3D adapter->recvpriv.signal_strength_=
dbg;
+		adapter->recvpriv.rssi =3D (s8)translate_percentage_to_dbm((u8)adapter->=
recvpriv.signal_strength_dbg);
+	} else {
+
+		if (recvpriv->signal_strength_data.update_req =3D=3D 0) { /* update_req =
is clear, means we got rx */
+			avg_signal_strength =3D recvpriv->signal_strength_data.avg_val;
+			num_signal_strength =3D recvpriv->signal_strength_data.total_num;
+			/* after avg_vals are accquired, we can re-stat the signal values */
+			recvpriv->signal_strength_data.update_req =3D 1;
+		}
+
+		if (recvpriv->signal_qual_data.update_req =3D=3D 0) { /* update_req is c=
lear, means we got rx */
+			avg_signal_qual =3D recvpriv->signal_qual_data.avg_val;
+			num_signal_qual =3D recvpriv->signal_qual_data.total_num;
+			/* after avg_vals are accquired, we can re-stat the signal values */
+			recvpriv->signal_qual_data.update_req =3D 1;
+		}
+
+		if (num_signal_strength =3D=3D 0) {
+			if (rtw_get_on_cur_ch_time(adapter) =3D=3D 0
+			    || rtw_get_passing_time_ms(rtw_get_on_cur_ch_time(adapter)) < 2 * a=
dapter->mlmeextpriv.mlmext_info.bcn_interval
+			   )
+				goto set_timer;
+		}
+
+		if (check_fwstate(&adapter->mlmepriv, _FW_UNDER_SURVEY)
+		    || check_fwstate(&adapter->mlmepriv, _FW_LINKED) =3D=3D false
+		   )
+			goto set_timer;
+
+#ifdef CONFIG_CONCURRENT_MODE
+		if (rtw_mi_buddy_check_fwstate(adapter, _FW_UNDER_SURVEY))
+			goto set_timer;
+#endif
+
+		if (RTW_SIGNAL_STATE_CALC_PROFILE < SIGNAL_STAT_CALC_PROFILE_MAX)
+			ratio_profile =3D RTW_SIGNAL_STATE_CALC_PROFILE;
+
+		ratio_pre_stat =3D signal_stat_calc_profile[ratio_profile][0];
+		ratio_curr_stat =3D signal_stat_calc_profile[ratio_profile][1];
+		ratio_total =3D ratio_pre_stat + ratio_curr_stat;
+
+		/* update value of signal_strength, rssi, signal_qual */
+		tmp_s =3D (ratio_curr_stat * avg_signal_strength + ratio_pre_stat * recv=
priv->signal_strength);
+		if (tmp_s % ratio_total)
+			tmp_s =3D tmp_s / ratio_total + 1;
+		else
+			tmp_s =3D tmp_s / ratio_total;
+		if (tmp_s > 100)
+			tmp_s =3D 100;
+
+		tmp_q =3D (ratio_curr_stat * avg_signal_qual + ratio_pre_stat * recvpriv=
->signal_qual);
+		if (tmp_q % ratio_total)
+			tmp_q =3D tmp_q / ratio_total + 1;
+		else
+			tmp_q =3D tmp_q / ratio_total;
+		if (tmp_q > 100)
+			tmp_q =3D 100;
+
+		recvpriv->signal_strength =3D tmp_s;
+		recvpriv->rssi =3D (s8)translate_percentage_to_dbm(tmp_s);
+		recvpriv->signal_qual =3D tmp_q;
+
+#if defined(DBG_RX_SIGNAL_DISPLAY_PROCESSING) && 1
+		RTW_INFO(FUNC_ADPT_FMT" signal_strength:%3u, rssi:%3d, signal_qual:%3u"
+			 ", num_signal_strength:%u, num_signal_qual:%u"
+			 ", on_cur_ch_ms:%d"
+			 "\n"
+			 , FUNC_ADPT_ARG(adapter)
+			 , recvpriv->signal_strength
+			 , recvpriv->rssi
+			 , recvpriv->signal_qual
+			 , num_signal_strength, num_signal_qual
+			, rtw_get_on_cur_ch_time(adapter) ? rtw_get_passing_time_ms(rtw_get_on_=
cur_ch_time(adapter)) : 0
+			);
+#endif
+	}
+
+set_timer:
+	rtw_set_signal_stat_timer(recvpriv);
+
+}
