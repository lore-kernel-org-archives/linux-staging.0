+
+static int hostap_sta_set_flags(void *priv, const u8 *addr,
+				int total_flags, int flags_or, int flags_and)
+{
+	struct hostap_driver_data *drv =3D priv;
+	struct prism2_hostapd_param param;
+
+	if (flags_or & WPA_STA_AUTHORIZED)
+		flags_or =3D BIT(5); /* WLAN_STA_AUTHORIZED */
+	if (!(flags_and & WPA_STA_AUTHORIZED))
+		flags_and =3D ~BIT(5);
+	else
+		flags_and =3D ~0;
+	memset(&param, 0, sizeof(param));
+	param.cmd =3D PRISM2_HOSTAPD_SET_FLAGS_STA;
+	memcpy(param.sta_addr, addr, ETH_ALEN);
+	param.u.set_flags_sta.flags_or =3D flags_or;
+	param.u.set_flags_sta.flags_and =3D flags_and;
+	return hostapd_ioctl(drv, &param, sizeof(param));
