+	pattrib =3D &precvframe->u.hdr.attrib;
+	memset(pattrib, 0, sizeof(struct rx_pkt_attrib));
+
+	pattrib->crc_err =3D (u8)((le32_to_cpu(report.rxdw0) >> 14) & 0x1);;/* (u=
