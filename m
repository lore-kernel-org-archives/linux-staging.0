+void rtw_process_public_act_bsscoex(_adapter *padapter, u8 *pframe, uint f=
rame_len)
+{
+	struct sta_info *psta;
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+	u8 beacon_updated =3D false;
+	struct mlme_priv *pmlmepriv =3D &(padapter->mlmepriv);
+	u8 *frame_body =3D pframe + sizeof(struct rtw_ieee80211_hdr_3addr);
+	uint frame_body_len =3D frame_len - sizeof(struct rtw_ieee80211_hdr_3addr=
);
+	u8 category, action;
+
+	psta =3D rtw_get_stainfo(pstapriv, get_addr2_ptr(pframe));
+	if (psta =3D=3D NULL)
+		return;
+
+
+	category =3D frame_body[0];
+	action =3D frame_body[1];
+
+	if (frame_body_len > 0) {
+		if ((frame_body[2] =3D=3D EID_BSSCoexistence) && (frame_body[3] > 0)) {
+			u8 ie_data =3D frame_body[4];
+
+			if (ie_data & RTW_WLAN_20_40_BSS_COEX_40MHZ_INTOL) {
+				if (psta->ht_40mhz_intolerant =3D=3D 0) {
+					psta->ht_40mhz_intolerant =3D 1;
+					pmlmepriv->num_sta_40mhz_intolerant++;
+					beacon_updated =3D true;
+				}
+			} else if (ie_data & RTW_WLAN_20_40_BSS_COEX_20MHZ_WIDTH_REQ)	{
+				if (pmlmepriv->ht_20mhz_width_req =3D=3D false) {
+					pmlmepriv->ht_20mhz_width_req =3D true;
+					beacon_updated =3D true;
+				}
+			} else
+				beacon_updated =3D false;
+		}
+	}
+
+	if (frame_body_len > 8) {
+		/* if EID_BSSIntolerantChlReport ie exists */
