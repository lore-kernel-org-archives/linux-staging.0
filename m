+#ifdef EAP_SERVER
+static int hostapd_config_read_eap_user(const char *fname,
+					struct hostapd_bss_config *conf)
+{
+	FILE *f;
+	char buf[512], *pos, *start, *pos2;
+	int line =3D 0, ret =3D 0, num_methods;
+	struct hostapd_eap_user *user, *tail =3D NULL;
+
+	if (!fname)
+		return 0;
+
+	f =3D fopen(fname, "r");
+	if (!f) {
+		wpa_printf(MSG_ERROR, "EAP user file '%s' not found.", fname);
+		return -1;
+	}
+
+	/* Lines: "user" METHOD,METHOD2 "password" (password optional) */
+	while (fgets(buf, sizeof(buf), f)) {
+		line++;
+
+		if (buf[0] =3D=3D '#')
+			continue;
+		pos =3D buf;
+		while (*pos !=3D '\0') {
+			if (*pos =3D=3D '\n') {
+				*pos =3D '\0';
+				break;
+			}
+			pos++;
+		}
+		if (buf[0] =3D=3D '\0')
+			continue;
+
+		user =3D NULL;
+
+		if (buf[0] !=3D '"' && buf[0] !=3D '*') {
+			wpa_printf(MSG_ERROR, "Invalid EAP identity (no \" in "
+				   "start) on line %d in '%s'", line, fname);
+			goto failed;
+		}
+
+		user =3D os_zalloc(sizeof(*user));
+		if (user =3D=3D NULL) {
+			wpa_printf(MSG_ERROR, "EAP user allocation failed");
+			goto failed;
+		}
+		user->force_version =3D -1;
+
+		if (buf[0] =3D=3D '*') {
+			pos =3D buf;
+		} else {
+			pos =3D buf + 1;
+			start =3D pos;
+			while (*pos !=3D '"' && *pos !=3D '\0')
+				pos++;
+			if (*pos =3D=3D '\0') {
+				wpa_printf(MSG_ERROR, "Invalid EAP identity "
+					   "(no \" in end) on line %d in '%s'",
+					   line, fname);
+				goto failed;
+			}
+
+			user->identity =3D os_malloc(pos - start);
+			if (user->identity =3D=3D NULL) {
+				wpa_printf(MSG_ERROR, "Failed to allocate "
+					   "memory for EAP identity");
+				goto failed;
+			}
+			os_memcpy(user->identity, start, pos - start);
+			user->identity_len =3D pos - start;
+
+			if (pos[0] =3D=3D '"' && pos[1] =3D=3D '*') {
+				user->wildcard_prefix =3D 1;
+				pos++;
+			}
+		}
+		pos++;
+		while (*pos =3D=3D ' ' || *pos =3D=3D '\t')
+			pos++;
+
+		if (*pos =3D=3D '\0') {
+			wpa_printf(MSG_ERROR, "No EAP method on line %d in "
+				   "'%s'", line, fname);
+			goto failed;
+		}
+
+		start =3D pos;
+		while (*pos !=3D ' ' && *pos !=3D '\t' && *pos !=3D '\0')
+			pos++;
+		if (*pos =3D=3D '\0') {
+			pos =3D NULL;
+		} else {
+			*pos =3D '\0';
+			pos++;
+		}
+		num_methods =3D 0;
+		while (*start) {
+			char *pos3 =3D os_strchr(start, ',');
+			if (pos3) {
+				*pos3++ =3D '\0';
+			}
+			user->methods[num_methods].method =3D
+				eap_server_get_type(
+					start,
+					&user->methods[num_methods].vendor);
+			if (user->methods[num_methods].vendor =3D=3D
+			    EAP_VENDOR_IETF &&
+			    user->methods[num_methods].method =3D=3D EAP_TYPE_NONE)
+			{
+				if (os_strcmp(start, "TTLS-PAP") =3D=3D 0) {
+					user->ttls_auth |=3D EAP_TTLS_AUTH_PAP;
+					goto skip_eap;
+				}
+				if (os_strcmp(start, "TTLS-CHAP") =3D=3D 0) {
+					user->ttls_auth |=3D EAP_TTLS_AUTH_CHAP;
+					goto skip_eap;
+				}
+				if (os_strcmp(start, "TTLS-MSCHAP") =3D=3D 0) {
+					user->ttls_auth |=3D
+						EAP_TTLS_AUTH_MSCHAP;
+					goto skip_eap;
+				}
+				if (os_strcmp(start, "TTLS-MSCHAPV2") =3D=3D 0) {
+					user->ttls_auth |=3D
+						EAP_TTLS_AUTH_MSCHAPV2;
+					goto skip_eap;
+				}
+				wpa_printf(MSG_ERROR, "Unsupported EAP type "
+					   "'%s' on line %d in '%s'",
+					   start, line, fname);
+				goto failed;
+			}
+
+			num_methods++;
+			if (num_methods >=3D EAP_USER_MAX_METHODS)
+				break;
+		skip_eap:
+			if (pos3 =3D=3D NULL)
+				break;
+			start =3D pos3;
+		}
+		if (num_methods =3D=3D 0 && user->ttls_auth =3D=3D 0) {
+			wpa_printf(MSG_ERROR, "No EAP types configured on "
+				   "line %d in '%s'", line, fname);
+			goto failed;
+		}
+
+		if (pos =3D=3D NULL)
+			goto done;
+
+		while (*pos =3D=3D ' ' || *pos =3D=3D '\t')
+			pos++;
+		if (*pos =3D=3D '\0')
+			goto done;
+
+		if (os_strncmp(pos, "[ver=3D0]", 7) =3D=3D 0) {
+			user->force_version =3D 0;
+			goto done;
+		}
+
+		if (os_strncmp(pos, "[ver=3D1]", 7) =3D=3D 0) {
+			user->force_version =3D 1;
+			goto done;
+		}
+
+		if (os_strncmp(pos, "[2]", 3) =3D=3D 0) {
+			user->phase2 =3D 1;
+			goto done;
+		}
+
+		if (*pos =3D=3D '"') {
+			pos++;
+			start =3D pos;
+			while (*pos !=3D '"' && *pos !=3D '\0')
+				pos++;
+			if (*pos =3D=3D '\0') {
+				wpa_printf(MSG_ERROR, "Invalid EAP password "
+					   "(no \" in end) on line %d in '%s'",
+					   line, fname);
+				goto failed;
+			}
+
+			user->password =3D os_malloc(pos - start);
+			if (user->password =3D=3D NULL) {
+				wpa_printf(MSG_ERROR, "Failed to allocate "
+					   "memory for EAP password");
+				goto failed;
+			}
+			os_memcpy(user->password, start, pos - start);
+			user->password_len =3D pos - start;
+
+			pos++;
+		} else if (os_strncmp(pos, "hash:", 5) =3D=3D 0) {
+			pos +=3D 5;
+			pos2 =3D pos;
+			while (*pos2 !=3D '\0' && *pos2 !=3D ' ' &&
+			       *pos2 !=3D '\t' && *pos2 !=3D '#')
+				pos2++;
+			if (pos2 - pos !=3D 32) {
+				wpa_printf(MSG_ERROR, "Invalid password hash "
+					   "on line %d in '%s'", line, fname);
+				goto failed;
+			}
+			user->password =3D os_malloc(16);
+			if (user->password =3D=3D NULL) {
+				wpa_printf(MSG_ERROR, "Failed to allocate "
+					   "memory for EAP password hash");
+				goto failed;
+			}
+			if (hexstr2bin(pos, user->password, 16) < 0) {
+				wpa_printf(MSG_ERROR, "Invalid hash password "
+					   "on line %d in '%s'", line, fname);
+				goto failed;
+			}
+			user->password_len =3D 16;
+			user->password_hash =3D 1;
+			pos =3D pos2;
+		} else {
+			pos2 =3D pos;
+			while (*pos2 !=3D '\0' && *pos2 !=3D ' ' &&
+			       *pos2 !=3D '\t' && *pos2 !=3D '#')
+				pos2++;
+			if ((pos2 - pos) & 1) {
+				wpa_printf(MSG_ERROR, "Invalid hex password "
+					   "on line %d in '%s'", line, fname);
+				goto failed;
+			}
+			user->password =3D os_malloc((pos2 - pos) / 2);
+			if (user->password =3D=3D NULL) {
+				wpa_printf(MSG_ERROR, "Failed to allocate "
+					   "memory for EAP password");
+				goto failed;
+			}
+			if (hexstr2bin(pos, user->password,
+				       (pos2 - pos) / 2) < 0) {
+				wpa_printf(MSG_ERROR, "Invalid hex password "
+					   "on line %d in '%s'", line, fname);
+				goto failed;
+			}
+			user->password_len =3D (pos2 - pos) / 2;
+			pos =3D pos2;
+		}
+
+		while (*pos =3D=3D ' ' || *pos =3D=3D '\t')
+			pos++;
+		if (os_strncmp(pos, "[2]", 3) =3D=3D 0) {
+			user->phase2 =3D 1;
+		}
+
+	done:
+		if (tail =3D=3D NULL) {
+			tail =3D conf->eap_user =3D user;
+		} else {
+			tail->next =3D user;
+			tail =3D user;
+		}
+		continue;
+
+	failed:
+		if (user) {
+			os_free(user->password);
+			os_free(user->identity);
+			os_free(user);
+		}
+		ret =3D -1;
+		break;
+	}
+
+	fclose(f);
+
+	return ret;
+}
