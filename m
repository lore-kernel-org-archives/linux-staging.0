+static void rtw_cfg80211_init_ht_capab_ex(_adapter *padapter, struct ieee8=
0211_sta_ht_cap *ht_cap, enum nl80211_band band, u8 rf_type)
+{
+	struct registry_priv *pregistrypriv =3D &padapter->registrypriv;
+	struct mlme_priv	*pmlmepriv =3D &padapter->mlmepriv;
+	struct ht_priv		*phtpriv =3D &pmlmepriv->htpriv;
+	u8 stbc_rx_enable =3D false;
+
+	rtw_ht_use_default_setting(padapter);
+
+	/* RX LDPC */
+	if (TEST_FLAG(phtpriv->ldpc_cap, LDPC_HT_ENABLE_RX))
+		ht_cap->cap |=3D IEEE80211_HT_CAP_LDPC_CODING;
+
+	/* TX STBC */
+	if (TEST_FLAG(phtpriv->stbc_cap, STBC_HT_ENABLE_TX))
+		ht_cap->cap |=3D IEEE80211_HT_CAP_TX_STBC;
+
+	/* RX STBC */
+	if (TEST_FLAG(phtpriv->stbc_cap, STBC_HT_ENABLE_RX)) {
+		/*rtw_rx_stbc 0: disable, bit(0):enable 2.4g, bit(1):enable 5g*/
+		if (band =3D=3D NL80211_BAND_2GHZ)
+			stbc_rx_enable =3D (pregistrypriv->rx_stbc & BIT(0)) ? true : false;
+		if (band =3D=3D NL80211_BAND_5GHZ)
+			stbc_rx_enable =3D (pregistrypriv->rx_stbc & BIT(1)) ? true : false;
+
+		if (stbc_rx_enable) {
+			switch (rf_type) {
+			case RF_1T1R:
+				ht_cap->cap |=3D IEEE80211_HT_CAP_RX_STBC_1R;/*RX STBC One spatial str=
eam*/
+				break;
+
+			case RF_2T2R:
+			case RF_1T2R:
+				ht_cap->cap |=3D IEEE80211_HT_CAP_RX_STBC_1R;/* Only one spatial-strea=
m STBC RX is supported */
+				break;
+			case RF_3T3R:
+			case RF_3T4R:
+			case RF_4T4R:
+				ht_cap->cap |=3D IEEE80211_HT_CAP_RX_STBC_1R;/* Only one spatial-strea=
m STBC RX is supported */
+				break;
+			default:
+				RTW_INFO("[warning] rf_type %d is not expected\n", rf_type);
+				break;
+			}
+		}
+	}
+}
