+	parm->ec_id =3D CUSTOMER_STR_WK_CID;
+	parm->type =3D write;
+	parm->size =3D write ? RTW_CUSTOMER_STR_LEN : 0;
+	parm->pbuf =3D write ? str : NULL;
+
+	if (write)
+		memcpy(str, cstr, RTW_CUSTOMER_STR_LEN);
+
+	/* need enqueue, prepare cmd_obj and enqueue */
+	cmdobj =3D (struct cmd_obj *)rtw_zmalloc(sizeof(*cmdobj));
+	if (cmdobj =3D=3D NULL) {
+		res =3D _FAIL;
+		rtw_mfree((u8 *)parm, sizeof(*parm));
+		if (write)
+			rtw_mfree(str, RTW_CUSTOMER_STR_LEN);
+		goto exit;
+	}
+
+	init_h2fwcmd_w_parm_no_rsp(cmdobj, parm, GEN_CMD_CODE(_Set_Drv_Extra));
+
+	cmdobj->sctx =3D &sctx;
+	rtw_sctx_init(&sctx, 2 * 1000);
+
+	res =3D rtw_enqueue_cmd(pcmdpriv, cmdobj);
+
+	if (res =3D=3D _SUCCESS) {
+		rtw_sctx_wait(&sctx, __func__);
+		_enter_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+		if (sctx.status =3D=3D RTW_SCTX_SUBMITTED)
+			cmdobj->sctx =3D NULL;
+		_exit_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+		if (sctx.status !=3D RTW_SCTX_DONE_SUCCESS)
+			res =3D _FAIL;
+	}
+
+exit:
+	return res;
+}
