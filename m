+static int rtw_mp_customer_str(
+	struct net_device *dev,
+	struct iw_request_info *info,
+	union iwreq_data *wrqu, char *extra)
+{
+	_adapter *adapter =3D rtw_netdev_priv(dev);
+	u32 len;
+	u8 *pbuf =3D NULL, *pch;
+	char *ptmp;
+	u8 param[RTW_CUSTOMER_STR_LEN];
+	u8 count =3D 0;
+	u8 tmp;
+	u8 i;
+	u32 pos;
+	u8 ret;
+	u8 read =3D 0;
+
+	if (adapter->registrypriv.mp_mode !=3D 1
+		|| !adapter->registrypriv.mp_customer_str)
+		return -EFAULT;
+
+	len =3D wrqu->data.length;
+
+	pbuf =3D (u8 *)rtw_zmalloc(len);
+	if (pbuf =3D=3D NULL) {
+		RTW_WARN("%s: no memory!\n", __func__);
+		return -ENOMEM;
+	}
+
+	if (copy_from_user(pbuf, wrqu->data.pointer, len)) {
+		rtw_mfree(pbuf, len);
+		RTW_WARN("%s: copy from user fail!\n", __func__);
+		return -EFAULT;
+	}
+	RTW_INFO("%s: string=3D\"%s\"\n", __func__, pbuf);
+
+	ptmp =3D (char *)pbuf;
+	pch =3D strsep(&ptmp, ",");
+	if ((pch =3D=3D NULL) || (strlen(pch) =3D=3D 0)) {
+		rtw_mfree(pbuf, len);
+		RTW_INFO("%s: parameter error(no cmd)!\n", __func__);
+		return -EFAULT;
