+	PNDIS_802_11_VARIABLE_IEs	pIE;
+	u8 FIXED_IE =3D 4;
+	u16 j;
+	struct mlme_ext_priv *pmlmeext =3D &padapter->mlmeextpriv;
+	struct tdls_txmgmt txmgmt;
+	u8 zaddr[ETH_ALEN] =3D {0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+	u16 switch_time =3D TDLS_CH_SWITCH_TIME * 1000, switch_timeout =3D TDLS_C=
H_SWITCH_TIMEOUT * 1000;
+	u8 take_care_iqk;
+
+	if (rtw_tdls_is_chsw_allowed(padapter) =3D=3D false) {
