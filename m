+/* VALID_PN_CHK
+ * Return true when PN is legal, otherwise false.
+ * Legal PN:
+ *	1. If old PN is 0, any PN is legal
+ *	2. PN > old PN
+ */
+#define PN_LESS_CHK(a, b)	(((a-b) & 0x800000000000L) !=3D 0)
+#define VALID_PN_CHK(new, old)	(((old) =3D=3D 0) || PN_LESS_CHK(old, new))
+#define CCMPH_2_KEYID(ch)	(((ch) & 0x00000000c0000000L) >> 30)
+#define CCMPH_2_PN(ch)	((ch) & 0x000000000000ffffL) \
+				| (((ch) & 0xffffffff00000000L) >> 16)
+sint recv_ucast_pn_decache(union recv_frame *precv_frame, struct stainfo_r=
xcache *prxcache);
+sint recv_ucast_pn_decache(union recv_frame *precv_frame, struct stainfo_r=
xcache *prxcache)
+{
+	_adapter *padapter =3D precv_frame->u.hdr.adapter;
+	struct rx_pkt_attrib *pattrib =3D &precv_frame->u.hdr.attrib;
+	u8 *pdata =3D precv_frame->u.hdr.rx_data;
+	u32 data_len =3D precv_frame->u.hdr.len;
+	sint tid =3D precv_frame->u.hdr.attrib.priority;
+	u64 tmp_iv_hdr =3D 0;
+	u64 curr_pn =3D 0, pkt_pn =3D 0;
+
+	if (tid > 15)
+		return _FAIL;
+
+	if (pattrib->encrypt =3D=3D _AES_) {
+		tmp_iv_hdr =3D le64_to_cpu(*(__le64*)(pdata + pattrib->hdrlen));
+		pkt_pn =3D CCMPH_2_PN(tmp_iv_hdr);
+=09
+		tmp_iv_hdr =3D le64_to_cpu(*(__le64*)prxcache->iv[tid]);
+		curr_pn =3D CCMPH_2_PN(tmp_iv_hdr);=09
+
+		if (!VALID_PN_CHK(pkt_pn, curr_pn)) {
+			/* return _FAIL; */
+		} else
+			memcpy(prxcache->iv[tid], (pdata + pattrib->hdrlen), sizeof(prxcache->i=
v[tid]));
+	}
+
+	return _SUCCESS;
+}
