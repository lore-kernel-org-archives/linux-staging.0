+static u8
+phydm_trans_platform_rf_type(
+	void		*p_dm_void,
+	u8		rf_type
+)
+{
+	if (rf_type =3D=3D RF_1T2R)
+		rf_type =3D PHYDM_RF_1T2R;
+
+	else if (rf_type =3D=3D RF_2T4R)
+		rf_type =3D PHYDM_RF_2T4R;
+
+	else if (rf_type =3D=3D RF_2T2R)
+		rf_type =3D PHYDM_RF_2T2R;
+
+	else if (rf_type =3D=3D RF_1T1R)
+		rf_type =3D PHYDM_RF_1T1R;
+
+	else if (rf_type =3D=3D RF_2T2R_GREEN)
+		rf_type =3D PHYDM_RF_2T2R_GREEN;
+
+	else if (rf_type =3D=3D RF_3T3R)
+		rf_type =3D PHYDM_RF_3T3R;
+
+	else if (rf_type =3D=3D RF_4T4R)
+		rf_type =3D PHYDM_RF_4T4R;
+
+	else if (rf_type =3D=3D RF_2T3R)
+		rf_type =3D PHYDM_RF_1T2R;
+
+	else if (rf_type =3D=3D RF_3T4R)
+		rf_type =3D PHYDM_RF_3T4R;
+
+	return rf_type;
+}
