+static int nl80211_send_ft_action(void *priv, u8 action, const u8 *target_=
ap,
+				  const u8 *ies, size_t ies_len)
+{
+	struct i802_bss *bss =3D priv;
+	struct wpa_driver_nl80211_data *drv =3D bss->drv;
+	int ret;
+	u8 *data, *pos;
+	size_t data_len;
+	u8 own_addr[ETH_ALEN];
+
+	if (linux_get_ifhwaddr(drv->ioctl_sock, bss->ifname, own_addr) < 0)
+		return -1;
+
+	if (action !=3D 1) {
+		wpa_printf(MSG_ERROR, "nl80211: Unsupported send_ft_action "
+			   "action %d", action);
+		return -1;
+	}
+
+	/*
+	 * Action frame payload:
+	 * Category[1] =3D 6 (Fast BSS Transition)
+	 * Action[1] =3D 1 (Fast BSS Transition Request)
+	 * STA Address
+	 * Target AP Address
+	 * FT IEs
+	 */
+
+	data_len =3D 2 + 2 * ETH_ALEN + ies_len;
+	data =3D os_malloc(data_len);
+	if (data =3D=3D NULL)
+		return -1;
+	pos =3D data;
+	*pos++ =3D 0x06; /* FT Action category */
+	*pos++ =3D action;
+	os_memcpy(pos, own_addr, ETH_ALEN);
+	pos +=3D ETH_ALEN;
+	os_memcpy(pos, target_ap, ETH_ALEN);
+	pos +=3D ETH_ALEN;
+	os_memcpy(pos, ies, ies_len);
+
+	ret =3D wpa_driver_nl80211_send_action(bss, drv->assoc_freq, 0,
+					     drv->bssid, own_addr, drv->bssid,
+					     data, data_len);
+	os_free(data);
+
+	return ret;
+}
