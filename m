+static void radius_client_timer(void *eloop_ctx, void *timeout_ctx)
+{
+	struct radius_client_data *radius =3D eloop_ctx;
+	struct hostapd_radius_servers *conf =3D radius->conf;
+	struct os_time now;
+	os_time_t first;
+	struct radius_msg_list *entry, *prev, *tmp;
+	int auth_failover =3D 0, acct_failover =3D 0;
+	char abuf[50];
+
+	entry =3D radius->msgs;
+	if (!entry)
+		return;
+
+	os_get_time(&now);
+	first =3D 0;
+
+	prev =3D NULL;
+	while (entry) {
+		if (now.sec >=3D entry->next_try &&
+		    radius_client_retransmit(radius, entry, now.sec)) {
+			if (prev)
+				prev->next =3D entry->next;
+			else
+				radius->msgs =3D entry->next;
+
+			tmp =3D entry;
+			entry =3D entry->next;
+			radius_client_msg_free(tmp);
+			radius->num_msgs--;
+			continue;
+		}
+
+		if (entry->attempts > RADIUS_CLIENT_NUM_FAILOVER) {
+			if (entry->msg_type =3D=3D RADIUS_ACCT ||
+			    entry->msg_type =3D=3D RADIUS_ACCT_INTERIM)
+				acct_failover++;
+			else
+				auth_failover++;
+		}
+
+		if (first =3D=3D 0 || entry->next_try < first)
+			first =3D entry->next_try;
+
+		prev =3D entry;
+		entry =3D entry->next;
+	}
+
+	if (radius->msgs) {
+		if (first < now.sec)
+			first =3D now.sec;
+		eloop_register_timeout(first - now.sec, 0,
+				       radius_client_timer, radius, NULL);
+		hostapd_logger(radius->ctx, NULL, HOSTAPD_MODULE_RADIUS,
+			       HOSTAPD_LEVEL_DEBUG, "Next RADIUS client "
+			       "retransmit in %ld seconds",
+			       (long int) (first - now.sec));
+	}
+
+	if (auth_failover && conf->num_auth_servers > 1) {
+		struct hostapd_radius_server *next, *old;
+		old =3D conf->auth_server;
+		hostapd_logger(radius->ctx, NULL, HOSTAPD_MODULE_RADIUS,
+			       HOSTAPD_LEVEL_NOTICE,
+			       "No response from Authentication server "
+			       "%s:%d - failover",
+			       hostapd_ip_txt(&old->addr, abuf, sizeof(abuf)),
+			       old->port);
+
+		for (entry =3D radius->msgs; entry; entry =3D entry->next) {
+			if (entry->msg_type =3D=3D RADIUS_AUTH)
+				old->timeouts++;
+		}
+
+		next =3D old + 1;
+		if (next > &(conf->auth_servers[conf->num_auth_servers - 1]))
+			next =3D conf->auth_servers;
+		conf->auth_server =3D next;
+		radius_change_server(radius, next, old,
+				     radius->auth_serv_sock,
+				     radius->auth_serv_sock6, 1);
+	}
+
+	if (acct_failover && conf->num_acct_servers > 1) {
+		struct hostapd_radius_server *next, *old;
+		old =3D conf->acct_server;
+		hostapd_logger(radius->ctx, NULL, HOSTAPD_MODULE_RADIUS,
+			       HOSTAPD_LEVEL_NOTICE,
+			       "No response from Accounting server "
+			       "%s:%d - failover",
+			       hostapd_ip_txt(&old->addr, abuf, sizeof(abuf)),
+			       old->port);
+
+		for (entry =3D radius->msgs; entry; entry =3D entry->next) {
+			if (entry->msg_type =3D=3D RADIUS_ACCT ||
+			    entry->msg_type =3D=3D RADIUS_ACCT_INTERIM)
+				old->timeouts++;
+		}
+
+		next =3D old + 1;
+		if (next > &conf->acct_servers[conf->num_acct_servers - 1])
+			next =3D conf->acct_servers;
+		conf->acct_server =3D next;
+		radius_change_server(radius, next, old,
+				     radius->acct_serv_sock,
+				     radius->acct_serv_sock6, 0);
+	}
+}
