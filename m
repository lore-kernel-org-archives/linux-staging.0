+_PageWrite(
+		PADAPTER	padapter,
+		u32			page,
+		void *		buffer,
+		u32			size
+)
+{
+	u8 value8;
+	u8 u8Page =3D (u8)(page & 0x07) ;
+
+	value8 =3D (rtw_read8(padapter, REG_MCUFWDL + 2) & 0xF8) | u8Page ;
+	rtw_write8(padapter, REG_MCUFWDL + 2, value8);
+
+	return _BlockWrite(padapter, buffer, size);
+}
+
+static void
+_FillDummy(
+	u8		*pFwBuf,
+	u32	*pFwLen
+)
+{
+	u32	FwLen =3D *pFwLen;
+	u8	remain =3D (u8)(FwLen % 4);
+	remain =3D (remain =3D=3D 0) ? 0 : (4 - remain);
+
+	while (remain > 0) {
+		pFwBuf[FwLen] =3D 0;
+		FwLen++;
+		remain--;
+	}
+
+	*pFwLen =3D FwLen;
+}
+
+static int
+_WriteFW(
+		PADAPTER		padapter,
+		void *			buffer,
+		u32			size
+)
+{
+	/* Since we need dynamic decide method of dwonload fw, so we call this fu=
nction to get chip version. */
+	int ret =3D _SUCCESS;
+	u32	pageNums, remainSize ;
+	u32	page, offset;
+	u8		*bufferPtr =3D (u8 *)buffer;
+
+	pageNums =3D size / MAX_DLFW_PAGE_SIZE ;
+	/* RT_ASSERT((pageNums <=3D 4), ("Page numbers should not greater then 4\=
n")); */
+	remainSize =3D size % MAX_DLFW_PAGE_SIZE;
+
+	for (page =3D 0; page < pageNums; page++) {
+		offset =3D page * MAX_DLFW_PAGE_SIZE;
+		ret =3D _PageWrite(padapter, page, bufferPtr + offset, MAX_DLFW_PAGE_SIZ=
E);
+
+		if (ret =3D=3D _FAIL)
+			goto exit;
+	}
+	if (remainSize) {
+		offset =3D pageNums * MAX_DLFW_PAGE_SIZE;
+		page =3D pageNums;
+		ret =3D _PageWrite(padapter, page, bufferPtr + offset, remainSize);
+
+		if (ret =3D=3D _FAIL)
+			goto exit;
+
+	}
+
+exit:
+	return ret;
+}
