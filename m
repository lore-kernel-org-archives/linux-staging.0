+#include "includes.h"
+
+#include "common.h"
+#include "crypto/crypto.h"
+#include "chap.h"
+
+int chap_md5(u8 id, const u8 *secret, size_t secret_len, const u8 *challen=
ge,
+	      size_t challenge_len, u8 *response)
+{
+	const u8 *addr[3];
+	size_t len[3];
+
+	addr[0] =3D &id;
+	len[0] =3D 1;
+	addr[1] =3D secret;
+	len[1] =3D secret_len;
+	addr[2] =3D challenge;
+	len[2] =3D challenge_len;
+	return md5_vector(3, addr, len, response);
+}
