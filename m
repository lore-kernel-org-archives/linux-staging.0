+	    || padapter->securitypriv.dot11PrivacyAlgrthm =3D=3D _TKIP_WTMIC_
+	    || padapter->securitypriv.dot11PrivacyAlgrthm =3D=3D _AES_)
+		/* WPS open need to enable multicast
+		 * || check_fwstate(&padapter->mlmepriv, WIFI_UNDER_WPS) ) */
+		rtw_hal_set_hwreg(padapter, HW_VAR_OFF_RCR_AM, null_addr);
+
+
+exit:
+
+	if (buf)
+		rtw_mfree(buf, ielen);
+
+	return ret;
+}
