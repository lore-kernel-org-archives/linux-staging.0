+int rtw_cmd_filter(struct cmd_priv *pcmdpriv, struct cmd_obj *cmd_obj)
+{
+	u8 bAllow =3D false; /* set to true to allow enqueuing cmd when hw_init_c=
ompleted is false */
+
+#ifdef SUPPORT_HW_RFOFF_DETECTED
+	/* To decide allow or not */
+	if ((adapter_to_pwrctl(pcmdpriv->padapter)->bHWPwrPindetect) &&
+	    (!pcmdpriv->padapter->registrypriv.usbss_enable)) {
+		if (cmd_obj->cmdcode =3D=3D GEN_CMD_CODE(_Set_Drv_Extra)) {
+			struct drvextra_cmd_parm *pdrvextra_cmd_parm =3D (struct drvextra_cmd_p=
arm *)cmd_obj->parmbuf;
+
+			if (pdrvextra_cmd_parm->ec_id =3D=3D POWER_SAVING_CTRL_WK_CID)
+				bAllow =3D true;
+		}
+	}
+#endif
+
+	if (cmd_obj->cmdcode =3D=3D GEN_CMD_CODE(_SetChannelPlan))
+		bAllow =3D true;
+
+	if (cmd_obj->no_io)
+		bAllow =3D true;
+
+	if ((!rtw_is_hw_init_completed(pcmdpriv->padapter) && (bAllow =3D=3D fals=
e))
+	    || ATOMIC_READ(&(pcmdpriv->cmdthd_running)) =3D=3D false	/* com_threa=
d not running */
+	   ) {
+		if (DBG_CMD_EXECUTE)
+			RTW_INFO(ADPT_FMT" drop "CMD_FMT" hw_init_completed:%u, cmdthd_running:=
%u\n", ADPT_ARG(cmd_obj->padapter)
+				, CMD_ARG(cmd_obj), rtw_get_hw_init_completed(cmd_obj->padapter), ATOM=
IC_READ(&pcmdpriv->cmdthd_running));
+		if (0)
+			rtw_warn_on(1);
+
+		return _FAIL;
+	}
+	return _SUCCESS;
+}
