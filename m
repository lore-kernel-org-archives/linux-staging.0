+ * be called whenever a RADIUS message is received from the active server.
+ *
+ * There can be multiple registered RADIUS message handlers. The handlers =
will
+ * be called in order until one of them indicates that it has processed or
+ * queued the message.
+ */
+int radius_client_register(struct radius_client_data *radius,
+			   RadiusType msg_type,
+			   RadiusRxResult (*handler)(struct radius_msg *msg,
+						     struct radius_msg *req,
+						     const u8 *shared_secret,
+						     size_t shared_secret_len,
+						     void *data),
+			   void *data)
+{
+	struct radius_rx_handler **handlers, *newh;
+	size_t *num;
+
+	if (msg_type =3D=3D RADIUS_ACCT) {
+		handlers =3D &radius->acct_handlers;
+		num =3D &radius->num_acct_handlers;
+	} else {
+		handlers =3D &radius->auth_handlers;
+		num =3D &radius->num_auth_handlers;
+	}
+
+	newh =3D os_realloc(*handlers,
+			  (*num + 1) * sizeof(struct radius_rx_handler));
+	if (newh =3D=3D NULL)
+		return -1;
+
+	newh[*num].handler =3D handler;
+	newh[*num].data =3D data;
+	(*num)++;
+	*handlers =3D newh;
+
+	return 0;
+}
