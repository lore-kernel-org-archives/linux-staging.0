+void
+phydm_adaptivity(
+	void			*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _dynamic_initial_gain_threshold_			*p_dm_dig_table =3D &p_dm_odm->=
dm_dig_table;
+	u8			IGI =3D p_dm_dig_table->cur_ig_value;
+	s8			th_l2h_dmc, th_h2l_dmc;
+	s8			diff =3D 0, igi_target;
+	struct _ADAPTIVITY_STATISTICS	*adaptivity =3D (struct _ADAPTIVITY_STATIST=
ICS *)phydm_get_structure(p_dm_odm, PHYDM_ADAPTIVITY);
+
+	if ((p_dm_odm->edcca_enable =3D=3D false) || (adaptivity->is_stop_edcca =
=3D=3D true)) {
+		ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("Disable ED=
CCA!!!\n"));
+		return;
+	}
+
+	if (!(p_dm_odm->support_ability & ODM_BB_ADAPTIVITY)) {
+		ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("adaptivity=
 disable, enable EDCCA mode!!!\n"));
+		p_dm_odm->th_l2h_ini =3D p_dm_odm->th_l2h_ini_mode2;
+		p_dm_odm->th_edcca_hl_diff =3D p_dm_odm->th_edcca_hl_diff_mode2;
+	}
+	ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("odm_Adaptiv=
ity() =3D=3D=3D=3D=3D>\n"));
+	ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("igi_base=3D=
0x%x, th_l2h_ini =3D %d, th_edcca_hl_diff =3D %d\n",
+		adaptivity->igi_base, p_dm_odm->th_l2h_ini, p_dm_odm->th_edcca_hl_diff));
+	if (p_dm_odm->support_ic_type & ODM_IC_11AC_SERIES) {
+		/*fix AC series when enable EDCCA hang issue*/
+		odm_set_bb_reg(p_dm_odm, 0x800, BIT(10), 1);	/*ADC_mask disable*/
+		odm_set_bb_reg(p_dm_odm, 0x800, BIT(10), 0);	/*ADC_mask enable*/
+	}
+	if (*p_dm_odm->p_band_width =3D=3D ODM_BW20M)		/*CHANNEL_WIDTH_20*/
+		igi_target =3D adaptivity->igi_base;
+	else if (*p_dm_odm->p_band_width =3D=3D ODM_BW40M)
+		igi_target =3D adaptivity->igi_base + 2;
+	else if (*p_dm_odm->p_band_width =3D=3D ODM_BW80M)
+		igi_target =3D adaptivity->igi_base + 2;
+	else
+		igi_target =3D adaptivity->igi_base;
+	adaptivity->igi_target =3D (u8) igi_target;
+
+	ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("band_width=
=3D%s, igi_target=3D0x%x, dynamic_link_adaptivity =3D %d, acs_for_adaptivit=
y =3D %d\n",
+		(*p_dm_odm->p_band_width =3D=3D ODM_BW80M) ? "80M" : ((*p_dm_odm->p_band=
_width =3D=3D ODM_BW40M) ? "40M" : "20M"), igi_target, adaptivity->dynamic_=
link_adaptivity, adaptivity->acs_for_adaptivity));
+	ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("RSSI_min =
=3D %d, adaptivity->adajust_igi_level=3D 0x%x, adaptivity_flag =3D %d, adap=
tivity_enable =3D %d\n",
+		p_dm_odm->rssi_min, adaptivity->adajust_igi_level, p_dm_odm->adaptivity_=
flag, p_dm_odm->adaptivity_enable));
+
+	if ((adaptivity->dynamic_link_adaptivity =3D=3D true) && (!p_dm_odm->is_l=
inked) && (p_dm_odm->adaptivity_enable =3D=3D false)) {
+		phydm_set_edcca_threshold(p_dm_odm, 0x7f, 0x7f);
+		ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("In Dynamic=
Link mode(noisy) and No link, Turn off EDCCA!!\n"));
+		return;
+	}
+
+	if (p_dm_odm->support_ic_type & (ODM_IC_11AC_GAIN_IDX_EDCCA | ODM_IC_11N_=
GAIN_IDX_EDCCA)) {
+		if ((adaptivity->adajust_igi_level > IGI) && (p_dm_odm->adaptivity_enabl=
e =3D=3D true))
+			diff =3D adaptivity->adajust_igi_level - IGI;
+
+		th_l2h_dmc =3D p_dm_odm->th_l2h_ini - diff + igi_target;
+		th_h2l_dmc =3D th_l2h_dmc - p_dm_odm->th_edcca_hl_diff;
+	} else	{
+		diff =3D igi_target - (s8)IGI;
+		th_l2h_dmc =3D p_dm_odm->th_l2h_ini + diff;
+		if (th_l2h_dmc > 10 && (p_dm_odm->adaptivity_enable =3D=3D true))
+			th_l2h_dmc =3D 10;
+
+		th_h2l_dmc =3D th_l2h_dmc - p_dm_odm->th_edcca_hl_diff;
+
+		/*replace lower bound to prevent EDCCA always equal 1*/
+		if (th_h2l_dmc < adaptivity->h2l_lb)
+			th_h2l_dmc =3D adaptivity->h2l_lb;
+		if (th_l2h_dmc < adaptivity->l2h_lb)
+			th_l2h_dmc =3D adaptivity->l2h_lb;
+	}
+	ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("IGI=3D0x%x,=
 th_l2h_dmc =3D %d, th_h2l_dmc =3D %d\n", IGI, th_l2h_dmc, th_h2l_dmc));
+	ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("adaptivity_=
igi_upper=3D0x%x, h2l_lb =3D 0x%x, l2h_lb =3D 0x%x\n", p_dm_odm->adaptivity=
_igi_upper, adaptivity->h2l_lb, adaptivity->l2h_lb));
+
+	phydm_set_edcca_threshold(p_dm_odm, th_h2l_dmc, th_l2h_dmc);
+
+	if (p_dm_odm->adaptivity_enable =3D=3D true)
+		odm_set_mac_reg(p_dm_odm, REG_RD_CTRL, BIT(11), 1);
+
+	return;
+}
