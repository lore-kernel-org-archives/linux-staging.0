+static int tls_cryptoapi_ca_cert(SSL_CTX *ssl_ctx, SSL *ssl, const char *n=
ame)
+{
+	HCERTSTORE cs;
+	PCCERT_CONTEXT ctx =3D NULL;
+	X509 *cert;
+	char buf[128];
+	const char *store;
+#ifdef UNICODE
+	WCHAR *wstore;
+#endif /* UNICODE */
+
+	if (name =3D=3D NULL || strncmp(name, "cert_store://", 13) !=3D 0)
+		return -1;
+
+	store =3D name + 13;
+#ifdef UNICODE
+	wstore =3D os_malloc((os_strlen(store) + 1) * sizeof(WCHAR));
+	if (wstore =3D=3D NULL)
+		return -1;
+	wsprintf(wstore, L"%S", store);
+	cs =3D CertOpenSystemStore(0, wstore);
+	os_free(wstore);
+#else /* UNICODE */
+	cs =3D CertOpenSystemStore(0, store);
+#endif /* UNICODE */
+	if (cs =3D=3D NULL) {
+		wpa_printf(MSG_DEBUG, "%s: failed to open system cert store "
+			   "'%s': error=3D%d", __func__, store,
+			   (int) GetLastError());
+		return -1;
+	}
+
+	while ((ctx =3D CertEnumCertificatesInStore(cs, ctx))) {
+		cert =3D d2i_X509(NULL, (OPENSSL_d2i_TYPE) &ctx->pbCertEncoded,
+				ctx->cbCertEncoded);
+		if (cert =3D=3D NULL) {
+			wpa_printf(MSG_INFO, "CryptoAPI: Could not process "
+				   "X509 DER encoding for CA cert");
+			continue;
+		}
+
+		X509_NAME_oneline(X509_get_subject_name(cert), buf,
+				  sizeof(buf));
+		wpa_printf(MSG_DEBUG, "OpenSSL: Loaded CA certificate for "
+			   "system certificate store: subject=3D'%s'", buf);
+
+		if (!X509_STORE_add_cert(ssl_ctx->cert_store, cert)) {
+			tls_show_errors(MSG_WARNING, __func__,
+					"Failed to add ca_cert to OpenSSL "
+					"certificate store");
+		}
+
+		X509_free(cert);
+	}
+
+	if (!CertCloseStore(cs, 0)) {
+		wpa_printf(MSG_DEBUG, "%s: failed to close system cert store "
+			   "'%s': error=3D%d", __func__, name + 13,
+			   (int) GetLastError());
+	}
+
+	return 0;
+}
