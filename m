+	u16  index =3D 0, ie_cap =3D 0;
+	unsigned char *ie_wpa =3D NULL, *ie_wpa2 =3D NULL, *ie_wps =3D NULL;
+	unsigned char *ie_p2p =3D NULL, *ssid =3D NULL;
+	char flag_str[64];
+	int ielen =3D 0;
+	u32 wpsielen =3D 0;
+
+	_enter_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+	phead =3D get_list_head(queue);
+	if (!phead)
+		goto exit;
+	plist =3D get_next(phead);
+	if (!plist)
+		goto exit;
+
+	RTW_PRINT_SEL(m, "%5s  %-17s  %3s  %-3s  %-4s  %-4s  %5s  %32s  %32s\n", =
"index", "bssid", "ch", "RSSI", "SdBm", "Noise", "age", "flag", "ssid");
+	while (1) {
+		if (rtw_end_of_queue_search(phead, plist) =3D=3D true)
+			break;
+
+		pnetwork =3D LIST_CONTAINOR(plist, struct wlan_network, list);
+		if (!pnetwork)
+			break;
+
+		if (check_fwstate(pmlmepriv, _FW_LINKED) =3D=3D true &&
+		    is_same_network(&pmlmepriv->cur_network.network, &pnetwork->network,=
 0)) {
+			notify_signal =3D translate_percentage_to_dbm(padapter->recvpriv.signal=
_strength);/* dbm */
+		} else {
+			notify_signal =3D translate_percentage_to_dbm(pnetwork->network.PhyInfo=
.SignalStrength);/* dbm */
+		}
+
+#if defined(CONFIG_SIGNAL_DISPLAY_DBM) && defined(CONFIG_BACKGROUND_NOISE_=
MONITOR)
+		rtw_hal_get_odm_var(padapter, HAL_ODM_NOISE_MONITOR, &(pnetwork->network=
.Configuration.DSConfig), &(notify_noise));
+#endif
+
+		ie_wpa =3D rtw_get_wpa_ie(&pnetwork->network.IEs[12], &ielen, pnetwork->=
network.IELength - 12);
+		ie_wpa2 =3D rtw_get_wpa2_ie(&pnetwork->network.IEs[12], &ielen, pnetwork=
->network.IELength - 12);
+		ie_cap =3D rtw_get_capability(&pnetwork->network);
+		ie_wps =3D rtw_get_wps_ie(&pnetwork->network.IEs[12], pnetwork->network.=
IELength - 12, NULL, &wpsielen);
+		ie_p2p =3D rtw_get_p2p_ie(&pnetwork->network.IEs[12], pnetwork->network.=
IELength - 12, NULL, &ielen);
+		ssid =3D pnetwork->network.Ssid.Ssid;
+		sprintf(flag_str, "%s%s%s%s%s%s%s",
+			(ie_wpa) ? "[WPA]" : "",
+			(ie_wpa2) ? "[WPA2]" : "",
+			(!ie_wpa && !ie_wpa && ie_cap & BIT(4)) ? "[WEP]" : "",
+			(ie_wps) ? "[WPS]" : "",
+			(pnetwork->network.InfrastructureMode =3D=3D Ndis802_11IBSS) ? "[IBSS]"=
 : "",
+			(ie_cap & BIT(0)) ? "[ESS]" : "",
+			(ie_p2p) ? "[P2P]" : "");
+		RTW_PRINT_SEL(m, "%5d  "MAC_FMT"  %3d  %3d  %4d  %4d    %5d  %32s  %32s\=
n",
+			      ++index,
+			      MAC_ARG(pnetwork->network.MacAddress),
+			      pnetwork->network.Configuration.DSConfig,
+			      (int)pnetwork->network.Rssi,
+			      notify_signal,
+			      notify_noise,
+			rtw_get_passing_time_ms((u32)pnetwork->last_scanned),
+			      flag_str,
+			      pnetwork->network.Ssid.Ssid);
+		plist =3D get_next(plist);
+	}
+exit:
+	_exit_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+
+	return 0;
+}
