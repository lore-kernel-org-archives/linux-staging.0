+		    os_memcmp(sdl->sdl_data, device, sdl->sdl_nlen) !=3D 0)
+			continue;
+		os_memcpy(ea, LLADDR(sdl), sdl->sdl_alen);
+		break;
+	}
+	os_free(buf);
+
+	if (p >=3D buf + len) {
+		errno =3D ESRCH;
+		return -1;
+	}
+#endif /* __sun__ */
+	return 0;
+}
