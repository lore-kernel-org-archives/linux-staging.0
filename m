+static void mlme_event_connect(struct wpa_driver_nl80211_data *drv,
+			       enum nl80211_commands cmd, struct nlattr *status,
+			       struct nlattr *addr, struct nlattr *req_ie,
+			       struct nlattr *resp_ie)
+{
+	union wpa_event_data event;
+
+	if (drv->capa.flags & WPA_DRIVER_FLAGS_SME) {
+		/*
+		 * Avoid reporting two association events that would confuse
+		 * the core code.
+		 */
+		wpa_printf(MSG_DEBUG, "nl80211: Ignore connect event (cmd=3D%d) "
+			   "when using userspace SME", cmd);
+		return;
+	}
+
+	os_memset(&event, 0, sizeof(event));
+	if (cmd =3D=3D NL80211_CMD_CONNECT &&
+	    nla_get_u16(status) !=3D WLAN_STATUS_SUCCESS) {
+		if (addr)
+			event.assoc_reject.bssid =3D nla_data(addr);
+		if (resp_ie) {
+			event.assoc_reject.resp_ies =3D nla_data(resp_ie);
+			event.assoc_reject.resp_ies_len =3D nla_len(resp_ie);
+		}
+		event.assoc_reject.status_code =3D nla_get_u16(status);
+		wpa_supplicant_event(drv->ctx, EVENT_ASSOC_REJECT, &event);
+		return;
+	}
+
+	drv->associated =3D 1;
+	if (addr)
+		os_memcpy(drv->bssid, nla_data(addr), ETH_ALEN);
+
+	if (req_ie) {
+		event.assoc_info.req_ies =3D nla_data(req_ie);
+		event.assoc_info.req_ies_len =3D nla_len(req_ie);
+	}
+	if (resp_ie) {
+		event.assoc_info.resp_ies =3D nla_data(resp_ie);
+		event.assoc_info.resp_ies_len =3D nla_len(resp_ie);
+	}
+
+	wpa_supplicant_event(drv->ctx, EVENT_ASSOC, &event);
+}
