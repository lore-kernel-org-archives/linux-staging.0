+static struct wpa_scan_results *
+wpa_driver_ralink_get_scan_results(void *priv)
+{
+	struct wpa_driver_ralink_data *drv =3D priv;
+	UCHAR *buf =3D NULL;
+	size_t buf_len;
+	NDIS_802_11_BSSID_LIST_EX *wsr;
+	NDIS_WLAN_BSSID_EX *wbi;
+	struct iwreq iwr;
+	size_t ap_num;
+	u8 *pos;
+	struct wpa_scan_results *res;
+
+	if (drv->g_driver_down =3D=3D 1)
+		return NULL;
+	wpa_printf(MSG_DEBUG, "%s", __FUNCTION__);
+
+	if (drv->we_version_compiled >=3D 17)
+		buf_len =3D 8192;
+	else
+		buf_len =3D 4096;
+
+	for (;;) {
+		buf =3D os_zalloc(buf_len);
+		iwr.u.data.length =3D buf_len;
+		if (buf =3D=3D NULL)
+			return NULL;
+
+		wsr =3D (NDIS_802_11_BSSID_LIST_EX *) buf;
+
+		wsr->NumberOfItems =3D 0;
+		os_strlcpy(iwr.ifr_name, drv->ifname, IFNAMSIZ);
+		iwr.u.data.pointer =3D (void *) buf;
+		iwr.u.data.flags =3D OID_802_11_BSSID_LIST;
+
+		if (ioctl(drv->ioctl_sock, RT_PRIV_IOCTL, &iwr) =3D=3D 0)
+			break;
+
+		if (errno =3D=3D E2BIG && buf_len < 65535) {
+			os_free(buf);
+			buf =3D NULL;
+			buf_len *=3D 2;
+			if (buf_len > 65535)
+				buf_len =3D 65535; /* 16-bit length field */
+			wpa_printf(MSG_DEBUG, "Scan results did not fit - "
+				   "trying larger buffer (%lu bytes)",
+				   (unsigned long) buf_len);
+		} else {
+			perror("ioctl[RT_PRIV_IOCTL]");
+			os_free(buf);
+			return NULL;
+		}
+	}
+
+	res =3D os_zalloc(sizeof(*res));
+	if (res =3D=3D NULL) {
+		os_free(buf);
+		return NULL;
+	}
+
+	res->res =3D os_zalloc(wsr->NumberOfItems *
+			     sizeof(struct wpa_scan_res *));
+	if (res->res =3D=3D NULL) {
+		os_free(res);
+		os_free(buf);
+		return NULL;
+	}
+
+	for (ap_num =3D 0, wbi =3D wsr->Bssid; ap_num < wsr->NumberOfItems;
+	     ++ap_num) {
+		struct wpa_scan_res *r =3D NULL;
+		size_t extra_len =3D 0, var_ie_len =3D 0;
+		u8 *pos2;
+
+		/* SSID data element */
+		extra_len +=3D 2 + wbi->Ssid.SsidLength;
+		var_ie_len =3D wbi->IELength - sizeof(NDIS_802_11_FIXED_IEs);
+		r =3D os_zalloc(sizeof(*r) + extra_len + var_ie_len);
+		if (r =3D=3D NULL)
+			break;
+		res->res[res->num++] =3D r;
+
+		wpa_printf(MSG_DEBUG, "SSID - %s", wbi->Ssid.Ssid);
+		/* get ie's */
+		wpa_hexdump(MSG_DEBUG, "RALINK: AP IEs",
+			    (u8 *) &wbi->IEs[0], wbi->IELength);
+
+		os_memcpy(r->bssid, wbi->MacAddress, ETH_ALEN);
+
+		extra_len +=3D (2 + wbi->Ssid.SsidLength);
+		r->ie_len =3D extra_len + var_ie_len;
+		pos2 =3D (u8 *) (r + 1);
+
+		/*
+		 * Generate a fake SSID IE since the driver did not report
+		 * a full IE list.
+		 */
+		*pos2++ =3D WLAN_EID_SSID;
+		*pos2++ =3D wbi->Ssid.SsidLength;
+		os_memcpy(pos2, wbi->Ssid.Ssid, wbi->Ssid.SsidLength);
+		pos2 +=3D wbi->Ssid.SsidLength;
+
+		r->freq =3D (wbi->Configuration.DSConfig / 1000);
+
+		pos =3D (u8 *) wbi + sizeof(*wbi) - 1;
+
+		pos +=3D sizeof(NDIS_802_11_FIXED_IEs) - 2;
+		os_memcpy(&(r->caps), pos, 2);
+		pos +=3D 2;
+
+		if (wbi->IELength > sizeof(NDIS_802_11_FIXED_IEs))
+			os_memcpy(pos2, pos, var_ie_len);
+
+		wbi =3D (NDIS_WLAN_BSSID_EX *) ((u8 *) wbi + wbi->Length);
+	}
+
+	os_free(buf);
+	return res;
+}
