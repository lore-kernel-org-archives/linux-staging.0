+ */
+void dump_TX_FIFO(_adapter *padapter, u8 page_num, u16 page_size)
+{
+
+	int i;
+	u8 val =3D 0;
+	u8 base =3D 0;
+	u32 addr =3D 0;
+	u32 count =3D (page_size / 8);
+
+	if (page_num <=3D 0) {
+		RTW_INFO("!!%s: incorrect input page_num paramter!\n", __func__);
+		return;
+	}
+
+	if (page_size < 128 || page_size > 512) {
