+static int eap_allowed_phase2_type(int vendor, int type)
+{
+	if (vendor !=3D EAP_VENDOR_IETF)
+		return 0;
+	return type !=3D EAP_TYPE_PEAP && type !=3D EAP_TYPE_TTLS &&
+		type !=3D EAP_TYPE_FAST;
+}
