+	switch (nr_index) {
+	case 1:
+		ndp_tx_rate =3D ODM_MGN_VHT2SS_MCS0;
+		break;
+
+	case 2:
+		ndp_tx_rate =3D ODM_MGN_VHT3SS_MCS0;
+		break;
+
+	case 3:
+		ndp_tx_rate =3D ODM_MGN_VHT4SS_MCS0;
+		break;
+
+	default:
+		ndp_tx_rate =3D ODM_MGN_VHT2SS_MCS0;
+		break;
+	}
