+		("ODM_ARFBRefresh_8188E(): rate_id=3D%d rate_mask=3D%8.8x ra_use_rate=3D=
%8.8x highest_rate=3D%d\n",
+		p_ra_info->rate_id, p_ra_info->rate_mask, p_ra_info->ra_use_rate, p_ra_i=
nfo->highest_rate));
+	return 0;
+}
