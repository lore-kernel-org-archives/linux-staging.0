+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("[Set NBI] CH =3D ((=
%d)), BW =3D ((%d)), f_intf =3D ((%d)), Scnd_CH =3D ((%s))\n",
