+/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
+ VHT Delimiter
+=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/
+void VHT_Delimiter_generator(
+	PRT_PMAC_TX_INFO	pPMacTxInfo
+)
+{
+	bool sig_bi[32] =3D {0}, crc8[8] =3D {0};
+	u32 crc8_in_len =3D 16;
+	u32 PacketLength =3D pPMacTxInfo->PacketLength;
+	int j;
+
+	/* Delimiter[0]: EOF*/
+	sig_bi[0] =3D 1;
+	/* Delimiter[1]: Reserved*/
+	sig_bi[1] =3D 0;
+	/* Delimiter[3:2]: MPDU Length High*/
+	sig_bi[2] =3D ((PacketLength - 4) >> 12) % 2;
+	sig_bi[3] =3D ((PacketLength - 4) >> 13) % 2;
+	/* Delimiter[15:4]: MPDU Length Low*/
+	for (j =3D 4; j < 16; j++)
+		sig_bi[j] =3D ((PacketLength - 4) >> (j - 4)) % 2;
+	CRC8_generator(crc8, sig_bi, crc8_in_len);
+	for (j =3D 16; j < 24; j++) /* Delimiter[23:16]: CRC 8*/
+		sig_bi[j] =3D crc8[j - 16];
+	for (j =3D 24; j < 32; j++) /* Delimiter[31:24]: Signature ('4E' in Hex, =
78 in Dec)*/
+		sig_bi[j]	=3D (78 >> (j - 24)) % 2;
+
+	memset(pPMacTxInfo->VHT_Delimiter, 0, 4);
+	ByteToBit(pPMacTxInfo->VHT_Delimiter, sig_bi, 4);
+}
