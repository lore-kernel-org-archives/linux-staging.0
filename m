+
+static void encrypt_ms_key(const u8 *key, size_t key_len, u16 salt,
+			   const u8 *req_authenticator,
+			   const u8 *secret, size_t secret_len,
+			   u8 *ebuf, size_t *elen)
+{
+	int i, len, first =3D 1;
+	u8 hash[MD5_MAC_LEN], saltbuf[2], *pos;
+	const u8 *addr[3];
+	size_t _len[3];
+
+	WPA_PUT_BE16(saltbuf, salt);
+
+	len =3D 1 + key_len;
+	if (len & 0x0f) {
+		len =3D (len & 0xf0) + 16;
+	}
+	os_memset(ebuf, 0, len);
+	ebuf[0] =3D key_len;
+	os_memcpy(ebuf + 1, key, key_len);
+
+	*elen =3D len;
+
+	pos =3D ebuf;
+	while (len > 0) {
+		/* b(1) =3D MD5(Secret + Request-Authenticator + Salt)
+		 * b(i) =3D MD5(Secret + c(i - 1)) for i > 1 */
+		addr[0] =3D secret;
+		_len[0] =3D secret_len;
+		if (first) {
+			addr[1] =3D req_authenticator;
+			_len[1] =3D MD5_MAC_LEN;
+			addr[2] =3D saltbuf;
+			_len[2] =3D sizeof(saltbuf);
+		} else {
+			addr[1] =3D pos - MD5_MAC_LEN;
+			_len[1] =3D MD5_MAC_LEN;
+		}
+		md5_vector(first ? 3 : 2, addr, _len, hash);
+		first =3D 0;
+
+		for (i =3D 0; i < MD5_MAC_LEN; i++)
+			*pos++ ^=3D hash[i];
+
+		len -=3D MD5_MAC_LEN;
+	}
+}
