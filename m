+}
+
+void
+phydm_config_kfree(
+	void	*p_dm_void,
+	u8	channel_to_sw,
+	u8	*kfree_table
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct odm_rf_calibration_structure	*p_rf_calibrate_info =3D &(p_dm_odm->=
rf_calibrate_info);
+	u8			rfpath =3D 0, max_rf_path =3D 0;
+	u8			channel_idx =3D 0;
+
+	if (p_dm_odm->support_ic_type & ODM_RTL8814A)
+		max_rf_path =3D 4;	/*0~3*/
+	else if (p_dm_odm->support_ic_type & (ODM_RTL8812 | ODM_RTL8192E | ODM_RT=
L8822B))
+		max_rf_path =3D 2;	/*0~1*/
+	else
+		max_rf_path =3D 1;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_MP, ODM_DBG_LOUD, ("=3D=3D=3D>phy_ConfigK=
Free8814A()\n"));
+
+	if (p_rf_calibrate_info->reg_rf_kfree_enable =3D=3D 2) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_MP, ODM_DBG_LOUD, ("phy_ConfigKFree8814A=
(): reg_rf_kfree_enable =3D=3D 2, Disable\n"));
+		return;
+	} else if (p_rf_calibrate_info->reg_rf_kfree_enable =3D=3D 1 || p_rf_cali=
brate_info->reg_rf_kfree_enable =3D=3D 0) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_MP, ODM_DBG_LOUD, ("phy_ConfigKFree8814A=
(): reg_rf_kfree_enable =3D=3D true\n"));
+		/*Make sure the targetval is defined*/
+		if (((p_rf_calibrate_info->reg_rf_kfree_enable =3D=3D 1) && (kfree_table=
[0] !=3D 0xFF)) || (p_rf_calibrate_info->rf_kfree_enable =3D=3D true)) {
+			/*if kfree_table[0] =3D=3D 0xff, means no Kfree*/
+			if (*p_dm_odm->p_band_type =3D=3D ODM_BAND_2_4G) {
+				if (channel_to_sw <=3D 14 && channel_to_sw >=3D 1)
+					channel_idx =3D PHYDM_2G;
+			} else if (*p_dm_odm->p_band_type =3D=3D ODM_BAND_5G) {
+				if (channel_to_sw >=3D 36 && channel_to_sw <=3D 48)
+					channel_idx =3D PHYDM_5GLB1;
+				if (channel_to_sw >=3D 52 && channel_to_sw <=3D 64)
+					channel_idx =3D PHYDM_5GLB2;
+				if (channel_to_sw >=3D 100 && channel_to_sw <=3D 120)
+					channel_idx =3D PHYDM_5GMB1;
+				if (channel_to_sw >=3D 124 && channel_to_sw <=3D 144)
+					channel_idx =3D PHYDM_5GMB2;
+				if (channel_to_sw >=3D 149 && channel_to_sw <=3D 177)
+					channel_idx =3D PHYDM_5GHB;
+			}
+
+			for (rfpath =3D ODM_RF_PATH_A;  rfpath < max_rf_path; rfpath++) {
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_MP, ODM_DBG_LOUD, ("phydm_kfree(): PAT=
H_%d: %#x\n", rfpath, kfree_table[channel_idx * max_rf_path + rfpath]));
+				phydm_set_kfree_to_rf(p_dm_odm, rfpath, kfree_table[channel_idx * max_=
rf_path + rfpath]);
+			}
+		} else {
+			ODM_RT_TRACE(p_dm_odm, ODM_COMP_MP, ODM_DBG_LOUD, ("phy_ConfigKFree8814=
A(): targetval not defined, Don't execute KFree Process.\n"));
+			return;
+		}
+	}
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_MP, ODM_DBG_LOUD, ("<=3D=3D=3Dphy_ConfigK=
Free8814A()\n"));
+}
