+static int rtw_scan_ch_decision(_adapter *padapter, struct rtw_ieee80211_c=
hannel *out,
+		u32 out_num, struct rtw_ieee80211_channel *in, u32 in_num)
+{
+	int i, j;
+	int scan_ch_num =3D 0;
+	int set_idx;
+	u8 chan;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+
+	/* clear first */
+	memset(out, 0, sizeof(struct rtw_ieee80211_channel) * out_num);
+
+	/* acquire channels from in */
+	j =3D 0;
+	for (i =3D 0; i < in_num; i++) {
+
+		if (0)
+			RTW_INFO(FUNC_ADPT_FMT" "CHAN_FMT"\n", FUNC_ADPT_ARG(padapter), CHAN_AR=
G(&in[i]));
+
+		if (!in[i].hw_value || (in[i].flags & RTW_IEEE80211_CHAN_DISABLED))
+			continue;
+		if (rtw_mlme_band_check(padapter, in[i].hw_value) =3D=3D false)
+			continue;
+
+		set_idx =3D rtw_ch_set_search_ch(pmlmeext->channel_set, in[i].hw_value);
+		if (set_idx >=3D 0) {
+			if (j >=3D out_num) {
+				RTW_PRINT(FUNC_ADPT_FMT" out_num:%u not enough\n",
+					  FUNC_ADPT_ARG(padapter), out_num);
+				break;
+			}
+
+			memcpy(&out[j], &in[i], sizeof(struct rtw_ieee80211_channel));
+
+			if (pmlmeext->channel_set[set_idx].ScanType =3D=3D SCAN_PASSIVE)
+				out[j].flags |=3D RTW_IEEE80211_CHAN_PASSIVE_SCAN;
+
+			j++;
+		}
+		if (j >=3D out_num)
+			break;
+	}
+
+	/* if out is empty, use channel_set as default */
+	if (j =3D=3D 0) {
+		for (i =3D 0; i < pmlmeext->max_chan_nums; i++) {
+			chan =3D pmlmeext->channel_set[i].ChannelNum;
+			if (rtw_mlme_band_check(padapter, chan)) {
+				if (rtw_mlme_ignore_chan(padapter, chan))
+					continue;
+
+				if (0)
+					RTW_INFO(FUNC_ADPT_FMT" ch:%u\n", FUNC_ADPT_ARG(padapter), chan);
+
+				if (j >=3D out_num) {
+					RTW_PRINT(FUNC_ADPT_FMT" out_num:%u not enough\n",
+						FUNC_ADPT_ARG(padapter), out_num);
+					break;
+				}
+
+				out[j].hw_value =3D chan;
+
+				if (pmlmeext->channel_set[i].ScanType =3D=3D SCAN_PASSIVE)
+					out[j].flags |=3D RTW_IEEE80211_CHAN_PASSIVE_SCAN;
+
+				j++;
+			}
+		}
+	}
+
+	/* scan_sparse */
+	j =3D rtw_scan_sparse(padapter, out, j);
+
+	return j;
+}
