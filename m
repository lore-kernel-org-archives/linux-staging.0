+unsigned char *rtw_get_wpa_ie(unsigned char *pie, int *wpa_ie_len, int lim=
it)
+{
+	int len;
+	u16 val16;
+	__le16 leval16;
+	unsigned char wpa_oui_type[] =3D {0x00, 0x50, 0xf2, 0x01};
+	u8 *pbuf =3D pie;
+	int limit_new =3D limit;
+
+	while (1) {
+		pbuf =3D rtw_get_ie(pbuf, _WPA_IE_ID_, &len, limit_new);
+		if (pbuf) {
+			/* check if oui matches... */
+			if (memcmp((pbuf + 2), wpa_oui_type, sizeof(wpa_oui_type)))
+				goto check_next_ie;
+			/* check version... */
