+static int wpa_driver_ralink_set_key(const char *ifname, void *priv,
+				     enum wpa_alg alg, const u8 *addr,
+				     int key_idx, int set_tx,
+				     const u8 *seq, size_t seq_len,
+				     const u8 *key, size_t key_len)
+{
+	struct wpa_driver_ralink_data *drv =3D priv;
+	size_t len, i;
+	NDIS_802_11_KEY *nkey;
+	int res, pairwise;
+	u8 bssid[ETH_ALEN];
+
+	if (drv->g_driver_down =3D=3D 1)
+		return -1;
+
+	wpa_printf(MSG_DEBUG, "%s", __FUNCTION__);
+
+	drv->bAddWepKey =3D FALSE;
+
+	if (addr =3D=3D NULL || is_broadcast_ether_addr(addr)) {
+		/* Group Key */
+		pairwise =3D 0;
+		wpa_driver_ralink_get_bssid(drv, bssid);
+	} else {
+		/* Pairwise Key */
+		pairwise =3D 1;
+		os_memcpy(bssid, addr, ETH_ALEN);
+	}
+
+	if (alg =3D=3D WPA_ALG_NONE || key_len =3D=3D 0) {
+		return wpa_driver_ralink_remove_key(drv, key_idx, addr, bssid,
+						    pairwise);
+	}
+
+	if (alg =3D=3D WPA_ALG_WEP) {
+		drv->bAddWepKey =3D TRUE;
+		return wpa_driver_ralink_add_wep(drv, pairwise, key_idx,
+						 set_tx, key, key_len);
+	}
+
+	len =3D 12 + 6 + 6 + 8 + key_len;
+
+	nkey =3D os_zalloc(len);
+	if (nkey =3D=3D NULL)
+		return -1;
+
+	nkey->Length =3D len;
+	nkey->KeyIndex =3D key_idx;
+
+	if (set_tx)
+		nkey->KeyIndex |=3D 1 << 31;
+
+	if (pairwise)
+		nkey->KeyIndex |=3D 1 << 30;
+
+	if (seq && seq_len)
+		nkey->KeyIndex |=3D 1 << 29;
+
+	nkey->KeyLength =3D key_len;
+	os_memcpy(nkey->BSSID, bssid, ETH_ALEN);
+
+	if (seq && seq_len) {
+		for (i =3D 0; i < seq_len; i++)
+			nkey->KeyRSC |=3D seq[i] << (i * 8);
+	}
+	if (alg =3D=3D WPA_ALG_TKIP && key_len =3D=3D 32) {
+		os_memcpy(nkey->KeyMaterial, key, 16);
+		os_memcpy(nkey->KeyMaterial + 16, key + 24, 8);
+		os_memcpy(nkey->KeyMaterial + 24, key + 16, 8);
+	} else {
+		os_memcpy(nkey->KeyMaterial, key, key_len);
+	}
+
+	wpa_printf(MSG_DEBUG, "%s: alg=3D%d key_idx=3D%d set_tx=3D%d seq_len=3D%l=
u "
+		   "key_len=3D%lu", __FUNCTION__, alg, key_idx, set_tx,
+		   (unsigned long) seq_len, (unsigned long) key_len);
+
+	wpa_hexdump_key(MSG_MSGDUMP, "RALINK: OID_802_11_ADD_KEY",
+			(const u8 *) nkey, len);
+	res =3D ralink_set_oid(drv, OID_802_11_ADD_KEY, (char *) nkey, len);
+	os_free(nkey);
+
+	return res;
+}
