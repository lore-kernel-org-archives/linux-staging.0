+static int pkcs1_generate_encryption_block(u8 block_type, size_t modlen,
+					   const u8 *in, size_t inlen,
+					   u8 *out, size_t *outlen)
+{
+	size_t ps_len;
+	u8 *pos;
+
+	/*
+	 * PKCS #1 v1.5, 8.1:
+	 *
+	 * EB =3D 00 || BT || PS || 00 || D
+	 * BT =3D 00 or 01 for private-key operation; 02 for public-key operation
+	 * PS =3D k-3-||D||; at least eight octets
+	 * (BT=3D0: PS=3D0x00, BT=3D1: PS=3D0xff, BT=3D2: PS=3Dpseudorandom non-z=
ero)
+	 * k =3D length of modulus in octets (modlen)
+	 */
+
+	if (modlen < 12 || modlen > *outlen || inlen > modlen - 11) {
+		wpa_printf(MSG_DEBUG, "PKCS #1: %s - Invalid buffer "
+			   "lengths (modlen=3D%lu outlen=3D%lu inlen=3D%lu)",
+			   __func__, (unsigned long) modlen,
+			   (unsigned long) *outlen,
+			   (unsigned long) inlen);
+		return -1;
+	}
+
+	pos =3D out;
+	*pos++ =3D 0x00;
+	*pos++ =3D block_type; /* BT */
+	ps_len =3D modlen - inlen - 3;
+	switch (block_type) {
+	case 0:
+		os_memset(pos, 0x00, ps_len);
+		pos +=3D ps_len;
+		break;
+	case 1:
+		os_memset(pos, 0xff, ps_len);
+		pos +=3D ps_len;
+		break;
+	case 2:
+		if (os_get_random(pos, ps_len) < 0) {
+			wpa_printf(MSG_DEBUG, "PKCS #1: %s - Failed to get "
+				   "random data for PS", __func__);
+			return -1;
+		}
+		while (ps_len--) {
+			if (*pos =3D=3D 0x00)
+				*pos =3D 0x01;
+			pos++;
+		}
+		break;
+	default:
+		wpa_printf(MSG_DEBUG, "PKCS #1: %s - Unsupported block type "
+			   "%d", __func__, block_type);
+		return -1;
+	}
+	*pos++ =3D 0x00;
+	os_memcpy(pos, in, inlen); /* D */
+
+	return 0;
+}
