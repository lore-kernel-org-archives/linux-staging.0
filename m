+static void phy_txpwr_by_rate_chk_for_path_dup(_adapter *adapter)
+{
+	struct hal_spec_t *hal_spec =3D GET_HAL_SPEC(adapter);
+	HAL_DATA_TYPE *hal_data =3D GET_HAL_DATA(adapter);
+	u8 band, path;
+	s8 src_path;
+
+	for (band =3D BAND_ON_2_4G; band <=3D BAND_ON_5G; band++)
+		for (path =3D RF_PATH_A; path < RF_PATH_MAX; path++)
+			hal_data->txpwr_by_rate_undefined_band_path[band][path] =3D 0;
+
+	for (band =3D BAND_ON_2_4G; band <=3D BAND_ON_5G; band++) {
+		if (!hal_is_band_support(adapter, band))
+			continue;
+
+		for (path =3D RF_PATH_A; path < RF_PATH_MAX; path++) {
+			if (!HAL_SPEC_CHK_RF_PATH(hal_spec, band, path))
+				continue;
+
+			if (phy_is_txpwr_by_rate_undefined_of_band_path(adapter, band, path))
+				hal_data->txpwr_by_rate_undefined_band_path[band][path] =3D 1;
+		}
+	}
+
+	for (band =3D BAND_ON_2_4G; band <=3D BAND_ON_5G; band++) {
+		if (!hal_is_band_support(adapter, band))
+			continue;
+
+		src_path =3D -1;
+		for (path =3D RF_PATH_A; path < RF_PATH_MAX; path++) {
+			if (!HAL_SPEC_CHK_RF_PATH(hal_spec, band, path))
+				continue;
+
+			/* find src */
+			if (src_path =3D=3D -1 && hal_data->txpwr_by_rate_undefined_band_path[b=
and][path] =3D=3D 0)
+				src_path =3D path;
+		}
+
+		if (src_path =3D=3D -1) {
+			RTW_ERR("%s all power by rate undefined\n", __func__);
+			continue;
+		}
+
+		for (path =3D RF_PATH_A; path < RF_PATH_MAX; path++) {
+			if (!HAL_SPEC_CHK_RF_PATH(hal_spec, band, path))
+				continue;
+
+			/* duplicate src to undefined one */
+			if (hal_data->txpwr_by_rate_undefined_band_path[band][path] =3D=3D 1) {
+				RTW_INFO("%s duplicate %s [%c] to [%c]\n", __func__
+					, band_str(band), rf_path_char(src_path), rf_path_char(path));
+				phy_txpwr_by_rate_duplicate_band_path(adapter, band, src_path, path);
+			}
+		}
+	}
+}
