+	u8			p2pie[255] =3D { 0x00 };
+	u8			p2pielen =3D 0, i;
+	u8			channel_cnt_24g =3D 0, channel_cnt_5gl =3D 0, channel_cnt_5gh =3D 0;
+	u16			len_channellist_attr =3D 0;
+	u32			pktlen;
