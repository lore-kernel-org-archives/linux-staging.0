+
+		/*get supported rates len*/
+		p =3D rtw_get_ie(pie + _BEACON_IE_OFFSET_, _SUPPORTEDRATES_IE_, &tmp_len=
, (pnetwork_mlmeext->IELength - _BEACON_IE_OFFSET_));
+		if (p !=3D  NULL)
+			offset +=3D tmp_len + 2;
+
+		/*DS Parameter Set IE, len=3D3*/
+		offset +=3D 3;
