--
+ *
+ * LLT R/W/Init function
+ *
+ * -----------------------------------------------------------------------=
-- */
+static s32 _LLTWrite(PADAPTER padapter, u32 address, u32 data)
+{
+	s32	status =3D _SUCCESS;
+	s8	count =3D POLLING_LLT_THRESHOLD;
+	u32	value =3D _LLT_INIT_ADDR(address) | _LLT_INIT_DATA(data) | _LLT_OP(_L=
LT_WRITE_ACCESS);
+
+	rtw_write32(padapter, REG_LLT_INIT, value);
+
+	/* polling */
+	do {
+		value =3D rtw_read32(padapter, REG_LLT_INIT);
+		if (_LLT_NO_ACTIVE =3D=3D _LLT_OP_VALUE(value))
+			break;
+	} while (--count);
+
+	if (count <=3D 0) {
+		RTW_INFO("Failed to polling write LLT done at address %d!\n", address);
+		status =3D _FAIL;
+	}
+
+	return status;
+}
+
+static u8 _LLTRead(PADAPTER padapter, u32 address)
+{
+	s32	count =3D POLLING_LLT_THRESHOLD;
+	u32	value =3D _LLT_INIT_ADDR(address) | _LLT_OP(_LLT_READ_ACCESS);
+	u16	LLTReg =3D REG_LLT_INIT;
+
+
+	rtw_write32(padapter, LLTReg, value);
+
+	/* polling and get value */
+	do {
+		value =3D rtw_read32(padapter, LLTReg);
+		if (_LLT_NO_ACTIVE =3D=3D _LLT_OP_VALUE(value))
+			return (u8)value;
+	} while (--count);
+
+
+
+
+	return 0xFF;
+}
