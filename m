+static struct wpabuf * eap_fast_tlv_pac_ack(void)
+{
+	struct wpabuf *buf;
+	struct eap_tlv_result_tlv *res;
+	struct eap_tlv_pac_ack_tlv *ack;
+
+	buf =3D wpabuf_alloc(sizeof(*res) + sizeof(*ack));
+	if (buf =3D=3D NULL)
+		return NULL;
+
+	wpa_printf(MSG_DEBUG, "EAP-FAST: Add PAC TLV (ack)");
+	ack =3D wpabuf_put(buf, sizeof(*ack));
+	ack->tlv_type =3D host_to_be16(EAP_TLV_PAC_TLV |
+				     EAP_TLV_TYPE_MANDATORY);
+	ack->length =3D host_to_be16(sizeof(*ack) - sizeof(struct eap_tlv_hdr));
+	ack->pac_type =3D host_to_be16(PAC_TYPE_PAC_ACKNOWLEDGEMENT);
+	ack->pac_len =3D host_to_be16(2);
+	ack->result =3D host_to_be16(EAP_TLV_RESULT_SUCCESS);
+
+	return buf;
+}
