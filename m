+
+int uuid_str2bin(const char *str, u8 *bin)
+{
+	const char *pos;
+	u8 *opos;
+
+	pos =3D str;
+	opos =3D bin;
+
+	if (hexstr2bin(pos, opos, 4))
+		return -1;
+	pos +=3D 8;
+	opos +=3D 4;
+
+	if (*pos++ !=3D '-' || hexstr2bin(pos, opos, 2))
+		return -1;
+	pos +=3D 4;
+	opos +=3D 2;
+
+	if (*pos++ !=3D '-' || hexstr2bin(pos, opos, 2))
+		return -1;
+	pos +=3D 4;
+	opos +=3D 2;
+
+	if (*pos++ !=3D '-' || hexstr2bin(pos, opos, 2))
+		return -1;
+	pos +=3D 4;
+	opos +=3D 2;
+
+	if (*pos++ !=3D '-' || hexstr2bin(pos, opos, 6))
+		return -1;
+
+	return 0;
+}
+
+
+int uuid_bin2str(const u8 *bin, char *str, size_t max_len)
+{
+	int len;
+	len =3D os_snprintf(str, max_len, "%02x%02x%02x%02x-%02x%02x-%02x%02x-"
+			  "%02x%02x-%02x%02x%02x%02x%02x%02x",
+			  bin[0], bin[1], bin[2], bin[3],
+			  bin[4], bin[5], bin[6], bin[7],
+			  bin[8], bin[9], bin[10], bin[11],
+			  bin[12], bin[13], bin[14], bin[15]);
+	if (len < 0 || (size_t) len >=3D max_len)
+		return -1;
+	return 0;
+}
+
+
+int is_nil_uuid(const u8 *uuid)
+{
+	int i;
+	for (i =3D 0; i < UUID_LEN; i++)
+		if (uuid[i])
+			return 0;
+	return 1;
+}
