+int rtw_select_roaming_candidate(struct mlme_priv *mlme)
+{
+	unsigned long	irqL;
+	int ret =3D _FAIL;
+	_list	*phead;
+	_adapter *adapter;
+	_queue	*queue	=3D &(mlme->scanned_queue);
+	struct	wlan_network	*pnetwork =3D NULL;
+	struct	wlan_network	*candidate =3D NULL;
+	u8		bSupportAntDiv =3D false;
+
+
+	if (mlme->cur_network_scanned =3D=3D NULL) {
+		rtw_warn_on(1);
+		return ret;
+	}
+
+	_enter_critical_bh(&(mlme->scanned_queue.lock), &irqL);
+	phead =3D get_list_head(queue);
+	adapter =3D (_adapter *)mlme->nic_hdl;
+
+	mlme->pscanned =3D get_next(phead);
+
+	while (!rtw_end_of_queue_search(phead, mlme->pscanned)) {
+
+		pnetwork =3D LIST_CONTAINOR(mlme->pscanned, struct wlan_network, list);
+		if (pnetwork =3D=3D NULL) {
+			ret =3D _FAIL;
+			goto exit;
+		}
+
+		mlme->pscanned =3D get_next(mlme->pscanned);
+
+		if (0)
+			RTW_INFO("%s("MAC_FMT", ch%u) rssi:%d\n"
+				 , pnetwork->network.Ssid.Ssid
+				 , MAC_ARG(pnetwork->network.MacAddress)
+				 , pnetwork->network.Configuration.DSConfig
+				 , (int)pnetwork->network.Rssi);
+
+		rtw_check_roaming_candidate(mlme, &candidate, pnetwork);
+
+	}
+
+	if (candidate =3D=3D NULL) {
+		RTW_INFO("%s: return _FAIL(candidate =3D=3D NULL)\n", __func__);
+		ret =3D _FAIL;
+		goto exit;
+	} else {
+		RTW_INFO("%s: candidate: %s("MAC_FMT", ch:%u)\n", __func__,
+			candidate->network.Ssid.Ssid, MAC_ARG(candidate->network.MacAddress),
+			 candidate->network.Configuration.DSConfig);
+
+		mlme->roam_network =3D candidate;
+
+		if (!memcmp(candidate->network.MacAddress, mlme->roam_tgt_addr, ETH_ALEN=
))
+			memset(mlme->roam_tgt_addr, 0, ETH_ALEN);
+	}
+
+	ret =3D _SUCCESS;
+exit:
+	_exit_critical_bh(&(mlme->scanned_queue.lock), &irqL);
+
+	return ret;
