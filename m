+		&& !memcmp(get_ra(wlanhdr), adapter_mac_addr(padapter), ETH_ALEN);
+
+	pkt_info.is_packet_to_self =3D pkt_info.is_packet_match_bssid
+		&& !memcmp(get_ra(wlanhdr), adapter_mac_addr(padapter), ETH_ALEN);
+
+	pkt_info.is_packet_beacon =3D pkt_info.is_packet_match_bssid
+				 && (get_frame_sub_type(wlanhdr) =3D=3D WIFI_BEACON);
+
+	sa =3D get_ta(wlanhdr);
+
+	pkt_info.station_id =3D 0xFF;
+
+	if (!memcmp(adapter_mac_addr(padapter), sa, ETH_ALEN)) {
+		static u32 start_time =3D 0;
+
+		if ((start_time =3D=3D 0) || (rtw_get_passing_time_ms(start_time) > 5000=
)) {
+			RTW_PRINT("Warning!!! %s: Confilc mac addr!!\n", __func__);
+			start_time =3D jiffies;
