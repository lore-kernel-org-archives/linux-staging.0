+				pframe_wscie =3D pframe + wps_offset;
+				memcpy(pframe, cur_network->IEs, wps_offset + wpsielen);
+				pframe +=3D (wps_offset + wpsielen);
+				pattrib->pktlen +=3D (wps_offset + wpsielen);
+
+				/* now pframe is end of wsc ie, insert Primary Device Type & Device Na=
me */
+				/*	Primary Device Type */
+				/*	Type: */
+				*(__be16 *)(pframe + insert_len) =3D cpu_to_be16(WPS_ATTR_PRIMARY_DEV_=
TYPE);
+				insert_len +=3D 2;
+
+				/*	Length: */
+				*(__be16 *)(pframe + insert_len) =3D cpu_to_be16(0x0008);
+				insert_len +=3D 2;
+
+				/*	Value: */
+				/*	Category ID */
+				*(__be16 *)(pframe + insert_len) =3D cpu_to_be16(WPS_PDT_CID_MULIT_MED=
IA);
+				insert_len +=3D 2;
+
+				/*	OUI */
+				*(__be32 *)(pframe + insert_len) =3D cpu_to_be32(WPSOUI);
+				insert_len +=3D 4;
+
+				/*	Sub Category ID */
+				*(__be16 *)(pframe + insert_len) =3D cpu_to_be16(WPS_PDT_SCID_MEDIA_SE=
RVER);
+				insert_len +=3D 2;
+
+
+				/*	Device Name */
+				/*	Type: */
+				*(__be16 *)(pframe + insert_len) =3D cpu_to_be16(WPS_ATTR_DEVICE_NAME);
+				insert_len +=3D 2;
+
+				/*	Length: */
+				*(__be16 *)(pframe + insert_len) =3D cpu_to_be16(pwdinfo->device_name_=
len);
+				insert_len +=3D 2;
+
+				/*	Value: */
+				memcpy(pframe + insert_len, pwdinfo->device_name, pwdinfo->device_name=
_len);
+				insert_len +=3D pwdinfo->device_name_len;
+
+
+				/* update wsc ie length */
+				*(pframe_wscie + 1) =3D (wpsielen - 2) + insert_len;
+
+				/* pframe move to end */
+				pframe +=3D insert_len;
+				pattrib->pktlen +=3D insert_len;
+
+				/* copy remainder_ie to pframe */
+				memcpy(pframe, premainder_ie, remainder_ielen);
+				pframe +=3D remainder_ielen;
+				pattrib->pktlen +=3D remainder_ielen;
+			}
+		} else
+#endif /* CONFIG_P2P */
+		{
+			int len_diff;
+			memcpy(pframe, cur_network->IEs, cur_network->IELength);
+			len_diff =3D update_hidden_ssid(
+					   pframe + _BEACON_IE_OFFSET_
+				   , cur_network->IELength - _BEACON_IE_OFFSET_
+					   , pmlmeinfo->hidden_ssid_mode
+				   );
+			pframe +=3D (cur_network->IELength + len_diff);
