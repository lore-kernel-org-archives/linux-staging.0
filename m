+static void eap_fast_write(char **buf, char **pos, size_t *buf_len,
+			   const char *field, const u8 *data,
+			   size_t len, int txt)
+{
+	size_t i, need;
+	int ret;
+	char *end;
+
+	if (data =3D=3D NULL || buf =3D=3D NULL || *buf =3D=3D NULL ||
+	    pos =3D=3D NULL || *pos =3D=3D NULL || *pos < *buf)
+		return;
+
+	need =3D os_strlen(field) + len * 2 + 30;
+	if (txt)
+		need +=3D os_strlen(field) + len + 20;
+
+	if (*pos - *buf + need > *buf_len) {
+		char *nbuf =3D os_realloc(*buf, *buf_len + need);
+		if (nbuf =3D=3D NULL) {
+			os_free(*buf);
+			*buf =3D NULL;
+			return;
+		}
+		*pos =3D nbuf + (*pos - *buf);
+		*buf =3D nbuf;
+		*buf_len +=3D need;
+	}
+	end =3D *buf + *buf_len;
+
+	ret =3D os_snprintf(*pos, end - *pos, "%s=3D", field);
+	if (ret < 0 || ret >=3D end - *pos)
+		return;
+	*pos +=3D ret;
+	*pos +=3D wpa_snprintf_hex(*pos, end - *pos, data, len);
+	ret =3D os_snprintf(*pos, end - *pos, "\n");
+	if (ret < 0 || ret >=3D end - *pos)
+		return;
+	*pos +=3D ret;
+
+	if (txt) {
+		ret =3D os_snprintf(*pos, end - *pos, "%s-txt=3D", field);
+		if (ret < 0 || ret >=3D end - *pos)
+			return;
+		*pos +=3D ret;
+		for (i =3D 0; i < len; i++) {
+			ret =3D os_snprintf(*pos, end - *pos, "%c", data[i]);
+			if (ret < 0 || ret >=3D end - *pos)
+				return;
+			*pos +=3D ret;
+		}
+		ret =3D os_snprintf(*pos, end - *pos, "\n");
+		if (ret < 0 || ret >=3D end - *pos)
+			return;
+		*pos +=3D ret;
+	}
+}
