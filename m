+u8 rtw_getmacreg_hdl(_adapter *padapter, u8 *pbuf)
+{
+
+	struct readMAC_parm *preadmacparm =3D NULL;
+	u8 sz =3D 0;
+	u32	addr =3D 0;
+	u32	value =3D 0;
+
+	if (!pbuf)
+		return H2C_PARAMETERS_ERROR;
+
+	preadmacparm =3D (struct readMAC_parm *) pbuf;
+	sz =3D preadmacparm->len;
+	addr =3D preadmacparm->addr;
+	value =3D 0;
+
+	switch (sz) {
+	case 1:
+		value =3D rtw_read8(padapter, addr);
+		break;
+	case 2:
+		value =3D rtw_read16(padapter, addr);
+		break;
+	case 4:
+		value =3D rtw_read32(padapter, addr);
+		break;
+	default:
+		RTW_INFO("%s: Unknown size\n", __func__);
+		break;
+	}
+	RTW_INFO("%s: addr:0x%02x valeu:0x%02x\n", __func__, addr, value);
+
+	return H2C_SUCCESS;
+}
