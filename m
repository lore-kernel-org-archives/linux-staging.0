+		if (pmlmepriv->wps_probe_req_ie =3D=3D NULL) {
+			/*	UUID-E */
+			/*	Type: */
+			*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_ATTR_UUID_E);
+			wpsielen +=3D 2;
+
+			/*	Length: */
+			*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(0x0010);
+			wpsielen +=3D 2;
+			/*	Value: */
+			if (pwdinfo->external_uuid =3D=3D 0) {
+				memset(wpsie + wpsielen, 0x0, 16);
+				memcpy(wpsie + wpsielen, mac, ETH_ALEN);
+			} else
+				memcpy(wpsie + wpsielen, pwdinfo->uuid, 0x10);
+			wpsielen +=3D 0x10;
+
+			/*	Config Method */
+			/*	Type: */
+			*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_ATTR_CONF_METHOD);
+			wpsielen +=3D 2;
+
+			/*	Length: */
+			*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(0x0002);
+			wpsielen +=3D 2;
+
+			/*	Value: */
+			*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(pwdinfo->supported_wps_cm=
);
+			wpsielen +=3D 2;
+		}
+
+		/*	Device Name */
+		/*	Type: */
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_ATTR_DEVICE_NAME);
+		wpsielen +=3D 2;
+
+		/*	Length: */
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(pwdinfo->device_name_len);
+		wpsielen +=3D 2;
+
+		/*	Value: */
+		memcpy(wpsie + wpsielen, pwdinfo->device_name, pwdinfo->device_name_len);
+		wpsielen +=3D pwdinfo->device_name_len;
+
+		/*	Primary Device Type */
+		/*	Type: */
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_ATTR_PRIMARY_DEV_TYPE);
+		wpsielen +=3D 2;
+
+		/*	Length: */
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(0x0008);
+		wpsielen +=3D 2;
+
+		/*	Value: */
+		/*	Category ID */
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_PDT_CID_RTK_WIDI);
+		wpsielen +=3D 2;
+
+		/*	OUI */
+		*(__be32 *)(wpsie + wpsielen) =3D cpu_to_be32(WPSOUI);
+		wpsielen +=3D 4;
+
+		/*	Sub Category ID */
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_PDT_SCID_RTK_DMP);
+		wpsielen +=3D 2;
+
+		/*	Device Password ID */
+		/*	Type: */
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_ATTR_DEVICE_PWID);
+		wpsielen +=3D 2;
+
+		/*	Length: */
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(0x0002);
+		wpsielen +=3D 2;
+
+		/*	Value: */
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_DPID_REGISTRAR_SPEC);	=
/*	Registrar-specified */
+		wpsielen +=3D 2;
+
+		pframe =3D rtw_set_ie(pframe, _VENDOR_SPECIFIC_IE_, wpsielen, (unsigned =
char *) wpsie, &pattrib->pktlen);
+
+		/*	P2P OUI */
+		p2pielen =3D 0;
+		p2pie[p2pielen++] =3D 0x50;
+		p2pie[p2pielen++] =3D 0x6F;
+		p2pie[p2pielen++] =3D 0x9A;
+		p2pie[p2pielen++] =3D 0x09;	/*	WFA P2P v1.0 */
+
+		/*	Commented by Albert 20110221 */
+		/*	According to the P2P Specification, the probe request frame should co=
ntain 5 P2P attributes */
+		/*	1. P2P Capability */
+		/*	2. P2P Device ID if this probe request wants to find the specific P2P=
 device */
+		/*	3. Listen Channel */
+		/*	4. Extended Listen Timing */
+		/*	5. Operating Channel if this WiFi is working as the group owner now */
+
+		/*	P2P Capability */
+		/*	Type: */
+		p2pie[p2pielen++] =3D P2P_ATTR_CAPABILITY;
+
+		/*	Length: */
+		*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0002);
+		p2pielen +=3D 2;
+
+		/*	Value: */
+		/*	Device Capability Bitmap, 1 byte */
+		p2pie[p2pielen++] =3D DMP_P2P_DEVCAP_SUPPORT;
+
+		/*	Group Capability Bitmap, 1 byte */
+		if (pwdinfo->persistent_supported)
+			p2pie[p2pielen++] =3D P2P_GRPCAP_PERSISTENT_GROUP | DMP_P2P_GRPCAP_SUPP=
ORT;
+		else
+			p2pie[p2pielen++] =3D DMP_P2P_GRPCAP_SUPPORT;
+
+		/*	Listen Channel */
+		/*	Type: */
+		p2pie[p2pielen++] =3D P2P_ATTR_LISTEN_CH;
+
+		/*	Length: */
+		*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0005);
+		p2pielen +=3D 2;
+
+		/*	Value: */
+		/*	Country String */
+		p2pie[p2pielen++] =3D 'X';
+		p2pie[p2pielen++] =3D 'X';
+
+		/*	The third byte should be set to 0x04. */
+		/*	Described in the "Operating Channel Attribute" section. */
+		p2pie[p2pielen++] =3D 0x04;
+
+		/*	Operating Class */
+		p2pie[p2pielen++] =3D 0x51;	/*	Copy from SD7 */
+
+		/*	Channel Number */
+		p2pie[p2pielen++] =3D pwdinfo->listen_channel;	/*	listen channel */
+
+
+		/*	Extended Listen Timing */
+		/*	Type: */
+		p2pie[p2pielen++] =3D P2P_ATTR_EX_LISTEN_TIMING;
+
+		/*	Length: */
+		*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0004);
+		p2pielen +=3D 2;
+
+		/*	Value: */
+		/*	Availability Period */
+		*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0xFFFF);
+		p2pielen +=3D 2;
+
+		/*	Availability Interval */
+		*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0xFFFF);
+		p2pielen +=3D 2;
+
+		if (rtw_p2p_chk_role(pwdinfo, P2P_ROLE_GO)) {
+			/*	Operating Channel (if this WiFi is working as the group owner now) */
+			/*	Type: */
+			p2pie[p2pielen++] =3D P2P_ATTR_OPERATING_CH;
+
+			/*	Length: */
+			*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0005);
+			p2pielen +=3D 2;
+
+			/*	Value: */
+			/*	Country String */
+			p2pie[p2pielen++] =3D 'X';
+			p2pie[p2pielen++] =3D 'X';
+
+			/*	The third byte should be set to 0x04. */
+			/*	Described in the "Operating Channel Attribute" section. */
+			p2pie[p2pielen++] =3D 0x04;
+
+			/*	Operating Class */
+			p2pie[p2pielen++] =3D 0x51;	/*	Copy from SD7 */
+
+			/*	Channel Number */
+			p2pie[p2pielen++] =3D pwdinfo->operating_channel;	/*	operating channel =
number */
+
+		}
+
+		pframe =3D rtw_set_ie(pframe, _VENDOR_SPECIFIC_IE_, p2pielen, (unsigned =
char *) p2pie, &pattrib->pktlen);
+
+	}
+
+#ifdef CONFIG_WFD
+	wfdielen =3D rtw_append_probe_req_wfd_ie(padapter, pframe);
+	pframe +=3D wfdielen;
+	pattrib->pktlen +=3D wfdielen;
+#endif
+
+	pattrib->last_txcmdsz =3D pattrib->pktlen;
+
+
+	if (wait_ack)
+		ret =3D dump_mgntframe_and_wait_ack(padapter, pmgntframe);
+	else {
+		dump_mgntframe(padapter, pmgntframe);
+		ret =3D _SUCCESS;
+	}
+
+exit:
+	return ret;
+}
