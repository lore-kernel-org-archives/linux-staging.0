+static int eap_fast_parse_phase1(struct eap_fast_data *data,
+				 const char *phase1)
+{
+	const char *pos;
+
+	pos =3D os_strstr(phase1, "fast_provisioning=3D");
+	if (pos) {
+		data->provisioning_allowed =3D atoi(pos + 18);
+		wpa_printf(MSG_DEBUG, "EAP-FAST: Automatic PAC provisioning "
+			   "mode: %d", data->provisioning_allowed);
+	}
+
+	pos =3D os_strstr(phase1, "fast_max_pac_list_len=3D");
+	if (pos) {
+		data->max_pac_list_len =3D atoi(pos + 22);
+		if (data->max_pac_list_len =3D=3D 0)
+			data->max_pac_list_len =3D 1;
+		wpa_printf(MSG_DEBUG, "EAP-FAST: Maximum PAC list length: %lu",
+			   (unsigned long) data->max_pac_list_len);
+	}
+
+	pos =3D os_strstr(phase1, "fast_pac_format=3Dbinary");
+	if (pos) {
+		data->use_pac_binary_format =3D 1;
+		wpa_printf(MSG_DEBUG, "EAP-FAST: Using binary format for PAC "
+			   "list");
+	}
+
+	return 0;
+}
