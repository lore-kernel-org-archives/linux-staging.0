+void dump_tx_power_limit(void *sel, _adapter *adapter)
+{
+	struct hal_spec_t *hal_spec =3D GET_HAL_SPEC(adapter);
+	HAL_DATA_TYPE *hal_data =3D GET_HAL_DATA(adapter);
+	struct registry_priv *regsty =3D dvobj_to_regsty(adapter_to_dvobj(adapter=
));
+
+	int bw, band, ch_num, rs, i, path;
+	u8 ch, n, rd, rfpath_num;
+
+	for (band =3D BAND_ON_2_4G; band <=3D BAND_ON_5G; band++) {
+		if (!hal_is_band_support(adapter, band))
+			continue;
+
+		rd =3D (band =3D=3D BAND_ON_2_4G ? hal_data->Regulation2_4G : hal_data->=
Regulation5G);
+		rfpath_num =3D (band =3D=3D BAND_ON_2_4G ? hal_spec->rfpath_num_2g : hal=
_spec->rfpath_num_5g);
+
+		for (bw =3D 0; bw < MAX_5G_BANDWIDTH_NUM; bw++) {
+
+			if (bw >=3D CHANNEL_WIDTH_160)
+				break;
+			if (band =3D=3D BAND_ON_2_4G && bw >=3D CHANNEL_WIDTH_80)
+				break;
+
+			if (band =3D=3D BAND_ON_2_4G)
+				ch_num =3D CENTER_CH_2G_NUM;
+			else
+				ch_num =3D center_chs_5g_num(bw);
+
+			if (ch_num =3D=3D 0) {
+				rtw_warn_on(1);
+				break;
+			}
+
+			for (rs =3D 0; rs < RATE_SECTION_NUM; rs++) {
+				if (band =3D=3D BAND_ON_2_4G && IS_VHT_RATE_SECTION(rs))
+					continue;
+				if (band =3D=3D BAND_ON_5G && IS_CCK_RATE_SECTION(rs))
+					continue;
+				if (bw > CHANNEL_WIDTH_20 && (IS_CCK_RATE_SECTION(rs) || IS_OFDM_RATE_=
SECTION(rs)))
+					continue;
+				if (bw > CHANNEL_WIDTH_40 && IS_HT_RATE_SECTION(rs))
+					continue;
+
+				if (rate_section_to_tx_num(rs) >=3D hal_spec->tx_nss_num)
+					continue;
+
+				if (IS_VHT_RATE_SECTION(rs))
+					continue;
+
+				/* by pass 5G 20M, 40M pure reference */
+				if (band =3D=3D BAND_ON_5G && (bw =3D=3D CHANNEL_WIDTH_20 || bw =3D=3D=
 CHANNEL_WIDTH_40)) {
+					if (hal_data->tx_pwr_lmt_5g_20_40_ref =3D=3D TX_PWR_LMT_REF_HT_FROM_V=
HT) {
+						if (IS_HT_RATE_SECTION(rs))
+							continue;
+					} else if (hal_data->tx_pwr_lmt_5g_20_40_ref =3D=3D TX_PWR_LMT_REF_VH=
T_FROM_HT) {
+						if (IS_VHT_RATE_SECTION(rs) && bw <=3D CHANNEL_WIDTH_40)
+							continue;
+					}
+				}
+
+				RTW_PRINT_SEL(sel, "[%s][%s][%s]\n"
+					, band_str(band)
+					, ch_width_str(bw)
+					, rate_section_str(rs)
+				);
+
+				/* header for limit in db */
+				RTW_PRINT_SEL(sel, "%3s %5s %5s %5s %5s "
+					, "ch"
+					, (rd =3D=3D TXPWR_LMT_FCC ? "*FCC" : "FCC")
+					, (rd =3D=3D TXPWR_LMT_ETSI ? "*ETSI" : "ETSI")
+					, (rd =3D=3D TXPWR_LMT_MKK ? "*MKK" : "MKK")
+					, (rd =3D=3D TXPWR_LMT_WW ? "*WW" : "WW")
+				);
+
+				/* header for limit offset */
+				for (path =3D 0; path < RF_PATH_MAX; path++) {
+					if (path >=3D rfpath_num)
+						break;
+					_RTW_PRINT_SEL(sel, "|%3c %3c %3c %3c "
+						, (rd =3D=3D TXPWR_LMT_FCC ? rf_path_char(path) : ' ')
+						, (rd =3D=3D TXPWR_LMT_ETSI ? rf_path_char(path) : ' ')
+						, (rd =3D=3D TXPWR_LMT_MKK ? rf_path_char(path) : ' ')
+						, (rd =3D=3D TXPWR_LMT_WW ? rf_path_char(path) : ' ')
+					);
+				}
+				_RTW_PRINT_SEL(sel, "\n");
+
+				for (n =3D 0; n < ch_num; n++) {
+					s8 limit_idx[RF_PATH_MAX][MAX_REGULATION_NUM];
+					s8 limit_offset[MAX_REGULATION_NUM];
+					u8 base;
+
+					if (band =3D=3D BAND_ON_2_4G)
+						ch =3D n + 1;
+					else
+						ch =3D center_chs_5g(bw, n);
+
+					if (ch =3D=3D 0) {
+						rtw_warn_on(1);
+						break;
+					}
+
+					/* dump limit in db (calculate from path A) */
+					limit_offset[0] =3D PHY_GetTxPowerLimit_no_sc(adapter, 3, band, bw, R=
F_PATH_A, rates_by_sections[rs].rates[0], ch); /* FCC */
+					limit_offset[1] =3D PHY_GetTxPowerLimit_no_sc(adapter, 1, band, bw, R=
F_PATH_A, rates_by_sections[rs].rates[0], ch); /* ETSI */
+					limit_offset[2] =3D PHY_GetTxPowerLimit_no_sc(adapter, 2, band, bw, R=
F_PATH_A, rates_by_sections[rs].rates[0], ch); /* MKK */
+					limit_offset[3] =3D PHY_GetTxPowerLimit_no_sc(adapter, 4, band, bw, R=
F_PATH_A, rates_by_sections[rs].rates[0], ch); /* WW */
+
+					base =3D PHY_GetTxPowerByRateBase(adapter, band, RF_PATH_A, rate_sect=
ion_to_tx_num(rs), rs);
+
+					RTW_PRINT_SEL(sel, "%3u ", ch);
+					for (i =3D 0; i < MAX_REGULATION_NUM; i++) {
+						if (limit_offset[i] =3D=3D MAX_POWER_INDEX) {
+							limit_idx[0][i] =3D MAX_POWER_INDEX;
+							_RTW_PRINT_SEL(sel, "%5s ", "NA");
+						} else {
+							limit_idx[0][i] =3D limit_offset[i] + base;
+							if ((limit_offset[i] + base) % 2)
+								_RTW_PRINT_SEL(sel, "%3d.5 ", (limit_offset[i] + base) / 2);
+							else
+								_RTW_PRINT_SEL(sel, "%5d ", (limit_offset[i] + base) / 2);
+						}
+					}
+
+					/* dump limit offset of each path */
+					for (path =3D 0; path < RF_PATH_MAX; path++) {
+						if (path >=3D rfpath_num)
+							break;
+						limit_offset[0] =3D PHY_GetTxPowerLimit_no_sc(adapter, 3, band, bw, =
path, rates_by_sections[rs].rates[0], ch); /* FCC */
+						limit_offset[1] =3D PHY_GetTxPowerLimit_no_sc(adapter, 1, band, bw, =
path, rates_by_sections[rs].rates[0], ch); /* ETSI */
+						limit_offset[2] =3D PHY_GetTxPowerLimit_no_sc(adapter, 2, band, bw, =
path, rates_by_sections[rs].rates[0], ch); /* MKK */
+						limit_offset[3] =3D PHY_GetTxPowerLimit_no_sc(adapter, 4, band, bw, =
path, rates_by_sections[rs].rates[0], ch); /* WW */
+
+						base =3D PHY_GetTxPowerByRateBase(adapter, band, path, rate_section_=
to_tx_num(rs), rs);
+
+						_RTW_PRINT_SEL(sel, "|");
+						for (i =3D 0; i < MAX_REGULATION_NUM; i++) {
+							if (limit_offset[i] =3D=3D MAX_POWER_INDEX) {
+								limit_idx[path][i] =3D MAX_POWER_INDEX;
+								_RTW_PRINT_SEL(sel, "%3s ", "NA");
+							} else {
+								limit_idx[path][i] =3D limit_offset[i] + base;
+								_RTW_PRINT_SEL(sel, "%3d ", limit_offset[i]);
+							}
+						}
+					}
+
+					/* compare limit_idx of each path, print 'x' when mismatch */
+					if (rfpath_num > 1) {
+						for (i =3D 0; i < MAX_REGULATION_NUM; i++) {
+							for (path =3D 0; path < RF_PATH_MAX; path++) {
+								if (path >=3D rfpath_num)
+									break;
+								if (limit_idx[path][i] !=3D limit_idx[(path + 1) % rfpath_num][i])
+									break;
+							}
+							if (path >=3D rfpath_num)
+								_RTW_PRINT_SEL(sel, " ");
+							else
+								_RTW_PRINT_SEL(sel, "x");
+						}
+					}
+					_RTW_PRINT_SEL(sel, "\n");
+
+				}
+				RTW_PRINT_SEL(sel, "\n");
+			} /* loop for rate sections */
+		} /* loop for bandwidths */
+	} /* loop for bands */
+}
