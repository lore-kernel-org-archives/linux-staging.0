+		result |=3D 0x01;
+	else
+		return result;
+
+	if (!(reg_eac & BIT(30)) &&
+	    (((reg_ec4 & 0x03FF0000) >> 16) !=3D 0x132) &&
+	    (((reg_ecc & 0x03FF0000) >> 16) !=3D 0x36))
+		result |=3D 0x02;
+	else
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("path B Rx I=
QK fail!!\n"));
+
+	return result;
+
