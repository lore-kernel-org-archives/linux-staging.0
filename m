+static int uuid_str2bin(const char *str, u8 *bin)
+{
+	const char *pos;
+	u8 *opos;
+
+	pos =3D str;
+	opos =3D bin;
+
+	if (hexstr2bin(pos, opos, 4))
+		return -1;
+	pos +=3D 8;
+	opos +=3D 4;
+
+	if (*pos++ !=3D '-' || hexstr2bin(pos, opos, 2))
+		return -1;
+	pos +=3D 4;
+	opos +=3D 2;
+
+	if (*pos++ !=3D '-' || hexstr2bin(pos, opos, 2))
+		return -1;
+	pos +=3D 4;
+	opos +=3D 2;
+
+	if (*pos++ !=3D '-' || hexstr2bin(pos, opos, 2))
+		return -1;
+	pos +=3D 4;
+	opos +=3D 2;
+
+	if (*pos++ !=3D '-' || hexstr2bin(pos, opos, 6))
+		return -1;
+
+	return 0;
+}
