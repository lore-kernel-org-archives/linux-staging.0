+static void rtw_ap_check_scan(_adapter *padapter)
+{
+	unsigned long	irqL;
+	_list		*plist, *phead;
+	u32	delta_time, lifetime;
+	struct	wlan_network	*pnetwork =3D NULL;
+	WLAN_BSSID_EX *pbss =3D NULL;
+	struct	mlme_priv	*pmlmepriv =3D &(padapter->mlmepriv);
+	_queue	*queue	=3D &(pmlmepriv->scanned_queue);
+	u8 do_scan =3D false;
+	u8 reason =3D RTW_AUTO_SCAN_REASON_UNSPECIFIED;
+
+	lifetime =3D SCANQUEUE_LIFETIME; /* 20 sec */
+
+	_enter_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+	phead =3D get_list_head(queue);
+	if (rtw_end_of_queue_search(phead, get_next(phead)) )
+		if (padapter->registrypriv.wifi_spec) {
+			do_scan =3D true;
+			reason |=3D RTW_AUTO_SCAN_REASON_2040_BSS;
+		}
+	_exit_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+
+#ifdef CONFIG_AUTO_CHNL_SEL_NHM
+	if (padapter->registrypriv.acs_auto_scan) {
+		do_scan =3D true;
+		reason |=3D RTW_AUTO_SCAN_REASON_ACS;
+		rtw_acs_start(padapter, true);
+	}
+#endif
+
+	if (do_scan) {
+		RTW_INFO("%s : drv scans by itself and wait_completed\n", __func__);
+		rtw_drv_scan_by_self(padapter, reason);
+		rtw_scan_wait_completed(padapter);
+	}
+
+#ifdef CONFIG_AUTO_CHNL_SEL_NHM
+	if (padapter->registrypriv.acs_auto_scan)
+		rtw_acs_start(padapter, false);
+#endif
+	_enter_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+
+	phead =3D get_list_head(queue);
+	plist =3D get_next(phead);
+
+	while (1) {
+
+		if (rtw_end_of_queue_search(phead, plist) )
+			break;
+
+		pnetwork =3D LIST_CONTAINOR(plist, struct wlan_network, list);
+
+		if (rtw_ch_set_search_ch(padapter->mlmeextpriv.channel_set, pnetwork->ne=
twork.Configuration.DSConfig) >=3D 0
+		    && rtw_mlme_band_check(padapter, pnetwork->network.Configuration.DSC=
onfig)=20
+		    && rtw_validate_ssid(&(pnetwork->network.Ssid))) {
+			delta_time =3D (u32) rtw_get_passing_time_ms(pnetwork->last_scanned);
+
+			if (delta_time < lifetime) {
+
+				uint ie_len =3D 0;
+				u8 *pbuf =3D NULL;
+				u8 *ie =3D NULL;
+
+				pbss =3D &pnetwork->network;
+				ie =3D pbss->IEs;
+
+				/*check if HT CAP INFO IE exists or not*/
+				pbuf =3D rtw_get_ie(ie + _BEACON_IE_OFFSET_, _HT_CAPABILITY_IE_, &ie_l=
en, (pbss->IELength - _BEACON_IE_OFFSET_));
+				if (pbuf =3D=3D NULL) {
+					/* HT CAP INFO IE don't exist, it is b/g mode bss.*/
+
+					if (false =3D=3D ATOMIC_READ(&pmlmepriv->olbc))
+						ATOMIC_SET(&pmlmepriv->olbc, true);
+
+					if (false =3D=3D ATOMIC_READ(&pmlmepriv->olbc_ht))
+						ATOMIC_SET(&pmlmepriv->olbc_ht, true);
+=09=09=09=09=09
+					if (padapter->registrypriv.wifi_spec)
+						RTW_INFO("%s: %s is a/b/g ap\n", __func__, pnetwork->network.Ssid.Ss=
id);
+				}
+			}
+		}
+
+		plist =3D get_next(plist);
+
+	}
+
+	_exit_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+
+	pmlmepriv->num_sta_no_ht =3D 0; /* reset to 0 after ap do scanning*/
+
+}
