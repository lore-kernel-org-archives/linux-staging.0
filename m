+/* called > TSR LEVEL for USB or SDIO Interface*/
+void sta_info_update(_adapter *padapter, struct sta_info *psta)
+{
+	int flags =3D psta->flags;
+	struct mlme_priv *pmlmepriv =3D &(padapter->mlmepriv);
+
+
+	/* update wmm cap. */
