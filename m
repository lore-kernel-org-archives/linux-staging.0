+unsigned int OnAction_back(_adapter *padapter, union recv_frame *precv_fra=
me)
+{
+	u8 *addr;
+	struct sta_info *psta =3D NULL;
+	struct recv_reorder_ctrl *preorder_ctrl;
+	unsigned char		*frame_body;
+	unsigned char		category, action;
+	unsigned short	tid, status, reason_code =3D 0;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	u8 *pframe =3D precv_frame->u.hdr.rx_data;
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+
+
+	RTW_INFO("%s\n", __func__);
+
+	/* check RA matches or not	 */
+	if (memcmp(adapter_mac_addr(padapter), GetAddr1Ptr(pframe), ETH_ALEN))
+		return _SUCCESS;
+
+	if ((pmlmeinfo->state & 0x03) !=3D WIFI_FW_AP_STATE)
+		if (!(pmlmeinfo->state & WIFI_FW_ASSOC_SUCCESS))
+			return _SUCCESS;
+
+	addr =3D get_addr2_ptr(pframe);
+	psta =3D rtw_get_stainfo(pstapriv, addr);
+
+	if (psta =3D=3D NULL)
+		return _SUCCESS;
+
+	frame_body =3D (unsigned char *)(pframe + sizeof(struct rtw_ieee80211_hdr=
_3addr));
+
+	category =3D frame_body[0];
+	if (category =3D=3D RTW_WLAN_CATEGORY_BACK) { /* representing Block Ack */
+#ifdef CONFIG_TDLS
+		if ((psta->tdls_sta_state & TDLS_LINKED_STATE) &&
+		    (psta->htpriv.ht_option) &&
+		    (psta->htpriv.ampdu_enable))
+			RTW_INFO("Recv [%s] from direc link\n", __func__);
+		else
+#endif /* CONFIG_TDLS */
+			if (!pmlmeinfo->HT_enable)
+				return _SUCCESS;
+
+		action =3D frame_body[1];
+		RTW_INFO("%s, action=3D%d\n", __func__, action);
+		switch (action) {
+		case RTW_WLAN_ACTION_ADDBA_REQ: /* ADDBA request */
+
+			memcpy(&(pmlmeinfo->ADDBA_req), &(frame_body[2]), sizeof(struct ADDBA_r=
equest));
+			/* process_addba_req(padapter, (u8*)&(pmlmeinfo->ADDBA_req), GetAddr3Pt=
r(pframe)); */
+			process_addba_req(padapter, (u8 *)&(pmlmeinfo->ADDBA_req), addr);
+
+			break;
+
+		case RTW_WLAN_ACTION_ADDBA_RESP: /* ADDBA response */
+
+			/* status =3D frame_body[3] | (frame_body[4] << 8); */ /* endian issue =
*/
+			status =3D RTW_GET_LE16(&frame_body[3]);
+			tid =3D ((frame_body[5] >> 2) & 0x7);
+			if (status =3D=3D 0) {
+				/* successful					 */
+				RTW_INFO("agg_enable for TID=3D%d\n", tid);
+				psta->htpriv.agg_enable_bitmap |=3D 1 << tid;
+				psta->htpriv.candidate_tid_bitmap &=3D ~BIT(tid);
+				/* amsdu in ampdu */
+				if (frame_body[5] & 1)
+					psta->htpriv.tx_amsdu_enable =3D true;
+			} else
+				psta->htpriv.agg_enable_bitmap &=3D ~BIT(tid);
+
+			if (psta->state & WIFI_STA_ALIVE_CHK_STATE) {
+				RTW_INFO("%s alive check - rx ADDBA response\n", __func__);
+				psta->htpriv.agg_enable_bitmap &=3D ~BIT(tid);
+				psta->expire_to =3D pstapriv->expire_to;
+				psta->state ^=3D WIFI_STA_ALIVE_CHK_STATE;
+			}
+
+			/* RTW_INFO("marc: ADDBA RSP: %x\n", pmlmeinfo->agg_enable_bitmap); */
+			break;
+
+		case RTW_WLAN_ACTION_DELBA: /* DELBA */
+			if ((frame_body[3] & BIT(3)) =3D=3D 0) {
+				psta->htpriv.agg_enable_bitmap &=3D ~(1 << ((frame_body[3] >> 4) & 0xf=
));
+				psta->htpriv.candidate_tid_bitmap &=3D ~(1 << ((frame_body[3] >> 4) & =
0xf));
+
+				/* reason_code =3D frame_body[4] | (frame_body[5] << 8); */
+				reason_code =3D RTW_GET_LE16(&frame_body[4]);
+			} else if ((frame_body[3] & BIT(3)) =3D=3D BIT(3)) {
+				tid =3D (frame_body[3] >> 4) & 0x0F;
+
+				preorder_ctrl =3D &psta->recvreorder_ctrl[tid];
+				preorder_ctrl->enable =3D false;
+				preorder_ctrl->ampdu_size =3D RX_AMPDU_SIZE_INVALID;
+			}
+
+			RTW_INFO("%s(): DELBA: %x(%x)\n", __func__, pmlmeinfo->agg_enable_bitma=
p, reason_code);
+			/* todo: how to notify the host while receiving DELETE BA */
+			break;
+
+		default:
+			break;
+		}
+	}
+	return _SUCCESS;
+}
