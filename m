+				wdata |=3D WOW_MC_BIT;
+			if (PATTERN_UNICAST =3D=3D context->type)
+				wdata |=3D WOW_UC_BIT;
+			if (PATTERN_INVALID !=3D context->type)
+				wdata |=3D WOW_VALID_BIT;
+			break;
+		default:
+			wdata =3D context->mask[j];
+			break;
+		}
