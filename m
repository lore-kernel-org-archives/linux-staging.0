index 000000000000..592ef13003a4
--- /dev/null
+++ b/drivers/staging/rtl8188eu/hostapd-0.8/src/eap_peer/eap_psk.c
@@ -0,0 +1,483 @@
+/*
+ * EAP peer method: EAP-PSK (RFC 4764)
+ * Copyright (c) 2004-2008, Jouni Malinen <j@w1.fi>
+ *
