+	pftpriv =3D &pmlmepriv->ftpriv;
+	pie =3D rtw_get_ie(pftpriv->updated_ft_ies, EID_WPA2, &ft_ie_len, pftpriv=
->updated_ft_ies_len);
+	if (pie)
+		pframe =3D rtw_set_ie(pframe, EID_WPA2, ft_ie_len, pie+2, &(pattrib->pkt=
len));
+	else
+		is_ft_roaming_with_rsn_ie =3D false;
+
+	pie =3D rtw_get_ie(pftpriv->updated_ft_ies, _MDIE_, &ft_ie_len, pftpriv->=
updated_ft_ies_len);
+	if (pie)
+		pframe =3D rtw_set_ie(pframe, _MDIE_, ft_ie_len , pie+2, &(pattrib->pktl=
en));
+
+	pie =3D rtw_get_ie(pftpriv->updated_ft_ies, _FTIE_, &ft_ie_len, pftpriv->=
updated_ft_ies_len);
+	if (pie && is_ft_roaming_with_rsn_ie)
+		pframe =3D rtw_set_ie(pframe, _FTIE_, ft_ie_len , pie+2, &(pattrib->pktl=
en));
+
+	pattrib->last_txcmdsz =3D pattrib->pktlen;
+	dump_mgntframe(padapter, pmgntframe);
+}
