+	memcpy(p2pie + p2pielen, pwdinfo->invitereq_info.go_bssid, ETH_ALEN);
+	p2pielen +=3D ETH_ALEN;
+
+	/*	SSID */
+	memcpy(p2pie + p2pielen, pwdinfo->invitereq_info.go_ssid, pwdinfo->invite=
req_info.ssidlen);
+	p2pielen +=3D pwdinfo->invitereq_info.ssidlen;
+
+
+	/*	Device Info */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_DEVICE_INFO;
+
+	/*	Length: */
+	/*	21->P2P Device Address (6bytes) + Config Methods (2bytes) + Primary De=
vice Type (8bytes)  */
+	/*	+ NumofSecondDevType (1byte) + WPS Device Name ID field (2bytes) + WPS=
 Device Name Len field (2bytes) */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(21 + pwdinfo->device_name_l=
en);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	/*	P2P Device Address */
+	memcpy(p2pie + p2pielen, adapter_mac_addr(padapter), ETH_ALEN);
+	p2pielen +=3D ETH_ALEN;
+
+	/*	Config Method */
+	/*	This field should be big endian. Noted by P2P specification. */
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(WPS_CONFIG_METHOD_DISPLAY);
+	p2pielen +=3D 2;
+
+	/*	Primary Device Type */
+	/*	Category ID */
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(WPS_PDT_CID_MULIT_MEDIA);
+	p2pielen +=3D 2;
+
+	/*	OUI */
+	*(__be32 *)(p2pie + p2pielen) =3D cpu_to_be32(WPSOUI);
+	p2pielen +=3D 4;
+
+	/*	Sub Category ID */
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(WPS_PDT_SCID_MEDIA_SERVER);
+	p2pielen +=3D 2;
+
+	/*	Number of Secondary Device Types */
+	p2pie[p2pielen++] =3D 0x00;	/*	No Secondary Device Type List */
+
+	/*	Device Name */
+	/*	Type: */
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(WPS_ATTR_DEVICE_NAME);
+	p2pielen +=3D 2;
+
+	/*	Length: */
+	*(__be16 *)(p2pie + p2pielen) =3D cpu_to_be16(pwdinfo->device_name_len);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	memcpy(p2pie + p2pielen, pwdinfo->device_name, pwdinfo->device_name_len);
+	p2pielen +=3D pwdinfo->device_name_len;
+
+	pframe =3D rtw_set_ie(pframe, _VENDOR_SPECIFIC_IE_, p2pielen, (unsigned c=
har *) p2pie, &pattrib->pktlen);
