+int rtw_parse_wpa_ie(u8 *wpa_ie, int wpa_ie_len, int *group_cipher, int *p=
airwise_cipher, int *is_8021x)
+{
+	int i, ret =3D _SUCCESS;
+	int left, count;
+	u8 *pos;
+	u8 SUITE_1X[4] =3D {0x00, 0x50, 0xf2, 1};
+
+	if (wpa_ie_len <=3D 0) {
+		/* No WPA IE - fail silently */
+		return _FAIL;
+	}
+
+
+	if ((*wpa_ie !=3D _WPA_IE_ID_) || (*(wpa_ie + 1) !=3D (u8)(wpa_ie_len - 2=
)) ||
+	    (memcmp(wpa_ie + 2, RTW_WPA_OUI_TYPE, WPA_SELECTOR_LEN)))
+		return _FAIL;
+
+	pos =3D wpa_ie;
+
+	pos +=3D 8;
+	left =3D wpa_ie_len - 8;
+
+
+	/* group_cipher */
+	if (left >=3D WPA_SELECTOR_LEN) {
+
+		*group_cipher =3D rtw_get_wpa_cipher_suite(pos);
+
+		pos +=3D WPA_SELECTOR_LEN;
+		left -=3D WPA_SELECTOR_LEN;
+
+	} else if (left > 0) {
+
+		return _FAIL;
+	}
+
+
+	/* pairwise_cipher */
+	if (left >=3D 2) {
+		/* count =3D le16_to_cpu(*(u16*)pos);	 */
+		count =3D RTW_GET_LE16(pos);
+		pos +=3D 2;
+		left -=3D 2;
+
+		if (count =3D=3D 0 || left < count * WPA_SELECTOR_LEN) {
+			return _FAIL;
+		}
+
+		for (i =3D 0; i < count; i++) {
+			*pairwise_cipher |=3D rtw_get_wpa_cipher_suite(pos);
+
+			pos +=3D WPA_SELECTOR_LEN;
+			left -=3D WPA_SELECTOR_LEN;
+		}
+
+	} else if (left =3D=3D 1) {
+		return _FAIL;
+	}
+
+	if (is_8021x) {
+		if (left >=3D 6) {
+			pos +=3D 2;
+			if (!memcmp(pos, SUITE_1X, 4)) {
+				*is_8021x =3D 1;
+			}
+		}
+	}
+
+	return ret;
+
+}
