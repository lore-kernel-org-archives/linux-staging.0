+/**
+ * hostapd_validate_bssid_configuration - Validate BSSID configuration
+ * @iface: Pointer to interface data
+ * Returns: 0 on success, -1 on failure
+ *
+ * This function is used to validate that the configured BSSIDs are valid.
+ */
+static int hostapd_validate_bssid_configuration(struct hostapd_iface *ifac=
e)
+{
+	u8 mask[ETH_ALEN] =3D { 0 };
+	struct hostapd_data *hapd =3D iface->bss[0];
+	unsigned int i =3D iface->conf->num_bss, bits =3D 0, j;
+	int res;
+	int auto_addr =3D 0;
+
+	if (hostapd_drv_none(hapd))
+		return 0;
+
+	/* Generate BSSID mask that is large enough to cover the BSSIDs. */
+
+	/* Determine the bits necessary to cover the number of BSSIDs. */
+	for (i--; i; i >>=3D 1)
+		bits++;
+
+	/* Determine the bits necessary to any configured BSSIDs,
+	   if they are higher than the number of BSSIDs. */
+	for (j =3D 0; j < iface->conf->num_bss; j++) {
+		if (hostapd_mac_comp_empty(iface->conf->bss[j].bssid) =3D=3D 0) {
+			if (j)
+				auto_addr++;
+			continue;
+		}
+
+		for (i =3D 0; i < ETH_ALEN; i++) {
+			mask[i] |=3D
+				iface->conf->bss[j].bssid[i] ^
+				hapd->own_addr[i];
+		}
+	}
+
+	if (!auto_addr)
+		goto skip_mask_ext;
+
+	for (i =3D 0; i < ETH_ALEN && mask[i] =3D=3D 0; i++)
+		;
+	j =3D 0;
+	if (i < ETH_ALEN) {
+		j =3D (5 - i) * 8;
+
+		while (mask[i] !=3D 0) {
+			mask[i] >>=3D 1;
+			j++;
+		}
+	}
+
+	if (bits < j)
+		bits =3D j;
+
+	if (bits > 40) {
+		wpa_printf(MSG_ERROR, "Too many bits in the BSSID mask (%u)",
+			   bits);
+		return -1;
+	}
+
+	os_memset(mask, 0xff, ETH_ALEN);
+	j =3D bits / 8;
+	for (i =3D 5; i > 5 - j; i--)
+		mask[i] =3D 0;
+	j =3D bits % 8;
+	while (j--)
+		mask[i] <<=3D 1;
+
+skip_mask_ext:
+	wpa_printf(MSG_DEBUG, "BSS count %lu, BSSID mask " MACSTR " (%d bits)",
+		   (unsigned long) iface->conf->num_bss, MAC2STR(mask), bits);
+
+	res =3D hostapd_valid_bss_mask(hapd, hapd->own_addr, mask);
+	if (res =3D=3D 0)
+		return 0;
+
+	if (res < 0) {
+		wpa_printf(MSG_ERROR, "Driver did not accept BSSID mask "
+			   MACSTR " for start address " MACSTR ".",
+			   MAC2STR(mask), MAC2STR(hapd->own_addr));
+		return -1;
+	}
+
+	if (!auto_addr)
+		return 0;
+
+	for (i =3D 0; i < ETH_ALEN; i++) {
+		if ((hapd->own_addr[i] & mask[i]) !=3D hapd->own_addr[i]) {
+			wpa_printf(MSG_ERROR, "Invalid BSSID mask " MACSTR
+				   " for start address " MACSTR ".",
+				   MAC2STR(mask), MAC2STR(hapd->own_addr));
+			wpa_printf(MSG_ERROR, "Start address must be the "
+				   "first address in the block (i.e., addr "
+				   "AND mask =3D=3D addr).");
+			return -1;
+		}
+	}
+
+	return 0;
+}
