+static struct tnc_if_imc * tncc_parse_imc(char *start, char *end, int *err=
or)
+{
+	struct tnc_if_imc *imc;
+	char *pos, *pos2;
+	int i;
+
+	for (i =3D 0; i < TNC_MAX_IMC_ID; i++) {
+		if (tnc_imc[i] =3D=3D NULL)
+			break;
+	}
+	if (i >=3D TNC_MAX_IMC_ID) {
+		wpa_printf(MSG_DEBUG, "TNC: Too many IMCs");
+		return NULL;
+	}
+
+	imc =3D os_zalloc(sizeof(*imc));
+	if (imc =3D=3D NULL) {
+		*error =3D 1;
+		return NULL;
+	}
+
+	imc->imcID =3D i;
+
+	pos =3D start;
+	wpa_printf(MSG_DEBUG, "TNC: Configured IMC: %s", pos);
+	if (pos + 1 >=3D end || *pos !=3D '"') {
+		wpa_printf(MSG_ERROR, "TNC: Ignoring invalid IMC line '%s' "
+			   "(no starting quotation mark)", start);
+		os_free(imc);
+		return NULL;
+	}
+
+	pos++;
+	pos2 =3D pos;
+	while (pos2 < end && *pos2 !=3D '"')
+		pos2++;
+	if (pos2 >=3D end) {
+		wpa_printf(MSG_ERROR, "TNC: Ignoring invalid IMC line '%s' "
+			   "(no ending quotation mark)", start);
+		os_free(imc);
+		return NULL;
+	}
+	*pos2 =3D '\0';
+	wpa_printf(MSG_DEBUG, "TNC: Name: '%s'", pos);
+	imc->name =3D os_strdup(pos);
+
+	pos =3D pos2 + 1;
+	if (pos >=3D end || *pos !=3D ' ') {
+		wpa_printf(MSG_ERROR, "TNC: Ignoring invalid IMC line '%s' "
+			   "(no space after name)", start);
+		os_free(imc->name);
+		os_free(imc);
+		return NULL;
+	}
+
+	pos++;
+	wpa_printf(MSG_DEBUG, "TNC: IMC file: '%s'", pos);
+	imc->path =3D os_strdup(pos);
+	tnc_imc[imc->imcID] =3D imc;
+
+	return imc;
+}
+
+
+static int tncc_read_config(struct tncc_data *tncc)
+{
+	char *config, *end, *pos, *line_end;
+	size_t config_len;
+	struct tnc_if_imc *imc, *last;
+
+	last =3D NULL;
+
+	config =3D os_readfile(TNC_CONFIG_FILE, &config_len);
+	if (config =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "TNC: Could not open TNC configuration "
+			   "file '%s'", TNC_CONFIG_FILE);
+		return -1;
+	}
+
+	end =3D config + config_len;
+	for (pos =3D config; pos < end; pos =3D line_end + 1) {
+		line_end =3D pos;
+		while (*line_end !=3D '\n' && *line_end !=3D '\r' &&
+		       line_end < end)
+			line_end++;
+		*line_end =3D '\0';
+
+		if (os_strncmp(pos, "IMC ", 4) =3D=3D 0) {
+			int error =3D 0;
+
+			imc =3D tncc_parse_imc(pos + 4, line_end, &error);
+			if (error)
+				return -1;
+			if (imc) {
+				if (last =3D=3D NULL)
+					tncc->imc =3D imc;
+				else
+					last->next =3D imc;
+				last =3D imc;
+			}
+		}
+	}
+
+	os_free(config);
+
+	return 0;
+}
+
+#endif /* CONFIG_NATIVE_WINDOWS */
