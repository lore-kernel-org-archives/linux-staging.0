+/*  11/16/2008 MH Write one byte to reald Efuse. */
+u8
+efuse_OneByteWrite(
+	PADAPTER	pAdapter,
+	u16			addr,
+	u8			data,
+	bool		bPseudoTest)
+{
+	u8	tmpidx =3D 0;
+	u8	bResult =3D false;
+	u32 efuseValue =3D 0;
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(pAdapter);
+
+	/* RTW_INFO("=3D=3D=3D> EFUSE_OneByteWrite(), addr =3D %x data=3D%x\n", a=
ddr, data); */
+	/* RTW_INFO("=3D=3D=3D> EFUSE_OneByteWrite() start, 0x34 =3D 0x%X\n", rtw=
_read32(pAdapter, EFUSE_TEST)); */
+
+	if (bPseudoTest) {
+		bResult =3D Efuse_Write1ByteToFakeContent(pAdapter, addr, data);
+		return bResult;
+	}
+
+	Efuse_PowerSwitch(pAdapter, true, true);
+
+	/* -----------------e-fuse reg ctrl ---------------------------------	 */
+	/* address			 */
+
+
+	efuseValue =3D rtw_read32(pAdapter, EFUSE_CTRL);
+	efuseValue |=3D (BIT21 | BIT31);
+	efuseValue &=3D ~(0x3FFFF);
+	efuseValue |=3D ((addr << 8 | data) & 0x3FFFF);
+
+	/* <20130227, Kordan> 8192E MP chip A-cut had better not set 0x34[11] unt=
il B-Cut. */
+	if ((IS_VENDOR_8188E_I_CUT_SERIES(pAdapter)) ||
+	    (IS_CHIP_VENDOR_SMIC(pHalData->version_id))) {
+		/* <20130121, Kordan> For SMIC EFUSE specificatoin. */
+		/* 0x34[11]: SW force PGMEN input of efuse to high. (for the bank select=
ed by 0x34[9:8]) */
+		/* phy_set_mac_reg(pAdapter, 0x34, BIT11, 1); */
+		rtw_write16(pAdapter, 0x34, rtw_read16(pAdapter, 0x34) | (BIT11));
+		rtw_write32(pAdapter, EFUSE_CTRL, 0x90600000 | ((addr << 8 | data)));
+	} else
+		rtw_write32(pAdapter, EFUSE_CTRL, efuseValue);
+
+	rtw_mdelay_os(1);
+
+	while ((0x80 &  rtw_read8(pAdapter, EFUSE_CTRL + 3)) && (tmpidx < 100)) {
+		rtw_mdelay_os(1);
+		tmpidx++;
+	}
+
+	if (tmpidx < 100)
+		bResult =3D true;
+	else {
+		bResult =3D false;
+		RTW_INFO("%s: [ERROR] addr=3D0x%x ,efuseValue=3D0x%x ,bResult=3D%d time =
out 1s !!!\n",
+			 __func__, addr, efuseValue, bResult);
+		RTW_INFO("%s: [ERROR] EFUSE_CTRL =3D0x%08x !!!\n", __func__, rtw_read32(=
pAdapter, EFUSE_CTRL));
+	}
+
+	/* disable Efuse program enable */
+	if ((IS_VENDOR_8188E_I_CUT_SERIES(pAdapter)) ||
+	    (IS_CHIP_VENDOR_SMIC(pHalData->version_id)))
+		phy_set_mac_reg(pAdapter, EFUSE_TEST, BIT(11), 0);
+
+	Efuse_PowerSwitch(pAdapter, true, false);
+
+	return bResult;
+}
