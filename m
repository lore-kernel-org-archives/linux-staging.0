+void hal_mpt_CCKTxPowerAdjust(PADAPTER Adapter, bool bInCH14)
+{
+	u32		TempVal =3D 0, TempVal2 =3D 0, TempVal3 =3D 0;
+	u32		CurrCCKSwingVal =3D 0, CCKSwingIndex =3D 12;
+	u8		i;
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(Adapter);
+	PMPT_CONTEXT		pMptCtx =3D &(Adapter->mppriv.mpt_ctx);
+	u8				u1Channel =3D pHalData->current_channel;
+	u32				ulRateIdx =3D pMptCtx->mpt_rate_index;
+	u8				DataRate =3D 0xFF;
+
+	DataRate =3D mpt_to_mgnt_rate(ulRateIdx);
+
+	if (u1Channel =3D=3D 14 && IS_CCK_RATE(DataRate))
+		pHalData->bCCKinCH14 =3D true;
+	else
+		pHalData->bCCKinCH14 =3D false;
+
+	/* get current cck swing value and check 0xa22 & 0xa23 later to match the=
 table.*/
+	CurrCCKSwingVal =3D read_bbreg(Adapter, rCCK0_TxFilter1, bMaskHWord);
+
+	if (!pHalData->bCCKinCH14) {
+		/* Readback the current bb cck swing value and compare with the table to=
 */
+		/* get the current swing index */
+		for (i =3D 0; i < CCK_TABLE_SIZE; i++) {
+			if (((CurrCCKSwingVal & 0xff) =3D=3D (u32)cck_swing_table_ch1_ch13[i][0=
]) &&
+			    (((CurrCCKSwingVal & 0xff00) >> 8) =3D=3D (u32)cck_swing_table_ch1_=
ch13[i][1])) {
+				CCKSwingIndex =3D i;
+				break;
+			}
+		}
+
+		/*Write 0xa22 0xa23*/
+		TempVal =3D cck_swing_table_ch1_ch13[CCKSwingIndex][0] +
+			(cck_swing_table_ch1_ch13[CCKSwingIndex][1] << 8);
+
+
+		/*Write 0xa24 ~ 0xa27*/
+		TempVal2 =3D 0;
+		TempVal2 =3D cck_swing_table_ch1_ch13[CCKSwingIndex][2] +
+			(cck_swing_table_ch1_ch13[CCKSwingIndex][3] << 8) +
+			(cck_swing_table_ch1_ch13[CCKSwingIndex][4] << 16) +
+			(cck_swing_table_ch1_ch13[CCKSwingIndex][5] << 24);
+
+		/*Write 0xa28  0xa29*/
+		TempVal3 =3D 0;
+		TempVal3 =3D cck_swing_table_ch1_ch13[CCKSwingIndex][6] +
+			(cck_swing_table_ch1_ch13[CCKSwingIndex][7] << 8);
+	}  else {
+		for (i =3D 0; i < CCK_TABLE_SIZE; i++) {
+			if (((CurrCCKSwingVal & 0xff) =3D=3D (u32)cck_swing_table_ch14[i][0]) &&
+			    (((CurrCCKSwingVal & 0xff00) >> 8) =3D=3D (u32)cck_swing_table_ch14=
[i][1])) {
+				CCKSwingIndex =3D i;
+				break;
+			}
+		}
+
+		/*Write 0xa22 0xa23*/
+		TempVal =3D cck_swing_table_ch14[CCKSwingIndex][0] +
+			  (cck_swing_table_ch14[CCKSwingIndex][1] << 8);
+
+		/*Write 0xa24 ~ 0xa27*/
+		TempVal2 =3D 0;
+		TempVal2 =3D cck_swing_table_ch14[CCKSwingIndex][2] +
+			   (cck_swing_table_ch14[CCKSwingIndex][3] << 8) +
+			(cck_swing_table_ch14[CCKSwingIndex][4] << 16) +
+			   (cck_swing_table_ch14[CCKSwingIndex][5] << 24);
+
+		/*Write 0xa28  0xa29*/
+		TempVal3 =3D 0;
+		TempVal3 =3D cck_swing_table_ch14[CCKSwingIndex][6] +
+			   (cck_swing_table_ch14[CCKSwingIndex][7] << 8);
+	}
+
+	write_bbreg(Adapter, rCCK0_TxFilter1, bMaskHWord, TempVal);
+	write_bbreg(Adapter, rCCK0_TxFilter2, bMaskDWord, TempVal2);
+	write_bbreg(Adapter, rCCK0_DebugPort, bMaskLWord, TempVal3);
+}
