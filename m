+		u32 reg_200 =3D 0, reg_204 =3D 0;
+		u32 init_reg_200 =3D 0, init_reg_204 =3D 0;
+		u32 start =3D jiffies;
+		u32 pass_ms;
+		int i =3D 0;
+
+		retry_limit =3D 0x01;
+
+		val16 =3D retry_limit << RETRY_LIMIT_SHORT_SHIFT | retry_limit << RETRY_=
LIMIT_LONG_SHIFT;
