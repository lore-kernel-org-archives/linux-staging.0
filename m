+static void radius_client_update_timeout(struct radius_client_data *radius)
+{
+	struct os_time now;
+	os_time_t first;
+	struct radius_msg_list *entry;
+
+	eloop_cancel_timeout(radius_client_timer, radius, NULL);
+
+	if (radius->msgs =3D=3D NULL) {
+		return;
+	}
+
+	first =3D 0;
+	for (entry =3D radius->msgs; entry; entry =3D entry->next) {
+		if (first =3D=3D 0 || entry->next_try < first)
+			first =3D entry->next_try;
+	}
+
+	os_get_time(&now);
+	if (first < now.sec)
+		first =3D now.sec;
+	eloop_register_timeout(first - now.sec, 0, radius_client_timer, radius,
+			       NULL);
+	hostapd_logger(radius->ctx, NULL, HOSTAPD_MODULE_RADIUS,
+		       HOSTAPD_LEVEL_DEBUG, "Next RADIUS client retransmit in"
+		       " %ld seconds\n", (long int) (first - now.sec));
+}
