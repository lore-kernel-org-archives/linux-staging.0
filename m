+
+		/* Record HW idx info */
+		for (i =3D 0; i < MAX_NUM_BEAMFORMEE_SU; i++) {
+			if ((info->beamformee_su_reg_maping & BIT(i)) =3D=3D 0) {
+				info->beamformee_su_reg_maping |=3D BIT(i);
