+static void rtl8188eu_cal_txdesc_chksum(struct tx_desc	*ptxdesc)
+{
+	__le16	*usPtr =3D (__le16 *)ptxdesc;
+	u32 count =3D 16;		/* (32 bytes / 2 bytes per XOR) =3D> 16 times */
+	u32 index;
+	u16 checksum =3D 0;
+
+	/* Clear first */
+	ptxdesc->txdw7 &=3D cpu_to_le32(0xffff0000);
+
+	for (index =3D 0 ; index < count ; index++)
+		checksum =3D checksum ^ le16_to_cpu(*(usPtr + index));
+
+	ptxdesc->txdw7 |=3D cpu_to_le32(0x0000ffff & checksum);
+
+}
+/*
+ * Description: In normal chip, we should send some packet to Hw which wil=
l be used by Fw
+ *			in FW LPS mode. The function is to fill the Tx descriptor of this pac=
kets, then
+ *			Fw can tell Hw to send these packet derectly.
+ *   */
+void rtl8188e_fill_fake_txdesc(
+	PADAPTER	padapter,
+	u8		*pDesc,
+	u32		BufferLen,
+	u8		IsPsPoll,
+	u8		IsBTQosNull,
+	u8		bDataFrame)
+{
+	struct tx_desc *ptxdesc;
+
+
+	/* Clear all status */
+	ptxdesc =3D (struct tx_desc *)pDesc;
+	memset(pDesc, 0, TXDESC_SIZE);
+
+	/* offset 0 */
+	ptxdesc->txdw0 |=3D cpu_to_le32(OWN | FSG | LSG);  /* own, bFirstSeg, bLa=
stSeg; */
+
+	ptxdesc->txdw0 |=3D cpu_to_le32(((TXDESC_SIZE + OFFSET_SZ) << OFFSET_SHT)=
 & 0x00ff0000); /* 32 bytes for TX Desc */
+
+	ptxdesc->txdw0 |=3D cpu_to_le32(BufferLen & 0x0000ffff); /* Buffer size +=
 command header */
+
+	/* offset 4 */
+	ptxdesc->txdw1 |=3D cpu_to_le32((QSLT_MGNT << QSEL_SHT) & 0x00001f00); /*=
 Fixed queue of Mgnt queue */
+
+	/* Set NAVUSEHDR to prevent Ps-poll AId filed to be changed to error vlau=
e by Hw. */
+	if (IsPsPoll)
+		ptxdesc->txdw1 |=3D cpu_to_le32(NAVUSEHDR);
+	else {
+		ptxdesc->txdw4 |=3D cpu_to_le32(BIT(7)); /* Hw set sequence number */
+		ptxdesc->txdw3 |=3D cpu_to_le32((8 << 28)); /* set bit3 to 1. Suugested =
by TimChen. 2009.12.29. */
+	}
+
+	if (IsBTQosNull) {
+		ptxdesc->txdw2 |=3D cpu_to_le32(BIT(23)); /* BT NULL */
+	}
+
+	/* offset 16 */
+	ptxdesc->txdw4 |=3D cpu_to_le32(BIT(8));/* driver uses rate */
+
+	/*  */
+	/* Encrypt the data frame if under security mode excepct null data. Sugge=
sted by CCW. */
+	/*  */
+	if (bDataFrame) {
+		u32 EncAlg;
+
+		EncAlg =3D padapter->securitypriv.dot11PrivacyAlgrthm;
+		switch (EncAlg) {
+		case _NO_PRIVACY_:
+			SET_TX_DESC_SEC_TYPE_8188E(pDesc, 0x0);
+			break;
+		case _WEP40_:
+		case _WEP104_:
+		case _TKIP_:
+			SET_TX_DESC_SEC_TYPE_8188E(pDesc, 0x1);
+			break;
+		case _SMS4_:
+			SET_TX_DESC_SEC_TYPE_8188E(pDesc, 0x2);
+			break;
+		case _AES_:
+			SET_TX_DESC_SEC_TYPE_8188E(pDesc, 0x3);
+			break;
+		default:
+			SET_TX_DESC_SEC_TYPE_8188E(pDesc, 0x0);
+			break;
+		}
+	}
+	/* USB interface drop packet if the checksum of descriptor isn't correct.=
 */
+	/* Using this checksum can let hardware recovery from packet bulk out err=
or (e.g. Cancel URC, Bulk out error.). */
+	rtl8188eu_cal_txdesc_chksum(ptxdesc);
+}
+
+static void fill_txdesc_sectype(struct pkt_attrib *pattrib, struct tx_desc=
 *ptxdesc)
+{
+	if ((pattrib->encrypt > 0) && !pattrib->bswenc) {
+		switch (pattrib->encrypt) {
+		/* SEC_TYPE : 0:NO_ENC,1:WEP40/TKIP,2:WAPI,3:AES */
+		case _WEP40_:
+		case _WEP104_:
+			ptxdesc->txdw1 |=3D cpu_to_le32((0x01 << SEC_TYPE_SHT) & 0x00c00000);
+			ptxdesc->txdw2 |=3D cpu_to_le32(0x7 << AMPDU_DENSITY_SHT);
+			break;
+		case _TKIP_:
+		case _TKIP_WTMIC_:
+			ptxdesc->txdw1 |=3D cpu_to_le32((0x01 << SEC_TYPE_SHT) & 0x00c00000);
+			ptxdesc->txdw2 |=3D cpu_to_le32(0x7 << AMPDU_DENSITY_SHT);
+			break;
+#ifdef CONFIG_WAPI_SUPPORT
+		case _SMS4_:
+			ptxdesc->txdw1 |=3D cpu_to_le32((0x02 << SEC_TYPE_SHT) & 0x00c00000);
+			ptxdesc->txdw2 |=3D cpu_to_le32(0x7 << AMPDU_DENSITY_SHT);
+			break;
+#endif
+		case _AES_:
+			ptxdesc->txdw1 |=3D cpu_to_le32((0x03 << SEC_TYPE_SHT) & 0x00c00000);
+			ptxdesc->txdw2 |=3D cpu_to_le32(0x7 << AMPDU_DENSITY_SHT);
+			break;
+		case _NO_PRIVACY_:
+		default:
+			break;
+
+		}
+
+	}
+
+}
