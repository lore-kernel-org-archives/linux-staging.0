+static u8 cmp_pkt_chnl_diff(_adapter *padapter, u8 *pframe, uint packet_le=
n)
+{
+	/* if the channel is same, return 0. else return channel differential	 */
+	uint len;
+	u8 channel;
+	u8 *p;
+	p =3D rtw_get_ie(pframe + WLAN_HDR_A3_LEN + _BEACON_IE_OFFSET_, _DSSET_IE=
_, &len, packet_len - _BEACON_IE_OFFSET_);
+	if (p) {
+		channel =3D *(p + 2);
+		if (padapter->mlmeextpriv.cur_channel >=3D channel)
+			return padapter->mlmeextpriv.cur_channel - channel;
+		else
+			return channel - padapter->mlmeextpriv.cur_channel;
+	} else
+		return 0;
+}
