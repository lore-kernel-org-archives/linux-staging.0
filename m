+
+const struct hostapd_eap_user *
+hostapd_get_eap_user(const struct hostapd_bss_config *conf, const u8 *iden=
tity,
+		     size_t identity_len, int phase2)
+{
+	struct hostapd_eap_user *user =3D conf->eap_user;
+
+#ifdef CONFIG_WPS
+	if (conf->wps_state && identity_len =3D=3D WSC_ID_ENROLLEE_LEN &&
+	    os_memcmp(identity, WSC_ID_ENROLLEE, WSC_ID_ENROLLEE_LEN) =3D=3D 0) {
+		static struct hostapd_eap_user wsc_enrollee;
+		os_memset(&wsc_enrollee, 0, sizeof(wsc_enrollee));
+		wsc_enrollee.methods[0].method =3D eap_server_get_type(
+			"WSC", &wsc_enrollee.methods[0].vendor);
+		return &wsc_enrollee;
+	}
+
+	if (conf->wps_state && identity_len =3D=3D WSC_ID_REGISTRAR_LEN &&
+	    os_memcmp(identity, WSC_ID_REGISTRAR, WSC_ID_REGISTRAR_LEN) =3D=3D 0)=
 {
+		static struct hostapd_eap_user wsc_registrar;
+		os_memset(&wsc_registrar, 0, sizeof(wsc_registrar));
+		wsc_registrar.methods[0].method =3D eap_server_get_type(
+			"WSC", &wsc_registrar.methods[0].vendor);
+		wsc_registrar.password =3D (u8 *) conf->ap_pin;
+		wsc_registrar.password_len =3D conf->ap_pin ?
+			os_strlen(conf->ap_pin) : 0;
+		return &wsc_registrar;
+	}
+#endif /* CONFIG_WPS */
+
+	while (user) {
+		if (!phase2 && user->identity =3D=3D NULL) {
+			/* Wildcard match */
+			break;
+		}
+
+		if (user->phase2 =3D=3D !!phase2 && user->wildcard_prefix &&
+		    identity_len >=3D user->identity_len &&
+		    os_memcmp(user->identity, identity, user->identity_len) =3D=3D
+		    0) {
+			/* Wildcard prefix match */
+			break;
+		}
+
+		if (user->phase2 =3D=3D !!phase2 &&
+		    user->identity_len =3D=3D identity_len &&
+		    os_memcmp(user->identity, identity, identity_len) =3D=3D 0)
+			break;
+		user =3D user->next;
+	}
+
+	return user;
+}
