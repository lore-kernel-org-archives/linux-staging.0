+/*
+* set adapter.mlmeextpriv.mlmext_info.HT_enable
+* set adapter.mlmeextpriv.cur_wireless_mode
+* set SIFS register
+* set mgmt tx rate
+*/
+void update_wireless_mode(_adapter *padapter)
+{
+	int ratelen, network_type =3D 0;
+	u32 SIFS_Timer;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	WLAN_BSSID_EX		*cur_network =3D &(pmlmeinfo->network);
+	unsigned char			*rate =3D cur_network->SupportedRates;
+#ifdef CONFIG_P2P
+	struct wifidirect_info	*pwdinfo =3D &(padapter->wdinfo);
+#endif /* CONFIG_P2P */
+
+	ratelen =3D rtw_get_rateset_len(cur_network->SupportedRates);
+
+	if ((pmlmeinfo->HT_info_enable) && (pmlmeinfo->HT_caps_enable))
+		pmlmeinfo->HT_enable =3D 1;
+
+	if (pmlmeext->cur_channel > 14) {
+		if (pmlmeinfo->VHT_enable)
+			network_type =3D WIRELESS_11AC;
+		else if (pmlmeinfo->HT_enable)
+			network_type =3D WIRELESS_11_5N;
+
+		network_type |=3D WIRELESS_11A;
+	} else {
+		if (pmlmeinfo->VHT_enable)
+			network_type =3D WIRELESS_11AC;
+		else if (pmlmeinfo->HT_enable)
+			network_type =3D WIRELESS_11_24N;
+
+		if ((cckratesonly_included(rate, ratelen)))
+			network_type |=3D WIRELESS_11B;
+		else if ((cckrates_included(rate, ratelen)))
+			network_type |=3D WIRELESS_11BG;
+		else
+			network_type |=3D WIRELESS_11G;
+	}
+
+	pmlmeext->cur_wireless_mode =3D network_type & padapter->registrypriv.wir=
eless_mode;
+
+	SIFS_Timer =3D 0x0a0a0808; /* 0x0808->for CCK, 0x0a0a->for OFDM
+                              * change this value if having IOT issues. */
+
+	rtw_hal_set_hwreg(padapter, HW_VAR_RESP_SIFS, (u8 *)&SIFS_Timer);
+
+	rtw_hal_set_hwreg(padapter, HW_VAR_WIRELESS_MODE, (u8 *)&(pmlmeext->cur_w=
ireless_mode));
+
+	if ((pmlmeext->cur_wireless_mode & WIRELESS_11B)
+		#ifdef CONFIG_P2P
+		&& (rtw_p2p_chk_state(pwdinfo, P2P_STATE_NONE)
+			#ifdef CONFIG_IOCTL_CFG80211
+			|| !rtw_cfg80211_iface_has_p2p_group_cap(padapter)
+			#endif
+			)
+		#endif
+	)
+		update_mgnt_tx_rate(padapter, IEEE80211_CCK_RATE_1MB);
+	else
+		update_mgnt_tx_rate(padapter, IEEE80211_OFDM_RATE_6MB);
+}
