+/* Find a tag in pppoe frame and return the pointer */
+static __inline__ unsigned char *__nat25_find_pppoe_tag(struct pppoe_hdr *=
ph, unsigned short type)
+{
+	unsigned char *cur_ptr, *start_ptr;
+	unsigned short tagLen, tagType;
+
+	start_ptr =3D cur_ptr =3D (unsigned char *)ph->tag;
+	while ((cur_ptr - start_ptr) < ntohs(ph->length)) {
+		/* prevent un-alignment access */
+		tagType =3D (unsigned short)((cur_ptr[0] << 8) + cur_ptr[1]);
+		tagLen  =3D (unsigned short)((cur_ptr[2] << 8) + cur_ptr[3]);
+		if (tagType =3D=3D type)
+			return cur_ptr;
+		cur_ptr =3D cur_ptr + TAG_HDR_LEN + tagLen;
+	}
+	return NULL;
+}
