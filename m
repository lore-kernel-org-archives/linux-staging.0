+static struct hostapd_wep_keys *
+ieee802_1x_get_group(struct hostapd_data *hapd, struct hostapd_ssid *ssid,
+		     size_t vlan_id)
+{
+	const char *ifname;
+
+	if (vlan_id =3D=3D 0)
+		return &ssid->wep;
+
+	if (vlan_id <=3D ssid->max_dyn_vlan_keys && ssid->dyn_vlan_keys &&
+	    ssid->dyn_vlan_keys[vlan_id])
+		return ssid->dyn_vlan_keys[vlan_id];
+
+	wpa_printf(MSG_DEBUG, "IEEE 802.1X: Creating new group "
+		   "state machine for VLAN ID %lu",
+		   (unsigned long) vlan_id);
+
+	ifname =3D hostapd_get_vlan_id_ifname(hapd->conf->vlan, vlan_id);
+	if (ifname =3D=3D NULL) {
+		wpa_printf(MSG_DEBUG, "IEEE 802.1X: Unknown VLAN ID %lu - "
+			   "cannot create group key state machine",
+			   (unsigned long) vlan_id);
+		return NULL;
+	}
+
+	if (ssid->dyn_vlan_keys =3D=3D NULL) {
+		int size =3D (vlan_id + 1) * sizeof(ssid->dyn_vlan_keys[0]);
+		ssid->dyn_vlan_keys =3D os_zalloc(size);
+		if (ssid->dyn_vlan_keys =3D=3D NULL)
+			return NULL;
+		ssid->max_dyn_vlan_keys =3D vlan_id;
+	}
+
+	if (ssid->max_dyn_vlan_keys < vlan_id) {
+		struct hostapd_wep_keys **na;
+		int size =3D (vlan_id + 1) * sizeof(ssid->dyn_vlan_keys[0]);
+		na =3D os_realloc(ssid->dyn_vlan_keys, size);
+		if (na =3D=3D NULL)
+			return NULL;
+		ssid->dyn_vlan_keys =3D na;
+		os_memset(&ssid->dyn_vlan_keys[ssid->max_dyn_vlan_keys + 1], 0,
+			  (vlan_id - ssid->max_dyn_vlan_keys) *
+			  sizeof(ssid->dyn_vlan_keys[0]));
+		ssid->max_dyn_vlan_keys =3D vlan_id;
+	}
+
+	ssid->dyn_vlan_keys[vlan_id] =3D ieee802_1x_group_alloc(hapd, ifname);
+
+	return ssid->dyn_vlan_keys[vlan_id];
+}
