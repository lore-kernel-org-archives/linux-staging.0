+#ifdef CONFIG_IEEE80211W
+static u8 * hostapd_eid_assoc_comeback_time(struct hostapd_data *hapd,
+					    struct sta_info *sta, u8 *eid)
+{
+	u8 *pos =3D eid;
+	u32 timeout, tu;
+	struct os_time now, passed;
+
+	*pos++ =3D WLAN_EID_TIMEOUT_INTERVAL;
+	*pos++ =3D 5;
+	*pos++ =3D WLAN_TIMEOUT_ASSOC_COMEBACK;
+	os_get_time(&now);
+	os_time_sub(&now, &sta->sa_query_start, &passed);
+	tu =3D (passed.sec * 1000000 + passed.usec) / 1024;
+	if (hapd->conf->assoc_sa_query_max_timeout > tu)
+		timeout =3D hapd->conf->assoc_sa_query_max_timeout - tu;
+	else
+		timeout =3D 0;
+	if (timeout < hapd->conf->assoc_sa_query_max_timeout)
+		timeout++; /* add some extra time for local timers */
+	WPA_PUT_LE32(pos, timeout);
+	pos +=3D 4;
+
+	return pos;
+}
