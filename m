+unsigned int OnAssocReq(_adapter *padapter, union recv_frame *precv_frame)
+{
+#ifdef CONFIG_AP_MODE
+	unsigned long irqL;
+	u16 capab_info, listen_interval;
+	struct rtw_ieee802_11_elems elems;
+	struct sta_info	*pstat;
+	unsigned char		reassoc, *p, *pos, *wpa_ie;
+	unsigned char WMM_IE[] =3D {0x00, 0x50, 0xf2, 0x02, 0x00, 0x01};
+	int		i, ie_len, wpa_ie_len, left;
+	u8 rate_set[16];
+	u8 rate_num;
+	unsigned short		status =3D _STATS_SUCCESSFUL_;
+	unsigned short		frame_type, ie_offset =3D 0;
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+	struct security_priv *psecuritypriv =3D &padapter->securitypriv;
+	struct mlme_ext_priv *pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	WLAN_BSSID_EX	*cur =3D &(pmlmeinfo->network);
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+	u8 *pframe =3D precv_frame->u.hdr.rx_data;
+	uint pkt_len =3D precv_frame->u.hdr.len;
+#ifdef CONFIG_P2P
+	struct wifidirect_info	*pwdinfo =3D &(padapter->wdinfo);
+	u8 p2p_status_code =3D P2P_STATUS_SUCCESS;
+	u8 *p2pie;
+	u32 p2pielen =3D 0;
+#endif /* CONFIG_P2P */
+
+#ifdef CONFIG_CONCURRENT_MODE
+	if (((pmlmeinfo->state & 0x03) =3D=3D WIFI_FW_AP_STATE) &&
+	    rtw_mi_buddy_check_fwstate(padapter, _FW_UNDER_LINKING | _FW_UNDER_SU=
RVEY)) {
+		/* don't process assoc request; */
+		return _SUCCESS;
+	}
+#endif /* CONFIG_CONCURRENT_MODE */
+
+	if ((pmlmeinfo->state & 0x03) !=3D WIFI_FW_AP_STATE)
+		return _FAIL;
+
+	frame_type =3D get_frame_sub_type(pframe);
+	if (frame_type =3D=3D WIFI_ASSOCREQ) {
+		reassoc =3D 0;
+		ie_offset =3D _ASOCREQ_IE_OFFSET_;
+	} else { /* WIFI_REASSOCREQ */
+		reassoc =3D 1;
+		ie_offset =3D _REASOCREQ_IE_OFFSET_;
+	}
+
+
+	if (pkt_len < IEEE80211_3ADDR_LEN + ie_offset) {
+		RTW_INFO("handle_assoc(reassoc=3D%d) - too short payload (len=3D%lu)"
+			 "\n", reassoc, (unsigned long)pkt_len);
+		return _FAIL;
+	}
+
+	pstat =3D rtw_get_stainfo(pstapriv, get_addr2_ptr(pframe));
+	if (pstat =3D=3D (struct sta_info *)NULL) {
+		status =3D _RSON_CLS2_;
+		goto asoc_class2_error;
+	}
+
+	capab_info =3D RTW_GET_LE16(pframe + WLAN_HDR_A3_LEN);
+	/* capab_info =3D le16_to_cpu(*(__le16 *)(pframe + WLAN_HDR_A3_LEN));	 */
+	/* listen_interval =3D le16_to_cpu(*(__le16 *)(pframe + WLAN_HDR_A3_LEN+2=
)); */
