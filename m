+int os_mktime(int year, int month, int day, int hour, int min, int sec,
+	      os_time_t *t)
+{
+	struct tm tm, *tm1;
+	time_t t_local, t1, t2;
+	os_time_t tz_offset;
+
+	if (year < 1970 || month < 1 || month > 12 || day < 1 || day > 31 ||
+	    hour < 0 || hour > 23 || min < 0 || min > 59 || sec < 0 ||
+	    sec > 60)
+		return -1;
+
+	memset(&tm, 0, sizeof(tm));
+	tm.tm_year =3D year - 1900;
+	tm.tm_mon =3D month - 1;
+	tm.tm_mday =3D day;
+	tm.tm_hour =3D hour;
+	tm.tm_min =3D min;
+	tm.tm_sec =3D sec;
+
+	t_local =3D mktime(&tm);
+
+	/* figure out offset to UTC */
+	tm1 =3D localtime(&t_local);
+	if (tm1) {
+		t1 =3D mktime(tm1);
+		tm1 =3D gmtime(&t_local);
+		if (tm1) {
+			t2 =3D mktime(tm1);
+			tz_offset =3D t2 - t1;
+		} else
+			tz_offset =3D 0;
+	} else
+		tz_offset =3D 0;
+
+	*t =3D (os_time_t) t_local - tz_offset;
+	return 0;
+}
