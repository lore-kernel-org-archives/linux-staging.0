+static int skb_pull_and_merge(struct sk_buff *skb, unsigned char *src, int=
 len)
+{
+	int tail_len;
+	unsigned long end, tail;
+
+	if ((src + len) > skb_tail_pointer(skb) || skb->len < len)
+		return -1;
+
+	tail =3D (unsigned long)skb_tail_pointer(skb);
+	end =3D (unsigned long)src + len;
+	if (tail < end)
