+static int rtw_tdls_get_best_ch(struct net_device *dev,
+				struct iw_request_info *info,
+				union iwreq_data *wrqu, char *extra)
+{
+#ifdef CONFIG_FIND_BEST_CHANNEL
+	_adapter *padapter =3D (_adapter *)rtw_netdev_priv(dev);
+	struct mlme_ext_priv *pmlmeext =3D &padapter->mlmeextpriv;
+	u32 i, best_channel_24G =3D 1, best_channel_5G =3D 36, index_24G =3D 0, i=
ndex_5G =3D 0;
+
+	for (i =3D 0; pmlmeext->channel_set[i].ChannelNum !=3D 0; i++) {
+		if (pmlmeext->channel_set[i].ChannelNum =3D=3D 1)
+			index_24G =3D i;
+		if (pmlmeext->channel_set[i].ChannelNum =3D=3D 36)
+			index_5G =3D i;
+	}
+
+	for (i =3D 0; pmlmeext->channel_set[i].ChannelNum !=3D 0; i++) {
+		/* 2.4G */
+		if (pmlmeext->channel_set[i].ChannelNum =3D=3D 6 || pmlmeext->channel_se=
t[i].ChannelNum =3D=3D 11) {
+			if (pmlmeext->channel_set[i].rx_count < pmlmeext->channel_set[index_24G=
].rx_count) {
+				index_24G =3D i;
+				best_channel_24G =3D pmlmeext->channel_set[i].ChannelNum;
+			}
+		}
+
+		/* 5G */
+		if (pmlmeext->channel_set[i].ChannelNum >=3D 36
+		    && pmlmeext->channel_set[i].ChannelNum < 140) {
+			/* Find primary channel */
+			if (((pmlmeext->channel_set[i].ChannelNum - 36) % 8 =3D=3D 0)
+			    && (pmlmeext->channel_set[i].rx_count < pmlmeext->channel_set[index=
_5G].rx_count)) {
+				index_5G =3D i;
+				best_channel_5G =3D pmlmeext->channel_set[i].ChannelNum;
+			}
+		}
+
+		if (pmlmeext->channel_set[i].ChannelNum >=3D 149
+		    && pmlmeext->channel_set[i].ChannelNum < 165) {
+			/* Find primary channel */
+			if (((pmlmeext->channel_set[i].ChannelNum - 149) % 8 =3D=3D 0)
+			    && (pmlmeext->channel_set[i].rx_count < pmlmeext->channel_set[index=
_5G].rx_count)) {
+				index_5G =3D i;
+				best_channel_5G =3D pmlmeext->channel_set[i].ChannelNum;
+			}
+		}
+		RTW_INFO("The rx cnt of channel %3d =3D %d\n",
+			 pmlmeext->channel_set[i].ChannelNum,
+			 pmlmeext->channel_set[i].rx_count);
+	}
+
+	sprintf(extra, "\nbest_channel_24G =3D %d\n", best_channel_24G);
+	RTW_INFO("best_channel_24G =3D %d\n", best_channel_24G);
+
+	if (index_5G !=3D 0) {
+		sprintf(extra, "best_channel_5G =3D %d\n", best_channel_5G);
+		RTW_INFO("best_channel_5G =3D %d\n", best_channel_5G);
+	}
+
+	wrqu->data.length =3D strlen(extra);
+
+#endif
+
+	return 0;
+
+}
