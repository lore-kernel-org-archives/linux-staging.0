+/* free all stainfo which in sta_hash[all] */
+void rtw_free_all_stainfo(_adapter *padapter)
+{
+	unsigned long	 irqL;
+	_list	*plist, *phead;
+	s32	index;
+	struct sta_info *psta =3D NULL;
+	struct	sta_priv *pstapriv =3D &padapter->stapriv;
+	struct sta_info *pbcmc_stainfo =3D rtw_get_bcmc_stainfo(padapter);
+	u8 free_sta_num =3D 0;
+	char free_sta_list[NUM_STA];
+	int stainfo_offset;
+
+
+	if (pstapriv->asoc_sta_count =3D=3D 1)
+		goto exit;
+
+	_enter_critical_bh(&pstapriv->sta_hash_lock, &irqL);
+
+	for (index =3D 0; index < NUM_STA; index++) {
+		phead =3D &(pstapriv->sta_hash[index]);
+		plist =3D get_next(phead);
+
+		while ((rtw_end_of_queue_search(phead, plist)) =3D=3D false) {
+			psta =3D LIST_CONTAINOR(plist, struct sta_info , hash_list);
+
+			plist =3D get_next(plist);
+
+			if (pbcmc_stainfo !=3D psta) {
+				if (rtw_is_pre_link_sta(pstapriv, psta->hwaddr) =3D=3D false)
+					list_del_init(&psta->hash_list);
+
+				stainfo_offset =3D rtw_stainfo_offset(pstapriv, psta);
+				if (stainfo_offset_valid(stainfo_offset))
+					free_sta_list[free_sta_num++] =3D stainfo_offset;
+			}
+
+		}
+	}
+
+	_exit_critical_bh(&pstapriv->sta_hash_lock, &irqL);
+
+
+	for (index =3D 0; index < free_sta_num; index++) {
+		psta =3D rtw_get_stainfo_by_offset(pstapriv, free_sta_list[index]);
+		rtw_free_stainfo(padapter , psta);
+	}
+
+exit:
+	return;
+}
