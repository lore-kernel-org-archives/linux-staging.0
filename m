+static void
+phy_StoreTxPowerByRateBase(
+	PADAPTER	pAdapter
+)
+{
+	struct hal_spec_t *hal_spec =3D GET_HAL_SPEC(pAdapter);
+	struct registry_priv *regsty =3D adapter_to_regsty(pAdapter);
+
+	u8 rate_sec_base[RATE_SECTION_NUM] =3D {
+		MGN_11M,
+		MGN_54M,
+		MGN_MCS7,
+		MGN_MCS15,
+		MGN_MCS23,
+		MGN_MCS31,
+		MGN_VHT1SS_MCS7,
+		MGN_VHT2SS_MCS7,
+		MGN_VHT3SS_MCS7,
+		MGN_VHT4SS_MCS7,
+	};
+
+	u8 band, path, rs, tx_num, base, index;
+
+	for (band =3D BAND_ON_2_4G; band <=3D BAND_ON_5G; band++) {
+		if (!hal_is_band_support(pAdapter, band))
+			continue;
+
+		for (path =3D RF_PATH_A; path < RF_PATH_MAX; path++) {
+			if (!HAL_SPEC_CHK_RF_PATH(hal_spec, band, path))
+				break;
+
+			for (rs =3D 0; rs < RATE_SECTION_NUM; rs++) {
+				tx_num =3D rate_section_to_tx_num(rs);
+				if (tx_num >=3D hal_spec->tx_nss_num)
+					continue;
+
+				if (band =3D=3D BAND_ON_5G && IS_CCK_RATE_SECTION(rs))
+					continue;
+
+				if (IS_VHT_RATE_SECTION(rs))
+					continue;
+
+				if (regsty->target_tx_pwr_valid =3D=3D true)
+					base =3D 2 * rtw_regsty_get_target_tx_power(pAdapter, band, path, rs);
+				else
+					base =3D _PHY_GetTxPowerByRate(pAdapter, band, path, tx_num, rate_sec=
_base[rs]);
+				phy_SetTxPowerByRateBase(pAdapter, band, path, rs, tx_num, base);
+			}
+		}
+	}
+}
