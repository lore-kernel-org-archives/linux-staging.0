+	u8	tmp_header =3D 0;
+
+	EFUSE_GetEfuseDefinition(pAdapter, EFUSE_WIFI, TYPE_EFUSE_MAX_SECTION, (v=
oid *)&max_section, bPseudoTest);
+
+	if (data =3D=3D NULL)
+		return false;
+	if (offset > max_section)
+		return false;
+
+	memset((void *)data, 0xff, sizeof(u8) * PGPKT_DATA_SIZE);
+	memset((void *)tmpdata, 0xff, sizeof(u8) * PGPKT_DATA_SIZE);
+
+
+	/*  */
+	/* <Roger_TODO> Efuse has been pre-programmed dummy 5Bytes at the end of =
Efuse by CP. */
+	/* Skip dummy parts to prevent unexpected data read from Efuse. */
+	/* By pass right now. 2009.02.19. */
+	/*  */
+	while (bContinual && AVAILABLE_EFUSE_ADDR(efuse_addr)) {
+		/* -------  Header Read ------------- */
+		if (ReadState & PG_STATE_HEADER) {
+			if (efuse_OneByteRead(pAdapter, efuse_addr , &efuse_data, bPseudoTest) =
&& (efuse_data !=3D 0xFF)) {
+				if (EXT_HEADER(efuse_data)) {
+					tmp_header =3D efuse_data;
+					efuse_addr++;
+					efuse_OneByteRead(pAdapter, efuse_addr , &efuse_data, bPseudoTest);
+					if (!ALL_WORDS_DISABLED(efuse_data)) {
+						hoffset =3D ((tmp_header & 0xE0) >> 5) | ((efuse_data & 0xF0) >> 1);
+						hworden =3D efuse_data & 0x0F;
+					} else {
+						RTW_INFO("Error, All words disabled\n");
+						efuse_addr++;
+						continue;
+					}
+				} else {
+					hoffset =3D (efuse_data >> 4) & 0x0F;
+					hworden =3D  efuse_data & 0x0F;
+				}
+				word_cnts =3D Efuse_CalculateWordCnts(hworden);
+				bDataEmpty =3D true ;
+
+				if (hoffset =3D=3D offset) {
+					for (tmpidx =3D 0; tmpidx < word_cnts * 2 ; tmpidx++) {
+						if (efuse_OneByteRead(pAdapter, efuse_addr + 1 + tmpidx , &efuse_dat=
a, bPseudoTest)) {
+							tmpdata[tmpidx] =3D efuse_data;
+							if (efuse_data !=3D 0xff)
+								bDataEmpty =3D false;
+						}
+					}
+					if (bDataEmpty =3D=3D false)
+						ReadState =3D PG_STATE_DATA;
+					else { /* read next header */
+						efuse_addr =3D efuse_addr + (word_cnts * 2) + 1;
+						ReadState =3D PG_STATE_HEADER;
+					}
+				} else { /* read next header */
+					efuse_addr =3D efuse_addr + (word_cnts * 2) + 1;
+					ReadState =3D PG_STATE_HEADER;
+				}
+
+			} else
+				bContinual =3D false ;
+		}
+		/* -------  Data section Read ------------- */
+		else if (ReadState & PG_STATE_DATA) {
+			efuse_WordEnableDataRead(hworden, tmpdata, data);
+			efuse_addr =3D efuse_addr + (word_cnts * 2) + 1;
+			ReadState =3D PG_STATE_HEADER;
+		}
+
+	}
+
+	if ((data[0] =3D=3D 0xff) && (data[1] =3D=3D 0xff) && (data[2] =3D=3D 0xf=
f)  && (data[3] =3D=3D 0xff) &&
+	    (data[4] =3D=3D 0xff) && (data[5] =3D=3D 0xff) && (data[6] =3D=3D 0xf=
f)  && (data[7] =3D=3D 0xff))
+		return false;
+	else
+		return true;
+
+}
