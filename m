+void rtl8188e_sreset_linked_status_check(_adapter *padapter)
+{
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(padapter);
+	struct sreset_priv *psrtpriv =3D &pHalData->srestpriv;
+
+	u32 rx_dma_status =3D 0;
+	u8 fw_status =3D 0;
+	rx_dma_status =3D rtw_read32(padapter, REG_RXDMA_STATUS);
+	if (rx_dma_status !=3D 0x00) {
+		RTW_INFO("%s REG_RXDMA_STATUS:0x%08x\n", __func__, rx_dma_status);
+		rtw_write32(padapter, REG_RXDMA_STATUS, rx_dma_status);
+	}
+	fw_status =3D rtw_read8(padapter, REG_FMETHR);
+	if (fw_status !=3D 0x00) {
+		if (fw_status =3D=3D 1)
+			RTW_INFO("%s REG_FW_STATUS (0x%02x), Read_Efuse_Fail !!\n", __func__, f=
w_status);
+		else if (fw_status =3D=3D 2)
+			RTW_INFO("%s REG_FW_STATUS (0x%02x), Condition_No_Match !!\n", __func__=
, fw_status);
+	}
+	if (psrtpriv->dbg_trigger_point =3D=3D SRESET_TGP_LINK_STATUS) {
+		psrtpriv->dbg_trigger_point =3D SRESET_TGP_NULL;
+		rtw_hal_sreset_reset(padapter);
