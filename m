+{
+	struct crypto_public_key *pk;
+	PCCERT_CONTEXT cc;
+
+	pk =3D os_zalloc(sizeof(*pk));
+	if (pk =3D=3D NULL)
+		return NULL;
+
+	cc =3D CertCreateCertificateContext(X509_ASN_ENCODING |
+					  PKCS_7_ASN_ENCODING, buf, len);
+	if (!cc) {
+ 		cryptoapi_report_error("CryptCreateCertificateContext");
+		os_free(pk);
