+u8 rtw_get_offset_by_chbw(u8 ch, u8 bw, u8 *r_offset)
+{
+	u8 valid =3D 1;
+	u8 offset =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+
+	if (bw =3D=3D CHANNEL_WIDTH_20)
+		goto exit;
