+static bool
+hal_EfuseFixHeaderProcess(
+		PADAPTER			pAdapter,
+		u8					efuseType,
+		PPGPKT_STRUCT		pFixPkt,
+		u16					*pAddr,
+		bool				bPseudoTest
+)
+{
+	u8	originaldata[8], badworden =3D 0;
+	u16	efuse_addr =3D *pAddr;
+	u32	PgWriteSuccess =3D 0;
+
+	memset((void *)originaldata, 0xff, 8);
+
+	if (Efuse_PgPacketRead(pAdapter, pFixPkt->offset, originaldata, bPseudoTe=
st)) {
+		/* check if data exist */
+		badworden =3D Efuse_WordEnableDataWrite(pAdapter, efuse_addr + 1, pFixPk=
t->word_en, originaldata, bPseudoTest);
+
+		if (badworden !=3D 0xf) {	/* write fail */
+			PgWriteSuccess =3D Efuse_PgPacketWrite(pAdapter, pFixPkt->offset, badwo=
rden, originaldata, bPseudoTest);
+
+			if (!PgWriteSuccess)
+				return false;
+			else
+				efuse_addr =3D Efuse_GetCurrentSize(pAdapter, efuseType, bPseudoTest);
+		} else
+			efuse_addr =3D efuse_addr + (pFixPkt->word_cnts * 2) + 1;
+	} else
+		efuse_addr =3D efuse_addr + (pFixPkt->word_cnts * 2) + 1;
+	*pAddr =3D efuse_addr;
+	return true;
