+void CRC8_generator(
+	bool	*out,
+	bool	*in,
+	u8	in_size
+)
+{
+	u8 i =3D 0;
+	bool temp =3D 0, reg[] =3D {1, 1, 1, 1, 1, 1, 1, 1};
+
+	for (i =3D 0; i < in_size; i++) { /* take one's complement and bit revers=
e*/
+		temp =3D in[i] ^ reg[7];
+		reg[7]	=3D reg[6];
+		reg[6]	=3D reg[5];
+		reg[5]	=3D reg[4];
+		reg[4]	=3D reg[3];
+		reg[3]	=3D reg[2];
+		reg[2]	=3D reg[1] ^ temp;
+		reg[1]	=3D reg[0] ^ temp;
+		reg[0]	=3D temp;
+	}
+	for (i =3D 0; i < 8; i++)/* take one's complement and bit reverse*/
+		out[i] =3D reg[7 - i] ^ 1;
+}
