--- /dev/null
+++ b/drivers/staging/rtl8188eu/hostapd-0.8/src/p2p/p2p_pd.c
@@ -0,0 +1,347 @@
+/*
+ * Wi-Fi Direct - P2P provision discovery
+ * Copyright (c) 2009-2010, Atheros Communications
