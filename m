+	u8 originalValue, bitShift;
+	u8 i;
+
+
+	pBtCoexist =3D (PBTC_COEXIST)pBtcContext;
+	padapter =3D pBtCoexist->Adapter;
+	originalValue =3D 0;
+	bitShift =3D 0;
+
+	if (bitMask !=3D 0xff) {
+		originalValue =3D rtw_read8(padapter, regAddr);
+
+		for (i =3D 0; i <=3D 7; i++) {
+			if ((bitMask >> i) & 0x1)
