+
+#if defined(CONFIG_P2P) && defined(RTW_DEDICATED_P2P_DEVICE)
+	case NL80211_IFTYPE_P2P_DEVICE:
+		ret =3D rtw_pd_iface_alloc(wiphy, name, &wdev);
+		break;
