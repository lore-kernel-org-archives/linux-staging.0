+	struct _odm_phy_status_info_				*p_phy_info
+)
+{
+	/* type 0 is used for cck packet */
+
+	struct _phy_status_rpt_jaguar2_type0	*p_phy_sta_rpt =3D (struct _phy_stat=
us_rpt_jaguar2_type0 *)p_phy_status;
+	u8							i, SQ =3D 0;
+	s8							rx_power =3D p_phy_sta_rpt->pwdb - 110;
+
+#if (RTL8723D_SUPPORT =3D=3D 1)
+	if (p_dm_odm->support_ic_type & ODM_RTL8723D)
+		rx_power =3D p_phy_sta_rpt->pwdb - 97;
+#endif
+#if (RTL8197F_SUPPORT =3D=3D 1)
+	if (p_dm_odm->support_ic_type & ODM_RTL8197F)
+		rx_power =3D p_phy_sta_rpt->pwdb - 97;
+#endif
+
+	/* Calculate Signal Quality*/
+	if (p_pktinfo->is_packet_match_bssid) {
+		if (p_phy_sta_rpt->signal_quality >=3D 64)
+			SQ =3D 0;
+		else if (p_phy_sta_rpt->signal_quality <=3D 20)
+			SQ =3D 100;
+		else {
+			/* mapping to 2~99% */
+			SQ =3D 64 - p_phy_sta_rpt->signal_quality;
+			SQ =3D ((SQ << 3) + SQ) >> 2;
+		}
+	}
+
+	/* Modify CCK PWDB if old AGC */
+	if (p_dm_odm->cck_new_agc =3D=3D false) {
+		u8	lna_idx, vga_idx;
+
+			lna_idx =3D ((p_phy_sta_rpt->lna_h << 3) | p_phy_sta_rpt->lna_l);
+		vga_idx =3D p_phy_sta_rpt->vga;
+	}
+
+	/* Update CCK packet counter */
+	p_dm_odm->phy_dbg_info.num_qry_phy_status_cck++;
+
+	/*CCK no STBC and LDPC*/
+	p_dm_odm->phy_dbg_info.is_ldpc_pkt =3D false;
+	p_dm_odm->phy_dbg_info.is_stbc_pkt =3D false;
+
+	/* Update Common information */
+	phydm_set_common_phy_info(rx_power, p_phy_sta_rpt->channel, false,
+		  false, ODM_BW20M, SQ, p_phy_sta_rpt->rxsc, p_phy_info);
+
+	/* Update CCK pwdb */
+	phydm_set_per_path_phy_info(ODM_RF_PATH_A, rx_power, 0, 0, 0, p_phy_info)=
;					/* Update per-path information */
+
+	p_dm_odm->dm_fat_table.antsel_rx_keep_0 =3D p_phy_sta_rpt->antidx_a;
+	p_dm_odm->dm_fat_table.antsel_rx_keep_1 =3D p_phy_sta_rpt->antidx_b;
