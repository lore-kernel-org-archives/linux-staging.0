+			RTW_INFO("%s, psta=3D=3DNUL\n", __func__);
+			return _FAIL;
+		}
+
+		if(!(stainfo->state &_FW_LINKED))
+		{
+			RTW_INFO("%s, psta->state(0x%x) !=3D _FW_LINKED\n", __func__, stainfo->=
state);
+			return _FAIL;
+		}
+	*/
+
+#ifdef CONFIG_USB_TX_AGGREGATION
+	hw_hdr_offset =3D TXDESC_SIZE + (pxmitframe->pkt_offset * PACKET_OFFSET_S=
Z);;
+#else
+#ifdef CONFIG_TX_EARLY_MODE
+	hw_hdr_offset =3D TXDESC_OFFSET + EARLY_MODE_INFO_SIZE;
+#else
+	hw_hdr_offset =3D TXDESC_OFFSET;
+#endif
+#endif
+
+	if (pattrib->encrypt =3D=3D _TKIP_) { /* if(psecuritypriv->dot11PrivacyAl=
grthm=3D=3D_TKIP_PRIVACY_) */
+		/* encode mic code */
+		/* if(stainfo!=3D NULL) */
+		{
+			u8 null_key[16] =3D {0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, =
0x0, 0x0, 0x0, 0x0, 0x0, 0x0};
+
+			pframe =3D pxmitframe->buf_addr + hw_hdr_offset;
+
+			if (bmcst) {
+				if (!memcmp(psecuritypriv->dot118021XGrptxmickey[psecuritypriv->dot118=
021XGrpKeyid].skey, null_key, 16)) {
+					/* DbgPrint("\nxmitframe_addmic:stainfo->dot11tkiptxmickey=3D=3D0\n")=
; */
+					/* rtw_msleep_os(10); */
+					return _FAIL;
+				}
+				/* start to calculate the mic code */
+				rtw_secmicsetkey(&micdata, psecuritypriv->dot118021XGrptxmickey[psecur=
itypriv->dot118021XGrpKeyid].skey);
+			} else {
+				if (!memcmp(&pattrib->dot11tkiptxmickey.skey[0], null_key, 16)) {
+					/* DbgPrint("\nxmitframe_addmic:stainfo->dot11tkiptxmickey=3D=3D0\n")=
; */
+					/* rtw_msleep_os(10); */
+					return _FAIL;
+				}
+				/* start to calculate the mic code */
+				rtw_secmicsetkey(&micdata, &pattrib->dot11tkiptxmickey.skey[0]);
+			}
+
+			if (pframe[1] & 1) { /* ToDS=3D=3D1 */
+				rtw_secmicappend(&micdata, &pframe[16], 6);  /* DA */
+				if (pframe[1] & 2) /* From Ds=3D=3D1 */
+					rtw_secmicappend(&micdata, &pframe[24], 6);
+				else
+					rtw_secmicappend(&micdata, &pframe[10], 6);
+			} else {	/* ToDS=3D=3D0 */
+				rtw_secmicappend(&micdata, &pframe[4], 6);   /* DA */
+				if (pframe[1] & 2) /* From Ds=3D=3D1 */
+					rtw_secmicappend(&micdata, &pframe[16], 6);
+				else
+					rtw_secmicappend(&micdata, &pframe[10], 6);
+
+			}
+
+			/* if(pqospriv->qos_option=3D=3D1) */
+			if (pattrib->qos_en)
+				priority[0] =3D (u8)pxmitframe->attrib.priority;
+
+			rtw_secmicappend(&micdata, &priority[0], 4);
+
+			payload =3D pframe;
+
+			for (curfragnum =3D 0; curfragnum < pattrib->nr_frags; curfragnum++) {
+				payload =3D (u8 *)RND4((SIZE_PTR)(payload));
+
+				payload =3D payload + pattrib->hdrlen + pattrib->iv_len;
+				if ((curfragnum + 1) =3D=3D pattrib->nr_frags) {
+					length =3D pattrib->last_txcmdsz - pattrib->hdrlen - pattrib->iv_len =
- ((pattrib->bswenc) ? pattrib->icv_len : 0);
+					rtw_secmicappend(&micdata, payload, length);
+					payload =3D payload + length;
+				} else {
+					length =3D pxmitpriv->frag_len - pattrib->hdrlen - pattrib->iv_len - =
((pattrib->bswenc) ? pattrib->icv_len : 0);
+					rtw_secmicappend(&micdata, payload, length);
+					payload =3D payload + length + pattrib->icv_len;
+				}
+			}
+			rtw_secgetmic(&micdata, &(mic[0]));
+			/* add mic code  and add the mic code length in last_txcmdsz */
+
+			memcpy(payload, &(mic[0]), 8);
+			pattrib->last_txcmdsz +=3D 8;
+
+			payload =3D payload - pattrib->last_txcmdsz + 8;
+		}
+	}
+
+	return _SUCCESS;
+}
