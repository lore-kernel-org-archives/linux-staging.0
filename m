+static void _get_sta_beamform_cap(PADAPTER adapter, struct sta_info *sta,
+	u8 *sta_bf_cap, u8 *sounding_dim, u8 *comp_steering)
+{
+	struct beamforming_info *info;
+	struct ht_priv *ht;
+	u16 bf_cap;
+
+
+	*sta_bf_cap =3D 0;
+	*sounding_dim =3D 0;
+	*comp_steering =3D 0;
+
+	info =3D GET_BEAMFORM_INFO(adapter);
+	ht =3D &adapter->mlmepriv.htpriv;
+
+	if (is_supported_ht(sta->wireless_mode) =3D=3D true) {
+		/* HT */
+		bf_cap =3D ht->beamform_cap;
+
+		if (TEST_FLAG(bf_cap, BEAMFORMING_HT_BEAMFORMEE_ENABLE)) {
