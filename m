+unsigned int update_basic_rate(unsigned char *ptn, unsigned int ptn_sz)
+{
+	unsigned int i, num_of_rate;
+	unsigned int mask =3D 0;
+
+	num_of_rate =3D (ptn_sz > NumRates) ? NumRates : ptn_sz;
+
+	for (i =3D 0; i < num_of_rate; i++) {
+		if ((*(ptn + i)) & 0x80)
+			mask |=3D 0x1 << wifirate2_ratetbl_inx(*(ptn + i));
+	}
+	return mask;
+}
