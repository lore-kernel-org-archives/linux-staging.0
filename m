+static int nl80211_scan_filtered(struct wpa_driver_nl80211_data *drv,
+				 const u8 *ie, size_t ie_len)
+{
+	const u8 *ssid;
+	size_t i;
+
+	if (drv->filter_ssids =3D=3D NULL)
+		return 0;
+
+	ssid =3D nl80211_get_ie(ie, ie_len, WLAN_EID_SSID);
+	if (ssid =3D=3D NULL)
+		return 1;
+
+	for (i =3D 0; i < drv->num_filter_ssids; i++) {
+		if (ssid[1] =3D=3D drv->filter_ssids[i].ssid_len &&
+		    os_memcmp(ssid + 2, drv->filter_ssids[i].ssid, ssid[1]) =3D=3D
+		    0)
+			return 0;
+	}
+
+	return 1;
+}
