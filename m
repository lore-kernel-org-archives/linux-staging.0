1, bMaskByte0);
+	pMptCtx->backup0x52_RF_A =3D (u8)phy_query_rf_reg(pAdapter, RF_PATH_A, RF=
_0x52, 0x000F0);
+	pMptCtx->backup0x52_RF_B =3D (u8)phy_query_rf_reg(pAdapter, RF_PATH_B, RF=
