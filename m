+/* Spatial Multiplexing Powersave (SMPS) action frame */
+static int _issue_action_SM_PS(_adapter *padapter ,  unsigned char *raddr =
, u8 NewMimoPsMode ,  u8 wait_ack)
+{
+
+	int ret =3D _FAIL;
+	unsigned char category =3D RTW_WLAN_CATEGORY_HT;
+	u8 action =3D RTW_WLAN_ACTION_HT_SM_PS;
+	u8 sm_power_control =3D 0;
+	struct xmit_frame			*pmgntframe;
+	struct pkt_attrib			*pattrib;
+	unsigned char					*pframe;
+	struct rtw_ieee80211_hdr	*pwlanhdr;
+	__le16 *fctrl;
+	struct xmit_priv			*pxmitpriv =3D &(padapter->xmitpriv);
+	struct mlme_ext_priv	*pmlmeext =3D &(padapter->mlmeextpriv);
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+
+
+	if (NewMimoPsMode =3D=3D WLAN_HT_CAP_SM_PS_DISABLED) {
+		sm_power_control =3D sm_power_control  & ~(BIT(0)); /* SM Power Save Ena=
ble =3D 0 SM Power Save Disable */
+	} else if (NewMimoPsMode =3D=3D WLAN_HT_CAP_SM_PS_STATIC) {
+		sm_power_control =3D sm_power_control | BIT(0);    /* SM Power Save Enab=
le =3D 1 SM Power Save Enable  */
+		sm_power_control =3D sm_power_control & ~(BIT(1)); /* SM Mode =3D 0 Stat=
ic Mode */
+	} else if (NewMimoPsMode =3D=3D WLAN_HT_CAP_SM_PS_DYNAMIC) {
+		sm_power_control =3D sm_power_control | BIT(0); /* SM Power Save Enable =
=3D 1 SM Power Save Enable  */
+		sm_power_control =3D sm_power_control | BIT(1); /* SM Mode =3D 1 Dynamic=
 Mode */
+	} else
+		return ret;
+
+	if (rtw_rfctl_is_tx_blocked_by_ch_waiting(adapter_to_rfctl(padapter)))
+		return ret;
+
+	RTW_INFO("%s, sm_power_control=3D%u, NewMimoPsMode=3D%u\n", __func__ , sm=
_power_control , NewMimoPsMode);
+
+	pmgntframe =3D alloc_mgtxmitframe(pxmitpriv);
+	if (pmgntframe =3D=3D NULL)
+		return ret;
+
+	/* update attribute */
+	pattrib =3D &pmgntframe->attrib;
+	update_mgntframe_attrib(padapter, pattrib);
+
+	memset(pmgntframe->buf_addr, 0, WLANHDR_OFFSET + TXDESC_OFFSET);
+
+	pframe =3D (u8 *)(pmgntframe->buf_addr) + TXDESC_OFFSET;
+	pwlanhdr =3D (struct rtw_ieee80211_hdr *)pframe;
+
+	fctrl =3D &(pwlanhdr->frame_ctl);
+	*(fctrl) =3D 0;
+
+	memcpy(pwlanhdr->addr1, raddr, ETH_ALEN); /* RA */
+	memcpy(pwlanhdr->addr2, adapter_mac_addr(padapter), ETH_ALEN); /* TA */
+	memcpy(pwlanhdr->addr3, get_my_bssid(&(pmlmeinfo->network)), ETH_ALEN); /=
* DA =3D RA */
+
+	SetSeqNum(pwlanhdr, pmlmeext->mgnt_seq);
+	pmlmeext->mgnt_seq++;
+	set_frame_sub_type(pframe, WIFI_ACTION);
+
+	pframe +=3D sizeof(struct rtw_ieee80211_hdr_3addr);
+	pattrib->pktlen =3D sizeof(struct rtw_ieee80211_hdr_3addr);
+
+	/* category, action */
+	pframe =3D rtw_set_fixed_ie(pframe, 1, &(category), &(pattrib->pktlen));
+	pframe =3D rtw_set_fixed_ie(pframe, 1, &(action), &(pattrib->pktlen));
+
+	pframe =3D rtw_set_fixed_ie(pframe, 1, &(sm_power_control), &(pattrib->pk=
tlen));
+
+	pattrib->last_txcmdsz =3D pattrib->pktlen;
+
+	if (wait_ack)
+		ret =3D dump_mgntframe_and_wait_ack(padapter, pmgntframe);
+	else {
+		dump_mgntframe(padapter, pmgntframe);
+		ret =3D _SUCCESS;
+	}
+
+	if (ret !=3D _SUCCESS)
+		RTW_INFO("%s, ack to\n", __func__);
+
+	return ret;
+}
