+int os_get_time(struct os_time *t)
+{
+#define EPOCHFILETIME (116444736000000000ULL)
+	FILETIME ft;
+	LARGE_INTEGER li;
+	ULONGLONG tt;
+
+#ifdef _WIN32_WCE
+	SYSTEMTIME st;
+
+	GetSystemTime(&st);
+	SystemTimeToFileTime(&st, &ft);
+#else /* _WIN32_WCE */
+	GetSystemTimeAsFileTime(&ft);
+#endif /* _WIN32_WCE */
+	li.LowPart =3D ft.dwLowDateTime;
+	li.HighPart =3D ft.dwHighDateTime;
+	tt =3D (li.QuadPart - EPOCHFILETIME) / 10;
+	t->sec =3D (os_time_t) (tt / 1000000);
+	t->usec =3D (os_time_t) (tt % 1000000);
+
+	return 0;
