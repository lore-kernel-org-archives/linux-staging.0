+/* remove the wlanhdr and add the eth_hdr */
+
+static sint wlanhdr_to_ethhdr(union recv_frame *precvframe)
+{
+	sint	rmv_len;
+	u16	eth_type, len;
+	u8	bsnaphdr;
+	u8	*psnap_type;
+	__be16 be_tmp;
+	struct ieee80211_snap_hdr	*psnap;
+
+	sint ret =3D _SUCCESS;
+	_adapter			*adapter =3D precvframe->u.hdr.adapter;
+	struct mlme_priv	*pmlmepriv =3D &adapter->mlmepriv;
+
+	u8	*ptr =3D get_recvframe_data(precvframe) ; /* point to frame_ctrl field=
 */
+	struct rx_pkt_attrib *pattrib =3D &precvframe->u.hdr.attrib;
+
+
+	if (pattrib->encrypt)
+		recvframe_pull_tail(precvframe, pattrib->icv_len);
+
+	psnap =3D (struct ieee80211_snap_hdr *)(ptr + pattrib->hdrlen + pattrib->=
iv_len);
+	psnap_type =3D ptr + pattrib->hdrlen + pattrib->iv_len + SNAP_SIZE;
+	/* convert hdr + possible LLC headers into Ethernet header */
+	/* eth_type =3D (psnap_type[0] << 8) | psnap_type[1]; */
+	if ((!memcmp(psnap, rtw_rfc1042_header, SNAP_SIZE) &&
+	     (!memcmp(psnap_type, SNAP_ETH_TYPE_IPX, 2) =3D=3D false) &&
+	     (!memcmp(psnap_type, SNAP_ETH_TYPE_APPLETALK_AARP, 2) =3D=3D false))=
 ||
+	    /* eth_type !=3D ETH_P_AARP && eth_type !=3D ETH_P_IPX) || */
+	    !memcmp(psnap, rtw_bridge_tunnel_header, SNAP_SIZE)) {
+		/* remove RFC1042 or Bridge-Tunnel encapsulation and replace EtherType */
+		bsnaphdr =3D true;
+	} else {
+		/* Leave Ethernet header part of hdr and full payload */
+		bsnaphdr =3D false;
+	}
+
+	rmv_len =3D pattrib->hdrlen + pattrib->iv_len + (bsnaphdr ? SNAP_SIZE : 0=
);
+	len =3D precvframe->u.hdr.len - rmv_len;
+
+
+	memcpy(&be_tmp, ptr + rmv_len, 2);
+	eth_type =3D ntohs(be_tmp); /* pattrib->ether_type */
+	pattrib->eth_type =3D cpu_to_le16(eth_type);
+
+#ifdef CONFIG_AUTO_AP_MODE
+	if (0x8899 =3D=3D pattrib->eth_type) {
+		struct sta_info *psta =3D precvframe->u.hdr.psta;
+
+		RTW_INFO("wlan rx: got eth_type=3D0x%x\n", pattrib->eth_type);
+
+		if (psta && psta->isrc && psta->pid > 0) {
+			u16 rx_pid;
+
+			rx_pid =3D *(u16 *)(ptr + rmv_len + 2);
+
+			RTW_INFO("wlan rx(pid=3D0x%x): sta("MAC_FMT") pid=3D0x%x\n",
+				 rx_pid, MAC_ARG(psta->hwaddr), psta->pid);
+
+			if (rx_pid =3D=3D psta->pid) {
+				int i;
+				u16 len =3D *(u16 *)(ptr + rmv_len + 4);
+				/* u16 ctrl_type =3D *(u16*)(ptr+rmv_len+6); */
+
+				/* RTW_INFO("RC: len=3D0x%x, ctrl_type=3D0x%x\n", len, ctrl_type);  */
+				RTW_INFO("RC: len=3D0x%x\n", len);
+
+				for (i =3D 0; i < len; i++)
+					RTW_INFO("0x%x\n", *(ptr + rmv_len + 6 + i));
+				/* RTW_INFO("0x%x\n", *(ptr+rmv_len+8+i)); */
+
+				RTW_INFO("RC-end\n");
+			}
+		}
+	}
+#endif /* CONFIG_AUTO_AP_MODE */
+
+	if ((check_fwstate(pmlmepriv, WIFI_MP_STATE))) {
+		ptr +=3D rmv_len ;
+		*ptr =3D 0x87;
+		*(ptr + 1) =3D 0x12;
+
+		eth_type =3D 0x8712;
+		/* append rx status for mp test packets */
+		ptr =3D recvframe_pull(precvframe, (rmv_len - sizeof(struct ethhdr) + 2)=
 - 24);
+		if (!ptr) {
+			ret =3D _FAIL;
+			goto exiting;
+		}
+		memcpy(ptr, get_rxmem(precvframe), 24);
+		ptr +=3D 24;
+	} else {
+		ptr =3D recvframe_pull(precvframe, (rmv_len - sizeof(struct ethhdr) + (b=
snaphdr ? 2 : 0)));
+		if (!ptr) {
+			ret =3D _FAIL;
+			goto exiting;
+		}
+	}
+
+	if (ptr) {
+		memcpy(ptr, pattrib->dst, ETH_ALEN);
+		memcpy(ptr + ETH_ALEN, pattrib->src, ETH_ALEN);
+
+		if (!bsnaphdr) {
+			be_tmp =3D htons(len);
+			memcpy(ptr + 12, &be_tmp, 2);
+		}
+	}
+
+exiting:
+	return ret;
+
+}
