+static int nl80211_signal_monitor(void *priv, int threshold, int hysteresi=
s)
+{
+	struct i802_bss *bss =3D priv;
+	struct wpa_driver_nl80211_data *drv =3D bss->drv;
+	struct nl_msg *msg, *cqm =3D NULL;
+
+	wpa_printf(MSG_DEBUG, "nl80211: Signal monitor threshold=3D%d "
+		   "hysteresis=3D%d", threshold, hysteresis);
+
+	msg =3D nlmsg_alloc();
+	if (!msg)
+		return -1;
+
+	genlmsg_put(msg, 0, 0, genl_family_get_id(drv->nl80211), 0,
+		    0, NL80211_CMD_SET_CQM, 0);
+
+	NLA_PUT_U32(msg, NL80211_ATTR_IFINDEX, bss->ifindex);
+
+	cqm =3D nlmsg_alloc();
+	if (cqm =3D=3D NULL)
+		return -1;
+
+	NLA_PUT_U32(cqm, NL80211_ATTR_CQM_RSSI_THOLD, threshold);
+	NLA_PUT_U32(cqm, NL80211_ATTR_CQM_RSSI_HYST, hysteresis);
+	nla_put_nested(msg, NL80211_ATTR_CQM, cqm);
+
+	if (send_and_recv_msgs(drv, msg, NULL, NULL) =3D=3D 0)
+		return 0;
+	msg =3D NULL;
+
+nla_put_failure:
+	if (cqm)
+		nlmsg_free(cqm);
+	nlmsg_free(msg);
+	return -1;
+}
