+u8 process_p2p_group_negotation_confirm(struct wifidirect_info *pwdinfo, u=
8 *pframe, uint len)
+{
+	_adapter *padapter =3D pwdinfo->padapter;
+	u8 *ies;
+	u32 ies_len;
+	u8 *p2p_ie;
+	u32	p2p_ielen =3D 0;
+	u8	result =3D P2P_STATUS_SUCCESS;
+	ies =3D pframe + _PUBLIC_ACTION_IE_OFFSET_;
