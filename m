+void count_rx_stats(_adapter *padapter, union recv_frame *prframe, struct =
sta_info *sta)
+{
+	int	sz;
+	struct sta_info		*psta =3D NULL;
+	struct stainfo_stats	*pstats =3D NULL;
+	struct rx_pkt_attrib	*pattrib =3D &prframe->u.hdr.attrib;
+	struct recv_priv		*precvpriv =3D &padapter->recvpriv;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+
+	sz =3D get_recvframe_len(prframe);
+	precvpriv->rx_bytes +=3D sz;
+
+	padapter->mlmepriv.LinkDetectInfo.NumRxOkInPeriod++;
+
+	if ((!MacAddr_isBcst(pattrib->dst)) && (!IS_MCAST(pattrib->dst)))
+		padapter->mlmepriv.LinkDetectInfo.NumRxUnicastOkInPeriod++;
+
+	if (sta)
+		psta =3D sta;
+	else
+		psta =3D prframe->u.hdr.psta;
+
+	if (psta) {
+		pstats =3D &psta->sta_stats;
+
+		pstats->rx_data_pkts++;
+		pstats->rx_bytes +=3D sz;
+
+		pstats->rxratecnt[pattrib->data_rate]++;
+		/*record rx packets for every tid*/
+		pstats->rx_data_qos_pkts[pattrib->priority]++;
+
+#ifdef CONFIG_TDLS
+		if (psta->tdls_sta_state & TDLS_LINKED_STATE) {
+			struct sta_info *pap_sta =3D NULL;
+			pap_sta =3D rtw_get_stainfo(&padapter->stapriv, get_bssid(&padapter->ml=
mepriv));
+			if (pap_sta) {
+				pstats =3D &pap_sta->sta_stats;
+				pstats->rx_data_pkts++;
+				pstats->rx_bytes +=3D sz;
+			}
+		}
+#endif /* CONFIG_TDLS */
+	}
+
+#ifdef CONFIG_CHECK_LEAVE_LPS
+	traffic_check_for_leave_lps(padapter, false, 0);
+#endif /* CONFIG_LPS */
+
+}
