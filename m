+
+		pcmd->cmdcode =3D _SetKey_CMD_;
+		pcmd->parmbuf =3D (u8 *)psetkeyparm;
+		pcmd->cmdsz =3D (sizeof(struct setkey_parm));
+		pcmd->rsp =3D NULL;
