+
+static void nl80211_set_ht40_mode_sec(struct hostapd_hw_modes *mode, int s=
tart,
+				      int end)
+{
+	int c;
+
+	for (c =3D 0; c < mode->num_channels; c++) {
+		struct hostapd_channel_data *chan =3D &mode->channels[c];
+		if (!(chan->flag & HOSTAPD_CHAN_HT40))
+			continue;
+		if (chan->freq - 30 >=3D start && chan->freq - 10 <=3D end)
+			chan->flag |=3D HOSTAPD_CHAN_HT40MINUS;
+		if (chan->freq + 10 >=3D start && chan->freq + 30 <=3D end)
+			chan->flag |=3D HOSTAPD_CHAN_HT40PLUS;
+	}
+}
