+		   __func__, ether_sprintf(addr), authorized);
+
+	if (authorized)
+		mlme.im_op =3D IEEE80211_MLME_AUTHORIZE;
+	else
+		mlme.im_op =3D IEEE80211_MLME_UNAUTHORIZE;
+	mlme.im_reason =3D 0;
+	memcpy(mlme.im_macaddr, addr, IEEE80211_ADDR_LEN);
+	ret =3D set80211priv(drv, IEEE80211_IOCTL_SETMLME, &mlme, sizeof(mlme));
+	if (ret < 0) {
+		wpa_printf(MSG_DEBUG, "%s: Failed to %sauthorize STA " MACSTR,
+			   __func__, authorized ? "" : "un", MAC2STR(addr));
+	}
