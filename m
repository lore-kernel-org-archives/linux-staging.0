+
+	if (!(psta->state & _FW_LINKED)) {
+		RTW_INFO("%s, psta->state(0x%x) !=3D _FW_LINKED\n", __func__, psta->stat=
e);
+		return;
+	}
+
+
+	phtpriv =3D &psta->htpriv;
+
+	if ((phtpriv->ht_option) && (phtpriv->ampdu_enable =3D=3D true)) {
+		issued =3D (phtpriv->agg_enable_bitmap >> priority) & 0x1;
+		issued |=3D (phtpriv->candidate_tid_bitmap >> priority) & 0x1;
+
+		if (0 =3D=3D issued) {
