+static void rtw_hal_construct_CTS(PADAPTER padapter, u8 *pframe, u32 *pLen=
gth)
+{
+	u8 broadcast_addr[ETH_ALEN] =3D {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+
+	/* frame type, length =3D 1*/
+	set_frame_sub_type(pframe, WIFI_RTS);
+
+	/* frame control flag, length =3D 1 */
+	*(pframe + 1) =3D 0;
+
+	/* frame duration, length =3D 2 */
+	*(pframe + 2) =3D 0x00;
+	*(pframe + 3) =3D 0x78;
+
+	/* frame recvaddr, length =3D 6 */
+	memcpy((pframe + 4), broadcast_addr, ETH_ALEN);
+	memcpy((pframe + 4 + ETH_ALEN), adapter_mac_addr(padapter), ETH_ALEN);
+	memcpy((pframe + 4 + ETH_ALEN*2), adapter_mac_addr(padapter), ETH_ALEN);
+	*pLength =3D 22;
