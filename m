+	ssize_t (*write)(struct file *, const char __user *, size_t, loff_t *, vo=
id *) =3D hdl->write;
+
+	if (write)
+		return write(file, buffer, count, pos, ((struct seq_file *)file->private=
_data)->private);
+
+	return -EROFS;
+}
