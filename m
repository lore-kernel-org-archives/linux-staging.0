+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	u8 u_ch;
+	u32 interval_ms =3D 0xffffffff; /* 0xffffffff: special value to make min(=
) works well, also means no auto scan */
