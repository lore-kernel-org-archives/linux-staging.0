+int wpa_driver_wext_set_ssid(void *priv, const u8 *ssid, size_t ssid_len)
+{
+	struct wpa_driver_wext_data *drv =3D priv;
+	struct iwreq iwr;
+	int ret =3D 0;
+	char buf[33];
+
+	if (ssid_len > 32)
