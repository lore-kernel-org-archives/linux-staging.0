+static int wpa_driver_nl80211_send_mlme(void *priv, const u8 *data,
+					size_t data_len)
+{
+	struct i802_bss *bss =3D priv;
+	struct wpa_driver_nl80211_data *drv =3D bss->drv;
+	struct ieee80211_mgmt *mgmt;
+	int encrypt =3D 1;
+	u16 fc;
+
+	mgmt =3D (struct ieee80211_mgmt *) data;
+	fc =3D le_to_host16(mgmt->frame_control);
+
+	if (drv->nlmode =3D=3D NL80211_IFTYPE_STATION &&
+	    WLAN_FC_GET_TYPE(fc) =3D=3D WLAN_FC_TYPE_MGMT &&
+	    WLAN_FC_GET_STYPE(fc) =3D=3D WLAN_FC_STYPE_PROBE_RESP) {
+		/*
+		 * The use of last_mgmt_freq is a bit of a hack,
+		 * but it works due to the single-threaded nature
+		 * of wpa_supplicant.
+		 */
+		return nl80211_send_frame_cmd(drv, drv->last_mgmt_freq, 0,
+					      data, data_len, NULL);
+	}
+
+	if (WLAN_FC_GET_TYPE(fc) =3D=3D WLAN_FC_TYPE_MGMT &&
+	    WLAN_FC_GET_STYPE(fc) =3D=3D WLAN_FC_STYPE_AUTH) {
+		/*
+		 * Only one of the authentication frame types is encrypted.
+		 * In order for static WEP encryption to work properly (i.e.,
+		 * to not encrypt the frame), we need to tell mac80211 about
+		 * the frames that must not be encrypted.
+		 */
+		u16 auth_alg =3D le_to_host16(mgmt->u.auth.auth_alg);
+		u16 auth_trans =3D le_to_host16(mgmt->u.auth.auth_transaction);
+		if (auth_alg !=3D WLAN_AUTH_SHARED_KEY || auth_trans !=3D 3)
+			encrypt =3D 0;
+	}
+
+	return wpa_driver_nl80211_send_frame(drv, data, data_len, encrypt);
+}
