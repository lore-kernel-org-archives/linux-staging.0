+static int wpa_driver_wext_set_auth_alg(void *priv, int auth_alg)
+{
+	struct wpa_driver_wext_data *drv =3D priv;
+	int algs =3D 0, res;
+
+	if (auth_alg & WPA_AUTH_ALG_OPEN)
+		algs |=3D IW_AUTH_ALG_OPEN_SYSTEM;
+	if (auth_alg & WPA_AUTH_ALG_SHARED)
+		algs |=3D IW_AUTH_ALG_SHARED_KEY;
+	if (auth_alg & WPA_AUTH_ALG_LEAP)
+		algs |=3D IW_AUTH_ALG_LEAP;
+	if (algs =3D=3D 0) {
+		/* at least one algorithm should be set */
+		algs =3D IW_AUTH_ALG_OPEN_SYSTEM;
+	}
+
+	res =3D wpa_driver_wext_set_auth_param(drv, IW_AUTH_80211_AUTH_ALG,
+					     algs);
+	drv->auth_alg_fallback =3D res =3D=3D -2;
+	return res;
+}
