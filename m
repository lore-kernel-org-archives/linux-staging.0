+/**
+ * radius_client_flush - Flush all pending RADIUS client messages
+ * @radius: RADIUS client context from radius_client_init()
+ * @only_auth: Whether only authentication messages are removed
+ */
+void radius_client_flush(struct radius_client_data *radius, int only_auth)
+{
+	struct radius_msg_list *entry, *prev, *tmp;
+
+	if (!radius)
+		return;
+
+	prev =3D NULL;
+	entry =3D radius->msgs;
+
+	while (entry) {
+		if (!only_auth || entry->msg_type =3D=3D RADIUS_AUTH) {
+			if (prev)
+				prev->next =3D entry->next;
+			else
+				radius->msgs =3D entry->next;
+
+			tmp =3D entry;
+			entry =3D entry->next;
+			radius_client_msg_free(tmp);
+			radius->num_msgs--;
+		} else {
+			prev =3D entry;
+			entry =3D entry->next;
+		}
+	}
+
+	if (radius->msgs =3D=3D NULL)
+		eloop_cancel_timeout(radius_client_timer, radius, NULL);
+}
