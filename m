+/**
+ * rtw_hal_mcc_sw_ch_fw_notify_hdl - handler flow ctrl
+ */
+static void rtw_hal_mcc_sw_ch_fw_notify_hdl(PADAPTER padapter)
+{
+	struct dvobj_priv *pdvobjpriv =3D adapter_to_dvobj(padapter);
+	struct mcc_obj_priv *pmccobjpriv =3D &(pdvobjpriv->mcc_objpriv);
+	struct mcc_adapter_priv *cur_mccadapriv =3D NULL, *next_mccadapriv =3D NU=
LL;
+	_adapter *iface =3D NULL, *cur_iface =3D NULL, *next_iface =3D NULL;
+	struct registry_priv *preg =3D &padapter->registrypriv;
+	u8 cur_op_ch =3D pdvobjpriv->oper_channel;
+	u8 i =3D 0, iface_num =3D pdvobjpriv->iface_nums, cur_order =3D 0, next_o=
rder =3D 0;
+	static u8 cnt =3D 1;
+	u32 single_tx_cri =3D preg->rtw_mcc_single_tx_cri;
+
+	for (i =3D 0; i < iface_num; i++) {
+		iface =3D pdvobjpriv->padapters[i];
+		if (cur_op_ch =3D=3D iface->mlmeextpriv.cur_channel) {
+			cur_iface =3D iface;
+			cur_mccadapriv =3D &cur_iface->mcc_adapterpriv;
+			cur_order =3D cur_mccadapriv->order;
+			next_order =3D (cur_order + 1) % iface_num;
+			next_iface =3D pmccobjpriv->iface[next_order];
+			next_mccadapriv =3D &next_iface->mcc_adapterpriv;
+			break;
+		}
+	}
+
+	/* check other interface tx busy traffic or not under every 2 switch chan=
nel notify(Mbits/100ms) */
+	if (cnt =3D=3D 2) {
+		cur_mccadapriv->mcc_tp =3D (cur_mccadapriv->mcc_tx_bytes_from_kernel
+			- cur_mccadapriv->mcc_last_tx_bytes_from_kernel) * 10 * 8 / 1024 / 1024;
+		cur_mccadapriv->mcc_last_tx_bytes_from_kernel =3D cur_mccadapriv->mcc_tx=
_bytes_from_kernel;
+
+		next_mccadapriv->mcc_tp =3D (next_mccadapriv->mcc_tx_bytes_from_kernel
+			- next_mccadapriv->mcc_last_tx_bytes_from_kernel) * 10 * 8 / 1024 / 102=
4;
+		next_mccadapriv->mcc_last_tx_bytes_from_kernel =3D next_mccadapriv->mcc_=
tx_bytes_from_kernel;
+
+		cnt =3D 1;
+	} else
+		cnt =3D 2;
+
+	/* check single TX or cuncurrnet TX */
+	if (next_mccadapriv->mcc_tp < single_tx_cri) {
+		/* single TX, does not stop */
+		cur_mccadapriv->mcc_tx_stop =3D false;
+		cur_mccadapriv->mcc_tp_limit =3D false;
+	} else {
+		/* concurrent TX, stop */
+		cur_mccadapriv->mcc_tx_stop =3D true;
+		cur_mccadapriv->mcc_tp_limit =3D true;
+	}
+
+	if (cur_mccadapriv->mcc_tp < single_tx_cri) {
+		next_mccadapriv->mcc_tx_stop  =3D false;
+		next_mccadapriv->mcc_tp_limit =3D false;
+	} else {
+		next_mccadapriv->mcc_tx_stop =3D false;
+		next_mccadapriv->mcc_tp_limit =3D true;
+		next_mccadapriv->mcc_tx_bytes_to_port =3D 0;
+	}
+
+	/* stop current iface kernel queue or not */
+	if (cur_mccadapriv->mcc_tx_stop)
+		rtw_netif_stop_queue(cur_iface->pnetdev);
+	else
+		rtw_netif_wake_queue(cur_iface->pnetdev);
+
+	/* stop next iface kernel queue or not */
+	if (next_mccadapriv->mcc_tx_stop)
+		rtw_netif_stop_queue(next_iface->pnetdev);
+	else
+		rtw_netif_wake_queue(next_iface->pnetdev);
+
+	/* start xmit tasklet */
+	rtw_os_xmit_schedule(next_iface);
+
+	rtw_hal_mcc_check_case_not_limit_traffic(cur_iface, next_iface);
+
+	if (0) {
+		RTW_INFO("order:%d, mcc_tx_stop:%d, mcc_tp:%d\n",
+			cur_mccadapriv->order, cur_mccadapriv->mcc_tx_stop, cur_mccadapriv->mcc=
_tp);
+		dump_os_queue(0, cur_iface);
+		RTW_INFO("order:%d, mcc_tx_stop:%d, mcc_tp:%d\n",
+			next_mccadapriv->order, next_mccadapriv->mcc_tx_stop, next_mccadapriv->=
mcc_tp);
+		dump_os_queue(0, next_iface);
+	}
+}
