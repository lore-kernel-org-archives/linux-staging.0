+static int tlsv1_process_diffie_hellman(struct tlsv1_client *conn,
+					const u8 *buf, size_t len)
+{
+	const u8 *pos, *end;
+
+	tlsv1_client_free_dh(conn);
+
+	pos =3D buf;
+	end =3D buf + len;
+
+	if (end - pos < 3)
+		goto fail;
+	conn->dh_p_len =3D WPA_GET_BE16(pos);
+	pos +=3D 2;
+	if (conn->dh_p_len =3D=3D 0 || end - pos < (int) conn->dh_p_len) {
+		wpa_printf(MSG_DEBUG, "TLSv1: Invalid dh_p length %lu",
+			   (unsigned long) conn->dh_p_len);
+		goto fail;
+	}
+	conn->dh_p =3D os_malloc(conn->dh_p_len);
+	if (conn->dh_p =3D=3D NULL)
+		goto fail;
+	os_memcpy(conn->dh_p, pos, conn->dh_p_len);
+	pos +=3D conn->dh_p_len;
+	wpa_hexdump(MSG_DEBUG, "TLSv1: DH p (prime)",
+		    conn->dh_p, conn->dh_p_len);
+
+	if (end - pos < 3)
+		goto fail;
+	conn->dh_g_len =3D WPA_GET_BE16(pos);
+	pos +=3D 2;
+	if (conn->dh_g_len =3D=3D 0 || end - pos < (int) conn->dh_g_len)
+		goto fail;
+	conn->dh_g =3D os_malloc(conn->dh_g_len);
+	if (conn->dh_g =3D=3D NULL)
+		goto fail;
+	os_memcpy(conn->dh_g, pos, conn->dh_g_len);
+	pos +=3D conn->dh_g_len;
+	wpa_hexdump(MSG_DEBUG, "TLSv1: DH g (generator)",
+		    conn->dh_g, conn->dh_g_len);
+	if (conn->dh_g_len =3D=3D 1 && conn->dh_g[0] < 2)
+		goto fail;
+
+	if (end - pos < 3)
+		goto fail;
+	conn->dh_ys_len =3D WPA_GET_BE16(pos);
+	pos +=3D 2;
+	if (conn->dh_ys_len =3D=3D 0 || end - pos < (int) conn->dh_ys_len)
+		goto fail;
+	conn->dh_ys =3D os_malloc(conn->dh_ys_len);
+	if (conn->dh_ys =3D=3D NULL)
+		goto fail;
+	os_memcpy(conn->dh_ys, pos, conn->dh_ys_len);
+	pos +=3D conn->dh_ys_len;
+	wpa_hexdump(MSG_DEBUG, "TLSv1: DH Ys (server's public value)",
+		    conn->dh_ys, conn->dh_ys_len);
+
+	return 0;
+
+fail:
+	wpa_printf(MSG_DEBUG, "TLSv1: Processing DH params failed");
+	tlsv1_client_free_dh(conn);
+	return -1;
+}
