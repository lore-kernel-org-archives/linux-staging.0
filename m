+u32 rtw_get_ch_waiting_ms(_adapter *adapter, u8 ch, u8 bw, u8 offset, u32 =
*r_non_ocp_ms, u32 *r_cac_ms)
+{
+	struct rf_ctl_t *rfctl =3D adapter_to_rfctl(adapter);
+	struct mlme_ext_priv *mlmeext =3D &adapter->mlmeextpriv;
+	u32 non_ocp_ms;
+	u32 cac_ms;
+	u8 in_rd_range =3D 0; /* if in current radar detection range*/
+
+	if (rtw_chset_is_ch_non_ocp(mlmeext->channel_set, ch, bw, offset))
+		non_ocp_ms =3D rtw_chset_get_ch_non_ocp_ms(mlmeext->channel_set, ch, bw,=
 offset);
+	else
+		non_ocp_ms =3D 0;
+
+	if (rfctl->dfs_master_enabled) {
+		u32 cur_hi, cur_lo, hi, lo;
+
+		if (rtw_chbw_to_freq_range(ch, bw, offset, &hi, &lo) =3D=3D false) {
+			RTW_ERR("input range ch:%u, bw:%u, offset:%u\n", ch, bw, offset);
+			rtw_warn_on(1);
+		}
+
+		if (rtw_chbw_to_freq_range(rfctl->radar_detect_ch, rfctl->radar_detect_b=
w, rfctl->radar_detect_offset, &cur_hi, &cur_lo) =3D=3D false) {
+			RTW_ERR("cur detection range ch:%u, bw:%u, offset:%u\n", rfctl->radar_d=
etect_ch, rfctl->radar_detect_bw, rfctl->radar_detect_offset);
+			rtw_warn_on(1);
+		}
+
+		if (rtw_is_range_a_in_b(hi, lo, cur_hi, cur_lo))
+			in_rd_range =3D 1;
+	}
+
+	if (!rtw_is_dfs_ch(ch, bw, offset))
+		cac_ms =3D 0;
+	else if (in_rd_range && !non_ocp_ms) {
+		if (IS_CH_WAITING(rfctl))
+			cac_ms =3D rtw_systime_to_ms(rfctl->cac_end_time - jiffies);
+		else
+			cac_ms =3D 0;
+	} else if (rtw_is_long_cac_ch(ch, bw, offset, rtw_odm_get_dfs_domain(adap=
ter)))
+		cac_ms =3D CAC_TIME_CE_MS;
+	else
+		cac_ms =3D CAC_TIME_MS;
+
+	if (r_non_ocp_ms)
+		*r_non_ocp_ms =3D non_ocp_ms;
+	if (r_cac_ms)
+		*r_cac_ms =3D cac_ms;
+
+	return non_ocp_ms + cac_ms;
+}
