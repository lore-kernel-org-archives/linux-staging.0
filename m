+	/* pmlmeinfo->assoc_AP_vendor =3D check_assoc_AP(pnetwork->IEs, pnetwork-=
>IELength); */
+
+	/* sizeof(NDIS_802_11_FIXED_IEs)	 */
+	for (i =3D _FIXED_IE_LENGTH_ ; i < pnetwork->IELength - 2 ;) {
+		pIE =3D (PNDIS_802_11_VARIABLE_IEs)(pnetwork->IEs + i);
+
+		switch (pIE->ElementID) {
