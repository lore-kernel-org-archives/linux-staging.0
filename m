+
+static u8 * eap_pwd_get_emsk(struct eap_sm *sm, void *priv, size_t *len)
+{
+	struct eap_pwd_data *data =3D priv;
+	u8 *key;
+
+	if (data->state !=3D SUCCESS)
+		return NULL;
+
+	key =3D os_malloc(EAP_EMSK_LEN);
+	if (key =3D=3D NULL)
+		return NULL;
+
+	os_memcpy(key, data->emsk, EAP_EMSK_LEN);
+	*len =3D EAP_EMSK_LEN;
+
+	return key;
+}
+
+
+static Boolean eap_pwd_is_success(struct eap_sm *sm, void *priv)
+{
+	struct eap_pwd_data *data =3D priv;
+	return data->state =3D=3D SUCCESS;
+}
+
+
+static Boolean eap_pwd_is_done(struct eap_sm *sm, void *priv)
+{
+	struct eap_pwd_data *data =3D priv;
+	return (data->state =3D=3D SUCCESS) || (data->state =3D=3D FAILURE);
+}
+
+
+int eap_server_pwd_register(void)
+{
+	struct eap_method *eap;
+	int ret;
+	struct timeval tp;
+	struct timezone tz;
+	u32 sr;
+
+	EVP_add_digest(EVP_sha256());
+
+	sr =3D 0xdeaddada;
+	(void) gettimeofday(&tp, &tz);
+	sr ^=3D (tp.tv_sec ^ tp.tv_usec);
+	srandom(sr);
+
+	eap =3D eap_server_method_alloc(EAP_SERVER_METHOD_INTERFACE_VERSION,
+				      EAP_VENDOR_IETF, EAP_TYPE_PWD,
+				      "PWD");
+	if (eap =3D=3D NULL)
+		return -1;
+
+	eap->init =3D eap_pwd_init;
+	eap->reset =3D eap_pwd_reset;
+	eap->buildReq =3D eap_pwd_build_req;
+	eap->check =3D eap_pwd_check;
+	eap->process =3D eap_pwd_process;
+	eap->isDone =3D eap_pwd_is_done;
+	eap->getKey =3D eap_pwd_getkey;
+	eap->get_emsk =3D eap_pwd_get_emsk;
+	eap->isSuccess =3D eap_pwd_is_success;
+
+	ret =3D eap_server_method_register(eap);
+	if (ret)
+		eap_server_method_free(eap);
+	return ret;
+}
+
