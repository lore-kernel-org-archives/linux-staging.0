+/**
+ * rtw_os_ndevs_init - Allocate and register OS layer net devices and rela=
ting structures for @dvobj
+ * @dvobj: the dvobj on which this function applies
+ *
+ * Returns:
+ * _SUCCESS or _FAIL
+ */
+int rtw_os_ndevs_init(struct dvobj_priv *dvobj)
+{
+	int ret =3D _FAIL;
+
+	if (rtw_os_ndevs_alloc(dvobj) !=3D _SUCCESS)
+		goto exit;
+
+	if (rtw_os_ndevs_register(dvobj) !=3D _SUCCESS)
+		goto os_ndevs_free;
+
+	ret =3D _SUCCESS;
+
+os_ndevs_free:
+	if (ret !=3D _SUCCESS)
+		rtw_os_ndevs_free(dvobj);
+exit:
+	return ret;
+}
