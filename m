+static void x509_free_name(struct x509_name *name)
+{
+	size_t i;
+
+	for (i =3D 0; i < name->num_attr; i++) {
+		os_free(name->attr[i].value);
+		name->attr[i].value =3D NULL;
+		name->attr[i].type =3D X509_NAME_ATTR_NOT_USED;
+	}
+	name->num_attr =3D 0;
+	os_free(name->email);
+	name->email =3D NULL;
+
+	os_free(name->alt_email);
+	os_free(name->dns);
+	os_free(name->uri);
+	os_free(name->ip);
+	name->alt_email =3D name->dns =3D name->uri =3D NULL;
+	name->ip =3D NULL;
+	name->ip_len =3D 0;
+	os_memset(&name->rid, 0, sizeof(name->rid));
