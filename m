+int tls_connection_set_cipher_list(void *tls_ctx, struct tls_connection *c=
onn,
+				   u8 *ciphers)
+{
+	char buf[100], *pos, *end;
+	u8 *c;
+	int ret;
+
+	if (conn =3D=3D NULL || conn->ssl =3D=3D NULL || ciphers =3D=3D NULL)
+		return -1;
+
+	buf[0] =3D '\0';
+	pos =3D buf;
+	end =3D pos + sizeof(buf);
+
+	c =3D ciphers;
+	while (*c !=3D TLS_CIPHER_NONE) {
+		const char *suite;
+
+		switch (*c) {
+		case TLS_CIPHER_RC4_SHA:
+			suite =3D "RC4-SHA";
+			break;
+		case TLS_CIPHER_AES128_SHA:
