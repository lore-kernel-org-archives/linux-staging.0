+		goto cancel_ps_deny;
+	}
+
+	while (1) {
+		u32 sleep_ms =3D 0;
+		u32 retry_guarantee_ms =3D 0;
+
+		dump_cnt++;
+		tx_ret =3D _cfg80211_rtw_mgmt_tx(padapter, tx_ch, no_cck, buf, len, wait=
_ack);
+
+		switch (action) {
+		case ACT_PUBLIC_GAS_INITIAL_REQ:
+		case ACT_PUBLIC_GAS_INITIAL_RSP:
+			sleep_ms =3D 50;
+			retry_guarantee_ms =3D RTW_MAX_MGMT_TX_MS_GAS;
+		}
+
+		if (tx_ret =3D=3D _SUCCESS
+			|| (dump_cnt >=3D dump_limit && rtw_get_passing_time_ms(start) >=3D ret=
ry_guarantee_ms))
+			break;
+
+		if (sleep_ms > 0)
+			rtw_msleep_os(sleep_ms);
+	}
+
+	if (tx_ret !=3D _SUCCESS || dump_cnt > 1) {
+		RTW_INFO(FUNC_ADPT_FMT" %s (%d/%d) in %d ms\n", FUNC_ADPT_ARG(padapter),
+			tx_ret =3D=3D _SUCCESS ? "OK" : "FAIL", dump_cnt, dump_limit, rtw_get_p=
assing_time_ms(start));
+	}
+
+	switch (type) {
+	case P2P_GO_NEGO_CONF:
+		if (0) {
+			RTW_INFO(FUNC_ADPT_FMT" Nego confirm. state=3D%u, status=3D%u, iaddr=3D=
"MAC_FMT"\n"
+				, FUNC_ADPT_ARG(padapter), pwdev_priv->nego_info.state, pwdev_priv->ne=
go_info.status
+				, MAC_ARG(pwdev_priv->nego_info.iface_addr));
+		}
+		if (pwdev_priv->nego_info.state =3D=3D 2
+			&& pwdev_priv->nego_info.status =3D=3D 0
+			&& rtw_check_invalid_mac_address(pwdev_priv->nego_info.iface_addr, fals=
e) =3D=3D false
+		) {
+			_adapter *intended_iface =3D dvobj_get_adapter_by_addr(dvobj, pwdev_pri=
v->nego_info.iface_addr);
+
+			if (intended_iface) {
+				RTW_INFO(FUNC_ADPT_FMT" Nego confirm. Allow only "ADPT_FMT" to scan fo=
r 2000 ms\n"
+					, FUNC_ADPT_ARG(padapter), ADPT_ARG(intended_iface));
+				/* allow only intended_iface to do scan for 2000 ms */
+				rtw_mi_set_scan_deny(padapter, 2000);
+				rtw_clear_scan_deny(intended_iface);
+			}
+		}
+		break;
+	case P2P_INVIT_RESP:
+		if (pwdev_priv->invit_info.flags & BIT(0)
+			&& pwdev_priv->invit_info.status =3D=3D 0
+		) {
+			RTW_INFO(FUNC_ADPT_FMT" agree with invitation of persistent group\n",
+				FUNC_ADPT_ARG(padapter));
+			#if !RTW_P2P_GROUP_INTERFACE
+			rtw_mi_buddy_set_scan_deny(padapter, 5000);
+			#endif
+			rtw_pwr_wakeup_ex(padapter, 5000);
+		}
+		break;
+	}
+
+cancel_ps_deny:
+	rtw_ps_deny_cancel(padapter, PS_DENY_MGNT_TX);
+exit:
+	return ret;
+}
