+void issue_p2p_GO_request(_adapter *padapter, u8 *raddr)
+{
+
+	unsigned char category =3D RTW_WLAN_CATEGORY_PUBLIC;
+	u8			action =3D P2P_PUB_ACTION_ACTION;
+	__be32			p2poui =3D cpu_to_be32(P2POUI);
+	u8			oui_subtype =3D P2P_GO_NEGO_REQ;
+	u8			wpsie[255] =3D { 0x00 }, p2pie[255] =3D { 0x00 };
+	u8			wpsielen =3D 0, p2pielen =3D 0, i;
+	u8			channel_cnt_24g =3D 0, channel_cnt_5gl =3D 0, channel_cnt_5gh =3D 0;
+	u16			len_channellist_attr =3D 0;
+#ifdef CONFIG_WFD
+	u32					wfdielen =3D 0;
+#endif
+
+	struct xmit_frame			*pmgntframe;
+	struct pkt_attrib			*pattrib;
+	unsigned char					*pframe;
+	struct rtw_ieee80211_hdr	*pwlanhdr;
+	__le16 *fctrl;
+	struct xmit_priv			*pxmitpriv =3D &(padapter->xmitpriv);
+	struct mlme_ext_priv	*pmlmeext =3D &(padapter->mlmeextpriv);
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	struct wifidirect_info	*pwdinfo =3D &(padapter->wdinfo);
+
+
+	pmgntframe =3D alloc_mgtxmitframe(pxmitpriv);
+	if (pmgntframe =3D=3D NULL)
+		return;
+
+	RTW_INFO("[%s] In\n", __func__);
+	/* update attribute */
+	pattrib =3D &pmgntframe->attrib;
+	update_mgntframe_attrib(padapter, pattrib);
+
+	memset(pmgntframe->buf_addr, 0, WLANHDR_OFFSET + TXDESC_OFFSET);
+
+	pframe =3D (u8 *)(pmgntframe->buf_addr) + TXDESC_OFFSET;
+	pwlanhdr =3D (struct rtw_ieee80211_hdr *)pframe;
+
+	fctrl =3D &(pwlanhdr->frame_ctl);
+	*(fctrl) =3D 0;
+
+	memcpy(pwlanhdr->addr1, raddr, ETH_ALEN);
+	memcpy(pwlanhdr->addr2, adapter_mac_addr(padapter), ETH_ALEN);
+	memcpy(pwlanhdr->addr3, adapter_mac_addr(padapter), ETH_ALEN);
+
+	SetSeqNum(pwlanhdr, pmlmeext->mgnt_seq);
+	pmlmeext->mgnt_seq++;
+	set_frame_sub_type(pframe, WIFI_ACTION);
+
+	pframe +=3D sizeof(struct rtw_ieee80211_hdr_3addr);
+	pattrib->pktlen =3D sizeof(struct rtw_ieee80211_hdr_3addr);
+
+	pframe =3D rtw_set_fixed_ie(pframe, 1, &(category), &(pattrib->pktlen));
+	pframe =3D rtw_set_fixed_ie(pframe, 1, &(action), &(pattrib->pktlen));
+	pframe =3D rtw_set_fixed_ie(pframe, 4, (unsigned char *) &(p2poui), &(pat=
trib->pktlen));
+	pframe =3D rtw_set_fixed_ie(pframe, 1, &(oui_subtype), &(pattrib->pktlen)=
);
+	pwdinfo->negotiation_dialog_token =3D 1;	/*	Initialize the dialog value */
+	pframe =3D rtw_set_fixed_ie(pframe, 1, &pwdinfo->negotiation_dialog_token=
, &(pattrib->pktlen));
+
+
+
+	/*	WPS Section */
+	wpsielen =3D 0;
+	/*	WPS OUI */
+	*(__be32 *)(wpsie) =3D cpu_to_be32(WPSOUI);
+	wpsielen +=3D 4;
+
+	/*	WPS version */
+	/*	Type: */
+	*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_ATTR_VER1);
+	wpsielen +=3D 2;
+
+	/*	Length: */
+	*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(0x0001);
+	wpsielen +=3D 2;
+
+	/*	Value: */
+	wpsie[wpsielen++] =3D WPS_VERSION_1;	/*	Version 1.0 */
+
+	/*	Device Password ID */
+	/*	Type: */
+	*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_ATTR_DEVICE_PWID);
+	wpsielen +=3D 2;
+
+	/*	Length: */
+	*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(0x0002);
+	wpsielen +=3D 2;
+
+	/*	Value: */
+
+	if (pwdinfo->ui_got_wps_info =3D=3D P2P_GOT_WPSINFO_PEER_DISPLAY_PIN)
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_DPID_USER_SPEC);
+	else if (pwdinfo->ui_got_wps_info =3D=3D P2P_GOT_WPSINFO_SELF_DISPLAY_PIN)
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_DPID_REGISTRAR_SPEC);
+	else if (pwdinfo->ui_got_wps_info =3D=3D P2P_GOT_WPSINFO_PBC)
+		*(__be16 *)(wpsie + wpsielen) =3D cpu_to_be16(WPS_DPID_PBC);
+
+	wpsielen +=3D 2;
+
+	pframe =3D rtw_set_ie(pframe, _VENDOR_SPECIFIC_IE_, wpsielen, (unsigned c=
har *) wpsie, &pattrib->pktlen);
+
+
+	/*	P2P IE Section. */
+
+	/*	P2P OUI */
+	p2pielen =3D 0;
+	p2pie[p2pielen++] =3D 0x50;
+	p2pie[p2pielen++] =3D 0x6F;
+	p2pie[p2pielen++] =3D 0x9A;
+	p2pie[p2pielen++] =3D 0x09;	/*	WFA P2P v1.0 */
+
+	/*	Commented by Albert 20110306 */
+	/*	According to the P2P Specification, the group negoitation request fram=
e should contain 9 P2P attributes */
+	/*	1. P2P Capability */
+	/*	2. Group Owner Intent */
+	/*	3. Configuration Timeout */
+	/*	4. Listen Channel */
+	/*	5. Extended Listen Timing */
+	/*	6. Intended P2P Interface Address */
+	/*	7. Channel List */
+	/*	8. P2P Device Info */
+	/*	9. Operating Channel */
+
+
+	/*	P2P Capability */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_CAPABILITY;
+
+	/*	Length: */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0002);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	/*	Device Capability Bitmap, 1 byte */
+	p2pie[p2pielen++] =3D DMP_P2P_DEVCAP_SUPPORT;
+
+	/*	Group Capability Bitmap, 1 byte */
+	if (pwdinfo->persistent_supported)
+		p2pie[p2pielen++] =3D P2P_GRPCAP_CROSS_CONN | P2P_GRPCAP_PERSISTENT_GROU=
P;
+	else
+		p2pie[p2pielen++] =3D P2P_GRPCAP_CROSS_CONN;
+
+
+	/*	Group Owner Intent */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_GO_INTENT;
+
+	/*	Length: */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0001);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	/*	Todo the tie breaker bit. */
+	p2pie[p2pielen++] =3D ((pwdinfo->intent << 1) &  0xFE);
+
+	/*	Configuration Timeout */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_CONF_TIMEOUT;
+
+	/*	Length: */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0002);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	p2pie[p2pielen++] =3D 200;	/*	2 seconds needed to be the P2P GO */
+	p2pie[p2pielen++] =3D 200;	/*	2 seconds needed to be the P2P Client */
+
+
+	/*	Listen Channel */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_LISTEN_CH;
+
+	/*	Length: */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0005);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	/*	Country String */
+	p2pie[p2pielen++] =3D 'X';
+	p2pie[p2pielen++] =3D 'X';
+
+	/*	The third byte should be set to 0x04. */
+	/*	Described in the "Operating Channel Attribute" section. */
+	p2pie[p2pielen++] =3D 0x04;
+
+	/*	Operating Class */
+	p2pie[p2pielen++] =3D 0x51;	/*	Copy from SD7 */
+
+	/*	Channel Number */
+	p2pie[p2pielen++] =3D pwdinfo->listen_channel;	/*	listening channel numbe=
r */
+
+
+	/*	Extended Listen Timing ATTR */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_EX_LISTEN_TIMING;
+
+	/*	Length: */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0x0004);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	/*	Availability Period */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0xFFFF);
+	p2pielen +=3D 2;
+
+	/*	Availability Interval */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(0xFFFF);
+	p2pielen +=3D 2;
+
+
+	/*	Intended P2P Interface Address */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_INTENDED_IF_ADDR;
+
+	/*	Length: */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(ETH_ALEN);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	memcpy(p2pie + p2pielen, adapter_mac_addr(padapter), ETH_ALEN);
+	p2pielen +=3D ETH_ALEN;
+
+
+	/*	Channel List */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_CH_LIST;
+
+	/* Length: */
+	/* Country String(3) */
+	/* + ( Operating Class (1) + Number of Channels(1) ) * Operation Classes =
(?) */
+	/* + number of channels in all classes */
+	len_channellist_attr =3D 3
+		       + (1 + 1) * (u16)(pmlmeext->channel_list.reg_classes)
+		       + get_reg_classes_full_count(pmlmeext->channel_list);
+
+#ifdef CONFIG_CONCURRENT_MODE
+	if (rtw_mi_check_status(padapter, MI_LINKED) && padapter->registrypriv.fu=
ll_ch_in_p2p_handshake =3D=3D 0)
+		*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(5 + 1);
+	else
