+
+struct wpabuf * wps_enrollee_get_msg(struct wps_data *wps,
+				     enum wsc_op_code *op_code)
+{
+	struct wpabuf *msg;
+
+	switch (wps->state) {
+	case SEND_M1:
+		msg =3D wps_build_m1(wps);
+		*op_code =3D WSC_MSG;
+		break;
+	case SEND_M3:
+		msg =3D wps_build_m3(wps);
+		*op_code =3D WSC_MSG;
+		break;
+	case SEND_M5:
+		msg =3D wps_build_m5(wps);
+		*op_code =3D WSC_MSG;
+		break;
+	case SEND_M7:
+		msg =3D wps_build_m7(wps);
+		*op_code =3D WSC_MSG;
+		break;
+	case RECEIVED_M2D:
+		if (wps->wps->ap) {
+			msg =3D wps_build_wsc_nack(wps);
+			*op_code =3D WSC_NACK;
+			break;
+		}
+		msg =3D wps_build_wsc_ack(wps);
+		*op_code =3D WSC_ACK;
+		if (msg) {
+			/* Another M2/M2D may be received */
+			wps->state =3D RECV_M2;
+		}
+		break;
+	case SEND_WSC_NACK:
+		msg =3D wps_build_wsc_nack(wps);
+		*op_code =3D WSC_NACK;
+		break;
+	case WPS_MSG_DONE:
+		msg =3D wps_build_wsc_done(wps);
+		*op_code =3D WSC_Done;
+		break;
+	default:
+		wpa_printf(MSG_DEBUG, "WPS: Unsupported state %d for building "
+			   "a message", wps->state);
+		msg =3D NULL;
+		break;
+	}
+
+	if (*op_code =3D=3D WSC_MSG && msg) {
+		/* Save a copy of the last message for Authenticator derivation
+		 */
+		wpabuf_free(wps->last_msg);
+		wps->last_msg =3D wpabuf_dup(msg);
+	}
+
+	return msg;
+}
