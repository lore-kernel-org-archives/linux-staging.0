+void
+odm_change_dynamic_init_gain_thresh(
+	void		*p_dm_void,
+	u32		dm_type,
+	u32		dm_value
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _dynamic_initial_gain_threshold_			*p_dm_dig_table =3D &p_dm_odm->=
dm_dig_table;
+
+	if (dm_type =3D=3D DIG_TYPE_THRESH_HIGH)
+		p_dm_dig_table->rssi_high_thresh =3D dm_value;
+	else if (dm_type =3D=3D DIG_TYPE_THRESH_LOW)
+		p_dm_dig_table->rssi_low_thresh =3D dm_value;
+	else if (dm_type =3D=3D DIG_TYPE_ENABLE)
+		p_dm_dig_table->dig_enable_flag	=3D true;
+	else if (dm_type =3D=3D DIG_TYPE_DISABLE)
+		p_dm_dig_table->dig_enable_flag =3D false;
+	else if (dm_type =3D=3D DIG_TYPE_BACKOFF) {
+		if (dm_value > 30)
+			dm_value =3D 30;
+		p_dm_dig_table->backoff_val =3D (u8)dm_value;
+	} else if (dm_type =3D=3D DIG_TYPE_RX_GAIN_MIN) {
+		if (dm_value =3D=3D 0)
+			dm_value =3D 0x1;
+		p_dm_dig_table->rx_gain_range_min =3D (u8)dm_value;
+	} else if (dm_type =3D=3D DIG_TYPE_RX_GAIN_MAX) {
+		if (dm_value > 0x50)
+			dm_value =3D 0x50;
+		p_dm_dig_table->rx_gain_range_max =3D (u8)dm_value;
+	}
+}	/* dm_change_dynamic_init_gain_thresh */
