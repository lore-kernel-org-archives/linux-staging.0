+static s32 pre_xmitframe(_adapter *padapter, struct xmit_frame *pxmitframe)
+{
+	unsigned long irqL;
+	s32 res;
+	struct xmit_buf *pxmitbuf =3D NULL;
+	struct xmit_priv *pxmitpriv =3D &padapter->xmitpriv;
+	struct pkt_attrib *pattrib =3D &pxmitframe->attrib;
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+
+	_enter_critical_bh(&pxmitpriv->lock, &irqL);
+
+	/* RTW_INFO("=3D=3D> %s\n",__func__); */
+
+	if (rtw_txframes_sta_ac_pending(padapter, pattrib) > 0) {
+		/* RTW_INFO("enqueue AC(%d)\n",pattrib->priority); */
+		goto enqueue;
+	}
+
+	if (rtw_xmit_ac_blocked(padapter) =3D=3D true)
+		goto enqueue;
+
+	if (DEV_STA_LG_NUM(padapter->dvobj))
+		goto enqueue;
+
+	pxmitbuf =3D rtw_alloc_xmitbuf(pxmitpriv);
+	if (pxmitbuf =3D=3D NULL)
