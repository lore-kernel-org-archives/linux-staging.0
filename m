+static int ikev2_derive_keys(struct ikev2_responder_data *data)
+{
+	u8 *buf, *pos, *pad, skeyseed[IKEV2_MAX_HASH_LEN];
+	size_t buf_len, pad_len;
+	struct wpabuf *shared;
+	const struct ikev2_integ_alg *integ;
+	const struct ikev2_prf_alg *prf;
+	const struct ikev2_encr_alg *encr;
+	int ret;
+	const u8 *addr[2];
+	size_t len[2];
+
+	/* RFC 4306, Sect. 2.14 */
+
+	integ =3D ikev2_get_integ(data->proposal.integ);
+	prf =3D ikev2_get_prf(data->proposal.prf);
+	encr =3D ikev2_get_encr(data->proposal.encr);
+	if (integ =3D=3D NULL || prf =3D=3D NULL || encr =3D=3D NULL) {
+		wpa_printf(MSG_INFO, "IKEV2: Unsupported proposal");
+		return -1;
+	}
+
+	shared =3D dh_derive_shared(data->i_dh_public, data->r_dh_private,
+				  data->dh);
+	if (shared =3D=3D NULL)
+		return -1;
+
+	/* Construct Ni | Nr | SPIi | SPIr */
+
+	buf_len =3D data->i_nonce_len + data->r_nonce_len + 2 * IKEV2_SPI_LEN;
+	buf =3D os_malloc(buf_len);
+	if (buf =3D=3D NULL) {
+		wpabuf_free(shared);
+		return -1;
+	}
+
+	pos =3D buf;
+	os_memcpy(pos, data->i_nonce, data->i_nonce_len);
+	pos +=3D data->i_nonce_len;
+	os_memcpy(pos, data->r_nonce, data->r_nonce_len);
+	pos +=3D data->r_nonce_len;
+	os_memcpy(pos, data->i_spi, IKEV2_SPI_LEN);
+	pos +=3D IKEV2_SPI_LEN;
+	os_memcpy(pos, data->r_spi, IKEV2_SPI_LEN);
+#ifdef CCNS_PL
+#if __BYTE_ORDER =3D=3D __LITTLE_ENDIAN
+	{
+		int i;
+		u8 *tmp =3D pos - IKEV2_SPI_LEN;
+		/* Incorrect byte re-ordering on little endian hosts.. */
+		for (i =3D 0; i < IKEV2_SPI_LEN; i++)
+			*tmp++ =3D data->i_spi[IKEV2_SPI_LEN - 1 - i];
+		for (i =3D 0; i < IKEV2_SPI_LEN; i++)
+			*tmp++ =3D data->r_spi[IKEV2_SPI_LEN - 1 - i];
+	}
+#endif
+#endif /* CCNS_PL */
+
+	/* SKEYSEED =3D prf(Ni | Nr, g^ir) */
+	/* Use zero-padding per RFC 4306, Sect. 2.14 */
+	pad_len =3D data->dh->prime_len - wpabuf_len(shared);
+#ifdef CCNS_PL
+	/* Shared secret is not zero-padded correctly */
+	pad_len =3D 0;
+#endif /* CCNS_PL */
+	pad =3D os_zalloc(pad_len ? pad_len : 1);
+	if (pad =3D=3D NULL) {
+		wpabuf_free(shared);
+		os_free(buf);
+		return -1;
+	}
+
+	addr[0] =3D pad;
+	len[0] =3D pad_len;
+	addr[1] =3D wpabuf_head(shared);
+	len[1] =3D wpabuf_len(shared);
+	if (ikev2_prf_hash(prf->id, buf, data->i_nonce_len + data->r_nonce_len,
+			   2, addr, len, skeyseed) < 0) {
+		wpabuf_free(shared);
+		os_free(buf);
+		os_free(pad);
+		return -1;
+	}
+	os_free(pad);
+	wpabuf_free(shared);
+
+	/* DH parameters are not needed anymore, so free them */
+	wpabuf_free(data->i_dh_public);
+	data->i_dh_public =3D NULL;
+	wpabuf_free(data->r_dh_private);
+	data->r_dh_private =3D NULL;
+
+	wpa_hexdump_key(MSG_DEBUG, "IKEV2: SKEYSEED",
+			skeyseed, prf->hash_len);
+
+	ret =3D ikev2_derive_sk_keys(prf, integ, encr, skeyseed, buf, buf_len,
+				   &data->keys);
+	os_free(buf);
+	return ret;
+}
