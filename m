+		break;
+	case 20:
+		ratevalue =3D 1;
+		break;
+	case 55:
+		ratevalue =3D 2;
+		break;
+	case 60:
+		ratevalue =3D 3;
+		break;
+	case 90:
+		ratevalue =3D 4;
+		break;
+	case 110:
+		ratevalue =3D 5;
+		break;
+	case 120:
+		ratevalue =3D 6;
+		break;
+	case 180:
+		ratevalue =3D 7;
+		break;
+	case 240:
+		ratevalue =3D 8;
+		break;
+	case 360:
