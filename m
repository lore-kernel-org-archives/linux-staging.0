+sint On_TDLS_Ch_Switch_Rsp(_adapter *padapter, union recv_frame *precv_fra=
me)
+{
+	struct tdls_ch_switch *pchsw_info =3D &padapter->tdlsinfo.chsw_info;
+	struct sta_info *ptdls_sta =3D NULL;
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+	u8 *ptr =3D precv_frame->u.hdr.rx_data;
+	struct rx_pkt_attrib	*prx_pkt_attrib =3D &precv_frame->u.hdr.attrib;
+	u8 *psa;
+	sint parsing_length;
+	PNDIS_802_11_VARIABLE_IEs	pIE;
+	u8 FIXED_IE =3D 4;
+	u16 status_code, j, switch_time, switch_timeout;
+	struct mlme_ext_priv *pmlmeext =3D &padapter->mlmeextpriv;
+	int ret =3D _SUCCESS;
+
+	if (rtw_tdls_is_chsw_allowed(padapter) =3D=3D false) {
+		RTW_INFO("[TDLS] Ignore %s since channel switch is not allowed\n", __fun=
c__);
+		return _SUCCESS;
+	}
+
+	psa =3D get_sa(ptr);
+	ptdls_sta =3D rtw_get_stainfo(pstapriv, psa);
+
+	if (ptdls_sta =3D=3D NULL) {
+		RTW_INFO("[%s] Direct Link Peer =3D "MAC_FMT" not found\n", __func__, MA=
C_ARG(psa));
+		return _FAIL;
+	}
+
+	/* If we receive Unsolicited TDLS Channel Switch Response when channel sw=
itch is running, */
+	/* we will go back to base channel and terminate this channel switch proc=
edure */
+	if (ATOMIC_READ(&pchsw_info->chsw_on) =3D=3D true) {
+		if (pmlmeext->cur_channel !=3D rtw_get_oper_ch(padapter)) {
+			RTW_INFO("[TDLS] Rx unsolicited channel switch response\n");
+			rtw_tdls_cmd(padapter, ptdls_sta->hwaddr, TDLS_CH_SW_TO_BASE_CHNL);
+			goto exit;
+		}
+	}
+
+	ptr +=3D prx_pkt_attrib->hdrlen + prx_pkt_attrib->iv_len + LLC_HEADER_SIZ=
E + ETH_TYPE_LEN + PAYLOAD_TYPE_LEN;
+	parsing_length =3D ((union recv_frame *)precv_frame)->u.hdr.len
+			 - prx_pkt_attrib->hdrlen
+			 - prx_pkt_attrib->iv_len
+			 - prx_pkt_attrib->icv_len
+			 - LLC_HEADER_SIZE
+			 - ETH_TYPE_LEN
+			 - PAYLOAD_TYPE_LEN
+			 - FIXED_IE;
+
+	memcpy(&status_code, ptr + 2, 2);
+
+	if (status_code !=3D 0) {
+		RTW_INFO("[TDLS] %s status_code:%d\n", __func__, status_code);
+		pchsw_info->ch_sw_state &=3D ~(TDLS_CH_SW_INITIATOR_STATE);
+		rtw_tdls_cmd(padapter, ptdls_sta->hwaddr, TDLS_CH_SW_END);
+		ret =3D _FAIL;
+		goto exit;
+	}
+
+	/* Parsing information element */
+	for (j =3D FIXED_IE; j < parsing_length;) {
+		pIE =3D (PNDIS_802_11_VARIABLE_IEs)(ptr + j);
+
+		switch (pIE->ElementID) {
+		case _LINK_ID_IE_:
+			break;
+		case _CH_SWITCH_TIMING_:
+			memcpy(&switch_time, pIE->data, 2);
+			if (switch_time > ptdls_sta->ch_switch_time)
+				memcpy(&ptdls_sta->ch_switch_time, &switch_time, 2);
+
+			memcpy(&switch_timeout, pIE->data + 2, 2);
+			if (switch_timeout > ptdls_sta->ch_switch_timeout)
+				memcpy(&ptdls_sta->ch_switch_timeout, &switch_timeout, 2);
+			break;
+		default:
+			break;
+		}
+
+		j +=3D (pIE->Length + 2);
+	}
+
+	if ((pmlmeext->cur_channel =3D=3D rtw_get_oper_ch(padapter)) &&
+	    (pchsw_info->ch_sw_state & TDLS_WAIT_CH_RSP_STATE)) {
+		if (ATOMIC_READ(&pchsw_info->chsw_on) =3D=3D true)
+			rtw_tdls_cmd(padapter, ptdls_sta->hwaddr, TDLS_CH_SW_TO_OFF_CHNL);
+	}
+
+exit:
+	return ret;
+}
