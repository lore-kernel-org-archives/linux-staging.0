+			  bool_txt(sm->keyTxEnabled));
+	if (ret < 0 || (size_t) ret >=3D buflen - len)
+		return len;
+	len +=3D ret;
+
+	/* dot1xAuthStatsTable */
+	ret =3D os_snprintf(buf + len, buflen - len,
+			  "dot1xAuthEapolFramesRx=3D%u\n"
+			  "dot1xAuthEapolFramesTx=3D%u\n"
+			  "dot1xAuthEapolStartFramesRx=3D%u\n"
