+static void rtw_cfg80211_init_ht_capab(_adapter *padapter, struct ieee8021=
1_sta_ht_cap *ht_cap, enum nl80211_band band, u8 rf_type)
+{
+	struct hal_spec_t *hal_spec =3D GET_HAL_SPEC(padapter);
+	u8 rx_nss =3D 0;
+
+	ht_cap->ht_supported =3D true;
+
+	ht_cap->cap =3D IEEE80211_HT_CAP_SUP_WIDTH_20_40 |
+				IEEE80211_HT_CAP_SGI_40 | IEEE80211_HT_CAP_SGI_20 |
+				IEEE80211_HT_CAP_DSSSCCK40 | IEEE80211_HT_CAP_MAX_AMSDU;
+	rtw_cfg80211_init_ht_capab_ex(padapter, ht_cap, band, rf_type);
+
+	/*
+	 *Maximum length of AMPDU that the STA can receive.
+	 *Length =3D 2 ^ (13 + max_ampdu_length_exp) - 1 (octets)
+	 */
+	ht_cap->ampdu_factor =3D IEEE80211_HT_MAX_AMPDU_64K;
+
+	/*Minimum MPDU start spacing , */
+	ht_cap->ampdu_density =3D IEEE80211_HT_MPDU_DENSITY_16;
+
+	ht_cap->mcs.tx_params =3D IEEE80211_HT_MCS_TX_DEFINED;
+
+	rx_nss =3D rtw_min(rf_type_to_rf_rx_cnt(rf_type), hal_spec->rx_nss_num);
+	switch (rx_nss) {
+	case 1:
+		ht_cap->mcs.rx_mask[0] =3D 0xFF;
+		break;
+	case 2:
+		ht_cap->mcs.rx_mask[0] =3D 0xFF;
+		ht_cap->mcs.rx_mask[1] =3D 0xFF;
+		break;
+	case 3:
+		ht_cap->mcs.rx_mask[0] =3D 0xFF;
+		ht_cap->mcs.rx_mask[1] =3D 0xFF;
+		ht_cap->mcs.rx_mask[2] =3D 0xFF;
+		break;
+	case 4:
+		ht_cap->mcs.rx_mask[0] =3D 0xFF;
+		ht_cap->mcs.rx_mask[1] =3D 0xFF;
+		ht_cap->mcs.rx_mask[2] =3D 0xFF;
+		ht_cap->mcs.rx_mask[3] =3D 0xFF;
+		break;
+	default:
+		rtw_warn_on(1);
+		RTW_INFO("%s, error rf_type=3D%d\n", __func__, rf_type);
+	};
+
+	ht_cap->mcs.rx_highest =3D
+		cpu_to_le16(rtw_mcs_rate(rf_type,
+					 hal_is_bw_support(padapter,
+							   CHANNEL_WIDTH_40),
+					 hal_is_bw_support(padapter,
+							   CHANNEL_WIDTH_40) ?
+					 ht_cap->cap & IEEE80211_HT_CAP_SGI_40 :
+					 ht_cap->cap & IEEE80211_HT_CAP_SGI_20,
+					 ht_cap->mcs.rx_mask));
+}
