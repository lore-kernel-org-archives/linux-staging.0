+		return -1;
+	if ((buf =3D os_malloc(len)) =3D=3D NULL)
+		return -1;
+	if (sysctl(mib, 6, buf, &len, NULL, 0) < 0) {
+		os_free(buf);
+		return -1;
+	}
+	for (p =3D buf; p < buf + len; p +=3D ifm->ifm_msglen) {
+		ifm =3D (struct if_msghdr *)p;
+		sdl =3D (struct sockaddr_dl *)(ifm + 1);
+		if (ifm->ifm_type !=3D RTM_IFINFO ||
+		    (ifm->ifm_addrs & RTA_IFP) =3D=3D 0)
+			continue;
