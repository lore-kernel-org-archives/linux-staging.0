+
+static int _scard_select_file(struct scard_data *scard, unsigned short fil=
e_id,
+			      unsigned char *buf, size_t *buf_len,
+			      sim_types sim_type, unsigned char *aid,
+			      size_t aidlen)
+{
+	long ret;
+	unsigned char resp[3];
+	unsigned char cmd[50] =3D { SIM_CMD_SELECT };
+	int cmdlen;
+	unsigned char get_resp[5] =3D { SIM_CMD_GET_RESPONSE };
+	size_t len, rlen;
+
+	if (sim_type =3D=3D SCARD_USIM) {
+		cmd[0] =3D USIM_CLA;
+		cmd[3] =3D 0x04;
+		get_resp[0] =3D USIM_CLA;
+	}
+
+	wpa_printf(MSG_DEBUG, "SCARD: select file %04x", file_id);
+	if (aid) {
+		wpa_hexdump(MSG_DEBUG, "SCARD: select file by AID",
+			    aid, aidlen);
+		if (5 + aidlen > sizeof(cmd))
+			return -1;
+		cmd[2] =3D 0x04; /* Select by AID */
+		cmd[4] =3D aidlen; /* len */
+		os_memcpy(cmd + 5, aid, aidlen);
+		cmdlen =3D 5 + aidlen;
+	} else {
+		cmd[5] =3D file_id >> 8;
+		cmd[6] =3D file_id & 0xff;
+		cmdlen =3D 7;
+	}
+	len =3D sizeof(resp);
+	ret =3D scard_transmit(scard, cmd, cmdlen, resp, &len);
+	if (ret !=3D SCARD_S_SUCCESS) {
+		wpa_printf(MSG_WARNING, "SCARD: SCardTransmit failed "
+			   "(err=3D0x%lx)", ret);
+		return -1;
+	}
+
+	if (len !=3D 2) {
+		wpa_printf(MSG_WARNING, "SCARD: unexpected resp len "
+			   "%d (expected 2)", (int) len);
+		return -1;
+	}
+
+	if (resp[0] =3D=3D 0x98 && resp[1] =3D=3D 0x04) {
+		/* Security status not satisfied (PIN_WLAN) */
+		wpa_printf(MSG_WARNING, "SCARD: Security status not satisfied "
+			   "(PIN_WLAN)");
+		return -1;
+	}
+
+	if (resp[0] =3D=3D 0x6e) {
+		wpa_printf(MSG_DEBUG, "SCARD: used CLA not supported");
+		return -1;
+	}
+
+	if (resp[0] !=3D 0x6c && resp[0] !=3D 0x9f && resp[0] !=3D 0x61) {
+		wpa_printf(MSG_WARNING, "SCARD: unexpected response 0x%02x "
+			   "(expected 0x61, 0x6c, or 0x9f)", resp[0]);
+		return -1;
+	}
+	/* Normal ending of command; resp[1] bytes available */
+	get_resp[4] =3D resp[1];
+	wpa_printf(MSG_DEBUG, "SCARD: trying to get response (%d bytes)",
+		   resp[1]);
+
+	rlen =3D *buf_len;
+	ret =3D scard_transmit(scard, get_resp, sizeof(get_resp), buf, &rlen);
+	if (ret =3D=3D SCARD_S_SUCCESS) {
+		*buf_len =3D resp[1] < rlen ? resp[1] : rlen;
+		return 0;
+	}
+
+	wpa_printf(MSG_WARNING, "SCARD: SCardTransmit err=3D0x%lx\n", ret);
+	return -1;
+}
