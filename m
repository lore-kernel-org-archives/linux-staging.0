]=3D %d\n", 2416, ant_a_report));
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("psd_report_B[%d=
]=3D %d\n", 2416, ant_b_report));
+
+		/* 2 Test ant B based on ant A is ON */
+		if ((ant_a_report >=3D 100) && (ant_b_report >=3D 100) && (ant_a_report =
<=3D 135) && (ant_b_report <=3D 135)) {
+			u8 TH1 =3D 2, TH2 =3D 6;
+
+			if ((ant_a_report - ant_b_report < TH1) || (ant_b_report - ant_a_report=
 < TH1)) {
