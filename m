+/*
+ *	Description:
+ *	Setting BT coex antenna isolation type .
+ *	coex mechanisn/ spital stream/ best throughput
+ *	anttype =3D 0	,	PSTDMA	/	2SS	/	0.5T	,	bad isolation , WiFi/BT ANT Dista=
nce<15cm , (<20dB) for 2,3 antenna
+ *	anttype =3D 1	,	PSTDMA	/	1SS	/	0.5T	,	normal isolaiton , 50cm>WiFi/BT A=
NT Distance>15cm , (>20dB) for 2 antenna
+ *	anttype =3D 2	,	TDMA	/	2SS	/	T ,		normal isolaiton , 50cm>WiFi/BT ANT D=
istance>15cm , (>20dB) for 3 antenna
+ *	anttype =3D 3	,	no TDMA	/	1SS	/	0.5T	,	good isolation , WiFi/BT ANT Dis=
tance >50cm , (>40dB) for 2 antenna
+ *	anttype =3D 4	,	no TDMA	/	2SS	/	T ,		good isolation , WiFi/BT ANT Dista=
nce >50cm , (>40dB) for 3 antenna
+ *	wifi only throughput ~ T
+ *	wifi/BT share one antenna with SPDT
+ */
+void hal_btcoex_SetAntIsolationType(PADAPTER padapter, u8 anttype)
+{
+	PHAL_DATA_TYPE pHalData;
+	PBTC_COEXIST	pBtCoexist =3D &GLBtCoexist;
+
+	/*RTW_INFO("####%s , anttype =3D %d  , %d\n" , __func__ , anttype , __LIN=
E__); */
+	pHalData =3D GET_HAL_DATA(padapter);
+
+
+	pHalData->bt_coexist.btAntisolation =3D anttype;
+
+	switch (pHalData->bt_coexist.btAntisolation) {
+	case 0:
+		pBtCoexist->board_info.ant_type =3D (u8)BTC_ANT_TYPE_0;
+		break;
+	case 1:
+		pBtCoexist->board_info.ant_type =3D (u8)BTC_ANT_TYPE_1;
+		break;
+	case 2:
+		pBtCoexist->board_info.ant_type =3D (u8)BTC_ANT_TYPE_2;
+		break;
+	case 3:
+		pBtCoexist->board_info.ant_type =3D (u8)BTC_ANT_TYPE_3;
+		break;
+	case 4:
+		pBtCoexist->board_info.ant_type =3D (u8)BTC_ANT_TYPE_4;
+		break;
+	}
+
+}
