+#ifndef CONFIG_NO_VLAN
+static int hostapd_config_read_vlan_file(struct hostapd_bss_config *bss,
+					 const char *fname)
+{
+	FILE *f;
+	char buf[128], *pos, *pos2;
+	int line =3D 0, vlan_id;
+	struct hostapd_vlan *vlan;
+
+	f =3D fopen(fname, "r");
+	if (!f) {
+		wpa_printf(MSG_ERROR, "VLAN file '%s' not readable.", fname);
+		return -1;
+	}
+
+	while (fgets(buf, sizeof(buf), f)) {
+		line++;
+
+		if (buf[0] =3D=3D '#')
+			continue;
+		pos =3D buf;
+		while (*pos !=3D '\0') {
+			if (*pos =3D=3D '\n') {
+				*pos =3D '\0';
+				break;
+			}
+			pos++;
+		}
+		if (buf[0] =3D=3D '\0')
+			continue;
+
+		if (buf[0] =3D=3D '*') {
+			vlan_id =3D VLAN_ID_WILDCARD;
+			pos =3D buf + 1;
+		} else {
+			vlan_id =3D strtol(buf, &pos, 10);
+			if (buf =3D=3D pos || vlan_id < 1 ||
+			    vlan_id > MAX_VLAN_ID) {
+				wpa_printf(MSG_ERROR, "Invalid VLAN ID at "
+					   "line %d in '%s'", line, fname);
+				fclose(f);
+				return -1;
+			}
+		}
+
+		while (*pos =3D=3D ' ' || *pos =3D=3D '\t')
+			pos++;
+		pos2 =3D pos;
+		while (*pos2 !=3D ' ' && *pos2 !=3D '\t' && *pos2 !=3D '\0')
+			pos2++;
+		*pos2 =3D '\0';
+		if (*pos =3D=3D '\0' || os_strlen(pos) > IFNAMSIZ) {
+			wpa_printf(MSG_ERROR, "Invalid VLAN ifname at line %d "
+				   "in '%s'", line, fname);
+			fclose(f);
+			return -1;
+		}
+
+		vlan =3D os_malloc(sizeof(*vlan));
+		if (vlan =3D=3D NULL) {
+			wpa_printf(MSG_ERROR, "Out of memory while reading "
+				   "VLAN interfaces from '%s'", fname);
+			fclose(f);
+			return -1;
+		}
+
+		os_memset(vlan, 0, sizeof(*vlan));
+		vlan->vlan_id =3D vlan_id;
+		os_strlcpy(vlan->ifname, pos, sizeof(vlan->ifname));
+		if (bss->vlan_tail)
+			bss->vlan_tail->next =3D vlan;
+		else
+			bss->vlan =3D vlan;
+		bss->vlan_tail =3D vlan;
+	}
+
+	fclose(f);
+
+	return 0;
+}
