+static int hexstr2bin(const char *hex, u8 *buf, size_t len)
+{
+	size_t i;
+	int a;
+	const char *ipos =3D hex;
+	u8 *opos =3D buf;
+
+	for (i =3D 0; i < len; i++) {
+		a =3D hex2byte_i(ipos);
+		if (a < 0)
+			return -1;
+		*opos++ =3D a;
+		ipos +=3D 2;
+	}
+	return 0;
+}
