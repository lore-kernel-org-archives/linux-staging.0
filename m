+
+static int nl80211_set_conn_keys(struct wpa_driver_associate_params *param=
s,
+				 struct nl_msg *msg)
+{
+	int i, privacy =3D 0;
+	struct nlattr *nl_keys, *nl_key;
+
+	for (i =3D 0; i < 4; i++) {
+		if (!params->wep_key[i])
+			continue;
+		privacy =3D 1;
+		break;
+	}
+	if (params->wps =3D=3D WPS_MODE_PRIVACY)
+		privacy =3D 1;
+	if (params->pairwise_suite &&
+	    params->pairwise_suite !=3D WPA_CIPHER_NONE)
+		privacy =3D 1;
+
+	if (!privacy)
+		return 0;
+
+	NLA_PUT_FLAG(msg, NL80211_ATTR_PRIVACY);
+
+	nl_keys =3D nla_nest_start(msg, NL80211_ATTR_KEYS);
+	if (!nl_keys)
+		goto nla_put_failure;
+
+	for (i =3D 0; i < 4; i++) {
+		if (!params->wep_key[i])
+			continue;
+
+		nl_key =3D nla_nest_start(msg, i);
+		if (!nl_key)
+			goto nla_put_failure;
+
+		NLA_PUT(msg, NL80211_KEY_DATA, params->wep_key_len[i],
+			params->wep_key[i]);
+		if (params->wep_key_len[i] =3D=3D 5)
+			NLA_PUT_U32(msg, NL80211_KEY_CIPHER,
+				    WLAN_CIPHER_SUITE_WEP40);
+		else
+			NLA_PUT_U32(msg, NL80211_KEY_CIPHER,
+				    WLAN_CIPHER_SUITE_WEP104);
+
+		NLA_PUT_U8(msg, NL80211_KEY_IDX, i);
+
+		if (i =3D=3D params->wep_tx_keyidx)
+			NLA_PUT_FLAG(msg, NL80211_KEY_DEFAULT);
+
+		nla_nest_end(msg, nl_key);
+	}
+	nla_nest_end(msg, nl_keys);
+
+	return 0;
+
+nla_put_failure:
+	return -ENOBUFS;
+}
