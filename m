+struct wpabuf * eap_sm_buildIdentity(struct eap_sm *sm, int id, int encryp=
ted)
+{
+	struct eap_peer_config *config =3D eap_get_config(sm);
+	struct wpabuf *resp;
+	const u8 *identity;
+	size_t identity_len;
+
+	if (config =3D=3D NULL) {
