+static struct wpa_scan_results * wpa_driver_ndis_get_scan_results(void *pr=
iv)
+{
+	struct wpa_driver_ndis_data *drv =3D priv;
+	NDIS_802_11_BSSID_LIST_EX *b;
+	size_t blen, count, i;
+	int len;
+	char *pos;
+	struct wpa_scan_results *results;
+	struct wpa_scan_res *r;
+
+	blen =3D 65535;
+	b =3D os_zalloc(blen);
+	if (b =3D=3D NULL)
+		return NULL;
+	len =3D ndis_get_oid(drv, OID_802_11_BSSID_LIST, (char *) b, blen);
+	if (len < 0) {
+		wpa_printf(MSG_DEBUG, "NDIS: failed to get scan results");
+		os_free(b);
+		return NULL;
+	}
+	count =3D b->NumberOfItems;
+
+	results =3D os_zalloc(sizeof(*results));
+	if (results =3D=3D NULL) {
+		os_free(b);
+		return NULL;
+	}
+	results->res =3D os_zalloc(count * sizeof(struct wpa_scan_res *));
+	if (results->res =3D=3D NULL) {
+		os_free(results);
+		os_free(b);
+		return NULL;
+	}
+
+	pos =3D (char *) &b->Bssid[0];
+	for (i =3D 0; i < count; i++) {
+		NDIS_WLAN_BSSID_EX *bss =3D (NDIS_WLAN_BSSID_EX *) pos;
+		NDIS_802_11_FIXED_IEs *fixed;
+
+		if (bss->IELength < sizeof(NDIS_802_11_FIXED_IEs)) {
+			wpa_printf(MSG_DEBUG, "NDIS: too small IELength=3D%d",
+				   (int) bss->IELength);
+			break;
+		}
+		if (((char *) bss->IEs) + bss->IELength  > (char *) b + blen) {
+			/*
+			 * Some NDIS drivers have been reported to include an
+			 * entry with an invalid IELength in scan results and
+			 * this has crashed wpa_supplicant, so validate the
+			 * returned value before using it.
+			 */
+			wpa_printf(MSG_DEBUG, "NDIS: skipped invalid scan "
+				   "result IE (BSSID=3D" MACSTR ") IELength=3D%d",
+				   MAC2STR(bss->MacAddress),
+				   (int) bss->IELength);
+			break;
+		}
+
+		r =3D os_zalloc(sizeof(*r) + bss->IELength -
+			      sizeof(NDIS_802_11_FIXED_IEs));
+		if (r =3D=3D NULL)
+			break;
+
+		os_memcpy(r->bssid, bss->MacAddress, ETH_ALEN);
+		r->level =3D (int) bss->Rssi;
+		r->freq =3D bss->Configuration.DSConfig / 1000;
+		fixed =3D (NDIS_802_11_FIXED_IEs *) bss->IEs;
+		r->beacon_int =3D WPA_GET_LE16((u8 *) &fixed->BeaconInterval);
+		r->caps =3D WPA_GET_LE16((u8 *) &fixed->Capabilities);
+		r->tsf =3D WPA_GET_LE64(fixed->Timestamp);
+		os_memcpy(r + 1, bss->IEs + sizeof(NDIS_802_11_FIXED_IEs),
+			  bss->IELength - sizeof(NDIS_802_11_FIXED_IEs));
+		r->ie_len =3D bss->IELength - sizeof(NDIS_802_11_FIXED_IEs);
+		r =3D wpa_driver_ndis_add_scan_ssid(r, &bss->Ssid);
+
+		results->res[results->num++] =3D r;
+
+		pos +=3D bss->Length;
+		if (pos > (char *) b + blen)
+			break;
+	}
+
+	os_free(b);
+
+	return results;
+}
