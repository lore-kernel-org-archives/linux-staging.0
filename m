+	 * Reinitialize GTK to make sure it is suitable for the new
+	 * configuration.
+	 */
+	group =3D wpa_auth->group;
+	wpa_group_set_key_len(group, wpa_auth->conf.wpa_group);
+	group->GInit =3D TRUE;
+	wpa_group_sm_step(wpa_auth, group);
+	group->GInit =3D FALSE;
+	wpa_group_sm_step(wpa_auth, group);
+
+	return 0;
+}
