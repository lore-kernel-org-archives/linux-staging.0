+			return -1;
+		}
+	}
+
+	len =3D os_strlen(own_dir) + 50;
+	drv->own_socket_path =3D os_malloc(len);
+	if (drv->own_socket_path =3D=3D NULL) {
+		os_free(priv_dir);
