+	for (i =3D 0; i < MAX_CHANNEL_NUM; i++) {
+		if (regsty->excl_chs[i] =3D=3D 0)
+			break;
+		if (regsty->excl_chs[i] =3D=3D ch)
+			return true;
+	}
+	return false;
+}
