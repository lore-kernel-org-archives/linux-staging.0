+static void wext_get_scan_custom(struct iw_event *iwe,
+				 struct wext_scan_data *res, char *custom,
+				 char *end)
+{
+	size_t clen;
+	u8 *tmp;
+
+	clen =3D iwe->u.data.length;
+	if (custom + clen > end)
+		return;
+
+	if (clen > 7 && os_strncmp(custom, "wpa_ie=3D", 7) =3D=3D 0) {
+		char *spos;
+		int bytes;
+		spos =3D custom + 7;
+		bytes =3D custom + clen - spos;
+		if (bytes & 1 || bytes =3D=3D 0)
+			return;
+		bytes /=3D 2;
+		tmp =3D os_realloc(res->ie, res->ie_len + bytes);
+		if (tmp =3D=3D NULL)
+			return;
+		res->ie =3D tmp;
+		if (hexstr2bin(spos, tmp + res->ie_len, bytes) < 0)
+			return;
+		res->ie_len +=3D bytes;
+	} else if (clen > 7 && os_strncmp(custom, "rsn_ie=3D", 7) =3D=3D 0) {
+		char *spos;
+		int bytes;
+		spos =3D custom + 7;
+		bytes =3D custom + clen - spos;
+		if (bytes & 1 || bytes =3D=3D 0)
+			return;
+		bytes /=3D 2;
+		tmp =3D os_realloc(res->ie, res->ie_len + bytes);
+		if (tmp =3D=3D NULL)
+			return;
+		res->ie =3D tmp;
+		if (hexstr2bin(spos, tmp + res->ie_len, bytes) < 0)
+			return;
+		res->ie_len +=3D bytes;
+	} else if (clen > 4 && os_strncmp(custom, "tsf=3D", 4) =3D=3D 0) {
+		char *spos;
+		int bytes;
+		u8 bin[8];
+		spos =3D custom + 4;
+		bytes =3D custom + clen - spos;
+		if (bytes !=3D 16) {
+			wpa_printf(MSG_INFO, "Invalid TSF length (%d)", bytes);
+			return;
+		}
+		bytes /=3D 2;
+		if (hexstr2bin(spos, bin, bytes) < 0) {
+			wpa_printf(MSG_DEBUG, "WEXT: Invalid TSF value");
+			return;
+		}
+		res->res.tsf +=3D WPA_GET_BE64(bin);
+	}
+}
