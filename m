+static int get_defaultgw(u32 *ip_addr , char mac[])
+{
+	int gw_index =3D 0; /* oif device index */
+	struct net_device *gw_dev =3D NULL; /* oif device */
+
+	route_dump(ip_addr, &gw_index);
+
+	if (!(*ip_addr) || !gw_index) {
+		/* RTW_INFO("No default GW\n"); */
+		return -1;
+	}
+
+	gw_dev =3D dev_get_by_index(&init_net, gw_index);
+
+	if (gw_dev =3D=3D NULL) {
+		/* RTW_INFO("get Oif Device Fail\n"); */
+		return -1;
+	}
+
+	if (!arp_query(mac, *ip_addr, gw_dev)) {
+		/* RTW_INFO( "arp query failed\n"); */
+		dev_put(gw_dev);
+		return -1;
+
+	}
+	dev_put(gw_dev);
+
+	return 0;
+}
