+static void wpa_driver_test_mlme(struct wpa_driver_test_data *drv,
+				 struct sockaddr *from,
+				 socklen_t fromlen,
+				 const u8 *data, size_t data_len)
+{
+	int freq =3D 0, own_freq;
+	union wpa_event_data event;
+	const struct ieee80211_mgmt *mgmt;
+	u16 fc;
+	struct test_driver_bss *bss;
+
+	bss =3D dl_list_first(&drv->bss, struct test_driver_bss, list);
+	if (data_len > 6 && os_memcmp(data, "freq=3D", 5) =3D=3D 0) {
+		size_t pos;
+		for (pos =3D 5; pos < data_len; pos++) {
+			if (data[pos] =3D=3D ' ')
+				break;
+		}
+		if (pos < data_len) {
+			freq =3D atoi((const char *) &data[5]);
+			wpa_printf(MSG_DEBUG, "test_driver(%s): MLME RX on "
+				   "freq %d MHz", bss->ifname, freq);
+			pos++;
+			data +=3D pos;
+			data_len -=3D pos;
+		}
+	}
+
+	if (drv->remain_on_channel_freq)
+		own_freq =3D drv->remain_on_channel_freq;
+	else
+		own_freq =3D drv->current_freq;
+
+	if (freq && own_freq && freq !=3D own_freq) {
+		wpa_printf(MSG_DEBUG, "test_driver(%s): Ignore MLME RX on "
+			   "another frequency %d MHz (own %d MHz)",
+			   bss->ifname, freq, own_freq);
+		return;
+	}
+
+	os_memset(&event, 0, sizeof(event));
+	event.mlme_rx.buf =3D data;
+	event.mlme_rx.len =3D data_len;
+	event.mlme_rx.freq =3D freq;
+	wpa_supplicant_event(drv->ctx, EVENT_MLME_RX, &event);
+
+	mgmt =3D (const struct ieee80211_mgmt *) data;
+	fc =3D le_to_host16(mgmt->frame_control);
+
+	if (drv->probe_req_report && data_len >=3D 24) {
+		if (WLAN_FC_GET_TYPE(fc) =3D=3D WLAN_FC_TYPE_MGMT &&
+		    WLAN_FC_GET_STYPE(fc) =3D=3D WLAN_FC_STYPE_PROBE_REQ) {
+			os_memset(&event, 0, sizeof(event));
+			event.rx_probe_req.sa =3D mgmt->sa;
+			event.rx_probe_req.ie =3D mgmt->u.probe_req.variable;
+			event.rx_probe_req.ie_len =3D
+				data_len - (mgmt->u.probe_req.variable - data);
+			wpa_supplicant_event(drv->ctx, EVENT_RX_PROBE_REQ,
+					     &event);
+#ifdef CONFIG_P2P
+			if (drv->p2p)
+				p2p_probe_req_rx(drv->p2p, mgmt->sa,
+						 event.rx_probe_req.ie,
+						 event.rx_probe_req.ie_len);
+#endif /* CONFIG_P2P */
+		}
+	}
+
+#ifdef CONFIG_P2P
+	if (drv->p2p &&
+	    WLAN_FC_GET_TYPE(fc) =3D=3D WLAN_FC_TYPE_MGMT &&
+	    WLAN_FC_GET_STYPE(fc) =3D=3D WLAN_FC_STYPE_ACTION) {
+		size_t hdr_len;
+		hdr_len =3D (const u8 *)
+			&mgmt->u.action.u.vs_public_action.action - data;
+		p2p_rx_action(drv->p2p, mgmt->da, mgmt->sa, mgmt->bssid,
+			      mgmt->u.action.category,
+			      &mgmt->u.action.u.vs_public_action.action,
+			      data_len - hdr_len, freq);
+	}
+#endif /* CONFIG_P2P */
+
+}
