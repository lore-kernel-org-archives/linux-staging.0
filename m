+static void handle_tx_callback(void *ctx, u8 *buf, size_t len, int ok)
+{
+	struct ieee80211_hdr *hdr;
+	u16 fc;
+	union wpa_event_data event;
+
+	hdr =3D (struct ieee80211_hdr *) buf;
+	fc =3D le_to_host16(hdr->frame_control);
+
+	os_memset(&event, 0, sizeof(event));
+	event.tx_status.type =3D WLAN_FC_GET_TYPE(fc);
+	event.tx_status.stype =3D WLAN_FC_GET_STYPE(fc);
+	event.tx_status.dst =3D hdr->addr1;
+	event.tx_status.data =3D buf;
+	event.tx_status.data_len =3D len;
+	event.tx_status.ack =3D ok;
+	wpa_supplicant_event(ctx, EVENT_TX_STATUS, &event);
+}
