+static int hostap_send_mlme(void *priv, const u8 *msg, size_t len)
+{
+	struct hostap_driver_data *drv =3D priv;
+	struct ieee80211_hdr *hdr =3D (struct ieee80211_hdr *) msg;
+	int res;
+
+	/* Request TX callback */
+	hdr->frame_control |=3D host_to_le16(BIT(1));
+	res =3D send(drv->sock, msg, len, 0);
+	hdr->frame_control &=3D ~host_to_le16(BIT(1));
+
+	return res;
+}
+
+
+static int hostap_send_eapol(void *priv, const u8 *addr, const u8 *data,
+			     size_t data_len, int encrypt, const u8 *own_addr,
+			     u32 flags)
+{
+	struct hostap_driver_data *drv =3D priv;
+	struct ieee80211_hdr *hdr;
+	size_t len;
+	u8 *pos;
+	int res;
+
+	len =3D sizeof(*hdr) + sizeof(rfc1042_header) + 2 + data_len;
+	hdr =3D os_zalloc(len);
+	if (hdr =3D=3D NULL) {
+		printf("malloc() failed for hostapd_send_data(len=3D%lu)\n",
+		       (unsigned long) len);
+		return -1;
+	}
+
+	hdr->frame_control =3D
+		IEEE80211_FC(WLAN_FC_TYPE_DATA, WLAN_FC_STYPE_DATA);
+	hdr->frame_control |=3D host_to_le16(WLAN_FC_FROMDS);
+	if (encrypt)
+		hdr->frame_control |=3D host_to_le16(WLAN_FC_ISWEP);
+	memcpy(hdr->IEEE80211_DA_FROMDS, addr, ETH_ALEN);
+	memcpy(hdr->IEEE80211_BSSID_FROMDS, own_addr, ETH_ALEN);
+	memcpy(hdr->IEEE80211_SA_FROMDS, own_addr, ETH_ALEN);
+
+	pos =3D (u8 *) (hdr + 1);
+	memcpy(pos, rfc1042_header, sizeof(rfc1042_header));
+	pos +=3D sizeof(rfc1042_header);
+	*((u16 *) pos) =3D htons(ETH_P_PAE);
+	pos +=3D 2;
+	memcpy(pos, data, data_len);
+
+	res =3D hostap_send_mlme(drv, (u8 *) hdr, len);
+	if (res < 0) {
+		wpa_printf(MSG_ERROR, "hostap_send_eapol - packet len: %lu - "
+			   "failed: %d (%s)",
+			   (unsigned long) len, errno, strerror(errno));
+	}
+	free(hdr);
+
+	return res;
+}
