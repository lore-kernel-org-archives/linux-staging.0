+#endif
+#ifdef CONFIG_MCC_MODE
+		/*
+		 * due to tx ps null date to ao, so ap doest not tx pkt to driver
+		 * we may check chk_ap_is_alive fail, and may issue_probereq to wrong ch=
annel under sitesurvey
+		 * don't keep alive check under MCC
+		 */
+		if (rtw_hal_mcc_link_status_chk(padapter, __func__) =3D=3D false)
+			return;
+#endif
+
+#if defined(DBG_ROAMING_TEST)
+		rx_chk_limit =3D 1;
+#elif defined(CONFIG_ACTIVE_KEEP_ALIVE_CHECK) && !defined(CONFIG_LPS_LCLK_=
WD_TIMER)
+		rx_chk_limit =3D 4;
+#else
+		rx_chk_limit =3D 8;
+#endif
+#ifdef CONFIG_ARP_KEEP_ALIVE
+		if (!from_timer && pmlmepriv->bGetGateway =3D=3D 1 && pmlmepriv->GetGate=
wayTryCnt < 3) {
+			RTW_INFO("do rtw_gw_addr_query() : %d\n", pmlmepriv->GetGatewayTryCnt);
+			pmlmepriv->GetGatewayTryCnt++;
+			if (rtw_gw_addr_query(padapter) =3D=3D 0)
+				pmlmepriv->bGetGateway =3D 0;
+			else {
+				memset(pmlmepriv->gw_ip, 0, 4);
+				memset(pmlmepriv->gw_mac_addr, 0, 6);
+			}
+		}
+#endif
+#ifdef CONFIG_P2P
+		if (!rtw_p2p_chk_state(&padapter->wdinfo, P2P_STATE_NONE)) {
+			if (!from_timer)
+				link_count_limit =3D 3; /* 8 sec */
+			else
+				link_count_limit =3D 15; /* 32 sec */
+		} else
+#endif /* CONFIG_P2P */
+		{
+			if (!from_timer)
+				link_count_limit =3D 7; /* 16 sec */
+			else
+				link_count_limit =3D 29; /* 60 sec */
+		}
+
+#ifdef CONFIG_TDLS
+#ifdef CONFIG_TDLS_CH_SW
+		if (ATOMIC_READ(&padapter->tdlsinfo.chsw_info.chsw_on))
+			return;
+#endif /* CONFIG_TDLS_CH_SW */
+
+#ifdef CONFIG_TDLS_AUTOCHECKALIVE
+		linked_status_chk_tdls(padapter);
+#endif /* CONFIG_TDLS_AUTOCHECKALIVE */
+#endif /* CONFIG_TDLS */
+
+		psta =3D rtw_get_stainfo(pstapriv, pmlmeinfo->network.MacAddress);
+		if (psta !=3D NULL) {
+			bool is_p2p_enable =3D false;
+#ifdef CONFIG_P2P
+			is_p2p_enable =3D !rtw_p2p_chk_state(&padapter->wdinfo, P2P_STATE_NONE);
+#endif
+
+#ifdef CONFIG_ISSUE_DELBA_WHEN_NO_TRAFFIC=20
+			/*issue delba when ap does not tx data packet that is Broadcom ap */
+			rtw_delba_check(padapter, psta, from_timer);
+#endif
+			if (chk_ap_is_alive(padapter, psta) =3D=3D false)
+				rx_chk =3D _FAIL;
+
+			if (pxmitpriv->last_tx_pkts =3D=3D pxmitpriv->tx_pkts)
+				tx_chk =3D _FAIL;
+
+#if defined(CONFIG_ACTIVE_KEEP_ALIVE_CHECK) && !defined(CONFIG_LPS_LCLK_WD=
_TIMER)
+			if (pmlmeext->active_keep_alive_check && (rx_chk =3D=3D _FAIL || tx_chk=
 =3D=3D _FAIL)
+				#ifdef CONFIG_MCC_MODE
+				/* Driver don't know operation channel under MCC*/
+				/* So driver don't  do KEEP_ALIVE_CHECK */
+				&& (!rtw_hal_check_mcc_status(padapter, MCC_STATUS_NEED_MCC))
+				#endif
+			) {
+				u8 backup_ch =3D 0, backup_bw, backup_offset;
+				u8 union_ch =3D 0, union_bw, union_offset;
+
+				if (!rtw_mi_get_ch_setting_union(padapter, &union_ch, &union_bw, &unio=
n_offset)
+					|| pmlmeext->cur_channel !=3D union_ch)
+						goto bypass_active_keep_alive;
+
+				/* switch to correct channel of current network  before issue keep-ali=
ve frames */
+				if (rtw_get_oper_ch(padapter) !=3D pmlmeext->cur_channel) {
+					backup_ch =3D rtw_get_oper_ch(padapter);
+					backup_bw =3D rtw_get_oper_bw(padapter);
+					backup_offset =3D rtw_get_oper_choffset(padapter);
+					set_channel_bwmode(padapter, union_ch, union_offset, union_bw);
+				}
+
+				if (rx_chk !=3D _SUCCESS)
+					issue_probereq_ex(padapter, &pmlmeinfo->network.Ssid, psta->hwaddr, 0=
, 0, 3, 1);
+
+				if ((tx_chk !=3D _SUCCESS && pmlmeinfo->link_count++ =3D=3D link_count=
_limit) || rx_chk !=3D _SUCCESS) {
+					tx_chk =3D issue_nulldata(padapter, psta->hwaddr, 0, 3, 1);
+					/* if tx acked and p2p disabled, set rx_chk _SUCCESS to reset retry c=
ount */
+					if (tx_chk =3D=3D _SUCCESS && !is_p2p_enable)
+						rx_chk =3D _SUCCESS;
+				}
+
+				/* back to the original operation channel */
+				if (backup_ch > 0)
+					set_channel_bwmode(padapter, backup_ch, backup_offset, backup_bw);
+
+bypass_active_keep_alive:
+				;
+			} else
+#endif /* CONFIG_ACTIVE_KEEP_ALIVE_CHECK */
+			{
+				if (rx_chk !=3D _SUCCESS) {
+					if (pmlmeext->retry =3D=3D 0) {
+#ifdef DBG_EXPIRATION_CHK
+						RTW_INFO("issue_probereq to trigger probersp, retry=3D%d\n", pmlmeex=
t->retry);
+#endif
+						issue_probereq_ex(padapter, &pmlmeinfo->network.Ssid, pmlmeinfo->net=
work.MacAddress, 0, 0, 0, 0);
+						issue_probereq_ex(padapter, &pmlmeinfo->network.Ssid, pmlmeinfo->net=
work.MacAddress, 0, 0, 0, 0);
+						issue_probereq_ex(padapter, &pmlmeinfo->network.Ssid, pmlmeinfo->net=
work.MacAddress, 0, 0, 0, 0);
+					}
+				}
+
+				if (tx_chk !=3D _SUCCESS && pmlmeinfo->link_count++ =3D=3D link_count_=
limit
+#ifdef CONFIG_MCC_MODE
+				    /* FW tx nulldata under MCC mode, we just check  ap is alive */
+				    && (!rtw_hal_check_mcc_status(padapter, MCC_STATUS_NEED_MCC))
+#endif /* CONFIG_MCC_MODE */
+				   ) {
