+/**
+ * rtw_chset_update_non_ocp - update non_ocp_end_time according to the giv=
en @ch, @bw, @offset into @ch_set
+ * @ch_set: the given channel set
+ * @ch: channel number on which radar is detected
+ * @bw: bandwidth on which radar is detected
+ * @offset: bandwidth offset on which radar is detected
+ * @ms: ms to add from now to update non_ocp_end_time, ms < 0 means use NO=
N_OCP_TIME_MS
+ */
+static void _rtw_chset_update_non_ocp(RT_CHANNEL_INFO *ch_set, u8 ch, u8 b=
w, u8 offset, int ms)
+{
+	u32 hi =3D 0, lo =3D 0;
+	int i;
+
+	if (rtw_chbw_to_freq_range(ch, bw, offset, &hi, &lo) =3D=3D false)
+		goto exit;
+
+	for (i =3D 0; ch_set[i].ChannelNum !=3D 0; i++) {
+		if (!rtw_ch2freq(ch_set[i].ChannelNum)) {
+			rtw_warn_on(1);
+			continue;
+		}
+
+		if (lo <=3D rtw_ch2freq(ch_set[i].ChannelNum)
+			&& rtw_ch2freq(ch_set[i].ChannelNum) <=3D hi
+		) {
+			if (ms >=3D 0)
+				ch_set[i].non_ocp_end_time =3D jiffies + rtw_ms_to_systime(ms);
+			else
+				ch_set[i].non_ocp_end_time =3D jiffies + rtw_ms_to_systime(NON_OCP_TIM=
E_MS);
+		}
+	}
+
+exit:
+	return;
+}
