+/*H2C_RSSI_REPORT*/
+static s8 phydm_rssi_report(struct PHY_DM_STRUCT *p_dm_odm, u8 mac_id)
+{
+	struct _ADAPTER *adapter =3D p_dm_odm->adapter;
+	struct _rate_adaptive_table_			*p_ra_table =3D &p_dm_odm->dm_ra_table;
+	struct dvobj_priv *pdvobjpriv =3D adapter_to_dvobj(adapter);
+	HAL_DATA_TYPE *p_hal_data =3D GET_HAL_DATA(adapter);
+	u8 h2c_parameter[H2C_0X42_LENGTH] =3D {0};
+	u8 UL_DL_STATE =3D 0, STBC_TX =3D 0, tx_bf_en =3D 0;
+	u8 cmdlen =3D H2C_0X42_LENGTH, first_connect =3D false;
+	u64	cur_tx_ok_cnt =3D 0, cur_rx_ok_cnt =3D 0;
+	struct sta_info *p_entry =3D p_dm_odm->p_odm_sta_info[mac_id];
+
+	if (!IS_STA_VALID(p_entry))
+		return _FAIL;
+
+	if (mac_id !=3D p_entry->mac_id) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_RATE_ADAPTIVE, ODM_DBG_LOUD, ("%s mac_id=
:%u:%u invalid\n", __func__, mac_id, p_entry->mac_id));
+		rtw_warn_on(1);
+		return _FAIL;
+	}
+
+	if (IS_MCAST(p_entry->hwaddr))  /*if(psta->mac_id =3D=3D1)*/
+		return _FAIL;
+
+	if (p_entry->rssi_stat.undecorated_smoothed_pwdb =3D=3D (-1)) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_RATE_ADAPTIVE, ODM_DBG_LOUD, ("%s mac_id=
:%u, mac:"MAC_FMT", rssi =3D=3D -1\n", __func__, p_entry->mac_id, MAC_ARG(p=
_entry->hwaddr)));
+		return _FAIL;
+	}
+
+	cur_tx_ok_cnt =3D pdvobjpriv->traffic_stat.cur_tx_bytes;
+	cur_rx_ok_cnt =3D pdvobjpriv->traffic_stat.cur_rx_bytes;
+	if (cur_rx_ok_cnt > (cur_tx_ok_cnt * 6))
+		UL_DL_STATE =3D 1;
+	else
+		UL_DL_STATE =3D 0;
+
+#ifdef CONFIG_BEAMFORMING
+	{
+#if (BEAMFORMING_SUPPORT =3D=3D 1)
+		enum beamforming_cap beamform_cap =3D phydm_beamforming_get_entry_beam_c=
ap_by_mac_id(p_dm_odm, p_entry->mac_id);
+#else/*for drv beamforming*/
+		enum beamforming_cap beamform_cap =3D beamforming_get_entry_beam_cap_by_=
mac_id(&adapter->mlmepriv, p_entry->mac_id);
+#endif
+
+		if (beamform_cap & (BEAMFORMER_CAP_HT_EXPLICIT | BEAMFORMER_CAP_VHT_SU))
+			tx_bf_en =3D 1;
+		else
+			tx_bf_en =3D 0;
+	}
+#endif /*#ifdef CONFIG_BEAMFORMING*/
+
+	if (tx_bf_en)
+		STBC_TX =3D 0;
+	else
+		STBC_TX =3D TEST_FLAG(p_entry->htpriv.stbc_cap, STBC_HT_ENABLE_TX);
+
+	h2c_parameter[0] =3D (u8)(p_entry->mac_id & 0xFF);
+	h2c_parameter[2] =3D p_entry->rssi_stat.undecorated_smoothed_pwdb & 0x7F;
+
+	if (UL_DL_STATE)
+		h2c_parameter[3] |=3D RAINFO_BE_RX_STATE;
+
+	if (tx_bf_en)
+		h2c_parameter[3] |=3D RAINFO_BF_STATE;
+	if (STBC_TX)
+		h2c_parameter[3] |=3D RAINFO_STBC_STATE;
+	if (p_dm_odm->noisy_decision)
+		h2c_parameter[3] |=3D RAINFO_NOISY_STATE;
+
+	if ((p_entry->ra_rpt_linked =3D=3D false) && (p_entry->rssi_stat.is_send_=
rssi =3D=3D RA_RSSI_STATE_SEND)) {
+		h2c_parameter[3] |=3D RAINFO_INIT_RSSI_RATE_STATE;
+		p_entry->ra_rpt_linked =3D true;
+		p_entry->rssi_stat.is_send_rssi =3D RA_RSSI_STATE_HOLD;
+		first_connect =3D true;
+	}
+
+	h2c_parameter[4] =3D (p_ra_table->RA_threshold_offset & 0x7f) | (p_ra_tab=
le->RA_offset_direction << 7);
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, ("RA_threshold_off=
set =3D (( %s%d ))\n", ((p_ra_table->RA_threshold_offset =3D=3D 0) ? " " : =
((p_ra_table->RA_offset_direction) ? "+" : "-")), p_ra_table->RA_threshold_=
offset));
+
+	if (first_connect) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_RATE_ADAPTIVE, ODM_DBG_LOUD, ("%s mac_id=
:%u, mac:"MAC_FMT", rssi:%d\n", __func__,
+			p_entry->mac_id, MAC_ARG(p_entry->hwaddr), p_entry->rssi_stat.undecorat=
ed_smoothed_pwdb));
+
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_RATE_ADAPTIVE, ODM_DBG_LOUD, ("%s RAINFO=
 - TP:%s, TxBF:%s, STBC:%s, Noisy:%s, Firstcont:%s\n", __func__,
+			(UL_DL_STATE) ? "DL" : "UL", (tx_bf_en) ? "EN" : "DIS", (STBC_TX) ? "EN=
" : "DIS",
+			(p_dm_odm->noisy_decision) ? "True" : "False", (first_connect) ? "True"=
 : "False"));
+	}
+
+	if (p_hal_data->fw_ractrl =3D=3D true) {
+		if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8188E)
+			cmdlen =3D 3;
+		odm_fill_h2c_cmd(p_dm_odm, ODM_H2C_RSSI_REPORT, cmdlen, h2c_parameter);
+	} else {
+#if ((RATE_ADAPTIVE_SUPPORT =3D=3D 1))
+		if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8188E)
+			odm_ra_set_rssi_8188e(p_dm_odm, (u8)(p_entry->mac_id & 0xFF), p_entry->=
rssi_stat.undecorated_smoothed_pwdb & 0x7F);
+#endif
+	}
+	return _SUCCESS;
+}
