+u8 rtw_do_join(_adapter *padapter)
+{
+	unsigned long	irqL;
+	_list	*plist, *phead;
+	u8 *pibss =3D NULL;
+	struct	mlme_priv	*pmlmepriv =3D &(padapter->mlmepriv);
+	_queue	*queue	=3D &(pmlmepriv->scanned_queue);
+	u8 ret =3D _SUCCESS;
+
+	_enter_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+	phead =3D get_list_head(queue);
+	plist =3D get_next(phead);
+
+	pmlmepriv->cur_network.join_res =3D -2;
+
+	set_fwstate(pmlmepriv, _FW_UNDER_LINKING);
+
+	pmlmepriv->pscanned =3D plist;
+
+	pmlmepriv->to_join =3D true;
+
+	if (_rtw_queue_empty(queue) ) {
+		_exit_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+		_clr_fwstate_(pmlmepriv, _FW_UNDER_LINKING);
+
+		/* when set_ssid/set_bssid for rtw_do_join(), but scanning queue is empt=
y */
+		/* we try to issue sitesurvey firstly	 */
+
+		if (pmlmepriv->LinkDetectInfo.bBusyTraffic =3D=3D false
+		    || rtw_to_roam(padapter) > 0
+		   ) {
+			/* submit site_survey_cmd */
+			ret =3D rtw_sitesurvey_cmd(padapter, &pmlmepriv->assoc_ssid, 1, NULL, 0=
);
+			if (_SUCCESS !=3D ret) {
+				pmlmepriv->to_join =3D false;
+			}
+		} else {
+			pmlmepriv->to_join =3D false;
+			ret =3D _FAIL;
+		}
+
+		goto exit;
+	} else {
+		int select_ret;
+		_exit_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+		select_ret =3D rtw_select_and_join_from_scanned_queue(pmlmepriv);
+		if (select_ret =3D=3D _SUCCESS) {
+			pmlmepriv->to_join =3D false;
+			_set_timer(&pmlmepriv->assoc_timer, MAX_JOIN_TIMEOUT);
+		} else {
+			if (check_fwstate(pmlmepriv, WIFI_ADHOC_STATE) ) {
+				/* submit createbss_cmd to change to a ADHOC_MASTER */
+
+				/* pmlmepriv->lock has been acquired by caller... */
+				WLAN_BSSID_EX    *pdev_network =3D &(padapter->registrypriv.dev_networ=
k);
+
+				/*pmlmepriv->fw_state =3D WIFI_ADHOC_MASTER_STATE;*/
+				init_fwstate(pmlmepriv, WIFI_ADHOC_MASTER_STATE);
+
+				pibss =3D padapter->registrypriv.dev_network.MacAddress;
+
+				memset(&pdev_network->Ssid, 0, sizeof(NDIS_802_11_SSID));
+				memcpy(&pdev_network->Ssid, &pmlmepriv->assoc_ssid, sizeof(NDIS_802_11=
_SSID));
+
+				rtw_update_registrypriv_dev_network(padapter);
+
+				rtw_generate_random_ibss(pibss);
+
+				if (rtw_create_ibss_cmd(padapter, 0) !=3D _SUCCESS) {
+					ret =3D  false;
+					goto exit;
+				}
+
+				pmlmepriv->to_join =3D false;
+
+			} else {
+				/* can't associate ; reset under-linking			 */
+				_clr_fwstate_(pmlmepriv, _FW_UNDER_LINKING);
+
+				/* when set_ssid/set_bssid for rtw_do_join(), but there are no desired=
 bss in scanning queue */
+				/* we try to issue sitesurvey firstly			 */
+				if (pmlmepriv->LinkDetectInfo.bBusyTraffic =3D=3D false
+				    || rtw_to_roam(padapter) > 0
+				   ) {
+					/* RTW_INFO("rtw_do_join() when   no desired bss in scanning queue\n"=
); */
+					ret =3D rtw_sitesurvey_cmd(padapter, &pmlmepriv->assoc_ssid, 1, NULL,=
 0);
+					if (_SUCCESS !=3D ret) {
+						pmlmepriv->to_join =3D false;
+					}
+				} else {
+					ret =3D _FAIL;
+					pmlmepriv->to_join =3D false;
+				}
+			}
+
+		}
+
+	}
+
+exit:
+
+	return ret;
+}
