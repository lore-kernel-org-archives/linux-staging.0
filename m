+void wps_free_pending_msgs(struct upnp_pending_message *msgs)
+{
+	struct upnp_pending_message *p, *prev;
+	p =3D msgs;
+	while (p) {
+		prev =3D p;
+		p =3D p->next;
+		wpabuf_free(prev->msg);
+		os_free(prev);
+	}
