+bool rtw_xmit_ac_blocked(_adapter *adapter)
+{
+	struct dvobj_priv *dvobj =3D adapter_to_dvobj(adapter);
+	_adapter *iface;
+	struct mlme_ext_priv *mlmeext;
+	struct mlme_ext_info *mlmeextinfo;
+	bool blocked =3D false;
+	int i;
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+		iface =3D dvobj->padapters[i];
+		mlmeext =3D &iface->mlmeextpriv;
+
+		/* check scan state */
+		if (mlmeext_scan_state(mlmeext) !=3D SCAN_DISABLE
+			&& mlmeext_scan_state(mlmeext) !=3D SCAN_BACK_OP
+		) {
+			blocked =3D true;
+			goto exit;
+		}
+
+		if (mlmeext_scan_state(mlmeext) =3D=3D SCAN_BACK_OP
+			&& !mlmeext_chk_scan_backop_flags(mlmeext, SS_BACKOP_TX_RESUME)
+		) {
+			blocked =3D true;
+			goto exit;
+		}
+	}
+
+#ifdef CONFIG_MCC_MODE
+	if (MCC_EN(adapter)) {
+		if (rtw_hal_check_mcc_status(adapter, MCC_STATUS_DOING_MCC)) {
+			if (MCC_STOP(adapter)) {
+				blocked =3D true;
+				goto exit;
+			}
+		}
+	}
+#endif /*  CONFIG_MCC_MODE */
+
+exit:
+	return blocked;
+}
