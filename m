+int sha1_vector(size_t num_elem, const u8 *addr[], const size_t *len, u8 *=
mac)
+{
+	SHA1_CTX ctx;
+	size_t i;
+
+	SHA1Init(&ctx);
+	for (i =3D 0; i < num_elem; i++)
+		SHA1Update(&ctx, addr[i], len[i]);
