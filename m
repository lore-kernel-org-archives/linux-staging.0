+#ifdef CONFIG_P2P_MANAGER
+u8 * hostapd_eid_p2p_manage(struct hostapd_data *hapd, u8 *eid)
+{
+	u8 bitmap;
+	*eid++ =3D WLAN_EID_VENDOR_SPECIFIC;
+	*eid++ =3D 4 + 3 + 1;
+	WPA_PUT_BE24(eid, OUI_WFA);
+	eid +=3D 3;
+	*eid++ =3D P2P_OUI_TYPE;
+
+	*eid++ =3D P2P_ATTR_MANAGEABILITY;
+	WPA_PUT_LE16(eid, 1);
+	eid +=3D 2;
+	bitmap =3D P2P_MAN_DEVICE_MANAGEMENT;
+	if (hapd->conf->p2p & P2P_ALLOW_CROSS_CONNECTION)
+		bitmap |=3D P2P_MAN_CROSS_CONNECTION_PERMITTED;
+	bitmap |=3D P2P_MAN_COEXISTENCE_OPTIONAL;
+	*eid++ =3D bitmap;
+
+	return eid;
+}
+#endif /* CONFIG_P2P_MANAGER */
