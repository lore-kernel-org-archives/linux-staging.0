+ssize_t proc_set_survey_info(struct file *file, const char __user *buffer,=
 size_t count, loff_t *pos, void *data)
+{
+	unsigned long irqL;
+	struct net_device *dev =3D data;
+	_adapter *padapter =3D (_adapter *)rtw_netdev_priv(dev);
+	struct mlme_priv	*pmlmepriv =3D &(padapter->mlmepriv);
+	bool need_indicate_scan_done =3D false;
+	u8 _status =3D false;
+	NDIS_802_11_SSID ssid[RTW_SSID_SCAN_AMOUNT];
+
+	if (count < 1)
+		return -EFAULT;
