+static void radius_client_update_acct_msgs(struct radius_client_data *radi=
us,
+					   const u8 *shared_secret,
+					   size_t shared_secret_len)
+{
+	struct radius_msg_list *entry;
+
+	if (!radius)
+		return;
+
+	for (entry =3D radius->msgs; entry; entry =3D entry->next) {
+		if (entry->msg_type =3D=3D RADIUS_ACCT) {
+			entry->shared_secret =3D shared_secret;
+			entry->shared_secret_len =3D shared_secret_len;
+			radius_msg_finish_acct(entry->msg, shared_secret,
+					       shared_secret_len);
+		}
+	}
+}
