+	_pkt *pskb;
+
+#ifdef CONFIG_USE_USB_BUFFER_ALLOC_RX
+	pskb =3D NULL;
+	transfer_len =3D (s32)((struct recv_buf *)ptr)->transfer_len;
+	pbuf =3D ((struct recv_buf *)ptr)->pbuf;
+#else
+	pskb =3D (_pkt *)ptr;
+	transfer_len =3D (s32)pskb->len;
+	pbuf =3D pskb->data;
+#endif
+	prxstat =3D (struct recv_stat *)pbuf;
+	pkt_cnt =3D (le32_to_cpu(prxstat->rxdw2) >> 16) & 0xff;
+
+	do {
+		prxstat =3D (struct recv_stat *)pbuf;
+
+		precvframe =3D rtw_alloc_recvframe(pfree_recv_queue);
+		if (precvframe =3D=3D NULL) {
+			RTW_INFO("%s()-%d: rtw_alloc_recvframe() failed! RX Drop!\n", __func__,=
 __LINE__);
+			goto _exit_recvbuf2recvframe;
+		}
+
+		INIT_LIST_HEAD(&precvframe->u.hdr.list);
+		precvframe->u.hdr.precvbuf =3D NULL;	/* can't access the precvbuf for ne=
w arch. */
+		precvframe->u.hdr.len =3D 0;
+
+		rtl8188e_query_rx_desc_status(precvframe, prxstat);
+
+		pattrib =3D &precvframe->u.hdr.attrib;
+
+		if ((padapter->registrypriv.mp_mode =3D=3D 0) && ((pattrib->crc_err) || =
(pattrib->icv_err))) {
+			RTW_INFO("%s: RX Warning! crc_err=3D%d icv_err=3D%d, skip!\n", __func__=
, pattrib->crc_err, pattrib->icv_err);
+			rtw_free_recvframe(precvframe, pfree_recv_queue);
+			goto _exit_recvbuf2recvframe;
+		}
+
+
+		pkt_offset =3D RXDESC_SIZE + pattrib->drvinfo_sz +
+			     pattrib->shift_sz + le16_to_cpu(pattrib->pkt_len);
+
+		if ((le16_to_cpu(pattrib->pkt_len) <=3D 0) || (pkt_offset > transfer_len=
)) {
+			RTW_INFO("%s()-%d: RX Warning!,pkt_len<=3D0 or pkt_offset> transfoer_le=
n\n", __func__, __LINE__);
+			rtw_free_recvframe(precvframe, pfree_recv_queue);
+			goto _exit_recvbuf2recvframe;
+		}
+
+#ifdef CONFIG_RX_PACKET_APPEND_FCS
+		if (check_fwstate(&padapter->mlmepriv, WIFI_MONITOR_STATE) =3D=3D false)
+			if ((pattrib->pkt_rpt_type =3D=3D NORMAL_RX) && (pHalData->ReceiveConfi=
g & RCR_APPFCS))
+				pattrib->pkt_len -=3D IEEE80211_FCS_LEN;
+#endif
+
+		if (rtw_os_alloc_recvframe(padapter, precvframe,
+			(pbuf + pattrib->shift_sz + pattrib->drvinfo_sz + RXDESC_SIZE), pskb) =
=3D=3D _FAIL) {
+			rtw_free_recvframe(precvframe, pfree_recv_queue);
+
+			goto _exit_recvbuf2recvframe;
+		}
+
+		recvframe_put(precvframe, pattrib->pkt_len);
+		/* recvframe_pull(precvframe, drvinfo_sz + RXDESC_SIZE);	 */
+
+		if (pattrib->pkt_rpt_type =3D=3D NORMAL_RX) { /* Normal rx packet */
+			if (pattrib->physt)
+				pphy_status =3D pbuf + RXDESC_OFFSET;
+
+#ifdef CONFIG_CONCURRENT_MODE
+			pre_recv_entry(precvframe, pphy_status);
+#endif /*CONFIG_CONCURRENT_MODE*/
+
+
+			if (pattrib->physt && pphy_status)
+				rx_query_phy_status(precvframe, pphy_status);
+
+			rtw_recv_entry(precvframe);
+
+		} else { /* pkt_rpt_type =3D=3D TX_REPORT1-CCX, TX_REPORT2-TX RTP,HIS_RE=
PORT-USB HISR RTP */
+
+			/* enqueue recvframe to txrtp queue */
+			if (pattrib->pkt_rpt_type =3D=3D TX_REPORT1) {
+				/* RTW_INFO("rx CCX\n"); */
+				/* CCX-TXRPT ack for xmit mgmt frames. */
+				handle_txrpt_ccx_88e(padapter, precvframe->u.hdr.rx_data);
+			} else if (pattrib->pkt_rpt_type =3D=3D TX_REPORT2) {
+				/* RTW_INFO("recv TX RPT\n"); */
+				odm_ra_tx_rpt2_handle_8188e(
+					&pHalData->odmpriv,
+					precvframe->u.hdr.rx_data,
+					pattrib->pkt_len,
+					le32_to_cpu(pattrib->MacIDValidEntry[0]),
+					le32_to_cpu(pattrib->MacIDValidEntry[1]));
+			} else if (pattrib->pkt_rpt_type =3D=3D HIS_REPORT) {
+				/* RTW_INFO("%s , rx USB HISR\n",__func__); */
+#ifdef CONFIG_SUPPORT_USB_INT
+				interrupt_handler_8188eu(padapter, le16_to_cpu(pattrib->pkt_len), prec=
vframe->u.hdr.rx_data);
+#endif
+			}
+			rtw_free_recvframe(precvframe, pfree_recv_queue);
+
+		}
+
+#ifdef CONFIG_USB_RX_AGGREGATION
+		switch (pHalData->rxagg_mode) {
+		case RX_AGG_DMA:
+		case RX_AGG_MIX:
+			pkt_offset =3D (u16)_RND128(pkt_offset);
+			break;
+		case RX_AGG_USB:
+			pkt_offset =3D (u16)_RND4(pkt_offset);
+			break;
+		case RX_AGG_DISABLE:
+		default:
+			break;
+		}
+#endif
+		pkt_cnt--;
+		transfer_len -=3D pkt_offset;
+		pbuf +=3D pkt_offset;
+		precvframe =3D NULL;
+
+		if (transfer_len > 0 && pkt_cnt =3D=3D 0)
+			pkt_cnt =3D (le32_to_cpu(prxstat->rxdw2) >> 16) & 0xff;
+
+	} while ((transfer_len > 0) && (pkt_cnt > 0));
+
+_exit_recvbuf2recvframe:
+
+	return _SUCCESS;
+}
+
+
+
+void rtl8188eu_xmit_tasklet(void *priv)
+{
+	int ret =3D false;
+	_adapter *padapter =3D (_adapter *)priv;
+	struct xmit_priv *pxmitpriv =3D &padapter->xmitpriv;
+
+	while (1) {
+		if (RTW_CANNOT_TX(padapter)) {
+			RTW_INFO("xmit_tasklet =3D> bDriverStopped or bSurpriseRemoved or bWrit=
ePortCancel\n");
+			break;
+		}
+
+		if (rtw_xmit_ac_blocked(padapter) =3D=3D true)
+			break;
+
+		ret =3D rtl8188eu_xmitframe_complete(padapter, pxmitpriv, NULL);
+
+		if (ret =3D=3D false)
+			break;
+	}
+
+}
+
+void rtl8188eu_set_hw_type(struct dvobj_priv *pdvobj)
+{
+	pdvobj->HardwareType =3D HARDWARE_TYPE_RTL8188EU;
+	RTW_INFO("CHIP TYPE: RTL8188E\n");
+}
