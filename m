+/**
+ * upnp_wps_device_send_wlan_event - Event notification
+ * @sm: WPS UPnP state machine from upnp_wps_device_init()
+ * @from_mac_addr: Source (Enrollee) MAC address for the event
+ * @ev_type: Event type
+ * @msg: Event data
+ * Returns: 0 on success, -1 on failure
+ *
+ * Tell external Registrars (UPnP control points) that something happened.=
 In
+ * particular, events include WPS messages from clients that are proxied to
+ * external Registrars.
+ */
+int upnp_wps_device_send_wlan_event(struct upnp_wps_device_sm *sm,
+				    const u8 from_mac_addr[ETH_ALEN],
+				    enum upnp_wps_wlanevent_type ev_type,
+				    const struct wpabuf *msg)
+{
+	int ret =3D -1;
+	char type[2];
+	const u8 *mac =3D from_mac_addr;
+	char mac_text[18];
+	u8 *raw =3D NULL;
+	size_t raw_len;
+	char *val;
+	size_t val_len;
+	int pos =3D 0;
+
+	if (!sm)
+		goto fail;
+
+	os_snprintf(type, sizeof(type), "%1u", ev_type);
+
+	raw_len =3D 1 + 17 + (msg ? wpabuf_len(msg) : 0);
+	raw =3D os_zalloc(raw_len);
+	if (!raw)
+		goto fail;
+
+	*(raw + pos) =3D (u8) ev_type;
+	pos +=3D 1;
+	os_snprintf(mac_text, sizeof(mac_text), MACSTR, MAC2STR(mac));
+	wpa_printf(MSG_DEBUG, "WPS UPnP: Proxying WLANEvent from %s",
+		   mac_text);
+	os_memcpy(raw + pos, mac_text, 17);
+	pos +=3D 17;
+	if (msg) {
+		os_memcpy(raw + pos, wpabuf_head(msg), wpabuf_len(msg));
+		pos +=3D wpabuf_len(msg);
+	}
+	raw_len =3D pos;
+
+	val =3D (char *) base64_encode(raw, raw_len, &val_len);
+	if (val =3D=3D NULL)
+		goto fail;
+
+	os_free(sm->wlanevent);
+	sm->wlanevent =3D val;
+	sm->wlanevent_type =3D ev_type;
+	upnp_wps_device_send_event(sm);
+
+	ret =3D 0;
+
+fail:
+	os_free(raw);
+
+	return ret;
+}
