+
+static void * init_nfc(struct wps_context *wps,
+		       struct oob_device_data *oob_dev, int registrar)
+{
+	struct oob_nfc_device_data *oob_nfc_dev;
+	struct wps_nfc_data *data;
+
+	oob_nfc_dev =3D wps_get_oob_nfc_device(oob_dev->device_name);
+	if (oob_nfc_dev =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "WPS (NFC): Unknown NFC device (%s)",
+			   oob_dev->device_name);
+		return NULL;
+	}
+
+	if (oob_nfc_dev->init_func(oob_dev->device_path) < 0)
+		return NULL;
+
+	data =3D os_zalloc(sizeof(*data));
+	if (data =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "WPS (NFC): Failed to allocate "
+			   "nfc data area");
+		return NULL;
+	}
+	data->oob_nfc_dev =3D oob_nfc_dev;
+	return data;
+}
+
+
+static struct wpabuf * read_nfc(void *priv)
+{
+	struct wps_nfc_data *data =3D priv;
+	struct wpabuf *wifi, *buf;
+	char *raw_data;
+	size_t len;
+
+	raw_data =3D data->oob_nfc_dev->read_func(&len);
+	if (raw_data =3D=3D NULL)
+		return NULL;
+
+	wifi =3D wpabuf_alloc_copy(raw_data, len);
+	os_free(raw_data);
+	if (wifi =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "WPS (NFC): Failed to allocate "
+			   "nfc read area");
+		return NULL;
+	}
+
+	buf =3D ndef_parse_wifi(wifi);
+	wpabuf_free(wifi);
+	if (buf =3D=3D NULL)
+		wpa_printf(MSG_ERROR, "WPS (NFC): Failed to unwrap");
+	return buf;
+}
+
+
+static int write_nfc(void *priv, struct wpabuf *buf)
+{
+	struct wps_nfc_data *data =3D priv;
+	struct wpabuf *wifi;
+	int ret;
+
+	wifi =3D ndef_build_wifi(buf);
+	if (wifi =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "WPS (NFC): Failed to wrap");
+		return -1;
+	}
+
+	ret =3D data->oob_nfc_dev->write_func(wpabuf_mhead(wifi),
+					    wpabuf_len(wifi));
+	wpabuf_free(wifi);
+	return ret;
+}
+
+
+static void deinit_nfc(void *priv)
+{
+	struct wps_nfc_data *data =3D priv;
+
+	data->oob_nfc_dev->deinit_func();
+
+	os_free(data);
+}
+
+
+struct oob_device_data oob_nfc_device_data =3D {
+	.device_name	=3D NULL,
+	.device_path	=3D NULL,
+	.init_func	=3D init_nfc,
+	.read_func	=3D read_nfc,
+	.write_func	=3D write_nfc,
+	.deinit_func	=3D deinit_nfc,
+};
