+	struct scan_info *info;
+#define MAX_REPORT_FREQS 50
+	int freqs[MAX_REPORT_FREQS];
+	int num_freqs =3D 0;
+
+	os_memset(&event, 0, sizeof(event));
+	info =3D &event.scan_info;
+	info->aborted =3D aborted;
+
+	if (tb[NL80211_ATTR_SCAN_SSIDS]) {
+		nla_for_each_nested(nl, tb[NL80211_ATTR_SCAN_SSIDS], rem) {
+			struct wpa_driver_scan_ssid *s =3D
+				&info->ssids[info->num_ssids];
+			s->ssid =3D nla_data(nl);
+			s->ssid_len =3D nla_len(nl);
+			info->num_ssids++;
+			if (info->num_ssids =3D=3D WPAS_MAX_SCAN_SSIDS)
+				break;
+		}
+	}
+	if (tb[NL80211_ATTR_SCAN_FREQUENCIES]) {
+		nla_for_each_nested(nl, tb[NL80211_ATTR_SCAN_FREQUENCIES], rem)
+		{
+			freqs[num_freqs] =3D nla_get_u32(nl);
+			num_freqs++;
+			if (num_freqs =3D=3D MAX_REPORT_FREQS - 1)
+				break;
+		}
+		info->freqs =3D freqs;
+		info->num_freqs =3D num_freqs;
+	}
+	wpa_supplicant_event(drv->ctx, EVENT_SCAN_RESULTS, &event);
+}
