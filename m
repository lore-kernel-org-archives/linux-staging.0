+thread_return lbk_thread(thread_context context)
+{
+	s32 err;
+	PADAPTER padapter;
+	PLOOPBACKDATA ploopback;
+	struct xmit_frame *pxmitframe;
+	u32 cnt, ok, fail, headerlen;
+	u32 pktsize;
+	u32 ff_hwaddr;
+
+
+	padapter =3D (PADAPTER)context;
+	ploopback =3D padapter->ploopback;
+	if (ploopback =3D=3D NULL)
+		return -1;
+	cnt =3D 0;
+	ok =3D 0;
+	fail =3D 0;
+
+	daemonize("%s", "RTW_LBK_THREAD");
+	allow_signal(SIGTERM);
+
+	do {
+		if (ploopback->size =3D=3D 0) {
+			get_random_bytes(&pktsize, 4);
+			pktsize =3D (pktsize % 1535) + 1; /* 1~1535 */
+		} else
+			pktsize =3D ploopback->size;
+
+		pxmitframe =3D createloopbackpkt(padapter, pktsize);
+		if (pxmitframe =3D=3D NULL) {
+			sprintf(ploopback->msg, "loopback FAIL! 3. create Packet FAIL!");
+			break;
+		}
+
+		ploopback->txsize =3D TXDESC_SIZE + pxmitframe->attrib.last_txcmdsz;
+		memcpy(ploopback->txbuf, pxmitframe->buf_addr, ploopback->txsize);
+		ff_hwaddr =3D rtw_get_ff_hwaddr(pxmitframe);
+		cnt++;
+		RTW_INFO("%s: wirte port cnt=3D%d size=3D%d\n", __func__, cnt, ploopback=
->txsize);
+		pxmitframe->pxmitbuf->pdata =3D ploopback->txbuf;
+		rtw_write_port(padapter, ff_hwaddr, ploopback->txsize, (u8 *)pxmitframe-=
>pxmitbuf);
+
+		/* wait for rx pkt */
+		_rtw_down_sema(&ploopback->sema);
+
+		err =3D pktcmp(padapter, ploopback->txbuf, ploopback->txsize, ploopback-=
>rxbuf, ploopback->rxsize);
+		if (err )
+			ok++;
+		else
+			fail++;
+
+		ploopback->txsize =3D 0;
+		memset(ploopback->txbuf, 0, 0x8000);
+		ploopback->rxsize =3D 0;
+		memset(ploopback->rxbuf, 0, 0x8000);
+
+		freeloopbackpkt(padapter, pxmitframe);
+		pxmitframe =3D NULL;
+
+		if (signal_pending(current))
+			flush_signals(current);
+
+		if ((ploopback->bstop ) ||
+		    ((ploopback->cnt !=3D 0) && (ploopback->cnt =3D=3D cnt))) {
+			u32 ok_rate, fail_rate, all;
+			all =3D cnt;
+			ok_rate =3D (ok * 100) / all;
+			fail_rate =3D (fail * 100) / all;
+			sprintf(ploopback->msg, \
+				"loopback result: ok=3D%d%%(%d/%d),error=3D%d%%(%d/%d)", \
+				ok_rate, ok, all, fail_rate, fail, all);
+			break;
+		}
+	} while (1);
+
+	ploopback->bstop =3D true;
+
+	thread_exit();
+}
+
+static void loopbackTest(PADAPTER padapter, u32 cnt, u32 size, u8 *pmsg)
+{
+	PLOOPBACKDATA ploopback;
+	u32 len;
+	s32 err;
+
+
+	ploopback =3D padapter->ploopback;
+
+	if (ploopback) {
+		if (ploopback->bstop =3D=3D false) {
+			ploopback->bstop =3D true;
+			up(&ploopback->sema);
+		}
+		len =3D 0;
+		do {
+			len =3D strlen(ploopback->msg);
+			if (len)
+				break;
+			rtw_msleep_os(1);
+		} while (1);
+		memcpy(pmsg, ploopback->msg, len + 1);
+		freeLoopback(padapter);
+
+		return;
+	}
+
+	/* disable dynamic algorithm	 */
+	rtw_phydm_ability_backup(padapter);
+	rtw_phydm_func_disable_all(padapter);
+
+	/* create pseudo ad-hoc connection */
+	err =3D initpseudoadhoc(padapter);
+	if (err =3D=3D _FAIL) {
+		sprintf(pmsg, "loopback FAIL! 1.1 init ad-hoc FAIL!");
+		return;
+	}
+
+	err =3D createpseudoadhoc(padapter);
+	if (err =3D=3D _FAIL) {
+		sprintf(pmsg, "loopback FAIL! 1.2 create ad-hoc master FAIL!");
+		return;
+	}
+
+	err =3D initLoopback(padapter);
+	if (err) {
+		sprintf(pmsg, "loopback FAIL! 2. init FAIL! error code=3D%d", err);
+		return;
+	}
+
+	ploopback =3D padapter->ploopback;
+
+	ploopback->bstop =3D false;
+	ploopback->cnt =3D cnt;
+	ploopback->size =3D size;
+	ploopback->lbkthread =3D kthread_run(lbk_thread, padapter, "RTW_LBK_THREA=
D");
+	if (IS_ERR(padapter->lbkthread)) {
+		freeLoopback(padapter);
+		sprintf(pmsg, "loopback start FAIL! cnt=3D%d", cnt);
+		return;
+	}
+
+	sprintf(pmsg, "loopback start! cnt=3D%d", cnt);
+}
