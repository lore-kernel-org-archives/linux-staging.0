+
+	/*	Device Name */
+	/*	Type: */
+	*(u16 *)(p2pie + p2pielen) =3D cpu_to_be16(WPS_ATTR_DEVICE_NAME);
+	p2pielen +=3D 2;
+
+	/*	Length: */
+	*(u16 *)(p2pie + p2pielen) =3D cpu_to_be16(pwdinfo->device_name_len);
+	p2pielen +=3D 2;
+
+	/*	Value: */
+	memcpy(p2pie + p2pielen, pwdinfo->device_name , pwdinfo->device_name_len);
+	p2pielen +=3D pwdinfo->device_name_len;
+
+	if (rtw_p2p_chk_role(pwdinfo, P2P_ROLE_GO)) {
+		/*	Group ID Attribute */
+		/*	Type: */
+		p2pie[p2pielen++] =3D P2P_ATTR_GROUP_ID;
+
+		/*	Length: */
+		*(u16 *)(p2pie + p2pielen) =3D cpu_to_le16(ETH_ALEN + pwdinfo->nego_ssid=
len);
+		p2pielen +=3D 2;
+
+		/*	Value: */
+		/*	p2P Device Address */
+		memcpy(p2pie + p2pielen , pwdinfo->device_addr, ETH_ALEN);
+		p2pielen +=3D ETH_ALEN;
+
+		/*	SSID */
+		memcpy(p2pie + p2pielen, pwdinfo->nego_ssid, pwdinfo->nego_ssidlen);
+		p2pielen +=3D pwdinfo->nego_ssidlen;
+
+	}
+
+	pframe =3D rtw_set_ie(pframe, _VENDOR_SPECIFIC_IE_, p2pielen, (unsigned c=
har *) p2pie, &pktlen);
+
+#ifdef CONFIG_WFD
+	wfdielen =3D build_nego_resp_wfd_ie(pwdinfo, pframe);
+	pframe +=3D wfdielen;
+	pktlen +=3D wfdielen;
+#endif
+	*pLength =3D pktlen;
+}
