+struct wps_add_pin_data {
+	const u8 *addr;
+	const u8 *uuid;
+	const u8 *pin;
+	size_t pin_len;
+	int timeout;
+	int added;
+};
+
+
+static int wps_add_pin(struct hostapd_data *hapd, void *ctx)
+{
+	struct wps_add_pin_data *data =3D ctx;
+	int ret;
+
+	if (hapd->wps =3D=3D NULL)
+		return 0;
+	ret =3D wps_registrar_add_pin(hapd->wps->registrar, data->addr,
+				    data->uuid, data->pin, data->pin_len,
+				    data->timeout);
+	if (ret =3D=3D 0)
+		data->added++;
+	return ret;
+}
+
+
+int hostapd_wps_add_pin(struct hostapd_data *hapd, const u8 *addr,
+			const char *uuid, const char *pin, int timeout)
+{
+	u8 u[UUID_LEN];
+	struct wps_add_pin_data data;
+
+	data.addr =3D addr;
+	data.uuid =3D u;
+	data.pin =3D (const u8 *) pin;
+	data.pin_len =3D os_strlen(pin);
+	data.timeout =3D timeout;
+	data.added =3D 0;
+
+	if (os_strcmp(uuid, "any") =3D=3D 0)
+		data.uuid =3D NULL;
+	else {
+		if (uuid_str2bin(uuid, u))
+			return -1;
+		data.uuid =3D u;
+	}
+	if (hostapd_wps_for_each(hapd, wps_add_pin, &data) < 0)
+		return -1;
+	return data.added ? 0 : -1;
+}
