+void ieee802_11_print_ssid(char *buf, const u8 *ssid, u8 len)
+{
+	int i;
+	if (len > HOSTAPD_MAX_SSID_LEN)
+		len =3D HOSTAPD_MAX_SSID_LEN;
+	for (i =3D 0; i < len; i++) {
+		if (ssid[i] >=3D 32 && ssid[i] < 127)
+			buf[i] =3D ssid[i];
+		else
+			buf[i] =3D '.';
+	}
+	buf[len] =3D '\0';
+}
