+u8 rtw_btcoex_create_kernel_socket(_adapter *padapter)
+{
+	s8 kernel_socket_err;
+	u8 tx_msg[255] =3D attend_req;
+	struct bt_coex_info *pcoex_info =3D &padapter->coex_info;
+	s32 sock_reuse =3D 1;
+	u8 status =3D _FAIL;
+
+	RTW_INFO("%s CONNECT_PORT %d\n", __func__, CONNECT_PORT);
+
+	if (NULL =3D=3D pcoex_info) {
+		RTW_INFO("coex_info: NULL\n");
+		status =3D  _FAIL;
+	}
+
+	kernel_socket_err =3D sock_create(PF_INET, SOCK_DGRAM, 0, &pcoex_info->ud=
psock);
+
+	if (kernel_socket_err < 0) {
+		RTW_INFO("Error during creation of socket error:%d\n", kernel_socket_err=
);
+		status =3D _FAIL;
+	} else {
+		memset(&(pcoex_info->wifi_sockaddr), 0, sizeof(pcoex_info->wifi_sockaddr=
));
+		pcoex_info->wifi_sockaddr.sin_family =3D AF_INET;
+		pcoex_info->wifi_sockaddr.sin_port =3D htons(CONNECT_PORT);
+		pcoex_info->wifi_sockaddr.sin_addr.s_addr =3D htonl(INADDR_LOOPBACK);
+
+		memset(&(pcoex_info->bt_sockaddr), 0, sizeof(pcoex_info->bt_sockaddr));
+		pcoex_info->bt_sockaddr.sin_family =3D AF_INET;
+		pcoex_info->bt_sockaddr.sin_port =3D htons(CONNECT_PORT_BT);
+		pcoex_info->bt_sockaddr.sin_addr.s_addr =3D htonl(INADDR_LOOPBACK);
+
+		pcoex_info->sk_store =3D NULL;
+		kernel_socket_err =3D pcoex_info->udpsock->ops->bind(pcoex_info->udpsock=
, (struct sockaddr *)&pcoex_info->wifi_sockaddr,
+				    sizeof(pcoex_info->wifi_sockaddr));
+		if (kernel_socket_err =3D=3D 0) {
+			RTW_INFO("binding socket success\n");
+			pcoex_info->udpsock->sk->sk_data_ready =3D rtw_btcoex_recvmsg_init;
+			pcoex_info->sock_open |=3D  KERNEL_SOCKET_OK;
+			pcoex_info->BT_attend =3D false;
+			RTW_INFO("WIFI sending attend_req\n");
+			rtw_btcoex_sendmsgbysocket(padapter, attend_req, sizeof(attend_req), tr=
ue);
+			status =3D _SUCCESS;
+		} else {
+			pcoex_info->BT_attend =3D false;
+			sock_release(pcoex_info->udpsock); /* bind fail release socket */
+			RTW_INFO("Error binding socket: %d\n", kernel_socket_err);
+			status =3D _FAIL;
+		}
+
+	}
+
+	return status;
+}
