+/*
+ * pts	start_point_min		stop_point_max
+ * 128	64			64 + 128 =3D 192
+ * 256	128			128 + 256 =3D 384
+ * 512	256			256 + 512 =3D 768
+ * 1024	512			512 + 1024 =3D 1536
+ *
+ */
+u32 mp_query_psd(PADAPTER pAdapter, u8 *data)
+{
+	u32 i, psd_pts =3D 0, psd_start =3D 0, psd_stop =3D 0;
+	u32 psd_data =3D 0;
+
+
+	if (!netif_running(pAdapter->pnetdev)) {
+		return 0;
+	}
+
+	if (check_fwstate(&pAdapter->mlmepriv, WIFI_MP_STATE) =3D=3D false) {
+		return 0;
+	}
+
+	if (strlen(data) =3D=3D 0) { /* default value */
+		psd_pts =3D 128;
+		psd_start =3D 64;
+		psd_stop =3D 128;
+	} else
+		sscanf(data, "pts=3D%d,start=3D%d,stop=3D%d", &psd_pts, &psd_start, &psd=
_stop);
+
+	data[0] =3D '\0';
+
+	i =3D psd_start;
+	while (i < psd_stop) {
+		if (i >=3D psd_pts)
+			psd_data =3D rtw_GetPSDData(pAdapter, i - psd_pts);
+		else
+			psd_data =3D rtw_GetPSDData(pAdapter, i);
+		sprintf(data + strlen(data), "%x ", psd_data);
+		i++;
+	}
+
+#ifdef CONFIG_LONG_DELAY_ISSUE
+	rtw_msleep_os(100);
+#else
+	rtw_mdelay_os(100);
+#endif
+
+	return strlen(data) + 1;
+}
