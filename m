+		if (TEST_FLAG(bf_cap, BEAMFORMING_HT_BEAMFORMER_ENABLE)) {
+			info->beamforming_cap |=3D BEAMFORMER_CAP_HT_EXPLICIT;
+			*sta_bf_cap |=3D BEAMFORMEE_CAP_HT_EXPLICIT;
+			*comp_steering =3D (bf_cap & BEAMFORMING_HT_BEAMFORMER_STEER_NUM) >> 4;
