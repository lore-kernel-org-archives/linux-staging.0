+/* compress 512-bits */
+static int sha256_compress(struct sha256_state_rtk *md, unsigned char *buf)
+{
+	u32 S[8], W[64], t0, t1;
+	u32 t;
+	int i;
+
+	/* copy state into S */
+	for (i =3D 0; i < 8; i++)
+		S[i] =3D md->state[i];
+
+	/* copy the state into 512-bits into W[0..15] */
+	for (i =3D 0; i < 16; i++)
+		W[i] =3D WPA_GET_BE32(buf + (4 * i));
+
+	/* fill W[16..63] */
+	for (i =3D 16; i < 64; i++) {
+		W[i] =3D Gamma1(W[i - 2]) + W[i - 7] + Gamma0(W[i - 15]) +
+		       W[i - 16];
+	}
+
+	/* Compress */
+#define RND(a, b, c, d, e, f, g, h, i)                          do {\
+	t0 =3D h + Sigma1(e) + Ch(e, f, g) + K[i] + W[i];	\
+	t1 =3D Sigma0(a) + Maj(a, b, c);			\
+	d +=3D t0;					\
+	h  =3D t0 + t1;	\
+	} while (0)
+
+	for (i =3D 0; i < 64; ++i) {
+		RND(S[0], S[1], S[2], S[3], S[4], S[5], S[6], S[7], i);
+		t =3D S[7];
+		S[7] =3D S[6];
+		S[6] =3D S[5];
+		S[5] =3D S[4];
+		S[4] =3D S[3];
+		S[3] =3D S[2];
+		S[2] =3D S[1];
+		S[1] =3D S[0];
+		S[0] =3D t;
+	}
+
+	/* feedback */
+	for (i =3D 0; i < 8; i++)
+		md->state[i] =3D md->state[i] + S[i];
+	return 0;
+}
