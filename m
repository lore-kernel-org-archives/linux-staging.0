+)
+{
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(Adapter);
+	u8			bResult =3D _SUCCESS;
+
+	switch (eVariable) {
+	case HAL_DEF_IS_SUPPORT_ANT_DIV:
+#ifdef CONFIG_ANTENNA_DIVERSITY
+		*((u8 *)pValue) =3D (pHalData->AntDivCfg =3D=3D 0) ? false : true;
+#endif
+		break;
+	case HAL_DEF_DRVINFO_SZ:
+		*((u32 *)pValue) =3D DRVINFO_SZ;
+		break;
+	case HAL_DEF_MAX_RECVBUF_SZ:
+		*((u32 *)pValue) =3D MAX_RECVBUF_SZ;
+		break;
+	case HAL_DEF_RX_PACKET_OFFSET:
+		*((u32 *)pValue) =3D RXDESC_SIZE + DRVINFO_SZ * 8;
+		break;
+#if (RATE_ADAPTIVE_SUPPORT =3D=3D 1)
+	case HAL_DEF_RA_DECISION_RATE: {
+		u8 MacID =3D *((u8 *)pValue);
+		*((u8 *)pValue) =3D odm_ra_get_decision_rate_8188e(&(pHalData->odmpriv),=
 MacID);
+	}
+	break;
+
+	case HAL_DEF_RA_SGI: {
+		u8 MacID =3D *((u8 *)pValue);
+		*((u8 *)pValue) =3D odm_ra_get_sgi_8188e(&(pHalData->odmpriv), MacID);
+	}
+	break;
+#endif
+
+
+	case HAL_DEF_PT_PWR_STATUS:
+#if (POWER_TRAINING_ACTIVE =3D=3D 1)
+		{
+			u8 MacID =3D *((u8 *)pValue);
+			*((u8 *)pValue) =3D odm_ra_get_hw_pwr_status_8188e(&(pHalData->odmpriv)=
, MacID);
+		}
