+	}
+	os_snprintf(drv->own_socket_path, len, "%s/wpa_privsep-%d-%d",
+		    own_dir, getpid(), counter++);
+
+	len =3D os_strlen(own_dir) + 50;
+	drv->own_cmd_path =3D os_malloc(len);
+	if (drv->own_cmd_path =3D=3D NULL) {
+		os_free(drv->own_socket_path);
+		drv->own_socket_path =3D NULL;
+		os_free(priv_dir);
