+static void * eap_wsc_init(struct eap_sm *sm)
+{
+	struct eap_wsc_data *data;
+	const u8 *identity;
+	size_t identity_len;
+	int registrar;
+	struct wps_config cfg;
+	const char *pos;
+	const char *phase1;
+	struct wps_context *wps;
+	struct wps_credential new_ap_settings;
+	int res;
+
+	wps =3D sm->wps;
+	if (wps =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "EAP-WSC: WPS context not available");
+		return NULL;
+	}
+
+	identity =3D eap_get_config_identity(sm, &identity_len);
+
+	if (identity && identity_len =3D=3D WSC_ID_REGISTRAR_LEN &&
+	    os_memcmp(identity, WSC_ID_REGISTRAR, WSC_ID_REGISTRAR_LEN) =3D=3D 0)
+		registrar =3D 1; /* Supplicant is Registrar */
+	else if (identity && identity_len =3D=3D WSC_ID_ENROLLEE_LEN &&
+	    os_memcmp(identity, WSC_ID_ENROLLEE, WSC_ID_ENROLLEE_LEN) =3D=3D 0)
+		registrar =3D 0; /* Supplicant is Enrollee */
+	else {
+		wpa_hexdump_ascii(MSG_INFO, "EAP-WSC: Unexpected identity",
+				  identity, identity_len);
+		return NULL;
+	}
+
+	data =3D os_zalloc(sizeof(*data));
+	if (data =3D=3D NULL)
+		return NULL;
+	data->state =3D registrar ? MESG : WAIT_START;
+	data->registrar =3D registrar;
+	data->wps_ctx =3D wps;
+
+	os_memset(&cfg, 0, sizeof(cfg));
+	cfg.wps =3D wps;
+	cfg.registrar =3D registrar;
+
+	phase1 =3D eap_get_config_phase1(sm);
+	if (phase1 =3D=3D NULL) {
+		wpa_printf(MSG_INFO, "EAP-WSC: phase1 configuration data not "
+			   "set");
+		os_free(data);
+		return NULL;
+	}
+
+	pos =3D os_strstr(phase1, "pin=3D");
+	if (pos) {
+		pos +=3D 4;
+		cfg.pin =3D (const u8 *) pos;
+		while (*pos !=3D '\0' && *pos !=3D ' ')
+			pos++;
+		cfg.pin_len =3D pos - (const char *) cfg.pin;
+	} else {
+		pos =3D os_strstr(phase1, "pbc=3D1");
+		if (pos)
+			cfg.pbc =3D 1;
+	}
+
+	if (cfg.pin =3D=3D NULL && !cfg.pbc) {
+		wpa_printf(MSG_INFO, "EAP-WSC: PIN or PBC not set in phase1 "
+			   "configuration data");
+		os_free(data);
+		return NULL;
+	}
+
+	pos =3D os_strstr(phase1, "dev_pw_id=3D");
+	if (pos && cfg.pin)
+		cfg.dev_pw_id =3D atoi(pos + 10);
+
+	res =3D eap_wsc_new_ap_settings(&new_ap_settings, phase1);
+	if (res < 0) {
+		os_free(data);
+		return NULL;
+	}
+	if (res =3D=3D 1) {
+		wpa_printf(MSG_DEBUG, "EAP-WSC: Provide new AP settings for "
+			   "WPS");
+		cfg.new_ap_settings =3D &new_ap_settings;
+	}
+
+	data->wps =3D wps_init(&cfg);
+	if (data->wps =3D=3D NULL) {
+		os_free(data);
+		return NULL;
+	}
+	res =3D eap_get_config_fragment_size(sm);
+	if (res > 0)
+		data->fragment_size =3D res;
+	else
+		data->fragment_size =3D WSC_FRAGMENT_SIZE;
+	wpa_printf(MSG_DEBUG, "EAP-WSC: Fragment size limit %u",
+		   (unsigned int) data->fragment_size);
+
+	if (registrar && cfg.pin) {
+		wps_registrar_add_pin(data->wps_ctx->registrar, NULL, NULL,
+				      cfg.pin, cfg.pin_len, 0);
+	}
+
+	/* Use reduced client timeout for WPS to avoid long wait */
+	if (sm->ClientTimeout > 30)
+		sm->ClientTimeout =3D 30;
+
+	return data;
+}
