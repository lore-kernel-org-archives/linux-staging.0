+
+		spos =3D custom + 17;
+
+		bytes =3D strspn(spos, "0123456789abcdefABCDEF");
+		if (!bytes || (bytes & 1))
+			return;
+		bytes /=3D 2;
+
+		req_ies =3D os_malloc(bytes);
