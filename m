+static void _beamforming_enter(PADAPTER adapter, void *p)
+{
+	struct mlme_priv *mlme;
+	struct ht_priv *htpriv;
+	struct mlme_ext_priv *mlme_ext;
+	struct sta_info *sta, *sta_copy;
+	struct beamforming_info *info;
+	struct beamformer_entry *bfer =3D NULL;
+	struct beamformee_entry *bfee =3D NULL;
+	u8 wireless_mode;
+	u8 sta_bf_cap;
+	u8 sounding_dim =3D 0; /* number of sounding dimensions */
+	u8 comp_steering_num =3D 0; /* compressed steering number */
+
+
+	mlme =3D &adapter->mlmepriv;
+	htpriv =3D &mlme->htpriv;
+	mlme_ext =3D &adapter->mlmeextpriv;
+	info =3D GET_BEAMFORM_INFO(adapter);
+
+	sta_copy =3D (struct sta_info *)p;
+	sta =3D rtw_get_stainfo(&adapter->stapriv, sta_copy->hwaddr);
+	if (!sta) {
+		RTW_ERR("%s: Cann't find STA info for " MAC_FMT "\n",
+		        __func__, MAC_ARG(sta_copy->hwaddr));
+		return;
+	}
+	if (sta !=3D sta_copy) {
+		RTW_WARN("%s: Origin sta(fake)=3D%p realsta=3D%p for " MAC_FMT "\n",
+	        	 __func__, sta_copy, sta, MAC_ARG(sta_copy->hwaddr));
+	}
+
+	/* The current setting does not support Beaforming */
+	wireless_mode =3D sta->wireless_mode;
+	if ((is_supported_ht(wireless_mode) =3D=3D false)
+	    && (is_supported_vht(wireless_mode) =3D=3D false)) {
+		RTW_WARN("%s: Not support HT or VHT mode\n", __func__);
+		return;
+	}
+
+	if ((0 =3D=3D htpriv->beamform_cap)) {
+		RTW_INFO("The configuration disabled Beamforming! Skip...\n");
+		return;
+	}
+
+	_get_sta_beamform_cap(adapter, sta,
+			      &sta_bf_cap, &sounding_dim, &comp_steering_num);
+	RTW_INFO("STA Beamforming Capability=3D0x%02X\n", sta_bf_cap);
+	if (sta_bf_cap =3D=3D BEAMFORMING_CAP_NONE)
+		return;
+	if ((sta_bf_cap & BEAMFORMEE_CAP_HT_EXPLICIT)
+	    || (sta_bf_cap & BEAMFORMEE_CAP_VHT_SU)
+	    || (sta_bf_cap & BEAMFORMEE_CAP_VHT_MU))
+		sta_bf_cap |=3D BEAMFORMEE_CAP;
+	if ((sta_bf_cap & BEAMFORMER_CAP_HT_EXPLICIT)
+	    || (sta_bf_cap & BEAMFORMER_CAP_VHT_SU)
+	    || (sta_bf_cap & BEAMFORMER_CAP_VHT_MU))
+		sta_bf_cap |=3D BEAMFORMER_CAP;
+
+	if (sta_bf_cap & BEAMFORMER_CAP) {
+		/* The other side is beamformer */
+		bfer =3D _bfer_add_entry(adapter, sta, sta_bf_cap, sounding_dim, comp_st=
eering_num);
+		if (!bfer)
+			RTW_ERR("%s: Fail to allocate bfer entry!\n", __func__);
+	}
+	if (sta_bf_cap & BEAMFORMEE_CAP) {
+		/* The other side is beamformee */
+		bfee =3D _bfee_add_entry(adapter, sta, sta_bf_cap, sounding_dim, comp_st=
eering_num);
+		if (!bfee)
+			RTW_ERR("%s: Fail to allocate bfee entry!\n", __func__);
+	}
+	if (!bfer && !bfee)
+		return;
+
+	rtw_hal_set_hwreg(adapter, HW_VAR_SOUNDING_ENTER, (u8*)sta);
+
+	/* Perform sounding if there is BFee */
+	if ((info->beamformee_su_cnt !=3D 0)
+	    || (info->beamformee_mu_cnt !=3D 0)) {
+		if (SOUNDING_STATE_NONE =3D=3D info->sounding_info.state) {
+			info->sounding_info.state =3D SOUNDING_STATE_INIT;
+			/* Start sounding after 2 sec */
+			_set_timer(&info->sounding_timer, 2000);
+		}
+	}
+}
