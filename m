+void add_RATid(_adapter *padapter, struct sta_info *psta, u8 rssi_level, u=
8 is_update_bw)
+{
+	int i;
+	u8 rf_type;
+	unsigned char sta_band =3D 0;
+	u64 tx_ra_bitmap =3D 0;
+	struct ht_priv	*psta_ht =3D NULL;
+	struct mlme_priv *pmlmepriv =3D &(padapter->mlmepriv);
+	WLAN_BSSID_EX *pcur_network =3D (WLAN_BSSID_EX *)&pmlmepriv->cur_network.=
network;
+
+	if (psta)
+		psta_ht =3D &psta->htpriv;
+	else
+		return;
+
+	if (!(psta->state & _FW_LINKED))
+		return;
+
+	rtw_hal_update_sta_rate_mask(padapter, psta);
+	tx_ra_bitmap =3D psta->ra_mask;
+
+	if (pcur_network->Configuration.DSConfig > 14) {
+		if (tx_ra_bitmap & 0xffff000)
+			sta_band |=3D WIRELESS_11_5N ;
+
+		if (tx_ra_bitmap & 0xff0)
+			sta_band |=3D WIRELESS_11A;
+	} else {
+		/* 5G band */
+		if (tx_ra_bitmap & 0xffff000)
+			sta_band |=3D WIRELESS_11_24N;
+
+		if (tx_ra_bitmap & 0xff0)
+			sta_band |=3D WIRELESS_11G;
+
+		if (tx_ra_bitmap & 0x0f)
+			sta_band |=3D WIRELESS_11B;
+	}
+
+	psta->wireless_mode =3D sta_band;
+	psta->raid =3D rtw_hal_networktype_to_raid(padapter, psta);
+
+	if (psta->aid < NUM_STA) {
+		RTW_INFO("%s=3D> mac_id:%d , raid:%d, tx_ra_bitmap:0x%016llx, networkTyp=
e:0x%02x\n",
+			__func__, psta->mac_id, psta->raid, tx_ra_bitmap, psta->wireless_mode);
+
+		rtw_update_ramask(padapter, psta, psta->mac_id, rssi_level, is_update_bw=
);
+	} else
+		RTW_INFO("station aid %d exceed the max number\n", psta->aid);
+
+}
