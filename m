+		tic->limit =3D limit;
+		tic->tpt =3D tpt_offset;
+		tic->ebias =3D extra_bias;
+	}
+
+	by_rate_diff =3D by_rate_diff > limit ? limit : by_rate_diff;
+	power_idx =3D base_idx + by_rate_diff + tpt_offset + extra_bias;
