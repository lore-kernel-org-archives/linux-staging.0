+/*
+* Open the file with @param path and retrive the file content into memory =
starting from @param buf for @param sz at most
+* @param path the path of the file to open and read
+* @param buf the starting address of the buffer to store file content
+* @param sz how many bytes to read at most
+* @return the byte we've read, or Linux specific error code
+*/
+static int retriveFromFile(const char *path, u8 *buf, u32 sz)
+{
+	int ret =3D -1;
+#ifdef set_fs
+	mm_segment_t oldfs;
+#endif
+	struct file *fp;
+
+	if (path && buf) {
+		ret =3D openFile(&fp, path, O_RDONLY, 0);
+		if (0 =3D=3D ret) {
+			RTW_INFO("%s openFile path:%s fp=3D%p\n", __func__, path , fp);
+
+#ifdef set_fs
+			oldfs =3D get_fs();
+			set_fs(KERNEL_DS);
+#endif
+			ret =3D readFile(fp, buf, sz);
+#ifdef set_fs
+			set_fs(oldfs);
+#endif
+			closeFile(fp);
+
+			RTW_INFO("%s readFile, ret:%d\n", __func__, ret);
+
+		} else
+			RTW_INFO("%s openFile path:%s Fail, ret:%d\n", __func__, path, ret);
+	} else {
+		RTW_INFO("%s NULL pointer\n", __func__);
+		ret =3D  -EINVAL;
+	}
+	return ret;
+}
