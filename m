+void
+phydm_adaptivity_init(
+	void		*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _ADAPTIVITY_STATISTICS	*adaptivity =3D (struct _ADAPTIVITY_STATIST=
ICS *)phydm_get_structure(p_dm_odm, PHYDM_ADAPTIVITY);
+	s8	igi_target =3D 0x32;
+
+	if (p_dm_odm->carrier_sense_enable =3D=3D false) {
+		if (p_dm_odm->th_l2h_ini =3D=3D 0)
+			p_dm_odm->th_l2h_ini =3D 0xf5;
+	} else
+		p_dm_odm->th_l2h_ini =3D 0xa;
+
+	if (p_dm_odm->th_edcca_hl_diff =3D=3D 0)
+		p_dm_odm->th_edcca_hl_diff =3D 7;
+	if (p_dm_odm->wifi_test =3D=3D true || p_dm_odm->mp_mode =3D=3D true)
+		p_dm_odm->edcca_enable =3D false;		/*even no adaptivity, we still enable=
 EDCCA, AP side use mib control*/
+	else
+		p_dm_odm->edcca_enable =3D true;
+
+	p_dm_odm->adaptivity_igi_upper =3D 0;
+	p_dm_odm->adaptivity_enable =3D false;	/*use this flag to decide enable o=
r disable*/
+
+	p_dm_odm->th_l2h_ini_mode2 =3D 20;
+	p_dm_odm->th_edcca_hl_diff_mode2 =3D 8;
+	adaptivity->th_l2h_ini_backup =3D p_dm_odm->th_l2h_ini;
+	adaptivity->th_edcca_hl_diff_backup =3D p_dm_odm->th_edcca_hl_diff;
+
+	adaptivity->igi_base =3D 0x32;
+	adaptivity->igi_target =3D 0x1c;
+	adaptivity->h2l_lb =3D 0;
+	adaptivity->l2h_lb =3D 0;
+	adaptivity->nhm_wait =3D 0;
+	adaptivity->is_check =3D false;
+	adaptivity->is_first_link =3D true;
+	adaptivity->adajust_igi_level =3D 0;
+	adaptivity->is_stop_edcca =3D false;
+	adaptivity->backup_h2l =3D 0;
+	adaptivity->backup_l2h =3D 0;
+
+	phydm_mac_edcca_state(p_dm_odm, phydm_dont_ignore_edcca);
+
+	/*Search pwdB lower bound*/
+	if (p_dm_odm->support_ic_type & ODM_IC_11N_SERIES)
+		odm_set_bb_reg(p_dm_odm, ODM_REG_DBG_RPT_11N, MASKDWORD, 0x208);
+	else if (p_dm_odm->support_ic_type & ODM_IC_11AC_SERIES)
+		odm_set_bb_reg(p_dm_odm, ODM_REG_DBG_RPT_11AC, MASKDWORD, 0x209);
+
+	if (p_dm_odm->support_ic_type & ODM_IC_11N_GAIN_IDX_EDCCA) {
+		/*odm_set_bb_reg(p_dm_odm, ODM_REG_EDCCA_DOWN_OPT_11N, BIT(12) | BIT11 |=
 BIT10, 0x7);*/		/*interfernce need > 2^x us, and then EDCCA will be 1*/
+		if (p_dm_odm->support_ic_type & ODM_RTL8197F) {
+			odm_set_bb_reg(p_dm_odm, ODM_REG_PAGE_B1_97F, BIT(30), 0x1);								/*s=
et to page B1*/
+			odm_set_bb_reg(p_dm_odm, ODM_REG_EDCCA_DCNF_97F, BIT(27) | BIT26, 0x1);=
		/*0:rx_dfir, 1: dcnf_out, 2 :rx_iq, 3: rx_nbi_nf_out*/
+			odm_set_bb_reg(p_dm_odm, ODM_REG_PAGE_B1_97F, BIT(30), 0x0);
+		} else
+			odm_set_bb_reg(p_dm_odm, ODM_REG_EDCCA_DCNF_11N, BIT(21) | BIT20, 0x1);=
		/*0:rx_dfir, 1: dcnf_out, 2 :rx_iq, 3: rx_nbi_nf_out*/
+	}
+	if (p_dm_odm->support_ic_type & ODM_IC_11AC_GAIN_IDX_EDCCA) {		/*8814a no=
 need to find pwdB lower bound, maybe*/
+		/*odm_set_bb_reg(p_dm_odm, ODM_REG_EDCCA_DOWN_OPT, BIT(30) | BIT29 | BIT=
28, 0x7);*/		/*interfernce need > 2^x us, and then EDCCA will be 1*/
+		odm_set_bb_reg(p_dm_odm, ODM_REG_ACBB_EDCCA_ENHANCE, BIT(29) | BIT28, 0x=
1);		/*0:rx_dfir, 1: dcnf_out, 2 :rx_iq, 3: rx_nbi_nf_out*/
+	}
+
+	if (!(p_dm_odm->support_ic_type & (ODM_IC_11AC_GAIN_IDX_EDCCA | ODM_IC_11=
N_GAIN_IDX_EDCCA))) {
+		phydm_search_pwdb_lower_bound(p_dm_odm);
+		if (phydm_re_search_condition(p_dm_odm))
+			phydm_search_pwdb_lower_bound(p_dm_odm);
+	}
+
+	/*we need to consider PwdB upper bound for 8814 later IC*/
+	adaptivity->adajust_igi_level =3D (u8)((p_dm_odm->th_l2h_ini + igi_target=
) - pwdb_upper_bound + dfir_loss);	/*IGI =3D L2H - PwdB - dfir_loss*/
+
+	ODM_RT_TRACE(p_dm_odm, PHYDM_COMP_ADAPTIVITY, ODM_DBG_LOUD, ("th_l2h_ini =
=3D 0x%x, th_edcca_hl_diff =3D 0x%x, adaptivity->adajust_igi_level =3D 0x%x=
\n", p_dm_odm->th_l2h_ini, p_dm_odm->th_edcca_hl_diff, adaptivity->adajust_=
igi_level));
+
+	/*Check this later on Windows*/
+	/*phydm_set_edcca_threshold_api(p_dm_odm, p_dm_dig_table->cur_ig_value);*/
+
+}
