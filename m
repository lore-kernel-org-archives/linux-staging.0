+
+	if (conf->auth_servers) {
+		for (i =3D 0; i < conf->num_auth_servers; i++) {
+			serv =3D &conf->auth_servers[i];
+			count +=3D radius_client_dump_auth_server(
+				buf + count, buflen - count, serv,
+				serv =3D=3D conf->auth_server ?
+				radius : NULL);
+		}
+	}
+
+	if (conf->acct_servers) {
+		for (i =3D 0; i < conf->num_acct_servers; i++) {
+			serv =3D &conf->acct_servers[i];
+			count +=3D radius_client_dump_acct_server(
+				buf + count, buflen - count, serv,
+				serv =3D=3D conf->acct_server ?
+				radius : NULL);
+		}
+	}
+
+	return count;
+}
+
+
+void radius_client_reconfig(struct radius_client_data *radius,
+			    struct hostapd_radius_servers *conf)
+{
+	if (radius)
+		radius->conf =3D conf;
+}
