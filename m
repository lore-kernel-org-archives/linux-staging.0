+
+
+/* ************************************************************
+ * include files
+ * ************************************************************ */
+#include "mp_precomp.h"
+#include "phydm_precomp.h"
+
+#if (defined(CONFIG_BB_POWER_SAVING))
+
+void
+odm_dynamic_bb_power_saving_init(
+	void					*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _dynamic_power_saving	*p_dm_ps_table =3D &p_dm_odm->dm_ps_table;
+
+	p_dm_ps_table->pre_cca_state =3D CCA_MAX;
+	p_dm_ps_table->cur_cca_state =3D CCA_MAX;
+	p_dm_ps_table->pre_rf_state =3D RF_MAX;
+	p_dm_ps_table->cur_rf_state =3D RF_MAX;
+	p_dm_ps_table->rssi_val_min =3D 0;
+	p_dm_ps_table->initialize =3D 0;
+}
+
+void
+odm_rf_saving(
+	void					*p_dm_void,
+	u8		is_force_in_normal
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _dynamic_power_saving	*p_dm_ps_table =3D &p_dm_odm->dm_ps_table;
+	u8	rssi_up_bound =3D 30 ;
+	u8	rssi_low_bound =3D 25;
+	if (p_dm_odm->patch_id =3D=3D 40) { /* RT_CID_819x_FUNAI_TV */
+		rssi_up_bound =3D 50 ;
+		rssi_low_bound =3D 45;
+	}
+	if (p_dm_ps_table->initialize =3D=3D 0) {
+		p_dm_ps_table->reg874 =3D (odm_get_bb_reg(p_dm_odm, 0x874, MASKDWORD) & =
0x1CC000) >> 14;
+		p_dm_ps_table->regc70 =3D (odm_get_bb_reg(p_dm_odm, 0xc70, MASKDWORD) & =
BIT(3)) >> 3;
+		p_dm_ps_table->reg85c =3D (odm_get_bb_reg(p_dm_odm, 0x85c, MASKDWORD) & =
0xFF000000) >> 24;
+		p_dm_ps_table->rega74 =3D (odm_get_bb_reg(p_dm_odm, 0xa74, MASKDWORD) & =
0xF000) >> 12;
+		/* Reg818 =3D phy_query_bb_reg(p_adapter, 0x818, MASKDWORD); */
+		p_dm_ps_table->initialize =3D 1;
+	}
+
+	if (!is_force_in_normal) {
+		if (p_dm_odm->rssi_min !=3D 0xFF) {
+			if (p_dm_ps_table->pre_rf_state =3D=3D rf_normal) {
+				if (p_dm_odm->rssi_min >=3D rssi_up_bound)
+					p_dm_ps_table->cur_rf_state =3D rf_save;
+				else
+					p_dm_ps_table->cur_rf_state =3D rf_normal;
+			} else {
+				if (p_dm_odm->rssi_min <=3D rssi_low_bound)
+					p_dm_ps_table->cur_rf_state =3D rf_normal;
+				else
+					p_dm_ps_table->cur_rf_state =3D rf_save;
+			}
+		} else
+			p_dm_ps_table->cur_rf_state =3D RF_MAX;
+	} else
+		p_dm_ps_table->cur_rf_state =3D rf_normal;
+
+	if (p_dm_ps_table->pre_rf_state !=3D p_dm_ps_table->cur_rf_state) {
+		if (p_dm_ps_table->cur_rf_state =3D=3D rf_save) {
+			odm_set_bb_reg(p_dm_odm, 0x874, 0x1C0000, 0x2); /* reg874[20:18]=3D3'b0=
10 */
+			odm_set_bb_reg(p_dm_odm, 0xc70, BIT(3), 0); /* regc70[3]=3D1'b0 */
+			odm_set_bb_reg(p_dm_odm, 0x85c, 0xFF000000, 0x63); /* reg85c[31:24]=3D0=
x63 */
+			odm_set_bb_reg(p_dm_odm, 0x874, 0xC000, 0x2); /* reg874[15:14]=3D2'b10 =
*/
+			odm_set_bb_reg(p_dm_odm, 0xa74, 0xF000, 0x3); /* RegA75[7:4]=3D0x3 */
+			odm_set_bb_reg(p_dm_odm, 0x818, BIT(28), 0x0); /* Reg818[28]=3D1'b0 */
+			odm_set_bb_reg(p_dm_odm, 0x818, BIT(28), 0x1); /* Reg818[28]=3D1'b1 */
+		} else {
+			odm_set_bb_reg(p_dm_odm, 0x874, 0x1CC000, p_dm_ps_table->reg874);
+			odm_set_bb_reg(p_dm_odm, 0xc70, BIT(3), p_dm_ps_table->regc70);
+			odm_set_bb_reg(p_dm_odm, 0x85c, 0xFF000000, p_dm_ps_table->reg85c);
+			odm_set_bb_reg(p_dm_odm, 0xa74, 0xF000, p_dm_ps_table->rega74);
+			odm_set_bb_reg(p_dm_odm, 0x818, BIT(28), 0x0);
+		}
+		p_dm_ps_table->pre_rf_state =3D p_dm_ps_table->cur_rf_state;
+	}
+}
+
+#endif
