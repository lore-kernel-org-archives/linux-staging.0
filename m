+static int
+hal_EfusePgPacketRead_8188e(
+	PADAPTER	pAdapter,
+	u8			offset,
+	u8			*data,
+	bool		bPseudoTest)
+{
+	u8	ReadState =3D PG_STATE_HEADER;
+
+	int	bContinual =3D true;
+	int	bDataEmpty =3D true ;
+
+	u8	efuse_data, word_cnts =3D 0;
+	u16	efuse_addr =3D 0;
+	u8	hoffset =3D 0, hworden =3D 0;
+	u8	tmpidx =3D 0;
