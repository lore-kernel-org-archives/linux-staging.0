+
+			param[count++] =3D tmp;
+
+		} while (count < RTW_CUSTOMER_STR_LEN);
+
+		if (count =3D=3D 0) {
+			rtw_mfree(pbuf, len);
+			RTW_WARN("%s: no input!\n", __func__);
+			return -EFAULT;
+		}
+		ret =3D rtw_hal_customer_str_write(adapter, param);
+	} else {
+		rtw_mfree(pbuf, len);
+		RTW_INFO("%s: parameter error(unknown cmd)!\n", __func__);
+		return -EFAULT;
+	}
+
+	pos =3D sprintf(extra, "%s: ", read ? "read" : "write");
+	if (read =3D=3D 0 || ret =3D=3D _SUCCESS) {
+		for (i =3D 0; i < RTW_CUSTOMER_STR_LEN; i++)
+			pos +=3D sprintf(extra + pos, "%02x:", param[i]);
+		extra[pos] =3D 0;
+		pos--;
+	}
+	pos +=3D sprintf(extra + pos, " %s", ret =3D=3D _SUCCESS ? "OK" : "FAIL");
+
+	wrqu->data.length =3D strlen(extra) + 1;
+
+free_buf:
