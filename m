+static int eap_fast_get_status(struct eap_sm *sm, void *priv, char *buf,
+			       size_t buflen, int verbose)
+{
+	struct eap_fast_data *data =3D priv;
+	int len, ret;
+
+	len =3D eap_peer_tls_status(sm, &data->ssl, buf, buflen, verbose);
+	if (data->phase2_method) {
+		ret =3D os_snprintf(buf + len, buflen - len,
+				  "EAP-FAST Phase2 method=3D%s\n",
+				  data->phase2_method->name);
+		if (ret < 0 || (size_t) ret >=3D buflen - len)
+			return len;
+		len +=3D ret;
+	}
+	return len;
