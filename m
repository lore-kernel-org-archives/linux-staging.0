+		p =3D rtw_get_ie(pie + _BEACON_IE_OFFSET_, _SSID_IE_, &tmp_len, (pnetwor=
k_mlmeext->IELength - _BEACON_IE_OFFSET_));
+		if (p !=3D NULL)
