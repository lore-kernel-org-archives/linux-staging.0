+/**
+ * hostapd_config_read - Read and parse a configuration file
+ * @fname: Configuration file name (including path, if needed)
+ * Returns: Allocated configuration data structure
+ */
+struct hostapd_config * hostapd_config_read(const char *fname)
+{
+	struct hostapd_config *conf;
+	struct hostapd_bss_config *bss;
+	FILE *f;
+	char buf[256], *pos;
+	int line =3D 0;
+	int errors =3D 0;
+	int pairwise;
+	size_t i;
+
+	f =3D fopen(fname, "r");
+	if (f =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "Could not open configuration file '%s' "
+			   "for reading.", fname);
+		return NULL;
+	}
+
+	conf =3D hostapd_config_defaults();
+	if (conf =3D=3D NULL) {
+		fclose(f);
+		return NULL;
+	}
+
+	/* set default driver based on configuration */
+	conf->driver =3D wpa_drivers[0];
+	if (conf->driver =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "No driver wrappers registered!");
+		hostapd_config_free(conf);
+		fclose(f);
+		return NULL;
+	}
+
+	bss =3D conf->last_bss =3D conf->bss;
+
+	while (fgets(buf, sizeof(buf), f)) {
+		bss =3D conf->last_bss;
+		line++;
+
+		if (buf[0] =3D=3D '#')
+			continue;
+		pos =3D buf;
+		while (*pos !=3D '\0') {
+			if (*pos =3D=3D '\n') {
+				*pos =3D '\0';
+				break;
+			}
+			pos++;
+		}
+		if (buf[0] =3D=3D '\0')
+			continue;
+
+		pos =3D os_strchr(buf, '=3D');
+		if (pos =3D=3D NULL) {
+			wpa_printf(MSG_ERROR, "Line %d: invalid line '%s'",
+				   line, buf);
+			errors++;
+			continue;
+		}
+		*pos =3D '\0';
+		pos++;
+
+		if (os_strcmp(buf, "interface") =3D=3D 0) {
+			os_strlcpy(conf->bss[0].iface, pos,
+				   sizeof(conf->bss[0].iface));
+		} else if (os_strcmp(buf, "bridge") =3D=3D 0) {
+			os_strlcpy(bss->bridge, pos, sizeof(bss->bridge));
+		} else if (os_strcmp(buf, "wds_bridge") =3D=3D 0) {
+			os_strlcpy(bss->wds_bridge, pos,
+				   sizeof(bss->wds_bridge));
+		} else if (os_strcmp(buf, "driver") =3D=3D 0) {
+			int j;
+			/* clear to get error below if setting is invalid */
+			conf->driver =3D NULL;
+			for (j =3D 0; wpa_drivers[j]; j++) {
+				if (os_strcmp(pos, wpa_drivers[j]->name) =3D=3D 0)
+				{
+					conf->driver =3D wpa_drivers[j];
+					break;
+				}
+			}
+			if (conf->driver =3D=3D NULL) {
+				wpa_printf(MSG_ERROR, "Line %d: invalid/"
+					   "unknown driver '%s'", line, pos);
+				errors++;
+			}
+		} else if (os_strcmp(buf, "debug") =3D=3D 0) {
+			wpa_printf(MSG_DEBUG, "Line %d: DEPRECATED: 'debug' "
+				   "configuration variable is not used "
+				   "anymore", line);
+		} else if (os_strcmp(buf, "logger_syslog_level") =3D=3D 0) {
+			bss->logger_syslog_level =3D atoi(pos);
+		} else if (os_strcmp(buf, "logger_stdout_level") =3D=3D 0) {
+			bss->logger_stdout_level =3D atoi(pos);
+		} else if (os_strcmp(buf, "logger_syslog") =3D=3D 0) {
+			bss->logger_syslog =3D atoi(pos);
+		} else if (os_strcmp(buf, "logger_stdout") =3D=3D 0) {
+			bss->logger_stdout =3D atoi(pos);
+		} else if (os_strcmp(buf, "dump_file") =3D=3D 0) {
+			bss->dump_log_name =3D os_strdup(pos);
+		} else if (os_strcmp(buf, "ssid") =3D=3D 0) {
+			bss->ssid.ssid_len =3D os_strlen(pos);
+			if (bss->ssid.ssid_len > HOSTAPD_MAX_SSID_LEN ||
+			    bss->ssid.ssid_len < 1) {
+				wpa_printf(MSG_ERROR, "Line %d: invalid SSID "
+					   "'%s'", line, pos);
+				errors++;
+			} else {
