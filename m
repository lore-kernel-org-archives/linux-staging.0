+u16 rtw_recv_select_queue(struct sk_buff *skb)
+{
+	struct iphdr *piphdr;
+	unsigned int dscp;
+	__be16	eth_type;
+	u32 priority;
+	u8 *pdata =3D skb->data;
+
+	memcpy(&eth_type, pdata + (ETH_ALEN << 1), 2);
+
+	switch (eth_type) {
+	case htons(ETH_P_IP):
+		piphdr =3D (struct iphdr *)(pdata + ETH_HLEN);
+		dscp =3D piphdr->tos & 0xfc;
+		priority =3D dscp >> 5;
+		break;
+	default:
+		priority =3D 0;
+	}
+
+	return rtw_1d_to_queue[priority];
+}
+
+#endif
+static int rtw_ndev_notifier_call(struct notifier_block *nb, unsigned long=
 state, void *ptr)
+{
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(3, 11, 0))
+	struct net_device *dev =3D netdev_notifier_info_to_dev(ptr);
+#else
+	struct net_device *dev =3D ptr;
+#endif
+
+	if (dev =3D=3D NULL)
+		return NOTIFY_DONE;
+
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 29))
+	if (dev->netdev_ops =3D=3D NULL)
+		return NOTIFY_DONE;
+
+	if (dev->netdev_ops->ndo_do_ioctl =3D=3D NULL)
+		return NOTIFY_DONE;
+
+	if (dev->netdev_ops->ndo_do_ioctl !=3D rtw_ioctl)
+#else
+	if (dev->do_ioctl =3D=3D NULL)
+		return NOTIFY_DONE;
+
+	if (dev->do_ioctl !=3D rtw_ioctl)
+#endif
+		return NOTIFY_DONE;
+
+	RTW_INFO(FUNC_NDEV_FMT" state:%lu\n", FUNC_NDEV_ARG(dev), state);
+
+	switch (state) {
+	case NETDEV_CHANGENAME:
+		rtw_adapter_proc_replace(dev);
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
