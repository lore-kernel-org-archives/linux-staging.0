+		code =3D RADIUS_CODE_ACCESS_REJECT;
+	} else if (sess->eap_if->eapSuccess) {
+		sess->eap_if->eapSuccess =3D FALSE;
+		code =3D RADIUS_CODE_ACCESS_ACCEPT;
+	} else {
