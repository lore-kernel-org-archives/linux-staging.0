+void init_wifidirect_info(_adapter *padapter, enum P2P_ROLE role)
+{
+	struct wifidirect_info	*pwdinfo;
+#ifdef CONFIG_WFD
+	struct wifi_display_info	*pwfd_info =3D &padapter->wfd_info;
+#endif
+	u8 union_ch =3D 0;
+	pwdinfo =3D &padapter->wdinfo;
+
+	pwdinfo->padapter =3D padapter;
+
+	/*	1, 6, 11 are the social channel defined in the WiFi Direct specificati=
on. */
+	pwdinfo->social_chan[0] =3D 1;
+	pwdinfo->social_chan[1] =3D 6;
+	pwdinfo->social_chan[2] =3D 11;
+	pwdinfo->social_chan[3] =3D 0;	/*	channel 0 for scanning ending in site s=
urvey function. */
+
+	if (role !=3D P2P_ROLE_DISABLE
+		&& pwdinfo->driver_interface !=3D DRIVER_CFG80211
+	) {
+		#ifdef CONFIG_CONCURRENT_MODE
+		if (rtw_mi_check_status(padapter, MI_LINKED))
+			union_ch =3D rtw_mi_get_union_chan(padapter);
+
+		if (union_ch !=3D 0 &&
+			(union_ch =3D=3D 1 || union_ch =3D=3D 6 || union_ch =3D=3D 11)
+		) {
+			/* Use the AP's channel as the listen channel */
+			/* This will avoid the channel switch between AP's channel and listen c=
hannel */
+			pwdinfo->listen_channel =3D union_ch;
+		} else
+		#endif /* CONFIG_CONCURRENT_MODE */
+		{
+			/* Use the channel 11 as the listen channel */
+			pwdinfo->listen_channel =3D 11;
+		}
+	}
+
+	if (role =3D=3D P2P_ROLE_DEVICE) {
+		rtw_p2p_set_role(pwdinfo, P2P_ROLE_DEVICE);
+#ifdef CONFIG_CONCURRENT_MODE
+		if (rtw_mi_check_status(padapter, MI_LINKED))
+			rtw_p2p_set_state(pwdinfo, P2P_STATE_IDLE);
+		else
+#endif
+			rtw_p2p_set_state(pwdinfo, P2P_STATE_LISTEN);
+
+		pwdinfo->intent =3D 1;
+		rtw_p2p_set_pre_state(pwdinfo, P2P_STATE_LISTEN);
+	} else if (role =3D=3D P2P_ROLE_CLIENT) {
+		rtw_p2p_set_role(pwdinfo, P2P_ROLE_CLIENT);
+		rtw_p2p_set_state(pwdinfo, P2P_STATE_GONEGO_OK);
+		pwdinfo->intent =3D 1;
+		rtw_p2p_set_pre_state(pwdinfo, P2P_STATE_GONEGO_OK);
+	} else if (role =3D=3D P2P_ROLE_GO) {
+		rtw_p2p_set_role(pwdinfo, P2P_ROLE_GO);
+		rtw_p2p_set_state(pwdinfo, P2P_STATE_GONEGO_OK);
+		pwdinfo->intent =3D 15;
+		rtw_p2p_set_pre_state(pwdinfo, P2P_STATE_GONEGO_OK);
+	}
+
+	/*	Use the OFDM rate in the P2P probe response frame. ( 6(B), 9(B), 12, 1=
8, 24, 36, 48, 54 )	 */
+	pwdinfo->support_rate[0] =3D 0x8c;	/*	6(B) */
+	pwdinfo->support_rate[1] =3D 0x92;	/*	9(B) */
+	pwdinfo->support_rate[2] =3D 0x18;	/*	12 */
+	pwdinfo->support_rate[3] =3D 0x24;	/*	18 */
+	pwdinfo->support_rate[4] =3D 0x30;	/*	24 */
+	pwdinfo->support_rate[5] =3D 0x48;	/*	36 */
+	pwdinfo->support_rate[6] =3D 0x60;	/*	48 */
+	pwdinfo->support_rate[7] =3D 0x6c;	/*	54 */
+
+	memcpy((void *) pwdinfo->p2p_wildcard_ssid, "DIRECT-", 7);
+
+	memset(pwdinfo->device_name, 0x00, WPS_MAX_DEVICE_NAME_LEN);
+	pwdinfo->device_name_len =3D 0;
+
+	memset(&pwdinfo->invitereq_info, 0x00, sizeof(struct tx_invite_req_info));
+	pwdinfo->invitereq_info.token =3D 3;	/*	Token used for P2P invitation req=
uest frame. */
+
+	memset(&pwdinfo->inviteresp_info, 0x00, sizeof(struct tx_invite_resp_info=
));
+	pwdinfo->inviteresp_info.token =3D 0;
+
+	pwdinfo->profileindex =3D 0;
+	memset(&pwdinfo->profileinfo[0], 0x00, sizeof(struct profile_info) * P2P_=
MAX_PERSISTENT_GROUP_NUM);
+
+	rtw_p2p_findphase_ex_set(pwdinfo, P2P_FINDPHASE_EX_NONE);
+
+	pwdinfo->listen_dwell =3D (u8)((jiffies % 3) + 1);
+	/* RTW_INFO( "[%s] listen_dwell time is %d00ms\n", __func__, pwdinfo->lis=
ten_dwell ); */
+
+	memset(&pwdinfo->tx_prov_disc_info, 0x00, sizeof(struct tx_provdisc_req_i=
nfo));
+	pwdinfo->tx_prov_disc_info.wps_config_method_request =3D WPS_CM_NONE;
+
+	memset(&pwdinfo->nego_req_info, 0x00, sizeof(struct tx_nego_req_info));
+
+	pwdinfo->device_password_id_for_nego =3D WPS_DPID_PBC;
+	pwdinfo->negotiation_dialog_token =3D 1;
+
+	memset(pwdinfo->nego_ssid, 0x00, WLAN_SSID_MAXLEN);
+	pwdinfo->nego_ssidlen =3D 0;
+
+	pwdinfo->ui_got_wps_info =3D P2P_NO_WPSINFO;
+#ifdef CONFIG_WFD
+	pwdinfo->supported_wps_cm =3D WPS_CONFIG_METHOD_DISPLAY  | WPS_CONFIG_MET=
HOD_PBC;
