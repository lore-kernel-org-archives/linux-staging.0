+/**
+ * wpa_sm_get_mib - Dump text list of MIB entries
+ * @sm: Pointer to WPA state machine data from wpa_sm_init()
+ * @buf: Buffer for the list
+ * @buflen: Length of the buffer
+ * Returns: Number of bytes written to buffer
+ *
+ * This function is used fetch dot11 MIB variables.
+ */
+int wpa_sm_get_mib(struct wpa_sm *sm, char *buf, size_t buflen)
+{
+	char pmkid_txt[PMKID_LEN * 2 + 1];
+	int rsna, ret;
+	size_t len;
+
+	if (sm->cur_pmksa) {
+		wpa_snprintf_hex(pmkid_txt, sizeof(pmkid_txt),
+				 sm->cur_pmksa->pmkid, PMKID_LEN);
+	} else
+		pmkid_txt[0] =3D '\0';
+
+	if ((wpa_key_mgmt_wpa_psk(sm->key_mgmt) ||
+	     wpa_key_mgmt_wpa_ieee8021x(sm->key_mgmt)) &&
+	    sm->proto =3D=3D WPA_PROTO_RSN)
+		rsna =3D 1;
+	else
+		rsna =3D 0;
+
+	ret =3D os_snprintf(buf, buflen,
+			  "dot11RSNAOptionImplemented=3DTRUE\n"
+			  "dot11RSNAPreauthenticationImplemented=3DTRUE\n"
+			  "dot11RSNAEnabled=3D%s\n"
+			  "dot11RSNAPreauthenticationEnabled=3D%s\n"
+			  "dot11RSNAConfigVersion=3D%d\n"
+			  "dot11RSNAConfigPairwiseKeysSupported=3D5\n"
+			  "dot11RSNAConfigGroupCipherSize=3D%d\n"
+			  "dot11RSNAConfigPMKLifetime=3D%d\n"
+			  "dot11RSNAConfigPMKReauthThreshold=3D%d\n"
+			  "dot11RSNAConfigNumberOfPTKSAReplayCounters=3D1\n"
+			  "dot11RSNAConfigSATimeout=3D%d\n",
+			  rsna ? "TRUE" : "FALSE",
+			  rsna ? "TRUE" : "FALSE",
+			  RSN_VERSION,
+			  wpa_cipher_bits(sm->group_cipher),
+			  sm->dot11RSNAConfigPMKLifetime,
+			  sm->dot11RSNAConfigPMKReauthThreshold,
+			  sm->dot11RSNAConfigSATimeout);
+	if (ret < 0 || (size_t) ret >=3D buflen)
+		return 0;
+	len =3D ret;
+
+	ret =3D os_snprintf(
+		buf + len, buflen - len,
+		"dot11RSNAAuthenticationSuiteSelected=3D" RSN_SUITE "\n"
+		"dot11RSNAPairwiseCipherSelected=3D" RSN_SUITE "\n"
+		"dot11RSNAGroupCipherSelected=3D" RSN_SUITE "\n"
+		"dot11RSNAPMKIDUsed=3D%s\n"
+		"dot11RSNAAuthenticationSuiteRequested=3D" RSN_SUITE "\n"
+		"dot11RSNAPairwiseCipherRequested=3D" RSN_SUITE "\n"
+		"dot11RSNAGroupCipherRequested=3D" RSN_SUITE "\n"
+		"dot11RSNAConfigNumberOfGTKSAReplayCounters=3D0\n"
+		"dot11RSNA4WayHandshakeFailures=3D%u\n",
+		RSN_SUITE_ARG(wpa_key_mgmt_suite(sm)),
+		RSN_SUITE_ARG(wpa_cipher_suite(sm, sm->pairwise_cipher)),
+		RSN_SUITE_ARG(wpa_cipher_suite(sm, sm->group_cipher)),
+		pmkid_txt,
+		RSN_SUITE_ARG(wpa_key_mgmt_suite(sm)),
+		RSN_SUITE_ARG(wpa_cipher_suite(sm, sm->pairwise_cipher)),
+		RSN_SUITE_ARG(wpa_cipher_suite(sm, sm->group_cipher)),
+		sm->dot11RSNA4WayHandshakeFailures);
+	if (ret >=3D 0 && (size_t) ret < buflen)
+		len +=3D ret;
+
+	return (int) len;
+}
