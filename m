+	if (sme->crypto.n_akm_suites) {
+		ret =3D rtw_cfg80211_set_key_mgt(psecuritypriv, sme->crypto.akm_suites[0=
]);
+		if (ret < 0)
+			goto cancel_ps_deny;
+	}
+#ifdef CONFIG_8011R
+	else {
+		/*It could be a connection without RSN IEs*/
+		psecuritypriv->rsn_akm_suite_type =3D 0;
+	}
+#endif
+
+#ifdef CONFIG_WAPI_SUPPORT
+	if (sme->crypto.akm_suites[0] =3D=3D WLAN_AKM_SUITE_WAPI_PSK)
+		padapter->wapiInfo.bWapiPSK =3D true;
+	else if (sme->crypto.akm_suites[0] =3D=3D WLAN_AKM_SUITE_WAPI_CERT)
+		padapter->wapiInfo.bWapiPSK =3D false;
+#endif
+
+	authmode =3D psecuritypriv->ndisauthtype;
+	rtw_set_802_11_authentication_mode(padapter, authmode);
+
+	/* rtw_set_802_11_encryption_mode(padapter, padapter->securitypriv.ndisen=
cryptstatus); */
+
+	if (rtw_set_802_11_connect(padapter, (u8 *)sme->bssid, &ndis_ssid) =3D=3D=
 false) {
+		ret =3D -1;
+		goto cancel_ps_deny;
+	}
+
+	RTW_INFO("set ssid:dot11AuthAlgrthm=3D%d, dot11PrivacyAlgrthm=3D%d, dot11=
8021XGrpPrivacy=3D%d\n", psecuritypriv->dot11AuthAlgrthm, psecuritypriv->do=
t11PrivacyAlgrthm,
+		psecuritypriv->dot118021XGrpPrivacy);
+
+cancel_ps_deny:
+	rtw_ps_deny_cancel(padapter, PS_DENY_JOIN);
+
+exit:
+	RTW_INFO("<=3D%s, ret %d\n", __func__, ret);
+
+#ifdef SUPPLICANT_RTK_VERSION_LOWER_THAN_JB42
+	padapter->mlmepriv.not_indic_disco =3D false;
+#endif
+
+	return ret;
+}
