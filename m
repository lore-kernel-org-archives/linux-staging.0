+bool	beamforming_init_entry(PADAPTER	adapter, struct sta_info *psta, u8 *i=
dx)
+{
+	struct mlme_priv	*pmlmepriv =3D &(adapter->mlmepriv);
+	struct ht_priv		*phtpriv =3D &(pmlmepriv->htpriv);
+	struct mlme_ext_priv	*pmlmeext =3D &(adapter->mlmeextpriv);
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	struct beamforming_entry	*pBeamformEntry =3D NULL;
+	u8	*ra;
+	u16	aid, mac_id;
+	u8	wireless_mode;
+	CHANNEL_WIDTH	bw =3D CHANNEL_WIDTH_20;
+	BEAMFORMING_CAP	beamform_cap =3D BEAMFORMING_CAP_NONE;
+
+	/* The current setting does not support Beaforming */
+	if (0 =3D=3D phtpriv->beamform_cap) {
+		RTW_INFO("The configuration disabled Beamforming! Skip...\n");
+		return false;
+	}
+
+	aid =3D psta->aid;
+	ra =3D psta->hwaddr;
+	mac_id =3D psta->mac_id;
+	wireless_mode =3D psta->wireless_mode;
+	bw =3D psta->bw_mode;
+
+	if (is_supported_ht(wireless_mode) || is_supported_vht(wireless_mode)) {
+		/* 3 */ /* HT */
+		u8	cur_beamform;
+
+		cur_beamform =3D psta->htpriv.beamform_cap;
+
+		/* We are Beamformee because the STA is Beamformer */
+		if (TEST_FLAG(cur_beamform, BEAMFORMING_HT_BEAMFORMER_ENABLE))
+			beamform_cap =3D (BEAMFORMING_CAP)(beamform_cap | BEAMFORMEE_CAP_HT_EXP=
LICIT);
+
+		/* We are Beamformer because the STA is Beamformee */
+		if (TEST_FLAG(cur_beamform, BEAMFORMING_HT_BEAMFORMEE_ENABLE))
+			beamform_cap =3D (BEAMFORMING_CAP)(beamform_cap | BEAMFORMER_CAP_HT_EXP=
LICIT);
+
+		if (beamform_cap =3D=3D BEAMFORMING_CAP_NONE)
+			return false;
+
+		RTW_INFO("Beamforming Config Capability =3D 0x%02X\n", beamform_cap);
+
+		pBeamformEntry =3D beamforming_get_entry_by_addr(pmlmepriv, ra, idx);
+		if (pBeamformEntry =3D=3D NULL) {
+			pBeamformEntry =3D beamforming_add_entry(adapter, ra, aid, mac_id, bw, =
beamform_cap, idx);
+			if (pBeamformEntry =3D=3D NULL)
+				return false;
+			else
+				pBeamformEntry->beamforming_entry_state =3D BEAMFORMING_ENTRY_STATE_IN=
ITIALIZEING;
+		} else {
+			/* Entry has been created. If entry is initialing or progressing then e=
rrors occur. */
+			if (pBeamformEntry->beamforming_entry_state !=3D BEAMFORMING_ENTRY_STAT=
E_INITIALIZED &&
+			    pBeamformEntry->beamforming_entry_state !=3D BEAMFORMING_ENTRY_STAT=
E_PROGRESSED) {
+				RTW_INFO("Error State of Beamforming");
+				return false;
+			} else
+				pBeamformEntry->beamforming_entry_state =3D BEAMFORMING_ENTRY_STATE_IN=
ITIALIZEING;
+		}
+
+		pBeamformEntry->beamforming_entry_state =3D BEAMFORMING_ENTRY_STATE_INIT=
IALIZED;
+		psta->txbf_paid =3D pBeamformEntry->p_aid;
+		psta->txbf_gid =3D pBeamformEntry->g_id;
+
+		RTW_INFO("%s Idx %d\n", __func__, *idx);
+	} else
+		return false;
+
+	return _SUCCESS;
+}
