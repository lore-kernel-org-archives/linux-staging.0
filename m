+static int hostapd_ctrl_iface_sta_mib(struct hostapd_data *hapd,
+				      struct sta_info *sta,
+				      char *buf, size_t buflen)
+{
+	int len, res, ret;
+
+	if (sta =3D=3D NULL) {
+		ret =3D os_snprintf(buf, buflen, "FAIL\n");
+		if (ret < 0 || (size_t) ret >=3D buflen)
+			return 0;
+		return ret;
+	}
+
+	len =3D 0;
+	ret =3D os_snprintf(buf + len, buflen - len, MACSTR "\n",
+			  MAC2STR(sta->addr));
+	if (ret < 0 || (size_t) ret >=3D buflen - len)
+		return len;
+	len +=3D ret;
+
+	res =3D ieee802_11_get_mib_sta(hapd, sta, buf + len, buflen - len);
+	if (res >=3D 0)
+		len +=3D res;
+	res =3D wpa_get_mib_sta(sta->wpa_sm, buf + len, buflen - len);
+	if (res >=3D 0)
+		len +=3D res;
+	res =3D ieee802_1x_get_mib_sta(hapd, sta, buf + len, buflen - len);
+	if (res >=3D 0)
+		len +=3D res;
+	res =3D hostapd_wps_get_mib_sta(hapd, sta->addr, buf + len,
+				      buflen - len);
+	if (res >=3D 0)
+		len +=3D res;
+	res =3D hostapd_p2p_get_mib_sta(hapd, sta, buf + len, buflen - len);
+	if (res >=3D 0)
+		len +=3D res;
+
+	return len;
+}
