+static int rtw_os_ndevs_register(struct dvobj_priv *dvobj)
+{
+	int i, status =3D _SUCCESS;
+	struct registry_priv *regsty =3D dvobj_to_regsty(dvobj);
+	_adapter *adapter;
+
+#if defined(CONFIG_IOCTL_CFG80211)
+	if (rtw_cfg80211_dev_res_register(dvobj) !=3D _SUCCESS) {
+		rtw_warn_on(1);
+		status =3D _FAIL;
+		goto exit;
+	}
+#endif
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+
+		if (i >=3D CONFIG_IFACE_NUMBER) {
+			RTW_ERR("%s %d >=3D CONFIG_IFACE_NUMBER(%d)\n", __func__, i, CONFIG_IFA=
CE_NUMBER);
+			rtw_warn_on(1);
+			continue;
+		}
+
+		adapter =3D dvobj->padapters[i];
+		if (adapter) {
+			char *name;
+
+			#ifdef CONFIG_RTW_DYNAMIC_NDEV
+			if (!is_primary_adapter(adapter))
+				continue;
+			#endif
+
+			if (adapter->iface_id =3D=3D IFACE_ID0)
+				name =3D regsty->ifname;
+			else if (adapter->iface_id =3D=3D IFACE_ID1)
+				name =3D regsty->if2name;
+			else
+				name =3D "wlan%d";
+
+			status =3D rtw_os_ndev_register(adapter, name);
+
+			if (status !=3D _SUCCESS) {
+				rtw_warn_on(1);
+				break;
+			}
+		}
+	}
+
+	if (status !=3D _SUCCESS) {
+		for (; i >=3D 0; i--) {
+			adapter =3D dvobj->padapters[i];
+			if (adapter)
+				rtw_os_ndev_unregister(adapter);
+		}
+	}
+
+#if defined(CONFIG_IOCTL_CFG80211)
+	if (status !=3D _SUCCESS)
+		rtw_cfg80211_dev_res_unregister(dvobj);
+#endif
+exit:
+	return status;
+}
+
+void rtw_os_ndevs_unregister(struct dvobj_priv *dvobj)
+{
+	int i;
+	_adapter *adapter =3D NULL;
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+		adapter =3D dvobj->padapters[i];
+
+		if (adapter =3D=3D NULL)
+			continue;
+
+		rtw_os_ndev_unregister(adapter);
+	}
+
+#if defined(CONFIG_IOCTL_CFG80211)
+	rtw_cfg80211_dev_res_unregister(dvobj);
+#endif
+}
