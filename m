+void
+phy_lc_calibrate_8188e(
+	void		*p_dm_void
+)
+{
+	bool		is_start_cont_tx =3D false, is_single_tone =3D false, is_carrier_su=
ppression =3D false;
+	u32			timeout =3D 2000, timecount =3D 0;
+	u32			start_time;
+	s32			progressing_time;
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+
+	struct _ADAPTER	*p_adapter =3D p_dm_odm->adapter;
+	/* HAL_DATA_TYPE	*p_hal_data =3D GET_HAL_DATA(p_adapter); */
+
+#if (MP_DRIVER =3D=3D 1)
+	PMPT_CONTEXT	p_mpt_ctx =3D &(p_adapter->mppriv.mpt_ctx);
+
+	if (p_dm_odm->mp_mode =3D=3D true) {
+		is_start_cont_tx =3D p_mpt_ctx->is_start_cont_tx;
+		is_single_tone =3D p_mpt_ctx->is_single_tone;
+		is_carrier_suppression =3D p_mpt_ctx->is_carrier_suppression;
+	}
+#endif
+
+#if DISABLE_BB_RF
+	return;
+#endif
+
+	if (!(p_dm_odm->support_ability & ODM_RF_CALIBRATION))
+		return;
+	/* 20120213<Kordan> Turn on when continuous Tx to pass lab testing. (requ=
ired by Edlu) */
+	if (is_single_tone || is_carrier_suppression)
+		return;
+
+	start_time =3D odm_get_current_time(p_dm_odm);
+	while (*(p_dm_odm->p_is_scan_in_process) && timecount < timeout) {
+		ODM_delay_ms(50);
+		timecount +=3D 50;
+	}
+
+	p_dm_odm->rf_calibrate_info.is_lck_in_progress =3D true;
+
+	/* ODM_RT_TRACE(p_dm_odm,ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("LCK:Start!=
!!interface %d currentband %x delay %d ms\n", p_dm_odm->interface_index, p_=
hal_data->CurrentBandType92D, timecount)); */
+	_phy_lc_calibrate_8188e(p_dm_odm, false);
+
+	p_dm_odm->rf_calibrate_info.is_lck_in_progress =3D false;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("LCK:Finish!!=
!interface %d\n", p_dm_odm->interface_index));
+	progressing_time =3D odm_get_progressing_time(p_dm_odm, start_time);
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("LCK progress=
ing_time =3D %d\n", progressing_time));
+}
