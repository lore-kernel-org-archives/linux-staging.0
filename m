+	_adapter *padapter;
+	struct dvobj_priv *dvobj =3D wiphy_to_dvobj(wiphy);
+
+	rtw_set_rtnl_lock_holder(dvobj, current);
+
+	RTW_INFO(FUNC_WIPHY_FMT" name:%s, type:%d\n", FUNC_WIPHY_ARG(wiphy), name=
, type);
+
+	switch (type) {
+	case NL80211_IFTYPE_MONITOR:
