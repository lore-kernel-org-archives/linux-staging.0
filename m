+		ndisencryptstatus =3D Ndis802_11Encryption3Enabled;
+		break;
+#ifdef CONFIG_WAPI_SUPPORT
+	case WLAN_CIPHER_SUITE_SMS4:
+		*profile_cipher =3D _SMS4_;
+		ndisencryptstatus =3D Ndis802_11_EncrypteionWAPI;
+		break;
+#endif
+	default:
+		RTW_INFO("Unsupported cipher: 0x%x\n", cipher);
+		return -ENOTSUPP;
+	}
+
+	if (ucast) {
+		psecuritypriv->ndisencryptstatus =3D ndisencryptstatus;
+
+		/* if(psecuritypriv->dot11PrivacyAlgrthm >=3D _AES_) */
+		/*	psecuritypriv->ndisauthtype =3D Ndis802_11AuthModeWPA2PSK; */
+	}
+
+	return 0;
