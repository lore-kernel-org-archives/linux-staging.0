+		if (fgets(rc->buf, rc->buf_len, rc->f) =3D=3D NULL)
+			return -1;
+	} else {
+		const char *l_end;
+		size_t len;
+		if (rc->pos >=3D rc->end)
+			return -1;
+		l_end =3D rc->pos;
+		while (l_end < rc->end && *l_end !=3D '\n')
+			l_end++;
+		len =3D l_end - rc->pos;
+		if (len >=3D rc->buf_len)
+			len =3D rc->buf_len - 1;
+		os_memcpy(rc->buf, rc->pos, len);
