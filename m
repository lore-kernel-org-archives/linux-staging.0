+int rtw_suspend_free_assoc_resource(_adapter *padapter)
+{
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+	struct net_device *pnetdev =3D padapter->pnetdev;
+#ifdef CONFIG_P2P
+	struct wifidirect_info	*pwdinfo =3D &padapter->wdinfo;
