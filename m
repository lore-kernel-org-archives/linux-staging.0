+static int eap_wsc_new_ap_settings(struct wps_credential *cred,
+				   const char *params)
+{
+	const char *pos, *end;
+	size_t len;
+
+	os_memset(cred, 0, sizeof(*cred));
+
+	pos =3D os_strstr(params, "new_ssid=3D");
+	if (pos =3D=3D NULL)
+		return 0;
+	pos +=3D 9;
+	end =3D os_strchr(pos, ' ');
+	if (end =3D=3D NULL)
+		len =3D os_strlen(pos);
+	else
+		len =3D end - pos;
+	if ((len & 1) || len > 2 * sizeof(cred->ssid) ||
+	    hexstr2bin(pos, cred->ssid, len / 2))
+		return -1;
+	cred->ssid_len =3D len / 2;
+
+	pos =3D os_strstr(params, "new_auth=3D");
+	if (pos =3D=3D NULL)
+		return -1;
+	if (os_strncmp(pos + 9, "OPEN", 4) =3D=3D 0)
+		cred->auth_type =3D WPS_AUTH_OPEN;
+	else if (os_strncmp(pos + 9, "WPAPSK", 6) =3D=3D 0)
+		cred->auth_type =3D WPS_AUTH_WPAPSK;
+	else if (os_strncmp(pos + 9, "WPA2PSK", 7) =3D=3D 0)
+		cred->auth_type =3D WPS_AUTH_WPA2PSK;
+	else
+		return -1;
+
+	pos =3D os_strstr(params, "new_encr=3D");
+	if (pos =3D=3D NULL)
+		return -1;
+	if (os_strncmp(pos + 9, "NONE", 4) =3D=3D 0)
+		cred->encr_type =3D WPS_ENCR_NONE;
+	else if (os_strncmp(pos + 9, "WEP", 3) =3D=3D 0)
+		cred->encr_type =3D WPS_ENCR_WEP;
+	else if (os_strncmp(pos + 9, "TKIP", 4) =3D=3D 0)
+		cred->encr_type =3D WPS_ENCR_TKIP;
+	else if (os_strncmp(pos + 9, "CCMP", 4) =3D=3D 0)
+		cred->encr_type =3D WPS_ENCR_AES;
+	else
+		return -1;
+
+	pos =3D os_strstr(params, "new_key=3D");
+	if (pos =3D=3D NULL)
+		return 0;
+	pos +=3D 8;
+	end =3D os_strchr(pos, ' ');
+	if (end =3D=3D NULL)
+		len =3D os_strlen(pos);
+	else
+		len =3D end - pos;
+	if ((len & 1) || len > 2 * sizeof(cred->key) ||
+	    hexstr2bin(pos, cred->key, len / 2))
+		return -1;
+	cred->key_len =3D len / 2;
+
+	return 1;
+}
