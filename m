+
+static void hostapd_mgmt_rx(struct hostapd_data *hapd, struct rx_mgmt *rx_=
mgmt)
+{
+	struct hostapd_iface *iface =3D hapd->iface;
+	const struct ieee80211_hdr *hdr;
+	const u8 *bssid;
+	struct hostapd_frame_info fi;
+
+	hdr =3D (const struct ieee80211_hdr *) rx_mgmt->frame;
+	bssid =3D get_hdr_bssid(hdr, rx_mgmt->frame_len);
+	if (bssid =3D=3D NULL)
+		return;
+
+	hapd =3D get_hapd_bssid(iface, bssid);
+	if (hapd =3D=3D NULL) {
+		u16 fc;
+		fc =3D le_to_host16(hdr->frame_control);
+
+		/*
+		 * Drop frames to unknown BSSIDs except for Beacon frames which
+		 * could be used to update neighbor information.
+		 */
+		if (WLAN_FC_GET_TYPE(fc) =3D=3D WLAN_FC_TYPE_MGMT &&
+		    WLAN_FC_GET_STYPE(fc) =3D=3D WLAN_FC_STYPE_BEACON)
+			hapd =3D iface->bss[0];
+		else
+			return;
+	}
+
+	os_memset(&fi, 0, sizeof(fi));
+	fi.datarate =3D rx_mgmt->datarate;
+	fi.ssi_signal =3D rx_mgmt->ssi_signal;
+
+	if (hapd =3D=3D HAPD_BROADCAST) {
+		size_t i;
+		for (i =3D 0; i < iface->num_bss; i++)
+			ieee802_11_mgmt(iface->bss[i], rx_mgmt->frame,
+					rx_mgmt->frame_len, &fi);
+	} else
+		ieee802_11_mgmt(hapd, rx_mgmt->frame, rx_mgmt->frame_len, &fi);
+
+	random_add_randomness(&fi, sizeof(fi));
+}
