+				ePA/eLNA sel.(ePA+eLNA=3D0x0, ePA+iLNA enable =3D 0x1, iPA+eLNA enable=
 =3D0x2, iPA+iLNA=3D0x3)
+			*/
+			switch (PA_LNAType_2G) {
+			case 0:
+				pHalData->ExternalPA_2G  =3D 1;
+				pHalData->ExternalLNA_2G =3D 1;
+				break;
+			case 1:
+				pHalData->ExternalPA_2G  =3D 1;
+				pHalData->ExternalLNA_2G =3D 0;
+				break;
+			case 2:
+				pHalData->ExternalPA_2G  =3D 0;
+				pHalData->ExternalLNA_2G =3D 1;
+				break;
+			case 3:
+			default:
+				pHalData->ExternalPA_2G  =3D 0;
+				pHalData->ExternalLNA_2G =3D 0;
+				break;
+			}
+		} else {
+			pHalData->ExternalPA_2G  =3D (GetRegAmplifierType2G(Adapter) & ODM_BOAR=
D_EXT_PA)  ? 1 : 0;
+			pHalData->ExternalLNA_2G =3D (GetRegAmplifierType2G(Adapter) & ODM_BOAR=
D_EXT_LNA) ? 1 : 0;
+		}
+	} else {
+		pHalData->ExternalPA_2G  =3D EEPROM_Default_PAType;
+		pHalData->external_pa_5g  =3D EEPROM_Default_PAType;
+		pHalData->ExternalLNA_2G =3D EEPROM_Default_LNAType;
+		pHalData->external_lna_5g =3D EEPROM_Default_LNAType;
+
+		if (GetRegAmplifierType2G(Adapter) =3D=3D 0) {
+			/* AUTO*/
+			pHalData->ExternalPA_2G  =3D EEPROM_Default_PAType;
+			pHalData->ExternalLNA_2G =3D EEPROM_Default_LNAType;
+		} else {
+			pHalData->ExternalPA_2G  =3D (GetRegAmplifierType2G(Adapter) & ODM_BOAR=
D_EXT_PA)  ? 1 : 0;
+			pHalData->ExternalLNA_2G =3D (GetRegAmplifierType2G(Adapter) & ODM_BOAR=
D_EXT_LNA) ? 1 : 0;
