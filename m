+		ctr_preload[i] =3D 0x00;
+	i =3D 0;
+
+	ctr_preload[0] =3D 0x01;                                  /* flag */
+	if (qc_exists && a4_exists)
+		ctr_preload[1] =3D mpdu[30] & 0x0f;   /* QoC_Control */
+	if (qc_exists && !a4_exists)
+		ctr_preload[1] =3D mpdu[24] & 0x0f;
+#ifdef CONFIG_IEEE80211W
+	/* 802.11w management frame should set management bit(4) */
+	if (frtype =3D=3D WIFI_MGT_TYPE)
+		ctr_preload[1] |=3D BIT(4);
+#endif /* CONFIG_IEEE80211W */
+	for (i =3D 2; i < 8; i++)
+		ctr_preload[i] =3D mpdu[i + 8];                       /* ctr_preload[2:7=
] =3D A2[0:5] =3D mpdu[10:15] */
+#ifdef CONSISTENT_PN_ORDER
+	for (i =3D 8; i < 14; i++)
+		ctr_preload[i] =3D    pn_vector[i - 8];           /* ctr_preload[8:13] =
=3D PN[0:5] */
+#else
+	for (i =3D 8; i < 14; i++)
+		ctr_preload[i] =3D    pn_vector[13 - i];          /* ctr_preload[8:13] =
=3D PN[5:0] */
+#endif
+	ctr_preload[14] =3D (unsigned char)(c / 256);   /* Ctr */
+	ctr_preload[15] =3D (unsigned char)(c % 256);
+}
