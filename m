+int rtw_parse_cipher_list(struct pno_nlo_info *nlo_info, char *list_str)
+{
+
+	char *pch, *pnext, *pend;
+	u8 key_len =3D 0, index =3D 0;
+
+	pch =3D list_str;
+
+	if (nlo_info =3D=3D NULL || list_str =3D=3D NULL) {
+		RTW_INFO("%s error paramters\n", __func__);
+		return -1;
+	}
+
+	while (strlen(pch) !=3D 0) {
+		pnext =3D strstr(pch, "key_mgmt=3D");
+		if (pnext !=3D NULL) {
+			pch =3D pnext + strlen(CIPHER_IE);
+			pend =3D strstr(pch, "}");
+			if (strncmp(pch, CIPHER_NONE,
+				    strlen(CIPHER_NONE)) =3D=3D 0)
+				nlo_info->ssid_cipher_info[index] =3D 0x00;
+			else if (strncmp(pch, CIPHER_WPA_PSK,
+					 strlen(CIPHER_WPA_PSK)) =3D=3D 0)
+				nlo_info->ssid_cipher_info[index] =3D 0x66;
+			else if (strncmp(pch, CIPHER_WPA_EAP,
+					 strlen(CIPHER_WPA_EAP)) =3D=3D 0)
+				nlo_info->ssid_cipher_info[index] =3D 0x01;
+			index++;
+			pch =3D pend + 1;
+		} else
+			break;
+	}
+	return 0;
