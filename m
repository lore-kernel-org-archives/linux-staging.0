+		else
+			cck_gp =3D gp;
+	} else {
+		band =3D BAND_ON_5G;
+
+		if (36 <=3D ch && ch <=3D 42)
+			gp =3D 0;
+		else if (44   <=3D ch && ch <=3D  48)
+			gp =3D 1;
+		else if (50   <=3D ch && ch <=3D  58)
+			gp =3D 2;
+		else if (60   <=3D ch && ch <=3D  64)
+			gp =3D 3;
+		else if (100  <=3D ch && ch <=3D 106)
+			gp =3D 4;
+		else if (108  <=3D ch && ch <=3D 114)
+			gp =3D 5;
+		else if (116  <=3D ch && ch <=3D 122)
+			gp =3D 6;
+		else if (124  <=3D ch && ch <=3D 130)
+			gp =3D 7;
+		else if (132  <=3D ch && ch <=3D 138)
