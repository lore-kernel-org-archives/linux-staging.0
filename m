+
+static void eap_peap_deinit_for_reauth(struct eap_sm *sm, void *priv)
+{
+	struct eap_peap_data *data =3D priv;
+	wpabuf_free(data->pending_phase2_req);
+	data->pending_phase2_req =3D NULL;
+	data->crypto_binding_used =3D 0;
+}
+
+
+static void * eap_peap_init_for_reauth(struct eap_sm *sm, void *priv)
+{
+	struct eap_peap_data *data =3D priv;
+	os_free(data->key_data);
+	data->key_data =3D NULL;
+	if (eap_peer_tls_reauth_init(sm, &data->ssl)) {
+		os_free(data);
+		return NULL;
+	}
+	if (data->phase2_priv && data->phase2_method &&
+	    data->phase2_method->init_for_reauth)
+		data->phase2_method->init_for_reauth(sm, data->phase2_priv);
+	data->phase2_success =3D 0;
+	data->phase2_eap_success =3D 0;
+	data->phase2_eap_started =3D 0;
+	data->resuming =3D 1;
+	data->reauth =3D 1;
+	sm->peap_done =3D FALSE;
+	return priv;
+}
+
+
+static int eap_peap_get_status(struct eap_sm *sm, void *priv, char *buf,
+			       size_t buflen, int verbose)
+{
+	struct eap_peap_data *data =3D priv;
+	int len, ret;
+
+	len =3D eap_peer_tls_status(sm, &data->ssl, buf, buflen, verbose);
+	if (data->phase2_method) {
+		ret =3D os_snprintf(buf + len, buflen - len,
+				  "EAP-PEAPv%d Phase2 method=3D%s\n",
+				  data->peap_version,
+				  data->phase2_method->name);
+		if (ret < 0 || (size_t) ret >=3D buflen - len)
+			return len;
+		len +=3D ret;
+	}
+	return len;
+}
+
+
+static Boolean eap_peap_isKeyAvailable(struct eap_sm *sm, void *priv)
+{
+	struct eap_peap_data *data =3D priv;
+	return data->key_data !=3D NULL && data->phase2_success;
+}
+
+
+static u8 * eap_peap_getKey(struct eap_sm *sm, void *priv, size_t *len)
+{
+	struct eap_peap_data *data =3D priv;
+	u8 *key;
+
+	if (data->key_data =3D=3D NULL || !data->phase2_success)
+		return NULL;
+
+	key =3D os_malloc(EAP_TLS_KEY_LEN);
+	if (key =3D=3D NULL)
+		return NULL;
+
+	*len =3D EAP_TLS_KEY_LEN;
+
+	if (data->crypto_binding_used) {
+		u8 csk[128];
+		/*
+		 * Note: It looks like Microsoft implementation requires null
+		 * termination for this label while the one used for deriving
+		 * IPMK|CMK did not use null termination.
+		 */
+		peap_prfplus(data->peap_version, data->ipmk, 40,
+			     "Session Key Generating Function",
+			     (u8 *) "\00", 1, csk, sizeof(csk));
+		wpa_hexdump_key(MSG_DEBUG, "EAP-PEAP: CSK", csk, sizeof(csk));
+		os_memcpy(key, csk, EAP_TLS_KEY_LEN);
+		wpa_hexdump(MSG_DEBUG, "EAP-PEAP: Derived key",
+			    key, EAP_TLS_KEY_LEN);
+	} else
+		os_memcpy(key, data->key_data, EAP_TLS_KEY_LEN);
+
+	return key;
+}
+
+
+int eap_peer_peap_register(void)
+{
+	struct eap_method *eap;
+	int ret;
+
+	eap =3D eap_peer_method_alloc(EAP_PEER_METHOD_INTERFACE_VERSION,
+				    EAP_VENDOR_IETF, EAP_TYPE_PEAP, "PEAP");
+	if (eap =3D=3D NULL)
+		return -1;
+
+	eap->init =3D eap_peap_init;
+	eap->deinit =3D eap_peap_deinit;
+	eap->process =3D eap_peap_process;
+	eap->isKeyAvailable =3D eap_peap_isKeyAvailable;
+	eap->getKey =3D eap_peap_getKey;
+	eap->get_status =3D eap_peap_get_status;
+	eap->has_reauth_data =3D eap_peap_has_reauth_data;
+	eap->deinit_for_reauth =3D eap_peap_deinit_for_reauth;
+	eap->init_for_reauth =3D eap_peap_init_for_reauth;
+
+	ret =3D eap_peer_method_register(eap);
+	if (ret)
+		eap_peer_method_free(eap);
+	return ret;
+}
