+	/* dbg_print("reg908 =3D 0x%x\n",val); */
+	/* val =3D phy_query_bb_reg(adapter,0xDF4, MASKDWORD); */
+	/* rfval =3D phy_query_rf_reg(adapter, ODM_RF_PATH_A, 0x00, RFREGOFFSETMA=
SK); */
+	/* dbg_print("RegDF4 =3D 0x%x, RFReg00 =3D 0x%x\n",val, rfval); */
+	/* dbg_print("PHYTXON =3D %x, OFDMCCA_PP =3D %x, CCKCCA_PP =3D %x, RFReg0=
0 =3D %x\n", */
+	/* (val&BIT25)>>25, (val&BIT14)>>14, (val&BIT15)>>15, rfval); */
+
+	/* Set DCO frequency index, offset=3D(40MHz/SamplePts)*point */
+	odm_set_bb_reg(p_dm_odm, 0x808, 0x3FF, point);
+
+	/* Start PSD calculation, Reg808[22]=3D0->1 */
+	odm_set_bb_reg(p_dm_odm, 0x808, BIT(22), 1);
+	/* Need to wait for HW PSD report */
+	odm_stall_execution(1000);
+	odm_set_bb_reg(p_dm_odm, 0x808, BIT(22), 0);
+	/* Read PSD report, Reg8B4[15:0] */
+	psd_report =3D odm_get_bb_reg(p_dm_odm, 0x8B4, MASKDWORD) & 0x0000FFFF;
+
+	psd_report =3D (u32)(odm_convert_to_db(psd_report)) + (u32)(initial_gain_=
psd - 0x1c);
+
+	return psd_report;
+}
