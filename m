+char * os_rel2abs_path(const char *rel_path)
+{
+	char *buf =3D NULL, *cwd, *ret;
+	size_t len =3D 128, cwd_len, rel_len, ret_len;
+	int last_errno;
+
+	if (rel_path[0] =3D=3D '/')
+		return os_strdup(rel_path);
+
+	for (;;) {
+		buf =3D os_malloc(len);
+		if (buf =3D=3D NULL)
+			return NULL;
+		cwd =3D getcwd(buf, len);
+		if (cwd =3D=3D NULL) {
+			last_errno =3D errno;
+			os_free(buf);
+			if (last_errno !=3D ERANGE)
+				return NULL;
+			len *=3D 2;
+			if (len > 2000)
+				return NULL;
+		} else {
+			buf[len - 1] =3D '\0';
+			break;
+		}
+	}
+
+	cwd_len =3D os_strlen(cwd);
+	rel_len =3D os_strlen(rel_path);
+	ret_len =3D cwd_len + 1 + rel_len + 1;
+	ret =3D os_malloc(ret_len);
+	if (ret) {
+		os_memcpy(ret, cwd, cwd_len);
+		ret[cwd_len] =3D '/';
+		os_memcpy(ret + cwd_len + 1, rel_path, rel_len);
+		ret[ret_len - 1] =3D '\0';
+	}
+	os_free(buf);
+	return ret;
