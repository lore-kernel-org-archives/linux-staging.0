+static void
+odm_pt_decision_8188e(
+	struct _odm_ra_info_	*p_ra_info
+)
+{
+	u8 stage_BUF;
+	u8 j;
+	u8 temp_stage;
+	u32 numsc;
+	u32 num_total;
+	u8 stage_id;
+
+	stage_BUF =3D p_ra_info->pt_stage;
+	numsc  =3D 0;
+	num_total =3D p_ra_info->TOTAL * PT_PENALTY[5];
+	for (j =3D 0; j <=3D 4; j++) {
+		numsc +=3D p_ra_info->RTY[j] * PT_PENALTY[j];
+		if (numsc > num_total)
+			break;
+	}
+
+	j =3D j >> 1;
+	temp_stage =3D (p_ra_info->pt_stage + 1) >> 1;
+	if (temp_stage > j)
+		stage_id =3D temp_stage - j;
+	else
+		stage_id =3D 0;
+
+	p_ra_info->pt_smooth_factor =3D (p_ra_info->pt_smooth_factor >> 1) + (p_r=
a_info->pt_smooth_factor >> 2) + stage_id * 16 + 2;
+	if (p_ra_info->pt_smooth_factor > 192)
+		p_ra_info->pt_smooth_factor =3D 192;
+	stage_id =3D p_ra_info->pt_smooth_factor >> 6;
+	temp_stage =3D stage_id * 2;
+	if (temp_stage !=3D 0)
+		temp_stage -=3D 1;
+	if (p_ra_info->DROP > 3)
+		temp_stage =3D 0;
+	p_ra_info->pt_stage =3D temp_stage;
+
