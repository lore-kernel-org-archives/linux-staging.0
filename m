+/* reg 0x808[9:0]: FFT data x
+ * reg 0x808[22]:  0  -->  1  to get 1 FFT data y
+ * reg 0x8B4[15:0]: FFT data y report */
+static u32 rtw_GetPSDData(PADAPTER pAdapter, u32 point)
+{
+	u32 psd_val =3D 0;
+	u16 psd_reg =3D 0x808;
+	u16 psd_regL =3D 0x8B4;
+
+	psd_val =3D rtw_read32(pAdapter, psd_reg);
+
+	psd_val &=3D 0xFFBFFC00;
+	psd_val |=3D point;
+
+	rtw_write32(pAdapter, psd_reg, psd_val);
+	rtw_mdelay_os(1);
+	psd_val |=3D 0x00400000;
+
+	rtw_write32(pAdapter, psd_reg, psd_val);
+	rtw_mdelay_os(1);
+
+	psd_val =3D rtw_read32(pAdapter, psd_regL);
+	psd_val &=3D 0x0000FFFF;
+
+	return psd_val;
+}
