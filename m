+static int amsdu_to_msdu(_adapter *padapter, union recv_frame *prframe)
+{
+	int	a_len, padding_len;
+	u16	nSubframe_Length;
+	u8	nr_subframes, i;
+	u8	*pdata;
+	_pkt *sub_pkt, *subframes[MAX_SUBFRAME_COUNT];
+	struct recv_priv *precvpriv =3D &padapter->recvpriv;
+	_queue *pfree_recv_queue =3D &(precvpriv->free_recv_queue);
+	int	ret =3D _SUCCESS;
+
+	nr_subframes =3D 0;
+
+	recvframe_pull(prframe, prframe->u.hdr.attrib.hdrlen);
+
+	if (prframe->u.hdr.attrib.iv_len > 0)
+		recvframe_pull(prframe, prframe->u.hdr.attrib.iv_len);
+
+	a_len =3D prframe->u.hdr.len;
+
+	pdata =3D prframe->u.hdr.rx_data;
+
+	while (a_len > ETH_HLEN) {
+
+		/* Offset 12 denote 2 mac address */
+		nSubframe_Length =3D RTW_GET_BE16(pdata + 12);
+
+		if (a_len < (ETHERNET_HEADER_SIZE + nSubframe_Length)) {
+			RTW_INFO("nRemain_Length is %d and nSubframe_Length is : %d\n", a_len, =
nSubframe_Length);
+			break;
+		}
+
+		sub_pkt =3D rtw_os_alloc_msdu_pkt(prframe, nSubframe_Length, pdata);
+		if (sub_pkt =3D=3D NULL) {
+			RTW_INFO("%s(): allocate sub packet fail !!!\n", __func__);
+			break;
+		}
+
+		/* move the data point to data content */
+		pdata +=3D ETH_HLEN;
+		a_len -=3D ETH_HLEN;
+
+		subframes[nr_subframes++] =3D sub_pkt;
+
+		if (nr_subframes >=3D MAX_SUBFRAME_COUNT) {
+			RTW_INFO("ParseSubframe(): Too many Subframes! Packets dropped!\n");
+			break;
+		}
+
+		pdata +=3D nSubframe_Length;
+		a_len -=3D nSubframe_Length;
+		if (a_len !=3D 0) {
+			padding_len =3D 4 - ((nSubframe_Length + ETH_HLEN) & (4 - 1));
+			if (padding_len =3D=3D 4)
+				padding_len =3D 0;
+
+			if (a_len < padding_len) {
+				RTW_INFO("ParseSubframe(): a_len < padding_len !\n");
+				break;
+			}
+			pdata +=3D padding_len;
+			a_len -=3D padding_len;
+		}
+	}
+
+	for (i =3D 0; i < nr_subframes; i++) {
+		sub_pkt =3D subframes[i];
+
+		/* Indicat the packets to upper layer */
+		if (sub_pkt)
+			rtw_os_recv_indicate_pkt(padapter, sub_pkt, &prframe->u.hdr.attrib);
+	}
+
+	prframe->u.hdr.len =3D 0;
+	rtw_free_recvframe(prframe, pfree_recv_queue);/* free this recv_frame */
+
+	return ret;
+}
