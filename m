a->rf_type, bw, MimoPs_enable, disable_cck_rate, &ratr_bitmap_msb, &ratr_bi=
tmap_lsb, rssi_level);
+	mask =3D (((u64)ratr_bitmap_msb) << 32) | ((u64)ratr_bitmap_lsb);
