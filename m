+u8 setopmode_hdl(_adapter *padapter, u8 *pbuf)
+{
+	u8	type;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	struct setopmode_parm *psetop =3D (struct setopmode_parm *)pbuf;
+
+	if (psetop->mode =3D=3D Ndis802_11APMode) {
+		pmlmeinfo->state =3D WIFI_FW_AP_STATE;
+		type =3D _HW_STATE_AP_;
+#ifdef CONFIG_NATIVEAP_MLME
+		/* start_ap_mode(padapter); */
+#endif
+	} else if (psetop->mode =3D=3D Ndis802_11Infrastructure) {
+		pmlmeinfo->state &=3D ~(BIT(0) | BIT(1)); /* clear state */
+		pmlmeinfo->state |=3D WIFI_FW_STATION_STATE;/* set to 	STATION_STATE */
+		type =3D _HW_STATE_STATION_;
+	} else if (psetop->mode =3D=3D Ndis802_11IBSS)
+		type =3D _HW_STATE_ADHOC_;
+	else if (psetop->mode =3D=3D Ndis802_11Monitor)
+		type =3D _HW_STATE_MONITOR_;
+	else
+		type =3D _HW_STATE_NOLINK_;
+
+#ifdef CONFIG_AP_PORT_SWAP
+	rtw_hal_set_hwreg(padapter, HW_VAR_PORT_SWITCH, (u8 *)(&type));
+#endif
+
+	rtw_hal_set_hwreg(padapter, HW_VAR_SET_OPMODE, (u8 *)(&type));
+
+#ifdef CONFIG_AUTO_AP_MODE
+	if (psetop->mode =3D=3D Ndis802_11APMode)
+		rtw_auto_ap_start_beacon(padapter);
+#endif
+
+	if (rtw_port_switch_chk(padapter)) {
+		rtw_hal_set_hwreg(padapter, HW_VAR_PORT_SWITCH, NULL);
+
+		if (psetop->mode =3D=3D Ndis802_11APMode)
+			adapter_to_pwrctl(padapter)->fw_psmode_iface_id =3D 0xff; /* ap mode wo=
n't dowload rsvd pages */
+		else if (psetop->mode =3D=3D Ndis802_11Infrastructure) {
+#ifdef CONFIG_LPS
+			_adapter *port0_iface =3D dvobj_get_port0_adapter(adapter_to_dvobj(pada=
pter));
+			if (port0_iface)
+				rtw_lps_ctrl_wk_cmd(port0_iface, LPS_CTRL_CONNECT, 0);
+#endif
+		}
+	}
+
+#ifdef CONFIG_BT_COEXIST
+	if (psetop->mode =3D=3D Ndis802_11APMode ||
+		psetop->mode =3D=3D Ndis802_11Monitor) {
+		/* Do this after port switch to */
+		/* prevent from downloading rsvd page to wrong port */
+		rtw_btcoex_MediaStatusNotify(padapter, 1); /* connect */
+	}
+#endif /* CONFIG_BT_COEXIST */
+
+	return H2C_SUCCESS;
+
+}
