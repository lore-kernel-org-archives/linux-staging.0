+
+	key =3D os_malloc(EAP_EMSK_LEN);
+	if (key =3D=3D NULL)
+		return NULL;
+
+	*len =3D EAP_EMSK_LEN;
+	os_memcpy(key, data->emsk, EAP_EMSK_LEN);
+
+	return key;
+}
+
+
+int eap_peer_sim_register(void)
+{
+	struct eap_method *eap;
+	int ret;
+
+	eap =3D eap_peer_method_alloc(EAP_PEER_METHOD_INTERFACE_VERSION,
+				    EAP_VENDOR_IETF, EAP_TYPE_SIM, "SIM");
+	if (eap =3D=3D NULL)
+		return -1;
+
+	eap->init =3D eap_sim_init;
+	eap->deinit =3D eap_sim_deinit;
+	eap->process =3D eap_sim_process;
+	eap->isKeyAvailable =3D eap_sim_isKeyAvailable;
+	eap->getKey =3D eap_sim_getKey;
+	eap->has_reauth_data =3D eap_sim_has_reauth_data;
+	eap->deinit_for_reauth =3D eap_sim_deinit_for_reauth;
+	eap->init_for_reauth =3D eap_sim_init_for_reauth;
+	eap->get_identity =3D eap_sim_get_identity;
+	eap->get_emsk =3D eap_sim_get_emsk;
+
+	ret =3D eap_peer_method_register(eap);
