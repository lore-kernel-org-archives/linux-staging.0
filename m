+rt_rf_power_state RfOnOffDetect(PADAPTER pAdapter)
+{
+	struct pwrctrl_priv *pwrctl =3D adapter_to_pwrctl(pAdapter);
+	HAL_DATA_TYPE		*pHalData =3D GET_HAL_DATA(pAdapter);
+	u8	val8;
+	rt_rf_power_state rfpowerstate =3D rf_off;
+
+	if (pwrctl->bHWPowerdown) {
+		val8 =3D rtw_read8(pAdapter, REG_HSISR);
+		RTW_INFO("pwrdown, 0x5c(BIT7)=3D%02x\n", val8);
+		rfpowerstate =3D (val8 & BIT7) ? rf_off : rf_on;
