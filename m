+int rtw_ies_get_supported_rate(u8 *ies, uint ies_len, u8 *rate_set, u8 *ra=
te_num)
+{
+	u8 *ie;
+	unsigned int ie_len;
+
+	if (!rate_set || !rate_num)
+		return false;
+
+	*rate_num =3D 0;
+
+	ie =3D rtw_get_ie(ies, _SUPPORTEDRATES_IE_, &ie_len, ies_len);
