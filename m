+	ap->manufacturer_url =3D xml_get_first_item(data, "manufacturerURL");
+	wpa_printf(MSG_DEBUG, "WPS ER: manufacturerURL=3D'%s'",
+		   ap->manufacturer_url);
+
+	ap->model_description =3D xml_get_first_item(data, "modelDescription");
+	wpa_printf(MSG_DEBUG, "WPS ER: modelDescription=3D'%s'",
+		   ap->model_description);
+
+	ap->model_name =3D xml_get_first_item(data, "modelName");
+	wpa_printf(MSG_DEBUG, "WPS ER: modelName=3D'%s'", ap->model_name);
+
+	ap->model_number =3D xml_get_first_item(data, "modelNumber");
+	wpa_printf(MSG_DEBUG, "WPS ER: modelNumber=3D'%s'", ap->model_number);
+
+	ap->model_url =3D xml_get_first_item(data, "modelURL");
+	wpa_printf(MSG_DEBUG, "WPS ER: modelURL=3D'%s'", ap->model_url);
+
+	ap->serial_number =3D xml_get_first_item(data, "serialNumber");
+	wpa_printf(MSG_DEBUG, "WPS ER: serialNumber=3D'%s'", ap->serial_number);
+
+	ap->udn =3D xml_get_first_item(data, "UDN");
+	wpa_printf(MSG_DEBUG, "WPS ER: UDN=3D'%s'", ap->udn);
+	pos =3D os_strstr(ap->udn, "uuid:");
+	if (pos) {
