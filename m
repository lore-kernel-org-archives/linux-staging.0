+	rtw_hal_get_hwreg(padapter, HW_VAR_RF_TYPE, (u8 *)(&rf_type));
+	rx_nss =3D rtw_min(rf_type_to_rf_rx_cnt(rf_type), hal_spec->rx_nss_num);
