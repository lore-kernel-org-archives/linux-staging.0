+void hal_btcoex_BtMpRptNotify(PADAPTER padapter, u8 length, u8 *tmpBuf)
+{
+	u8 extid, status, len, seq;
+
+
+	if (!GLBtcBtMpRptWait)
+		return;
+
+	if ((length < 3) || (!tmpBuf))
+		return;
+
+	extid =3D tmpBuf[0];
+	/* not response from BT FW then exit*/
+	switch (extid) {
+	case C2H_WIFI_FW_ACTIVE_RSP:
+		GLBtcBtMpRptWiFiOK =3D 1;
+		return;
+
+	case C2H_TRIG_BY_BT_FW:
+		_cancel_timer_ex(&GLBtcBtMpOperTimer);
+		GLBtcBtMpRptWait =3D 0;
+		GLBtcBtMpRptBTOK =3D 1;
+		break;
+
+	default:
+		return;
+	}
+
+	status =3D tmpBuf[1] & 0xF;
+	len =3D length - 3;
+	seq =3D tmpBuf[2] >> 4;
+
+	GLBtcBtMpRptSeq =3D seq;
+	GLBtcBtMpRptStatus =3D status;
+	memcpy(GLBtcBtMpRptRsp, tmpBuf + 3, len);
+	GLBtcBtMpRptRspSize =3D len;
+	up(&GLBtcBtMpRptSema);
+}
