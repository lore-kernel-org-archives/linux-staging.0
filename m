+u8 * hostapd_eid_supp_rates(struct hostapd_data *hapd, u8 *eid)
+{
+	u8 *pos =3D eid;
+	int i, num, count;
+
+	if (hapd->iface->current_rates =3D=3D NULL)
+		return eid;
+
+	*pos++ =3D WLAN_EID_SUPP_RATES;
+	num =3D hapd->iface->num_rates;
+	if (hapd->iconf->ieee80211n && hapd->iconf->require_ht)
+		num++;
+	if (num > 8) {
+		/* rest of the rates are encoded in Extended supported
+		 * rates element */
+		num =3D 8;
+	}
+
+	*pos++ =3D num;
+	count =3D 0;
+	for (i =3D 0, count =3D 0; i < hapd->iface->num_rates && count < num;
+	     i++) {
+		count++;
+		*pos =3D hapd->iface->current_rates[i].rate / 5;
+		if (hapd->iface->current_rates[i].flags & HOSTAPD_RATE_BASIC)
+			*pos |=3D 0x80;
+		pos++;
+	}
+
+	if (hapd->iconf->ieee80211n && hapd->iconf->require_ht &&
+	    hapd->iface->num_rates < 8)
+		*pos++ =3D 0x80 | BSS_MEMBERSHIP_SELECTOR_HT_PHY;
+
+	return pos;
+}
+
+
+u8 * hostapd_eid_ext_supp_rates(struct hostapd_data *hapd, u8 *eid)
+{
+	u8 *pos =3D eid;
+	int i, num, count;
+
+	if (hapd->iface->current_rates =3D=3D NULL)
+		return eid;
+
+	num =3D hapd->iface->num_rates;
+	if (hapd->iconf->ieee80211n && hapd->iconf->require_ht)
+		num++;
+	if (num <=3D 8)
+		return eid;
+	num -=3D 8;
+
+	*pos++ =3D WLAN_EID_EXT_SUPP_RATES;
+	*pos++ =3D num;
+	count =3D 0;
+	for (i =3D 0, count =3D 0; i < hapd->iface->num_rates && count < num + 8;
+	     i++) {
+		count++;
+		if (count <=3D 8)
+			continue; /* already in SuppRates IE */
+		*pos =3D hapd->iface->current_rates[i].rate / 5;
+		if (hapd->iface->current_rates[i].flags & HOSTAPD_RATE_BASIC)
+			*pos |=3D 0x80;
+		pos++;
+	}
+
+	if (hapd->iconf->ieee80211n && hapd->iconf->require_ht &&
+	    hapd->iface->num_rates >=3D 8)
+		*pos++ =3D 0x80 | BSS_MEMBERSHIP_SELECTOR_HT_PHY;
+
+	return pos;
+}
