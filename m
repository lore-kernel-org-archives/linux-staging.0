+static void
+odm_common_info_self_update(
+	struct PHY_DM_STRUCT		*p_dm_odm
+)
+{
+	u8	entry_cnt =3D 0, num_active_client =3D 0;
+	u32	i, one_entry_macid =3D 0, ma_rx_tp =3D 0;
+	struct sta_info	*p_entry;
+
+	if (*(p_dm_odm->p_band_width) =3D=3D ODM_BW40M) {
+		if (*(p_dm_odm->p_sec_ch_offset) =3D=3D 1)
+			p_dm_odm->control_channel =3D *(p_dm_odm->p_channel) - 2;
+		else if (*(p_dm_odm->p_sec_ch_offset) =3D=3D 2)
+			p_dm_odm->control_channel =3D *(p_dm_odm->p_channel) + 2;
+	} else
+		p_dm_odm->control_channel =3D *(p_dm_odm->p_channel);
+
+	for (i =3D 0; i < ODM_ASSOCIATE_ENTRY_NUM; i++) {
+		p_entry =3D p_dm_odm->p_odm_sta_info[i];
+		if (IS_STA_VALID(p_entry)) {
+			entry_cnt++;
+			if (entry_cnt =3D=3D 1)
+				one_entry_macid =3D i;
+		}
+	}
+
+	if (entry_cnt =3D=3D 1) {
+		p_dm_odm->is_one_entry_only =3D true;
+		p_dm_odm->one_entry_macid =3D one_entry_macid;
+	} else
+		p_dm_odm->is_one_entry_only =3D false;
+
+	p_dm_odm->pre_number_linked_client =3D p_dm_odm->number_linked_client;
+	p_dm_odm->pre_number_active_client =3D p_dm_odm->number_active_client;
+
+	p_dm_odm->number_linked_client =3D entry_cnt;
+	p_dm_odm->number_active_client =3D num_active_client;
+
+	/* Update MP driver status*/
+	odm_update_mp_driver_status(p_dm_odm);
+
+	/*Traffic load information update*/
+	phydm_traffic_load_decision(p_dm_odm);
+
+	p_dm_odm->phydm_sys_up_time +=3D p_dm_odm->phydm_period;
+}
