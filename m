+	rtw_write32(adapter, REG_WKFMCAM_CMD, BIT_WKFCAM_POLLING_V1 | BIT_WKFCAM_=
WE | BIT_WKFCAM_ADDR_V2(addr));
+
+	start =3D jiffies;
+	while (1) {
