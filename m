+
+#define TNC_MAX_IMC_ID 10
+static struct tnc_if_imc *tnc_imc[TNC_MAX_IMC_ID] =3D { NULL };
+
+
+/* TNCC functions that IMCs can call */
+
+TNC_Result TNC_TNCC_ReportMessageTypes(
+	TNC_IMCID imcID,
+	TNC_MessageTypeList supportedTypes,
+	TNC_UInt32 typeCount)
+{
+	TNC_UInt32 i;
+	struct tnc_if_imc *imc;
+
+	wpa_printf(MSG_DEBUG, "TNC: TNC_TNCC_ReportMessageTypes(imcID=3D%lu "
+		   "typeCount=3D%lu)",
+		   (unsigned long) imcID, (unsigned long) typeCount);
+
+	for (i =3D 0; i < typeCount; i++) {
+		wpa_printf(MSG_DEBUG, "TNC: supportedTypes[%lu] =3D %lu",
+			   i, supportedTypes[i]);
+	}
+
+	if (imcID >=3D TNC_MAX_IMC_ID || tnc_imc[imcID] =3D=3D NULL)
+		return TNC_RESULT_INVALID_PARAMETER;
+
+	imc =3D tnc_imc[imcID];
+	os_free(imc->supported_types);
+	imc->supported_types =3D
+		os_malloc(typeCount * sizeof(TNC_MessageType));
+	if (imc->supported_types =3D=3D NULL)
+		return TNC_RESULT_FATAL;
+	os_memcpy(imc->supported_types, supportedTypes,
+		  typeCount * sizeof(TNC_MessageType));
+	imc->num_supported_types =3D typeCount;
+
+	return TNC_RESULT_SUCCESS;
