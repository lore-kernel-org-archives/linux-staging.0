+static int get_priv_size(__u16 args)
+{
+	int num =3D args & IW_PRIV_SIZE_MASK;
+	int type =3D (args & IW_PRIV_TYPE_MASK) >> 12;
+
+	return num * iw_priv_type_size[type];
