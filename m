+
+/**
+	* Perform an atomic 8 bit add
+	*
+	* @reg:     FAU atomic register to access. 0 <= reg < 2048.
+	* @value:   Signed value to add.
+	*/
+static inline void cvmx_fau_atomic_add8(cvmx_fau_reg_8_t reg, int8_t value)
+{
+	reg ^= SWIZZLE_8;
