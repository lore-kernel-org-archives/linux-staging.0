+#ifdef CONFIG_IOCTL_CFG80211
+static u8 _p2p_roch_cmd(_adapter *adapter, u64 cookie,
+			struct wireless_dev *wdev,
+			struct ieee80211_channel *ch,
+			enum nl80211_channel_type ch_type,
+			unsigned int duration, u8 flags)
+{
+	struct cmd_obj *cmdobj;
+	struct drvextra_cmd_parm *parm;
+	struct p2p_roch_parm *roch_parm;
+	struct cmd_priv *pcmdpriv =3D &adapter->cmdpriv;
+	struct submit_ctx sctx;
+	u8 cancel =3D duration ? 0 : 1;
+	u8 res =3D _SUCCESS;
+
+	roch_parm =3D (struct p2p_roch_parm *)rtw_zmalloc(sizeof(struct p2p_roch_=
parm));
+	if (!roch_parm) {
+		res =3D _FAIL;
+		goto exit;
+	}
+
+	roch_parm->cookie =3D cookie;
+	roch_parm->wdev =3D wdev;
+	if (!cancel) {
+		memcpy(&roch_parm->ch, ch, sizeof(struct ieee80211_channel));
+		roch_parm->ch_type =3D ch_type;
+		roch_parm->duration =3D duration;
+	}
+
+	if (flags & RTW_CMDF_DIRECTLY) {
+		/* no need to enqueue, do the cmd hdl directly and free cmd parameter */
+		if (p2p_protocol_wk_hdl(adapter,
+					cancel ? P2P_CANCEL_RO_CH_WK : P2P_RO_CH_WK,
+					(u8 *)roch_parm) !=3D H2C_SUCCESS)
+			res =3D _FAIL;
+		rtw_mfree((u8 *)roch_parm, sizeof(*roch_parm));
+	} else {
+		/* need enqueue, prepare cmd_obj and enqueue */
+		parm =3D (struct drvextra_cmd_parm *)rtw_zmalloc(sizeof(struct drvextra_=
cmd_parm));
+		if (parm =3D=3D NULL) {
+			rtw_mfree((u8 *)roch_parm, sizeof(*roch_parm));
+			res =3D _FAIL;
+			goto exit;
+		}
+
+		parm->ec_id =3D P2P_PROTO_WK_CID;
+		parm->type =3D cancel ? P2P_CANCEL_RO_CH_WK : P2P_RO_CH_WK;
+		parm->size =3D sizeof(*roch_parm);
+		parm->pbuf =3D (u8 *)roch_parm;
+
+		cmdobj =3D (struct cmd_obj *)rtw_zmalloc(sizeof(*cmdobj));
+		if (cmdobj =3D=3D NULL) {
+			res =3D _FAIL;
+			rtw_mfree((u8 *)roch_parm, sizeof(*roch_parm));
+			rtw_mfree((u8 *)parm, sizeof(*parm));
+			goto exit;
+		}
+
+		init_h2fwcmd_w_parm_no_rsp(cmdobj, parm, GEN_CMD_CODE(_Set_Drv_Extra));
+
+		if (flags & RTW_CMDF_WAIT_ACK) {
+			cmdobj->sctx =3D &sctx;
+			rtw_sctx_init(&sctx, 10 * 1000);
+		}
+
+		res =3D rtw_enqueue_cmd(pcmdpriv, cmdobj);
+
+		if (res =3D=3D _SUCCESS && (flags & RTW_CMDF_WAIT_ACK)) {
+			rtw_sctx_wait(&sctx, __func__);
+			_enter_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+			if (sctx.status =3D=3D RTW_SCTX_SUBMITTED)
+				cmdobj->sctx =3D NULL;
+			_exit_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+			if (sctx.status !=3D RTW_SCTX_DONE_SUCCESS)
+				res =3D _FAIL;
+		}
+	}
+
+exit:
+	return res;
+}
