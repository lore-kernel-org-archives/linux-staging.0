+	char *custom =3D pos + IW_EV_LCP_LEN;
+	struct iw_param p;
+	size_t clen;
+
+	clen =3D iwe->len;
+	if (custom + clen > end)
+		return;
+	maxrate =3D 0;
+	while (((ssize_t) clen) >=3D (ssize_t) sizeof(struct iw_param)) {
+		/* Note: may be misaligned, make a local, aligned copy */
+		os_memcpy(&p, custom, sizeof(struct iw_param));
+		if (p.value > maxrate)
+			maxrate =3D p.value;
+		clen -=3D sizeof(struct iw_param);
+		custom +=3D sizeof(struct iw_param);
+	}
