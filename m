+/*
+ * Description:
+ *	If task is done, call this func. to power down firmware again.
+ *
+ *	Constraint:
+ *		1. this function will request pwrctrl->lock
+ *
+ * Return Value:
+ *	none
+ */
+void rtw_unregister_task_alive(PADAPTER padapter, u32 task)
+{
+	struct pwrctrl_priv *pwrctrl;
+	u8 pslv;
+
+
+	pwrctrl =3D adapter_to_pwrctl(padapter);
+	pslv =3D PS_STATE_S0;
+
+#ifdef CONFIG_BT_COEXIST
+	if ((rtw_btcoex_IsBtDisabled(padapter) =3D=3D false)
+	    && (rtw_btcoex_IsBtControlLps(padapter) =3D=3D true)) {
+		u8 val8;
+
+		val8 =3D rtw_btcoex_LpsVal(padapter);
+		if (val8 & BIT(4))
+			pslv =3D PS_STATE_S2;
+
+	}
+#endif /* CONFIG_BT_COEXIST */
+
+	_enter_pwrlock(&pwrctrl->lock);
+
+	unregister_task_alive(pwrctrl, task);
+
+	if ((pwrctrl->pwr_mode !=3D PS_MODE_ACTIVE)
+	    && (pwrctrl->bFwCurrentInPSMode =3D=3D true)) {
+
+		if (pwrctrl->cpwm > pslv) {
+			if ((pslv >=3D PS_STATE_S2) || (pwrctrl->alives =3D=3D 0))
+				rtw_set_rpwm(padapter, pslv);
+		}
+	}
+
+	_exit_pwrlock(&pwrctrl->lock);
+
+}
