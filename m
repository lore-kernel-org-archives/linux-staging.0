+
+/* op_code: */
+enum {
+	EAP_PAX_OP_STD_1 =3D 0x01,
+	EAP_PAX_OP_STD_2 =3D 0x02,
+	EAP_PAX_OP_STD_3 =3D 0x03,
+	EAP_PAX_OP_SEC_1 =3D 0x11,
+	EAP_PAX_OP_SEC_2 =3D 0x12,
+	EAP_PAX_OP_SEC_3 =3D 0x13,
+	EAP_PAX_OP_SEC_4 =3D 0x14,
+	EAP_PAX_OP_SEC_5 =3D 0x15,
+	EAP_PAX_OP_ACK =3D 0x21
+};
+
+/* flags: */
+#define EAP_PAX_FLAGS_MF			0x01
+#define EAP_PAX_FLAGS_CE			0x02
+#define EAP_PAX_FLAGS_AI			0x04
+
