+				#ifdef CONFIG_DEBUG_CFG80211
+				RTW_INFO("%s, role=3D%d, p2p_state=3D%d\n", __func__, rtw_p2p_role(pwd=
info), rtw_p2p_state(pwdinfo));
+				#endif
