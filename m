+#ifdef CONFIG_CONCURRENT_MODE
+#ifndef CONFIG_FW_MULTI_PORT_SUPPORT
+	    || (padapter->hw_port !=3D HW_PORT0)
+#endif
+#endif
+	   )
+		return res;
+
+	if (enqueue) {
+		ph2c =3D (struct cmd_obj *)rtw_zmalloc(sizeof(struct cmd_obj));
+		if (ph2c =3D=3D NULL) {
+			res =3D _FAIL;
+			goto exit;
+		}
+
+		pdrvextra_cmd_parm =3D (struct drvextra_cmd_parm *)rtw_zmalloc(sizeof(st=
ruct drvextra_cmd_parm));
+		if (pdrvextra_cmd_parm =3D=3D NULL) {
+			rtw_mfree((unsigned char *)ph2c, sizeof(struct cmd_obj));
+			res =3D _FAIL;
+			goto exit;
+		}
+
+		pdrvextra_cmd_parm->ec_id =3D P2P_PS_WK_CID;
+		pdrvextra_cmd_parm->type =3D p2p_ps_state;
+		pdrvextra_cmd_parm->size =3D 0;
+		pdrvextra_cmd_parm->pbuf =3D NULL;
+
+		init_h2fwcmd_w_parm_no_rsp(ph2c, pdrvextra_cmd_parm, GEN_CMD_CODE(_Set_D=
rv_Extra));
+
+		res =3D rtw_enqueue_cmd(pcmdpriv, ph2c);
+	} else
+		p2p_ps_wk_hdl(padapter, p2p_ps_state);
+
+exit:
+
+
+	return res;
+
