factor);
+
+	/* rtw_hal_get_def_var(padapter, HW_VAR_MAX_RX_AMPDU_FACTOR, &max_rx_ampd=
u_factor); */
+	ht_capie.ampdu_params_info =3D (max_rx_ampdu_factor & 0x03);
+
+	if (padapter->driver_rx_ampdu_spacing !=3D 0xFF)
+		ht_capie.ampdu_params_info |=3D ((padapter->driver_rx_ampdu_spacing & 0x=
07) << 2);
+	else {
+		if (padapter->securitypriv.dot11PrivacyAlgrthm =3D=3D _AES_) {
+			/*
+			*	Todo : Each chip must to ask DD , this chip best ampdu_density setting
+			*	By yiwei.sun
+			*/
+			rtw_hal_get_def_var(padapter, HW_VAR_BEST_AMPDU_DENSITY, &best_ampdu_de=
nsity);
+
+			ht_capie.ampdu_params_info |=3D (IEEE80211_HT_CAP_AMPDU_DENSITY & (best=
_ampdu_density << 2));
