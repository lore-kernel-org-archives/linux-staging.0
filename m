+static void test_driver_mlme(struct wpa_driver_test_data *drv,
+			     struct sockaddr_un *from, socklen_t fromlen,
+			     u8 *data, size_t datalen)
+{
+	struct ieee80211_hdr *hdr;
+	u16 fc;
+	union wpa_event_data event;
+	int freq =3D 0, own_freq;
+	struct test_driver_bss *bss;
+
+	bss =3D dl_list_first(&drv->bss, struct test_driver_bss, list);
+
+	if (datalen > 6 && os_memcmp(data, "freq=3D", 5) =3D=3D 0) {
+		size_t pos;
+		for (pos =3D 5; pos < datalen; pos++) {
+			if (data[pos] =3D=3D ' ')
+				break;
+		}
+		if (pos < datalen) {
+			freq =3D atoi((const char *) &data[5]);
+			wpa_printf(MSG_DEBUG, "test_driver(%s): MLME RX on "
+				   "freq %d MHz", bss->ifname, freq);
+			pos++;
+			data +=3D pos;
+			datalen -=3D pos;
+		}
+	}
+
+	if (drv->remain_on_channel_freq)
+		own_freq =3D drv->remain_on_channel_freq;
+	else
+		own_freq =3D drv->current_freq;
+
+	if (freq && own_freq && freq !=3D own_freq) {
+		wpa_printf(MSG_DEBUG, "test_driver(%s): Ignore MLME RX on "
+			   "another frequency %d MHz (own %d MHz)",
+			   bss->ifname, freq, own_freq);
+		return;
+	}
+
+	hdr =3D (struct ieee80211_hdr *) data;
+
+	if (test_driver_get_cli(drv, from, fromlen) =3D=3D NULL && datalen >=3D 1=
6) {
+		struct test_client_socket *cli;
+		cli =3D os_zalloc(sizeof(*cli));
+		if (cli =3D=3D NULL)
+			return;
+		wpa_printf(MSG_DEBUG, "Adding client entry for " MACSTR,
+			   MAC2STR(hdr->addr2));
+		memcpy(cli->addr, hdr->addr2, ETH_ALEN);
+		memcpy(&cli->un, from, sizeof(cli->un));
+		cli->unlen =3D fromlen;
+		cli->next =3D drv->cli;
+		drv->cli =3D cli;
+	}
+
+	wpa_hexdump(MSG_MSGDUMP, "test_driver_mlme: received frame",
+		    data, datalen);
+	fc =3D le_to_host16(hdr->frame_control);
+	if (WLAN_FC_GET_TYPE(fc) !=3D WLAN_FC_TYPE_MGMT) {
+		wpa_printf(MSG_ERROR, "%s: received non-mgmt frame",
+			   __func__);
+		return;
+	}
+
+	os_memset(&event, 0, sizeof(event));
+	event.rx_mgmt.frame =3D data;
+	event.rx_mgmt.frame_len =3D datalen;
+	wpa_supplicant_event(drv->ctx, EVENT_RX_MGMT, &event);
+}
