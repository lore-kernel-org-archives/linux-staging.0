+void rtw_drv_stop_vir_if(_adapter *padapter)
+{
+	struct net_device *pnetdev =3D NULL;
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+
+	if (padapter =3D=3D NULL)
+		return;
+
+	pnetdev =3D padapter->pnetdev;
+
+	if (check_fwstate(pmlmepriv, _FW_LINKED))
+		rtw_disassoc_cmd(padapter, 0, false);
+
+#ifdef CONFIG_AP_MODE
+	if (check_fwstate(&padapter->mlmepriv, WIFI_AP_STATE) =3D=3D true) {
+		free_mlme_ap_info(padapter);
+		#ifdef CONFIG_HOSTAPD_MLME
+		hostapd_mode_unload(padapter);
+		#endif
+	}
+#endif
+
+	if (padapter->bup =3D=3D true) {
+		#ifdef CONFIG_XMIT_ACK
+		if (padapter->xmitpriv.ack_tx)
+			rtw_ack_tx_done(&padapter->xmitpriv, RTW_SCTX_DONE_DRV_STOP);
