+	/* parsing HT_INFO_IE */
+	p =3D rtw_get_ie(ie + _BEACON_IE_OFFSET_, _HT_ADD_INFO_IE_, &ie_len, (pbs=
s_network->IELength - _BEACON_IE_OFFSET_));
+	if (p && ie_len > 0)
