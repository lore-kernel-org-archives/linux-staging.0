+int hostapd_reload_config(struct hostapd_iface *iface)
+{
+	struct hostapd_data *hapd =3D iface->bss[0];
+	struct hostapd_config *newconf, *oldconf;
+	size_t j;
+
+	if (iface->config_read_cb =3D=3D NULL)
+		return -1;
+	newconf =3D iface->config_read_cb(iface->config_fname);
+	if (newconf =3D=3D NULL)
+		return -1;
+
+	/*
+	 * Deauthenticate all stations since the new configuration may not
+	 * allow them to use the BSS anymore.
+	 */
+	for (j =3D 0; j < iface->num_bss; j++) {
+		hostapd_flush_old_stations(iface->bss[j]);
+
+#ifndef CONFIG_NO_RADIUS
+		/* TODO: update dynamic data based on changed configuration
+		 * items (e.g., open/close sockets, etc.) */
+		radius_client_flush(iface->bss[j]->radius, 0);
+#endif /* CONFIG_NO_RADIUS */
+	}
+
+	oldconf =3D hapd->iconf;
+	iface->conf =3D newconf;
+
+	for (j =3D 0; j < iface->num_bss; j++) {
+		hapd =3D iface->bss[j];
+		hapd->iconf =3D newconf;
+		hapd->conf =3D &newconf->bss[j];
+		hostapd_reload_bss(hapd);
+	}
+
+	hostapd_config_free(oldconf);
+
+
+	return 0;
+}
