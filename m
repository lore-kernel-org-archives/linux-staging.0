+static void * eap_aka_init(struct eap_sm *sm)
+{
+	struct eap_aka_data *data;
+	const char *phase1 =3D eap_get_config_phase1(sm);
+
+	data =3D os_zalloc(sizeof(*data));
+	if (data =3D=3D NULL)
+		return NULL;
+
+	data->eap_method =3D EAP_TYPE_AKA;
+
+	eap_aka_state(data, CONTINUE);
+	data->prev_id =3D -1;
+
+	data->result_ind =3D phase1 && os_strstr(phase1, "result_ind=3D1") !=3D N=
ULL;
+
+	return data;
