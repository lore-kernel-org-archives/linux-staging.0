+static int wpa_driver_ndis_set_pmkid(struct wpa_driver_ndis_data *drv)
+{
+	int len, count, i, ret;
+	struct ndis_pmkid_entry *entry;
+	NDIS_802_11_PMKID *p;
+
+	count =3D 0;
+	entry =3D drv->pmkid;
+	while (entry) {
+		count++;
+		if (count >=3D drv->no_of_pmkid)
+			break;
+		entry =3D entry->next;
+	}
+	len =3D 8 + count * sizeof(BSSID_INFO);
+	p =3D os_zalloc(len);
+	if (p =3D=3D NULL)
+		return -1;
+
+	p->Length =3D len;
+	p->BSSIDInfoCount =3D count;
+	entry =3D drv->pmkid;
+	for (i =3D 0; i < count; i++) {
+		os_memcpy(&p->BSSIDInfo[i].BSSID, entry->bssid, ETH_ALEN);
+		os_memcpy(&p->BSSIDInfo[i].PMKID, entry->pmkid, 16);
+		entry =3D entry->next;
+	}
+	wpa_hexdump(MSG_MSGDUMP, "NDIS: OID_802_11_PMKID", (u8 *) p, len);
+	ret =3D ndis_set_oid(drv, OID_802_11_PMKID, (char *) p, len);
+	os_free(p);
+	return ret;
+}
