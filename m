+static int check_ielen(u8 *start, uint len)
+{
+	int left =3D len;
+	u8 *pos =3D start;
+	int unknown =3D 0;
+	u8 id, elen;
+
+	while (left >=3D 2) {
+		id =3D *pos++;
+		elen =3D *pos++;
+		left -=3D 2;
+
+		if (elen > left) {
+			RTW_INFO("IEEE 802.11 element parse failed (id=3D%d elen=3D%d left=3D%l=
u)\n",
+					id, elen, (unsigned long) left);
+			return false;
+		}
+		if ((id =3D=3D WLAN_EID_VENDOR_SPECIFIC) && (elen < 4))
+				return false;
+
+		left -=3D elen;
+		pos +=3D elen;
+	}
+	if (left)
+		return false;
+
+	return true;
+}
