+int
+hal_btcoex_ParseAntIsolationConfigFile(
+	PADAPTER		Adapter,
+	char			*buffer
+)
+{
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(Adapter);
+	u32	i =3D 0 , j =3D 0;
+	char	*szLine , *ptmp;
+	int rtStatus =3D _SUCCESS;
+	char param_value_string[10];
+	u8 param_value;
+	u8 anttype =3D 4;
+
+	u8 ant_num =3D 3 , ant_distance =3D 50 , rfe_type =3D 1;
+
+	typedef struct ant_isolation {
+		char *param_name;  /* antenna isolation config parameter name */
+		u8 *value; /* antenna isolation config parameter value */
+	} ANT_ISOLATION;
+
+	ANT_ISOLATION ant_isolation_param[] =3D {
+		{"ANT_NUMBER" , &ant_num},
+		{"ANT_DISTANCE" , &ant_distance},
+		{"RFE_TYPE" , &rfe_type},
+		{NULL , 0}
+	};
+
+
+
+	/* RTW_INFO("=3D=3D=3D>Hal_ParseAntIsolationConfigFile()\n" ); */
+
+	ptmp =3D buffer;
+	for (szLine =3D GetLineFromBuffer(ptmp) ; szLine !=3D NULL; szLine =3D Ge=
tLineFromBuffer(ptmp)) {
+		/* skip comment */
+		if (IsCommentString(szLine))
+			continue;
+
+		/* RTW_INFO("%s : szLine =3D %s , strlen(szLine) =3D %d\n" , __func__ , =
szLine , strlen(szLine));*/
+		for (j =3D 0 ; ant_isolation_param[j].param_name !=3D NULL ; j++) {
+			if (strstr(szLine , ant_isolation_param[j].param_name) !=3D NULL) {
+				i =3D 0;
+				while (i < strlen(szLine)) {
+					if (szLine[i] !=3D '"')
+						++i;
+					else {
+						/* skip only has one " */
+						if (strpbrk(szLine , "\"") =3D=3D strrchr(szLine , '"')) {
+							RTW_INFO("Fail to parse parameters , format error!\n");
+							break;
+						}
+						memset((void *)param_value_string , 0 , 10);
+						if (!ParseQualifiedString(szLine , &i , param_value_string , '"' , '=
"')) {
+							RTW_INFO("Fail to parse parameters\n");
+							return _FAIL;
+						} else if (!GetU1ByteIntegerFromStringInDecimal(param_value_string ,=
 ant_isolation_param[j].value))
+							RTW_INFO("Fail to GetU1ByteIntegerFromStringInDecimal\n");
+
+						break;
+					}
+				}
+			}
+		}
+	}
+
+	/* YiWei 20140716 , for BT coex antenna isolation control */
+	/* rfe_type =3D 0 was SPDT , rfe_type =3D 1 was coupler */
+	if (ant_num =3D=3D 3 && ant_distance >=3D 50)
+		anttype =3D 3;
+	else if (ant_num =3D=3D 2 && ant_distance >=3D 50 && rfe_type =3D=3D 1)
+		anttype =3D 2;
+	else if (ant_num =3D=3D 3 && ant_distance >=3D 15 && ant_distance < 50)
+		anttype =3D 2;
+	else if (ant_num =3D=3D 2 && ant_distance >=3D 15 && ant_distance < 50 &&=
 rfe_type =3D=3D 1)
+		anttype =3D 2;
+	else if ((ant_num =3D=3D 2 && ant_distance < 15 && rfe_type =3D=3D 1) || =
(ant_num =3D=3D 3 && ant_distance < 15))
+		anttype =3D 1;
+	else if (ant_num =3D=3D 2 && rfe_type =3D=3D 0)
+		anttype =3D 0;
+	else
+		anttype =3D 0;
+
+	hal_btcoex_SetAntIsolationType(Adapter, anttype);
+
+	RTW_INFO("%s : ant_num =3D %d\n" , __func__ , ant_num);
+	RTW_INFO("%s : ant_distance =3D %d\n" , __func__ , ant_distance);
+	RTW_INFO("%s : rfe_type =3D %d\n" , __func__ , rfe_type);
+	/* RTW_INFO("<=3D=3D=3DHal_ParseAntIsolationConfigFile()\n"); */
+	return rtStatus;
+}
