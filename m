+static inline char *iwe_stream_rate_process(_adapter *padapter,
+		struct iw_request_info *info, struct wlan_network *pnetwork,
+		char *start, char *stop, struct iw_event *iwe)
+{
+	u32 ht_ielen =3D 0, vht_ielen =3D 0;
+	char *p;
+	u16 max_rate =3D 0, rate, ht_cap =3D false, vht_cap =3D false;
+	u32 i =3D 0;
+	u8 bw_40MHz =3D 0, short_GI =3D 0, bw_160MHz =3D 0, vht_highest_rate =3D =
0;
+	u16 mcs_rate =3D 0, vht_data_rate =3D 0;
+	char custom[MAX_CUSTOM_LEN] =3D {0};
+	u8 ie_offset =3D (pnetwork->network.Reserved[0] =3D=3D 2 ? 0 : 12); /* Pr=
obe Request	 */
+
+	/* parsing HT_CAP_IE	 */
+	p =3D rtw_get_ie(&pnetwork->network.IEs[ie_offset], _HT_CAPABILITY_IE_, &=
ht_ielen, pnetwork->network.IELength - ie_offset);
+	if (p && ht_ielen > 0) {
+		struct rtw_ieee80211_ht_cap *pht_capie;
+
+		ht_cap =3D true;
+		pht_capie =3D (struct rtw_ieee80211_ht_cap *)(p + 2);
+		memcpy(&mcs_rate , pht_capie->supp_mcs_set, 2);
+		bw_40MHz =3D (le16_to_cpu(pht_capie->cap_info) & IEEE80211_HT_CAP_SUP_WI=
DTH) ? 1 : 0;
+		short_GI =3D (le16_to_cpu(pht_capie->cap_info) & (IEEE80211_HT_CAP_SGI_2=
0 | IEEE80211_HT_CAP_SGI_40)) ? 1 : 0;
+	}
+
+	/*Add basic and extended rates */
+	p =3D custom;
+	p +=3D snprintf(p, MAX_CUSTOM_LEN - (p - custom), " Rates (Mb/s): ");
+	while (pnetwork->network.SupportedRates[i] !=3D 0) {
+		rate =3D pnetwork->network.SupportedRates[i] & 0x7F;
+		if (rate > max_rate)
+			max_rate =3D rate;
+		p +=3D snprintf(p, MAX_CUSTOM_LEN - (p - custom),
+			      "%d%s ", rate >> 1, (rate & 1) ? ".5" : "");
+		i++;
+	}
+	if (ht_cap ) {
+		if (mcs_rate & 0x8000) /* MCS15 */
+			max_rate =3D (bw_40MHz) ? ((short_GI) ? 300 : 270) : ((short_GI) ? 144 =
: 130);
+
+		else if (mcs_rate & 0x0080) /* MCS7 */
+			max_rate =3D (bw_40MHz) ? ((short_GI) ? 150 : 135) : ((short_GI) ? 72 :=
 65);
+		else { /* default MCS7 */
+			/* RTW_INFO("wx_get_scan, mcs_rate_bitmap=3D0x%x\n", mcs_rate); */
+			max_rate =3D (bw_40MHz) ? ((short_GI) ? 150 : 135) : ((short_GI) ? 72 :=
 65);
+		}
+
+		max_rate =3D max_rate * 2; /* Mbps/2;		 */
+	}
+
+	iwe->cmd =3D SIOCGIWRATE;
+	iwe->u.bitrate.fixed =3D iwe->u.bitrate.disabled =3D 0;
+	iwe->u.bitrate.value =3D max_rate * 500000;
+	start =3D iwe_stream_add_event(info, start, stop, iwe, IW_EV_PARAM_LEN);
+	return start ;
+}
