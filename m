+
+	while (pac) {
+		count++;
+		if (count > max_len)
+			break;
+		prev =3D pac;
+		pac =3D pac->next;
+	}
+
+	if (count <=3D max_len || prev =3D=3D NULL)
+		return 0;
+
+	count =3D 0;
+	prev->next =3D NULL;
+
+	while (pac) {
+		prev =3D pac;
+		pac =3D pac->next;
+		eap_fast_free_pac(prev);
+		count++;
+	}
+
+	return count;
+}
+
+
+static void eap_fast_pac_get_a_id(struct eap_fast_pac *pac)
+{
+	u8 *pos, *end;
+	u16 type, len;
+
+	pos =3D pac->pac_info;
+	end =3D pos + pac->pac_info_len;
+
+	while (pos + 4 < end) {
+		type =3D WPA_GET_BE16(pos);
+		pos +=3D 2;
+		len =3D WPA_GET_BE16(pos);
+		pos +=3D 2;
+		if (pos + len > end)
+			break;
+
+		if (type =3D=3D PAC_TYPE_A_ID) {
+			os_free(pac->a_id);
+			pac->a_id =3D os_malloc(len);
+			if (pac->a_id =3D=3D NULL)
+				break;
+			os_memcpy(pac->a_id, pos, len);
+			pac->a_id_len =3D len;
+		}
+
+		if (type =3D=3D PAC_TYPE_A_ID_INFO) {
+			os_free(pac->a_id_info);
+			pac->a_id_info =3D os_malloc(len);
+			if (pac->a_id_info =3D=3D NULL)
+				break;
+			os_memcpy(pac->a_id_info, pos, len);
+			pac->a_id_info_len =3D len;
+		}
+
+		pos +=3D len;
+	}
+}
+
+
+/**
+ * eap_fast_load_pac_bin - Load PAC entries (binary format)
+ * @sm: Pointer to EAP state machine allocated with eap_peer_sm_init()
+ * @pac_root: Pointer to root of the PAC list (to be filled)
+ * @pac_file: Name of the PAC file/blob to load
+ * Returns: 0 on success, -1 on failure
+ */
+int eap_fast_load_pac_bin(struct eap_sm *sm, struct eap_fast_pac **pac_roo=
t,
+			  const char *pac_file)
+{
+	const struct wpa_config_blob *blob =3D NULL;
+	u8 *buf, *end, *pos;
+	size_t len, count =3D 0;
+	struct eap_fast_pac *pac, *prev;
+
+	*pac_root =3D NULL;
+
+	if (pac_file =3D=3D NULL)
+		return -1;
+
+	if (os_strncmp(pac_file, "blob://", 7) =3D=3D 0) {
+		blob =3D eap_get_config_blob(sm, pac_file + 7);
+		if (blob =3D=3D NULL) {
+			wpa_printf(MSG_INFO, "EAP-FAST: No PAC blob '%s' - "
+				   "assume no PAC entries have been "
+				   "provisioned", pac_file + 7);
+			return 0;
+		}
+		buf =3D blob->data;
+		len =3D blob->len;
+	} else {
+		buf =3D (u8 *) os_readfile(pac_file, &len);
+		if (buf =3D=3D NULL) {
+			wpa_printf(MSG_INFO, "EAP-FAST: No PAC file '%s' - "
+				   "assume no PAC entries have been "
+				   "provisioned", pac_file);
+			return 0;
+		}
+	}
+
+	if (len =3D=3D 0) {
+		if (blob =3D=3D NULL)
+			os_free(buf);
+		return 0;
+	}
+
+	if (len < 6 || WPA_GET_BE32(buf) !=3D EAP_FAST_PAC_BINARY_MAGIC ||
+	    WPA_GET_BE16(buf + 4) !=3D EAP_FAST_PAC_BINARY_FORMAT_VERSION) {
+		wpa_printf(MSG_INFO, "EAP-FAST: Invalid PAC file '%s' (bin)",
+			   pac_file);
+		if (blob =3D=3D NULL)
+			os_free(buf);
+		return -1;
+	}
+
+	pac =3D prev =3D NULL;
+	pos =3D buf + 6;
+	end =3D buf + len;
+	while (pos < end) {
+		if (end - pos < 2 + 32 + 2 + 2)
+			goto parse_fail;
+
+		pac =3D os_zalloc(sizeof(*pac));
+		if (pac =3D=3D NULL)
+			goto parse_fail;
+
+		pac->pac_type =3D WPA_GET_BE16(pos);
+		pos +=3D 2;
+		os_memcpy(pac->pac_key, pos, EAP_FAST_PAC_KEY_LEN);
+		pos +=3D EAP_FAST_PAC_KEY_LEN;
+		pac->pac_opaque_len =3D WPA_GET_BE16(pos);
+		pos +=3D 2;
+		if (pos + pac->pac_opaque_len + 2 > end)
+			goto parse_fail;
+		pac->pac_opaque =3D os_malloc(pac->pac_opaque_len);
+		if (pac->pac_opaque =3D=3D NULL)
+			goto parse_fail;
+		os_memcpy(pac->pac_opaque, pos, pac->pac_opaque_len);
+		pos +=3D pac->pac_opaque_len;
+		pac->pac_info_len =3D WPA_GET_BE16(pos);
+		pos +=3D 2;
+		if (pos + pac->pac_info_len > end)
+			goto parse_fail;
+		pac->pac_info =3D os_malloc(pac->pac_info_len);
+		if (pac->pac_info =3D=3D NULL)
+			goto parse_fail;
+		os_memcpy(pac->pac_info, pos, pac->pac_info_len);
+		pos +=3D pac->pac_info_len;
+		eap_fast_pac_get_a_id(pac);
+
+		count++;
+		if (prev)
+			prev->next =3D pac;
+		else
+			*pac_root =3D pac;
+		prev =3D pac;
+	}
+
+	if (blob =3D=3D NULL)
+		os_free(buf);
+
+	wpa_printf(MSG_DEBUG, "EAP-FAST: Read %lu PAC entries from '%s' (bin)",
+		   (unsigned long) count, pac_file);
+
+	return 0;
+
+parse_fail:
+	wpa_printf(MSG_INFO, "EAP-FAST: Failed to parse PAC file '%s' (bin)",
+		   pac_file);
+	if (blob =3D=3D NULL)
+		os_free(buf);
+	if (pac)
+		eap_fast_free_pac(pac);
+	return -1;
+}
+
+
+/**
+ * eap_fast_save_pac_bin - Save PAC entries (binary format)
+ * @sm: Pointer to EAP state machine allocated with eap_peer_sm_init()
+ * @pac_root: Root of the PAC list
+ * @pac_file: Name of the PAC file/blob
+ * Returns: 0 on success, -1 on failure
+ */
+int eap_fast_save_pac_bin(struct eap_sm *sm, struct eap_fast_pac *pac_root,
+			  const char *pac_file)
+{
+	size_t len, count =3D 0;
+	struct eap_fast_pac *pac;
+	u8 *buf, *pos;
+
+	len =3D 6;
+	pac =3D pac_root;
+	while (pac) {
+		if (pac->pac_opaque_len > 65535 ||
+		    pac->pac_info_len > 65535)
+			return -1;
+		len +=3D 2 + EAP_FAST_PAC_KEY_LEN + 2 + pac->pac_opaque_len +
+			2 + pac->pac_info_len;
+		pac =3D pac->next;
+	}
+
+	buf =3D os_malloc(len);
+	if (buf =3D=3D NULL)
+		return -1;
+
+	pos =3D buf;
+	WPA_PUT_BE32(pos, EAP_FAST_PAC_BINARY_MAGIC);
+	pos +=3D 4;
+	WPA_PUT_BE16(pos, EAP_FAST_PAC_BINARY_FORMAT_VERSION);
+	pos +=3D 2;
+
+	pac =3D pac_root;
+	while (pac) {
+		WPA_PUT_BE16(pos, pac->pac_type);
+		pos +=3D 2;
+		os_memcpy(pos, pac->pac_key, EAP_FAST_PAC_KEY_LEN);
+		pos +=3D EAP_FAST_PAC_KEY_LEN;
+		WPA_PUT_BE16(pos, pac->pac_opaque_len);
+		pos +=3D 2;
+		os_memcpy(pos, pac->pac_opaque, pac->pac_opaque_len);
+		pos +=3D pac->pac_opaque_len;
+		WPA_PUT_BE16(pos, pac->pac_info_len);
+		pos +=3D 2;
+		os_memcpy(pos, pac->pac_info, pac->pac_info_len);
+		pos +=3D pac->pac_info_len;
+
+		pac =3D pac->next;
+		count++;
+	}
+
+	if (eap_fast_write_pac(sm, pac_file, (char *) buf, len)) {
+		os_free(buf);
+		return -1;
+	}
+
+	wpa_printf(MSG_DEBUG, "EAP-FAST: Wrote %lu PAC entries into '%s' "
+		   "(bin)", (unsigned long) count, pac_file);
+
+	return 0;
+}
