+struct wpabuf * tls_connection_handshake(void *tls_ctx,
+					 struct tls_connection *conn,
+					 const struct wpabuf *in_data,
+					 struct wpabuf **appl_data)
+{
+#ifdef CONFIG_TLS_INTERNAL_CLIENT
+	u8 *res, *ad;
+	size_t res_len, ad_len;
+	struct wpabuf *out;
+
+	if (conn->client =3D=3D NULL)
+		return NULL;
+
+	ad =3D NULL;
+	res =3D tlsv1_client_handshake(conn->client,
+				     in_data ? wpabuf_head(in_data) : NULL,
+				     in_data ? wpabuf_len(in_data) : 0,
+				     &res_len, &ad, &ad_len);
+	if (res =3D=3D NULL)
+		return NULL;
+	out =3D wpabuf_alloc_ext_data(res, res_len);
+	if (out =3D=3D NULL) {
+		os_free(res);
+		os_free(ad);
+		return NULL;
+	}
+	if (appl_data) {
+		if (ad) {
+			*appl_data =3D wpabuf_alloc_ext_data(ad, ad_len);
+			if (*appl_data =3D=3D NULL)
+				os_free(ad);
+		} else
+			*appl_data =3D NULL;
+	} else
+		os_free(ad);
