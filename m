+static void hostapd_rx_from_unknown_sta(struct hostapd_data *hapd,
+					const u8 *frame, size_t len)
+{
+	const struct ieee80211_hdr *hdr =3D (const struct ieee80211_hdr *) frame;
+	u16 fc =3D le_to_host16(hdr->frame_control);
+	hapd =3D get_hapd_bssid(hapd->iface, get_hdr_bssid(hdr, len));
+	if (hapd =3D=3D NULL || hapd =3D=3D HAPD_BROADCAST)
+		return;
+
+	ieee802_11_rx_from_unknown(hapd, hdr->addr2,
+				   (fc & (WLAN_FC_TODS | WLAN_FC_FROMDS)) =3D=3D
+				   (WLAN_FC_TODS | WLAN_FC_FROMDS));
+}
