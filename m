+	os_memcpy(pos, &vendor_id, sizeof(vendor_id));
+	pos +=3D sizeof(vendor_id);
+	vhdr =3D (struct radius_attr_vendor *) pos;
+	vhdr->vendor_type =3D RADIUS_VENDOR_ATTR_MS_MPPE_RECV_KEY;
+	pos =3D (u8 *) (vhdr + 1);
