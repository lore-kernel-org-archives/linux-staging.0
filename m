+static int
+wpa_driver_ndis_associate(void *priv,
+			  struct wpa_driver_associate_params *params)
+{
+	struct wpa_driver_ndis_data *drv =3D priv;
+	u32 auth_mode, encr, priv_mode, mode;
+	u8 bcast[ETH_ALEN] =3D { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+
+	drv->mode =3D params->mode;
+
+	/* Note: Setting OID_802_11_INFRASTRUCTURE_MODE clears current keys,
+	 * so static WEP keys needs to be set again after this. */
+	if (params->mode =3D=3D IEEE80211_MODE_IBSS) {
+		mode =3D Ndis802_11IBSS;
+		/* Need to make sure that BSSID polling is enabled for
+		 * IBSS mode. */
+		eloop_cancel_timeout(wpa_driver_ndis_poll_timeout, drv, NULL);
+		eloop_register_timeout(1, 0, wpa_driver_ndis_poll_timeout,
+				       drv, NULL);
+	} else
+		mode =3D Ndis802_11Infrastructure;
+	if (ndis_set_oid(drv, OID_802_11_INFRASTRUCTURE_MODE,
+			 (char *) &mode, sizeof(mode)) < 0) {
+		wpa_printf(MSG_DEBUG, "NDIS: Failed to set "
+			   "OID_802_11_INFRASTRUCTURE_MODE (%d)",
+			   (int) mode);
+		/* Try to continue anyway */
+	}
+
+	if (params->key_mgmt_suite =3D=3D KEY_MGMT_NONE ||
+	    params->key_mgmt_suite =3D=3D KEY_MGMT_802_1X_NO_WPA) {
+		/* Re-set WEP keys if static WEP configuration is used. */
+		int i;
+		for (i =3D 0; i < 4; i++) {
+			if (!params->wep_key[i])
+				continue;
+			wpa_printf(MSG_DEBUG, "NDIS: Re-setting static WEP "
+				   "key %d", i);
+			wpa_driver_ndis_set_key(drv->ifname, drv, WPA_ALG_WEP,
+						bcast, i,
+						i =3D=3D params->wep_tx_keyidx,
+						NULL, 0, params->wep_key[i],
+						params->wep_key_len[i]);
+		}
+	}
+
+	if (params->wpa_ie =3D=3D NULL || params->wpa_ie_len =3D=3D 0) {
+		if (params->auth_alg & WPA_AUTH_ALG_SHARED) {
+			if (params->auth_alg & WPA_AUTH_ALG_OPEN)
+				auth_mode =3D Ndis802_11AuthModeAutoSwitch;
+			else
+				auth_mode =3D Ndis802_11AuthModeShared;
+		} else
+			auth_mode =3D Ndis802_11AuthModeOpen;
+		priv_mode =3D Ndis802_11PrivFilterAcceptAll;
+	} else if (params->wpa_ie[0] =3D=3D WLAN_EID_RSN) {
+		priv_mode =3D Ndis802_11PrivFilter8021xWEP;
+		if (params->key_mgmt_suite =3D=3D KEY_MGMT_PSK)
+			auth_mode =3D Ndis802_11AuthModeWPA2PSK;
+		else
+			auth_mode =3D Ndis802_11AuthModeWPA2;
+#ifdef CONFIG_WPS
+	} else if (params->key_mgmt_suite =3D=3D KEY_MGMT_WPS) {
+		auth_mode =3D Ndis802_11AuthModeOpen;
+		priv_mode =3D Ndis802_11PrivFilterAcceptAll;
+		if (params->wps =3D=3D WPS_MODE_PRIVACY) {
+			u8 dummy_key[5] =3D { 0x11, 0x22, 0x33, 0x44, 0x55 };
+			/*
+			 * Some NDIS drivers refuse to associate in open mode
+			 * configuration due to Privacy field mismatch, so use
+			 * a workaround to make the configuration look like
+			 * matching one for WPS provisioning.
+			 */
+			wpa_printf(MSG_DEBUG, "NDIS: Set dummy WEP key as a "
+				   "workaround to allow driver to associate "
+				   "for WPS");
+			wpa_driver_ndis_set_key(drv->ifname, drv, WPA_ALG_WEP,
+						bcast, 0, 1,
+						NULL, 0, dummy_key,
+						sizeof(dummy_key));
+		}
+#endif /* CONFIG_WPS */
+	} else {
+		priv_mode =3D Ndis802_11PrivFilter8021xWEP;
+		if (params->key_mgmt_suite =3D=3D KEY_MGMT_WPA_NONE)
+			auth_mode =3D Ndis802_11AuthModeWPANone;
+		else if (params->key_mgmt_suite =3D=3D KEY_MGMT_PSK)
+			auth_mode =3D Ndis802_11AuthModeWPAPSK;
+		else
+			auth_mode =3D Ndis802_11AuthModeWPA;
+	}
+
+	switch (params->pairwise_suite) {
+	case CIPHER_CCMP:
+		encr =3D Ndis802_11Encryption3Enabled;
+		break;
+	case CIPHER_TKIP:
+		encr =3D Ndis802_11Encryption2Enabled;
+		break;
+	case CIPHER_WEP40:
+	case CIPHER_WEP104:
+		encr =3D Ndis802_11Encryption1Enabled;
+		break;
+	case CIPHER_NONE:
+#ifdef CONFIG_WPS
+		if (params->wps =3D=3D WPS_MODE_PRIVACY) {
+			encr =3D Ndis802_11Encryption1Enabled;
+			break;
+		}
+#endif /* CONFIG_WPS */
+		if (params->group_suite =3D=3D CIPHER_CCMP)
+			encr =3D Ndis802_11Encryption3Enabled;
+		else if (params->group_suite =3D=3D CIPHER_TKIP)
+			encr =3D Ndis802_11Encryption2Enabled;
+		else
+			encr =3D Ndis802_11EncryptionDisabled;
+		break;
+	default:
+#ifdef CONFIG_WPS
+		if (params->wps =3D=3D WPS_MODE_PRIVACY) {
+			encr =3D Ndis802_11Encryption1Enabled;
+			break;
+		}
+#endif /* CONFIG_WPS */
+		encr =3D Ndis802_11EncryptionDisabled;
+		break;
+	};
+
+	if (ndis_set_oid(drv, OID_802_11_PRIVACY_FILTER,
+			 (char *) &priv_mode, sizeof(priv_mode)) < 0) {
+		wpa_printf(MSG_DEBUG, "NDIS: Failed to set "
+			   "OID_802_11_PRIVACY_FILTER (%d)",
+			   (int) priv_mode);
+		/* Try to continue anyway */
+	}
+
+	ndis_set_auth_mode(drv, auth_mode);
+	ndis_set_encr_status(drv, encr);
+
+	if (params->bssid) {
+		ndis_set_oid(drv, OID_802_11_BSSID, (char *) params->bssid,
+			     ETH_ALEN);
+		drv->oid_bssid_set =3D 1;
+	} else if (drv->oid_bssid_set) {
+		ndis_set_oid(drv, OID_802_11_BSSID, "\xff\xff\xff\xff\xff\xff",
+			     ETH_ALEN);
+		drv->oid_bssid_set =3D 0;
+	}
+
+	return wpa_driver_ndis_set_ssid(drv, params->ssid, params->ssid_len);
+}
