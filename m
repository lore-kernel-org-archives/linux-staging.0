+static inline void phy_txpwr_by_rate_duplicate_band_path(_adapter *adapter=
, u8 band, u8 s_path, u8 t_path)
+{
+	struct hal_spec_t *hal_spec =3D GET_HAL_SPEC(adapter);
+	HAL_DATA_TYPE *hal_data =3D GET_HAL_DATA(adapter);
