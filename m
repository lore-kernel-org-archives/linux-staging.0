+static void _sounding_update_min_period(PADAPTER adapter, u16 period, u8 l=
eave)
+{
+	struct beamforming_info *info;
+	struct beamformee_entry *bfee;
+	u8 i =3D 0;
+	u16 min_val =3D 0xFFFF;
+
+
+	info =3D GET_BEAMFORM_INFO(adapter);
+
+	if (leave) {
+		/*
+		 * When a BFee left,
+		 * we need to find the latest min sounding period
+		 * from the remaining BFees
+		 */
+		for (i =3D 0; i < MAX_BEAMFORMEE_ENTRY_NUM; i++) {
+			bfee =3D &info->bfee_entry[i];
+			if ((bfee->used =3D=3D true)
+			    && (bfee->sound_period < min_val))
+				min_val =3D bfee->sound_period;
+		}
+
+		if (min_val =3D=3D 0xFFFF)
+			info->sounding_info.min_sounding_period =3D 0;
+		else
+			info->sounding_info.min_sounding_period =3D min_val;
+	} else {
+		if ((info->sounding_info.min_sounding_period =3D=3D 0)
+		    || (period < info->sounding_info.min_sounding_period))
+			info->sounding_info.min_sounding_period =3D period;
+	}
+}
+
+static void _sounding_init(struct sounding_info *sounding)
+{
+	memset(sounding->su_sounding_list, 0xFF, MAX_NUM_BEAMFORMEE_SU);
+	memset(sounding->mu_sounding_list, 0xFF, MAX_NUM_BEAMFORMEE_MU);
+	sounding->state =3D SOUNDING_STATE_NONE;
+	sounding->su_bfee_curidx =3D 0xFF;
+	sounding->candidate_mu_bfee_cnt =3D 0;
+	sounding->min_sounding_period =3D 0;
+	sounding->sound_remain_cnt_per_period =3D 0;
+}
+
+static void _sounding_reset_vars(PADAPTER adapter)
+{
+	struct beamforming_info	*info;
+	struct sounding_info *sounding;
+	u8 idx;
+
+
+	info =3D GET_BEAMFORM_INFO(adapter);
+	sounding =3D &info->sounding_info;
+
+	memset(sounding->su_sounding_list, 0xFF, MAX_NUM_BEAMFORMEE_SU);
+	memset(sounding->mu_sounding_list, 0xFF, MAX_NUM_BEAMFORMEE_MU);
+	sounding->su_bfee_curidx =3D 0xFF;
+	sounding->candidate_mu_bfee_cnt =3D 0;
+
+	/* Clear bSound flag for the new period */
+	for (idx =3D 0; idx < MAX_BEAMFORMEE_ENTRY_NUM; idx++) {
+		if ((info->bfee_entry[idx].used =3D=3D true)
+		    && (info->bfee_entry[idx].sounding =3D=3D true)) {
+			info->bfee_entry[idx].sounding =3D false;
+			info->bfee_entry[idx].bCandidateSoundingPeer =3D false;
+		}
+	}
+}
+
+/*
+ * Return
+ *	0	Prepare sounding list OK
+ *	-1	Fail to prepare sounding list, because no beamformee need to souding
+ *	-2	Fail to prepare sounding list, because beamformee state not ready
+ *
+ */
+static int _sounding_get_list(PADAPTER adapter)
+{
+	struct beamforming_info	*info;
+	struct sounding_info *sounding;
+	struct beamformee_entry *bfee;
+	u8 i, mu_idx =3D 0, su_idx =3D 0, not_ready =3D 0;
+	int ret =3D 0;
+
+
+	info =3D GET_BEAMFORM_INFO(adapter);
+	sounding =3D &info->sounding_info;
+
+	/* Add MU BFee list first because MU priority is higher than SU */
+	for (i =3D 0; i < MAX_BEAMFORMEE_ENTRY_NUM; i++) {
+		bfee =3D &info->bfee_entry[i];
+		if (bfee->used =3D=3D false)
+			continue;
+
+		if (bfee->state !=3D BEAMFORM_ENTRY_HW_STATE_ADDED) {
+			RTW_ERR("%s: Invalid BFee idx(%d) Hw state=3D%d\n", __func__, i, bfee->=
state);
+			not_ready++;
+			continue;
+		}
+
+		/*
+		 * Decrease BFee's SoundCnt per period
+		 * If the remain count is 0,
+		 * then it can be sounded at this time
+		 */
+		if (bfee->SoundCnt) {
+			bfee->SoundCnt--;
+			if (bfee->SoundCnt)
+				continue;
+		}
+
+		/*
+		 * <tynli_Note>
+		 *	If the STA supports MU BFee capability then we add it to MUSoundingLi=
st directly
+		 *	because we can only sound one STA by unicast NDPA with MU cap enabled=
 to get correct channel info.
+		 *	Suggested by BB team Luke Lee. 2015.11.25.
+		 */
+		if (bfee->cap & BEAMFORMEE_CAP_VHT_MU) {
+			/* MU BFee */
+			if (mu_idx >=3D MAX_NUM_BEAMFORMEE_MU) {
+				RTW_ERR("%s: Too much MU bfee entry(Limit:%d)\n", __func__, MAX_NUM_BE=
AMFORMEE_MU);
+				continue;
+			}
+
+			if (bfee->bApplySounding =3D=3D true) {
+				bfee->bCandidateSoundingPeer =3D true;
+				bfee->SoundCnt =3D GetInitSoundCnt(bfee->sound_period, sounding->min_s=
ounding_period);
+				sounding->mu_sounding_list[mu_idx] =3D i;
+				mu_idx++;
+			}
+		} else if (bfee->cap & (BEAMFORMEE_CAP_VHT_SU|BEAMFORMEE_CAP_HT_EXPLICIT=
)) {
+			/* SU BFee (HT/VHT) */
+			if (su_idx >=3D MAX_NUM_BEAMFORMEE_SU) {
+				RTW_ERR("%s: Too much SU bfee entry(Limit:%d)\n", __func__, MAX_NUM_BE=
AMFORMEE_SU);
+				continue;
+			}
+
+			if (bfee->bDeleteSounding =3D=3D true) {
+				sounding->su_sounding_list[su_idx] =3D i;
+				su_idx++;
+			} else if ((bfee->bApplySounding =3D=3D true)
+			    && (bfee->bSuspendSUCap =3D=3D false)) {
+				bfee->bCandidateSoundingPeer =3D true;
+				bfee->SoundCnt =3D GetInitSoundCnt(bfee->sound_period, sounding->min_s=
ounding_period);
+				sounding->su_sounding_list[su_idx] =3D i;
+				su_idx++;
+			}
+		}
+	}
+
+	sounding->candidate_mu_bfee_cnt =3D mu_idx;
+
+	if (su_idx + mu_idx =3D=3D 0) {
+		ret =3D -1;
+		if (not_ready)
+			ret =3D -2;
+	}
+
+	RTW_INFO("-%s: There are %d SU and %d MU BFees in this sounding period\n"=
, __func__, su_idx, mu_idx);
+
+	return ret;
+}
+
+static void _sounding_handler(PADAPTER adapter)
+{
+	struct beamforming_info	*info;
+	struct sounding_info *sounding;
+	struct beamformee_entry *bfee;
+	u8 su_idx, i;
+	u32 timeout_period =3D 0;
+	u8 set_timer =3D false;
+	int ret =3D 0;
+	static u16 wait_cnt =3D 0;
+
+
+	info =3D GET_BEAMFORM_INFO(adapter);
+	sounding =3D &info->sounding_info;
+
+	RTW_DBG("+%s: state=3D%d\n", __func__, sounding->state);
+	if ((sounding->state !=3D SOUNDING_STATE_INIT)
+	    && (sounding->state !=3D SOUNDING_STATE_SU_SOUNDDOWN)
+	    && (sounding->state !=3D SOUNDING_STATE_MU_SOUNDDOWN)
+	    && (sounding->state !=3D SOUNDING_STATE_SOUNDING_TIMEOUT)) {
+		RTW_WARN("%s: Invalid State(%d) and return!\n", __func__, sounding->stat=
e);
+		return;
+	}
+
+	if (sounding->state =3D=3D SOUNDING_STATE_INIT) {
+		RTW_INFO("%s: Sounding start\n", __func__);
+
+		/* Init Var */
+		_sounding_reset_vars(adapter);
+
+		/* Get the sounding list of this sounding period */
+		ret =3D _sounding_get_list(adapter);
+		if (ret =3D=3D -1) {
+			wait_cnt =3D 0;
+			sounding->state =3D SOUNDING_STATE_NONE;
+			RTW_ERR("%s: No BFees found, set to SOUNDING_STATE_NONE\n", __func__);
+			info->sounding_running--;
+			return;
+		}
+		if (ret =3D=3D -2) {
+			RTW_WARN("%s: Temporarily cann't find BFee to sounding\n", __func__);
+			if (wait_cnt < 5) {
+				wait_cnt++;
+			} else {
+				wait_cnt =3D 0;
+				sounding->state =3D SOUNDING_STATE_NONE;
+				RTW_ERR("%s: Wait changing state timeout!! Set to SOUNDING_STATE_NONE\=
n", __func__);
+			}
+			info->sounding_running--;
+			return;
+		}
+		if (ret !=3D 0) {
+			wait_cnt =3D 0;
+			RTW_ERR("%s: Unkown state(%d)!\n", __func__, ret);
+			info->sounding_running--;
+			return;
+
+		}
+
+		wait_cnt =3D 0;
+
+		if (check_fwstate(&adapter->mlmepriv, WIFI_SITE_MONITOR) =3D=3D true) {
+			RTW_INFO("%s: Sounding abort! scanning APs...\n", __func__);
+			info->sounding_running--;
+			return;
+		}
+
+		rtw_ps_deny(adapter, PS_DENY_BEAMFORMING);
+		LeaveAllPowerSaveModeDirect(adapter);
+	}
+
+	/* Get non-sound SU BFee index */
+	for (i =3D 0; i < MAX_NUM_BEAMFORMEE_SU; i++) {
+		su_idx =3D sounding->su_sounding_list[i];
+		if (su_idx >=3D MAX_BEAMFORMEE_ENTRY_NUM)
+			continue;
+		bfee =3D &info->bfee_entry[su_idx];
+		if (false =3D=3D bfee->sounding)
+			break;
+	}
+	if (i < MAX_NUM_BEAMFORMEE_SU) {
+		sounding->su_bfee_curidx =3D su_idx;
+		/* Set to sounding start state */
+		sounding->state =3D SOUNDING_STATE_SU_START;
+		RTW_DBG("%s: Set to SOUNDING_STATE_SU_START\n", __func__);
+
+		bfee->sounding =3D true;
+		/* Reset sounding timeout flag for the new sounding */
+		bfee->bSoundingTimeout =3D false;
+
+		if (bfee->bDeleteSounding) {
+			u8 res =3D false;
+			rtw_bf_cmd(adapter, BEAMFORMING_CTRL_END_PERIOD, &res, 1, 0);
+			return;
+		}
+
+		/* Start SU sounding */
+		if (bfee->cap & BEAMFORMEE_CAP_VHT_SU)
+			_send_vht_ndpa_packet(adapter, bfee->mac_addr, bfee->aid, bfee->sound_b=
w);
+		else if (bfee->cap & BEAMFORMEE_CAP_HT_EXPLICIT)
+			_send_ht_ndpa_packet(adapter, bfee->mac_addr, bfee->sound_bw);
+
+		/* Set sounding timeout timer */
+		_set_timer(&info->sounding_timeout_timer, SU_SOUNDING_TIMEOUT);
+		return;
+	}
+
+	if (sounding->candidate_mu_bfee_cnt > 0) {
+		/*
+		 * If there is no SU BFee then find MU BFee and perform MU sounding
+		 *
+		 * <tynli_note> Need to check the MU starting condition. 2015.12.15.
+		 */
+		sounding->state =3D SOUNDING_STATE_MU_START;
+		RTW_DBG("%s: Set to SOUNDING_STATE_MU_START\n", __func__);
+
+		/* Update MU BFee info */
+		for (i =3D 0; i < sounding->candidate_mu_bfee_cnt; i++) {
+			bfee =3D &info->bfee_entry[sounding->mu_sounding_list[i]];
+			bfee->sounding =3D true;
+		}
+
+		/* Send MU NDPA */
+		bfee =3D &info->bfee_entry[sounding->mu_sounding_list[0]];
+		_send_vht_mu_ndpa_packet(adapter, bfee->sound_bw);
+
+		/* Send BF report poll if more than 1 MU STA */
+		for (i =3D 1; i < sounding->candidate_mu_bfee_cnt; i++) {
+			bfee =3D &info->bfee_entry[sounding->mu_sounding_list[i]];
+
+			if (i =3D=3D (sounding->candidate_mu_bfee_cnt - 1))/* The last STA*/
+				_send_bf_report_poll(adapter, bfee->mac_addr, true);
+			else
+				_send_bf_report_poll(adapter, bfee->mac_addr, false);
+		}
+
+		sounding->candidate_mu_bfee_cnt =3D 0;
+
+		/* Set sounding timeout timer */
+		_set_timer(&info->sounding_timeout_timer, MU_SOUNDING_TIMEOUT);
+		return;
+	}
+
+	info->sounding_running--;
+	sounding->state =3D SOUNDING_STATE_INIT;
+	RTW_INFO("%s: Sounding finished!\n", __func__);
+	rtw_ps_deny_cancel(adapter, PS_DENY_BEAMFORMING);
+}
+
+static void _sounding_force_stop(PADAPTER adapter)
+{
+	struct beamforming_info	*info;
+	struct sounding_info *sounding;
+	u8 cancelled;
+
+
+	info =3D GET_BEAMFORM_INFO(adapter);
+	sounding =3D &info->sounding_info;
+
+	if ((sounding->state =3D=3D SOUNDING_STATE_SU_START)
+	    || (sounding->state =3D=3D SOUNDING_STATE_MU_START)) {
+		u8 res =3D false;
+		_cancel_timer(&info->sounding_timeout_timer, &cancelled);
+		rtw_bf_cmd(adapter, BEAMFORMING_CTRL_END_PERIOD, &res, 1, 1);
+		return;
+	}
+
+	info->sounding_running--;
+	sounding->state =3D SOUNDING_STATE_INIT;
+	RTW_INFO("%s: Sounding finished!\n", __func__);
+	rtw_ps_deny_cancel(adapter, PS_DENY_BEAMFORMING);
+}
+
+static void _sounding_timer_handler(void *FunctionContext)
+{
+	PADAPTER adapter;
+	struct beamforming_info	*info;
+	struct sounding_info *sounding;
+	static u8 delay =3D 0;
+
+
+	RTW_DBG("+%s\n", __func__);
+
+	adapter =3D (PADAPTER)FunctionContext;
+	info =3D GET_BEAMFORM_INFO(adapter);
+	sounding =3D &info->sounding_info;
+
+	if (SOUNDING_STATE_NONE =3D=3D sounding->state) {
+		RTW_INFO("%s: Stop!\n", __func__);
+		if (info->sounding_running)
+			RTW_WARN("%s: souding_running=3D%d when thread stop!\n",
+				 __func__, info->sounding_running);
+		return;
+	}
+
+	_set_timer(&info->sounding_timer, sounding->min_sounding_period);
+
+	if (!info->sounding_running) {
+		if (SOUNDING_STATE_INIT !=3D sounding->state) {
+			RTW_WARN("%s: state(%d) !=3D SOUNDING_STATE_INIT!!\n", __func__, soundi=
ng->state);
+			sounding->state =3D SOUNDING_STATE_INIT;
+		}
+		delay =3D 0;
+		info->sounding_running++;
+		rtw_bf_cmd(adapter, BEAMFORMING_CTRL_START_PERIOD, NULL, 0, 1);
+	} else {
+		if (delay !=3D 0xFF)
+			delay++;
+		RTW_WARN("%s: souding is still processing...(state:%d, running:%d, delay=
:%d)\n",
+			 __func__, sounding->state, info->sounding_running, delay);
+		if (delay > 3) {
+			RTW_WARN("%s: Stop sounding!!\n", __func__);
+			_sounding_force_stop(adapter);
+		}
+	}
+}
+
+static void _sounding_timeout_timer_handler(void *FunctionContext)
+{
+	PADAPTER adapter;
+	struct beamforming_info	*info;
+	struct sounding_info *sounding;
+	struct beamformee_entry *bfee;
+
+
+	RTW_WARN("+%s\n", __func__);
