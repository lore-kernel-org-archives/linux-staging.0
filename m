+
+	if (rtw_is_surprise_removed(Adapter)) {
+		RTW_INFO(FUNC_ADPT_FMT ": bSurpriseRemoved=3Dtrue Skip!\n", FUNC_ADPT_AR=
G(Adapter));
+		return;
+	}
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
