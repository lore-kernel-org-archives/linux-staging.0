+static int hostapd_driver_init(struct hostapd_iface *iface)
+{
+	struct wpa_init_params params;
+	size_t i;
+	struct hostapd_data *hapd =3D iface->bss[0];
+	struct hostapd_bss_config *conf =3D hapd->conf;
+	u8 *b =3D conf->bssid;
+	struct wpa_driver_capa capa;
+
+	if (hapd->driver =3D=3D NULL || hapd->driver->hapd_init =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "No hostapd driver wrapper available");
+		return -1;
+	}
+
+	/* Initialize the driver interface */
+	if (!(b[0] | b[1] | b[2] | b[3] | b[4] | b[5]))
+		b =3D NULL;
+
+	os_memset(&params, 0, sizeof(params));
+	params.bssid =3D b;
+	params.ifname =3D hapd->conf->iface;
+	params.ssid =3D (const u8 *) hapd->conf->ssid.ssid;
+	params.ssid_len =3D hapd->conf->ssid.ssid_len;
+	params.test_socket =3D hapd->conf->test_socket;
+	params.use_pae_group_addr =3D hapd->conf->use_pae_group_addr;
+
+	params.num_bridge =3D hapd->iface->num_bss;
+	params.bridge =3D os_zalloc(hapd->iface->num_bss * sizeof(char *));
+	if (params.bridge =3D=3D NULL)
+		return -1;
+	for (i =3D 0; i < hapd->iface->num_bss; i++) {
+		struct hostapd_data *bss =3D hapd->iface->bss[i];
+		if (bss->conf->bridge[0])
+			params.bridge[i] =3D bss->conf->bridge;
+	}
+
+	params.own_addr =3D hapd->own_addr;
+
+	hapd->drv_priv =3D hapd->driver->hapd_init(hapd, &params);
+	os_free(params.bridge);
+	if (hapd->drv_priv =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "%s driver initialization failed.",
+			   hapd->driver->name);
+		hapd->driver =3D NULL;
