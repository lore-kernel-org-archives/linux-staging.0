+static s16
+odm_inband_noise_monitor_ac_series(struct PHY_DM_STRUCT	*p_dm_odm, u8 is_p=
ause_dig, u8 igi_value, u32 max_time
+				  )
+{
+	s32          rxi_buf_anta, rxq_buf_anta; /*rxi_buf_antb, rxq_buf_antb;*/
+	s32	        value32, pwdb_A =3D 0, sval, noise, sum;
+	bool	        pd_flag;
+	u8			i, valid_cnt;
+	u64	start =3D 0, func_start =3D 0, func_end =3D 0;
+
+
+	if (!(p_dm_odm->support_ic_type & (ODM_RTL8812 | ODM_RTL8821 | ODM_RTL881=
4A)))
+		return 0;
+
+	func_start =3D odm_get_current_time(p_dm_odm);
+	p_dm_odm->noise_level.noise_all =3D 0;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_COMMON, ODM_DBG_LOUD, ("odm_inband_noise_=
monitor_ac_series() =3D=3D>\n"));
+
+	/* step 1. Disable DIG && Set initial gain. */
+	if (is_pause_dig)
+		odm_pause_dig(p_dm_odm, PHYDM_PAUSE, PHYDM_PAUSE_LEVEL_1, igi_value);
+
+	/* step 2. Disable all power save for read registers */
+	/*dcmd_DebugControlPowerSave(p_adapter, PSDisable); */
+
+	/* step 3. Get noise power level */
+	start =3D odm_get_current_time(p_dm_odm);
+
+	/* reset counters */
+	sum =3D 0;
+	valid_cnt =3D 0;
+
+	/* step 3. Get noise power level */
+	while (1) {
+		/*Set IGI=3D0x1C */
+		odm_write_dig(p_dm_odm, 0x1C);
+		/*stop CK320&CK88 */
+		odm_set_bb_reg(p_dm_odm, 0x8B4, BIT(6), 1);
+		/*Read path-A */
+		odm_set_bb_reg(p_dm_odm, 0x8FC, MASKDWORD, 0x200); /*set debug port*/
+		value32 =3D odm_get_bb_reg(p_dm_odm, 0xFA0, MASKDWORD); /*read debug por=
t*/
+
+		rxi_buf_anta =3D (value32 & 0xFFC00) >> 10; /*rxi_buf_anta=3DRegFA0[19:1=
0]*/
+		rxq_buf_anta =3D value32 & 0x3FF; /*rxq_buf_anta=3DRegFA0[19:10]*/
+
+		pd_flag =3D (bool)((value32 & BIT(31)) >> 31);
+
+		/*Not in packet detection period or Tx state */
+		if ((!pd_flag) || (rxi_buf_anta !=3D 0x200)) {
+			/*sign conversion*/
+			rxi_buf_anta =3D odm_sign_conversion(rxi_buf_anta, 10);
+			rxq_buf_anta =3D odm_sign_conversion(rxq_buf_anta, 10);
+
+			pwdb_A =3D odm_pwdb_conversion(rxi_buf_anta * rxi_buf_anta + rxq_buf_an=
ta * rxq_buf_anta, 20, 18); /*S(10,9)*S(10,9)=3DS(20,18)*/
+
+			ODM_RT_TRACE(p_dm_odm, ODM_COMP_COMMON, ODM_DBG_LOUD, ("pwdb_A=3D %d dB=
, rxi_buf_anta=3D 0x%x, rxq_buf_anta=3D 0x%x\n", pwdb_A, rxi_buf_anta & 0x3=
FF, rxq_buf_anta & 0x3FF));
+		}
+		/*Start CK320&CK88*/
+		odm_set_bb_reg(p_dm_odm, 0x8B4, BIT(6), 0);
+		/*BB Reset*/
+		odm_write_1byte(p_dm_odm, 0x02, odm_read_1byte(p_dm_odm, 0x02) & (~BIT(0=
)));
+		odm_write_1byte(p_dm_odm, 0x02, odm_read_1byte(p_dm_odm, 0x02) | BIT(0));
+		/*PMAC Reset*/
+		odm_write_1byte(p_dm_odm, 0xB03, odm_read_1byte(p_dm_odm, 0xB03) & (~BIT=
(0)));
+		odm_write_1byte(p_dm_odm, 0xB03, odm_read_1byte(p_dm_odm, 0xB03) | BIT(0=
));
+		/*CCK Reset*/
+		if (odm_read_1byte(p_dm_odm, 0x80B) & BIT(4)) {
+			odm_write_1byte(p_dm_odm, 0x80B, odm_read_1byte(p_dm_odm, 0x80B) & (~BI=
T(4)));
+			odm_write_1byte(p_dm_odm, 0x80B, odm_read_1byte(p_dm_odm, 0x80B) | BIT(=
4));
+		}
+
+		sval =3D pwdb_A;
+
+		if (sval < 0 && sval >=3D -27) {
+			if (valid_cnt < VALID_CNT) {
+				valid_cnt++;
+				sum +=3D sval;
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_COMMON, ODM_DBG_LOUD, ("Valid sval =3D=
 %d\n", sval));
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_COMMON, ODM_DBG_LOUD, ("Sum of sval =
=3D %d,\n", sum));
+				if ((valid_cnt >=3D VALID_CNT) || (odm_get_progressing_time(p_dm_odm, =
start) > max_time)) {
+					sum /=3D VALID_CNT;
+					ODM_RT_TRACE(p_dm_odm, ODM_COMP_COMMON, ODM_DBG_LOUD, ("After divided=
, sum =3D %d\n", sum));
+					break;
+				}
+			}
+		}
+	}
+
+	/*ADC backoff is 12dB,*/
+	/*Ptarget=3D0x1C-110=3D-82dBm*/
+	noise =3D sum + 12 + 0x1C - 110;
+
+	/*Offset*/
+	noise =3D noise - 3;
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_COMMON, ODM_DBG_LOUD, ("noise =3D %d\n", =
noise));
+	p_dm_odm->noise_level.noise_all =3D (s16)noise;
+
+	/* step 4. Recover the Dig*/
+	if (is_pause_dig)
+		odm_pause_dig(p_dm_odm, PHYDM_RESUME, PHYDM_PAUSE_LEVEL_1, igi_value);
+
+	func_end =3D odm_get_progressing_time(p_dm_odm, func_start);
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_COMMON, ODM_DBG_LOUD, ("odm_inband_noise_=
monitor_ac_series() <=3D=3D\n"));
+
+	return p_dm_odm->noise_level.noise_all;
+}
+
+s16
+odm_inband_noise_monitor(void *p_dm_void, u8 is_pause_dig, u8 igi_value, u=
32 max_time)
+{
+
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	if (p_dm_odm->support_ic_type & ODM_IC_11AC_SERIES)
+		return odm_inband_noise_monitor_ac_series(p_dm_odm, is_pause_dig, igi_va=
lue, max_time);
+	else
+		return odm_inband_noise_monitor_n_series(p_dm_odm, is_pause_dig, igi_val=
ue, max_time);
+}
