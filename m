+u32
+odm_convert_to_db(
+	u32	value)
+{
+	u8 i;
+	u8 j;
+	u32 dB;
+
+	value =3D value & 0xFFFF;
+
+	for (i =3D 0; i < 12; i++) {
+		if (value <=3D db_invert_table[i][7])
+			break;
+	}
+
+	if (i >=3D 12) {
+		return 96;	/* maximum 96 dB */
+	}
+
+	for (j =3D 0; j < 8; j++) {
+		if (value <=3D db_invert_table[i][j])
+			break;
+	}
+
+	dB =3D (i << 3) + j + 1;
+
+	return dB;
+}
+
+u32
+odm_convert_to_linear(
+	u32	value)
+{
+	u8 i;
+	u8 j;
+	u32 linear;
+
+	/* 1dB~96dB */
+
+	value =3D value & 0xFF;
+
+	i =3D (u8)((value - 1) >> 3);
+	j =3D (u8)(value - 1) - (i << 3);
+
+	linear =3D db_invert_table[i][j];
+
+	return linear;
+}
