+
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+
+	RTW_PRINT("set bssid:%pM\n", bssid);
+
+	if ((bssid[0] =3D=3D 0x00 && bssid[1] =3D=3D 0x00 && bssid[2] =3D=3D 0x00=
 && bssid[3] =3D=3D 0x00 && bssid[4] =3D=3D 0x00 && bssid[5] =3D=3D 0x00) ||
+	    (bssid[0] =3D=3D 0xFF && bssid[1] =3D=3D 0xFF && bssid[2] =3D=3D 0xFF=
 && bssid[3] =3D=3D 0xFF && bssid[4] =3D=3D 0xFF && bssid[5] =3D=3D 0xFF)) {
+		status =3D _FAIL;
+		goto exit;
+	}
+
+	_enter_critical_bh(&pmlmepriv->lock, &irqL);
+
+	RTW_INFO("Set BSSID under fw_state=3D0x%08x\n", get_fwstate(pmlmepriv));
+	if (check_fwstate(pmlmepriv, _FW_UNDER_SURVEY) )
+		goto handle_tkip_countermeasure;
+	else if (check_fwstate(pmlmepriv, _FW_UNDER_LINKING) )
+		goto release_mlme_lock;
+
+	if (check_fwstate(pmlmepriv, _FW_LINKED | WIFI_ADHOC_MASTER_STATE) ) {
+
+		if (!memcmp(&pmlmepriv->cur_network.network.MacAddress, bssid, ETH_ALEN)=
 ) {
+			if (check_fwstate(pmlmepriv, WIFI_STATION_STATE) =3D=3D false)
+				goto release_mlme_lock;/* it means driver is in WIFI_ADHOC_MASTER_STAT=
E, we needn't create bss again. */
