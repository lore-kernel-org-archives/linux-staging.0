+static void parse_routes(struct nlmsghdr *nl_hdr, struct route_info *rt_in=
fo)
+{
+	struct rtmsg *rt_msg;
+	struct rtattr *rt_attr;
+	int rt_len;
+
+	rt_msg =3D (struct rtmsg *) NLMSG_DATA(nl_hdr);
+	if ((rt_msg->rtm_family !=3D AF_INET) || (rt_msg->rtm_table !=3D RT_TABLE=
_MAIN))
+		return;
+
+	rt_attr =3D (struct rtattr *) RTM_RTA(rt_msg);
+	rt_len =3D RTM_PAYLOAD(nl_hdr);
+
+	for (; RTA_OK(rt_attr, rt_len); rt_attr =3D RTA_NEXT(rt_attr, rt_len)) {
+		switch (rt_attr->rta_type) {
+		case RTA_OIF:
+			rt_info->dev_index =3D *(int *) RTA_DATA(rt_attr);
+			break;
+		case RTA_GATEWAY:
+			rt_info->gateway.s_addr =3D *(u_int *) RTA_DATA(rt_attr);
+			break;
+		case RTA_PREFSRC:
+			rt_info->src_addr.s_addr =3D *(u_int *) RTA_DATA(rt_attr);
+			break;
+		case RTA_DST:
+			rt_info->dst_addr.s_addr =3D *(u_int *) RTA_DATA(rt_attr);
+			break;
+		}
+	}
+}
