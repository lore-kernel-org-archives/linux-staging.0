+		dst_ie +=3D 2;
+	}
+
+	/*copy remainder IE*/
+	if (pbackup_remainder_ie) {
+		memcpy(dst_ie, pbackup_remainder_ie, remainder_ielen);
+
+		rtw_mfree(pbackup_remainder_ie, remainder_ielen);
+	}
+
+	offset =3D (uint)(dst_ie - pie);
+	pnetwork_mlmeext->IELength =3D offset + remainder_ielen;
