+static struct radius_client *
+radius_server_read_clients(const char *client_file, int ipv6)
+{
+	FILE *f;
+	const int buf_size =3D 1024;
+	char *buf, *pos;
+	struct radius_client *clients, *tail, *entry;
+	int line =3D 0, mask, failed =3D 0, i;
+	struct in_addr addr;
+#ifdef CONFIG_IPV6
+	struct in6_addr addr6;
+#endif /* CONFIG_IPV6 */
+	unsigned int val;
+
+	f =3D fopen(client_file, "r");
+	if (f =3D=3D NULL) {
+		RADIUS_ERROR("Could not open client file '%s'", client_file);
+		return NULL;
+	}
+
+	buf =3D os_malloc(buf_size);
+	if (buf =3D=3D NULL) {
+		fclose(f);
+		return NULL;
+	}
+
+	clients =3D tail =3D NULL;
+	while (fgets(buf, buf_size, f)) {
+		/* Configuration file format:
+		 * 192.168.1.0/24 secret
+		 * 192.168.1.2 secret
+		 * fe80::211:22ff:fe33:4455/64 secretipv6
+		 */
+		line++;
+		buf[buf_size - 1] =3D '\0';
+		pos =3D buf;
+		while (*pos !=3D '\0' && *pos !=3D '\n')
+			pos++;
+		if (*pos =3D=3D '\n')
+			*pos =3D '\0';
+		if (*buf =3D=3D '\0' || *buf =3D=3D '#')
+			continue;
+
+		pos =3D buf;
+		while ((*pos >=3D '0' && *pos <=3D '9') || *pos =3D=3D '.' ||
+		       (*pos >=3D 'a' && *pos <=3D 'f') || *pos =3D=3D ':' ||
+		       (*pos >=3D 'A' && *pos <=3D 'F')) {
+			pos++;
+		}
+
+		if (*pos =3D=3D '\0') {
+			failed =3D 1;
+			break;
+		}
+
+		if (*pos =3D=3D '/') {
+			char *end;
+			*pos++ =3D '\0';
+			mask =3D strtol(pos, &end, 10);
+			if ((pos =3D=3D end) ||
+			    (mask < 0 || mask > (ipv6 ? 128 : 32))) {
+				failed =3D 1;
+				break;
+			}
+			pos =3D end;
+		} else {
+			mask =3D ipv6 ? 128 : 32;
+			*pos++ =3D '\0';
+		}
+
+		if (!ipv6 && inet_aton(buf, &addr) =3D=3D 0) {
+			failed =3D 1;
+			break;
+		}
+#ifdef CONFIG_IPV6
+		if (ipv6 && inet_pton(AF_INET6, buf, &addr6) <=3D 0) {
+			if (inet_pton(AF_INET, buf, &addr) <=3D 0) {
+				failed =3D 1;
+				break;
+			}
+			/* Convert IPv4 address to IPv6 */
+			if (mask <=3D 32)
+				mask +=3D (128 - 32);
+			os_memset(addr6.s6_addr, 0, 10);
+			addr6.s6_addr[10] =3D 0xff;
+			addr6.s6_addr[11] =3D 0xff;
+			os_memcpy(addr6.s6_addr + 12, (char *) &addr.s_addr,
+				  4);
+		}
+#endif /* CONFIG_IPV6 */
+
+		while (*pos =3D=3D ' ' || *pos =3D=3D '\t') {
+			pos++;
+		}
+
+		if (*pos =3D=3D '\0') {
+			failed =3D 1;
+			break;
+		}
+
+		entry =3D os_zalloc(sizeof(*entry));
+		if (entry =3D=3D NULL) {
+			failed =3D 1;
+			break;
+		}
+		entry->shared_secret =3D os_strdup(pos);
+		if (entry->shared_secret =3D=3D NULL) {
+			failed =3D 1;
+			os_free(entry);
+			break;
+		}
+		entry->shared_secret_len =3D os_strlen(entry->shared_secret);
+		entry->addr.s_addr =3D addr.s_addr;
+		if (!ipv6) {
+			val =3D 0;
+			for (i =3D 0; i < mask; i++)
+				val |=3D 1 << (31 - i);
+			entry->mask.s_addr =3D htonl(val);
+		}
+#ifdef CONFIG_IPV6
+		if (ipv6) {
+			int offset =3D mask / 8;
+
+			os_memcpy(entry->addr6.s6_addr, addr6.s6_addr, 16);
+			os_memset(entry->mask6.s6_addr, 0xff, offset);
+			val =3D 0;
+			for (i =3D 0; i < (mask % 8); i++)
+				val |=3D 1 << (7 - i);
+			if (offset < 16)
+				entry->mask6.s6_addr[offset] =3D val;
+		}
+#endif /* CONFIG_IPV6 */
+
+		if (tail =3D=3D NULL) {
+			clients =3D tail =3D entry;
+		} else {
+			tail->next =3D entry;
+			tail =3D entry;
+		}
+	}
+
+	if (failed) {
+		RADIUS_ERROR("Invalid line %d in '%s'", line, client_file);
+		radius_server_free_clients(NULL, clients);
+		clients =3D NULL;
+	}
+
+	os_free(buf);
+	fclose(f);
+
+	return clients;
+}
