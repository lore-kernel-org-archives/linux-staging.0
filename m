+			return ret;
+#endif /* CONFIG_INTEL_WIDI */
+
+		#ifdef CONFIG_IOCTL_CFG80211
+		if (padapter->wdinfo.driver_interface =3D=3D DRIVER_CFG80211)
+			adapter_wdev_data(padapter)->p2p_enabled =3D false;
+		#endif
+
+		pwdinfo->listen_channel =3D 0;
+
