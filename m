+			RTW_INFO(FUNC_ADPT_FMT" fix_rx_ampdu_accept:%u\n", FUNC_ADPT_ARG(adapte=
r), accept);
+		}
+	} else if (reason =3D=3D RX_AMPDU_DRV_SCAN) {
+		if (adapter->mlmeextpriv.sitesurvey_res.rx_ampdu_accept !=3D accept) {
+			adapter->mlmeextpriv.sitesurvey_res.rx_ampdu_accept =3D accept;
+			is_adj =3D true;
+			RTW_INFO(FUNC_ADPT_FMT" ss.rx_ampdu_accept:%u\n", FUNC_ADPT_ARG(adapter=
), accept);
+		}
+	}
+
+	return is_adj;
+}
