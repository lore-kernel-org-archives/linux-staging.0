index 000000000000..a2d6f1708838
--- /dev/null
+++ b/drivers/staging/rtl8188eu/hostapd-0.8/src/eap_server/eap_server_tnc.c
@@ -0,0 +1,582 @@
+/*
+ * EAP server method: EAP-TNC (Trusted Network Connect)
+ * Copyright (c) 2007-2010, Jouni Malinen <j@w1.fi>
+ *
