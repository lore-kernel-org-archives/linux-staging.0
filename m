+	os_free(sm->identity);
+	sm->identity =3D os_malloc(len ? len : 1);
+	if (sm->identity =3D=3D NULL) {
+		data->state =3D FAILURE;
+	} else {
+		os_memcpy(sm->identity, pos, len);
+		sm->identity_len =3D len;
+		data->state =3D SUCCESS;
+	}
+}
+
+
+static Boolean eap_identity_isDone(struct eap_sm *sm, void *priv)
+{
+	struct eap_identity_data *data =3D priv;
+	return data->state !=3D CONTINUE;
+}
+
+
+static Boolean eap_identity_isSuccess(struct eap_sm *sm, void *priv)
+{
+	struct eap_identity_data *data =3D priv;
+	return data->state =3D=3D SUCCESS;
+}
+
+
+int eap_server_identity_register(void)
+{
+	struct eap_method *eap;
+	int ret;
+
+	eap =3D eap_server_method_alloc(EAP_SERVER_METHOD_INTERFACE_VERSION,
+				      EAP_VENDOR_IETF, EAP_TYPE_IDENTITY,
+				      "Identity");
+	if (eap =3D=3D NULL)
+		return -1;
+
+	eap->init =3D eap_identity_init;
+	eap->initPickUp =3D eap_identity_initPickUp;
