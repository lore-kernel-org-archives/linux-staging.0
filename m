index 000000000000..3391245fe3cd
--- /dev/null
+++ b/drivers/staging/rtl8188eu/hostapd-0.8/src/tls/asn1.c
@@ -0,0 +1,212 @@
+/*
+ * ASN.1 DER parsing
+ * Copyright (c) 2006, Jouni Malinen <j@w1.fi>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * Alternatively, this software may be distributed under the terms of BSD
+ * license.
+ *
+ * See README and COPYING for more details.
+ */
+
+#include "includes.h"
+
+#include "common.h"
+#include "asn1.h"
+
+int asn1_get_next(const u8 *buf, size_t len, struct asn1_hdr *hdr)
+{
+	const u8 *pos, *end;
+	u8 tmp;
+
+	os_memset(hdr, 0, sizeof(*hdr));
+	pos =3D buf;
+	end =3D buf + len;
+
+	hdr->identifier =3D *pos++;
+	hdr->class =3D hdr->identifier >> 6;
+	hdr->constructed =3D !!(hdr->identifier & (1 << 5));
+
+	if ((hdr->identifier & 0x1f) =3D=3D 0x1f) {
+		hdr->tag =3D 0;
+		do {
+			if (pos >=3D end) {
+				wpa_printf(MSG_DEBUG, "ASN.1: Identifier "
+					   "underflow");
+				return -1;
+			}
+			tmp =3D *pos++;
+			wpa_printf(MSG_MSGDUMP, "ASN.1: Extended tag data: "
+				   "0x%02x", tmp);
+			hdr->tag =3D (hdr->tag << 7) | (tmp & 0x7f);
+		} while (tmp & 0x80);
+	} else
+		hdr->tag =3D hdr->identifier & 0x1f;
+
+	tmp =3D *pos++;
+	if (tmp & 0x80) {
+		if (tmp =3D=3D 0xff) {
+			wpa_printf(MSG_DEBUG, "ASN.1: Reserved length "
+				   "value 0xff used");
+			return -1;
+		}
+		tmp &=3D 0x7f; /* number of subsequent octets */
+		hdr->length =3D 0;
+		if (tmp > 4) {
+			wpa_printf(MSG_DEBUG, "ASN.1: Too long length field");
+			return -1;
+		}
+		while (tmp--) {
+			if (pos >=3D end) {
+				wpa_printf(MSG_DEBUG, "ASN.1: Length "
+					   "underflow");
+				return -1;
+			}
+			hdr->length =3D (hdr->length << 8) | *pos++;
+		}
+	} else {
+		/* Short form - length 0..127 in one octet */
+		hdr->length =3D tmp;
+	}
+
+	if (end < pos || hdr->length > (unsigned int) (end - pos)) {
+		wpa_printf(MSG_DEBUG, "ASN.1: Contents underflow");
+		return -1;
+	}
+
+	hdr->payload =3D pos;
+	return 0;
+}
+
+
+int asn1_parse_oid(const u8 *buf, size_t len, struct asn1_oid *oid)
+{
+	const u8 *pos, *end;
+	unsigned long val;
+	u8 tmp;
+
+	os_memset(oid, 0, sizeof(*oid));
+
+	pos =3D buf;
+	end =3D buf + len;
+
+	while (pos < end) {
+		val =3D 0;
+
+		do {
+			if (pos >=3D end)
+				return -1;
+			tmp =3D *pos++;
+			val =3D (val << 7) | (tmp & 0x7f);
+		} while (tmp & 0x80);
+
+		if (oid->len >=3D ASN1_MAX_OID_LEN) {
+			wpa_printf(MSG_DEBUG, "ASN.1: Too long OID value");
+			return -1;
+		}
+		if (oid->len =3D=3D 0) {
+			/*
+			 * The first octet encodes the first two object
+			 * identifier components in (X*40) + Y formula.
+			 * X =3D 0..2.
+			 */
+			oid->oid[0] =3D val / 40;
+			if (oid->oid[0] > 2)
+				oid->oid[0] =3D 2;
+			oid->oid[1] =3D val - oid->oid[0] * 40;
+			oid->len =3D 2;
+		} else
+			oid->oid[oid->len++] =3D val;
+	}
+
+	return 0;
+}
+
+
+int asn1_get_oid(const u8 *buf, size_t len, struct asn1_oid *oid,
+		 const u8 **next)
+{
+	struct asn1_hdr hdr;
+
+	if (asn1_get_next(buf, len, &hdr) < 0 || hdr.length =3D=3D 0)
+		return -1;
+
+	if (hdr.class !=3D ASN1_CLASS_UNIVERSAL || hdr.tag !=3D ASN1_TAG_OID) {
+		wpa_printf(MSG_DEBUG, "ASN.1: Expected OID - found class %d "
+			   "tag 0x%x", hdr.class, hdr.tag);
+		return -1;
+	}
+
+	*next =3D hdr.payload + hdr.length;
+
+	return asn1_parse_oid(hdr.payload, hdr.length, oid);
+}
+
+
+void asn1_oid_to_str(struct asn1_oid *oid, char *buf, size_t len)
+{
+	char *pos =3D buf;
+	size_t i;
+	int ret;
+
+	if (len =3D=3D 0)
+		return;
+
+	buf[0] =3D '\0';
+
+	for (i =3D 0; i < oid->len; i++) {
+		ret =3D os_snprintf(pos, buf + len - pos,
+				  "%s%lu",
+				  i =3D=3D 0 ? "" : ".", oid->oid[i]);
+		if (ret < 0 || ret >=3D buf + len - pos)
+			break;
+		pos +=3D ret;
+	}
+	buf[len - 1] =3D '\0';
+}
+
+
+static u8 rotate_bits(u8 octet)
+{
+	int i;
+	u8 res;
+
+	res =3D 0;
+	for (i =3D 0; i < 8; i++) {
+		res <<=3D 1;
+		if (octet & 1)
+			res |=3D 1;
+		octet >>=3D 1;
+	}
+
+	return res;
+}
+
+
+unsigned long asn1_bit_string_to_long(const u8 *buf, size_t len)
+{
+	unsigned long val =3D 0;
+	const u8 *pos =3D buf;
+
+	/* BER requires that unused bits are zero, so we can ignore the number
+	 * of unused bits */
+	pos++;
+
+	if (len >=3D 2)
+		val |=3D rotate_bits(*pos++);
+	if (len >=3D 3)
+		val |=3D ((unsigned long) rotate_bits(*pos++)) << 8;
+	if (len >=3D 4)
+		val |=3D ((unsigned long) rotate_bits(*pos++)) << 16;
+	if (len >=3D 5)
+		val |=3D ((unsigned long) rotate_bits(*pos++)) << 24;
+	if (len >=3D 6)
+		wpa_printf(MSG_DEBUG, "X509: %s - some bits ignored "
+			   "(BIT STRING length %lu)",
+			   __func__, (unsigned long) len);
+
+	return val;
+}
