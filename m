+int crypto_mod_exp(const u8 *base, size_t base_len,
+		   const u8 *power, size_t power_len,
+		   const u8 *modulus, size_t modulus_len,
+		   u8 *result, size_t *result_len)
+{
+	void *b, *p, *m, *r;
+
+	if (mp_init_multi(&b, &p, &m, &r, NULL) !=3D CRYPT_OK)
+		return -1;
+
+	if (mp_read_unsigned_bin(b, (u8 *) base, base_len) !=3D CRYPT_OK ||
+	    mp_read_unsigned_bin(p, (u8 *) power, power_len) !=3D CRYPT_OK ||
+	    mp_read_unsigned_bin(m, (u8 *) modulus, modulus_len) !=3D CRYPT_OK)
+		goto fail;
+
+	if (mp_exptmod(b, p, m, r) !=3D CRYPT_OK)
+		goto fail;
+
+	*result_len =3D mp_unsigned_bin_size(r);
+	if (mp_to_unsigned_bin(r, result) !=3D CRYPT_OK)
+		goto fail;
+
+	mp_clear_multi(b, p, m, r, NULL);
+	return 0;
+
+fail:
+	mp_clear_multi(b, p, m, r, NULL);
+	return -1;
+}
+
+#endif /* CONFIG_MODEXP */
