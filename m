+static struct hostapd_data * get_hapd_bssid(struct hostapd_iface *iface,
+					    const u8 *bssid)
+{
+	size_t i;
+
+	if (bssid =3D=3D NULL)
+		return NULL;
+	if (bssid[0] =3D=3D 0xff && bssid[1] =3D=3D 0xff && bssid[2] =3D=3D 0xff =
&&
+	    bssid[3] =3D=3D 0xff && bssid[4] =3D=3D 0xff && bssid[5] =3D=3D 0xff)
+		return HAPD_BROADCAST;
+
+	for (i =3D 0; i < iface->num_bss; i++) {
+		if (os_memcmp(bssid, iface->bss[i]->own_addr, ETH_ALEN) =3D=3D 0)
+			return iface->bss[i];
+	}
+
+	return NULL;
+}
