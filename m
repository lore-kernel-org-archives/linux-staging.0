+void rtw_wow_pattern_write_cam_ent(_adapter *adapter, u8 id, struct  rtl_w=
ow_pattern *context)
+{
+	int j;
+	u8 addr;
+	u32 wdata =3D 0;
+
+	for (j =3D 4; j >=3D 0; j--) {
+		switch (j) {
+		case 4:
+			wdata =3D context->crc;
