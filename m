+static void
+phydm_traffic_load_decision(
+	void	*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _sw_antenna_switch_		*p_dm_swat_table =3D &p_dm_odm->dm_swat_table;
+
+	/*---TP & Trafic-load calculation---*/
+
+	if (p_dm_odm->last_tx_ok_cnt > (*(p_dm_odm->p_num_tx_bytes_unicast)))
+		p_dm_odm->last_tx_ok_cnt =3D (*(p_dm_odm->p_num_tx_bytes_unicast));
+
+	if (p_dm_odm->last_rx_ok_cnt > (*(p_dm_odm->p_num_rx_bytes_unicast)))
+		p_dm_odm->last_rx_ok_cnt =3D (*(p_dm_odm->p_num_rx_bytes_unicast));
+
+	p_dm_odm->cur_tx_ok_cnt =3D  *(p_dm_odm->p_num_tx_bytes_unicast) - p_dm_o=
dm->last_tx_ok_cnt;
+	p_dm_odm->cur_rx_ok_cnt =3D  *(p_dm_odm->p_num_rx_bytes_unicast) - p_dm_o=
dm->last_rx_ok_cnt;
+	p_dm_odm->last_tx_ok_cnt =3D  *(p_dm_odm->p_num_tx_bytes_unicast);
+	p_dm_odm->last_rx_ok_cnt =3D  *(p_dm_odm->p_num_rx_bytes_unicast);
+
+	p_dm_odm->tx_tp =3D ((p_dm_odm->tx_tp) >> 1) + (u32)(((p_dm_odm->cur_tx_o=
k_cnt) >> 18) >> 1); /* <<3(8bit), >>20(10^6,M), >>1(2sec)*/
+	p_dm_odm->rx_tp =3D ((p_dm_odm->rx_tp) >> 1) + (u32)(((p_dm_odm->cur_rx_o=
k_cnt) >> 18) >> 1); /* <<3(8bit), >>20(10^6,M), >>1(2sec)*/
+	p_dm_odm->total_tp =3D p_dm_odm->tx_tp + p_dm_odm->rx_tp;
+
+	if (p_dm_odm->total_tp =3D=3D 0)
+		p_dm_odm->consecutive_idlel_time +=3D PHYDM_WATCH_DOG_PERIOD;
+	else
+		p_dm_odm->consecutive_idlel_time =3D 0;
+
+	p_dm_odm->pre_traffic_load =3D p_dm_odm->traffic_load;
+
+	if (p_dm_odm->cur_tx_ok_cnt > 1875000 || p_dm_odm->cur_rx_ok_cnt > 187500=
0) {		/* ( 1.875M * 8bit ) / 2sec=3D 7.5M bits /sec )*/
+
+		p_dm_odm->traffic_load =3D TRAFFIC_HIGH;
+		/**/
+	} else if (p_dm_odm->cur_tx_ok_cnt > 500000 || p_dm_odm->cur_rx_ok_cnt > =
500000) { /*( 0.5M * 8bit ) / 2sec =3D  2M bits /sec )*/
+
+		p_dm_odm->traffic_load =3D TRAFFIC_MID;
+		/**/
+	} else if (p_dm_odm->cur_tx_ok_cnt > 100000 || p_dm_odm->cur_rx_ok_cnt > =
100000)  { /*( 0.1M * 8bit ) / 2sec =3D  0.4M bits /sec )*/
+
+		p_dm_odm->traffic_load =3D TRAFFIC_LOW;
+		/**/
+	} else {
+
+		p_dm_odm->traffic_load =3D TRAFFIC_ULTRA_LOW;
+		/**/
+	}
