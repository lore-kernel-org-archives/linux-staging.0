+static int rtw_wx_read32(struct net_device *dev,
+			 struct iw_request_info *info,
+			 union iwreq_data *wrqu, char *extra)
+{
+	PADAPTER padapter;
+	struct iw_point *p;
+	u16 len;
+	u32 addr;
+	u32 data32;
+	u32 bytes;
+	u8 *ptmp;
+	int ret;
+
+
+	ret =3D 0;
+	padapter =3D (PADAPTER)rtw_netdev_priv(dev);
+	p =3D &wrqu->data;
+	len =3D p->length;
+	if (0 =3D=3D len)
+		return -EINVAL;
+
+	ptmp =3D (u8 *)rtw_malloc(len);
+	if (NULL =3D=3D ptmp)
+		return -ENOMEM;
+
+	if (copy_from_user(ptmp, p->pointer, len)) {
+		ret =3D -EFAULT;
+		goto exit;
+	}
+
+	bytes =3D 0;
+	addr =3D 0;
+	sscanf(ptmp, "%d,%x", &bytes, &addr);
+
+	switch (bytes) {
+	case 1:
+		data32 =3D rtw_read8(padapter, addr);
+		sprintf(extra, "0x%02X", data32);
+		break;
+	case 2:
+		data32 =3D rtw_read16(padapter, addr);
+		sprintf(extra, "0x%04X", data32);
+		break;
+	case 4:
+		data32 =3D rtw_read32(padapter, addr);
+		sprintf(extra, "0x%08X", data32);
+		break;
+	default:
+		RTW_INFO("%s: usage> read [bytes],[address(hex)]\n", __func__);
+		ret =3D -EINVAL;
+		goto exit;
+	}
+	RTW_INFO("%s: addr=3D0x%08X data=3D%s\n", __func__, addr, extra);
+
+exit:
+	rtw_mfree(ptmp, len);
+
+	return 0;
+}
