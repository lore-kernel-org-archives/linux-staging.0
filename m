+static void
+usb_AggSettingTxUpdate(
+	PADAPTER			Adapter
+)
+{
+#ifdef CONFIG_USB_TX_AGGREGATION
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(Adapter);
+	/* PMGNT_INFO		pMgntInfo =3D &(Adapter->MgntInfo);	 */
+	u32			value32;
+
+	if (Adapter->registrypriv.wifi_spec)
+		pHalData->UsbTxAggMode =3D false;
+
+	if (pHalData->UsbTxAggMode) {
+		value32 =3D rtw_read32(Adapter, REG_TDECTRL);
+		value32 =3D value32 & ~(BLK_DESC_NUM_MASK << BLK_DESC_NUM_SHIFT);
+		value32 |=3D ((pHalData->UsbTxAggDescNum & BLK_DESC_NUM_MASK) << BLK_DES=
C_NUM_SHIFT);
+
+		rtw_write32(Adapter, REG_TDECTRL, value32);
+	}
+
+#endif
+}	/* usb_AggSettingTxUpdate */
