+void WMMOnAssocRsp(_adapter *padapter)
+{
+	u8	ACI, ACM, AIFS, ECWMin, ECWMax, aSifsTime;
+	u8	acm_mask;
+	u16	TXOP;
+	u32	acParm, i;
+	u32	edca[4], inx[4];
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	struct xmit_priv		*pxmitpriv =3D &padapter->xmitpriv;
+	struct registry_priv	*pregpriv =3D &padapter->registrypriv;
+
+	acm_mask =3D 0;
+
+	if (is_supported_5g(pmlmeext->cur_wireless_mode) ||
+	    (pmlmeext->cur_wireless_mode & WIRELESS_11_24N))
+		aSifsTime =3D 16;
+	else
+		aSifsTime =3D 10;
+
+	if (pmlmeinfo->WMM_enable =3D=3D 0) {
+		padapter->mlmepriv.acm_mask =3D 0;
+
+		AIFS =3D aSifsTime + (2 * pmlmeinfo->slotTime);
+
+		if (pmlmeext->cur_wireless_mode & (WIRELESS_11G | WIRELESS_11A)) {
+			ECWMin =3D 4;
+			ECWMax =3D 10;
+		} else if (pmlmeext->cur_wireless_mode & WIRELESS_11B) {
+			ECWMin =3D 5;
+			ECWMax =3D 10;
+		} else {
+			ECWMin =3D 4;
+			ECWMax =3D 10;
+		}
+
+		TXOP =3D 0;
+		acParm =3D AIFS | (ECWMin << 8) | (ECWMax << 12) | (TXOP << 16);
+		rtw_hal_set_hwreg(padapter, HW_VAR_AC_PARAM_BE, (u8 *)(&acParm));
+		rtw_hal_set_hwreg(padapter, HW_VAR_AC_PARAM_BK, (u8 *)(&acParm));
+		rtw_hal_set_hwreg(padapter, HW_VAR_AC_PARAM_VI, (u8 *)(&acParm));
+
+		ECWMin =3D 2;
+		ECWMax =3D 3;
+		TXOP =3D 0x2f;
+		acParm =3D AIFS | (ECWMin << 8) | (ECWMax << 12) | (TXOP << 16);
+		rtw_hal_set_hwreg(padapter, HW_VAR_AC_PARAM_VO, (u8 *)(&acParm));
+	} else {
+		edca[0] =3D edca[1] =3D edca[2] =3D edca[3] =3D 0;
+
+		for (i =3D 0; i < 4; i++) {
+			ACI =3D (pmlmeinfo->WMM_param.ac_param[i].ACI_AIFSN >> 5) & 0x03;
+			ACM =3D (pmlmeinfo->WMM_param.ac_param[i].ACI_AIFSN >> 4) & 0x01;
+
+			/* AIFS =3D AIFSN * slot time + SIFS - r2t phy delay */
+			AIFS =3D (pmlmeinfo->WMM_param.ac_param[i].ACI_AIFSN & 0x0f) * pmlmeinf=
o->slotTime + aSifsTime;
+
+			ECWMin =3D (pmlmeinfo->WMM_param.ac_param[i].CW & 0x0f);
+			ECWMax =3D (pmlmeinfo->WMM_param.ac_param[i].CW & 0xf0) >> 4;
+			TXOP =3D le16_to_cpu(pmlmeinfo->WMM_param.ac_param[i].TXOP_limit);
+
+			acParm =3D AIFS | (ECWMin << 8) | (ECWMax << 12) | (TXOP << 16);
+
+			switch (ACI) {
+			case 0x0:
+				rtw_hal_set_hwreg(padapter, HW_VAR_AC_PARAM_BE, (u8 *)(&acParm));
+				acm_mask |=3D (ACM ? BIT(1) : 0);
+				edca[XMIT_BE_QUEUE] =3D acParm;
+				break;
+
+			case 0x1:
+				rtw_hal_set_hwreg(padapter, HW_VAR_AC_PARAM_BK, (u8 *)(&acParm));
+				/* acm_mask |=3D (ACM? BIT(0):0); */
+				edca[XMIT_BK_QUEUE] =3D acParm;
+				break;
+
+			case 0x2:
+				rtw_hal_set_hwreg(padapter, HW_VAR_AC_PARAM_VI, (u8 *)(&acParm));
+				acm_mask |=3D (ACM ? BIT(2) : 0);
+				edca[XMIT_VI_QUEUE] =3D acParm;
+				break;
+
+			case 0x3:
+				rtw_hal_set_hwreg(padapter, HW_VAR_AC_PARAM_VO, (u8 *)(&acParm));
+				acm_mask |=3D (ACM ? BIT(3) : 0);
+				edca[XMIT_VO_QUEUE] =3D acParm;
+				break;
+			}
+
+			RTW_INFO("WMM(%x): %x, %x\n", ACI, ACM, acParm);
+		}
+
+		if (padapter->registrypriv.acm_method =3D=3D 1)
+			rtw_hal_set_hwreg(padapter, HW_VAR_ACM_CTRL, (u8 *)(&acm_mask));
+		else
+			padapter->mlmepriv.acm_mask =3D acm_mask;
+
+		inx[0] =3D 0;
+		inx[1] =3D 1;
+		inx[2] =3D 2;
+		inx[3] =3D 3;
+
+		if (pregpriv->wifi_spec =3D=3D 1) {
+			u32	j, tmp, change_inx =3D false;
+
+			/* entry indx: 0->vo, 1->vi, 2->be, 3->bk. */
+			for (i =3D 0; i < 4; i++) {
+				for (j =3D i + 1; j < 4; j++) {
+					/* compare CW and AIFS */
+					if ((edca[j] & 0xFFFF) < (edca[i] & 0xFFFF))
+						change_inx =3D true;
+					else if ((edca[j] & 0xFFFF) =3D=3D (edca[i] & 0xFFFF)) {
+						/* compare TXOP */
+						if ((edca[j] >> 16) > (edca[i] >> 16))
+							change_inx =3D true;
+					}
+
+					if (change_inx) {
+						tmp =3D edca[i];
+						edca[i] =3D edca[j];
+						edca[j] =3D tmp;
+
+						tmp =3D inx[i];
+						inx[i] =3D inx[j];
+						inx[j] =3D tmp;
+
+						change_inx =3D false;
+					}
+				}
+			}
+		}
+
+		for (i =3D 0; i < 4; i++) {
+			pxmitpriv->wmm_para_seq[i] =3D inx[i];
+			RTW_INFO("wmm_para_seq(%d): %d\n", i, pxmitpriv->wmm_para_seq[i]);
+		}
+#ifdef CONFIG_WMMPS
+		if (pmlmeinfo->WMM_param.QoS_info & BIT(7))
+			rtw_hal_set_hwreg(padapter, HW_VAR_UAPSD_TID, NULL);
+#endif
+	}
+}
