+void ByteToBit(
+	u8	*out,
+	bool	*in,
+	u8	in_size)
+{
+	u8 i =3D 0, j =3D 0;
+
+	for (i =3D 0; i < in_size; i++) {
+		for (j =3D 0; j < 8; j++) {
+			if (in[8 * i + j])
+				out[i] |=3D (1 << j);
+		}
+	}
+}
