+static void _phy_lc_calibrate_8188e(struct PHY_DM_STRUCT *p_dm_odm, bool i=
s2T)
+{
+	u8	tmp_reg;
+	u32	rf_amode =3D 0, rf_bmode =3D 0, lc_cal;
+	struct _ADAPTER *p_adapter =3D p_dm_odm->adapter;
+	/* Check continuous TX and Packet TX */
+	tmp_reg =3D odm_read_1byte(p_dm_odm, 0xd03);
+
+	if ((tmp_reg & 0x70) !=3D 0)			/* Deal with contisuous TX case */
+		odm_write_1byte(p_dm_odm, 0xd03, tmp_reg & 0x8F);	/* disable all continu=
ous TX */
+	else							/* Deal with Packet TX case */
+		odm_write_1byte(p_dm_odm, REG_TXPAUSE, 0xFF);			/* block all queues */
+
+	if ((tmp_reg & 0x70) !=3D 0) {
+		/* 1. Read original RF mode */
+		/* path-A */
+		rf_amode =3D phy_query_rf_reg(p_adapter, ODM_RF_PATH_A, RF_AC, MASK12BIT=
S);
+
+		/* path-B */
+		if (is2T)
+			rf_bmode =3D phy_query_rf_reg(p_adapter, ODM_RF_PATH_B, RF_AC, MASK12BI=
TS);
+
+		/* 2. Set RF mode =3D standby mode */
+		/* path-A */
+		odm_set_rf_reg(p_dm_odm, ODM_RF_PATH_A, RF_AC, MASK12BITS, (rf_amode & 0=
x8FFFF) | 0x10000);
+
+		/* path-B */
+		if (is2T)
+			odm_set_rf_reg(p_dm_odm, ODM_RF_PATH_B, RF_AC, MASK12BITS, (rf_bmode & =
0x8FFFF) | 0x10000);
+	}
+
+	/* 3. Read RF reg18 */
+	lc_cal =3D phy_query_rf_reg(p_adapter, ODM_RF_PATH_A, RF_CHNLBW, MASK12BI=
TS);
+
+	/* 4. Set LC calibration begin	bit15 */
+	odm_set_rf_reg(p_dm_odm, ODM_RF_PATH_A, RF_CHNLBW, MASK12BITS, lc_cal | 0=
x08000);
+
+	ODM_delay_ms(100);
+
+	/* Restore original situation */
+	if ((tmp_reg & 0x70) !=3D 0) {	/* Deal with contisuous TX case */
+		/* path-A */
+		odm_write_1byte(p_dm_odm, 0xd03, tmp_reg);
+		odm_set_rf_reg(p_dm_odm, ODM_RF_PATH_A, RF_AC, MASK12BITS, rf_amode);
+
+		/* path-B */
+		if (is2T)
+			odm_set_rf_reg(p_dm_odm, ODM_RF_PATH_B, RF_AC, MASK12BITS, rf_bmode);
+	} else /* Deal with Packet TX case */
+		odm_write_1byte(p_dm_odm, REG_TXPAUSE, 0x00);
+}
