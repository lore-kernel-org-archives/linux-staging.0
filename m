+static void openssl_tls_fail_event(struct tls_connection *conn,
+				   X509 *err_cert, int err, int depth,
+				   const char *subject, const char *err_str,
+				   enum tls_fail_reason reason)
+{
+	union tls_event_data ev;
+	struct wpabuf *cert =3D NULL;
+
+	if (tls_global->event_cb =3D=3D NULL)
+		return;
+
+	cert =3D get_x509_cert(err_cert);
+	os_memset(&ev, 0, sizeof(ev));
+	ev.cert_fail.reason =3D reason !=3D TLS_FAIL_UNSPECIFIED ?
+		reason : openssl_tls_fail_reason(err);
+	ev.cert_fail.depth =3D depth;
+	ev.cert_fail.subject =3D subject;
+	ev.cert_fail.reason_txt =3D err_str;
+	ev.cert_fail.cert =3D cert;
+	tls_global->event_cb(tls_global->cb_ctx, TLS_CERT_CHAIN_FAILURE, &ev);
+	wpabuf_free(cert);
+}
