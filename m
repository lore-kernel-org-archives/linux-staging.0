+	i =3D (int *) iwr.u.name;
+	*i++ =3D param;
+	*i++ =3D value;
+
+	if (ioctl(drv->sock, PRISM2_IOCTL_PRISM2_PARAM, &iwr) < 0) {
+		perror("ioctl[PRISM2_IOCTL_PRISM2_PARAM]");
