+int rtw_ap_inform_ch_switch(_adapter *padapter, u8 new_ch, u8 ch_offset)
+{
+	unsigned long irqL;
+	_list	*phead, *plist;
+	int ret =3D 0;
+	struct sta_info *psta =3D NULL;
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+	struct mlme_ext_priv *pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	u8 bc_addr[ETH_ALEN] =3D {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+
+	if ((pmlmeinfo->state & 0x03) !=3D WIFI_FW_AP_STATE)
+		return ret;
+
+	RTW_INFO(FUNC_NDEV_FMT" with ch:%u, offset:%u\n",
+		 FUNC_NDEV_ARG(padapter->pnetdev), new_ch, ch_offset);
+
+	_enter_critical_bh(&pstapriv->asoc_list_lock, &irqL);
+	phead =3D &pstapriv->asoc_list;
+	plist =3D get_next(phead);
+
+	/* for each sta in asoc_queue */
+	while ((rtw_end_of_queue_search(phead, plist)) =3D=3D false) {
+		psta =3D LIST_CONTAINOR(plist, struct sta_info, asoc_list);
+		plist =3D get_next(plist);
+
+		issue_action_spct_ch_switch(padapter, psta->hwaddr, new_ch, ch_offset);
+		psta->expire_to =3D ((pstapriv->expire_to * 2) > 5) ? 5 : (pstapriv->exp=
ire_to * 2);
+	}
+	_exit_critical_bh(&pstapriv->asoc_list_lock, &irqL);
+
+	issue_action_spct_ch_switch(padapter, bc_addr, new_ch, ch_offset);
+
+	return ret;
+}
