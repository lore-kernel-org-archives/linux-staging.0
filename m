+	priv_args =3D rtw_private_args;
+	mp_priv_args =3D rtw_mp_private_args;
+	num_priv =3D sizeof(rtw_private_handler) / sizeof(iw_handler);
+	num_priv_args =3D sizeof(rtw_private_args) / sizeof(struct iw_priv_args);
+	num_mp_priv_args =3D sizeof(rtw_mp_private_args) / sizeof(struct iw_priv_=
args);
