+	sta_info.nc_index =3D 0;
+	memcpy(pframe + 17, (u8 *)&sta_info, 2);
+
+	attrib->pktlen =3D 19;
+	attrib->last_txcmdsz =3D attrib->pktlen;
+
+	dump_mgntframe(adapter, pmgntframe);
+
+	return true;
+}
+
+static u8 _send_vht_mu_ndpa_packet(PADAPTER adapter, CHANNEL_WIDTH bw)
+{
+	/* General */
+	struct xmit_priv		*pxmitpriv;
+	struct mlme_ext_priv		*pmlmeext;
+	struct xmit_frame		*pmgntframe;
+	/* Beamforming */
+	struct beamforming_info		*info;
+	struct sounding_info		*sounding;
+	struct beamformee_entry		*bfee;
+	struct ndpa_sta_info		sta_info;
+	/* MISC */
+	struct pkt_attrib		*attrib;
+	struct rtw_ieee80211_hdr	*pwlanhdr;
+	enum MGN_RATE txrate;
+	u8 *pframe;
+	u8 *ra =3D NULL;
+	u16 duration =3D 0;
+	u8 sequence =3D 0, aSifsTime =3D 0;
+	u8 i;
+
+
+	RTW_INFO("+%s\n", __func__);
+
+	pxmitpriv =3D &adapter->xmitpriv;
+	pmlmeext =3D &adapter->mlmeextpriv;
+	info =3D GET_BEAMFORM_INFO(adapter);
+	sounding =3D &info->sounding_info;
+
+	txrate =3D MGN_VHT2SS_MCS0;
+
+	/*
+	 * Fill the first MU BFee entry (STA1) MAC addr to destination address th=
en
+	 * HW will change A1 to broadcast addr.
+	 * 2015.05.28. Suggested by SD1 Chunchu.
+	 */
+	bfee =3D &info->bfee_entry[sounding->mu_sounding_list[0]];
+	ra =3D bfee->mac_addr;
+
+	pmgntframe =3D alloc_mgtxmitframe(pxmitpriv);
+	if (!pmgntframe) {
+		RTW_ERR("%s: alloc mgnt frame fail!\n", __func__);
+		return false;
+	}
+
+	/* update attribute */
+	attrib =3D &pmgntframe->attrib;
+	update_mgntframe_attrib(adapter, attrib);
+	/*attrib->type =3D WIFI_MGT_TYPE;*/ /* set in update_mgntframe_attrib() */
+	attrib->subtype =3D WIFI_NDPA;
+	attrib->bwmode =3D bw;
+	/*attrib->qsel =3D QSLT_MGNT;*/ /* set in update_mgntframe_attrib() */
+	attrib->rate =3D (u8)txrate;
+	/* Set TxBFPktType of Tx desc to unicast type if there is only one MU STA=
 for HW design */
+	if (info->sounding_info.candidate_mu_bfee_cnt > 1)
+		attrib->bf_pkt_type =3D 1;
+	else
+		attrib->bf_pkt_type =3D 0;
+
+	memset(pmgntframe->buf_addr, 0, TXDESC_OFFSET + WLANHDR_OFFSET);
+	pframe =3D pmgntframe->buf_addr + TXDESC_OFFSET;
+	pwlanhdr =3D (struct rtw_ieee80211_hdr *)pframe;
+
+	/* Frame control */
+	pwlanhdr->frame_ctl =3D 0;
+	set_frame_sub_type(pframe, attrib->subtype);
+
+	/* Duration */
+	if (is_supported_5g(pmlmeext->cur_wireless_mode) || is_supported_ht(pmlme=
ext->cur_wireless_mode))
+		aSifsTime =3D 16;
+	else
+		aSifsTime =3D 10;
+	duration =3D 2 * aSifsTime + 44;
+	if (bw =3D=3D CHANNEL_WIDTH_80)
+		duration +=3D 40;
+	else if (bw =3D=3D CHANNEL_WIDTH_40)
+		duration +=3D 87;
+	else
+		duration +=3D 180;
+	set_duration(pframe, duration);
+
+	/* RA */
+	memcpy(pwlanhdr->addr1, ra, ETH_ALEN);
+
+	/* TA */
+	memcpy(pwlanhdr->addr2, adapter_mac_addr(adapter), ETH_ALEN);
+
+	/* Sounding Sequence, bit0~1 is reserved */
+	sequence =3D info->sounding_sequence << 2;
+	if (info->sounding_sequence >=3D 0x3f)
+		info->sounding_sequence =3D 0;
+	else
+		info->sounding_sequence++;
+	memcpy(pframe + 16, &sequence, 1);
+
+	attrib->pktlen =3D 17;
+
+	/*
+	 * Construct STA info. for multiple STAs
+	 * STA Info1, ..., STA Info n
+	 */
+	for (i =3D 0; i < sounding->candidate_mu_bfee_cnt; i++) {
+		bfee =3D &info->bfee_entry[sounding->mu_sounding_list[i]];
+		sta_info.aid =3D bfee->aid;
+		sta_info.feedback_type =3D 1; /* 1'b1: MU */
+		sta_info.nc_index =3D 0;
+		memcpy(pframe + attrib->pktlen, (u8 *)&sta_info, 2);
+		attrib->pktlen +=3D 2;
+	}
+
+	attrib->last_txcmdsz =3D attrib->pktlen;
+
+	dump_mgntframe(adapter, pmgntframe);
+
+	return true;
+}
+
+static u8 _send_bf_report_poll(PADAPTER adapter, u8 *ra, u8 bFinalPoll)
+{
+	/* General */
+	struct xmit_priv *pxmitpriv;
+	struct xmit_frame *pmgntframe;
+	/* MISC */
+	struct pkt_attrib *attrib;
+	struct rtw_ieee80211_hdr *pwlanhdr;
+	u8 *pframe;
+
+
+	RTW_INFO("+%s: Send to " MAC_FMT "\n", __func__, MAC_ARG(ra));
+
+	pxmitpriv =3D &adapter->xmitpriv;
+
+	pmgntframe =3D alloc_mgtxmitframe(pxmitpriv);
+	if (!pmgntframe) {
+		RTW_ERR("%s: alloc mgnt frame fail!\n", __func__);
+		return false;
+	}
+
+	/* update attribute */
+	attrib =3D &pmgntframe->attrib;
+	update_mgntframe_attrib(adapter, attrib);
+	/*attrib->type =3D WIFI_MGT_TYPE;*/ /* set in update_mgntframe_attrib() */
+	attrib->subtype =3D WIFI_BF_REPORT_POLL;
+	attrib->bwmode =3D CHANNEL_WIDTH_20;
+	/*attrib->qsel =3D QSLT_MGNT;*/ /* set in update_mgntframe_attrib() */
+	attrib->rate =3D MGN_6M;
+	if (bFinalPoll)
+		attrib->bf_pkt_type =3D 3;
+	else
+		attrib->bf_pkt_type =3D 2;
+
+	memset(pmgntframe->buf_addr, 0, TXDESC_OFFSET + WLANHDR_OFFSET);
+	pframe =3D pmgntframe->buf_addr + TXDESC_OFFSET;
+	pwlanhdr =3D (struct rtw_ieee80211_hdr *)pframe;
+
+	/* Frame control */
+	pwlanhdr->frame_ctl =3D 0;
+	set_frame_sub_type(pframe, attrib->subtype);
+
+	/* Duration */
+	set_duration(pframe, 100);
+
+	/* RA */
+	memcpy(pwlanhdr->addr1, ra, ETH_ALEN);
+
+	/* TA */
+	memcpy(pwlanhdr->addr2, adapter_mac_addr(adapter), ETH_ALEN);
+
+	/* Feedback Segment Retransmission Bitmap */
+	pframe[16] =3D 0xFF;
+
+	attrib->pktlen =3D 17;
+	attrib->last_txcmdsz =3D attrib->pktlen;
+
+	dump_mgntframe(adapter, pmgntframe);
+
+	return true;
+}
