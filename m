+	struct rtl_wow_pattern wow_pattern;
+
+	total =3D pwrpriv->wowlan_pattern_idx;
+
+	if (total > MAX_WKFM_CAM_NUM)
+		total =3D MAX_WKFM_CAM_NUM;
+
+	for (i =3D 0 ; i < total ; i++) {
+		if (_SUCCESS =3D=3D rtw_hal_wow_pattern_generate(adapter, i, &wow_patter=
n)) {
