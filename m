+u8 rtw_set_802_11_add_key(_adapter *padapter, NDIS_802_11_KEY *key)
+{
+
+	uint	encryptionalgo;
+	u8 *pbssid;
+	struct sta_info *stainfo;
+	u8	bgroup =3D false;
+	u8	bgrouptkey =3D false;/* can be remove later */
+	u8	ret =3D _SUCCESS;
+
+	if (((key->KeyIndex & 0x80000000) =3D=3D 0) && ((key->KeyIndex & 0x400000=
00) > 0)) {
+
+		/* It is invalid to clear bit 31 and set bit 30. If the miniport driver =
encounters this combination, */
+		/* it must fail the request and return NDIS_STATUS_INVALID_DATA. */
+		ret =3D _FAIL;
+		goto exit;
+	}
+
+	if (key->KeyIndex & 0x40000000) {
+		/* Pairwise key */
+
+		pbssid =3D get_bssid(&padapter->mlmepriv);
+		stainfo =3D rtw_get_stainfo(&padapter->stapriv, pbssid);
+
+		if ((stainfo !=3D NULL) && (padapter->securitypriv.dot11AuthAlgrthm =3D=
=3D dot11AuthAlgrthm_8021X)) {
+			encryptionalgo =3D stainfo->dot118021XPrivacy;
+		} else {
+			encryptionalgo =3D padapter->securitypriv.dot11PrivacyAlgrthm;
+		}
+
+		if (key->KeyIndex & 0x000000FF) {
+			/* The key index is specified in the lower 8 bits by values of zero to =
255. */
+			/* The key index should be set to zero for a Pairwise key, and the driv=
er should fail with */
+			/* NDIS_STATUS_INVALID_DATA if the lower 8 bits is not zero */
+			ret =3D _FAIL;
+			goto exit;
+		}
+
+		/* check BSSID */
+		if (IS_MAC_ADDRESS_BROADCAST(key->BSSID) ) {
+
+			ret =3D false;
+			goto exit;
+		}
+
+		/* Check key length for TKIP. */
+		/* if(encryptionAlgorithm =3D=3D RT_ENC_TKIP_ENCRYPTION && key->KeyLengt=
h !=3D 32) */
+		if ((encryptionalgo =3D=3D _TKIP_) && (key->KeyLength !=3D 32)) {
+			ret =3D _FAIL;
+			goto exit;
+
+		}
+
+		/* Check key length for AES. */
+		if ((encryptionalgo =3D=3D _AES_) && (key->KeyLength !=3D 16)) {
+			/* For our supplicant, EAPPkt9x.vxd, cannot differentiate TKIP and AES =
case. */
+			if (key->KeyLength =3D=3D 32)
+				key->KeyLength =3D 16;
+			else {
+				ret =3D _FAIL;
+				goto exit;
+			}
+		}
+
+		/* Check key length for WEP. For NDTEST, 2005.01.27, by rcnjko. -> modif=
y checking condition*/
+		if (((encryptionalgo =3D=3D _WEP40_) && (key->KeyLength !=3D 5)) || ((en=
cryptionalgo =3D=3D _WEP104_) && (key->KeyLength !=3D 13))) {
+			ret =3D _FAIL;
+			goto exit;
+		}
+
+		bgroup =3D false;
+
+		/* Check the pairwise key. Added by Annie, 2005-07-06. */
+
+	} else {
+		/* Group key - KeyIndex(BIT30=3D=3D0) */
+
+		/* when add wep key through add key and didn't assigned encryption type =
before */
+		if ((padapter->securitypriv.ndisauthtype <=3D 3) && (padapter->securityp=
riv.dot118021XGrpPrivacy =3D=3D 0)) {
+
+			switch (key->KeyLength) {
+			case 5:
+				padapter->securitypriv.dot11PrivacyAlgrthm =3D _WEP40_;
+				break;
+			case 13:
+				padapter->securitypriv.dot11PrivacyAlgrthm =3D _WEP104_;
+				break;
+			default:
+				padapter->securitypriv.dot11PrivacyAlgrthm =3D _NO_PRIVACY_;
+				break;
+			}
+
+			encryptionalgo =3D padapter->securitypriv.dot11PrivacyAlgrthm;
+
+		} else {
+			encryptionalgo =3D padapter->securitypriv.dot118021XGrpPrivacy;
+
+		}
+
+		if ((check_fwstate(&padapter->mlmepriv, WIFI_ADHOC_STATE) ) && (IS_MAC_A=
DDRESS_BROADCAST(key->BSSID) =3D=3D false)) {
+			ret =3D _FAIL;
+			goto exit;
+		}
+
+		/* Check key length for TKIP */
+		if ((encryptionalgo =3D=3D _TKIP_) && (key->KeyLength !=3D 32)) {
+
+			ret =3D _FAIL;
+			goto exit;
+
+		} else if (encryptionalgo =3D=3D _AES_ && (key->KeyLength !=3D 16 && key=
->KeyLength !=3D 32)) {
+
+			/* Check key length for AES */
+			/* For NDTEST, we allow keylen=3D32 in this case. 2005.01.27, by rcnjko=
. */
+			ret =3D _FAIL;
+			goto exit;
+		}
+
+		/* Change the key length for EAPPkt9x.vxd. Added by Annie, 2005-11-03. */
+		if ((encryptionalgo =3D=3D  _AES_) && (key->KeyLength =3D=3D 32)) {
+			key->KeyLength =3D 16;
+		}
+
+		if (key->KeyIndex & 0x8000000) /* error ??? 0x8000_0000 */
+			bgrouptkey =3D true;
+
+		if ((check_fwstate(&padapter->mlmepriv, WIFI_ADHOC_STATE) ) && (check_fw=
state(&padapter->mlmepriv, _FW_LINKED) =3D=3D true))
+			bgrouptkey =3D true;
+
+		bgroup =3D true;
+
+	}
+
+	/* If WEP encryption algorithm, just call rtw_set_802_11_add_wep(). */
+	if ((padapter->securitypriv.dot11AuthAlgrthm !=3D dot11AuthAlgrthm_8021X)=
 && (encryptionalgo =3D=3D _WEP40_  || encryptionalgo =3D=3D _WEP104_)) {
+		u8 ret;
+		u32 keyindex;
+		u32 len =3D FIELD_OFFSET(NDIS_802_11_KEY, KeyMaterial) + key->KeyLength;
+		NDIS_802_11_WEP *wep =3D &padapter->securitypriv.ndiswep;
+
+		wep->Length =3D len;
+		keyindex =3D key->KeyIndex & 0x7fffffff;
+		wep->KeyIndex =3D keyindex ;
+		wep->KeyLength =3D key->KeyLength;
+
+		memcpy(wep->KeyMaterial, key->KeyMaterial, key->KeyLength);
+		memcpy(&(padapter->securitypriv.dot11DefKey[keyindex].skey[0]), key->Key=
Material, key->KeyLength);
+
+		padapter->securitypriv.dot11DefKeylen[keyindex] =3D key->KeyLength;
+		padapter->securitypriv.dot11PrivacyKeyIndex =3D keyindex;
+
+		ret =3D rtw_set_802_11_add_wep(padapter, wep);
+
+		goto exit;
+
+	}
+
+	if (key->KeyIndex & 0x20000000) {
+		/* SetRSC */
+		if (bgroup ) {
+			NDIS_802_11_KEY_RSC keysrc =3D key->KeyRSC & 0x00FFFFFFFFFFFFULL;
+			memcpy(&padapter->securitypriv.dot11Grprxpn, &keysrc, 8);
+		} else {
+			NDIS_802_11_KEY_RSC keysrc =3D key->KeyRSC & 0x00FFFFFFFFFFFFULL;
+			memcpy(&padapter->securitypriv.dot11Grptxpn, &keysrc, 8);
+		}
+
+	}
+
+	/* Indicate this key idx is used for TX */
+	/* Save the key in KeyMaterial */
+	if (bgroup ) { /* Group transmit key */
+		int res;
+
+		if (bgrouptkey )
+			padapter->securitypriv.dot118021XGrpKeyid =3D (u8)key->KeyIndex;
+
+		if ((key->KeyIndex & 0x3) =3D=3D 0) {
+			ret =3D _FAIL;
+			goto exit;
+		}
+
+		memset(&padapter->securitypriv.dot118021XGrpKey[(u8)((key->KeyIndex) & 0=
x03)], 0, 16);
+		memset(&padapter->securitypriv.dot118021XGrptxmickey[(u8)((key->KeyIndex=
) & 0x03)], 0, 16);
+		memset(&padapter->securitypriv.dot118021XGrprxmickey[(u8)((key->KeyIndex=
) & 0x03)], 0, 16);
+
+		if ((key->KeyIndex & 0x10000000)) {
+			memcpy(&padapter->securitypriv.dot118021XGrptxmickey[(u8)((key->KeyInde=
x) & 0x03)], key->KeyMaterial + 16, 8);
+			memcpy(&padapter->securitypriv.dot118021XGrprxmickey[(u8)((key->KeyInde=
x) & 0x03)], key->KeyMaterial + 24, 8);
+
+		} else {
+			memcpy(&padapter->securitypriv.dot118021XGrptxmickey[(u8)((key->KeyInde=
x) & 0x03)], key->KeyMaterial + 24, 8);
+			memcpy(&padapter->securitypriv.dot118021XGrprxmickey[(u8)((key->KeyInde=
x) & 0x03)], key->KeyMaterial + 16, 8);
+
+		}
+
+		/* set group key by index */
+		memcpy(&padapter->securitypriv.dot118021XGrpKey[(u8)((key->KeyIndex) & 0=
x03)], key->KeyMaterial, key->KeyLength);
+
+		key->KeyIndex =3D key->KeyIndex & 0x03;
+
+		padapter->securitypriv.binstallGrpkey =3D true;
+
+		padapter->securitypriv.bcheck_grpkey =3D false;
+
+		res =3D rtw_set_key(padapter, &padapter->securitypriv, key->KeyIndex, 1,=
 true);
+
+		if (res =3D=3D _FAIL)
+			ret =3D _FAIL;
+
+		goto exit;
+
+	} else { /* Pairwise Key */
+		u8 res;
+
+		pbssid =3D get_bssid(&padapter->mlmepriv);
+		stainfo =3D rtw_get_stainfo(&padapter->stapriv , pbssid);
+
+		if (stainfo !=3D NULL) {
+			memset(&stainfo->dot118021x_UncstKey, 0, 16); /* clear keybuffer */
+
+			memcpy(&stainfo->dot118021x_UncstKey, key->KeyMaterial, 16);
+
+			if (encryptionalgo =3D=3D _TKIP_) {
+				padapter->securitypriv.busetkipkey =3D false;
+
+				/* _set_timer(&padapter->securitypriv.tkip_timer, 50); */
+
+				/* if TKIP, save the Receive/Transmit MIC key in KeyMaterial[128-255] =
*/
+				if ((key->KeyIndex & 0x10000000)) {
+					memcpy(&stainfo->dot11tkiptxmickey, key->KeyMaterial + 16, 8);
+					memcpy(&stainfo->dot11tkiprxmickey, key->KeyMaterial + 24, 8);
+
+				} else {
+					memcpy(&stainfo->dot11tkiptxmickey, key->KeyMaterial + 24, 8);
+					memcpy(&stainfo->dot11tkiprxmickey, key->KeyMaterial + 16, 8);
+
+				}
+
+			} else if (encryptionalgo =3D=3D _AES_) {
+
+			}
+
+			/* Set key to CAM through H2C command */
+
+			res =3D rtw_setstakey_cmd(padapter, stainfo, UNICAST_KEY, true);
+
+			if (res =3D=3D false)
+				ret =3D _FAIL;
+		}
+	}
+
+exit:
+
+	return ret;
+}
