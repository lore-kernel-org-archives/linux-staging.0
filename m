+static u8
+odm_evm_db_to_percentage(
+	s8 value
+)
+{
+	/*  */
+	/* -33dB~0dB to 0%~99% */
+	/*  */
+	s8 ret_val;
+
+	ret_val =3D value;
+	ret_val /=3D 2;
+
+	/*dbg_print("value=3D%d\n", value);*/
+	/*ODM_RT_DISP(FRX, RX_PHY_SQ, ("EVMdbToPercentage92C value=3D%d / %x\n", =
ret_val, ret_val));*/
+#ifdef ODM_EVM_ENHANCE_ANTDIV
+	if (ret_val >=3D 0)
+		ret_val =3D 0;
+
+	if (ret_val <=3D -40)
+		ret_val =3D -40;
+
+	ret_val =3D 0 - ret_val;
+	ret_val *=3D 3;
+#else
+	if (ret_val >=3D 0)
+		ret_val =3D 0;
+
+	if (ret_val <=3D -33)
+		ret_val =3D -33;
+
+	ret_val =3D 0 - ret_val;
+	ret_val *=3D 3;
+
+	if (ret_val =3D=3D 99)
+		ret_val =3D 100;
+#endif
+
+	return (u8)ret_val;
+}
+
+static u8
+odm_evm_dbm_jaguar_series(
+	s8 value
+)
+{
+	s8 ret_val =3D value;
+
+	/* -33dB~0dB to 33dB ~ 0dB */
+	if (ret_val =3D=3D -128)
+		ret_val =3D 127;
+	else if (ret_val < 0)
+		ret_val =3D 0 - ret_val;
+
+	ret_val  =3D ret_val >> 1;
+	return (u8)ret_val;
+}
+
+static s16
+odm_cfo(
+	s8 value
+)
+{
+	s16  ret_val;
+
+	if (value < 0) {
+		ret_val =3D 0 - value;
+		ret_val =3D (ret_val << 1) + (ret_val >> 1) ;  /* *2.5~=3D312.5/2^7 */
+		ret_val =3D ret_val | BIT(12);  /* set bit12 as 1 for negative cfo */
+	} else {
+		ret_val =3D value;
+		ret_val =3D (ret_val << 1) + (ret_val >> 1) ; /* *2.5~=3D312.5/2^7 */
+	}
+	return ret_val;
+}
