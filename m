+	wpa_printf(MSG_DEBUG, "%s(ifname=3D%s)", __func__, ifname);
+
+	dl_list_for_each(bss, &drv->bss, struct test_driver_bss, list) {
+		if (strcmp(bss->ifname, ifname) !=3D 0)
+			continue;
+
+		for (prev_c =3D NULL, cli =3D drv->cli; cli;
+		     prev_c =3D cli, cli =3D cli->next) {
+			if (cli->bss !=3D bss)
+				continue;
+			if (prev_c)
+				prev_c->next =3D cli->next;
+			else
+				drv->cli =3D cli->next;
+			os_free(cli);
+			break;
+		}
+
+		dl_list_del(&bss->list);
+		test_driver_free_bss(bss);
