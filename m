+static unsigned int rtl8188eu_inirp_init(PADAPTER Adapter)
+{
+	u8 i;
+	struct recv_buf *precvbuf;
+	uint	status;
+	struct dvobj_priv *pdev =3D adapter_to_dvobj(Adapter);
+	struct intf_hdl *pintfhdl =3D &Adapter->iopriv.intf;
+	struct recv_priv *precvpriv =3D &(Adapter->recvpriv);
+	u32(*_read_port)(struct intf_hdl *pintfhdl, u32 addr, u32 cnt, u8 *pmem);
+#ifdef CONFIG_USB_INTERRUPT_IN_PIPE
+	HAL_DATA_TYPE *pHalData =3D GET_HAL_DATA(Adapter);
+	u32(*_read_interrupt)(struct intf_hdl *pintfhdl, u32 addr);
+#endif
+
+	_read_port =3D pintfhdl->io_ops._read_port;
+
+	status =3D _SUCCESS;
+
+	precvpriv->ff_hwaddr =3D RECV_BULK_IN_ADDR;
+
+	/* issue Rx irp to receive data	 */
+	precvbuf =3D (struct recv_buf *)precvpriv->precv_buf;
+	for (i =3D 0; i < NR_RECVBUFF; i++) {
+		if (_read_port(pintfhdl, precvpriv->ff_hwaddr, 0, (unsigned char *)precv=
buf) =3D=3D false) {
+			status =3D _FAIL;
+			goto exit;
+		}
+
+		precvbuf++;
+		precvpriv->free_recv_buf_queue_cnt--;
+	}
+
+#ifdef CONFIG_USB_INTERRUPT_IN_PIPE
+	if (pdev->RtInPipe[REALTEK_USB_IN_INT_EP_IDX] !=3D 0x05) {
+		status =3D _FAIL;
+		RTW_INFO("%s =3D>Warning !! Have not USB Int-IN pipe, RtIntInPipe(%d)!!!=
\n", __func__, pdev->RtInPipe[REALTEK_USB_IN_INT_EP_IDX]);
+		goto exit;
+	}
+	_read_interrupt =3D pintfhdl->io_ops._read_interrupt;
+	if (_read_interrupt(pintfhdl, RECV_INT_IN_ADDR) =3D=3D false) {
+		status =3D _FAIL;
+	}
+#endif
+
+exit:
+
+	return status;
+
+}
