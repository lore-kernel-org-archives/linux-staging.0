+
+		if (!next) {
+			if (dev->flags & P2P_DEV_PROBE_REQ_ONLY)
+				return NULL;
+
+			return &dev->info;
+		} else {
+			do {
+				dev =3D dl_list_first(&dev->list,
+						    struct p2p_device,
+						    list);
+				if (&dev->list =3D=3D &p2p->devices)
