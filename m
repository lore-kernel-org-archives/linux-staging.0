+	u8		TX_RATE =3D pPMacTxInfo->TX_RATE;
+
+	/*	TX_RATE & Nss	*/
+	if (MPT_IS_2SS_RATE(TX_RATE))
+		pPMacPktInfo->Nss =3D 2;
+	else if (MPT_IS_3SS_RATE(TX_RATE))
+		pPMacPktInfo->Nss =3D 3;
+	else if (MPT_IS_4SS_RATE(TX_RATE))
+		pPMacPktInfo->Nss =3D 4;
+	else
+		pPMacPktInfo->Nss =3D 1;
+
+	RTW_INFO("PMacTxInfo.Nss =3D%d\n", pPMacPktInfo->Nss);
+
+	/*	MCS & TX_RATE_HEX*/
+	if (MPT_IS_CCK_RATE(TX_RATE)) {
+		switch (TX_RATE) {
+		case MPT_RATE_1M:
+			TX_RATE_HEX =3D MCS =3D 0;
+			break;
+		case MPT_RATE_2M:
+			TX_RATE_HEX =3D MCS =3D 1;
+			break;
+		case MPT_RATE_55M:
+			TX_RATE_HEX =3D MCS =3D 2;
+			break;
+		case MPT_RATE_11M:
+			TX_RATE_HEX =3D MCS =3D 3;
+			break;
+		}
+	} else if (MPT_IS_OFDM_RATE(TX_RATE)) {
+		MCS =3D TX_RATE - MPT_RATE_6M;
+		TX_RATE_HEX =3D MCS + 4;
+	} else if (MPT_IS_HT_RATE(TX_RATE)) {
+		MCS =3D TX_RATE - MPT_RATE_MCS0;
+		TX_RATE_HEX =3D MCS + 12;
+	} else if (MPT_IS_VHT_RATE(TX_RATE)) {
+		TX_RATE_HEX =3D TX_RATE - MPT_RATE_VHT1SS_MCS0 + 44;
+
+		if (MPT_IS_VHT_2S_RATE(TX_RATE))
+			MCS =3D TX_RATE - MPT_RATE_VHT2SS_MCS0;
+		else if (MPT_IS_VHT_3S_RATE(TX_RATE))
+			MCS =3D TX_RATE - MPT_RATE_VHT3SS_MCS0;
+		else if (MPT_IS_VHT_4S_RATE(TX_RATE))
+			MCS =3D TX_RATE - MPT_RATE_VHT4SS_MCS0;
+		else
+			MCS =3D TX_RATE - MPT_RATE_VHT1SS_MCS0;
+	}
+
+	pPMacPktInfo->MCS =3D MCS;
+	pPMacTxInfo->TX_RATE_HEX =3D TX_RATE_HEX;
+
+	RTW_INFO(" MCS=3D%d, TX_RATE_HEX =3D0x%x\n", MCS, pPMacTxInfo->TX_RATE_HE=
X);
+	/*	mSTBC & Nsts*/
+	pPMacPktInfo->Nsts =3D pPMacPktInfo->Nss;
+	if (pPMacTxInfo->bSTBC) {
+		if (pPMacPktInfo->Nss =3D=3D 1) {
+			pPMacTxInfo->m_STBC =3D 2;
+			pPMacPktInfo->Nsts =3D pPMacPktInfo->Nss * 2;
+		} else
+			pPMacTxInfo->m_STBC =3D 1;
+	} else
+		pPMacTxInfo->m_STBC =3D 1;
+}
