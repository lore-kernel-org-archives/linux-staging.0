+	void	*p_dm_void,
+	u8	comp_steering_num_of_bfer
+)
+{
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u8 nr_index =3D 0;
+	u8 ndp_tx_rate;
+	/*Find nr*/
+	nr_index =3D tx_bf_nr(1, comp_steering_num_of_bfer);
