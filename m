+__inline static u8 *recvframe_push(union recv_frame *precvframe, sint sz)
+{
+	/* append data before rx_data */
+
+	/* add data to the start of recv_frame
+	*
+	*      This function extends the used data area of the recv_frame at the =
buffer
+	*      start. rx_data must be still larger than rx_head, after pushing.
+	*/
+
+	if (precvframe =3D=3D NULL)
+		return NULL;
+
+
+	precvframe->u.hdr.rx_data -=3D sz ;
+	if (precvframe->u.hdr.rx_data < precvframe->u.hdr.rx_head) {
+		precvframe->u.hdr.rx_data +=3D sz ;
+		return NULL;
+	}
+
+	precvframe->u.hdr.len +=3D sz;
+
+	return precvframe->u.hdr.rx_data;
+
+}
+
+
+__inline static u8 *recvframe_pull(union recv_frame *precvframe, sint sz)
+{
+	/* rx_data +=3D sz; move rx_data sz bytes  hereafter */
+
+	/* used for extract sz bytes from rx_data, update rx_data and return the =
updated rx_data to the caller */
+
+
+	if (precvframe =3D=3D NULL)
+		return NULL;
+
+
+	precvframe->u.hdr.rx_data +=3D sz;
+
+	if (precvframe->u.hdr.rx_data > precvframe->u.hdr.rx_tail) {
+		precvframe->u.hdr.rx_data -=3D sz;
+		return NULL;
+	}
+
+	precvframe->u.hdr.len -=3D sz;
+
+	return precvframe->u.hdr.rx_data;
+
+}
+
+__inline static u8 *recvframe_put(union recv_frame *precvframe, __le16 le_=
sz)
+{
+	s16 sz =3D le16_to_cpu(le_sz);
+	/* used for append sz bytes from ptr to rx_tail, update rx_tail and retur=
n the updated rx_tail to the caller */
+	/* after putting, rx_tail must be still larger than rx_end. */
+	unsigned char *prev_rx_tail;
+
+	if (!precvframe)
+		return NULL;
+
+	prev_rx_tail =3D precvframe->u.hdr.rx_tail;
+
+	precvframe->u.hdr.rx_tail +=3D sz;
+
+	if (precvframe->u.hdr.rx_tail > precvframe->u.hdr.rx_end) {
+		precvframe->u.hdr.rx_tail -=3D sz;
+		return NULL;
+	}
+
+	precvframe->u.hdr.len +=3D sz;
+
+	return precvframe->u.hdr.rx_tail;
+}
