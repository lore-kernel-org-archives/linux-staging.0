+	rk[1] =3D GETU32(cipherKey +  4);
+	rk[2] =3D GETU32(cipherKey +  8);
+	rk[3] =3D GETU32(cipherKey + 12);
+	for (i =3D 0; i < 10; i++) {
+		temp  =3D rk[3];
+		rk[4] =3D rk[0] ^
