+static void p2p_reg_class_intersect(const struct p2p_reg_class *a,
+				    const struct p2p_reg_class *b,
+				    struct p2p_reg_class *res)
+{
+	size_t i, j;
+
+	res->reg_class =3D a->reg_class;
+
+	for (i =3D 0; i < a->channels; i++) {
+		for (j =3D 0; j < b->channels; j++) {
+			if (a->channel[i] !=3D b->channel[j])
+				continue;
+			res->channel[res->channels] =3D a->channel[i];
+			res->channels++;
+			if (res->channels =3D=3D P2P_MAX_REG_CLASS_CHANNELS)
+				return;
+		}
+	}
+}
+
+
+/**
+ * p2p_channels_intersect - Intersection of supported channel lists
+ * @a: First set of supported channels
+ * @b: Second set of supported channels
+ * @res: Data structure for returning the intersection of support channels
+ *
+ * This function can be used to find a common set of supported channels. B=
oth
+ * input channels sets are assumed to use the same country code. If differ=
ent
+ * country codes are used, the regulatory class numbers may not be matched
+ * correctly and results are undefined.
+ */
+void p2p_channels_intersect(const struct p2p_channels *a,
+			    const struct p2p_channels *b,
+			    struct p2p_channels *res)
+{
+	size_t i, j;
+
+	os_memset(res, 0, sizeof(*res));
+
+	for (i =3D 0; i < a->reg_classes; i++) {
+		const struct p2p_reg_class *a_reg =3D &a->reg_class[i];
+		for (j =3D 0; j < b->reg_classes; j++) {
+			const struct p2p_reg_class *b_reg =3D &b->reg_class[j];
+			if (a_reg->reg_class !=3D b_reg->reg_class)
+				continue;
+			p2p_reg_class_intersect(
+				a_reg, b_reg,
+				&res->reg_class[res->reg_classes]);
+			if (res->reg_class[res->reg_classes].channels) {
+				res->reg_classes++;
+				if (res->reg_classes =3D=3D P2P_MAX_REG_CLASSES)
+					return;
+			}
+		}
+	}
+}
+
+
+/**
+ * p2p_channels_includes - Check whether a channel is included in the list
+ * @channels: List of supported channels
+ * @reg_class: Regulatory class of the channel to search
+ * @channel: Channel number of the channel to search
+ * Returns: 1 if channel was found or 0 if not
+ */
+int p2p_channels_includes(const struct p2p_channels *channels, u8 reg_clas=
s,
+			  u8 channel)
+{
+	size_t i, j;
+	for (i =3D 0; i < channels->reg_classes; i++) {
+		const struct p2p_reg_class *reg =3D &channels->reg_class[i];
+		if (reg->reg_class !=3D reg_class)
+			continue;
+		for (j =3D 0; j < reg->channels; j++) {
+			if (reg->channel[j] =3D=3D channel)
+				return 1;
+		}
+	}
+	return 0;
+}
+
+
+int p2p_supported_freq(struct p2p_data *p2p, unsigned int freq)
+{
+	u8 op_reg_class, op_channel;
+	if (p2p_freq_to_channel(p2p->cfg->country, freq,
+				&op_reg_class, &op_channel) < 0)
+		return 0;
+	return p2p_channels_includes(&p2p->cfg->channels, op_reg_class,
+				     op_channel);
+}
