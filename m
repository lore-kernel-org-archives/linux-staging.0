+static void wps_registrar_add_pbc_session(struct wps_registrar *reg,
+					  const u8 *addr, const u8 *uuid_e)
+{
+	struct wps_pbc_session *pbc, *prev =3D NULL;
+	struct os_time now;
+
+	os_get_time(&now);
+
+	pbc =3D reg->pbc_sessions;
+	while (pbc) {
+		if (os_memcmp(pbc->addr, addr, ETH_ALEN) =3D=3D 0 &&
+		    os_memcmp(pbc->uuid_e, uuid_e, WPS_UUID_LEN) =3D=3D 0) {
+			if (prev)
+				prev->next =3D pbc->next;
+			else
+				reg->pbc_sessions =3D pbc->next;
+			break;
+		}
+		prev =3D pbc;
+		pbc =3D pbc->next;
+	}
+
+	if (!pbc) {
+		pbc =3D os_zalloc(sizeof(*pbc));
+		if (pbc =3D=3D NULL)
+			return;
+		os_memcpy(pbc->addr, addr, ETH_ALEN);
+		if (uuid_e)
+			os_memcpy(pbc->uuid_e, uuid_e, WPS_UUID_LEN);
+	}
+
+	pbc->next =3D reg->pbc_sessions;
+	reg->pbc_sessions =3D pbc;
+	pbc->timestamp =3D now;
+
+	/* remove entries that have timed out */
+	prev =3D pbc;
+	pbc =3D pbc->next;
+
+	while (pbc) {
+		if (now.sec > pbc->timestamp.sec + WPS_PBC_WALK_TIME) {
+			prev->next =3D NULL;
+			wps_free_pbc_sessions(pbc);
+			break;
+		}
+		prev =3D pbc;
+		pbc =3D pbc->next;
+	}
+}
+
+
+static void wps_registrar_remove_pbc_session(struct wps_registrar *reg,
+					     const u8 *uuid_e)
+{
+	struct wps_pbc_session *pbc, *prev =3D NULL, *tmp;
+
+	pbc =3D reg->pbc_sessions;
+	while (pbc) {
+		if (os_memcmp(pbc->uuid_e, uuid_e, WPS_UUID_LEN) =3D=3D 0) {
+			if (prev)
+				prev->next =3D pbc->next;
+			else
+				reg->pbc_sessions =3D pbc->next;
+			tmp =3D pbc;
+			pbc =3D pbc->next;
+			wpa_printf(MSG_DEBUG, "WPS: Removing PBC session for "
+				   "addr=3D" MACSTR, MAC2STR(tmp->addr));
+			wpa_hexdump(MSG_DEBUG, "WPS: Removed UUID-E",
+				    tmp->uuid_e, WPS_UUID_LEN);
+			os_free(tmp);
+			continue;
+		}
+		prev =3D pbc;
+		pbc =3D pbc->next;
+	}
+}
+
+
+int wps_registrar_pbc_overlap(struct wps_registrar *reg,
+			      const u8 *addr, const u8 *uuid_e)
+{
+	int count =3D 0;
+	struct wps_pbc_session *pbc;
+	struct wps_pbc_session *first =3D NULL;
+	struct os_time now;
+
+	os_get_time(&now);
+
+	wpa_printf(MSG_DEBUG, "WPS: Checking active PBC sessions for overlap");
+
+	if (uuid_e) {
+		wpa_printf(MSG_DEBUG, "WPS: Add one for the requested UUID");
+		wpa_hexdump(MSG_DEBUG, "WPS: Requested UUID",
+			    uuid_e, WPS_UUID_LEN);
+		count++;
+	}
+
+	for (pbc =3D reg->pbc_sessions; pbc; pbc =3D pbc->next) {
+		wpa_printf(MSG_DEBUG, "WPS: Consider PBC session with " MACSTR,
+			   MAC2STR(pbc->addr));
+		wpa_hexdump(MSG_DEBUG, "WPS: UUID-E",
+			    pbc->uuid_e, WPS_UUID_LEN);
+		if (now.sec > pbc->timestamp.sec + WPS_PBC_WALK_TIME) {
+			wpa_printf(MSG_DEBUG, "WPS: PBC walk time has "
+				   "expired");
+			break;
+		}
+		if (first &&
+		    os_memcmp(pbc->uuid_e, first->uuid_e, WPS_UUID_LEN) =3D=3D 0) {
+			wpa_printf(MSG_DEBUG, "WPS: Same Enrollee");
+			continue; /* same Enrollee */
+		}
+		if (uuid_e =3D=3D NULL ||
+		    os_memcmp(uuid_e, pbc->uuid_e, WPS_UUID_LEN)) {
+			wpa_printf(MSG_DEBUG, "WPS: New Enrollee");
+			count++;
+		}
+		if (first =3D=3D NULL)
+			first =3D pbc;
+	}
+
+	wpa_printf(MSG_DEBUG, "WPS: %u active PBC session(s) found", count);
+
+	return count > 1 ? 1 : 0;
+}
+
