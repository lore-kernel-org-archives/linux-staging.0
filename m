+static u32 _rtw_wow_pattern_read_cam(_adapter *adapter, u8 addr)
+{
+	struct pwrctrl_priv *pwrpriv =3D adapter_to_pwrctl(adapter);
+	_mutex *mutex =3D &pwrpriv->wowlan_pattern_cam_mutex;
+
+	u32 rdata =3D 0;
+	u32 cnt =3D 0;
+	u32 start =3D 0;
+	u8 timeout =3D 0;
+	u8 rst =3D false;
+
+	_enter_critical_mutex(mutex, NULL);
+
+	rtw_write32(adapter, REG_WKFMCAM_CMD, BIT_WKFCAM_POLLING_V1 | BIT_WKFCAM_=
ADDR_V2(addr));
+
+	start =3D jiffies;
+	while (1) {
+		if (rtw_is_surprise_removed(adapter))
+			break;
+
+		cnt++;
+		if (0 =3D=3D (rtw_read32(adapter, REG_WKFMCAM_CMD) & BIT_WKFCAM_POLLING_=
V1)) {
+			rst =3D _SUCCESS;
+			break;
+		}
+		if (rtw_get_passing_time_ms(start) > WOW_CAM_ACCESS_TIMEOUT_MS) {
+			timeout =3D 1;
+			break;
+		}
+	}
+
+	rdata =3D rtw_read32(adapter, REG_WKFMCAM_RWD);
+
+	_exit_critical_mutex(mutex, NULL);
+
+	/*RTW_INFO("%s =3D=3D> addr:0x%02x , rdata:0x%08x\n", __func__, addr, rda=
ta);*/
+
+	if (timeout)
+		RTW_ERR(FUNC_ADPT_FMT" failed due to polling timeout\n", FUNC_ADPT_ARG(a=
dapter));
+
+	return rdata;
+}
+void rtw_wow_pattern_read_cam_ent(_adapter *adapter, u8 id, struct  rtl_wo=
w_pattern *context)
+{
+	int i;
+	u32 rdata;
+
+	memset(context, 0, sizeof(struct  rtl_wow_pattern));
+
+	for (i =3D 4; i >=3D 0; i--) {
+		rdata =3D _rtw_wow_pattern_read_cam(adapter, (id << 3) | i);
+
+		switch (i) {
+		case 4:
+			if (rdata & WOW_BC_BIT)
+				context->type =3D PATTERN_BROADCAST;
+			else if (rdata & WOW_MC_BIT)
+				context->type =3D PATTERN_MULTICAST;
+			else if (rdata & WOW_UC_BIT)
+				context->type =3D PATTERN_UNICAST;
+			else
+				context->type =3D PATTERN_INVALID;
+
+			context->crc =3D rdata & 0xFFFF;
+			break;
+		default:
+			memcpy(&context->mask[i], (u8 *)(&rdata), 4);
+			break;
+		}
+	}
+}
