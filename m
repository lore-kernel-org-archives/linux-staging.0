+static int test_send_probe_resp(void *ctx, const struct wpabuf *buf)
+{
+	struct wpa_driver_test_data *drv =3D ctx;
+	char resp[512], *pos, *end;
+	int ret;
+	const struct ieee80211_mgmt *mgmt;
+	const u8 *ie, *ie_end;
+
+	wpa_printf(MSG_DEBUG, "%s", __func__);
+	wpa_hexdump_buf(MSG_MSGDUMP, "Probe Response", buf);
+	if (wpabuf_len(buf) < 24)
+		return -1;
+	if (!drv->probe_from) {
+		wpa_printf(MSG_DEBUG, "%s: probe_from not set", __func__);
+		return -1;
+	}
+
+	pos =3D resp;
+	end =3D resp + sizeof(resp);
+
+	mgmt =3D wpabuf_head(buf);
+
+	/* reply: SCANRESP BSSID SSID IEs */
+	ret =3D os_snprintf(pos, end - pos, "SCANRESP " MACSTR " ",
+			  MAC2STR(mgmt->bssid));
+	if (ret < 0 || ret >=3D end - pos)
+		return -1;
+	pos +=3D ret;
+
+	ie =3D mgmt->u.probe_resp.variable;
+	ie_end =3D wpabuf_head_u8(buf) + wpabuf_len(buf);
+	if (ie_end - ie < 2 || ie[0] !=3D WLAN_EID_SSID ||
+	    ie + 2 + ie[1] > ie_end)
+		return -1;
+	pos +=3D wpa_snprintf_hex(pos, end - pos, ie + 2, ie[1]);
+
+	ret =3D os_snprintf(pos, end - pos, " ");
+	if (ret < 0 || ret >=3D end - pos)
+		return -1;
+	pos +=3D ret;
+	pos +=3D wpa_snprintf_hex(pos, end - pos, ie, ie_end - ie);
+
+	sendto(drv->test_socket, resp, pos - resp, 0,
+	       drv->probe_from, drv->probe_from_len);
+
+	return 0;
+}
