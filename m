+static void ieee80211n_get_pri_sec_chan(struct wpa_scan_res *bss,
+					int *pri_chan, int *sec_chan)
+{
+	struct ieee80211_ht_operation *oper;
+	struct ieee802_11_elems elems;
+
+	*pri_chan =3D *sec_chan =3D 0;
+
+	ieee802_11_parse_elems((u8 *) (bss + 1), bss->ie_len, &elems, 0);
+	if (elems.ht_operation &&
+	    elems.ht_operation_len >=3D sizeof(*oper)) {
+		oper =3D (struct ieee80211_ht_operation *) elems.ht_operation;
+		*pri_chan =3D oper->control_chan;
+		if (oper->ht_param & HT_INFO_HT_PARAM_REC_TRANS_CHNL_WIDTH) {
+			int sec =3D oper->ht_param &
+				HT_INFO_HT_PARAM_SECONDARY_CHNL_OFF_MASK;
+			if (sec =3D=3D HT_INFO_HT_PARAM_SECONDARY_CHNL_ABOVE)
+				*sec_chan =3D *pri_chan + 4;
+			else if (sec =3D=3D HT_INFO_HT_PARAM_SECONDARY_CHNL_BELOW)
+				*sec_chan =3D *pri_chan - 4;
+		}
+	}
+}
