+static void
+efuse_phymap_to_logical(u8 *phymap, u16 _offset, u16 _size_byte, u8  *pbuf)
+{
+	u8	*efuseTbl =3D NULL;
+	u8	rtemp8;
+	u16	eFuse_Addr =3D 0;
+	u8	offset, wren;
+	u16	i, j;
+	u16	**eFuseWord =3D NULL;
+	u16	efuse_utilized =3D 0;
+	u8	efuse_usage =3D 0;
+	u8	u1temp =3D 0;
+
+
+	efuseTbl =3D (u8 *)rtw_zmalloc(EFUSE_MAP_LEN_88E);
+	if (efuseTbl =3D=3D NULL) {
+		RTW_INFO("%s: alloc efuseTbl fail!\n", __func__);
+		goto exit;
+	}
+
+	eFuseWord =3D (u16 **)rtw_malloc2d(EFUSE_MAX_SECTION_88E, EFUSE_MAX_WORD_=
UNIT, 2);
+	if (eFuseWord =3D=3D NULL) {
+		RTW_INFO("%s: alloc eFuseWord fail!\n", __func__);
+		goto exit;
+	}
+
+	/* 0. Refresh efuse init map as all oxFF. */
+	for (i =3D 0; i < EFUSE_MAX_SECTION_88E; i++)
+		for (j =3D 0; j < EFUSE_MAX_WORD_UNIT; j++)
+			eFuseWord[i][j] =3D 0xFFFF;
+
+	/*  */
+	/* 1. Read the first byte to check if efuse is empty!!! */
+	/*  */
+	/*  */
+	rtemp8 =3D *(phymap + eFuse_Addr);
+	if (rtemp8 !=3D 0xFF) {
+		efuse_utilized++;
+		eFuse_Addr++;
+	} else {
+		RTW_INFO("EFUSE is empty efuse_Addr-%d efuse_data=3D%x\n", eFuse_Addr, r=
temp8);
+		goto exit;
+	}
+
+
+	/*  */
+	/* 2. Read real efuse content. Filter PG header and every section data. */
+	/*  */
+	while ((rtemp8 !=3D 0xFF) && (eFuse_Addr < EFUSE_REAL_CONTENT_LEN_88E)) {
+		/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("efuse_Addr-%d efuse_data=3D%x\n", =
eFuse_Addr-1, *rtemp8)); */
+
+		/* Check PG header for section num. */
+		if ((rtemp8 & 0x1F) =3D=3D 0x0F) {	/* extended header */
+			u1temp =3D ((rtemp8 & 0xE0) >> 5);
+			/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("extended header u1temp=3D%x *rtem=
p&0xE0 0x%x\n", u1temp, *rtemp8 & 0xE0)); */
+
+			/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("extended header u1temp=3D%x\n", u=
1temp)); */
+
+			rtemp8 =3D *(phymap + eFuse_Addr);
+
+			/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("extended header efuse_Addr-%d efu=
se_data=3D%x\n", eFuse_Addr, *rtemp8));	 */
+
+			if ((rtemp8 & 0x0F) =3D=3D 0x0F) {
+				eFuse_Addr++;
+				rtemp8 =3D *(phymap + eFuse_Addr);
+
+				if (rtemp8 !=3D 0xFF && (eFuse_Addr < EFUSE_REAL_CONTENT_LEN_88E))
+					eFuse_Addr++;
+				continue;
+			} else {
+				offset =3D ((rtemp8 & 0xF0) >> 1) | u1temp;
+				wren =3D (rtemp8 & 0x0F);
+				eFuse_Addr++;
+			}
+		} else {
+			offset =3D ((rtemp8 >> 4) & 0x0f);
+			wren =3D (rtemp8 & 0x0f);
+		}
+
+		if (offset < EFUSE_MAX_SECTION_88E) {
+			/* Get word enable value from PG header */
+			/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("Offset-%d Worden=3D%x\n", offset,=
 wren)); */
+
+			for (i =3D 0; i < EFUSE_MAX_WORD_UNIT; i++) {
+				/* Check word enable condition in the section				 */
+				if (!(wren & 0x01)) {
+					/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("Addr=3D%d\n", eFuse_Addr)); */
+					rtemp8 =3D *(phymap + eFuse_Addr);
+					eFuse_Addr++;
+					/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("Data=3D0x%x\n", *rtemp8)); 				=
 */
+					efuse_utilized++;
+					eFuseWord[offset][i] =3D (rtemp8 & 0xff);
+
+
+					if (eFuse_Addr >=3D EFUSE_REAL_CONTENT_LEN_88E)
+						break;
+
+					/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("Addr=3D%d", eFuse_Addr)); */
+					rtemp8 =3D *(phymap + eFuse_Addr);
+					eFuse_Addr++;
+					/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("Data=3D0x%x\n", *rtemp8)); 				=
 */
+
+					efuse_utilized++;
+					eFuseWord[offset][i] |=3D (((u16)rtemp8 << 8) & 0xff00);
+
+					if (eFuse_Addr >=3D EFUSE_REAL_CONTENT_LEN_88E)
+						break;
+				}
+
+				wren >>=3D 1;
+
+			}
+		}
+
+		/* Read next PG header */
+		rtemp8 =3D *(phymap + eFuse_Addr);
+		/* RTPRINT(FEEPROM, EFUSE_READ_ALL, ("Addr=3D%d rtemp 0x%x\n", eFuse_Add=
r, *rtemp8)); */
+
+		if (rtemp8 !=3D 0xFF && (eFuse_Addr < EFUSE_REAL_CONTENT_LEN_88E)) {
+			efuse_utilized++;
+			eFuse_Addr++;
+		}
+	}
+
+	/*  */
+	/* 3. Collect 16 sections and 4 word unit into Efuse map. */
+	/*  */
+	for (i =3D 0; i < EFUSE_MAX_SECTION_88E; i++) {
+		for (j =3D 0; j < EFUSE_MAX_WORD_UNIT; j++) {
+			efuseTbl[(i * 8) + (j * 2)] =3D (eFuseWord[i][j] & 0xff);
+			efuseTbl[(i * 8) + ((j * 2) + 1)] =3D ((eFuseWord[i][j] >> 8) & 0xff);
+		}
+	}
+
+
+	/*  */
+	/* 4. Copy from Efuse map to output pointer memory!!! */
+	/*  */
+	for (i =3D 0; i < _size_byte; i++)
+		pbuf[i] =3D efuseTbl[_offset + i];
+
+	/*  */
+	/* 5. Calculate Efuse utilization. */
+	/*  */
+	efuse_usage =3D (u8)((efuse_utilized * 100) / EFUSE_REAL_CONTENT_LEN_88E);
+	/* rtw_hal_set_hwreg(Adapter, HW_VAR_EFUSE_BYTES, (u8 *)&efuse_utilized);=
 */
+
+exit:
+	if (efuseTbl)
+		rtw_mfree(efuseTbl, EFUSE_MAP_LEN_88E);
+
+	if (eFuseWord)
+		rtw_mfree2d((void *)eFuseWord, EFUSE_MAX_SECTION_88E, EFUSE_MAX_WORD_UNI=
T, sizeof(u16));
+}
