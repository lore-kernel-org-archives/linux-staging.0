+/* Encapsulate WPS IE data with one (or more, if needed) IE headers */
+struct wpabuf * wps_ie_encapsulate(struct wpabuf *data)
+{
+	struct wpabuf *ie;
+	const u8 *pos, *end;
+
+	ie =3D wpabuf_alloc(wpabuf_len(data) + 100);
+	if (ie =3D=3D NULL) {
+		wpabuf_free(data);
+		return NULL;
+	}
+
+	pos =3D wpabuf_head(data);
+	end =3D pos + wpabuf_len(data);
+
+	while (end > pos) {
+		size_t frag_len =3D end - pos;
+		if (frag_len > 251)
+			frag_len =3D 251;
+		wpabuf_put_u8(ie, WLAN_EID_VENDOR_SPECIFIC);
+		wpabuf_put_u8(ie, 4 + frag_len);
+		wpabuf_put_be32(ie, WPS_DEV_OUI_WFA);
+		wpabuf_put_data(ie, pos, frag_len);
+		pos +=3D frag_len;
+	}
+
+	wpabuf_free(data);
+
+	return ie;
+}
