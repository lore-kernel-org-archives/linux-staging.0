+
+static enum tncs_process_res tncs_derive_recommendation(struct tncs_data *=
tncs)
+{
+	enum IMV_Action_Recommendation rec;
+	struct tnc_if_imv *imv;
+	TNC_ConnectionState state;
+	char *txt;
+
+	wpa_printf(MSG_DEBUG, "TNC: No more messages from IMVs");
+
+	if (tncs->done)
+		return TNCCS_PROCESS_OK_NO_RECOMMENDATION;
+
+	tncs_solicit_recommendation(tncs);
+
+	/* Select the most restrictive recommendation */
+	rec =3D TNC_IMV_ACTION_RECOMMENDATION_NO_RECOMMENDATION;
+	for (imv =3D tncs->imv; imv; imv =3D imv->next) {
+		TNC_IMV_Action_Recommendation irec;
+		irec =3D tncs->imv_data[imv->imvID].recommendation;
+		if (irec =3D=3D TNC_IMV_ACTION_RECOMMENDATION_NO_ACCESS)
+			rec =3D TNC_IMV_ACTION_RECOMMENDATION_NO_ACCESS;
+		if (irec =3D=3D TNC_IMV_ACTION_RECOMMENDATION_ISOLATE &&
+		    rec !=3D TNC_IMV_ACTION_RECOMMENDATION_NO_ACCESS)
+			rec =3D TNC_IMV_ACTION_RECOMMENDATION_ISOLATE;
+		if (irec =3D=3D TNC_IMV_ACTION_RECOMMENDATION_ALLOW &&
+		    rec =3D=3D TNC_IMV_ACTION_RECOMMENDATION_NO_RECOMMENDATION)
+			rec =3D TNC_IMV_ACTION_RECOMMENDATION_ALLOW;
+	}
+
+	wpa_printf(MSG_DEBUG, "TNC: Recommendation: %d", rec);
+	tncs->recommendation =3D rec;
+	tncs->done =3D 1;
+
+	txt =3D NULL;
+	switch (rec) {
+	case TNC_IMV_ACTION_RECOMMENDATION_ALLOW:
+	case TNC_IMV_ACTION_RECOMMENDATION_NO_RECOMMENDATION:
+		txt =3D "allow";
+		state =3D TNC_CONNECTION_STATE_ACCESS_ALLOWED;
+		break;
+	case TNC_IMV_ACTION_RECOMMENDATION_ISOLATE:
+		txt =3D "isolate";
+		state =3D TNC_CONNECTION_STATE_ACCESS_ISOLATED;
+		break;
+	case TNC_IMV_ACTION_RECOMMENDATION_NO_ACCESS:
+		txt =3D "none";
+		state =3D TNC_CONNECTION_STATE_ACCESS_NONE;
+		break;
+	default:
+		state =3D TNC_CONNECTION_STATE_ACCESS_ALLOWED;
+		break;
+	}
+
+	if (txt) {
+		os_free(tncs->tncs_message);
+		tncs->tncs_message =3D os_zalloc(200);
+		if (tncs->tncs_message) {
+			os_snprintf(tncs->tncs_message, 199,
+				    "<TNCC-TNCS-Message><Type>%08X</Type>"
+				    "<XML><TNCCS-Recommendation type=3D\"%s\">"
+				    "</TNCCS-Recommendation></XML>"
+				    "</TNCC-TNCS-Message>",
+				    TNC_TNCCS_RECOMMENDATION, txt);
+		}
+	}
+
+	for (imv =3D tncs->imv; imv; imv =3D imv->next) {
+		tncs_imv_notify_connection_change(imv, tncs->connectionID,
+						  state);
+	}
+
+	switch (rec) {
+	case TNC_IMV_ACTION_RECOMMENDATION_ALLOW:
+		return TNCCS_RECOMMENDATION_ALLOW;
+	case TNC_IMV_ACTION_RECOMMENDATION_NO_ACCESS:
+		return TNCCS_RECOMMENDATION_NO_ACCESS;
+	case TNC_IMV_ACTION_RECOMMENDATION_ISOLATE:
+		return TNCCS_RECOMMENDATION_ISOLATE;
+	case TNC_IMV_ACTION_RECOMMENDATION_NO_RECOMMENDATION:
+		return TNCCS_RECOMMENDATION_NO_RECOMMENDATION;
+	default:
+		return TNCCS_PROCESS_ERROR;
+	}
+}
+
+
+enum tncs_process_res tncs_process_if_tnccs(struct tncs_data *tncs,
+					    const u8 *msg, size_t len)
+{
+	char *buf, *start, *end, *pos, *pos2, *payload;
+	unsigned int batch_id;
+	unsigned char *decoded;
+	size_t decoded_len;
+
+	buf =3D os_malloc(len + 1);
+	if (buf =3D=3D NULL)
+		return TNCCS_PROCESS_ERROR;
+
+	os_memcpy(buf, msg, len);
+	buf[len] =3D '\0';
+	start =3D os_strstr(buf, "<TNCCS-Batch ");
+	end =3D os_strstr(buf, "</TNCCS-Batch>");
+	if (start =3D=3D NULL || end =3D=3D NULL || start > end) {
+		os_free(buf);
+		return TNCCS_PROCESS_ERROR;
+	}
+
+	start +=3D 13;
+	while (*start =3D=3D ' ')
+		start++;
+	*end =3D '\0';
+
+	pos =3D os_strstr(start, "BatchId=3D");
+	if (pos =3D=3D NULL) {
+		os_free(buf);
+		return TNCCS_PROCESS_ERROR;
+	}
+
+	pos +=3D 8;
+	if (*pos =3D=3D '"')
+		pos++;
+	batch_id =3D atoi(pos);
+	wpa_printf(MSG_DEBUG, "TNC: Received IF-TNCCS BatchId=3D%u",
+		   batch_id);
+	if (batch_id !=3D tncs->last_batchid + 1) {
+		wpa_printf(MSG_DEBUG, "TNC: Unexpected IF-TNCCS BatchId "
+			   "%u (expected %u)",
+			   batch_id, tncs->last_batchid + 1);
+		os_free(buf);
+		return TNCCS_PROCESS_ERROR;
+	}
+	tncs->last_batchid =3D batch_id;
+
+	while (*pos !=3D '\0' && *pos !=3D '>')
+		pos++;
+	if (*pos =3D=3D '\0') {
+		os_free(buf);
+		return TNCCS_PROCESS_ERROR;
+	}
+	pos++;
+	payload =3D start;
+
+	/*
+	 * <IMC-IMV-Message>
+	 * <Type>01234567</Type>
+	 * <Base64>foo=3D=3D</Base64>
+	 * </IMC-IMV-Message>
+	 */
+
+	while (*start) {
+		char *endpos;
+		unsigned int type;
+
+		pos =3D os_strstr(start, "<IMC-IMV-Message>");
+		if (pos =3D=3D NULL)
+			break;
+		start =3D pos + 17;
+		end =3D os_strstr(start, "</IMC-IMV-Message>");
+		if (end =3D=3D NULL)
+			break;
+		*end =3D '\0';
+		endpos =3D end;
+		end +=3D 18;
+
+		if (tncs_get_type(start, &type) < 0) {
+			*endpos =3D '<';
+			start =3D end;
+			continue;
+		}
+		wpa_printf(MSG_DEBUG, "TNC: IMC-IMV-Message Type 0x%x", type);
+
+		decoded =3D tncs_get_base64(start, &decoded_len);
+		if (decoded =3D=3D NULL) {
+			*endpos =3D '<';
+			start =3D end;
+			continue;
+		}
+
+		tncs_send_to_imvs(tncs, type, decoded, decoded_len);
+
+		os_free(decoded);
+
+		start =3D end;
+	}
+
+	/*
+	 * <TNCC-TNCS-Message>
+	 * <Type>01234567</Type>
+	 * <XML><TNCCS-Foo type=3D"foo"></TNCCS-Foo></XML>
+	 * <Base64>foo=3D=3D</Base64>
+	 * </TNCC-TNCS-Message>
+	 */
+
+	start =3D payload;
+	while (*start) {
+		unsigned int type;
+		char *xml, *xmlend, *endpos;
+
+		pos =3D os_strstr(start, "<TNCC-TNCS-Message>");
+		if (pos =3D=3D NULL)
+			break;
+		start =3D pos + 19;
+		end =3D os_strstr(start, "</TNCC-TNCS-Message>");
+		if (end =3D=3D NULL)
+			break;
+		*end =3D '\0';
+		endpos =3D end;
+		end +=3D 20;
+
+		if (tncs_get_type(start, &type) < 0) {
+			*endpos =3D '<';
+			start =3D end;
+			continue;
+		}
+		wpa_printf(MSG_DEBUG, "TNC: TNCC-TNCS-Message Type 0x%x",
+			   type);
+
+		/* Base64 OR XML */
+		decoded =3D NULL;
+		xml =3D NULL;
+		xmlend =3D NULL;
+		pos =3D os_strstr(start, "<XML>");
+		if (pos) {
+			pos +=3D 5;
+			pos2 =3D os_strstr(pos, "</XML>");
+			if (pos2 =3D=3D NULL) {
+				*endpos =3D '<';
+				start =3D end;
+				continue;
+			}
+			xmlend =3D pos2;
+			xml =3D pos;
+		} else {
+			decoded =3D tncs_get_base64(start, &decoded_len);
+			if (decoded =3D=3D NULL) {
+				*endpos =3D '<';
+				start =3D end;
+				continue;
+			}
+		}
+
+		if (decoded) {
+			wpa_hexdump_ascii(MSG_MSGDUMP,
+					  "TNC: TNCC-TNCS-Message Base64",
+					  decoded, decoded_len);
+			os_free(decoded);
+		}
+
+		if (xml) {
+			wpa_hexdump_ascii(MSG_MSGDUMP,
+					  "TNC: TNCC-TNCS-Message XML",
+					  (unsigned char *) xml,
+					  xmlend - xml);
+		}
+
+		start =3D end;
+	}
+
+	os_free(buf);
+
+	tncs_batch_ending(tncs);
+
+	if (tncs_total_send_len(tncs) =3D=3D 0)
+		return tncs_derive_recommendation(tncs);
+
+	return TNCCS_PROCESS_OK_NO_RECOMMENDATION;
+}
+
+
+static struct tnc_if_imv * tncs_parse_imv(int id, char *start, char *end,
+					  int *error)
+{
+	struct tnc_if_imv *imv;
+	char *pos, *pos2;
+
+	if (id >=3D TNC_MAX_IMV_ID) {
+		wpa_printf(MSG_DEBUG, "TNC: Too many IMVs");
+		return NULL;
+	}
+
+	imv =3D os_zalloc(sizeof(*imv));
+	if (imv =3D=3D NULL) {
+		*error =3D 1;
+		return NULL;
+	}
+
+	imv->imvID =3D id;
+
+	pos =3D start;
+	wpa_printf(MSG_DEBUG, "TNC: Configured IMV: %s", pos);
+	if (pos + 1 >=3D end || *pos !=3D '"') {
+		wpa_printf(MSG_ERROR, "TNC: Ignoring invalid IMV line '%s' "
+			   "(no starting quotation mark)", start);
+		os_free(imv);
+		return NULL;
+	}
+
+	pos++;
+	pos2 =3D pos;
+	while (pos2 < end && *pos2 !=3D '"')
+		pos2++;
+	if (pos2 >=3D end) {
+		wpa_printf(MSG_ERROR, "TNC: Ignoring invalid IMV line '%s' "
+			   "(no ending quotation mark)", start);
+		os_free(imv);
+		return NULL;
+	}
+	*pos2 =3D '\0';
+	wpa_printf(MSG_DEBUG, "TNC: Name: '%s'", pos);
+	imv->name =3D os_strdup(pos);
+
+	pos =3D pos2 + 1;
+	if (pos >=3D end || *pos !=3D ' ') {
+		wpa_printf(MSG_ERROR, "TNC: Ignoring invalid IMV line '%s' "
+			   "(no space after name)", start);
+		os_free(imv);
+		return NULL;
+	}
+
+	pos++;
+	wpa_printf(MSG_DEBUG, "TNC: IMV file: '%s'", pos);
+	imv->path =3D os_strdup(pos);
+
+	return imv;
+}
+
+
+static int tncs_read_config(struct tncs_global *global)
+{
+	char *config, *end, *pos, *line_end;
+	size_t config_len;
+	struct tnc_if_imv *imv, *last;
+	int id =3D 0;
+
+	last =3D NULL;
+
+	config =3D os_readfile(TNC_CONFIG_FILE, &config_len);
+	if (config =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "TNC: Could not open TNC configuration "
+			   "file '%s'", TNC_CONFIG_FILE);
+		return -1;
+	}
+
+	end =3D config + config_len;
+	for (pos =3D config; pos < end; pos =3D line_end + 1) {
+		line_end =3D pos;
+		while (*line_end !=3D '\n' && *line_end !=3D '\r' &&
+		       line_end < end)
+			line_end++;
+		*line_end =3D '\0';
+
+		if (os_strncmp(pos, "IMV ", 4) =3D=3D 0) {
+			int error =3D 0;
+
+			imv =3D tncs_parse_imv(id++, pos + 4, line_end, &error);
+			if (error)
+				return -1;
+			if (imv) {
+				if (last =3D=3D NULL)
+					global->imv =3D imv;
+				else
+					last->next =3D imv;
+				last =3D imv;
+			}
+		}
+	}
+
+	os_free(config);
+
+	return 0;
+}
+
+
+struct tncs_data * tncs_init(void)
+{
+	struct tncs_data *tncs;
+
+	if (tncs_global_data =3D=3D NULL)
+		return NULL;
+
+	tncs =3D os_zalloc(sizeof(*tncs));
+	if (tncs =3D=3D NULL)
+		return NULL;
+	tncs->imv =3D tncs_global_data->imv;
+	tncs->connectionID =3D tncs_global_data->next_conn_id++;
+	tncs->next =3D tncs_global_data->connections;
+	tncs_global_data->connections =3D tncs;
+
+	return tncs;
+}
+
+
+void tncs_deinit(struct tncs_data *tncs)
+{
+	int i;
+	struct tncs_data *prev, *conn;
+
+	if (tncs =3D=3D NULL)
+		return;
+
+	for (i =3D 0; i < TNC_MAX_IMV_ID; i++)
+		os_free(tncs->imv_data[i].imv_send);
+
+	prev =3D NULL;
+	conn =3D tncs_global_data->connections;
+	while (conn) {
+		if (conn =3D=3D tncs) {
+			if (prev)
+				prev->next =3D tncs->next;
+			else
+				tncs_global_data->connections =3D tncs->next;
+			break;
+		}
+		prev =3D conn;
+		conn =3D conn->next;
+	}
+
+	os_free(tncs->tncs_message);
+	os_free(tncs);
+}
+
+
+int tncs_global_init(void)
+{
+	struct tnc_if_imv *imv;
+
+	tncs_global_data =3D os_zalloc(sizeof(*tncs_global_data));
+	if (tncs_global_data =3D=3D NULL)
+		return -1;
+
+	if (tncs_read_config(tncs_global_data) < 0) {
+		wpa_printf(MSG_ERROR, "TNC: Failed to read TNC configuration");
+		goto failed;
+	}
+
+	for (imv =3D tncs_global_data->imv; imv; imv =3D imv->next) {
+		if (tncs_load_imv(imv)) {
+			wpa_printf(MSG_ERROR, "TNC: Failed to load IMV '%s'",
+				   imv->name);
+			goto failed;
+		}
+	}
+
+	return 0;
+
+failed:
+	tncs_global_deinit();
+	return -1;
+}
+
+
+void tncs_global_deinit(void)
+{
+	struct tnc_if_imv *imv, *prev;
+
+	if (tncs_global_data =3D=3D NULL)
+		return;
+
+	imv =3D tncs_global_data->imv;
+	while (imv) {
+		tncs_unload_imv(imv);
+
+		prev =3D imv;
+		imv =3D imv->next;
+		os_free(prev);
+	}
+
+	os_free(tncs_global_data);
+	tncs_global_data =3D NULL;
+}
+
+
+struct wpabuf * tncs_build_soh_request(void)
+{
+	struct wpabuf *buf;
+
+	/*
+	 * Build a SoH Request TLV (to be used inside SoH EAP Extensions
+	 * Method)
+	 */
+
+	buf =3D wpabuf_alloc(8 + 4);
+	if (buf =3D=3D NULL)
+		return NULL;
+
+	/* Vendor-Specific TLV (Microsoft) - SoH Request */
+	wpabuf_put_be16(buf, EAP_TLV_VENDOR_SPECIFIC_TLV); /* TLV Type */
+	wpabuf_put_be16(buf, 8); /* Length */
+
+	wpabuf_put_be32(buf, EAP_VENDOR_MICROSOFT); /* Vendor_Id */
+
+	wpabuf_put_be16(buf, 0x02); /* TLV Type - SoH Request TLV */
+	wpabuf_put_be16(buf, 0); /* Length */
+
+	return buf;
+}
+
+
+struct wpabuf * tncs_process_soh(const u8 *soh_tlv, size_t soh_tlv_len,
+				 int *failure)
+{
+	wpa_hexdump(MSG_DEBUG, "TNC: SoH TLV", soh_tlv, soh_tlv_len);
+	*failure =3D 0;
+
+	/* TODO: return MS-SoH Response TLV */
+
+	return NULL;
+}
