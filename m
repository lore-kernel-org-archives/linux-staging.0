+int _netdev_vir_if_open(struct net_device *pnetdev)
+{
+	_adapter *padapter =3D (_adapter *)rtw_netdev_priv(pnetdev);
+	_adapter *primary_padapter =3D GET_PRIMARY_ADAPTER(padapter);
+
+	RTW_INFO(FUNC_NDEV_FMT" , bup=3D%d\n", FUNC_NDEV_ARG(pnetdev), padapter->=
bup);
+
+	if (!primary_padapter)
+		goto _netdev_virtual_iface_open_error;
+
+#ifdef CONFIG_PLATFORM_INTEL_BYT
+	if (padapter->bup =3D=3D false) {
+		u8 mac[ETH_ALEN];
+
+		/* get mac address from primary_padapter */
+		if (primary_padapter->bup =3D=3D false)
+			rtw_macaddr_cfg(adapter_mac_addr(primary_padapter), get_hal_mac_addr(pr=
imary_padapter));
+
+		memcpy(mac, adapter_mac_addr(primary_padapter), ETH_ALEN);
+
+		/*
+		* If the BIT1 is 0, the address is universally administered.
+		* If it is 1, the address is locally administered
+		*/
+		mac[0] |=3D BIT(1);
+
+		memcpy(adapter_mac_addr(padapter), mac, ETH_ALEN);
+
+#ifdef CONFIG_MI_WITH_MBSSID_CAM
+		rtw_mbid_camid_alloc(padapter, adapter_mac_addr(padapter));
+#endif
+		rtw_init_wifidirect_addrs(padapter, adapter_mac_addr(padapter), adapter_=
mac_addr(padapter));
+		memcpy(pnetdev->dev_addr, adapter_mac_addr(padapter), ETH_ALEN);
+	}
+#endif /*CONFIG_PLATFORM_INTEL_BYT*/
+
+	if (primary_padapter->bup =3D=3D false || !rtw_is_hw_init_completed(prima=
ry_padapter))
+		_netdev_open(primary_padapter->pnetdev);
+
+	if (padapter->bup =3D=3D false && primary_padapter->bup =3D=3D true &&
+	    rtw_is_hw_init_completed(primary_padapter)) {
+		padapter->bFWReady =3D primary_padapter->bFWReady;
+	}
+
+	if (padapter->bup =3D=3D false) {
+		if (rtw_start_drv_threads(padapter) =3D=3D _FAIL)
+			goto _netdev_virtual_iface_open_error;
+	}
+
+#ifdef CONFIG_RTW_NAPI
+	if (padapter->napi_state =3D=3D NAPI_DISABLE) {
+		napi_enable(&padapter->napi);
+		padapter->napi_state =3D NAPI_ENABLE;
+	}
+#endif
+
+#ifdef CONFIG_IOCTL_CFG80211
+	rtw_cfg80211_init_wiphy(padapter);
+	rtw_cfg80211_init_wdev_data(padapter);
+#endif
+
+	padapter->bup =3D true;
+
+	padapter->net_closed =3D false;
+
+	rtw_netif_wake_queue(pnetdev);
+
+	RTW_INFO(FUNC_NDEV_FMT" (bup=3D%d) exit\n", FUNC_NDEV_ARG(pnetdev), padap=
ter->bup);
+
+	return 0;
+
+_netdev_virtual_iface_open_error:
+
+	padapter->bup =3D false;
+
+#ifdef CONFIG_RTW_NAPI
+	if(padapter->napi_state =3D=3D NAPI_ENABLE) {
+		napi_disable(&padapter->napi);
+		padapter->napi_state =3D NAPI_DISABLE;
+	}
+#endif
+
+	netif_carrier_off(pnetdev);
+	rtw_netif_stop_queue(pnetdev);
+
+	return -1;
+
+}
