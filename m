+static u8 * decrypt_ms_key(const u8 *key, size_t len,
+			   const u8 *req_authenticator,
+			   const u8 *secret, size_t secret_len, size_t *reslen)
+{
+	u8 *plain, *ppos, *res;
+	const u8 *pos;
+	size_t left, plen;
+	u8 hash[MD5_MAC_LEN];
+	int i, first =3D 1;
+	const u8 *addr[3];
+	size_t elen[3];
+
+	/* key: 16-bit salt followed by encrypted key info */
+
+	if (len < 2 + 16)
+		return NULL;
+
+	pos =3D key + 2;
+	left =3D len - 2;
+	if (left % 16) {
+		printf("Invalid ms key len %lu\n", (unsigned long) left);
+		return NULL;
+	}
+
+	plen =3D left;
+	ppos =3D plain =3D os_malloc(plen);
+	if (plain =3D=3D NULL)
+		return NULL;
+	plain[0] =3D 0;
+
+	while (left > 0) {
+		/* b(1) =3D MD5(Secret + Request-Authenticator + Salt)
+		 * b(i) =3D MD5(Secret + c(i - 1)) for i > 1 */
+
+		addr[0] =3D secret;
+		elen[0] =3D secret_len;
+		if (first) {
+			addr[1] =3D req_authenticator;
+			elen[1] =3D MD5_MAC_LEN;
+			addr[2] =3D key;
+			elen[2] =3D 2; /* Salt */
+		} else {
+			addr[1] =3D pos - MD5_MAC_LEN;
+			elen[1] =3D MD5_MAC_LEN;
+		}
+		md5_vector(first ? 3 : 2, addr, elen, hash);
+		first =3D 0;
+
+		for (i =3D 0; i < MD5_MAC_LEN; i++)
+			*ppos++ =3D *pos++ ^ hash[i];
+		left -=3D MD5_MAC_LEN;
+	}
+
+	if (plain[0] =3D=3D 0 || plain[0] > plen - 1) {
+		printf("Failed to decrypt MPPE key\n");
+		os_free(plain);
+		return NULL;
+	}
+
+	res =3D os_malloc(plain[0]);
+	if (res =3D=3D NULL) {
+		os_free(plain);
+		return NULL;
+	}
+	os_memcpy(res, plain + 1, plain[0]);
+	if (reslen)
+		*reslen =3D plain[0];
+	os_free(plain);
+	return res;
+}
