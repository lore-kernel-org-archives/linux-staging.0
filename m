+static struct tnc_if_imv * tncs_get_imv(TNC_IMVID imvID)
+{
+	struct tnc_if_imv *imv;
+
+	if (imvID >=3D TNC_MAX_IMV_ID || tncs_global_data =3D=3D NULL)
+		return NULL;
+	imv =3D tncs_global_data->imv;
+	while (imv) {
+		if (imv->imvID =3D=3D imvID)
+			return imv;
+		imv =3D imv->next;
+	}
+	return NULL;
+}
+
+
+static struct tncs_data * tncs_get_conn(TNC_ConnectionID connectionID)
+{
+	struct tncs_data *tncs;
+
+	if (tncs_global_data =3D=3D NULL)
+		return NULL;
+
+	tncs =3D tncs_global_data->connections;
+	while (tncs) {
+		if (tncs->connectionID =3D=3D connectionID)
+			return tncs;
+		tncs =3D tncs->next;
+	}
+
+	wpa_printf(MSG_DEBUG, "TNC: Connection ID %lu not found",
+		   (unsigned long) connectionID);
+
+	return NULL;
+}
