+	char		*szScan =3D szStr;
+
+	/* Check input parameter. */
+	if (szStr =3D=3D NULL || pu4bVal =3D=3D NULL || pu4bMove =3D=3D NULL) {
+		RTW_INFO("GetHexValueFromString(): Invalid inpur argumetns! szStr: %p, p=
u4bVal: %p, pu4bMove: %p\n", szStr, pu4bVal, pu4bMove);
+		return false;
+	}
+
+	/* Initialize output. */
+	*pu4bMove =3D 0;
+	*pu4bVal =3D 0;
+
+	/* Skip leading space. */
+	while (*szScan !=3D '\0' &&
+	       (*szScan =3D=3D ' ' || *szScan =3D=3D '\t')) {
+		szScan++;
+		(*pu4bMove)++;
+	}
+
+	/* Skip leading '0x' or '0X'. */
+	if (*szScan =3D=3D '0' && (*(szScan + 1) =3D=3D 'x' || *(szScan + 1) =3D=
=3D 'X')) {
+		szScan +=3D 2;
+		(*pu4bMove) +=3D 2;
+	}
+
+	/* Check if szScan is now pointer to a character for hex digit, */
+	/* if not, it means this is not a valid hex number. */
+	if (!IsHexDigit(*szScan))
+		return false;
+
+	/* Parse each digit. */
+	do {
+		(*pu4bVal) <<=3D 4;
+		*pu4bVal +=3D MapCharToHexDigit(*szScan);
+
+		szScan++;
+		(*pu4bMove)++;
+	} while (IsHexDigit(*szScan));
+
+	return true;
+}
