+void EXhalbtcoutsrc_StackUpdateProfileInfo(void)
+{
+#ifdef CONFIG_BT_COEXIST_SOCKET_TRX
+	PBTC_COEXIST pBtCoexist =3D &GLBtCoexist;
+	PADAPTER padapter =3D (PADAPTER)GLBtCoexist.Adapter;
+	PBT_MGNT pBtMgnt =3D &padapter->coex_info.BtMgnt;
+	u8 i;
+
+	if (!halbtcoutsrc_IsBtCoexistAvailable(pBtCoexist))
+		return;
+
+	pBtCoexist->stack_info.profile_notified =3D true;
+
+	pBtCoexist->stack_info.num_of_link =3D
+		pBtMgnt->ExtConfig.NumberOfACL + pBtMgnt->ExtConfig.NumberOfSCO;
+
+	/* reset first */
+	pBtCoexist->stack_info.bt_link_exist =3D false;
+	pBtCoexist->stack_info.sco_exist =3D false;
+	pBtCoexist->stack_info.acl_exist =3D false;
+	pBtCoexist->stack_info.a2dp_exist =3D false;
+	pBtCoexist->stack_info.hid_exist =3D false;
+	pBtCoexist->stack_info.num_of_hid =3D 0;
+	pBtCoexist->stack_info.pan_exist =3D false;
+
+	if (!pBtMgnt->ExtConfig.NumberOfACL)
+		pBtCoexist->stack_info.min_bt_rssi =3D 0;
+
+	if (pBtCoexist->stack_info.num_of_link) {
+		pBtCoexist->stack_info.bt_link_exist =3D true;
+		if (pBtMgnt->ExtConfig.NumberOfSCO)
+			pBtCoexist->stack_info.sco_exist =3D true;
+		if (pBtMgnt->ExtConfig.NumberOfACL)
+			pBtCoexist->stack_info.acl_exist =3D true;
+	}
+
+	for (i =3D 0; i < pBtMgnt->ExtConfig.NumberOfACL; i++) {
+		if (BT_PROFILE_A2DP =3D=3D pBtMgnt->ExtConfig.aclLink[i].BTProfile)
+			pBtCoexist->stack_info.a2dp_exist =3D true;
+		else if (BT_PROFILE_PAN =3D=3D pBtMgnt->ExtConfig.aclLink[i].BTProfile)
+			pBtCoexist->stack_info.pan_exist =3D true;
+		else if (BT_PROFILE_HID =3D=3D pBtMgnt->ExtConfig.aclLink[i].BTProfile) {
+			pBtCoexist->stack_info.hid_exist =3D true;
+			pBtCoexist->stack_info.num_of_hid++;
+		} else
+			pBtCoexist->stack_info.unknown_acl_exist =3D true;
+	}
+#endif /* CONFIG_BT_COEXIST_SOCKET_TRX */
+}
