+static void hostapd_cli_interactive(void)
+{
+	const int max_args =3D 10;
+	char cmd[256], *res, *argv[max_args], *pos;
+	int argc;
+
+	printf("\nInteractive mode\n\n");
+
+	do {
+		hostapd_cli_recv_pending(ctrl_conn, 0, 0);
+		printf("> ");
+		alarm(ping_interval);
+		res =3D fgets(cmd, sizeof(cmd), stdin);
+		alarm(0);
+		if (res =3D=3D NULL)
+			break;
+		pos =3D cmd;
+		while (*pos !=3D '\0') {
+			if (*pos =3D=3D '\n') {
+				*pos =3D '\0';
+				break;
+			}
+			pos++;
+		}
+		argc =3D 0;
+		pos =3D cmd;
+		for (;;) {
+			while (*pos =3D=3D ' ')
+				pos++;
+			if (*pos =3D=3D '\0')
+				break;
+			argv[argc] =3D pos;
+			argc++;
+			if (argc =3D=3D max_args)
+				break;
+			while (*pos !=3D '\0' && *pos !=3D ' ')
+				pos++;
+			if (*pos =3D=3D ' ')
+				*pos++ =3D '\0';
+		}
+		if (argc)
+			wpa_request(ctrl_conn, argc, argv);
+	} while (!hostapd_cli_quit);
+}
