+		ndp_tx_rate =3D ODM_MGN_MCS8;
+		break;
+
+	case 2:
+		ndp_tx_rate =3D ODM_MGN_MCS16;
+		break;
+
+	case 3:
+		ndp_tx_rate =3D ODM_MGN_MCS24;
+		break;
+
+	default:
+		ndp_tx_rate =3D ODM_MGN_MCS8;
+		break;
+	}
+
+	return ndp_tx_rate;
+
+}
