+u8 rtl8188e_set_raid_cmd(_adapter *padapter, u32 bitmap, u8 *arg, u8 bw)
+{
+	u8	res =3D _SUCCESS;
+	HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(padapter);
+	struct sta_info	*psta =3D NULL;
+	struct macid_ctl_t *macid_ctl =3D &padapter->dvobj->macid_ctl;
+	u8 macid, init_rate, raid, shortGIrate =3D false;
+	u8 H2CCommand[7] =3D {0};
+	u8 ignore_bw =3D false;
+
+	if (pHalData->fw_ractrl =3D=3D false) {
+		RTW_INFO("=3D=3D>%s fw dont support RA\n", __func__);
+		return _FAIL;
+	}
+
+	macid =3D arg[0];
+	raid =3D arg[1];
+	shortGIrate =3D arg[2] & 0x0F;
+	ignore_bw =3D arg[2] >> 4;
+	init_rate =3D arg[3];
+
+	if (macid < macid_ctl->num)
+		psta =3D macid_ctl->sta[macid];
+	if (psta =3D=3D NULL) {
+		RTW_PRINT(FUNC_ADPT_FMT" macid:%u, sta is NULL\n"
+			  , FUNC_ADPT_ARG(padapter), macid);
+		return _FAIL;
+	}
+
+	H2CCommand[0] =3D macid;
+	H2CCommand[1] =3D raid | (shortGIrate ? 0x80 : 0x00) ;
+	H2CCommand[2] =3D bw & 0x03; /* BW; */
+	if (ignore_bw)
+		H2CCommand[2] |=3D BIT(3);
+
+#ifdef CONFIG_INTEL_PROXIM
+	if (padapter->proximity.proxim_on =3D=3D true)
+		pHalData->bDisableTXPowerTraining =3D false;
+#endif
+
+	/* DisableTXPowerTraining */
+	if (pHalData->bDisableTXPowerTraining) {
+		H2CCommand[2] |=3D BIT6;
+		RTW_INFO("%s,Disable PWT by driver\n", __func__);
+	} else {
+		struct PHY_DM_STRUCT	*pDM_OutSrc =3D &pHalData->odmpriv;
+
+		if (pDM_OutSrc->is_disable_power_training) {
+			H2CCommand[2] |=3D BIT6;
+			RTW_INFO("%s,Disable PWT by DM\n", __func__);
+		}
+	}
+
+	H2CCommand[3] =3D (u8)(bitmap & 0x000000ff);
+	H2CCommand[4] =3D (u8)((bitmap & 0x0000ff00) >> 8);
+	H2CCommand[5] =3D (u8)((bitmap & 0x00ff0000) >> 16);
+	H2CCommand[6] =3D (u8)((bitmap & 0xff000000) >> 24);
+
+	FillH2CCmd_88E(padapter, H2C_DM_MACID_CFG, 7, H2CCommand);
+
+	/* The firmware Rate Adaption function is triggered by TBTT INT, so to */
+	/* enable the rate adaption, we need to enable the hardware Beacon functi=
on Reg 0x550[3]		 */
+	/* SetBcnCtrlReg(padapter, BIT3, 0);		 */
+	rtw_write8(padapter, REG_BCN_CTRL, rtw_read8(padapter, REG_BCN_CTRL) | BI=
T3);
+
+	return res;
+
+}
