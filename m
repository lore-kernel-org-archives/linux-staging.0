+static u8 * wpa_ft_process_ric(u8 *pos, u8 *end, const u8 *ric, size_t ric=
_len)
+{
+	const u8 *rpos, *start;
+	const struct rsn_rdie *rdie;
+
+	wpa_hexdump(MSG_MSGDUMP, "FT: RIC Request", ric, ric_len);
+
+	rpos =3D ric;
+	while (rpos + sizeof(*rdie) < ric + ric_len) {
+		if (rpos[0] !=3D WLAN_EID_RIC_DATA || rpos[1] < sizeof(*rdie) ||
+		    rpos + 2 + rpos[1] > ric + ric_len)
+			break;
+		rdie =3D (const struct rsn_rdie *) (rpos + 2);
+		rpos +=3D 2 + rpos[1];
+		start =3D rpos;
+
+		while (rpos + 2 <=3D ric + ric_len &&
+		       rpos + 2 + rpos[1] <=3D ric + ric_len) {
+			if (rpos[0] =3D=3D WLAN_EID_RIC_DATA)
+				break;
+			rpos +=3D 2 + rpos[1];
+		}
+		pos =3D wpa_ft_process_rdie(pos, end, rdie->id,
+					  rdie->descr_count,
+					  start, rpos - start);
+	}
+
+	return pos;
+}
