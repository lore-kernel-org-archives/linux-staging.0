+	size_t res_buf_len;
+
+	res_buf_len =3D IW_SCAN_MAX_DATA;
+	for (;;) {
+		res_buf =3D os_malloc(res_buf_len);
+		if (res_buf =3D=3D NULL)
+			return NULL;
+		os_memset(&iwr, 0, sizeof(iwr));
+		os_strlcpy(iwr.ifr_name, drv->ifname, IFNAMSIZ);
