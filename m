+static bool
+hal_EfusePartialWriteCheck(
+	PADAPTER		pAdapter,
+	u8				efuseType,
+	u16				*pAddr,
+	PPGPKT_STRUCT	pTargetPkt,
+	bool			bPseudoTest
+)
+{
+	bool		bRet =3D false;
+	u8	i, efuse_data =3D 0, cur_header =3D 0;
+	u8	new_wden =3D 0, matched_wden =3D 0, badworden =3D 0;
+	u16	startAddr =3D 0, efuse_max_available_len =3D 0, efuse_max =3D 0;
+	PGPKT_STRUCT	curPkt;
+
+	EFUSE_GetEfuseDefinition(pAdapter, efuseType, TYPE_AVAILABLE_EFUSE_BYTES_=
BANK, (void *)&efuse_max_available_len, bPseudoTest);
+	EFUSE_GetEfuseDefinition(pAdapter, efuseType, TYPE_EFUSE_REAL_CONTENT_LEN=
, (void *)&efuse_max, bPseudoTest);
+
+	if (efuseType =3D=3D EFUSE_WIFI) {
+		if (bPseudoTest)
+			startAddr =3D (u16)(fakeEfuseUsedBytes % EFUSE_REAL_CONTENT_LEN);
+		else {
+			rtw_hal_get_hwreg(pAdapter, HW_VAR_EFUSE_BYTES, (u8 *)&startAddr);
+			startAddr %=3D EFUSE_REAL_CONTENT_LEN;
+		}
+	} else {
+		if (bPseudoTest)
+			startAddr =3D (u16)(fakeBTEfuseUsedBytes % EFUSE_REAL_CONTENT_LEN);
+		else
+			startAddr =3D (u16)(BTEfuseUsedBytes % EFUSE_REAL_CONTENT_LEN);
+	}
+	/* RTPRINT(FEEPROM, EFUSE_PG, ("hal_EfusePartialWriteCheck(), startAddr=
=3D%d\n", startAddr)); */
+
+	while (1) {
+		if (startAddr >=3D efuse_max_available_len) {
+			bRet =3D false;
+			break;
+		}
+
+		if (efuse_OneByteRead(pAdapter, startAddr, &efuse_data, bPseudoTest) && =
(efuse_data !=3D 0xFF)) {
+			if (EXT_HEADER(efuse_data)) {
+				cur_header =3D efuse_data;
+				startAddr++;
+				efuse_OneByteRead(pAdapter, startAddr, &efuse_data, bPseudoTest);
+				if (ALL_WORDS_DISABLED(efuse_data)) {
+					/* RTPRINT(FEEPROM, EFUSE_PG, ("Error condition, all words disabled")=
); */
+					bRet =3D false;
+					break;
+				} else {
+					curPkt.offset =3D ((cur_header & 0xE0) >> 5) | ((efuse_data & 0xF0) >=
> 1);
+					curPkt.word_en =3D efuse_data & 0x0F;
+				}
+			} else {
+				cur_header  =3D  efuse_data;
+				curPkt.offset =3D (cur_header >> 4) & 0x0F;
+				curPkt.word_en =3D cur_header & 0x0F;
+			}
+
+			curPkt.word_cnts =3D Efuse_CalculateWordCnts(curPkt.word_en);
+			/* if same header is found but no data followed */
+			/* write some part of data followed by the header. */
+			if ((curPkt.offset =3D=3D pTargetPkt->offset) &&
+			    (!hal_EfuseCheckIfDatafollowed(pAdapter, curPkt.word_cnts, startAdd=
r + 1, bPseudoTest)) &&
+			    wordEnMatched(pTargetPkt, &curPkt, &matched_wden)) {
+				/* RTPRINT(FEEPROM, EFUSE_PG, ("Need to partial write data by the prev=
ious wrote header\n")); */
+				/* Here to write partial data */
+				badworden =3D Efuse_WordEnableDataWrite(pAdapter, startAddr + 1, match=
ed_wden, pTargetPkt->data, bPseudoTest);
+				if (badworden !=3D 0x0F) {
+					u32	PgWriteSuccess =3D 0;
+					/* if write fail on some words, write these bad words again */
+
+					PgWriteSuccess =3D Efuse_PgPacketWrite(pAdapter, pTargetPkt->offset, =
badworden, pTargetPkt->data, bPseudoTest);
+
+					if (!PgWriteSuccess) {
+						bRet =3D false;	/* write fail, return */
+						break;
+					}
+				}
+				/* partial write ok, update the target packet for later use */
+				for (i =3D 0; i < 4; i++) {
+					if ((matched_wden & (0x1 << i)) =3D=3D 0) {	/* this word has been wri=
tten */
+						pTargetPkt->word_en |=3D (0x1 << i);	/* disable the word */
+					}
+				}
+				pTargetPkt->word_cnts =3D Efuse_CalculateWordCnts(pTargetPkt->word_en);
+			}
+			/* read from next header */
+			startAddr =3D startAddr + (curPkt.word_cnts * 2) + 1;
+		} else {
+			/* not used header, 0xff */
+			*pAddr =3D startAddr;
+			/* RTPRINT(FEEPROM, EFUSE_PG, ("Started from unused header offset=3D%d\=
n", startAddr)); */
+			bRet =3D true;
+			break;
+		}
+	}
+	return bRet;
+}
