+static int wpa_ft_parse_ftie(const u8 *ie, size_t ie_len,
+			     struct wpa_ft_ies *parse)
+{
+	const u8 *end, *pos;
+
+	parse->ftie =3D ie;
+	parse->ftie_len =3D ie_len;
+
+	pos =3D ie + sizeof(struct rsn_ftie);
+	end =3D ie + ie_len;
+
+	while (pos + 2 <=3D end && pos + 2 + pos[1] <=3D end) {
+		switch (pos[0]) {
+		case FTIE_SUBELEM_R1KH_ID:
+			if (pos[1] !=3D FT_R1KH_ID_LEN) {
+				wpa_printf(MSG_DEBUG, "FT: Invalid R1KH-ID "
+					   "length in FTIE: %d", pos[1]);
+				return -1;
+			}
+			parse->r1kh_id =3D pos + 2;
+			break;
+		case FTIE_SUBELEM_GTK:
+			parse->gtk =3D pos + 2;
+			parse->gtk_len =3D pos[1];
+			break;
+		case FTIE_SUBELEM_R0KH_ID:
+			if (pos[1] < 1 || pos[1] > FT_R0KH_ID_MAX_LEN) {
+				wpa_printf(MSG_DEBUG, "FT: Invalid R0KH-ID "
+					   "length in FTIE: %d", pos[1]);
+				return -1;
+			}
+			parse->r0kh_id =3D pos + 2;
+			parse->r0kh_id_len =3D pos[1];
+			break;
+		}
+
+		pos +=3D 2 + pos[1];
+	}
+
+	return 0;
+}
+
+
+static int wpa_ft_parse_ies(const u8 *ies, size_t ies_len,
+			    struct wpa_ft_ies *parse)
+{
+	const u8 *end, *pos;
+	struct wpa_ie_data data;
+	int ret;
+	const struct rsn_ftie *ftie;
+	int prot_ie_count =3D 0;
+
+	os_memset(parse, 0, sizeof(*parse));
+	if (ies =3D=3D NULL)
+		return 0;
+
+	pos =3D ies;
+	end =3D ies + ies_len;
+	while (pos + 2 <=3D end && pos + 2 + pos[1] <=3D end) {
+		switch (pos[0]) {
+		case WLAN_EID_RSN:
+			parse->rsn =3D pos + 2;
+			parse->rsn_len =3D pos[1];
+			ret =3D wpa_parse_wpa_ie_rsn(parse->rsn - 2,
+						   parse->rsn_len + 2,
+						   &data);
+			if (ret < 0) {
+				wpa_printf(MSG_DEBUG, "FT: Failed to parse "
+					   "RSN IE: %d", ret);
+				return -1;
+			}
+			if (data.num_pmkid =3D=3D 1 && data.pmkid)
+				parse->rsn_pmkid =3D data.pmkid;
+			break;
+		case WLAN_EID_MOBILITY_DOMAIN:
+			parse->mdie =3D pos + 2;
+			parse->mdie_len =3D pos[1];
+			break;
+		case WLAN_EID_FAST_BSS_TRANSITION:
+			if (pos[1] < sizeof(*ftie))
+				return -1;
+			ftie =3D (const struct rsn_ftie *) (pos + 2);
+			prot_ie_count =3D ftie->mic_control[1];
+			if (wpa_ft_parse_ftie(pos + 2, pos[1], parse) < 0)
+				return -1;
+			break;
+		case WLAN_EID_RIC_DATA:
+			if (parse->ric =3D=3D NULL)
+				parse->ric =3D pos;
+		}
+
+		pos +=3D 2 + pos[1];
+	}
+
+	if (prot_ie_count =3D=3D 0)
+		return 0; /* no MIC */
+
+	/*
+	 * Check that the protected IE count matches with IEs included in the
+	 * frame.
+	 */
+	if (parse->rsn)
+		prot_ie_count--;
+	if (parse->mdie)
+		prot_ie_count--;
+	if (parse->ftie)
+		prot_ie_count--;
+	if (prot_ie_count < 0) {
+		wpa_printf(MSG_DEBUG, "FT: Some required IEs not included in "
+			   "the protected IE count");
+		return -1;
+	}
+
+	if (prot_ie_count =3D=3D 0 && parse->ric) {
+		wpa_printf(MSG_DEBUG, "FT: RIC IE(s) in the frame, but not "
+			   "included in protected IE count");
+		return -1;
+	}
+
+	/* Determine the end of the RIC IE(s) */
+	pos =3D parse->ric;
+	while (pos && pos + 2 <=3D end && pos + 2 + pos[1] <=3D end &&
+	       prot_ie_count) {
+		prot_ie_count--;
+		pos +=3D 2 + pos[1];
+	}
+	parse->ric_len =3D pos - parse->ric;
+	if (prot_ie_count) {
+		wpa_printf(MSG_DEBUG, "FT: %d protected IEs missing from "
+			   "frame", (int) prot_ie_count);
+		return -1;
+	}
+
+	return 0;
+}
