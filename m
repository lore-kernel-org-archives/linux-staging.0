+	p2p_buf_add_action_hdr(req, P2P_PRESENCE_REQ, 1);
+	len =3D p2p_buf_add_ie_hdr(req);
+	p2p_buf_add_noa(req, 0, 0, 0, ptr1, ptr2);
+	p2p_buf_update_ie_hdr(req, len);
