+
+	/*	P2P Group ID */
+	/*	Type: */
+	p2pie[p2pielen++] =3D P2P_ATTR_GROUP_ID;
+
+	/*	Length: */
+	*(__le16 *)(p2pie + p2pielen) =3D cpu_to_le16(6 + pwdinfo->invitereq_info=
.ssidlen);
+	p2pielen +=3D 2;
