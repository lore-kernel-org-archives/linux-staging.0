+
+	case LED_BLINK_WPS_STOP:	/* WPS success */
+
+		if (pLed->BlinkingLedState =3D=3D RTW_LED_OFF) {
+			pLed->bLedWPSBlinkInProgress =3D false;
+			return;
+		}
+
+		pLed->CurrLedState =3D LED_BLINK_WPS_STOP;
