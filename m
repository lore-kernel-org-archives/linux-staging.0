+const u8 * hostapd_get_psk(const struct hostapd_bss_config *conf,
+			   const u8 *addr, const u8 *prev_psk)
+{
+	struct hostapd_wpa_psk *psk;
+	int next_ok =3D prev_psk =3D=3D NULL;
+
+	for (psk =3D conf->ssid.wpa_psk; psk !=3D NULL; psk =3D psk->next) {
+		if (next_ok &&
+		    (psk->group || os_memcmp(psk->addr, addr, ETH_ALEN) =3D=3D 0))
+			return psk->psk;
+
+		if (psk->psk =3D=3D prev_psk)
+			next_ok =3D 1;
+	}
+
+	return NULL;
+}
