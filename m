+void rtw_odm_parse_rx_phy_status_chinfo(union recv_frame *rframe, u8 *phys)
+{
+#ifndef DBG_RX_PHYSTATUS_CHINFO
+#define DBG_RX_PHYSTATUS_CHINFO 0
+#endif
+
+#if (ODM_PHY_STATUS_NEW_TYPE_SUPPORT =3D=3D 1)
+	_adapter *adapter =3D rframe->u.hdr.adapter;
+	struct PHY_DM_STRUCT *phydm =3D GET_ODM(adapter);
+	struct rx_pkt_attrib *attrib =3D &rframe->u.hdr.attrib;
+	u8 *wlanhdr =3D get_recvframe_data(rframe);
+
+	if (phydm->support_ic_type & ODM_IC_PHY_STATUE_NEW_TYPE) {
+		/*
+		* 8723D:
+		* type_0(CCK)
+		*     l_rxsc
+		*         is filled with primary channel SC, not real rxsc.
+		*         0:LSC, 1:USC
+		* type_1(OFDM)
+		*     rf_mode
+		*         RF bandwidth when RX
+		*     l_rxsc(legacy), ht_rxsc
+		*         see below RXSC N-series
+		* type_2(Not used)
+		*/
+		/*
+		* 8821C, 8822B:
+		* type_0(CCK)
+		*     l_rxsc
+		*         is filled with primary channel SC, not real rxsc.
+		*         0:LSC, 1:USC
+		* type_1(OFDM)
+		*     rf_mode
+		*         RF bandwidth when RX
+		*     l_rxsc(legacy), ht_rxsc
+		*         see below RXSC AC-series
+		* type_2(Not used)
+		*/
+
+		if ((*phys & 0xf) =3D=3D 0) {
+			struct _phy_status_rpt_jaguar2_type0 *phys_t0 =3D (struct _phy_status_r=
pt_jaguar2_type0 *)phys;
+
+			if (DBG_RX_PHYSTATUS_CHINFO) {
+				RTW_PRINT("phys_t%u ta=3D"MAC_FMT" %s, %s(band:%u, ch:%u, l_rxsc:%u)\n"
+					, *phys & 0xf
+					, MAC_ARG(get_ta(wlanhdr))
+					, is_broadcast_mac_addr(get_ra(wlanhdr)) ? "BC" : is_multicast_mac_ad=
dr(get_ra(wlanhdr)) ? "MC" : "UC"
+					, HDATA_RATE(attrib->data_rate)
+					, phys_t0->band, phys_t0->channel, phys_t0->rxsc
+				);
+			}
+
+		} else if ((*phys & 0xf) =3D=3D 1) {
+			struct _phy_status_rpt_jaguar2_type1 *phys_t1 =3D (struct _phy_status_r=
pt_jaguar2_type1 *)phys;
+			u8 rxsc =3D (attrib->data_rate > DESC_RATE11M && attrib->data_rate < DE=
SC_RATEMCS0) ? phys_t1->l_rxsc : phys_t1->ht_rxsc;
+			u8 pkt_cch =3D 0;
+			u8 pkt_bw =3D CHANNEL_WIDTH_20;
+
+			#if	ODM_IC_11N_SERIES_SUPPORT
+			if (phydm->support_ic_type & ODM_IC_11N_SERIES) {
+				/* RXSC N-series */
+				#define RXSC_DUP	0
+				#define RXSC_LSC	1
+				#define RXSC_USC	2
+				#define RXSC_40M	3
+
+				static const s8 cch_offset_by_rxsc[4] =3D {0, -2, 2, 0};
+
+				if (phys_t1->rf_mode =3D=3D 0) {
+					pkt_cch =3D phys_t1->channel;
+					pkt_bw =3D CHANNEL_WIDTH_20;
+				} else if (phys_t1->rf_mode =3D=3D 1) {
+					if (rxsc =3D=3D RXSC_LSC || rxsc =3D=3D RXSC_USC) {
+						pkt_cch =3D phys_t1->channel + cch_offset_by_rxsc[rxsc];
+						pkt_bw =3D CHANNEL_WIDTH_20;
+					} else if (rxsc =3D=3D RXSC_40M) {
+						pkt_cch =3D phys_t1->channel;
+						pkt_bw =3D CHANNEL_WIDTH_40;
+					}
+				} else
+					rtw_warn_on(1);
+
+				goto type1_end;
+			}
+			#endif /* ODM_IC_11N_SERIES_SUPPORT */
+
+			#if	ODM_IC_11AC_SERIES_SUPPORT
+			if (phydm->support_ic_type & ODM_IC_11AC_SERIES) {
+				/* RXSC AC-series */
+				#define RXSC_DUP			0 /* 0: RX from all SC of current rf_mode */
+
+				#define RXSC_LL20M_OF_160M	8 /* 1~8: RX from 20MHz SC */
+				#define RXSC_L20M_OF_160M	6
+				#define RXSC_L20M_OF_80M	4
+				#define RXSC_L20M_OF_40M	2
+				#define RXSC_U20M_OF_40M	1
+				#define RXSC_U20M_OF_80M	3
+				#define RXSC_U20M_OF_160M	5
+				#define RXSC_UU20M_OF_160M	7
+
+				#define RXSC_L40M_OF_160M	12 /* 9~12: RX from 40MHz SC */
+				#define RXSC_L40M_OF_80M	10
+				#define RXSC_U40M_OF_80M	9
+				#define RXSC_U40M_OF_160M	11
+
+				#define RXSC_L80M_OF_160M	14 /* 13~14: RX from 80MHz SC */
+				#define RXSC_U80M_OF_160M	13
+
+				static const s8 cch_offset_by_rxsc[15] =3D {0, 2, -2, 6, -6, 10, -10, =
14, -14, 4, -4, 12, -12, 8, -8};
+
+				if (phys_t1->rf_mode > 3) {
+					/* invalid rf_mode */
+					rtw_warn_on(1);
+					goto type1_end;
+				}
+
+				if (phys_t1->rf_mode =3D=3D 0) {
+					/* RF 20MHz */
+					pkt_cch =3D phys_t1->channel;
+					pkt_bw =3D CHANNEL_WIDTH_20;
+					goto type1_end;
+				}
+
+				if (rxsc =3D=3D 0) {
+					/* RF and RX with same BW */
+					if (attrib->data_rate >=3D DESC_RATEMCS0) {
+						pkt_cch =3D phys_t1->channel;
+						pkt_bw =3D phys_t1->rf_mode;
+					}
+					goto type1_end;
+				}
+
+				if ((phys_t1->rf_mode =3D=3D 1 && rxsc >=3D 1 && rxsc <=3D 2) /* RF 40=
MHz, RX 20MHz */
+					|| (phys_t1->rf_mode =3D=3D 2 && rxsc >=3D 1 && rxsc <=3D 4) /* RF 80=
MHz, RX 20MHz */
+					|| (phys_t1->rf_mode =3D=3D 3 && rxsc >=3D 1 && rxsc <=3D 8) /* RF 16=
0MHz, RX 20MHz */
+				) {
+					pkt_cch =3D phys_t1->channel + cch_offset_by_rxsc[rxsc];
+					pkt_bw =3D CHANNEL_WIDTH_20;
+				} else if ((phys_t1->rf_mode =3D=3D 2 && rxsc >=3D 9 && rxsc <=3D 10) =
/* RF 80MHz, RX 40MHz */
+					|| (phys_t1->rf_mode =3D=3D 3 && rxsc >=3D 9 && rxsc <=3D 12) /* RF 1=
60MHz, RX 40MHz */
+				) {
+					if (attrib->data_rate >=3D DESC_RATEMCS0) {
+						pkt_cch =3D phys_t1->channel + cch_offset_by_rxsc[rxsc];
+						pkt_bw =3D CHANNEL_WIDTH_40;
+					}
+				} else if ((phys_t1->rf_mode =3D=3D 3 && rxsc >=3D 13 && rxsc <=3D 14)=
 /* RF 160MHz, RX 80MHz */
+				) {
+					if (attrib->data_rate >=3D DESC_RATEMCS0) {
+						pkt_cch =3D phys_t1->channel + cch_offset_by_rxsc[rxsc];
+						pkt_bw =3D CHANNEL_WIDTH_80;
+					}
+				} else
+					rtw_warn_on(1);
+
+			}
+			#endif /* ODM_IC_11AC_SERIES_SUPPORT */
+
+type1_end:
+			if (DBG_RX_PHYSTATUS_CHINFO) {
+				RTW_PRINT("phys_t%u ta=3D"MAC_FMT" %s, %s(band:%u, ch:%u, rf_mode:%u, =
l_rxsc:%u, ht_rxsc:%u) =3D> %u,%u\n"
+					, *phys & 0xf
+					, MAC_ARG(get_ta(wlanhdr))
+					, is_broadcast_mac_addr(get_ra(wlanhdr)) ? "BC" : is_multicast_mac_ad=
dr(get_ra(wlanhdr)) ? "MC" : "UC"
+					, HDATA_RATE(attrib->data_rate)
+					, phys_t1->band, phys_t1->channel, phys_t1->rf_mode, phys_t1->l_rxsc,=
 phys_t1->ht_rxsc
+					, pkt_cch, pkt_bw
+				);
+			}
+
+			/* for now, only return cneter channel of 20MHz packet */
+			if (pkt_cch && pkt_bw =3D=3D CHANNEL_WIDTH_20)
+				attrib->ch =3D pkt_cch;
+
+		} else {
+			struct _phy_status_rpt_jaguar2_type2 *phys_t2 =3D (struct _phy_status_r=
pt_jaguar2_type2 *)phys;
+
+			if (DBG_RX_PHYSTATUS_CHINFO) {
+				RTW_PRINT("phys_t%u ta=3D"MAC_FMT" %s, %s(band:%u, ch:%u, l_rxsc:%u, h=
t_rxsc:%u)\n"
+					, *phys & 0xf
+					, MAC_ARG(get_ta(wlanhdr))
+					, is_broadcast_mac_addr(get_ra(wlanhdr)) ? "BC" : is_multicast_mac_ad=
dr(get_ra(wlanhdr)) ? "MC" : "UC"
+					, HDATA_RATE(attrib->data_rate)
+					, phys_t2->band, phys_t2->channel, phys_t2->l_rxsc, phys_t2->ht_rxsc
+				);
+			}
+		}
+	}
+#endif /* (ODM_PHY_STATUS_NEW_TYPE_SUPPORT =3D=3D 1) */
+
+}
