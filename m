+ * Copyright (c) 2003-2007, Jouni Malinen <j@w1.fi>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * Alternatively, this software may be distributed under the terms of BSD
+ * license.
+ *
+ * See README and COPYING for more details.
+ */
+
+#include "includes.h"
+
+#include "common.h"
+#include "aes.h"
+#include "aes_wrap.h"
+
+/**
+ * aes_unwrap - Unwrap key with AES Key Wrap Algorithm (128-bit KEK) (RFC3=
394)
+ * @kek: Key encryption key (KEK)
+ * @n: Length of the plaintext key in 64-bit units; e.g., 2 =3D 128-bit =
=3D 16
+ * bytes
+ * @cipher: Wrapped key to be unwrapped, (n + 1) * 64 bits
+ * @plain: Plaintext key, n * 64 bits
+ * Returns: 0 on success, -1 on failure (e.g., integrity verification fail=
ed)
+ */
+int aes_unwrap(const u8 *kek, int n, const u8 *cipher, u8 *plain)
+{
+	u8 a[8], *r, b[16];
+	int i, j;
+	void *ctx;
+
+	/* 1) Initialize variables. */
+	os_memcpy(a, cipher, 8);
+	r =3D plain;
+	os_memcpy(r, cipher + 8, 8 * n);
+
+	ctx =3D aes_decrypt_init(kek, 16);
+	if (ctx =3D=3D NULL)
+		return -1;
+
+	/* 2) Compute intermediate values.
+	 * For j =3D 5 to 0
+	 *     For i =3D n to 1
+	 *         B =3D AES-1(K, (A ^ t) | R[i]) where t =3D n*j+i
+	 *         A =3D MSB(64, B)
+	 *         R[i] =3D LSB(64, B)
+	 */
+	for (j =3D 5; j >=3D 0; j--) {
+		r =3D plain + (n - 1) * 8;
+		for (i =3D n; i >=3D 1; i--) {
+			os_memcpy(b, a, 8);
+			b[7] ^=3D n * j + i;
+
+			os_memcpy(b + 8, r, 8);
+			aes_decrypt(ctx, b, b);
+			os_memcpy(a, b, 8);
+			os_memcpy(r, b + 8, 8);
+			r -=3D 8;
+		}
+	}
+	aes_decrypt_deinit(ctx);
+
+	/* 3) Output results.
+	 *
+	 * These are already in @plain due to the location of temporary
+	 * variables. Just verify that the IV matches with the expected value.
+	 */
+	for (i =3D 0; i < 8; i++) {
+		if (a[i] !=3D 0xa6)
+			return -1;
+	}
+
+	return 0;
+}
