+static int rtw_adapter_proc_open(struct inode *inode, struct file *file)
+{
+	ssize_t index =3D (ssize_t)PDE_DATA(inode);
+	const struct rtw_proc_hdl *hdl =3D adapter_proc_hdls + index;
+	void *private =3D proc_get_parent_data(inode);
+
+	if (hdl->type =3D=3D RTW_PROC_HDL_TYPE_SEQ) {
+		int res =3D seq_open(file, hdl->u.seq_op);
+
+		if (res =3D=3D 0)
+			((struct seq_file *)file->private_data)->private =3D private;
+
+		return res;
+	} else if (hdl->type =3D=3D RTW_PROC_HDL_TYPE_SSEQ) {
+		int (*show)(struct seq_file *, void *) =3D hdl->u.show ? hdl->u.show : p=
roc_get_dummy;
+
+		return single_open(file, show, private);
+	} else {
+		return -EROFS;
+	}
+}
