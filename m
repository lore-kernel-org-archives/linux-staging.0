+		 0)
+		*pOutFunctionPointer =3D TNC_TNCS_RequestHandshakeRetry;
+	else if (os_strcmp(functionName, "TNC_TNCS_ProvideRecommendation") =3D=3D
+		 0)
+		*pOutFunctionPointer =3D TNC_TNCS_ProvideRecommendation;
+	else if (os_strcmp(functionName, "TNC_TNCS_GetAttribute") =3D=3D 0)
+		*pOutFunctionPointer =3D TNC_TNCS_GetAttribute;
+	else if (os_strcmp(functionName, "TNC_TNCS_SetAttribute") =3D=3D 0)
+		*pOutFunctionPointer =3D TNC_TNCS_SetAttribute;
