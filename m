+sint validate_recv_ctrl_frame(_adapter *padapter, union recv_frame *precv_=
frame);
+sint validate_recv_ctrl_frame(_adapter *padapter, union recv_frame *precv_=
frame)
+{
+	struct rx_pkt_attrib *pattrib =3D &precv_frame->u.hdr.attrib;
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+	u8 *pframe =3D precv_frame->u.hdr.rx_data;
+	struct sta_info *psta =3D NULL;
+	/* uint len =3D precv_frame->u.hdr.len; */
+
+	/* RTW_INFO("+validate_recv_ctrl_frame\n"); */
+
+	if (GetFrameType(pframe) !=3D WIFI_CTRL_TYPE)
+		return _FAIL;
+
+	/* receive the frames that ra(a1) is my address */
+	if (memcmp(GetAddr1Ptr(pframe), adapter_mac_addr(padapter), ETH_ALEN))
+		return _FAIL;
+
+	psta =3D rtw_get_stainfo(pstapriv, get_addr2_ptr(pframe));
+	if (psta =3D=3D NULL)
+		return _FAIL;
+
+	/* for rx pkt statistics */
+	psta->sta_stats.rx_ctrl_pkts++;
+
+	/* only handle ps-poll */
+	if (get_frame_sub_type(pframe) =3D=3D WIFI_PSPOLL) {
+#ifdef CONFIG_AP_MODE
+		u16 aid;
+		u8 wmmps_ac =3D 0;
+
+		aid =3D GetAid(pframe);
+		if (psta->aid !=3D aid)
+			return _FAIL;
+
+		switch (pattrib->priority) {
+		case 1:
+		case 2:
+			wmmps_ac =3D psta->uapsd_bk & BIT(0);
+			break;
+		case 4:
+		case 5:
+			wmmps_ac =3D psta->uapsd_vi & BIT(0);
+			break;
+		case 6:
+		case 7:
+			wmmps_ac =3D psta->uapsd_vo & BIT(0);
+			break;
+		case 0:
+		case 3:
+		default:
+			wmmps_ac =3D psta->uapsd_be & BIT(0);
+			break;
+		}
+
+		if (wmmps_ac)
+			return _FAIL;
+
+		if (psta->state & WIFI_STA_ALIVE_CHK_STATE) {
+			RTW_INFO("%s alive check-rx ps-poll\n", __func__);
+			psta->expire_to =3D pstapriv->expire_to;
+			psta->state ^=3D WIFI_STA_ALIVE_CHK_STATE;
+		}
+
+		if ((psta->state & WIFI_SLEEP_STATE) && (pstapriv->sta_dz_bitmap & BIT(p=
sta->aid))) {
+			unsigned long irqL;
+			_list	*xmitframe_plist, *xmitframe_phead;
+			struct xmit_frame *pxmitframe =3D NULL;
+			struct xmit_priv *pxmitpriv =3D &padapter->xmitpriv;
+
+			/* _enter_critical_bh(&psta->sleep_q.lock, &irqL); */
+			_enter_critical_bh(&pxmitpriv->lock, &irqL);
+
+			xmitframe_phead =3D get_list_head(&psta->sleep_q);
+			xmitframe_plist =3D get_next(xmitframe_phead);
+
+			if ((rtw_end_of_queue_search(xmitframe_phead, xmitframe_plist)) =3D=3D =
false) {
+				pxmitframe =3D LIST_CONTAINOR(xmitframe_plist, struct xmit_frame, list=
);
+
+				xmitframe_plist =3D get_next(xmitframe_plist);
+
+				list_del_init(&pxmitframe->list);
+
+				psta->sleepq_len--;
+
+				if (psta->sleepq_len > 0)
+					pxmitframe->attrib.mdata =3D 1;
+				else
+					pxmitframe->attrib.mdata =3D 0;
+
+				pxmitframe->attrib.triggered =3D 1;
+
+				/* RTW_INFO("handling ps-poll, q_len=3D%d, tim=3D%x\n", psta->sleepq_l=
en, pstapriv->tim_bitmap); */
+
+				rtw_hal_xmitframe_enqueue(padapter, pxmitframe);
+
+				if (psta->sleepq_len =3D=3D 0) {
+					pstapriv->tim_bitmap &=3D ~BIT(psta->aid);
+
+					/* RTW_INFO("after handling ps-poll, tim=3D%x\n", pstapriv->tim_bitma=
p); */
+
+					/* upate BCN for TIM IE */
+					/* update_BCNTIM(padapter);		 */
+					update_beacon(padapter, _TIM_IE_, NULL, true);
+				}
+
+				/* _exit_critical_bh(&psta->sleep_q.lock, &irqL); */
+				_exit_critical_bh(&pxmitpriv->lock, &irqL);
+
+			} else {
+				/* _exit_critical_bh(&psta->sleep_q.lock, &irqL); */
+				_exit_critical_bh(&pxmitpriv->lock, &irqL);
+
+				/* RTW_INFO("no buffered packets to xmit\n"); */
+				if (pstapriv->tim_bitmap & BIT(psta->aid)) {
+					if (psta->sleepq_len =3D=3D 0) {
+						RTW_INFO("no buffered packets to xmit\n");
+
+						/* issue nulldata with More data bit =3D 0 to indicate we have no bu=
ffered packets */
+						issue_nulldata_in_interrupt(padapter, psta->hwaddr, 0);
+					} else {
+						RTW_INFO("error!psta->sleepq_len=3D%d\n", psta->sleepq_len);
+						psta->sleepq_len =3D 0;
+					}
+
+					pstapriv->tim_bitmap &=3D ~BIT(psta->aid);
+
+					/* upate BCN for TIM IE */
+					/* update_BCNTIM(padapter); */
+					update_beacon(padapter, _TIM_IE_, NULL, true);
+				}
+			}
+		}
+#endif /* CONFIG_AP_MODE */
+	} else if (get_frame_sub_type(pframe) =3D=3D WIFI_NDPA) {
+#ifdef CONFIG_BEAMFORMING
+		beamforming_get_ndpa_frame(padapter, precv_frame);
+#endif/*CONFIG_BEAMFORMING*/
+	}
+
+	return _FAIL;
+
+}
