+	hdr =3D (struct ieee80211_hdr *) buf;
+	hapd =3D get_hapd_bssid(hapd->iface, get_hdr_bssid(hdr, len));
+	if (hapd =3D=3D NULL || hapd =3D=3D HAPD_BROADCAST)
+		return;
+	ieee802_11_mgmt_cb(hapd, buf, len, stype, ok);
+}
