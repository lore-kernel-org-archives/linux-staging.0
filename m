+		os_free(tncs->imv_data[i].imv_send);
+		tncs->imv_data[i].imv_send =3D NULL;
+		tncs->imv_data[i].imv_send_len =3D 0;
+	}
+
+	if (tncs->tncs_message) {
+		size_t len =3D os_strlen(tncs->tncs_message);
+		os_memcpy(pos, tncs->tncs_message, len);
+		pos +=3D len;
+		os_free(tncs->tncs_message);
+		tncs->tncs_message =3D NULL;
+	}
+
+	return pos;
+}
