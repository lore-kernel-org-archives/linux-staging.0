+/*Y =3D 10*log(X)*/
+s32
+odm_pwdb_conversion(
+	s32 X,
+	u32 total_bit,
+	u32 decimal_bit
+)
+{
+	s32 Y, integer =3D 0, decimal =3D 0;
+	u32 i;
+
+	if (X =3D=3D 0)
+		X =3D 1; /* log2(x), x can't be 0 */
+
+	for (i =3D (total_bit - 1); i > 0; i--) {
+		if (X & BIT(i)) {
+			integer =3D i;
+			if (i > 0)
+				decimal =3D (X & BIT(i - 1)) ? 2 : 0; /* decimal is 0.5dB*3=3D1.5dB~=
=3D2dB */
+			break;
+		}
+	}
+
+	Y =3D 3 * (integer - decimal_bit) + decimal; /* 10*log(x)=3D3*log2(x), */
+
+	return Y;
+}
