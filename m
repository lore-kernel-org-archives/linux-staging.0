_file_map_path);
+		Status =3D rtw_efuse_file_read(padapter, rtw_efuse_file_map_path, pEfuse=
Hal->fakeEfuseModifiedMap, sizeof(pEfuseHal->fakeEfuseModifiedMap));
+		if (Status =3D=3D true) {
+			pmp_priv->bloadefusemap =3D true;
+			sprintf(extra, "efuse file file_read OK\n");
+		} else {
+			pmp_priv->bloadefusemap =3D false;
+			sprintf(extra, "efuse file file_read FAIL\n");
+		}
+	} else {
+		sprintf(extra, "efuse file readable FAIL\n");
+		RTW_INFO("%s rtw_is_file_readable fail!\n", __func__);
