+#ifdef CONFIG_TX_AMSDU
+			if (padapter->tx_amsdu >=3D 1) /* TX AMSDU  enabled */
+				BA_para_set |=3D BIT(0);
+			else /* TX AMSDU disabled */
+				BA_para_set &=3D ~BIT(0);
+#endif
+			le_val =3D cpu_to_le16(BA_para_set);
+			pframe =3D rtw_set_fixed_ie(pframe, 2, (unsigned char *)(&(le_val)), &(=
pattrib->pktlen));
+
+			/* BA_timeout_value =3D 0xffff; */ /* max: 65535 TUs(~ 65 ms) */
+			BA_timeout_value =3D 5000;/* ~ 5ms */
+			le_val =3D cpu_to_le16(BA_timeout_value);
+			pframe =3D rtw_set_fixed_ie(pframe, 2, (unsigned char *)(&(le_val)), &(=
pattrib->pktlen));
