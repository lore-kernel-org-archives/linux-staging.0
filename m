+u8 * wpa_sm_write_assoc_resp_ies(struct wpa_state_machine *sm, u8 *pos,
+				 size_t max_len, int auth_alg,
+				 const u8 *req_ies, size_t req_ies_len)
+{
+	u8 *end, *mdie, *ftie, *rsnie =3D NULL, *r0kh_id, *subelem =3D NULL;
+	size_t mdie_len, ftie_len, rsnie_len =3D 0, r0kh_id_len, subelem_len =3D =
0;
+	int res;
+	struct wpa_auth_config *conf;
+	struct rsn_ftie *_ftie;
+	struct wpa_ft_ies parse;
+	u8 *ric_start;
+	u8 *anonce, *snonce;
+
+	if (sm =3D=3D NULL)
+		return pos;
+
+	conf =3D &sm->wpa_auth->conf;
+
+	if (sm->wpa_key_mgmt !=3D WPA_KEY_MGMT_FT_IEEE8021X &&
+	    sm->wpa_key_mgmt !=3D WPA_KEY_MGMT_FT_PSK)
+		return pos;
+
+	end =3D pos + max_len;
+
+	if (auth_alg =3D=3D WLAN_AUTH_FT) {
+		/*
+		 * RSN (only present if this is a Reassociation Response and
+		 * part of a fast BSS transition)
+		 */
+		res =3D wpa_write_rsn_ie(conf, pos, end - pos, sm->pmk_r1_name);
+		if (res < 0)
+			return pos;
+		rsnie =3D pos;
+		rsnie_len =3D res;
+		pos +=3D res;
+	}
+
+	/* Mobility Domain Information */
+	res =3D wpa_write_mdie(conf, pos, end - pos);
+	if (res < 0)
+		return pos;
+	mdie =3D pos;
+	mdie_len =3D res;
+	pos +=3D res;
+
+	/* Fast BSS Transition Information */
+	if (auth_alg =3D=3D WLAN_AUTH_FT) {
+		subelem =3D wpa_ft_gtk_subelem(sm, &subelem_len);
+		r0kh_id =3D sm->r0kh_id;
+		r0kh_id_len =3D sm->r0kh_id_len;
+		anonce =3D sm->ANonce;
+		snonce =3D sm->SNonce;
+#ifdef CONFIG_IEEE80211W
+		if (sm->mgmt_frame_prot) {
+			u8 *igtk;
+			size_t igtk_len;
+			u8 *nbuf;
+			igtk =3D wpa_ft_igtk_subelem(sm, &igtk_len);
+			if (igtk =3D=3D NULL) {
+				os_free(subelem);
+				return pos;
+			}
+			nbuf =3D os_realloc(subelem, subelem_len + igtk_len);
+			if (nbuf =3D=3D NULL) {
+				os_free(subelem);
+				os_free(igtk);
+				return pos;
+			}
+			subelem =3D nbuf;
+			os_memcpy(subelem + subelem_len, igtk, igtk_len);
+			subelem_len +=3D igtk_len;
+			os_free(igtk);
+		}
+#endif /* CONFIG_IEEE80211W */
+	} else {
+		r0kh_id =3D conf->r0_key_holder;
+		r0kh_id_len =3D conf->r0_key_holder_len;
+		anonce =3D NULL;
+		snonce =3D NULL;
+	}
+	res =3D wpa_write_ftie(conf, r0kh_id, r0kh_id_len, anonce, snonce, pos,
+			     end - pos, subelem, subelem_len);
+	os_free(subelem);
+	if (res < 0)
+		return pos;
+	ftie =3D pos;
+	ftie_len =3D res;
+	pos +=3D res;
+
+	os_free(sm->assoc_resp_ftie);
+	sm->assoc_resp_ftie =3D os_malloc(ftie_len);
+	if (sm->assoc_resp_ftie)
+		os_memcpy(sm->assoc_resp_ftie, ftie, ftie_len);
+
+	_ftie =3D (struct rsn_ftie *) (ftie + 2);
+	if (auth_alg =3D=3D WLAN_AUTH_FT)
+		_ftie->mic_control[1] =3D 3; /* Information element count */
+
+	ric_start =3D pos;
+	if (wpa_ft_parse_ies(req_ies, req_ies_len, &parse) =3D=3D 0 && parse.ric)=
 {
+		pos =3D wpa_ft_process_ric(pos, end, parse.ric, parse.ric_len);
+		if (auth_alg =3D=3D WLAN_AUTH_FT)
+			_ftie->mic_control[1] +=3D
+				ieee802_11_ie_count(ric_start,
+						    pos - ric_start);
+	}
+	if (ric_start =3D=3D pos)
+		ric_start =3D NULL;
+
+	if (auth_alg =3D=3D WLAN_AUTH_FT &&
+	    wpa_ft_mic(sm->PTK.kck, sm->addr, sm->wpa_auth->addr, 6,
+		       mdie, mdie_len, ftie, ftie_len,
+		       rsnie, rsnie_len,
+		       ric_start, ric_start ? pos - ric_start : 0,
+		       _ftie->mic) < 0)
+		wpa_printf(MSG_DEBUG, "FT: Failed to calculate MIC");
+
+	return pos;
+}
