+	set_frame_sub_type(pframe, attrib->subtype);
+
+	/* Duration */
+	if (is_supported_5g(pmlmeext->cur_wireless_mode) || is_supported_ht(pmlme=
ext->cur_wireless_mode))
+		aSifsTime =3D 16;
+	else
+		aSifsTime =3D 10;
+	duration =3D 2 * aSifsTime + 44;
+	if (bw =3D=3D CHANNEL_WIDTH_80)
+		duration +=3D 40;
+	else if (bw =3D=3D CHANNEL_WIDTH_40)
+		duration +=3D 87;
+	else
+		duration +=3D 180;
