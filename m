+
+/**
+ * radius_msg_get_vlanid - Parse RADIUS attributes for VLAN tunnel informa=
tion
+ * @msg: RADIUS message
+ * Returns: VLAN ID for the first tunnel configuration of -1 if none is fo=
und
+ */
+int radius_msg_get_vlanid(struct radius_msg *msg)
+{
+	struct radius_tunnel_attrs tunnel[RADIUS_TUNNEL_TAGS], *tun;
+	size_t i;
+	struct radius_attr_hdr *attr =3D NULL;
+	const u8 *data;
+	char buf[10];
+	size_t dlen;
+
+	os_memset(&tunnel, 0, sizeof(tunnel));
+
+	for (i =3D 0; i < msg->attr_used; i++) {
+		attr =3D radius_get_attr_hdr(msg, i);
+		data =3D (const u8 *) (attr + 1);
+		dlen =3D attr->length - sizeof(*attr);
+		if (attr->length < 3)
+			continue;
+		if (data[0] >=3D RADIUS_TUNNEL_TAGS)
+			tun =3D &tunnel[0];
+		else
+			tun =3D &tunnel[data[0]];
+
+		switch (attr->type) {
+		case RADIUS_ATTR_TUNNEL_TYPE:
+			if (attr->length !=3D 6)
+				break;
+			tun->tag_used++;
+			tun->type =3D WPA_GET_BE24(data + 1);
+			break;
+		case RADIUS_ATTR_TUNNEL_MEDIUM_TYPE:
+			if (attr->length !=3D 6)
+				break;
+			tun->tag_used++;
+			tun->medium_type =3D WPA_GET_BE24(data + 1);
+			break;
+		case RADIUS_ATTR_TUNNEL_PRIVATE_GROUP_ID:
+			if (data[0] < RADIUS_TUNNEL_TAGS) {
+				data++;
+				dlen--;
+			}
+			if (dlen >=3D sizeof(buf))
+				break;
+			os_memcpy(buf, data, dlen);
+			buf[dlen] =3D '\0';
+			tun->tag_used++;
+			tun->vlanid =3D atoi(buf);
+			break;
+		}
+	}
+
+	for (i =3D 0; i < RADIUS_TUNNEL_TAGS; i++) {
+		tun =3D &tunnel[i];
+		if (tun->tag_used &&
+		    tun->type =3D=3D RADIUS_TUNNEL_TYPE_VLAN &&
+		    tun->medium_type =3D=3D RADIUS_TUNNEL_MEDIUM_TYPE_802 &&
+		    tun->vlanid > 0)
+			return tun->vlanid;
+	}
+
+	return -1;
+}
+
+
+void radius_free_class(struct radius_class_data *c)
+{
+	size_t i;
+	if (c =3D=3D NULL)
+		return;
+	for (i =3D 0; i < c->count; i++)
+		os_free(c->attr[i].data);
+	os_free(c->attr);
+	c->attr =3D NULL;
+	c->count =3D 0;
+}
+
+
+int radius_copy_class(struct radius_class_data *dst,
+		      const struct radius_class_data *src)
+{
+	size_t i;
+
+	if (src->attr =3D=3D NULL)
+		return 0;
+
+	dst->attr =3D os_zalloc(src->count * sizeof(struct radius_attr_data));
+	if (dst->attr =3D=3D NULL)
+		return -1;
+
+	dst->count =3D 0;
+
+	for (i =3D 0; i < src->count; i++) {
+		dst->attr[i].data =3D os_malloc(src->attr[i].len);
+		if (dst->attr[i].data =3D=3D NULL)
+			break;
+		dst->count++;
+		os_memcpy(dst->attr[i].data, src->attr[i].data,
+			  src->attr[i].len);
+		dst->attr[i].len =3D src->attr[i].len;
+	}
+
+	return 0;
+}
