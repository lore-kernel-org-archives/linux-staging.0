+	*(fctrl) =3D 0;
+
+	if (da) {
+		/*	unicast probe request frame */
+		memcpy(pwlanhdr->addr1, da, ETH_ALEN);
+		memcpy(pwlanhdr->addr3, da, ETH_ALEN);
+	} else {
+		/*	broadcast probe request frame */
+		memcpy(pwlanhdr->addr1, bc_addr, ETH_ALEN);
+		memcpy(pwlanhdr->addr3, bc_addr, ETH_ALEN);
+	}
+
+	memcpy(pwlanhdr->addr2, mac, ETH_ALEN);
+
+	SetSeqNum(pwlanhdr, pmlmeext->mgnt_seq);
+	pmlmeext->mgnt_seq++;
+	set_frame_sub_type(pframe, WIFI_PROBEREQ);
+
+	pframe +=3D sizeof(struct rtw_ieee80211_hdr_3addr);
+	pattrib->pktlen =3D sizeof(struct rtw_ieee80211_hdr_3addr);
+
+	if (pssid)
+		pframe =3D rtw_set_ie(pframe, _SSID_IE_, pssid->SsidLength, pssid->Ssid,=
 &(pattrib->pktlen));
+	else
+		pframe =3D rtw_set_ie(pframe, _SSID_IE_, 0, NULL, &(pattrib->pktlen));
+
+	get_rate_set(padapter, bssrate, &bssrate_len);
+
+	if (bssrate_len > 8) {
+		pframe =3D rtw_set_ie(pframe, _SUPPORTEDRATES_IE_ , 8, bssrate, &(pattri=
b->pktlen));
+		pframe =3D rtw_set_ie(pframe, _EXT_SUPPORTEDRATES_IE_ , (bssrate_len - 8=
), (bssrate + 8), &(pattrib->pktlen));
+	} else
+		pframe =3D rtw_set_ie(pframe, _SUPPORTEDRATES_IE_ , bssrate_len , bssrat=
e, &(pattrib->pktlen));
+
+	if (ch)
+		pframe =3D rtw_set_ie(pframe, _DSSET_IE_, 1, &ch, &pattrib->pktlen);
+
+	if (append_wps) {
+		/* add wps_ie for wps2.0 */
+		if (pmlmepriv->wps_probe_req_ie_len > 0 && pmlmepriv->wps_probe_req_ie) {
+			memcpy(pframe, pmlmepriv->wps_probe_req_ie, pmlmepriv->wps_probe_req_ie=
_len);
+			pframe +=3D pmlmepriv->wps_probe_req_ie_len;
+			pattrib->pktlen +=3D pmlmepriv->wps_probe_req_ie_len;
+			/* pmlmepriv->wps_probe_req_ie_len =3D 0 ; */ /* reset to zero */
+		}
+	}
+#ifdef CONFIG_APPEND_VENDOR_IE_ENABLE
+	pattrib->pktlen +=3D rtw_build_vendor_ie(padapter , pframe , WIFI_PROBERE=
Q_VENDOR_IE_BIT);
+#endif
+
+	pattrib->last_txcmdsz =3D pattrib->pktlen;
+
+
+	if (wait_ack)
+		ret =3D dump_mgntframe_and_wait_ack(padapter, pmgntframe);
+	else {
+		dump_mgntframe(padapter, pmgntframe);
+		ret =3D _SUCCESS;
+	}
+
+exit:
+	return ret;
+}
