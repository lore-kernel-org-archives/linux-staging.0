+
+static int wpa_driver_ndis_add_pmkid(void *priv, const u8 *bssid,
+				     const u8 *pmkid)
+{
+	struct wpa_driver_ndis_data *drv =3D priv;
+	struct ndis_pmkid_entry *entry, *prev;
+
+	if (drv->no_of_pmkid =3D=3D 0)
+		return 0;
+
+	prev =3D NULL;
+	entry =3D drv->pmkid;
+	while (entry) {
+		if (os_memcmp(entry->bssid, bssid, ETH_ALEN) =3D=3D 0)
+			break;
+		prev =3D entry;
+		entry =3D entry->next;
+	}
+
+	if (entry) {
+		/* Replace existing entry for this BSSID and move it into the
+		 * beginning of the list. */
+		os_memcpy(entry->pmkid, pmkid, 16);
+		if (prev) {
+			prev->next =3D entry->next;
+			entry->next =3D drv->pmkid;
+			drv->pmkid =3D entry;
+		}
+	} else {
+		entry =3D os_malloc(sizeof(*entry));
+		if (entry) {
+			os_memcpy(entry->bssid, bssid, ETH_ALEN);
+			os_memcpy(entry->pmkid, pmkid, 16);
+			entry->next =3D drv->pmkid;
+			drv->pmkid =3D entry;
+		}
+	}
+
+	return wpa_driver_ndis_set_pmkid(drv);
+}
+
+
+static int wpa_driver_ndis_remove_pmkid(void *priv, const u8 *bssid,
+		 			const u8 *pmkid)
+{
+	struct wpa_driver_ndis_data *drv =3D priv;
+	struct ndis_pmkid_entry *entry, *prev;
+
+	if (drv->no_of_pmkid =3D=3D 0)
+		return 0;
+
+	entry =3D drv->pmkid;
+	prev =3D NULL;
+	while (entry) {
+		if (os_memcmp(entry->bssid, bssid, ETH_ALEN) =3D=3D 0 &&
+		    os_memcmp(entry->pmkid, pmkid, 16) =3D=3D 0) {
+			if (prev)
+				prev->next =3D entry->next;
+			else
+				drv->pmkid =3D entry->next;
+			os_free(entry);
+			break;
+		}
+		prev =3D entry;
+		entry =3D entry->next;
+	}
+	return wpa_driver_ndis_set_pmkid(drv);
+}
+
+
+static int wpa_driver_ndis_flush_pmkid(void *priv)
+{
+	struct wpa_driver_ndis_data *drv =3D priv;
+	NDIS_802_11_PMKID p;
+	struct ndis_pmkid_entry *pmkid, *prev;
+	int prev_authmode, ret;
+
+	if (drv->no_of_pmkid =3D=3D 0)
+		return 0;
+
+	pmkid =3D drv->pmkid;
+	drv->pmkid =3D NULL;
+	while (pmkid) {
+		prev =3D pmkid;
+		pmkid =3D pmkid->next;
+		os_free(prev);
+	}
+
+	/*
+	 * Some drivers may refuse OID_802_11_PMKID if authMode is not set to
+	 * WPA2, so change authMode temporarily, if needed.
+	 */
+	prev_authmode =3D ndis_get_auth_mode(drv);
+	if (prev_authmode !=3D Ndis802_11AuthModeWPA2)
+		ndis_set_auth_mode(drv, Ndis802_11AuthModeWPA2);
+
+	os_memset(&p, 0, sizeof(p));
+	p.Length =3D 8;
+	p.BSSIDInfoCount =3D 0;
+	wpa_hexdump(MSG_MSGDUMP, "NDIS: OID_802_11_PMKID (flush)",
+		    (u8 *) &p, 8);
+	ret =3D ndis_set_oid(drv, OID_802_11_PMKID, (char *) &p, 8);
+
+	if (prev_authmode !=3D Ndis802_11AuthModeWPA2)
+		ndis_set_auth_mode(drv, prev_authmode);
+
+	return ret;
+}
