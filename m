+static int wpa_driver_ndis_get_names(struct wpa_driver_ndis_data *drv)
+{
+#ifdef CONFIG_USE_NDISUIO
+	NDISUIO_QUERY_BINDING *b;
+	size_t blen =3D sizeof(*b) + 1024;
+	int i, error, found =3D 0;
+	DWORD written;
+	char name[256], desc[256], *dpos;
+	WCHAR *pos;
+	size_t j, len, dlen;
+
+	b =3D os_malloc(blen);
+	if (b =3D=3D NULL)
+		return -1;
+
+	for (i =3D 0; ; i++) {
+		os_memset(b, 0, blen);
+		b->BindingIndex =3D i;
+		if (!DeviceIoControl(drv->ndisuio, IOCTL_NDISUIO_QUERY_BINDING,
+				     b, sizeof(NDISUIO_QUERY_BINDING), b, blen,
+				     &written, NULL)) {
+			error =3D (int) GetLastError();
+			if (error =3D=3D ERROR_NO_MORE_ITEMS)
+				break;
+			wpa_printf(MSG_DEBUG, "IOCTL_NDISUIO_QUERY_BINDING "
+				   "failed: %d", error);
+			break;
+		}
+
+		pos =3D (WCHAR *) ((char *) b + b->DeviceNameOffset);
+		len =3D b->DeviceNameLength;
+		if (len >=3D sizeof(name))
+			len =3D sizeof(name) - 1;
+		for (j =3D 0; j < len; j++)
+			name[j] =3D (char) pos[j];
+		name[len] =3D '\0';
+
+		pos =3D (WCHAR *) ((char *) b + b->DeviceDescrOffset);
+		len =3D b->DeviceDescrLength;
+		if (len >=3D sizeof(desc))
+			len =3D sizeof(desc) - 1;
+		for (j =3D 0; j < len; j++)
+			desc[j] =3D (char) pos[j];
+		desc[len] =3D '\0';
+
+		wpa_printf(MSG_DEBUG, "NDIS: %d - %s - %s", i, name, desc);
+
+		if (os_strstr(name, drv->ifname)) {
+			wpa_printf(MSG_DEBUG, "NDIS: Interface name match");
+			found =3D 1;
+			break;
+		}
+
+		if (os_strncmp(desc, drv->ifname, os_strlen(drv->ifname)) =3D=3D 0)
+		{
+			wpa_printf(MSG_DEBUG, "NDIS: Interface description "
+				   "match");
+			found =3D 1;
+			break;
+		}
+	}
+
+	if (!found) {
+		wpa_printf(MSG_DEBUG, "NDIS: Could not find interface '%s'",
+			   drv->ifname);
+		os_free(b);
+		return -1;
+	}
+
+	os_strlcpy(drv->ifname,
+		   os_strncmp(name, "\\DEVICE\\", 8) =3D=3D 0 ? name + 8 : name,
+		   sizeof(drv->ifname));
+#ifdef _WIN32_WCE
+	drv->adapter_name =3D wpa_strdup_tchar(drv->ifname);
+	if (drv->adapter_name =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "NDIS: Failed to allocate memory for "
+			   "adapter name");
+		os_free(b);
+		return -1;
+	}
+#endif /* _WIN32_WCE */
+
+	dpos =3D os_strstr(desc, " - ");
+	if (dpos)
+		dlen =3D dpos - desc;
+	else
+		dlen =3D os_strlen(desc);
+	drv->adapter_desc =3D os_malloc(dlen + 1);
+	if (drv->adapter_desc) {
+		os_memcpy(drv->adapter_desc, desc, dlen);
+		drv->adapter_desc[dlen] =3D '\0';
+	}
+
+	os_free(b);
+
+	if (drv->adapter_desc =3D=3D NULL)
+		return -1;
+
+	wpa_printf(MSG_DEBUG, "NDIS: Adapter description prefix '%s'",
+		   drv->adapter_desc);
+
+	return 0;
+#else /* CONFIG_USE_NDISUIO */
+	PTSTR _names;
+	char *names, *pos, *pos2;
+	ULONG len;
+	BOOLEAN res;
+#define MAX_ADAPTERS 32
+	char *name[MAX_ADAPTERS];
+	char *desc[MAX_ADAPTERS];
+	int num_name, num_desc, i, found_name, found_desc;
+	size_t dlen;
+
+	wpa_printf(MSG_DEBUG, "NDIS: Packet.dll version: %s",
+		   PacketGetVersion());
+
+	len =3D 8192;
+	_names =3D os_zalloc(len);
+	if (_names =3D=3D NULL)
+		return -1;
+
+	res =3D PacketGetAdapterNames(_names, &len);
+	if (!res && len > 8192) {
+		os_free(_names);
+		_names =3D os_zalloc(len);
+		if (_names =3D=3D NULL)
+			return -1;
+		res =3D PacketGetAdapterNames(_names, &len);
+	}
+
+	if (!res) {
+		wpa_printf(MSG_ERROR, "NDIS: Failed to get adapter list "
+			   "(PacketGetAdapterNames)");
+		os_free(_names);
+		return -1;
+	}
+
+	names =3D (char *) _names;
+	if (names[0] && names[1] =3D=3D '\0' && names[2] && names[3] =3D=3D '\0')=
 {
+		wpa_printf(MSG_DEBUG, "NDIS: Looks like adapter names are in "
+			   "UNICODE");
+		/* Convert to ASCII */
+		pos2 =3D pos =3D names;
+		while (pos2 < names + len) {
+			if (pos2[0] =3D=3D '\0' && pos2[1] =3D=3D '\0' &&
+			    pos2[2] =3D=3D '\0' && pos2[3] =3D=3D '\0') {
+				pos2 +=3D 4;
+				break;
+			}
+			*pos++ =3D pos2[0];
+			pos2 +=3D 2;
+		}
+		os_memcpy(pos + 2, names, pos - names);
+		pos +=3D 2;
+	} else
+		pos =3D names;
+
+	num_name =3D 0;
+	while (pos < names + len) {
+		name[num_name] =3D pos;
+		while (*pos && pos < names + len)
+			pos++;
+		if (pos + 1 >=3D names + len) {
+			os_free(names);
+			return -1;
+		}
+		pos++;
+		num_name++;
+		if (num_name >=3D MAX_ADAPTERS) {
+			wpa_printf(MSG_DEBUG, "NDIS: Too many adapters");
+			os_free(names);
+			return -1;
+		}
+		if (*pos =3D=3D '\0') {
+			wpa_printf(MSG_DEBUG, "NDIS: %d adapter names found",
+				   num_name);
+			pos++;
+			break;
+		}
+	}
+
+	num_desc =3D 0;
+	while (pos < names + len) {
+		desc[num_desc] =3D pos;
+		while (*pos && pos < names + len)
+			pos++;
+		if (pos + 1 >=3D names + len) {
+			os_free(names);
+			return -1;
+		}
+		pos++;
+		num_desc++;
+		if (num_desc >=3D MAX_ADAPTERS) {
+			wpa_printf(MSG_DEBUG, "NDIS: Too many adapter "
+				   "descriptions");
+			os_free(names);
+			return -1;
+		}
+		if (*pos =3D=3D '\0') {
+			wpa_printf(MSG_DEBUG, "NDIS: %d adapter descriptions "
+				   "found", num_name);
+			pos++;
+			break;
+		}
+	}
+
+	/*
+	 * Windows 98 with Packet.dll 3.0 alpha3 does not include adapter
+	 * descriptions. Fill in dummy descriptors to work around this.
+	 */
+	while (num_desc < num_name)
+		desc[num_desc++] =3D "dummy description";
+
+	if (num_name !=3D num_desc) {
+		wpa_printf(MSG_DEBUG, "NDIS: mismatch in adapter name and "
+			   "description counts (%d !=3D %d)",
+			   num_name, num_desc);
+		os_free(names);
+		return -1;
+	}
+
+	found_name =3D found_desc =3D -1;
+	for (i =3D 0; i < num_name; i++) {
+		wpa_printf(MSG_DEBUG, "NDIS: %d - %s - %s",
+			   i, name[i], desc[i]);
+		if (found_name =3D=3D -1 && os_strstr(name[i], drv->ifname))
+			found_name =3D i;
+		if (found_desc =3D=3D -1 &&
+		    os_strncmp(desc[i], drv->ifname, os_strlen(drv->ifname)) =3D=3D
+		    0)
