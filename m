+int wifirate2_ratetbl_inx(unsigned char rate)
+{
+	int	inx =3D 0;
+	rate =3D rate & 0x7f;
+
+	switch (rate) {
+	case 54*2:
+		inx =3D 11;
+		break;
+
+	case 48*2:
+		inx =3D 10;
+		break;
+
+	case 36*2:
+		inx =3D 9;
+		break;
+
+	case 24*2:
+		inx =3D 8;
+		break;
+
+	case 18*2:
+		inx =3D 7;
+		break;
+
+	case 12*2:
+		inx =3D 6;
+		break;
+
+	case 9*2:
+		inx =3D 5;
+		break;
+
+	case 6*2:
+		inx =3D 4;
+		break;
+
+	case 11*2:
+		inx =3D 3;
+		break;
+	case 11:
+		inx =3D 2;
+		break;
+
+	case 2*2:
+		inx =3D 1;
+		break;
+
+	case 1*2:
+		inx =3D 0;
+		break;
+
+	}
+	return inx;
+}
