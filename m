+static struct wpabuf * p2p_build_presence_req(u32 duration1, u32 interval1,
+					      u32 duration2, u32 interval2)
+{
+	struct wpabuf *req;
+	struct p2p_noa_desc desc1, desc2, *ptr1 =3D NULL, *ptr2 =3D NULL;
+	u8 *len;
+
+	req =3D wpabuf_alloc(100);
+	if (req =3D=3D NULL)
+		return NULL;
+
+	if (duration1 || interval1) {
+		os_memset(&desc1, 0, sizeof(desc1));
+		desc1.count_type =3D 1;
+		desc1.duration =3D duration1;
+		desc1.interval =3D interval1;
+		ptr1 =3D &desc1;
+
+		if (duration2 || interval2) {
+			os_memset(&desc2, 0, sizeof(desc2));
+			desc2.count_type =3D 2;
+			desc2.duration =3D duration2;
+			desc2.interval =3D interval2;
