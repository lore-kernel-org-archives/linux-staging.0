+	struct family_data res =3D { group, -ENOENT };
+
+	msg =3D nlmsg_alloc();
+	if (!msg)
+		return -ENOMEM;
+	genlmsg_put(msg, 0, 0, genl_ctrl_resolve(drv->nl_handle, "nlctrl"),
+		    0, 0, CTRL_CMD_GETFAMILY, 0);
+	NLA_PUT_STRING(msg, CTRL_ATTR_FAMILY_NAME, family);
+
+	ret =3D send_and_recv_msgs(drv, msg, family_handler, &res);
+	msg =3D NULL;
+	if (ret =3D=3D 0)
+		ret =3D res.id;
+
+nla_put_failure:
+	nlmsg_free(msg);
+	return ret;
