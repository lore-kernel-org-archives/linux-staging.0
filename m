+static void atheros_raw_receive(void *ctx, const u8 *src_addr, const u8 *b=
uf,
+				size_t len)
+{
+	struct atheros_driver_data *drv =3D ctx;
+	const struct ieee80211_mgmt *mgmt;
+	u16 fc;
+	union wpa_event_data event;
+
+	/* Send Probe Request information to WPS processing */
+
+	if (len < IEEE80211_HDRLEN + sizeof(mgmt->u.probe_req))
+		return;
+	mgmt =3D (const struct ieee80211_mgmt *) buf;
+
+	fc =3D le_to_host16(mgmt->frame_control);
+	if (WLAN_FC_GET_TYPE(fc) !=3D WLAN_FC_TYPE_MGMT ||
+	    WLAN_FC_GET_STYPE(fc) !=3D WLAN_FC_STYPE_PROBE_REQ)
+		return;
+
+	os_memset(&event, 0, sizeof(event));
+	event.rx_probe_req.sa =3D mgmt->sa;
+	event.rx_probe_req.ie =3D mgmt->u.probe_req.variable;
+	event.rx_probe_req.ie_len =3D
+		len - (IEEE80211_HDRLEN + sizeof(mgmt->u.probe_req));
+	wpa_supplicant_event(drv->hapd, EVENT_RX_PROBE_REQ, &event);
+}
