+	if (conn =3D=3D NULL)
+		return -1;
+
+	if (verify_peer) {
+		conn->ca_cert_verify =3D 1;
+		SSL_set_verify(conn->ssl, SSL_VERIFY_PEER |
+			       SSL_VERIFY_FAIL_IF_NO_PEER_CERT |
