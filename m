+	entry =3D os_zalloc(sizeof(*entry));
+	if (entry =3D=3D NULL)
+		return EAP_SIM_DB_FAILURE;
+
+	os_get_time(&entry->timestamp);
+	os_memcpy(entry->imsi, identity, identity_len);
+	entry->imsi_len =3D identity_len;
+	entry->cb_session_ctx =3D cb_session_ctx;
+	entry->state =3D PENDING;
+	eap_sim_db_add_pending(data, entry);
+	eap_sim_db_expire_pending(data);
+
+	return EAP_SIM_DB_PENDING;
