+static const u8 * nl80211_get_ie(const u8 *ies, size_t ies_len, u8 ie)
+{
+	const u8 *end, *pos;
+
+	if (ies =3D=3D NULL)
+		return NULL;
+
+	pos =3D ies;
+	end =3D ies + ies_len;
+
+	while (pos + 1 < end) {
+		if (pos + 2 + pos[1] > end)
+			break;
+		if (pos[0] =3D=3D ie)
+			return pos;
+		pos +=3D 2 + pos[1];
+	}
+
+	return NULL;
+}
