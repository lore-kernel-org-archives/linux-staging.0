+static struct wpa_interface_info *
+wpa_driver_ndis_get_interfaces(void *global_priv)
+{
+	struct wpa_interface_info *iface =3D NULL, *niface;
+
+#ifdef CONFIG_USE_NDISUIO
+	NDISUIO_QUERY_BINDING *b;
+	size_t blen =3D sizeof(*b) + 1024;
+	int i, error;
+	DWORD written;
+	char name[256], desc[256];
+	WCHAR *pos;
+	size_t j, len;
+	HANDLE ndisuio;
+
+	ndisuio =3D CreateFile(NDISUIO_DEVICE_NAME,
+			     GENERIC_READ | GENERIC_WRITE, 0, NULL,
+			     OPEN_EXISTING,
+			     FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OVERLAPPED,
+			     INVALID_HANDLE_VALUE);
+	if (ndisuio =3D=3D INVALID_HANDLE_VALUE) {
+		wpa_printf(MSG_ERROR, "NDIS: Failed to open connection to "
+			   "NDISUIO: %d", (int) GetLastError());
+		return NULL;
+	}
+
+#ifndef _WIN32_WCE
+	if (!DeviceIoControl(ndisuio, IOCTL_NDISUIO_BIND_WAIT, NULL, 0,
+			     NULL, 0, &written, NULL)) {
+		wpa_printf(MSG_ERROR, "NDIS: IOCTL_NDISUIO_BIND_WAIT failed: "
+			   "%d", (int) GetLastError());
+		CloseHandle(ndisuio);
+		return NULL;
+	}
+#endif /* _WIN32_WCE */
+
+	b =3D os_malloc(blen);
+	if (b =3D=3D NULL) {
+		CloseHandle(ndisuio);
+		return NULL;
+	}
+
+	for (i =3D 0; ; i++) {
+		os_memset(b, 0, blen);
+		b->BindingIndex =3D i;
+		if (!DeviceIoControl(ndisuio, IOCTL_NDISUIO_QUERY_BINDING,
+				     b, sizeof(NDISUIO_QUERY_BINDING), b, blen,
+				     &written, NULL)) {
+			error =3D (int) GetLastError();
+			if (error =3D=3D ERROR_NO_MORE_ITEMS)
+				break;
+			wpa_printf(MSG_DEBUG, "IOCTL_NDISUIO_QUERY_BINDING "
+				   "failed: %d", error);
+			break;
+		}
+
+		pos =3D (WCHAR *) ((char *) b + b->DeviceNameOffset);
+		len =3D b->DeviceNameLength;
+		if (len >=3D sizeof(name))
+			len =3D sizeof(name) - 1;
+		for (j =3D 0; j < len; j++)
+			name[j] =3D (char) pos[j];
+		name[len] =3D '\0';
+
+		pos =3D (WCHAR *) ((char *) b + b->DeviceDescrOffset);
+		len =3D b->DeviceDescrLength;
+		if (len >=3D sizeof(desc))
+			len =3D sizeof(desc) - 1;
+		for (j =3D 0; j < len; j++)
+			desc[j] =3D (char) pos[j];
+		desc[len] =3D '\0';
+
+		wpa_printf(MSG_DEBUG, "NDIS: %d - %s - %s", i, name, desc);
+
+		niface =3D os_zalloc(sizeof(*niface));
+		if (niface =3D=3D NULL)
+			break;
+		niface->drv_name =3D "ndis";
+		if (os_strncmp(name, "\\DEVICE\\", 8) =3D=3D 0)
+			niface->ifname =3D os_strdup(name + 8);
+		else
+			niface->ifname =3D os_strdup(name);
+		if (niface->ifname =3D=3D NULL) {
+			os_free(niface);
+			break;
+		}
+		niface->desc =3D os_strdup(desc);
+		niface->next =3D iface;
+		iface =3D niface;
+	}
+
+	os_free(b);
+	CloseHandle(ndisuio);
+#else /* CONFIG_USE_NDISUIO */
+	PTSTR _names;
+	char *names, *pos, *pos2;
+	ULONG len;
+	BOOLEAN res;
+	char *name[MAX_ADAPTERS];
+	char *desc[MAX_ADAPTERS];
+	int num_name, num_desc, i;
+
+	wpa_printf(MSG_DEBUG, "NDIS: Packet.dll version: %s",
+		   PacketGetVersion());
+
+	len =3D 8192;
+	_names =3D os_zalloc(len);
+	if (_names =3D=3D NULL)
+		return NULL;
+
+	res =3D PacketGetAdapterNames(_names, &len);
+	if (!res && len > 8192) {
+		os_free(_names);
+		_names =3D os_zalloc(len);
+		if (_names =3D=3D NULL)
+			return NULL;
+		res =3D PacketGetAdapterNames(_names, &len);
+	}
+
+	if (!res) {
+		wpa_printf(MSG_ERROR, "NDIS: Failed to get adapter list "
+			   "(PacketGetAdapterNames)");
+		os_free(_names);
+		return NULL;
+	}
+
+	names =3D (char *) _names;
+	if (names[0] && names[1] =3D=3D '\0' && names[2] && names[3] =3D=3D '\0')=
 {
+		wpa_printf(MSG_DEBUG, "NDIS: Looks like adapter names are in "
+			   "UNICODE");
+		/* Convert to ASCII */
+		pos2 =3D pos =3D names;
+		while (pos2 < names + len) {
+			if (pos2[0] =3D=3D '\0' && pos2[1] =3D=3D '\0' &&
+			    pos2[2] =3D=3D '\0' && pos2[3] =3D=3D '\0') {
+				pos2 +=3D 4;
+				break;
+			}
+			*pos++ =3D pos2[0];
+			pos2 +=3D 2;
+		}
+		os_memcpy(pos + 2, names, pos - names);
+		pos +=3D 2;
+	} else
+		pos =3D names;
+
+	num_name =3D 0;
+	while (pos < names + len) {
+		name[num_name] =3D pos;
+		while (*pos && pos < names + len)
+			pos++;
+		if (pos + 1 >=3D names + len) {
+			os_free(names);
+			return NULL;
+		}
+		pos++;
+		num_name++;
+		if (num_name >=3D MAX_ADAPTERS) {
+			wpa_printf(MSG_DEBUG, "NDIS: Too many adapters");
+			os_free(names);
+			return NULL;
+		}
+		if (*pos =3D=3D '\0') {
+			wpa_printf(MSG_DEBUG, "NDIS: %d adapter names found",
+				   num_name);
+			pos++;
+			break;
+		}
+	}
+
+	num_desc =3D 0;
+	while (pos < names + len) {
+		desc[num_desc] =3D pos;
+		while (*pos && pos < names + len)
+			pos++;
+		if (pos + 1 >=3D names + len) {
+			os_free(names);
+			return NULL;
+		}
+		pos++;
+		num_desc++;
+		if (num_desc >=3D MAX_ADAPTERS) {
+			wpa_printf(MSG_DEBUG, "NDIS: Too many adapter "
+				   "descriptions");
+			os_free(names);
+			return NULL;
+		}
+		if (*pos =3D=3D '\0') {
+			wpa_printf(MSG_DEBUG, "NDIS: %d adapter descriptions "
+				   "found", num_name);
+			pos++;
+			break;
+		}
+	}
+
+	/*
+	 * Windows 98 with Packet.dll 3.0 alpha3 does not include adapter
+	 * descriptions. Fill in dummy descriptors to work around this.
+	 */
+	while (num_desc < num_name)
+		desc[num_desc++] =3D "dummy description";
+
+	if (num_name !=3D num_desc) {
+		wpa_printf(MSG_DEBUG, "NDIS: mismatch in adapter name and "
+			   "description counts (%d !=3D %d)",
+			   num_name, num_desc);
+		os_free(names);
+		return NULL;
+	}
+
+	for (i =3D 0; i < num_name; i++) {
+		niface =3D os_zalloc(sizeof(*niface));
+		if (niface =3D=3D NULL)
+			break;
+		niface->drv_name =3D "ndis";
+		if (os_strncmp(name[i], "\\Device\\NPF_", 12) =3D=3D 0)
+			niface->ifname =3D os_strdup(name[i] + 12);
+		else
+			niface->ifname =3D os_strdup(name[i]);
+		if (niface->ifname =3D=3D NULL) {
+			os_free(niface);
+			break;
+		}
+		niface->desc =3D os_strdup(desc[i]);
+		niface->next =3D iface;
+		iface =3D niface;
+	}
+
+#endif /* CONFIG_USE_NDISUIO */
+
+	return iface;
+}
