+=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/
+void PMAC_Nsym_generator(
+	PRT_PMAC_TX_INFO	pPMacTxInfo,
+	PRT_PMAC_PKT_INFO	pPMacPktInfo)
+{
+	u32	SIGA2B3 =3D 0;
+	u8	TX_RATE =3D pPMacTxInfo->TX_RATE;
+
+	u32 R, R_list[10] =3D {0, 0, 2, 0, 2, 1, 2, 3, 2, 3};
+	double CR =3D 0;
+	u32 N_SD, N_BPSC_list[10] =3D {1, 2, 2, 4, 4, 6, 6, 6, 8, 8};
+	u32 N_BPSC =3D 0, N_CBPS =3D 0, N_DBPS =3D 0, N_ES =3D 0, N_SYM =3D 0, N_=
pld =3D 0, N_TCB =3D 0;
+	int D_R =3D 0;
+
+	RTW_INFO("TX_RATE =3D %d\n", TX_RATE);
+	/*	N_SD*/
+	if (pPMacTxInfo->BandWidth =3D=3D 0)
+		N_SD =3D 52;
+	else if (pPMacTxInfo->BandWidth =3D=3D 1)
+		N_SD =3D 108;
+	else
+		N_SD =3D 234;
+
+	if (MPT_IS_HT_RATE(TX_RATE)) {
+		u8 MCS_temp;
+
+		if (pPMacPktInfo->MCS > 23)
+			MCS_temp =3D pPMacPktInfo->MCS - 24;
+		else if (pPMacPktInfo->MCS > 15)
+			MCS_temp =3D pPMacPktInfo->MCS - 16;
+		else if (pPMacPktInfo->MCS > 7)
+			MCS_temp =3D pPMacPktInfo->MCS - 8;
+		else
+			MCS_temp =3D pPMacPktInfo->MCS;
+
+		R =3D R_list[MCS_temp];
+
+		switch (R) {
+		case 0:
+			CR =3D .5;
+			break;
+		case 1:
+			CR =3D 2. / 3.;
+			break;
+		case 2:
+			CR =3D 3. / 4.;
+			break;
+		case 3:
+			CR =3D 5. / 6.;
+			break;
+		}
+
+		N_BPSC =3D N_BPSC_list[MCS_temp];
+		N_CBPS =3D N_BPSC * N_SD * pPMacPktInfo->Nss;
+		N_DBPS =3D (u32)((double)N_CBPS * CR);
+
+		if (pPMacTxInfo->bLDPC =3D=3D false) {
+			N_ES =3D (u32)ceil((double)(N_DBPS * pPMacPktInfo->Nss) / 4. / 300.);
+			RTW_INFO("N_ES =3D %d\n", N_ES);
+
+			/*	N_SYM =3D m_STBC* (8*length+16+6*N_ES) / (m_STBC*N_DBPS)*/
+			N_SYM =3D pPMacTxInfo->m_STBC * (u32)ceil((double)(pPMacTxInfo->PacketL=
ength * 8 + 16 + N_ES * 6) /
+					(double)(N_DBPS * pPMacTxInfo->m_STBC));
+
+		} else {
+			N_ES =3D 1;
+			/*	N_pld =3D length * 8 + 16*/
+			N_pld =3D pPMacTxInfo->PacketLength * 8 + 16;
+			RTW_INFO("N_pld =3D %d\n", N_pld);
+			N_SYM =3D pPMacTxInfo->m_STBC * (u32)ceil((double)(N_pld) /
+					(double)(N_DBPS * pPMacTxInfo->m_STBC));
+			RTW_INFO("N_SYM =3D %d\n", N_SYM);
+			/*	N_avbits =3D N_CBPS *m_STBC *(N_pld/N_CBPS*R*m_STBC)*/
+			N_TCB =3D N_CBPS * N_SYM;
+			RTW_INFO("N_TCB =3D %d\n", N_TCB);
+			SIGA2B3 =3D LDPC_parameter_generator(N_pld, N_CBPS, pPMacPktInfo->Nss, =
R, pPMacTxInfo->m_STBC, N_TCB);
+			RTW_INFO("SIGA2B3 =3D %d\n", SIGA2B3);
+			N_SYM =3D N_SYM + SIGA2B3 * pPMacTxInfo->m_STBC;
+			RTW_INFO("N_SYM =3D %d\n", N_SYM);
+		}
+	} else if (MPT_IS_VHT_RATE(TX_RATE)) {
+		R =3D R_list[pPMacPktInfo->MCS];
+
+		switch (R) {
+		case 0:
+			CR =3D .5;
+			break;
+		case 1:
+			CR =3D 2. / 3.;
+			break;
+		case 2:
+			CR =3D 3. / 4.;
+			break;
+		case 3:
+			CR =3D 5. / 6.;
+			break;
+		}
+		N_BPSC =3D N_BPSC_list[pPMacPktInfo->MCS];
+		N_CBPS =3D N_BPSC * N_SD * pPMacPktInfo->Nss;
+		N_DBPS =3D (u32)((double)N_CBPS * CR);
+		if (pPMacTxInfo->bLDPC =3D=3D false) {
+			if (pPMacTxInfo->bSGI)
+				N_ES =3D (u32)ceil((double)(N_DBPS) / 3.6 / 600.);
+			else
+				N_ES =3D (u32)ceil((double)(N_DBPS) / 4. / 600.);
+			/*	N_SYM =3D m_STBC* (8*length+16+6*N_ES) / (m_STBC*N_DBPS)*/
+			N_SYM =3D pPMacTxInfo->m_STBC * (u32)ceil((double)(pPMacTxInfo->PacketL=
ength * 8 + 16 + N_ES * 6) / (double)(N_DBPS * pPMacTxInfo->m_STBC));
+			SIGA2B3 =3D 0;
+		} else {
+			N_ES =3D 1;
+			/*	N_SYM =3D m_STBC* (8*length+N_service) / (m_STBC*N_DBPS)*/
+			N_SYM =3D pPMacTxInfo->m_STBC * (u32)ceil((double)(pPMacTxInfo->PacketL=
ength * 8 + 16) / (double)(N_DBPS * pPMacTxInfo->m_STBC));
+			/*	N_avbits =3D N_sys_init * N_CBPS*/
+			N_TCB =3D N_CBPS * N_SYM;
+			/*	N_pld =3D N_sys_init * N_DBPS*/
+			N_pld =3D N_SYM * N_DBPS;
+			SIGA2B3 =3D LDPC_parameter_generator(N_pld, N_CBPS, pPMacPktInfo->Nss, =
R, pPMacTxInfo->m_STBC, N_TCB);
+			N_SYM =3D N_SYM + SIGA2B3 * pPMacTxInfo->m_STBC;
+		}
+
+		switch (R) {
+		case 0:
+			D_R =3D 2;
+			break;
+		case 1:
+			D_R =3D 3;
+			break;
+		case 2:
+			D_R =3D 4;
+			break;
+		case 3:
+			D_R =3D 6;
+			break;
+		}
+
+		if (((N_CBPS / N_ES) % D_R) !=3D 0) {
+			RTW_INFO("MCS=3D %d is not supported when Nss=3D%d and BW=3D %d !!\n", =
 pPMacPktInfo->MCS, pPMacPktInfo->Nss, pPMacTxInfo->BandWidth);
+			return;
+		}
+
+		RTW_INFO("MCS=3D %d Nss=3D%d and BW=3D %d !!\n",  pPMacPktInfo->MCS, pPM=
acPktInfo->Nss, pPMacTxInfo->BandWidth);
+	}
+
+	pPMacPktInfo->N_sym =3D N_SYM;
+	pPMacPktInfo->SIGA2B3 =3D SIGA2B3;
+}
