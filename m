+/*
+ *	Description:
+ *		Translate a character to hex digit.
+ *   */
+u32
+MapCharToHexDigit(
+		char		chTmp
+)
+{
+	if (chTmp >=3D '0' && chTmp <=3D '9')
+		return chTmp - '0';
+	else if (chTmp >=3D 'a' && chTmp <=3D 'f')
+		return 10 + (chTmp - 'a');
+	else if (chTmp >=3D 'A' && chTmp <=3D 'F')
+		return 10 + (chTmp - 'A');
+	else
+		return 0;
+}
