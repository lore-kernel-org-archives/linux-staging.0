+				continue;
+
+			hal_data->Index24G_CCK_Base[rfpath][ch_idx] =3D pwr_info_2g->IndexCCK_B=
ase[rfpath][cck_group];
+			hal_data->Index24G_BW40_Base[rfpath][ch_idx] =3D pwr_info_2g->IndexBW40=
_Base[rfpath][group];
+		}
+
+		/* 2.4G diff */
+		for (tx_idx =3D 0; tx_idx < MAX_TX_COUNT; tx_idx++) {
+			if (tx_idx >=3D max_tx_cnt)
+				break;
+
+			hal_data->CCK_24G_Diff[rfpath][tx_idx] =3D pwr_info_2g->CCK_Diff[rfpath=
][tx_idx];
+			hal_data->OFDM_24G_Diff[rfpath][tx_idx] =3D pwr_info_2g->OFDM_Diff[rfpa=
th][tx_idx];
+			hal_data->BW20_24G_Diff[rfpath][tx_idx] =3D pwr_info_2g->BW20_Diff[rfpa=
th][tx_idx];
+			hal_data->BW40_24G_Diff[rfpath][tx_idx] =3D pwr_info_2g->BW40_Diff[rfpa=
th][tx_idx];
+		}
+bypass_2g:
+		;
+
+#ifdef CONFIG_IEEE80211_BAND_5GHZ
+		if (!pwr_info_5g || !HAL_SPEC_CHK_RF_PATH_5G(hal_spec, rfpath))
+			goto bypass_5g;
+
+		/* 5G base */
+		for (ch_idx =3D 0; ch_idx < CENTER_CH_5G_ALL_NUM; ch_idx++) {
+			if (rtw_get_ch_group(center_ch_5g_all[ch_idx], &group, NULL) !=3D BAND_=
ON_5G)
+				continue;
+			hal_data->Index5G_BW40_Base[rfpath][ch_idx] =3D pwr_info_5g->IndexBW40_=
Base[rfpath][group];
+		}
