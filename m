+int validate_beacon_len(u8 *pframe, u32 len)
+{
+	u8 ie_offset =3D _BEACON_IE_OFFSET_ + sizeof(struct rtw_ieee80211_hdr_3ad=
dr);
+
+	if (len < ie_offset) {
+		RTW_INFO("%s: incorrect beacon length(%d)\n", __func__, len);
+		return false;
+	}
+
+	if (check_ielen(pframe + ie_offset, len - ie_offset) =3D=3D false)
+		return false;
+
+	return true;
+}
