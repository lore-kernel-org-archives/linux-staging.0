+static u8 key_char2num(u8 ch);
+static u8 key_char2num(u8 ch)
+{
+	if ((ch >=3D '0') && (ch <=3D '9'))
+		return ch - '0';
+	else if ((ch >=3D 'a') && (ch <=3D 'f'))
+		return ch - 'a' + 10;
+	else if ((ch >=3D 'A') && (ch <=3D 'F'))
+		return ch - 'A' + 10;
+	else
+		return 0xff;
+}
