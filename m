+u8 rtw_set_802_11_remove_key(_adapter	*padapter, NDIS_802_11_REMOVE_KEY *k=
ey)
+{
+
+	uint				encryptionalgo;
+	u8 *pbssid;
+	struct sta_info *stainfo;
+	u8	bgroup =3D (key->KeyIndex & 0x4000000) > 0 ? false : true;
+	u8	keyIndex =3D (u8)key->KeyIndex & 0x03;
+	u8	ret =3D _SUCCESS;
