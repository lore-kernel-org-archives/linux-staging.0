+		break;
+	case RATR_INX_WIRELESS_B:
+		p_ra_info->ra_use_rate =3D (p_ra_info->rate_mask) & 0x0000000d;
+		break;
+	case 12:
+		mask_from_reg =3D odm_read_4byte(p_dm_odm, REG_ARFR0);
+		p_ra_info->ra_use_rate =3D (p_ra_info->rate_mask) & mask_from_reg;
+		break;
+	case 13:
+		mask_from_reg =3D odm_read_4byte(p_dm_odm, REG_ARFR1);
+		p_ra_info->ra_use_rate =3D (p_ra_info->rate_mask) & mask_from_reg;
+		break;
+	case 14:
+		mask_from_reg =3D odm_read_4byte(p_dm_odm, REG_ARFR2);
+		p_ra_info->ra_use_rate =3D (p_ra_info->rate_mask) & mask_from_reg;
+		break;
+	case 15:
+		mask_from_reg =3D odm_read_4byte(p_dm_odm, REG_ARFR3);
+		p_ra_info->ra_use_rate =3D (p_ra_info->rate_mask) & mask_from_reg;
+		break;
+
+	default:
+		p_ra_info->ra_use_rate =3D (p_ra_info->rate_mask);
+		break;
+	}
+	/* Highest rate */
+	if (p_ra_info->ra_use_rate)
