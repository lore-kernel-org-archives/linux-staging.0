+
+int eap_is_wps_pin_enrollee(struct eap_peer_config *conf)
+{
+	if (conf->identity_len !=3D WSC_ID_ENROLLEE_LEN ||
+	    os_memcmp(conf->identity, WSC_ID_ENROLLEE, WSC_ID_ENROLLEE_LEN))
+		return 0; /* Not a WPS Enrollee */
+
+	if (conf->phase1 =3D=3D NULL || os_strstr(conf->phase1, "pin=3D") =3D=3D =
NULL)
+		return 0; /* Not using PIN */
+
+	return 1;
+}
