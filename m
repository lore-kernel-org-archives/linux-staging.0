+
+		pxmitbuf->pbuf =3D (u8 *)N_BYTE_ALIGMENT((SIZE_PTR)(pxmitbuf->pallocated=
_buf), XMITBUF_ALIGN_SZ);
+
+#endif /* CONFIG_USE_USB_BUFFER_ALLOC_TX */
+	}
+
+	if (flag) {
+		int i;
+		for (i =3D 0; i < 8; i++) {
+			pxmitbuf->pxmit_urb[i] =3D usb_alloc_urb(0, GFP_KERNEL);
+			if (pxmitbuf->pxmit_urb[i] =3D=3D NULL) {
+				RTW_INFO("pxmitbuf->pxmit_urb[i]=3D=3DNULL");
+				return _FAIL;
+			}
+		}
+	}
+	return _SUCCESS;
+}
