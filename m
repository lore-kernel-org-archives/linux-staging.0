+
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_CFO_TRACKING, ODM_DBG_LOUD, ("valid_path=
_cnt =3D ((%d)), CFO_ave =3D ((%d kHz))\n", valid_path_cnt, CFO_ave));
