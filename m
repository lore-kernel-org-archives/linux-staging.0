+static int rtw_auto_ap_start_beacon(_adapter *adapter)
+{
+	int ret =3D 0;
+	u8 *pbuf =3D NULL;
+	uint len;
+	u8	supportRate[16];
+	int	sz =3D 0, rateLen;
+	u8	*ie;
+	u8	wireless_mode, oper_channel;
+	u8 ssid[3] =3D {0}; /* hidden ssid */
+	u32 ssid_len =3D sizeof(ssid);
+	struct mlme_priv *pmlmepriv =3D &(adapter->mlmepriv);
+
+
+	if (check_fwstate(pmlmepriv, WIFI_AP_STATE) !=3D true)
+		return -EINVAL;
+
+
+	len =3D 128;
+	pbuf =3D rtw_zmalloc(len);
+	if (!pbuf)
+		return -ENOMEM;
+
+
+	/* generate beacon */
+	ie =3D pbuf;
+
+	/* timestamp will be inserted by hardware */
+	sz +=3D 8;
+	ie +=3D sz;
+
+	/* beacon interval : 2bytes */
+	*(__le16 *)ie =3D cpu_to_le16((u16)100); /* BCN_INTERVAL=3D100; */
+	sz +=3D 2;
+	ie +=3D 2;
+
+	/* capability info */
+	*(u16 *)ie =3D 0;
+	*(u16 *)ie |=3D cpu_to_le16(cap_ESS);
+	*(u16 *)ie |=3D cpu_to_le16(cap_ShortPremble);
+	/* *(u16*)ie |=3D cpu_to_le16(cap_Privacy); */
+	sz +=3D 2;
+	ie +=3D 2;
+
+	/* SSID */
+	ie =3D rtw_set_ie(ie, _SSID_IE_, ssid_len, ssid, &sz);
+
+	/* supported rates */
+	wireless_mode =3D WIRELESS_11BG_24N;
+	rtw_set_supported_rate(supportRate, wireless_mode) ;
+	rateLen =3D rtw_get_rateset_len(supportRate);
+	if (rateLen > 8)
+		ie =3D rtw_set_ie(ie, _SUPPORTEDRATES_IE_, 8, supportRate, &sz);
+	else
+		ie =3D rtw_set_ie(ie, _SUPPORTEDRATES_IE_, rateLen, supportRate, &sz);
+
+
+	/* DS parameter set */
+	if (rtw_mi_check_status(adapter, MI_LINKED))
+		oper_channel =3D rtw_mi_get_union_chan(adapter);
+	else
+		oper_channel =3D adapter_to_dvobj(adapter)->oper_channel;
+
+	ie =3D rtw_set_ie(ie, _DSSET_IE_, 1, &oper_channel, &sz);
+
+	/* ext supported rates */
+	if (rateLen > 8)
+		ie =3D rtw_set_ie(ie, _EXT_SUPPORTEDRATES_IE_, (rateLen - 8), (supportRa=
te + 8), &sz);
+
+	RTW_INFO("%s, start auto ap beacon sz=3D%d\n", __func__, sz);
+
+	/* lunch ap mode & start to issue beacon */
+	if (rtw_check_beacon_data(adapter, pbuf,  sz) =3D=3D _SUCCESS) {
+
+	} else
+		ret =3D -EINVAL;
+
+
+	rtw_mfree(pbuf, len);
+
+	return ret;
+
+}
