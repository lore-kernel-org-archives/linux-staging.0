+void rtl8188e_set_FwPwrMode_cmd(PADAPTER padapter, u8 Mode)
+{
+	SETPWRMODE_PARM H2CSetPwrMode;
+	struct pwrctrl_priv *pwrpriv =3D adapter_to_pwrctl(padapter);
+	u8	RLBM =3D 0; /* 0:Min, 1:Max , 2:User define */
+
+	RTW_INFO("%s: Mode=3D%d SmartPS=3D%d UAPSD=3D%d\n", __func__,
+		 Mode, pwrpriv->smart_ps, padapter->registrypriv.uapsd_enable);
+
+	H2CSetPwrMode.AwakeInterval =3D 2;	/* DTIM =3D 1 */
+
+	switch (Mode) {
+	case PS_MODE_ACTIVE:
+		H2CSetPwrMode.Mode =3D 0;
+		break;
+	case PS_MODE_MIN:
+		H2CSetPwrMode.Mode =3D 1;
+		break;
+	case PS_MODE_MAX:
+		RLBM =3D 1;
+		H2CSetPwrMode.Mode =3D 1;
+		break;
+	case PS_MODE_DTIM:
+		RLBM =3D 2;
+		H2CSetPwrMode.AwakeInterval =3D 3; /* DTIM =3D 2 */
+		H2CSetPwrMode.Mode =3D 1;
+		break;
+	case PS_MODE_UAPSD_WMM:
+		H2CSetPwrMode.Mode =3D 2;
+		break;
+	default:
+		H2CSetPwrMode.Mode =3D 0;
+		break;
+	}
+
+	/* H2CSetPwrMode.Mode =3D Mode; */
+
+	H2CSetPwrMode.SmartPS_RLBM =3D (((pwrpriv->smart_ps << 4) & 0xf0) | (RLBM=
 & 0x0f));
+
+	H2CSetPwrMode.bAllQueueUAPSD =3D padapter->registrypriv.uapsd_enable;
+
+	if (Mode > 0) {
+		H2CSetPwrMode.PwrState =3D 0x00;/* AllON(0x0C), RFON(0x04), RFOFF(0x00) =
*/
+#ifdef CONFIG_EXT_CLK
+		H2CSetPwrMode.Mode |=3D BIT(7);/* supporting 26M XTAL CLK_Request featur=
e. */
+#endif /* CONFIG_EXT_CLK */
+	} else
+		H2CSetPwrMode.PwrState =3D 0x0C;/* AllON(0x0C), RFON(0x04), RFOFF(0x00) =
*/
+
+	FillH2CCmd_88E(padapter, H2C_PS_PWR_MODE, sizeof(H2CSetPwrMode), (u8 *)&H=
2CSetPwrMode);
+
+
+}
