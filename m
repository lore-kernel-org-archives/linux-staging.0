+/**
+ * rx_ampdu_apply_sta - Apply RX AMPDU setting to the specific @sta
+ * @adapter: the adapter to which @sta belongs
+ * @sta: the sta to be checked
+ * @accept: the target permission if RX AMPDU should be set up
+ * @size: the target RX AMPDU buffer size
+ *
+ * Returns: number of the RX AMPDU assciation canceled for applying curren=
t target setting
+ *
+ * Blocking function, may sleep
+ */
+u8 rx_ampdu_apply_sta(_adapter *adapter, struct sta_info *sta, u8 accept, =
u8 size)
+{
+	u8 change_cnt =3D 0;
+	int i;
+
+	for (i =3D 0; i < TID_NUM; i++) {
+		if (rx_ampdu_apply_sta_tid(adapter, sta, i, accept, size) !=3D 0)
+			change_cnt++;
+	}
+
+	return change_cnt;
+}
+
+/**
+ * rtw_rx_ampdu_apply - Apply the current target RX AMPDU setting for the =
specific @adapter
+ * @adapter: the adapter to be applied
+ *
+ * Returns: number of the RX AMPDU assciation canceled for applying curren=
t target setting
+ */
+u16 rtw_rx_ampdu_apply(_adapter *adapter)
+{
+	u16 adj_cnt =3D 0;
+	struct mlme_ext_priv *mlmeext;
+	struct sta_info *sta;
+	u8 accept =3D rtw_rx_ampdu_is_accept(adapter);
+	u8 size =3D rtw_rx_ampdu_size(adapter);
+
+	mlmeext =3D &adapter->mlmeextpriv;
+
+	if (mlmeext_msr(mlmeext) =3D=3D WIFI_FW_STATION_STATE) {
+		sta =3D rtw_get_stainfo(&adapter->stapriv, get_bssid(&adapter->mlmepriv)=
);
+		if (sta)
+			adj_cnt +=3D rx_ampdu_apply_sta(adapter, sta, accept, size);
+
+	} else if (mlmeext_msr(mlmeext) =3D=3D WIFI_FW_AP_STATE) {
+		unsigned long irqL;
+		_list *phead, *plist;
+		u8 peer_num =3D 0;
+		char peers[NUM_STA];
+		struct sta_priv *pstapriv =3D &adapter->stapriv;
+		int i;
+
+		_enter_critical_bh(&pstapriv->asoc_list_lock, &irqL);
+
+		phead =3D &pstapriv->asoc_list;
+		plist =3D get_next(phead);
+
+		while ((rtw_end_of_queue_search(phead, plist)) =3D=3D false) {
+			int stainfo_offset;
+
+			sta =3D LIST_CONTAINOR(plist, struct sta_info, asoc_list);
+			plist =3D get_next(plist);
+
+			stainfo_offset =3D rtw_stainfo_offset(pstapriv, sta);
+			if (stainfo_offset_valid(stainfo_offset))
+				peers[peer_num++] =3D stainfo_offset;
+		}
+
+		_exit_critical_bh(&pstapriv->asoc_list_lock, &irqL);
+
+		for (i =3D 0; i < peer_num; i++) {
+			sta =3D rtw_get_stainfo_by_offset(pstapriv, peers[i]);
+			if (sta)
+				adj_cnt +=3D rx_ampdu_apply_sta(adapter, sta, accept, size);
+		}
+	}
+
+	return adj_cnt;
+}
