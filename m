+void tx_beacon_handler(struct dvobj_priv *pdvobj)
+{
+#define BEACON_EARLY_TIME		20	/* unit:TU*/
+	unsigned long irqL;
+	_list	*plist, *phead;
+	u32 timestamp[2];
+	u32 bcn_interval_us; /* unit : usec */
+	u64 time;
+	u32 cur_tick, time_offset; /* unit : usec */
+	u32 inter_bcn_space_us; /* unit : usec */
+	int nr_vap, idx, bcn_idx;
+	int i;
+	u8 val8, late =3D 0;
+	_adapter *padapter =3D NULL;
+
+	i =3D 0;
+
+	/* get first ap mode interface */
+	_enter_critical_bh(&pdvobj->ap_if_q.lock, &irqL);
+	if (list_empty(&pdvobj->ap_if_q.queue) || (pdvobj->nr_ap_if =3D=3D 0)) {
+		RTW_INFO("[%s] ERROR: ap_if_q is empty!or nr_ap =3D %d\n", __func__, pdv=
obj->nr_ap_if);
+		_exit_critical_bh(&pdvobj->ap_if_q.lock, &irqL);
+		return;
+	} else
+		padapter =3D LIST_CONTAINOR(get_next(&(pdvobj->ap_if_q.queue)), struct _=
ADAPTER, list);
+	_exit_critical_bh(&pdvobj->ap_if_q.lock, &irqL);
+
+	if (NULL =3D=3D padapter) {
+		RTW_INFO("[%s] ERROR: no any ap interface!\n", __func__);
+		return;
+	}
+
+
+	bcn_interval_us =3D DEFAULT_BCN_INTERVAL * NET80211_TU_TO_US;
+	if (0 =3D=3D bcn_interval_us) {
+		RTW_INFO("[%s] ERROR: beacon interval =3D 0\n", __func__);
+		return;
+	}
+
+	/* read TSF */
+	timestamp[1] =3D rtw_read32(padapter, 0x560 + 4);
+	timestamp[0] =3D rtw_read32(padapter, 0x560);
+	while (timestamp[1]) {
+		time =3D (0xFFFFFFFF % bcn_interval_us + 1) * timestamp[1] + timestamp[0=
];
+		timestamp[0] =3D (u32)time;
+		timestamp[1] =3D (u32)(time >> 32);
+	}
+	cur_tick =3D timestamp[0] % bcn_interval_us;
+
+
+	_enter_critical_bh(&pdvobj->ap_if_q.lock, &irqL);
+
+	nr_vap =3D (pdvobj->nr_ap_if - 1);
+	if (nr_vap > 0) {
+		inter_bcn_space_us =3D pdvobj->inter_bcn_space * NET80211_TU_TO_US; /* b=
eacon_interval / (nr_vap+1); */
+		idx =3D cur_tick / inter_bcn_space_us;
+		if (idx < nr_vap)	/* if (idx < (nr_vap+1))*/
+			bcn_idx =3D idx + 1;	/* bcn_idx =3D (idx + 1) % (nr_vap+1);*/
+		else
+			bcn_idx =3D 0;
+
+		/* to get padapter based on bcn_idx */
+		padapter =3D NULL;
+		phead =3D get_list_head(&pdvobj->ap_if_q);
+		plist =3D get_next(phead);
+		while ((!rtw_end_of_queue_search(phead, plist))) {
+			padapter =3D LIST_CONTAINOR(plist, struct _ADAPTER, list);
+
+			plist =3D get_next(plist);
+
+			if (i =3D=3D bcn_idx)
+				break;
+
+			i++;
+		}
+		if ((NULL =3D=3D padapter) || (i > pdvobj->nr_ap_if)) {
+			RTW_INFO("[%s] ERROR: nr_ap_if =3D %d, padapter=3D%p, bcn_idx=3D%d, ind=
ex=3D%d\n",
+				__func__, pdvobj->nr_ap_if, padapter, bcn_idx, i);
+			_exit_critical_bh(&pdvobj->ap_if_q.lock, &irqL);
+			return;
+		}
+#ifdef DBG_SWTIMER_BASED_TXBCN
+		RTW_INFO("BCN_IDX=3D%d, cur_tick=3D%d, padapter=3D%p\n", bcn_idx, cur_ti=
ck, padapter);
+#endif
+		if (((idx + 2 =3D=3D nr_vap + 1) && (idx < nr_vap + 1)) || (0 =3D=3D bcn=
_idx)) {
+			time_offset =3D bcn_interval_us - cur_tick - BEACON_EARLY_TIME * NET802=
11_TU_TO_US;
+			if ((s32)time_offset < 0)
+				time_offset +=3D inter_bcn_space_us;
+
+		} else {
+			time_offset =3D (idx + 2) * inter_bcn_space_us - cur_tick - BEACON_EARL=
Y_TIME * NET80211_TU_TO_US;
+			if (time_offset > (inter_bcn_space_us + (inter_bcn_space_us >> 1))) {
+				time_offset -=3D inter_bcn_space_us;
+				late =3D 1;
+			}
+		}
+	} else
+		/*#endif*/ { /* MBSSID */
+		time_offset =3D 2 * bcn_interval_us - cur_tick - BEACON_EARLY_TIME * NET=
80211_TU_TO_US;
+		if (time_offset > (bcn_interval_us + (bcn_interval_us >> 1))) {
+			time_offset -=3D bcn_interval_us;
+			late =3D 1;
+		}
+	}
+	_exit_critical_bh(&pdvobj->ap_if_q.lock, &irqL);
+
+#ifdef DBG_SWTIMER_BASED_TXBCN
+	RTW_INFO("set sw bcn timer %d us\n", time_offset);
+#endif
+	_set_timer(&pdvobj->txbcn_timer, time_offset / NET80211_TU_TO_US);
+
+	if (padapter) {
+#ifdef DBG_SWTIMER_BASED_TXBCN
+		RTW_INFO("padapter=3D%p, PORT=3D%d\n", padapter, padapter->hw_port);
+#endif
+		/*update_beacon(padapter, _TIM_IE_, NULL, false);*/
+		issue_beacon(padapter, 0);
+	}
+}
