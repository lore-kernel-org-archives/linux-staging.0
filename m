+	u8 eid, wps_oui[4] =3D {0x00, 0x50, 0xf2, 0x04};
+
+	if (wps_ielen)
+		*wps_ielen =3D 0;
+
+	if (!in_ie) {
+		rtw_warn_on(1);
+		return wpsie_ptr;
+	}
+
+	if (in_len <=3D 0)
+		return wpsie_ptr;
+
+	cnt =3D 0;
+
+	while (cnt + 1 + 4 < in_len) {
+		eid =3D in_ie[cnt];
+
+		if (cnt + 1 + 4 >=3D MAX_IE_SZ) {
+			rtw_warn_on(1);
+			return NULL;
+		}
+
+		if (eid =3D=3D WLAN_EID_VENDOR_SPECIFIC && !memcmp(&in_ie[cnt + 2], wps_=
oui, 4)) {
+			wpsie_ptr =3D in_ie + cnt;
+
+			if (wps_ie)
+				memcpy(wps_ie, &in_ie[cnt], in_ie[cnt + 1] + 2);
+
+			if (wps_ielen)
+				*wps_ielen =3D in_ie[cnt + 1] + 2;
+
+			break;
+		} else
+			cnt +=3D in_ie[cnt + 1] + 2;
+
+	}
+
+	return wpsie_ptr;
+}
