+{
+	unsigned long irqL;
+	_list	*plist, *phead;
+	u32	bssid_ex_sz;
+	struct mlme_priv	*pmlmepriv =3D &(adapter->mlmepriv);
+	struct mlme_ext_priv	*pmlmeext =3D &(adapter->mlmeextpriv);
+#ifdef CONFIG_P2P
+	struct wifidirect_info *pwdinfo =3D &(adapter->wdinfo);
+#endif /* CONFIG_P2P */
+	_queue	*queue	=3D &(pmlmepriv->scanned_queue);
+	struct wlan_network	*pnetwork =3D NULL;
+	struct wlan_network	*oldest =3D NULL;
+	int target_find =3D 0;
+	u8 feature =3D 0;
+
+
+	_enter_critical_bh(&queue->lock, &irqL);
+	phead =3D get_list_head(queue);
+	plist =3D get_next(phead);
+
+#ifdef CONFIG_P2P
+	if (!rtw_p2p_chk_state(pwdinfo, P2P_STATE_NONE))
+		feature =3D 1; /* p2p enable */
+#endif
+
+	while (1) {
+		if (rtw_end_of_queue_search(phead, plist))
+			break;
+
+		pnetwork =3D LIST_CONTAINOR(plist, struct wlan_network, list);
+
+		rtw_bug_check(pnetwork, pnetwork, pnetwork, pnetwork);
+
+#ifdef CONFIG_P2P
+		if (!rtw_p2p_chk_state(pwdinfo, P2P_STATE_NONE) &&
+		    (!memcmp(pnetwork->network.MacAddress, target->MacAddress, ETH_ALEN)=
)) {
+			target_find =3D 1;
+			break;
+		}
+#endif
+
+		if (is_same_network(&(pnetwork->network), target, feature)) {
+			target_find =3D 1;
+			break;
+		}
+
+		if (rtw_roam_flags(adapter)) {
+			/* TODO: don't  select netowrk in the same ess as oldest if it's new en=
ough*/
+		}
+
+		if (oldest =3D=3D NULL || time_after(oldest->last_scanned, pnetwork->las=
t_scanned))
+			oldest =3D pnetwork;
+
+		plist =3D get_next(plist);
+
+	}
+
+
+	/* If we didn't find a match, then get a new network slot to initialize
+	 * with this beacon's information */
+	/* if (rtw_end_of_queue_search(phead,plist)=3D=3D true) { */
+	if (!target_find) {
+		if (_rtw_queue_empty(&(pmlmepriv->free_bss_pool))) {
+			/* If there are no more slots, expire the oldest */
+			/* list_del_init(&oldest->list); */
+			pnetwork =3D oldest;
+			if (pnetwork =3D=3D NULL) {
+				goto exit;
+			}
+#ifdef CONFIG_ANTENNA_DIVERSITY
+			rtw_hal_get_odm_var(adapter, HAL_ODM_ANTDIV_SELECT, &(target->PhyInfo.O=
ptimum_antenna), NULL);
+#endif
+			memcpy(&(pnetwork->network), target,  get_WLAN_BSSID_EX_sz(target));
+			/* pnetwork->last_scanned =3D jiffies; */
+			/* variable initialize */
+			pnetwork->fixed =3D false;
+			pnetwork->last_scanned =3D jiffies;
+
+			pnetwork->network_type =3D 0;
+			pnetwork->aid =3D 0;
+			pnetwork->join_res =3D 0;
+
+			/* bss info not receving from the right channel */
+			if (pnetwork->network.PhyInfo.SignalQuality =3D=3D 101)
+				pnetwork->network.PhyInfo.SignalQuality =3D 0;
+		} else {
+			/* Otherwise just pull from the free list */
+
+			pnetwork =3D rtw_alloc_network(pmlmepriv); /* will update scan_time */
+
+			if (pnetwork =3D=3D NULL) {
+				goto exit;
+			}
+
+			bssid_ex_sz =3D get_WLAN_BSSID_EX_sz(target);
+			target->Length =3D bssid_ex_sz;
+#ifdef CONFIG_ANTENNA_DIVERSITY
+			rtw_hal_get_odm_var(adapter, HAL_ODM_ANTDIV_SELECT, &(target->PhyInfo.O=
ptimum_antenna), NULL);
+#endif
+			memcpy(&(pnetwork->network), target, bssid_ex_sz);
+
+			pnetwork->last_scanned =3D jiffies;
+
+			/* bss info not receving from the right channel */
+			if (pnetwork->network.PhyInfo.SignalQuality =3D=3D 101)
+				pnetwork->network.PhyInfo.SignalQuality =3D 0;
+
+			list_add_tail(&(pnetwork->list), &(queue->queue));
+
+		}
+	} else {
+		/* we have an entry and we are going to update it. But this entry may
+		 * be already expired. In this case we do the same as we found a new
+		 * net and call the new_net handler
+		 */
+		bool update_ie =3D true;
+
+		pnetwork->last_scanned =3D jiffies;
+
+		/* target.Reserved[0]=3D=3D1, means that scaned network is a bcn frame. =
*/
+		if ((pnetwork->network.IELength > target->IELength) && (target->Reserved=
[0] =3D=3D 1))
+			update_ie =3D false;
+
+		/* probe resp(3) > beacon(1) > probe req(2) */
+		if ((target->Reserved[0] !=3D 2) &&
+		    (target->Reserved[0] >=3D pnetwork->network.Reserved[0])
+		   )
+			update_ie =3D true;
+		else
+			update_ie =3D false;
+
+		update_network(&(pnetwork->network), target, adapter, update_ie);
+	}
+
+exit:
+	_exit_critical_bh(&queue->lock, &irqL);
+
+}
