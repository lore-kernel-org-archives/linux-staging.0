+int wpa_write_mdie(struct wpa_auth_config *conf, u8 *buf, size_t len)
+{
+	u8 *pos =3D buf;
+	u8 capab;
+	if (len < 2 + sizeof(struct rsn_mdie))
+		return -1;
+
+	*pos++ =3D WLAN_EID_MOBILITY_DOMAIN;
+	*pos++ =3D MOBILITY_DOMAIN_ID_LEN + 1;
+	os_memcpy(pos, conf->mobility_domain, MOBILITY_DOMAIN_ID_LEN);
+	pos +=3D MOBILITY_DOMAIN_ID_LEN;
+	capab =3D 0;
+	if (conf->ft_over_ds)
+		capab |=3D RSN_FT_CAPAB_FT_OVER_DS;
+	*pos++ =3D capab;
+
+	return pos - buf;
+}
