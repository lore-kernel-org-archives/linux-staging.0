+int rtw_acl_add_sta(_adapter *adapter, const u8 *addr)
+{
+	unsigned long irqL;
+	_list *list, *head;
+	u8 existed =3D 0;
+	int i =3D -1, ret =3D 0;
+	struct rtw_wlan_acl_node *acl_node;
+	struct sta_priv *stapriv =3D &adapter->stapriv;
+	struct wlan_acl_pool *acl =3D &stapriv->acl_list;
+	_queue *acl_node_q =3D &acl->acl_node_q;
+
+	_enter_critical_bh(&(acl_node_q->lock), &irqL);
+
+	head =3D get_list_head(acl_node_q);
+	list =3D get_next(head);
+
+	/* search for existed entry */
+	while (rtw_end_of_queue_search(head, list) =3D=3D false) {
+		acl_node =3D LIST_CONTAINOR(list, struct rtw_wlan_acl_node, list);
+		list =3D get_next(list);
+
+		if (!memcmp(acl_node->addr, addr, ETH_ALEN)) {
+			if (acl_node->valid ) {
+				existed =3D 1;
+				break;
+			}
+		}
+	}
+	if (existed)
+		goto release_lock;
+
+	if (acl->num >=3D NUM_ACL)
+		goto release_lock;
+
+	/* find empty one and use */
+	for (i =3D 0; i < NUM_ACL; i++) {
+
+		acl_node =3D &acl->aclnode[i];
+		if (acl_node->valid =3D=3D false) {
+
+			INIT_LIST_HEAD(&acl_node->list);
+			memcpy(acl_node->addr, addr, ETH_ALEN);
+			acl_node->valid =3D true;
+
+			list_add_tail(&acl_node->list, get_list_head(acl_node_q));
+			acl->num++;
+			break;
+		}
+	}
+
+release_lock:
+	_exit_critical_bh(&(acl_node_q->lock), &irqL);
+
+	if (!existed && (i < 0 || i >=3D NUM_ACL))
+		ret =3D -1;
+
+	RTW_INFO(FUNC_ADPT_FMT" "MAC_FMT" %s (acl_num=3D%d)\n"
+		 , FUNC_ADPT_ARG(adapter), MAC_ARG(addr)
+		, (existed ? "existed" : ((i < 0 || i >=3D NUM_ACL) ? "no room" : "added=
"))
+		 , acl->num);
+
+	return ret;
+}
+
+int rtw_acl_remove_sta(_adapter *adapter, const u8 *addr)
+{
+	unsigned long irqL;
+	_list *list, *head;
+	int ret =3D 0;
+	struct rtw_wlan_acl_node *acl_node;
+	struct sta_priv *stapriv =3D &adapter->stapriv;
+	struct wlan_acl_pool *acl =3D &stapriv->acl_list;
+	_queue	*acl_node_q =3D &acl->acl_node_q;
+	u8 is_baddr =3D is_broadcast_mac_addr(addr);
+	u8 match =3D 0;
+
+	_enter_critical_bh(&(acl_node_q->lock), &irqL);
+
+	head =3D get_list_head(acl_node_q);
+	list =3D get_next(head);
+
+	while (rtw_end_of_queue_search(head, list) =3D=3D false) {
+		acl_node =3D LIST_CONTAINOR(list, struct rtw_wlan_acl_node, list);
+		list =3D get_next(list);
+
+		if (is_baddr || !memcmp(acl_node->addr, addr, ETH_ALEN)) {
+			if (acl_node->valid ) {
