+static u8 rtw_hal_decide_mcc_role(PADAPTER padapter)
+{
+	struct dvobj_priv *dvobj =3D adapter_to_dvobj(padapter);
+	_adapter *iface =3D NULL;
+	struct mcc_adapter_priv *pmccadapriv =3D NULL;
+	struct wifidirect_info *pwdinfo =3D NULL;
+	struct mlme_priv *pmlmepriv =3D NULL;
+	u8 ret =3D _SUCCESS, i =3D 0;
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+		iface =3D dvobj->padapters[i];
+		if (iface =3D=3D NULL)
+			continue;
+
+		pmccadapriv =3D &iface->mcc_adapterpriv;
+
+		if (MLME_IS_GO(iface))
+			pmccadapriv->role =3D MCC_ROLE_GO;
+		else if (MLME_IS_AP(iface))
+			pmccadapriv->role =3D MCC_ROLE_AP;
+		else if (MLME_IS_GC(iface))
+			pmccadapriv->role =3D MCC_ROLE_GC;
+		else if (MLME_IS_STA(iface))
+			pmccadapriv->role =3D MCC_ROLE_STA;
+		else {
+			pwdinfo =3D &iface->wdinfo;
+			pmlmepriv =3D &iface->mlmepriv;
+
+			RTW_INFO(FUNC_ADPT_FMT"\n", FUNC_ADPT_ARG(iface));
+			RTW_INFO("Unknown:P2P state:%d, mlme state:0x%2x, mlmext info state:0x%=
02x\n",
+				pwdinfo->role, pmlmepriv->fw_state, iface->mlmeextpriv.mlmext_info.sta=
te);
+			rtw_warn_on(1);
+			ret =3D  _FAIL;
+			goto exit;
+		}
+
+		if (ret =3D=3D _SUCCESS)
+			rtw_hal_config_mcc_role_setting(iface);
+	}
+
+exit:
+	return ret;
