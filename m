+/**
+ * ieee802_11_parse_elems - Parse information elements in management frames
+ * @start: Pointer to the start of IEs
+ * @len: Length of IE buffer in octets
+ * @elems: Data structure for parsed elements
+ * @show_errors: Whether to show parsing errors in debug log
+ * Returns: Parsing result
+ */
+ParseRes rtw_ieee802_11_parse_elems(u8 *start, uint len,
+				    struct rtw_ieee802_11_elems *elems,
+				    int show_errors)
+{
+	uint left =3D len;
+	u8 *pos =3D start;
+	int unknown =3D 0;
+
+	memset(elems, 0, sizeof(*elems));
+
+	while (left >=3D 2) {
+		u8 id, elen;
+
+		id =3D *pos++;
+		elen =3D *pos++;
+		left -=3D 2;
+
+		if (elen > left) {
+			if (show_errors) {
+				RTW_INFO("IEEE 802.11 element "
+					 "parse failed (id=3D%d elen=3D%d "
+					 "left=3D%lu)\n",
+					 id, elen, (unsigned long) left);
+			}
+			return ParseFailed;
+		}
+
+		switch (id) {
+		case WLAN_EID_SSID:
+			elems->ssid =3D pos;
+			elems->ssid_len =3D elen;
+			break;
+		case WLAN_EID_SUPP_RATES:
+			elems->supp_rates =3D pos;
+			elems->supp_rates_len =3D elen;
+			break;
+		case WLAN_EID_FH_PARAMS:
+			elems->fh_params =3D pos;
+			elems->fh_params_len =3D elen;
+			break;
+		case WLAN_EID_DS_PARAMS:
+			elems->ds_params =3D pos;
+			elems->ds_params_len =3D elen;
+			break;
+		case WLAN_EID_CF_PARAMS:
+			elems->cf_params =3D pos;
+			elems->cf_params_len =3D elen;
+			break;
+		case WLAN_EID_TIM:
+			elems->tim =3D pos;
+			elems->tim_len =3D elen;
+			break;
+		case WLAN_EID_IBSS_PARAMS:
+			elems->ibss_params =3D pos;
+			elems->ibss_params_len =3D elen;
+			break;
+		case WLAN_EID_CHALLENGE:
+			elems->challenge =3D pos;
+			elems->challenge_len =3D elen;
+			break;
+		case WLAN_EID_ERP_INFO:
+			elems->erp_info =3D pos;
+			elems->erp_info_len =3D elen;
+			break;
+		case WLAN_EID_EXT_SUPP_RATES:
+			elems->ext_supp_rates =3D pos;
+			elems->ext_supp_rates_len =3D elen;
+			break;
+		case WLAN_EID_VENDOR_SPECIFIC:
+			if (rtw_ieee802_11_parse_vendor_specific(pos, elen,
+					elems,
+					show_errors))
+				unknown++;
+			break;
+		case WLAN_EID_RSN:
+			elems->rsn_ie =3D pos;
+			elems->rsn_ie_len =3D elen;
+			break;
+		case WLAN_EID_PWR_CAPABILITY:
+			elems->power_cap =3D pos;
+			elems->power_cap_len =3D elen;
+			break;
+		case WLAN_EID_SUPPORTED_CHANNELS:
+			elems->supp_channels =3D pos;
+			elems->supp_channels_len =3D elen;
+			break;
+		case WLAN_EID_MOBILITY_DOMAIN:
+			elems->mdie =3D pos;
+			elems->mdie_len =3D elen;
+			break;
+		case WLAN_EID_FAST_BSS_TRANSITION:
+			elems->ftie =3D pos;
+			elems->ftie_len =3D elen;
+			break;
+		case WLAN_EID_TIMEOUT_INTERVAL:
+			elems->timeout_int =3D pos;
+			elems->timeout_int_len =3D elen;
+			break;
+		case WLAN_EID_HT_CAP:
+			elems->ht_capabilities =3D pos;
+			elems->ht_capabilities_len =3D elen;
+			break;
+		case WLAN_EID_HT_OPERATION:
+			elems->ht_operation =3D pos;
+			elems->ht_operation_len =3D elen;
+			break;
+		case WLAN_EID_VHT_CAPABILITY:
+			elems->vht_capabilities =3D pos;
+			elems->vht_capabilities_len =3D elen;
+			break;
+		case WLAN_EID_VHT_OPERATION:
+			elems->vht_operation =3D pos;
+			elems->vht_operation_len =3D elen;
+			break;
+		case WLAN_EID_VHT_OP_MODE_NOTIFY:
+			elems->vht_op_mode_notify =3D pos;
+			elems->vht_op_mode_notify_len =3D elen;
+			break;
+		default:
+			unknown++;
+			if (!show_errors)
+				break;
+			RTW_DBG("IEEE 802.11 element parse "
+				"ignored unknown element (id=3D%d elen=3D%d)\n",
+				id, elen);
+			break;
+		}
+
+		left -=3D elen;
+		pos +=3D elen;
+	}
+
+	if (left)
+		return ParseFailed;
+
+	return unknown ? ParseUnknown : ParseOK;
+
+}
