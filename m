+static u32 arcfour_byte(struct arc4context	*parc4ctx)
+{
+	u32 x;
+	u32 y;
+	u32 sx, sy;
+	u8 *state;
+	state =3D parc4ctx->state;
+	x =3D (parc4ctx->x + 1) & 0xff;
+	sx =3D state[x];
+	y =3D (sx + parc4ctx->y) & 0xff;
+	sy =3D state[y];
+	parc4ctx->x =3D x;
+	parc4ctx->y =3D y;
+	state[y] =3D (u8)sx;
+	state[x] =3D (u8)sy;
+	return state[(sx + sy) & 0xff];
