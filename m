+static int readFile(struct file *fp, char *buf, int len)
+{
+	int rlen =3D 0, sum =3D 0;
+
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(4, 1, 0))
+	if (!(fp->f_mode & FMODE_CAN_READ))
+#else
+	if (!fp->f_op || !fp->f_op->read)
+#endif
+		return -EPERM;
+
+	while (sum < len) {
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(4, 1, 0))
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(4, 14, 0))
+		rlen =3D kernel_read(fp, buf + sum, len - sum, &fp->f_pos);
+#else
+		rlen =3D __vfs_read(fp, buf + sum, len - sum, &fp->f_pos);
+#endif
+#else
+		rlen =3D fp->f_op->read(fp, buf + sum, len - sum, &fp->f_pos);
+#endif
+		if (rlen > 0)
+			sum +=3D rlen;
+		else if (0 !=3D rlen)
+			return rlen;
+		else
+			break;
+	}
+
+	return  sum;
+
+}
+
+static int writeFile(struct file *fp, char *buf, int len)
+{
+	int wlen =3D 0, sum =3D 0;
+
+	if (!fp->f_op || !fp->f_op->write)
+		return -EPERM;
+
+	while (sum < len) {
+		wlen =3D fp->f_op->write(fp, (char __user *)buf + sum, len - sum, &fp->f=
_pos);
+		if (wlen > 0)
+			sum +=3D wlen;
+		else if (0 !=3D wlen)
+			return wlen;
+		else
+			break;
+	}
+
+	return sum;
+
+}
