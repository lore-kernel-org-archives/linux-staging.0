+				goto choose_chbw;
+			RTW_WARN(FUNC_ADPT_FMT" req: %u,%u,%u doesn't fit in chplan\n", FUNC_AD=
PT_ARG(adapter), dec_ch, dec_bw, dec_offset);
+			*chbw_allow =3D false;
+			goto exit;
+		}
+
+		if (rtw_odm_dfs_domain_unknown(adapter) && rtw_is_dfs_ch(dec_ch, dec_bw,=
 dec_offset)) {
+			if (req_ch >=3D 0)
+				RTW_WARN(FUNC_ADPT_FMT" DFS channel %u,%u,%u can't be used\n", FUNC_AD=
PT_ARG(adapter), dec_ch, dec_bw, dec_offset);
