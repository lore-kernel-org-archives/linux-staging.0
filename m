+			if ((padapter->securitypriv.dot11PrivacyAlgrthm =3D=3D _TKIP_) ||
+			    (padapter->securitypriv.dot11PrivacyAlgrthm =3D=3D _AES_))
+				rtw_setstakey_cmd(padapter, psta, UNICAST_KEY, false);
+		}
+	}
