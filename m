+u32 rtw_bf_get_report_packet(PADAPTER adapter, union recv_frame *precv_fra=
me)
+{
+	u32 ret =3D _SUCCESS;
+	struct beamforming_info *info;
+	struct beamformee_entry *bfee =3D NULL;
+	u8 *pframe;
+	u32 frame_len;
+	u8 *ta;
+	u8 *frame_body;
+	u8 category, action;
+	u8 *pMIMOCtrlField, *pCSIMatrix;
+	u8 Nc =3D 0, Nr =3D 0, CH_W =3D 0, Ng =3D 0, CodeBook =3D 0;
+	u16 CSIMatrixLen =3D 0;
+
+
+	RTW_INFO("+%s\n", __func__);
+
+	info =3D GET_BEAMFORM_INFO(adapter);
+	pframe =3D precv_frame->u.hdr.rx_data;
+	frame_len =3D precv_frame->u.hdr.len;
+
+	/* Memory comparison to see if CSI report is the same with previous one */
+	ta =3D get_addr2_ptr(pframe);
+	bfee =3D _bfee_get_entry_by_addr(adapter, ta);
+	if (!bfee)
+		return _FAIL;
+
+	frame_body =3D pframe + sizeof(struct rtw_ieee80211_hdr_3addr);
+	category =3D frame_body[0];
+	action =3D frame_body[1];
+
+	if ((category =3D=3D RTW_WLAN_CATEGORY_VHT)
+	    && (action =3D=3D RTW_WLAN_ACTION_VHT_COMPRESSED_BEAMFORMING)) {
+		pMIMOCtrlField =3D pframe + 26;
+		Nc =3D (*pMIMOCtrlField) & 0x7;
+		Nr =3D ((*pMIMOCtrlField) & 0x38) >> 3;
+		CH_W =3D  (((*pMIMOCtrlField) & 0xC0) >> 6);
+		Ng =3D (*(pMIMOCtrlField+1)) & 0x3;
+		CodeBook =3D ((*(pMIMOCtrlField+1)) & 0x4) >> 2;
+		/*
+		 * 24+(1+1+3)+2
+		 * =3D=3D> MAC header+(Category+ActionCode+MIMOControlField)+SNR(Nc=3D2)
+		 */
+		pCSIMatrix =3D pMIMOCtrlField + 3 + Nc;
+		CSIMatrixLen =3D frame_len - 26 - 3 - Nc;
+		info->TargetCSIInfo.bVHT =3D true;
+	} else if ((category =3D=3D RTW_WLAN_CATEGORY_HT)
+		   && (action =3D=3D RTW_WLAN_ACTION_HT_COMPRESS_BEAMFORMING)) {
+		pMIMOCtrlField =3D pframe + 26;
+		Nc =3D (*pMIMOCtrlField) & 0x3;
+		Nr =3D ((*pMIMOCtrlField) & 0xC) >> 2;
+		CH_W =3D ((*pMIMOCtrlField) & 0x10) >> 4;
+		Ng =3D ((*pMIMOCtrlField) & 0x60) >> 5;
+		CodeBook =3D ((*(pMIMOCtrlField+1)) & 0x6) >> 1;
+		/*
+		 * 24+(1+1+6)+2
+		 * =3D=3D> MAC header+(Category+ActionCode+MIMOControlField)+SNR(Nc=3D2)
+		 */
+		pCSIMatrix =3D pMIMOCtrlField + 6 + Nr;
+		CSIMatrixLen =3D frame_len  - 26 - 6 - Nr;
+		info->TargetCSIInfo.bVHT =3D false;
+	}
+
+	/* Update current CSI report info */
+	if ((info->bEnableSUTxBFWorkAround)
+	    && (info->TargetSUBFee =3D=3D bfee)) {
+		if ((info->TargetCSIInfo.Nc !=3D Nc) || (info->TargetCSIInfo.Nr !=3D Nr)=
 ||
+			(info->TargetCSIInfo.ChnlWidth !=3D CH_W) || (info->TargetCSIInfo.Ng !=
=3D Ng) ||
+			(info->TargetCSIInfo.CodeBook !=3D CodeBook)) {
+			info->TargetCSIInfo.Nc =3D Nc;
+			info->TargetCSIInfo.Nr =3D Nr;
+			info->TargetCSIInfo.ChnlWidth =3D CH_W;
+			info->TargetCSIInfo.Ng =3D Ng;
+			info->TargetCSIInfo.CodeBook =3D CodeBook;
+
+			rtw_bf_cmd(adapter, BEAMFORMING_CTRL_SET_CSI_REPORT, (u8*)&info->Target=
CSIInfo, sizeof(struct _RT_CSI_INFO), 1);
+		}
+	}
+
+	RTW_INFO("%s: pkt type=3D%d-%d, Nc=3D%d, Nr=3D%d, CH_W=3D%d, Ng=3D%d, Cod=
eBook=3D%d\n",
+		 __func__, category, action, Nc, Nr, CH_W, Ng, CodeBook);
+
+	return ret;
+}
