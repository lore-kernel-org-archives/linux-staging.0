SKDWORD) >> 22) & 0x3FF;
+
+		X =3D result[final_candidate][4];
+		if ((X & 0x00000200) !=3D 0)
+			X =3D X | 0xFFFFFC00;
+		TX1_A =3D (X * oldval_1) >> 8;
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("X =3D 0x%x,=
 TX1_A =3D 0x%x\n", X, TX1_A));
