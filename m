+	tmp1byte =3D rtw_read8(padapter, GPIO_IO_SEL);
+	tmp1byte &=3D ~(HAL_8188E_HW_GPIO_WPS_BIT);
+	rtw_write8(padapter, GPIO_IO_SEL, tmp1byte);	/* enable GPIO[2] as input m=
ode */
+
+	tmp1byte =3D rtw_read8(padapter, GPIO_IN);
+
+	if (tmp1byte =3D=3D 0xff)
