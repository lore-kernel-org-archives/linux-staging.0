+static inline char *iwe_stream_wps_process(_adapter *padapter,
+		struct iw_request_info *info, struct wlan_network *pnetwork,
+		char *start, char *stop, struct iw_event *iwe)
+{
+	/* parsing WPS IE */
+	uint cnt =3D 0, total_ielen;
+	u8 *wpsie_ptr =3D NULL;
+	uint wps_ielen =3D 0;
+	u8 ie_offset =3D (pnetwork->network.Reserved[0] =3D=3D 2 ? 0 : 12);
+
+	u8 *ie_ptr =3D pnetwork->network.IEs + ie_offset;
+	total_ielen =3D pnetwork->network.IELength - ie_offset;
+
+	if (pnetwork->network.Reserved[0] =3D=3D 2) { /* Probe Request */
+		ie_ptr =3D pnetwork->network.IEs;
+		total_ielen =3D pnetwork->network.IELength;
+	} else { /* Beacon or Probe Respones */
+		ie_ptr =3D pnetwork->network.IEs + _FIXED_IE_LENGTH_;
+		total_ielen =3D pnetwork->network.IELength - _FIXED_IE_LENGTH_;
+	}
+	while (cnt < total_ielen) {
+		if (rtw_is_wps_ie(&ie_ptr[cnt], &wps_ielen) && (wps_ielen > 2)) {
+			wpsie_ptr =3D &ie_ptr[cnt];
+			iwe->cmd =3D IWEVGENIE;
+			iwe->u.data.length =3D (u16)wps_ielen;
+			start =3D iwe_stream_add_point(info, start, stop, iwe, wpsie_ptr);
+		}
+		cnt +=3D ie_ptr[cnt + 1] + 2; /* goto next */
+	}
+	return start;
+}
