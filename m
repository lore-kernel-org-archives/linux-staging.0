+static int rtw_wx_set_mode(struct net_device *dev, struct iw_request_info =
*a,
+			   union iwreq_data *wrqu, char *b)
+{
+	_adapter *padapter =3D (_adapter *)rtw_netdev_priv(dev);
+	struct	mlme_priv	*pmlmepriv =3D &(padapter->mlmepriv);
+	NDIS_802_11_NETWORK_INFRASTRUCTURE networkType ;
+	int ret =3D 0;
+
+
+	if (_FAIL =3D=3D rtw_pwr_wakeup(padapter)) {
+		ret =3D -EPERM;
+		goto exit;
+	}
+
+	if (!rtw_is_hw_init_completed(padapter)) {
+		ret =3D -EPERM;
+		goto exit;
+	}
+
+	/* initial default type */
+	dev->type =3D ARPHRD_ETHER;
+
+	if (wrqu->mode =3D=3D IW_MODE_MONITOR) {
+		rtw_ps_deny(padapter, PS_DENY_MONITOR_MODE);
+		LeaveAllPowerSaveMode(padapter);
+	} else {
+		rtw_ps_deny_cancel(padapter, PS_DENY_MONITOR_MODE);
+	}
+
+	switch (wrqu->mode) {
+	case IW_MODE_MONITOR:
+		networkType =3D Ndis802_11Monitor;
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 24))
+		dev->type =3D ARPHRD_IEEE80211_RADIOTAP; /* IEEE 802.11 + radiotap heade=
r : 803 */
+		RTW_INFO("set_mode =3D IW_MODE_MONITOR\n");
+#else
+		RTW_INFO("kernel version < 2.6.24 not support IW_MODE_MONITOR\n");
+#endif
+		break;
+
+	case IW_MODE_AUTO:
+		networkType =3D Ndis802_11AutoUnknown;
+		RTW_INFO("set_mode =3D IW_MODE_AUTO\n");
+		break;
+	case IW_MODE_ADHOC:
+		networkType =3D Ndis802_11IBSS;
+		RTW_INFO("set_mode =3D IW_MODE_ADHOC\n");
+		break;
+	case IW_MODE_MASTER:
+		networkType =3D Ndis802_11APMode;
+		RTW_INFO("set_mode =3D IW_MODE_MASTER\n");
+		/* rtw_setopmode_cmd(padapter, networkType,true);	 */
+		break;
+	case IW_MODE_INFRA:
+		networkType =3D Ndis802_11Infrastructure;
+		RTW_INFO("set_mode =3D IW_MODE_INFRA\n");
+		break;
+
+	default:
+		ret =3D -EINVAL;;
+		goto exit;
+	}
+
+	/*
+		if(Ndis802_11APMode =3D=3D networkType)
+		{
+			rtw_setopmode_cmd(padapter, networkType,true);
+		}
+		else
+		{
+			rtw_setopmode_cmd(padapter, Ndis802_11AutoUnknown,true);
+		}
+	*/
+
+	if (rtw_set_802_11_infrastructure_mode(padapter, networkType) =3D=3D fals=
e) {
+
+		ret =3D -EPERM;
+		goto exit;
+
+	}
+
+	rtw_setopmode_cmd(padapter, networkType, true);
+
+	if (check_fwstate(pmlmepriv, WIFI_MONITOR_STATE) )
+		rtw_indicate_connect(padapter);
+
+exit:
+
+
+	return ret;
+
+}
