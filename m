+		t_cch =3D cch;
+		goto exit;
+	}
+
+	if (offset =3D=3D HAL_PRIME_CHNL_OFFSET_DONT_CARE) {
+		rtw_warn_on(1);
+		goto exit;
+	}
+
+	/* 2.4G, 40MHz */
+	if (cch >=3D 3 && cch <=3D 11 && bw =3D=3D CHANNEL_WIDTH_40) {
+		t_cch =3D (offset =3D=3D HAL_PRIME_CHNL_OFFSET_UPPER) ? cch + 2 : cch - =
2;
+		goto exit;
+	}
+
+	/* 5G, 160MHz */
+	if (cch >=3D 50 && cch <=3D 163 && bw =3D=3D CHANNEL_WIDTH_160) {
+		t_cch =3D (offset =3D=3D HAL_PRIME_CHNL_OFFSET_UPPER) ? cch + 8 : cch - =
8;
+		goto exit;
+
+	/* 5G, 80MHz */
+	} else if (cch >=3D 42 && cch <=3D 171 && bw =3D=3D CHANNEL_WIDTH_80) {
+		t_cch =3D (offset =3D=3D HAL_PRIME_CHNL_OFFSET_UPPER) ? cch + 4 : cch - =
4;
+		goto exit;
+
+	/* 5G, 40MHz */
+	} else if (cch >=3D 38 && cch <=3D 175 && bw =3D=3D CHANNEL_WIDTH_40) {
+		t_cch =3D (offset =3D=3D HAL_PRIME_CHNL_OFFSET_UPPER) ? cch + 2 : cch - =
2;
+		goto exit;
