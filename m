+int usbctrl_vendorreq(struct intf_hdl *pintfhdl, u8 request, u16 value, u1=
6 index, void *pdata, u16 len, u8 requesttype)
+{
+	_adapter	*padapter =3D pintfhdl->padapter;
+	struct dvobj_priv  *pdvobjpriv =3D adapter_to_dvobj(padapter);
+	struct pwrctrl_priv *pwrctl =3D dvobj_to_pwrctl(pdvobjpriv);
+	struct usb_device *udev =3D pdvobjpriv->pusbdev;
+
+	unsigned int pipe;
+	int status =3D 0;
+	u32 tmp_buflen =3D 0;
+	u8 reqtype;
+	u8 *pIo_buf;
+	int vendorreq_times =3D 0;
+
+#ifdef CONFIG_USB_VENDOR_REQ_BUFFER_DYNAMIC_ALLOCATE
+	u8 *tmp_buf;
+#else /* use stack memory */
+	u8 tmp_buf[MAX_USB_IO_CTL_SIZE];
+#endif
+
+	/* RTW_INFO("%s %s:%d\n",__func__, current->comm, current->pid); */
+
+	if (RTW_CANNOT_IO(padapter)) {
+		status =3D -EPERM;
+		goto exit;
+	}
+
+	if (len > MAX_VENDOR_REQ_CMD_SIZE) {
+		RTW_INFO("[%s] Buffer len error ,vendor request failed\n", __func__);
+		status =3D -EINVAL;
+		goto exit;
+	}
+
+#ifdef CONFIG_USB_VENDOR_REQ_MUTEX
+	_enter_critical_mutex(&pdvobjpriv->usb_vendor_req_mutex, NULL);
+#endif
+
+
+	/* Acquire IO memory for vendorreq */
+#ifdef CONFIG_USB_VENDOR_REQ_BUFFER_PREALLOC
+	pIo_buf =3D pdvobjpriv->usb_vendor_req_buf;
+#else
+	#ifdef CONFIG_USB_VENDOR_REQ_BUFFER_DYNAMIC_ALLOCATE
+	tmp_buf =3D rtw_malloc((u32) len + ALIGNMENT_UNIT);
+	tmp_buflen =3D (u32)len + ALIGNMENT_UNIT;
+	#else /* use stack memory */
+	tmp_buflen =3D MAX_USB_IO_CTL_SIZE;
+	#endif
+
+	/* Added by Albert 2010/02/09 */
+	/* For mstar platform, mstar suggests the address for USB IO should be 16=
 bytes alignment. */
+	/* Trying to fix it here. */
+	pIo_buf =3D (tmp_buf =3D=3D NULL) ? NULL : tmp_buf + ALIGNMENT_UNIT - ((S=
IZE_PTR)(tmp_buf) & 0x0f);
+#endif
+
+	if (pIo_buf =3D=3D NULL) {
+		RTW_INFO("[%s] pIo_buf =3D=3D NULL\n", __func__);
+		status =3D -ENOMEM;
+		goto release_mutex;
+	}
+
+	while (++vendorreq_times <=3D MAX_USBCTRL_VENDORREQ_TIMES) {
+		memset(pIo_buf, 0, len);
+
+		if (requesttype =3D=3D 0x01) {
+			pipe =3D usb_rcvctrlpipe(udev, 0);/* read_in */
+			reqtype =3D  REALTEK_USB_VENQT_READ;
+		} else {
+			pipe =3D usb_sndctrlpipe(udev, 0);/* write_out */
+			reqtype =3D  REALTEK_USB_VENQT_WRITE;
+			memcpy(pIo_buf, pdata, len);
+		}
+
+		status =3D rtw_usb_control_msg(udev, pipe, request, reqtype, value, inde=
x, pIo_buf, len, RTW_USB_CONTROL_MSG_TIMEOUT);
+
+		if (status =3D=3D len) {  /* Success this control transfer. */
+			rtw_reset_continual_io_error(pdvobjpriv);
+			if (requesttype =3D=3D 0x01) {
+				/* For Control read transfer, we have to copy the read data from pIo_b=
uf to pdata. */
+				memcpy(pdata, pIo_buf,  len);
+			}
+		} else { /* error cases */
+			RTW_INFO("reg 0x%x, usb %s %u fail, status:%d value=3D0x%x, vendorreq_t=
imes:%d\n"
+				, value, (requesttype =3D=3D 0x01) ? "read" : "write" , len, status, *=
(u32 *)pdata, vendorreq_times);
+
+			if (status < 0) {
+				if (status =3D=3D (-ESHUTDOWN)	|| status =3D=3D -ENODEV)
+					rtw_set_surprise_removed(padapter);
+				else {
+					#ifdef DBG_CONFIG_ERROR_DETECT
+					{
+						HAL_DATA_TYPE	*pHalData =3D GET_HAL_DATA(padapter);
+						pHalData->srestpriv.Wifi_Error_Status =3D USB_VEN_REQ_CMD_FAIL;
+					}
+					#endif
+				}
+			} else { /* status !=3D len && status >=3D 0 */
+				if (status > 0) {
+					if (requesttype =3D=3D 0x01) {
+						/* For Control read transfer, we have to copy the read data from pIo=
_buf to pdata. */
+						memcpy(pdata, pIo_buf,  len);
+					}
+				}
+			}
+
+			if (rtw_inc_and_chk_continual_io_error(pdvobjpriv) =3D=3D true) {
+				rtw_set_surprise_removed(padapter);
+				break;
+			}
+
+		}
+
+		/* firmware download is checksumed, don't retry */
+		if ((value >=3D FW_START_ADDRESS) || status =3D=3D len)
+			break;
+
+	}
+
+	/* release IO memory used by vendorreq */
+#ifdef CONFIG_USB_VENDOR_REQ_BUFFER_DYNAMIC_ALLOCATE
+	rtw_mfree(tmp_buf, tmp_buflen);
+#endif
+
+release_mutex:
+#ifdef CONFIG_USB_VENDOR_REQ_MUTEX
+	_exit_critical_mutex(&pdvobjpriv->usb_vendor_req_mutex, NULL);
+#endif
+exit:
+	return status;
+
+}
