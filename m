+				portConnectedStatus |=3D WIFI_P2P_GO_CONNECTED;
+			else
+				portConnectedStatus |=3D WIFI_AP_CONNECTED;
+		} else {
+			if (bp2p)
+				portConnectedStatus |=3D WIFI_P2P_GC_CONNECTED;
+			else
