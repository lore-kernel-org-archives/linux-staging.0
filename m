+			*sta_bf_cap |=3D BEAMFORMER_CAP_HT_EXPLICIT;
+			*sounding_dim =3D (bf_cap & BEAMFORMING_HT_BEAMFORMEE_CHNL_EST_CAP) >> =
6;
