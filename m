+static int tls_match_altsubject_component(X509 *cert, int type,
+					  const char *value, size_t len)
+{
+	GENERAL_NAME *gen;
+	void *ext;
+	int i, found =3D 0;
+
+	ext =3D X509_get_ext_d2i(cert, NID_subject_alt_name, NULL, NULL);
+
+	for (i =3D 0; ext && i < sk_GENERAL_NAME_num(ext); i++) {
+		gen =3D sk_GENERAL_NAME_value(ext, i);
+		if (gen->type !=3D type)
+			continue;
+		if (os_strlen((char *) gen->d.ia5->data) =3D=3D len &&
+		    os_memcmp(value, gen->d.ia5->data, len) =3D=3D 0)
+			found++;
+	}
+
+	return found;
+}
