+static int
+wpa_driver_ralink_set_countermeasures(void *priv, int enabled)
+{
+	struct wpa_driver_ralink_data *drv =3D priv;
+	if (drv->g_driver_down =3D=3D 1)
+		return -1;
+	wpa_printf(MSG_DEBUG, "%s: enabled=3D%d", __FUNCTION__, enabled);
+	return ralink_set_oid(drv, OID_SET_COUNTERMEASURES, (char *) &enabled,
+			      sizeof(int));
+}
