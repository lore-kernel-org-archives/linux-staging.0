odm), get_igi_for_diff(current_igi));
+				break;
+			case ODM_CCA_1R_B:
+				odm_set_bb_reg(p_dm_odm, ODM_REG(IGI_B, p_dm_odm), ODM_BIT(IGI, p_dm_o=
dm), get_igi_for_diff(current_igi));
+				if (p_dm_odm->rf_type !=3D ODM_1T1R)
+					odm_set_bb_reg(p_dm_odm, ODM_REG(IGI_A, p_dm_odm), ODM_BIT(IGI, p_dm_=
odm), current_igi);
+				break;
+			}
+		}
+
+		p_dm_dig_table->cur_ig_value =3D current_igi;
+	}
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_DIG, ODM_DBG_TRACE, ("odm_write_dig(): cu=
rrent_igi(0x%02x).\n", current_igi));
