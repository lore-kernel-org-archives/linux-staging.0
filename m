+	/* For CE/NIC use struct _ADAPTER* */
+	/*  */
+
+	/*  */
+	/* 2011/09/29 MH In HW integration first stage, we provide 4 different ha=
ndle to operate */
+	/* at the same time. In the stage2/3, we need to prive universal interfac=
e and merge all */
+	/* HW dynamic mechanism. */
+	/*  */
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_EDCA_TURBO, ODM_DBG_LOUD, ("odm_edca_turb=
o_check=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D>\n"));
+
+	if (!(p_dm_odm->support_ability & ODM_MAC_EDCA_TURBO))
+		return;
+
+	switch	(p_dm_odm->support_platform) {
+	case	ODM_WIN:
+		break;
+	case	ODM_CE:
+		odm_edca_turbo_check_ce(p_dm_odm);
+		break;
+	}
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_EDCA_TURBO, ODM_DBG_LOUD, ("<=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3Dodm_edca_turbo_=
check\n"));
+
+}	/* odm_CheckEdcaTurbo */
+
+void
+odm_edca_turbo_check_ce(
+	void		*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _ADAPTER		*adapter =3D p_dm_odm->adapter;
+	u32	EDCA_BE_UL =3D 0x5ea42b;/* Parameter suggested by Scott  */ /* edca_s=
etting_UL[p_mgnt_info->iot_peer]; */
+	u32	EDCA_BE_DL =3D 0x00a42b;/* Parameter suggested by Scott  */ /* edca_s=
etting_DL[p_mgnt_info->iot_peer]; */
+	u32	ic_type =3D p_dm_odm->support_ic_type;
+	u32	iot_peer =3D 0;
+	u8	wireless_mode =3D 0xFF;                 /* invalid value */
+	u32	traffic_index;
+	u32	edca_param;
+	u64	cur_tx_bytes =3D 0;
+	u64	cur_rx_bytes =3D 0;
+	u8	bbtchange =3D true;
+	u8	is_bias_on_rx =3D false;
+	HAL_DATA_TYPE		*p_hal_data =3D GET_HAL_DATA(adapter);
+	struct dvobj_priv		*pdvobjpriv =3D adapter_to_dvobj(adapter);
+	struct xmit_priv		*pxmitpriv =3D &(adapter->xmitpriv);
+	struct recv_priv		*precvpriv =3D &(adapter->recvpriv);
+	struct registry_priv	*pregpriv =3D &adapter->registrypriv;
+	struct mlme_ext_priv	*pmlmeext =3D &(adapter->mlmeextpriv);
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+
+	if (p_dm_odm->is_linked !=3D true) {
+		precvpriv->is_any_non_be_pkts =3D false;
+		return;
+	}
+
+	if ((pregpriv->wifi_spec =3D=3D 1)) { /* || (pmlmeinfo->HT_enable =3D=3D =
0)) */
+		precvpriv->is_any_non_be_pkts =3D false;
+		return;
+	}
+
+	if (p_dm_odm->p_wireless_mode !=3D NULL)
+		wireless_mode =3D *(p_dm_odm->p_wireless_mode);
+
+	iot_peer =3D pmlmeinfo->assoc_AP_vendor;
+
+	if (iot_peer >=3D  HT_IOT_PEER_MAX) {
+		precvpriv->is_any_non_be_pkts =3D false;
+		return;
+	}
+
+	if (p_dm_odm->support_ic_type & ODM_RTL8188E) {
+		if ((iot_peer =3D=3D HT_IOT_PEER_RALINK) || (iot_peer =3D=3D HT_IOT_PEER=
_ATHEROS))
+			is_bias_on_rx =3D true;
+	}
+
+	/* Check if the status needs to be changed. */
+	if ((bbtchange) || (!precvpriv->is_any_non_be_pkts)) {
+		cur_tx_bytes =3D pdvobjpriv->traffic_stat.cur_tx_bytes;
+		cur_rx_bytes =3D pdvobjpriv->traffic_stat.cur_rx_bytes;
+
+		/* traffic, TX or RX */
+		if (is_bias_on_rx) {
+			if (cur_tx_bytes > (cur_rx_bytes << 2)) {
+				/* Uplink TP is present. */
+				traffic_index =3D UP_LINK;
+			} else {
+				/* Balance TP is present. */
+				traffic_index =3D DOWN_LINK;
+			}
+		} else {
+			if (cur_rx_bytes > (cur_tx_bytes << 2)) {
+				/* Downlink TP is present. */
+				traffic_index =3D DOWN_LINK;
+			} else {
+				/* Balance TP is present. */
+				traffic_index =3D UP_LINK;
+			}
+		}
+
+		/* if ((p_dm_odm->dm_edca_table.prv_traffic_idx !=3D traffic_index) || (=
!p_dm_odm->dm_edca_table.is_current_turbo_edca)) */
+		{
+			if (p_dm_odm->support_interface =3D=3D ODM_ITRF_PCIE) {
+				EDCA_BE_UL =3D 0x6ea42b;
+				EDCA_BE_DL =3D 0x6ea42b;
+			}
+
+			/* 92D txop can't be set to 0x3e for cisco1250 */
+			if ((iot_peer =3D=3D HT_IOT_PEER_CISCO) && (wireless_mode =3D=3D ODM_WM=
_N24G)) {
+				EDCA_BE_DL =3D edca_setting_DL[iot_peer];
+				EDCA_BE_UL =3D edca_setting_UL[iot_peer];
+			}
+			/* merge from 92s_92c_merge temp brunch v2445    20120215 */
+			else if ((iot_peer =3D=3D HT_IOT_PEER_CISCO) && ((wireless_mode =3D=3D =
ODM_WM_G) || (wireless_mode =3D=3D (ODM_WM_B | ODM_WM_G)) || (wireless_mode=
 =3D=3D ODM_WM_A) || (wireless_mode =3D=3D ODM_WM_B)))
+				EDCA_BE_DL =3D edca_setting_dl_g_mode[iot_peer];
+			else if ((iot_peer =3D=3D HT_IOT_PEER_AIRGO) && ((wireless_mode =3D=3D =
ODM_WM_G) || (wireless_mode =3D=3D ODM_WM_A)))
+				EDCA_BE_DL =3D 0xa630;
+			else if (iot_peer =3D=3D HT_IOT_PEER_MARVELL) {
+				EDCA_BE_DL =3D edca_setting_DL[iot_peer];
+				EDCA_BE_UL =3D edca_setting_UL[iot_peer];
+			} else if (iot_peer =3D=3D HT_IOT_PEER_ATHEROS) {
+				/* Set DL EDCA for Atheros peer to 0x3ea42b. Suggested by SD3 Wilson f=
or ASUS TP issue. */
+				EDCA_BE_DL =3D edca_setting_DL[iot_peer];
+			}
+
+			if ((ic_type =3D=3D ODM_RTL8812) || (ic_type =3D=3D ODM_RTL8821) || (ic=
_type =3D=3D ODM_RTL8192E)) { /* add 8812AU/8812AE */
+				EDCA_BE_UL =3D 0x5ea42b;
+				EDCA_BE_DL =3D 0x5ea42b;
+
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_EDCA_TURBO, ODM_DBG_LOUD, ("8812A: EDC=
A_BE_UL=3D0x%x EDCA_BE_DL =3D0x%x", EDCA_BE_UL, EDCA_BE_DL));
+			}
+
+			if (traffic_index =3D=3D DOWN_LINK)
+				edca_param =3D EDCA_BE_DL;
+			else
+				edca_param =3D EDCA_BE_UL;
+
+			rtw_write32(adapter, REG_EDCA_BE_PARAM, edca_param);
+
+			p_dm_odm->dm_edca_table.prv_traffic_idx =3D traffic_index;
+		}
+
+		p_dm_odm->dm_edca_table.is_current_turbo_edca =3D true;
+	} else {
+		/*  */
+		/* Turn Off EDCA turbo here. */
+		/* Restore original EDCA according to the declaration of AP. */
+		/*  */
+		if (p_dm_odm->dm_edca_table.is_current_turbo_edca) {
+			rtw_write32(adapter, REG_EDCA_BE_PARAM, p_hal_data->ac_param_be);
+			p_dm_odm->dm_edca_table.is_current_turbo_edca =3D false;
+		}
+	}
+}
+
+#endif /*PHYDM_SUPPORT_EDCA*/
