+static void phy_DecryptBBPgParaFile(PADAPTER Adapter, char *buffer)
+{
+	u32	i =3D 0, j =3D 0;
+	u8	map[95] =3D {0};
+	u8	currentChar;
+	char	*BufOfLines, *ptmp;
+
+	/* RTW_INFO("=3D=3D=3D=3D=3D>phy_DecryptBBPgParaFile()\n"); */
+	/* 32 the ascii code of the first visable char, 126 the last one */
+	for (i =3D 0; i < 95; ++i)
+		map[i] =3D (u8)(94 - i);
+
+	ptmp =3D buffer;
+	i =3D 0;
+	for (BufOfLines =3D GetLineFromBuffer(ptmp); BufOfLines !=3D NULL; BufOfL=
ines =3D GetLineFromBuffer(ptmp)) {
+		/* RTW_INFO("Encrypted Line: %s\n", BufOfLines); */
+
+		for (j =3D 0; j < strlen(BufOfLines); ++j) {
+			currentChar =3D BufOfLines[j];
+
+			if (currentChar =3D=3D '\0')
+				break;
+
+			currentChar -=3D (u8)((((i + j) * 3) % 128));
+
+			BufOfLines[j] =3D map[currentChar - 32] + 32;
+		}
+		/* RTW_INFO("Decrypted Line: %s\n", BufOfLines ); */
+		if (strlen(BufOfLines) !=3D 0)
+			i++;
+		BufOfLines[strlen(BufOfLines)] =3D '\n';
+	}
+}
