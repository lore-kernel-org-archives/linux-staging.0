+	for (i =3D 0; i < 8; i++) {
+		S[i] =3D md->state[i];
+	}
+
+	/* copy the state into 512-bits into W[0..15] */
+	for (i =3D 0; i < 16; i++)
+		W[i] =3D WPA_GET_BE32(buf + (4 * i));
+
+	/* fill W[16..63] */
+	for (i =3D 16; i < 64; i++) {
+		W[i] =3D Gamma1(W[i - 2]) + W[i - 7] + Gamma0(W[i - 15]) +
+			W[i - 16];
+	}=20=20=20=20=20=20=20=20
+
