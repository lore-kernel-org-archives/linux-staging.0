+static void wpa_driver_osx_add_scan_entry(struct wpa_scan_results *res,
+					  WirelessNetworkInfo *info)
+{
+	struct wpa_scan_res *result, **tmp;
+	size_t extra_len;
+	u8 *pos;
+
+	extra_len =3D 2 + info->ssid_len;
+
+	result =3D os_zalloc(sizeof(*result) + extra_len);
+	if (result =3D=3D NULL)
+		return;
+	os_memcpy(result->bssid, info->bssid, ETH_ALEN);
+	result->freq =3D 2407 + info->channel * 5;
+	//result->beacon_int =3D;
+	result->caps =3D info->capability;
+	//result->qual =3D info->signal;
+	result->noise =3D info->noise;
+
+	pos =3D (u8 *)(result + 1);
+
+	*pos++ =3D WLAN_EID_SSID;
+	*pos++ =3D info->ssid_len;
+	os_memcpy(pos, info->ssid, info->ssid_len);
+	pos +=3D info->ssid_len;
+
+	result->ie_len =3D pos - (u8 *)(result + 1);
+
+	tmp =3D os_realloc(res->res,
+			 (res->num + 1) * sizeof(struct wpa_scan_res *));
+	if (tmp =3D=3D NULL) {
+		os_free(result);
+		return;
