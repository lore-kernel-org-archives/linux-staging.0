+static void ieee802_1x_store_radius_class(struct hostapd_data *hapd,
+					  struct sta_info *sta,
+					  struct radius_msg *msg)
+{
+	u8 *class;
+	size_t class_len;
+	struct eapol_state_machine *sm =3D sta->eapol_sm;
+	int count, i;
+	struct radius_attr_data *nclass;
+	size_t nclass_count;
+
+	if (!hapd->conf->radius->acct_server || hapd->radius =3D=3D NULL ||
+	    sm =3D=3D NULL)
+		return;
+
+	radius_free_class(&sm->radius_class);
+	count =3D radius_msg_count_attr(msg, RADIUS_ATTR_CLASS, 1);
+	if (count <=3D 0)
+		return;
+
+	nclass =3D os_zalloc(count * sizeof(struct radius_attr_data));
+	if (nclass =3D=3D NULL)
+		return;
+
+	nclass_count =3D 0;
+
+	class =3D NULL;
+	for (i =3D 0; i < count; i++) {
+		do {
+			if (radius_msg_get_attr_ptr(msg, RADIUS_ATTR_CLASS,
+						    &class, &class_len,
+						    class) < 0) {
+				i =3D count;
+				break;
+			}
+		} while (class_len < 1);
+
+		nclass[nclass_count].data =3D os_malloc(class_len);
+		if (nclass[nclass_count].data =3D=3D NULL)
+			break;
+
+		os_memcpy(nclass[nclass_count].data, class, class_len);
+		nclass[nclass_count].len =3D class_len;
+		nclass_count++;
+	}
+
+	sm->radius_class.attr =3D nclass;
+	sm->radius_class.count =3D nclass_count;
+	wpa_printf(MSG_DEBUG, "IEEE 802.1X: Stored %lu RADIUS Class "
+		   "attributes for " MACSTR,
+		   (unsigned long) sm->radius_class.count,
+		   MAC2STR(sta->addr));
+}
