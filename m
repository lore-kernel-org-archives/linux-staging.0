+static void hal_load_pg_txpwr_info(
+	_adapter *adapter,
+	TxPowerInfo24G *pwr_info_2g,
+	TxPowerInfo5G *pwr_info_5g,
+	u8 *pg_data,
+	bool AutoLoadFail
+)
+{
+	struct hal_spec_t *hal_spec =3D GET_HAL_SPEC(adapter);
+	u8 path;
+	u16 pg_offset;
+	u8 txpwr_src =3D PG_TXPWR_SRC_PG_DATA;
+	struct map_t pg_data_map =3D MAP_ENT(184, 1, 0xFF, MAPSEG_PTR_ENT(0x00, 1=
84, pg_data));
+	const struct map_t *txpwr_map =3D NULL;
+
+	/* init with invalid value and some dummy base and diff */
+	hal_init_pg_txpwr_info_2g(adapter, pwr_info_2g);
+	hal_init_pg_txpwr_info_5g(adapter, pwr_info_5g);
+
+select_src:
+	pg_offset =3D 0x10;
+
+	switch (txpwr_src) {
+	case PG_TXPWR_SRC_PG_DATA:
+		txpwr_map =3D &pg_data_map;
+		break;
+	case PG_TXPWR_SRC_IC_DEF:
+		txpwr_map =3D hal_pg_txpwr_def_info(adapter);
+		break;
+	case PG_TXPWR_SRC_DEF:
+	default:
+		txpwr_map =3D &pg_txpwr_def_info;
+		break;
+	};
+
+	if (txpwr_map =3D=3D NULL)
+		goto end_parse;
+
+	for (path =3D 0; path < MAX_RF_PATH ; path++) {
+		if (!HAL_SPEC_CHK_RF_PATH_2G(hal_spec, path) && !HAL_SPEC_CHK_RF_PATH_5G=
(hal_spec, path))
+			break;
+		pg_offset =3D hal_load_pg_txpwr_info_path_2g(adapter, pwr_info_2g, path,=
 txpwr_src, txpwr_map, pg_offset);
+		pg_offset =3D hal_load_pg_txpwr_info_path_5g(adapter, pwr_info_5g, path,=
 txpwr_src, txpwr_map, pg_offset);
+	}
+
+	if (hal_chk_pg_txpwr_info_2g(adapter, pwr_info_2g) =3D=3D _SUCCESS
+		&& hal_chk_pg_txpwr_info_5g(adapter, pwr_info_5g) =3D=3D _SUCCESS)
+		goto exit;
+
+end_parse:
+	txpwr_src++;
+	if (txpwr_src < PG_TXPWR_SRC_NUM)
+		goto select_src;
+
+	if (hal_chk_pg_txpwr_info_2g(adapter, pwr_info_2g) !=3D _SUCCESS
+		|| hal_chk_pg_txpwr_info_5g(adapter, pwr_info_5g) !=3D _SUCCESS)
+		rtw_warn_on(1);
+
+exit:
+	if (DBG_PG_TXPWR_READ) {
+		if (pwr_info_2g)
+			dump_pg_txpwr_info_2g(RTW_DBGDUMP, pwr_info_2g, 4, 4);
+		if (pwr_info_5g)
+			dump_pg_txpwr_info_5g(RTW_DBGDUMP, pwr_info_5g, 4, 4);
+	}
+
+	return;
+}
