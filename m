+#define toMbps(bytes, secs)	(rtw_division64(bytes >> 17, secs))
+void rtw_bf_update_traffic(PADAPTER adapter)
+{
+	struct beamforming_info	*info;
+	struct sounding_info *sounding;
+	struct beamformee_entry *bfee;
+	struct sta_info *sta;
+	u8 bfee_cnt, sounding_idx, i;
+	u16 tp[MAX_BEAMFORMEE_ENTRY_NUM] =3D {0};
+	u8 tx_rate[MAX_BEAMFORMEE_ENTRY_NUM] =3D {0};
+	u64 tx_bytes, last_bytes;
+	u32 time, last_timestamp;
+	u8 set_timer =3D false;
+
+
+	info =3D GET_BEAMFORM_INFO(adapter);
+	sounding =3D &info->sounding_info;
+
+	/* Check any bfee exist? */
+	bfee_cnt =3D info->beamformee_su_cnt + info->beamformee_mu_cnt;
+	if (bfee_cnt =3D=3D 0)
+		return;
+
+	for (i =3D 0; i < MAX_BEAMFORMEE_ENTRY_NUM; i++) {
+		bfee =3D &info->bfee_entry[i];
+		if (false =3D=3D bfee->used)
+			continue;
+
+		sta =3D rtw_get_stainfo(&adapter->stapriv, bfee->mac_addr);
+		if (!sta) {
+			RTW_ERR("%s: Cann't find sta_info for " MAC_FMT "!\n", __func__, MAC_AR=
G(bfee->mac_addr));
+			continue;
+		}
+
+		last_timestamp =3D bfee->tx_timestamp;
+		last_bytes =3D bfee->tx_bytes;
+		bfee->tx_timestamp =3D jiffies;
+		bfee->tx_bytes =3D sta->sta_stats.tx_bytes;
+		if (last_timestamp) {
+			if (bfee->tx_bytes >=3D last_bytes)
+				tx_bytes =3D bfee->tx_bytes - last_bytes;
+			else
+				tx_bytes =3D bfee->tx_bytes + (~last_bytes);
+			time =3D rtw_get_time_interval_ms(last_timestamp, bfee->tx_timestamp);
+			time =3D (time > 1000) ? time/1000 : 1;
+			tp[i] =3D toMbps(tx_bytes, time);
+			tx_rate[i] =3D rtw_get_current_tx_rate(adapter, bfee->mac_id);
+			RTW_INFO("%s: BFee idx(%d), MadId(%d), TxTP=3D%lld bytes (%d Mbps), txr=
ate=3D%d\n",
+				 __func__, i, bfee->mac_id, tx_bytes, tp[i], tx_rate[i]);
+		}
+	}
+
+	sounding_idx =3D phydm_get_beamforming_sounding_info(GET_PDM_ODM(adapter)=
, tp, MAX_BEAMFORMEE_ENTRY_NUM, tx_rate);
+
+	for (i =3D 0; i < MAX_BEAMFORMEE_ENTRY_NUM; i++) {
+		bfee =3D &info->bfee_entry[i];
+		if (false =3D=3D bfee->used) {
+			if (sounding_idx & BIT(i))
+				RTW_WARN("%s: bfee(%d) not in used but need sounding?!\n", __func__, i=
);
+			continue;
+		}
+
+		if (sounding_idx & BIT(i)) {
+			if (false =3D=3D bfee->bApplySounding) {
+				bfee->bApplySounding =3D true;
+				bfee->SoundCnt =3D 0;
+				set_timer =3D true;
+			}
+		} else {
+			if (bfee->bApplySounding) {
+				bfee->bApplySounding =3D false;
+				bfee->bDeleteSounding =3D true;
+				bfee->SoundCnt =3D 0;
+				set_timer =3D true;
+			}
+		}
+	}
+
+	if (set_timer) {
+		if (SOUNDING_STATE_NONE =3D=3D info->sounding_info.state) {
+			info->sounding_info.state =3D SOUNDING_STATE_INIT;
+			_set_timer(&info->sounding_timer, 0);
+		}
+	}
+}
