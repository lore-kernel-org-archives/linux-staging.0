+static int p2p_manager_disconnect(struct hostapd_data *hapd, u16 stype,
+				  u8 minor_reason_code, const u8 *addr)
+{
+	struct ieee80211_mgmt *mgmt;
+	int ret;
+	u8 *pos;
+
+	if (hapd->driver->send_frame =3D=3D NULL)
+		return -1;
+
+	mgmt =3D os_zalloc(sizeof(*mgmt) + 100);
+	if (mgmt =3D=3D NULL)
+		return -1;
+
+	wpa_printf(MSG_DEBUG, "P2P: Disconnect STA " MACSTR " with minor "
+		   "reason code %u (stype=3D%u)",
+		   MAC2STR(addr), minor_reason_code, stype);
+
+	mgmt->frame_control =3D IEEE80211_FC(WLAN_FC_TYPE_MGMT, stype);
+	os_memcpy(mgmt->da, addr, ETH_ALEN);
+	os_memcpy(mgmt->sa, hapd->own_addr, ETH_ALEN);
+	os_memcpy(mgmt->bssid, hapd->own_addr, ETH_ALEN);
+	if (stype =3D=3D WLAN_FC_STYPE_DEAUTH) {
+		mgmt->u.deauth.reason_code =3D
+			host_to_le16(WLAN_REASON_PREV_AUTH_NOT_VALID);
+		pos =3D (u8 *) (&mgmt->u.deauth.reason_code + 1);
+	} else {
+		mgmt->u.disassoc.reason_code =3D
+			host_to_le16(WLAN_REASON_PREV_AUTH_NOT_VALID);
+		pos =3D (u8 *) (&mgmt->u.disassoc.reason_code + 1);
+	}
+
+	*pos++ =3D WLAN_EID_VENDOR_SPECIFIC;
+	*pos++ =3D 4 + 3 + 1;
+	WPA_PUT_BE24(pos, OUI_WFA);
+	pos +=3D 3;
+	*pos++ =3D P2P_OUI_TYPE;
+
+	*pos++ =3D P2P_ATTR_MINOR_REASON_CODE;
+	WPA_PUT_LE16(pos, 1);
+	pos +=3D 2;
+	*pos++ =3D minor_reason_code;
+
+	ret =3D hapd->driver->send_frame(hapd->drv_priv, (u8 *) mgmt,
+				       pos - (u8 *) mgmt, 1);
+	os_free(mgmt);
+
+	return ret < 0 ? -1 : 0;
+}
