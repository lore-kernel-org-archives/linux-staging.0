+static void mlme_event_unprot_disconnect(struct wpa_driver_nl80211_data *d=
rv,
+					 enum wpa_event_type type,
+					 const u8 *frame, size_t len)
+{
+	const struct ieee80211_mgmt *mgmt;
+	union wpa_event_data event;
+	u16 reason_code =3D 0;
+
+	if (len < 24)
+		return;
+
+	mgmt =3D (const struct ieee80211_mgmt *) frame;
+
+	os_memset(&event, 0, sizeof(event));
+	/* Note: Same offset for Reason Code in both frame subtypes */
+	if (len >=3D 24 + sizeof(mgmt->u.deauth))
+		reason_code =3D le_to_host16(mgmt->u.deauth.reason_code);
+
+	if (type =3D=3D EVENT_UNPROT_DISASSOC) {
+		event.unprot_disassoc.sa =3D mgmt->sa;
+		event.unprot_disassoc.da =3D mgmt->da;
+		event.unprot_disassoc.reason_code =3D reason_code;
+	} else {
+		event.unprot_deauth.sa =3D mgmt->sa;
+		event.unprot_deauth.da =3D mgmt->da;
+		event.unprot_deauth.reason_code =3D reason_code;
