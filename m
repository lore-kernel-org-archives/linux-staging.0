+	tx_ra_bitmap =3D 0;
+
+	/* b/g mode ra_bitmap  */
+	for (i =3D 0; i < sizeof(psta->bssrateset); i++) {
+		if (psta->bssrateset[i])
+			tx_ra_bitmap |=3D rtw_get_bit_value_from_ieee_value(psta->bssrateset[i]=
 & 0x7f);
