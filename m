+static void
+phydm_set_csi_mask_reg(
+	void		*p_dm_void,
+	u32		tone_idx_tmp,
+	u8		tone_direction
+)
+{
+	struct PHY_DM_STRUCT	*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u8		byte_offset, bit_offset;
+	u32		target_reg;
+	u8		reg_tmp_value;
+	u32		tone_num =3D 64;
+	u32		tone_num_shift =3D 0;
+	u32		csi_mask_reg_p =3D 0, csi_mask_reg_n =3D 0;
+
+	/* calculate real tone idx*/
+	if ((tone_idx_tmp % 10) >=3D 5)
+		tone_idx_tmp +=3D 10;
+
+	tone_idx_tmp =3D (tone_idx_tmp / 10);
+
+	if (p_dm_odm->support_ic_type & ODM_IC_11N_SERIES) {
+
+		tone_num =3D 64;
+		csi_mask_reg_p =3D 0xD40;
+		csi_mask_reg_n =3D 0xD48;
+
+	} else if (p_dm_odm->support_ic_type & ODM_IC_11AC_SERIES) {
+
+		tone_num =3D 128;
+		csi_mask_reg_p =3D 0x880;
+		csi_mask_reg_n =3D 0x890;
+	}
+
+	if (tone_direction =3D=3D FREQ_POSITIVE) {
+
+		if (tone_idx_tmp >=3D (tone_num - 1))
+			tone_idx_tmp =3D (tone_num - 1);
+
+		byte_offset =3D (u8)(tone_idx_tmp >> 3);
+		bit_offset =3D (u8)(tone_idx_tmp & 0x7);
+		target_reg =3D csi_mask_reg_p + byte_offset;
+
+	} else {
+		tone_num_shift =3D tone_num;
+
+		if (tone_idx_tmp >=3D tone_num)
+			tone_idx_tmp =3D tone_num;
+
+		tone_idx_tmp =3D tone_num - tone_idx_tmp;
+
+		byte_offset =3D (u8)(tone_idx_tmp >> 3);
+		bit_offset =3D (u8)(tone_idx_tmp & 0x7);
+		target_reg =3D csi_mask_reg_n + byte_offset;
+	}
+
+	reg_tmp_value =3D odm_read_1byte(p_dm_odm, target_reg);
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("Pre Mask tone idx[%d=
]:  Reg0x%x =3D ((0x%x))\n", (tone_idx_tmp + tone_num_shift), target_reg, r=
eg_tmp_value));
+	reg_tmp_value |=3D BIT(bit_offset);
+	odm_write_1byte(p_dm_odm, target_reg, reg_tmp_value);
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_API, ODM_DBG_LOUD, ("New Mask tone idx[%d=
]:  Reg0x%x =3D ((0x%x))\n", (tone_idx_tmp + tone_num_shift), target_reg, r=
eg_tmp_value));
+}
