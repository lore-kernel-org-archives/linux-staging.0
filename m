+int rtw_select_and_join_from_scanned_queue(struct mlme_priv *pmlmepriv)
+{
+	unsigned long	irqL;
+	int ret;
+	_list	*phead;
+	_adapter *adapter;
+	_queue	*queue	=3D &(pmlmepriv->scanned_queue);
+	struct	wlan_network	*pnetwork =3D NULL;
