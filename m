+static int rtw_wx_get_enc(struct net_device *dev,
+			  struct iw_request_info *info,
+			  union iwreq_data *wrqu, char *keybuf)
+{
+	uint key, ret =3D 0;
+	_adapter *padapter =3D (_adapter *)rtw_netdev_priv(dev);
+	struct iw_point *erq =3D &(wrqu->encoding);
+	struct	mlme_priv	*pmlmepriv =3D &(padapter->mlmepriv);
+
+
+	if (check_fwstate(pmlmepriv, _FW_LINKED) !=3D true) {
+		if (check_fwstate(pmlmepriv, WIFI_ADHOC_MASTER_STATE) !=3D true) {
+			erq->length =3D 0;
+			erq->flags |=3D IW_ENCODE_DISABLED;
+			return 0;
+		}
+	}
+
+
+	key =3D erq->flags & IW_ENCODE_INDEX;
+
+	if (key) {
+		if (key > WEP_KEYS)
+			return -EINVAL;
+		key--;
+	} else
+		key =3D padapter->securitypriv.dot11PrivacyKeyIndex;
+
+	erq->flags =3D key + 1;
+
+	/* if(padapter->securitypriv.ndisauthtype =3D=3D Ndis802_11AuthModeOpen) =
*/
+	/* { */
+	/* erq->flags |=3D IW_ENCODE_OPEN; */
+	/* }	  */
+
+	switch (padapter->securitypriv.ndisencryptstatus) {
+	case Ndis802_11EncryptionNotSupported:
+	case Ndis802_11EncryptionDisabled:
+
+		erq->length =3D 0;
+		erq->flags |=3D IW_ENCODE_DISABLED;
+
+		break;
+
+	case Ndis802_11Encryption1Enabled:
+
+		erq->length =3D padapter->securitypriv.dot11DefKeylen[key];
+
+		if (erq->length) {
+			memcpy(keybuf, padapter->securitypriv.dot11DefKey[key].skey, padapter->=
securitypriv.dot11DefKeylen[key]);
+
+			erq->flags |=3D IW_ENCODE_ENABLED;
+
+			if (padapter->securitypriv.ndisauthtype =3D=3D Ndis802_11AuthModeOpen)
+				erq->flags |=3D IW_ENCODE_OPEN;
