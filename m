+static unsigned int on_action_spct_ch_switch(_adapter *padapter, struct st=
a_info *psta, u8 *ies, uint ies_len)
+{
+	unsigned int ret =3D _FAIL;
+	struct mlme_ext_priv *mlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(mlmeext->mlmext_info);
+
+	if (!(pmlmeinfo->state & WIFI_FW_ASSOC_SUCCESS)) {
+		ret =3D _SUCCESS;
+		goto exit;
+	}
+
+	if ((pmlmeinfo->state & 0x03) =3D=3D WIFI_FW_STATION_STATE) {
+
+		int ch_switch_mode =3D -1, ch =3D -1, ch_switch_cnt =3D -1;
+		int ch_offset =3D -1;
+		u8 bwmode;
+		struct ieee80211_info_element *ie;
+
+		RTW_INFO(FUNC_NDEV_FMT" from "MAC_FMT"\n",
+			FUNC_NDEV_ARG(padapter->pnetdev), MAC_ARG(psta->hwaddr));
+
+		for_each_ie(ie, ies, ies_len) {
+			if (ie->id =3D=3D WLAN_EID_CHANNEL_SWITCH) {
+				ch_switch_mode =3D ie->data[0];
+				ch =3D ie->data[1];
+				ch_switch_cnt =3D ie->data[2];
+				RTW_INFO("ch_switch_mode:%d, ch:%d, ch_switch_cnt:%d\n",
+					 ch_switch_mode, ch, ch_switch_cnt);
+			} else if (ie->id =3D=3D WLAN_EID_SECONDARY_CHANNEL_OFFSET) {
+				ch_offset =3D secondary_ch_offset_to_hal_ch_offset(ie->data[0]);
+				RTW_INFO("ch_offset:%d\n", ch_offset);
+			}
+		}
+
+		if (ch =3D=3D -1)
+			return _SUCCESS;
+
+		if (ch_offset =3D=3D -1)
+			bwmode =3D mlmeext->cur_bwmode;
+		else
+			bwmode =3D (ch_offset =3D=3D HAL_PRIME_CHNL_OFFSET_DONT_CARE) ?
+				 CHANNEL_WIDTH_20 : CHANNEL_WIDTH_40;
+
+		ch_offset =3D (ch_offset =3D=3D -1) ? mlmeext->cur_ch_offset : ch_offset;
+
+		/* todo:
+		 * 1. the decision of channel switching
+		 * 2. things after channel switching
+		 */
+
+		ret =3D rtw_set_ch_cmd(padapter, ch, bwmode, ch_offset, true);
+	}
+
+exit:
+	return ret;
+}
