+static u8 init_channel_set(_adapter *padapter, u8 ChannelPlan, RT_CHANNEL_=
INFO *channel_set)
+{
+	struct registry_priv *regsty =3D adapter_to_regsty(padapter);
+	u8	index, chanset_size =3D 0;
+	u8	b5GBand =3D false, b2_4GBand =3D false;
+	u8	Index2G =3D 0, Index5G =3D 0;
+	HAL_DATA_TYPE *hal_data =3D GET_HAL_DATA(padapter);
+	int i;
+
+	if (!rtw_is_channel_plan_valid(ChannelPlan)) {
+		RTW_ERR("ChannelPlan ID 0x%02X error !!!!!\n", ChannelPlan);
+		return chanset_size;
+	}
+
+	memset(channel_set, 0, sizeof(RT_CHANNEL_INFO) * MAX_CHANNEL_NUM);
+
+	if (IsSupported24G(padapter->registrypriv.wireless_mode))
+		b2_4GBand =3D true;
+
+	if (is_supported_5g(padapter->registrypriv.wireless_mode))
+		b5GBand =3D true;
+
+	if (b2_4GBand) {
+		if (RTW_CHPLAN_REALTEK_DEFINE =3D=3D ChannelPlan)
+			Index2G =3D RTW_CHANNEL_PLAN_MAP_REALTEK_DEFINE.Index2G;
+		else
+			Index2G =3D RTW_ChannelPlanMap[ChannelPlan].Index2G;
+
+		for (index =3D 0; index < CH_LIST_LEN(RTW_ChannelPlan2G[Index2G]); index=
++) {
+			if (rtw_regsty_is_excl_chs(regsty, CH_LIST_CH(RTW_ChannelPlan2G[Index2G=
], index)))
+				continue;
+
+			channel_set[chanset_size].ChannelNum =3D CH_LIST_CH(RTW_ChannelPlan2G[I=
ndex2G], index);
+
+			if (RTW_CHPLAN_GLOBAL_DOAMIN =3D=3D ChannelPlan
+				|| RTW_CHPLAN_GLOBAL_NULL =3D=3D ChannelPlan
+			) {
+				/* Channel 1~11 is active, and 12~14 is passive */
+				if (channel_set[chanset_size].ChannelNum >=3D 1 && channel_set[chanset=
_size].ChannelNum <=3D 11)
+					channel_set[chanset_size].ScanType =3D SCAN_ACTIVE;
+				else if ((channel_set[chanset_size].ChannelNum  >=3D 12 && channel_set=
[chanset_size].ChannelNum  <=3D 14))
+					channel_set[chanset_size].ScanType  =3D SCAN_PASSIVE;
+			} else if (RTW_CHPLAN_WORLD_WIDE_13 =3D=3D ChannelPlan
+				|| RTW_CHPLAN_WORLD_WIDE_5G =3D=3D ChannelPlan
+				|| RTW_RD_2G_WORLD =3D=3D Index2G
+			) {
+				/* channel 12~13, passive scan */
+				if (channel_set[chanset_size].ChannelNum <=3D 11)
+					channel_set[chanset_size].ScanType =3D SCAN_ACTIVE;
+				else
+					channel_set[chanset_size].ScanType =3D SCAN_PASSIVE;
+			} else
+				channel_set[chanset_size].ScanType =3D SCAN_ACTIVE;
+
+			chanset_size++;
+		}
+	}
+
+#ifdef CONFIG_IEEE80211_BAND_5GHZ
+	if (b5GBand) {
+		if (RTW_CHPLAN_REALTEK_DEFINE =3D=3D ChannelPlan)
+			Index5G =3D RTW_CHANNEL_PLAN_MAP_REALTEK_DEFINE.Index5G;
+		else
+			Index5G =3D RTW_ChannelPlanMap[ChannelPlan].Index5G;
+
+		for (index =3D 0; index < CH_LIST_LEN(RTW_ChannelPlan5G[Index5G]); index=
++) {
+			if (rtw_regsty_is_excl_chs(regsty, CH_LIST_CH(RTW_ChannelPlan5G[Index5G=
], index)))
+				continue;
+#ifdef CONFIG_DFS
+			channel_set[chanset_size].ChannelNum =3D CH_LIST_CH(RTW_ChannelPlan5G[I=
ndex5G], index);
+			if (channel_set[chanset_size].ChannelNum <=3D 48
+				|| channel_set[chanset_size].ChannelNum >=3D 149
+			) {
+				if (RTW_CHPLAN_WORLD_WIDE_5G =3D=3D ChannelPlan) /* passive scan for a=
ll 5G channels */
+					channel_set[chanset_size].ScanType =3D SCAN_PASSIVE;
+				else
+					channel_set[chanset_size].ScanType =3D SCAN_ACTIVE;
+			} else
+				channel_set[chanset_size].ScanType =3D SCAN_PASSIVE;
+			chanset_size++;
+#else /* CONFIG_DFS */
+			if (CH_LIST_CH(RTW_ChannelPlan5G[Index5G], index) <=3D 48
+				|| CH_LIST_CH(RTW_ChannelPlan5G[Index5G], index) >=3D 149
+			) {
+				channel_set[chanset_size].ChannelNum =3D CH_LIST_CH(RTW_ChannelPlan5G[=
Index5G], index);
+				if (RTW_CHPLAN_WORLD_WIDE_5G =3D=3D ChannelPlan) /* passive scan for a=
ll 5G channels */
+					channel_set[chanset_size].ScanType =3D SCAN_PASSIVE;
+				else
+					channel_set[chanset_size].ScanType =3D SCAN_ACTIVE;
+				chanset_size++;
+			}
+#endif /* CONFIG_DFS */
+		}
+	}
+
+	#ifdef CONFIG_DFS_MASTER
+	for (i =3D 0; i < chanset_size; i++)
+		channel_set[i].non_ocp_end_time =3D jiffies;
+	#endif
+#endif /* CONFIG_IEEE80211_BAND_5GHZ */
+
+	if (RTW_CHPLAN_REALTEK_DEFINE =3D=3D ChannelPlan) {
+		hal_data->Regulation2_4G =3D RTW_CHANNEL_PLAN_MAP_REALTEK_DEFINE.regd;
+		hal_data->Regulation5G =3D RTW_CHANNEL_PLAN_MAP_REALTEK_DEFINE.regd;
+	} else {
+		hal_data->Regulation2_4G =3D RTW_ChannelPlanMap[ChannelPlan].regd;
+		hal_data->Regulation5G =3D RTW_ChannelPlanMap[ChannelPlan].regd;
+	}
+
+	RTW_INFO(FUNC_ADPT_FMT" ChannelPlan ID:0x%02x, ch num:%d\n"
+		, FUNC_ADPT_ARG(padapter), ChannelPlan, chanset_size);
+
+	return chanset_size;
+}
