+static void fill_tx_desc_8188e(PADAPTER padapter)
+{
+	struct mp_priv *pmp_priv =3D &padapter->mppriv;
+	struct tx_desc *desc   =3D (struct tx_desc *)&(pmp_priv->tx.desc);
+	struct pkt_attrib *pattrib =3D &(pmp_priv->tx.attrib);
+	u32	pkt_size =3D pattrib->last_txcmdsz;
+	s32 bmcast =3D IS_MCAST(pattrib->ra);
+	/* offset 0 */
+	desc->txdw0 |=3D cpu_to_le32(OWN | FSG | LSG);
+	desc->txdw0 |=3D cpu_to_le32(pkt_size & 0x0000FFFF); /* packet size */
+	desc->txdw0 |=3D cpu_to_le32(((TXDESC_SIZE + OFFSET_SZ) << OFFSET_SHT) & =
0x00FF0000); /* 32 bytes for TX Desc */
+	if (bmcast)
+		desc->txdw0 |=3D cpu_to_le32(BMC); /* broadcast packet */
+
+	desc->txdw1 |=3D cpu_to_le32((0x01 << 26) & 0xff000000);
+
+	desc->txdw1 |=3D cpu_to_le32((pattrib->mac_id) & 0x3F); /* CAM_ID(MAC_ID)=
 */
+	desc->txdw1 |=3D cpu_to_le32((pattrib->qsel << QSEL_SHT) & 0x00001F00); /=
* Queue Select, TID */
+	desc->txdw1 |=3D cpu_to_le32((pattrib->raid << RATE_ID_SHT) & 0x000F0000)=
; /* Rate Adaptive ID */
+	/* offset 8 */
+	/* desc->txdw2 |=3D cpu_to_le32(AGG_BK); */ /* AGG BK */
+
+	desc->txdw3 |=3D cpu_to_le32((pattrib->seqnum << 16) & 0x0fff0000);
+	desc->txdw4 |=3D cpu_to_le32(HW_SSN);
+
+	desc->txdw4 |=3D cpu_to_le32(USERATE);
+	desc->txdw4 |=3D cpu_to_le32(DISDATAFB);
+
+	if (pmp_priv->preamble) {
+		if (HwRateToMPTRate(pmp_priv->rateidx) <=3D  MPT_RATE_54M)
+			desc->txdw4 |=3D cpu_to_le32(DATA_SHORT); /* CCK Short Preamble */
+	}
+
+	if (pmp_priv->bandwidth =3D=3D CHANNEL_WIDTH_40)
+		desc->txdw4 |=3D cpu_to_le32(DATA_BW);
+
+	/* offset 20 */
+	desc->txdw5 |=3D cpu_to_le32(pmp_priv->rateidx & 0x0000001F);
+
+	if (pmp_priv->preamble) {
+		if (HwRateToMPTRate(pmp_priv->rateidx) > MPT_RATE_54M)
+			desc->txdw5 |=3D cpu_to_le32(SGI); /* MCS Short Guard Interval */
+	}
+
+	desc->txdw5 |=3D cpu_to_le32(RTY_LMT_EN); /* retry limit enable */
+	desc->txdw5 |=3D cpu_to_le32(0x00180000); /* DATA/RTS Rate Fallback Limit=
	 */
+
+
+}
