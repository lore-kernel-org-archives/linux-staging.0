+	else
+		allowed_bw =3D REGSTY_BW_5G(regsty);
+
+	allowed_bw =3D hal_largest_bw(adapter, allowed_bw);
+
+	if (allowed_bw =3D=3D CHANNEL_WIDTH_80 && *req_bw > CHANNEL_WIDTH_80)
+		*req_bw =3D CHANNEL_WIDTH_80;
+	else if (allowed_bw =3D=3D CHANNEL_WIDTH_40 && *req_bw > CHANNEL_WIDTH_40)
+		*req_bw =3D CHANNEL_WIDTH_40;
+	else if (allowed_bw =3D=3D CHANNEL_WIDTH_20 && *req_bw > CHANNEL_WIDTH_20=
) {
+		*req_bw =3D CHANNEL_WIDTH_20;
+		*req_offset =3D HAL_PRIME_CHNL_OFFSET_DONT_CARE;
+	} else
