+static void _get_txvector_parameter(PADAPTER adapter, struct sta_info *sta=
, u8 *g_id, u16 *p_aid)
+{
+	struct mlme_priv *mlme;
+	u16 aid;
+	u8 *bssid;
+	u16 val16;
+	u8 i;
+
+
+	mlme =3D &adapter->mlmepriv;
+
+	if (check_fwstate(mlme, WIFI_AP_STATE)) {
+		/*
+		 * Sent by an AP and addressed to a STA associated with that AP
+		 * or sent by a DLS or TDLS STA in a direct path to
+		 * a DLS or TDLS peer STA
+		 */
+
+		aid =3D sta->aid;
+		bssid =3D adapter_mac_addr(adapter);
+		RTW_INFO("%s: AID=3D0x%x BSSID=3D" MAC_FMT "\n",
+			 __func__, sta->aid, MAC_ARG(bssid));
+
+		/* AID[0:8] */
+		aid &=3D 0x1FF;
+		/* BSSID[44:47] xor BSSID[40:43] */
+		val16 =3D ((bssid[5] & 0xF0) >> 4) ^ (bssid[5] & 0xF);
+		/* (dec(AID[0:8]) + dec(BSSID)*2^5) mod 2^9 */
+		*p_aid =3D (aid + (val16 << 5)) & 0x1FF;
+		*g_id =3D 63;
+	} else if ((check_fwstate(mlme, WIFI_ADHOC_STATE) =3D=3D true)
+		   || (check_fwstate(mlme, WIFI_ADHOC_MASTER_STATE) =3D=3D true)) {
+		/*
+		 * Otherwise, includes
+		 * 1. Sent to an IBSS STA
+		 * 2. Sent by an AP to a non associated STA
+		 * 3. Sent to a STA for which it is not known
+		 *    which condition is applicable
+		 */
+		*p_aid =3D 0;
+		*g_id =3D 63;
+	} else {
+		/* Addressed to AP */
+		bssid =3D sta->hwaddr;
+		RTW_INFO("%s: BSSID=3D" MAC_FMT "\n", __func__, MAC_ARG(bssid));
+
+		/* BSSID[39:47] */
+		*p_aid =3D (bssid[5] << 1) | (bssid[4] >> 7);
+		*g_id =3D 0;
+	}
+
+	RTW_INFO("%s: GROUP_ID=3D0x%02x PARTIAL_AID=3D0x%04x\n",
+		 __func__, *g_id, *p_aid);
+}
