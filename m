+#endif /* CONFIG_P2P */
+
+	if (bssid->IELength < 12)
+		return _FAIL;
+
+	/* Checking for DSConfig */
+	p =3D rtw_get_ie(bssid->IEs + ie_offset, _DSSET_IE_, &len, bssid->IELengt=
h - ie_offset);
+
+	bssid->Configuration.DSConfig =3D 0;
+	bssid->Configuration.Length =3D 0;
+
+	if (p)
+		bssid->Configuration.DSConfig =3D *(p + 2);
+	else {
+		/* In 5G, some ap do not have DSSET IE */
+		/* checking HT info for channel */
+		p =3D rtw_get_ie(bssid->IEs + ie_offset, _HT_ADD_INFO_IE_, &len, bssid->=
IELength - ie_offset);
+		if (p) {
+			struct HT_info_element *HT_info =3D (struct HT_info_element *)(p + 2);
+			bssid->Configuration.DSConfig =3D HT_info->primary_channel;
+		} else {
+			/* use current channel */
+			bssid->Configuration.DSConfig =3D rtw_get_oper_ch(padapter);
+		}
+	}
+
+	memcpy(&bssid->Configuration.BeaconPeriod, rtw_get_beacon_interval_from_i=
e(bssid->IEs), 2);
+
+	val16 =3D rtw_get_capability((WLAN_BSSID_EX *)bssid);
+
+	if (val16 & BIT(0)) {
+		bssid->InfrastructureMode =3D Ndis802_11Infrastructure;
+		memcpy(bssid->MacAddress, get_addr2_ptr(pframe), ETH_ALEN);
+	} else {
+		bssid->InfrastructureMode =3D Ndis802_11IBSS;
+		memcpy(bssid->MacAddress, GetAddr3Ptr(pframe), ETH_ALEN);
+	}
+
+	if (val16 & BIT(4))
+		bssid->Privacy =3D 1;
+	else
+		bssid->Privacy =3D 0;
+
+	bssid->Configuration.ATIMWindow =3D 0;
+
+	/* 20/40 BSS Coexistence check */
+	if ((pregistrypriv->wifi_spec =3D=3D 1) && (false =3D=3D pmlmeinfo->bwmod=
e_updated)) {
+		struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+		p =3D rtw_get_ie(bssid->IEs + ie_offset, _HT_CAPABILITY_IE_, &len, bssid=
->IELength - ie_offset);
+		if (p && len > 0) {
+			struct HT_caps_element	*pHT_caps;
+			pHT_caps =3D (struct HT_caps_element *)(p + 2);
+
+			if (pHT_caps->u.HT_cap_element.HT_caps_info & cpu_to_le16(BIT(14)))
+				pmlmepriv->num_FortyMHzIntolerant++;
+		} else
+			pmlmepriv->num_sta_no_ht++;
+	}
+
+#ifdef CONFIG_INTEL_WIDI
+	/* process_intel_widi_query_or_tigger(padapter, bssid); */
+	if (process_intel_widi_query_or_tigger(padapter, bssid))
+		return _FAIL;
+#endif /* CONFIG_INTEL_WIDI */
+
+#if defined(DBG_RX_SIGNAL_DISPLAY_SSID_MONITORED) & 1
+	if (strcmp(bssid->Ssid.Ssid, DBG_RX_SIGNAL_DISPLAY_SSID_MONITORED) =3D=3D=
 0) {
+		RTW_INFO("Receiving %s("MAC_FMT", DSConfig:%u) from ch%u with ss:%3u, sq=
:%3u, RawRSSI:%3ld\n"
+			, bssid->Ssid.Ssid, MAC_ARG(bssid->MacAddress), bssid->Configuration.DS=
Config
+			 , rtw_get_oper_ch(padapter)
+			, bssid->PhyInfo.SignalStrength, bssid->PhyInfo.SignalQuality, bssid->R=
ssi
+			);
+	}
+#endif
+
+	/* mark bss info receving from nearby channel as SignalQuality 101 */
+	if (bssid->Configuration.DSConfig !=3D rtw_get_oper_ch(padapter))
+		bssid->PhyInfo.SignalQuality =3D 101;
+
+	return _SUCCESS;
+}
