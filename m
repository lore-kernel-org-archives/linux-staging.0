+void odm_ra_tx_rpt2_handle_8188e(struct PHY_DM_STRUCT *p_dm_odm,
+				 u8 *tx_rpt_buf, __le16 tx_rpt_len,
+				 u32 mac_id_valid_entry0,
+				 u32 mac_id_valid_entry1)
+{
+	struct _odm_ra_info_ *p_ra_info =3D NULL;
+	u8 mac_id =3D 0;
+	u8 *p_buffer =3D NULL;
+	u32			valid =3D 0, item_num =3D 0;
+	u16 min_rpt_time =3D 0x927c;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RATE_ADAPTIVE, ODM_DBG_LOUD, ("=3D=3D=3D=
=3D=3D>odm_ra_tx_rpt2_handle_8188e(): valid0=3D%d valid1=3D%d BufferLength=
=3D%d\n",
+			mac_id_valid_entry0, mac_id_valid_entry1, tx_rpt_len));
+
+	item_num =3D le16_to_cpu(tx_rpt_len) >> 3;
+	p_buffer =3D tx_rpt_buf;
+
+	do {
+		valid =3D 0;
+		if (mac_id < 32)
+			valid =3D (1 << mac_id) & mac_id_valid_entry0;
+		else if (mac_id < 64)
+			valid =3D (1 << (mac_id - 32)) & mac_id_valid_entry1;
+
+		p_ra_info =3D &(p_dm_odm->ra_info[mac_id]);
+		if (valid) {
+			p_ra_info->RTY[0] =3D (u16)GET_TX_REPORT_TYPE1_RERTY_0(p_buffer);
+			p_ra_info->RTY[1] =3D (u16)GET_TX_REPORT_TYPE1_RERTY_1(p_buffer);
+			p_ra_info->RTY[2] =3D (u16)GET_TX_REPORT_TYPE1_RERTY_2(p_buffer);
+			p_ra_info->RTY[3] =3D (u16)GET_TX_REPORT_TYPE1_RERTY_3(p_buffer);
+			p_ra_info->RTY[4] =3D (u16)GET_TX_REPORT_TYPE1_RERTY_4(p_buffer);
+			p_ra_info->DROP =3D (u16)GET_TX_REPORT_TYPE1_DROP_0(p_buffer);
+
+			p_ra_info->TOTAL =3D p_ra_info->RTY[0] + \
+					   p_ra_info->RTY[1] + \
+					   p_ra_info->RTY[2] + \
+					   p_ra_info->RTY[3] + \
+					   p_ra_info->RTY[4] + \
+					   p_ra_info->DROP;
+#if defined(TXRETRY_CNT)
+			extern struct stat_info *get_macidinfo(struct rtl8192cd_priv *priv, uns=
igned int aid);
+
+			{
+				struct stat_info *pstat =3D get_macidinfo(p_dm_odm->priv, mac_id);
+				if (pstat) {
+					pstat->cur_tx_ok +=3D p_ra_info->RTY[0];
+					pstat->cur_tx_retry_pkts +=3D p_ra_info->RTY[1] + p_ra_info->RTY[2] +=
 p_ra_info->RTY[3] + p_ra_info->RTY[4];
+					pstat->cur_tx_retry_cnt +=3D p_ra_info->RTY[1] + p_ra_info->RTY[2] * =
2 + p_ra_info->RTY[3] * 3 + p_ra_info->RTY[4] * 4;
+					pstat->total_tx_retry_cnt +=3D pstat->cur_tx_retry_cnt;
+					pstat->total_tx_retry_pkts +=3D pstat->cur_tx_retry_pkts;
+					pstat->cur_tx_fail +=3D p_ra_info->DROP;
+				}
+			}
+#endif
+			if (p_ra_info->TOTAL !=3D 0) {
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_RATE_ADAPTIVE, ODM_DBG_LOUD,
+					("macid=3D%d Total=3D%d R0=3D%d R1=3D%d R2=3D%d R3=3D%d R4=3D%d D0=3D=
%d valid0=3D%x valid1=3D%x\n",
+					      mac_id,
+					      p_ra_info->TOTAL,
+					      p_ra_info->RTY[0],
+					      p_ra_info->RTY[1],
+					      p_ra_info->RTY[2],
+					      p_ra_info->RTY[3],
+					      p_ra_info->RTY[4],
+					      p_ra_info->DROP,
+					      mac_id_valid_entry0,
+					      mac_id_valid_entry1));
+#if POWER_TRAINING_ACTIVE =3D=3D 1
+				if (p_ra_info->pt_active) {
+					if (p_ra_info->ra_stage < 5)
+						odm_rate_decision_8188e(p_dm_odm, p_ra_info);
+					else if (p_ra_info->ra_stage =3D=3D 5) /* Power training try state */
+						odm_pt_try_state_8188e(p_dm_odm, p_ra_info);
+					else  /* ra_stage=3D=3D6 */
+						odm_pt_decision_8188e(p_ra_info);
+
+					/* Stage_RA counter */
+					if (p_ra_info->ra_stage <=3D 5)
+						p_ra_info->ra_stage++;
+					else
+						p_ra_info->ra_stage =3D 0;
+				} else
+					odm_rate_decision_8188e(p_dm_odm, p_ra_info);
+#else
+				odm_rate_decision_8188e(p_dm_odm, p_ra_info);
+#endif
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_INIT, ODM_DBG_LOUD,
+					("macid=3D%d R0=3D%d R1=3D%d R2=3D%d R3=3D%d R4=3D%d drop=3D%d valid0=
=3D%x rate_id=3D%d SGI=3D%d\n",
+					      mac_id,
+					      p_ra_info->RTY[0],
+					      p_ra_info->RTY[1],
+					      p_ra_info->RTY[2],
+					      p_ra_info->RTY[3],
+					      p_ra_info->RTY[4],
+					      p_ra_info->DROP,
+					      mac_id_valid_entry0,
+					      p_ra_info->decision_rate,
+					      p_ra_info->rate_sgi));
+			} else
+				ODM_RT_TRACE(p_dm_odm, ODM_COMP_RATE_ADAPTIVE, ODM_DBG_LOUD, (" TOTAL=
=3D0!!!!\n"));
+		}
+
+		if (min_rpt_time > p_ra_info->rpt_time)
+			min_rpt_time =3D p_ra_info->rpt_time;
+
+		p_buffer +=3D TX_RPT2_ITEM_SIZE;
+		mac_id++;
+	} while (mac_id < item_num);
+
+	odm_ra_tx_rpt_timer_setting(p_dm_odm, min_rpt_time);
+
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RATE_ADAPTIVE, ODM_DBG_LOUD, ("<=3D=3D=3D=
=3D=3D odm_ra_tx_rpt2_handle_8188e()\n"));
+}
+
+#else
