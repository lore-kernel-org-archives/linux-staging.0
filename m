+/**
+ * wpa_driver_wext_init - Initialize WE driver interface
+ * @ctx: context to be used when calling wpa_supplicant functions,
+ * e.g., wpa_supplicant_event()
+ * @ifname: interface name, e.g., wlan0
+ * Returns: Pointer to private data, %NULL on failure
+ */
+void * wpa_driver_wext_init(void *ctx, const char *ifname)
+{
+	struct wpa_driver_wext_data *drv;
+	struct netlink_config *cfg;
+	struct rfkill_config *rcfg;
+	char path[128];
+	struct stat buf;
+
+	drv =3D os_zalloc(sizeof(*drv));
+	if (drv =3D=3D NULL)
+		return NULL;
+	drv->ctx =3D ctx;
+	os_strlcpy(drv->ifname, ifname, sizeof(drv->ifname));
+
+	os_snprintf(path, sizeof(path), "/sys/class/net/%s/phy80211", ifname);
+	if (stat(path, &buf) =3D=3D 0) {
+		wpa_printf(MSG_DEBUG, "WEXT: cfg80211-based driver detected");
+		drv->cfg80211 =3D 1;
+		wext_get_phy_name(drv);
+	}
+
+	drv->ioctl_sock =3D socket(PF_INET, SOCK_DGRAM, 0);
+	if (drv->ioctl_sock < 0) {
+		perror("socket(PF_INET,SOCK_DGRAM)");
+		goto err1;
+	}
+
+	cfg =3D os_zalloc(sizeof(*cfg));
+	if (cfg =3D=3D NULL)
+		goto err1;
+	cfg->ctx =3D drv;
+	cfg->newlink_cb =3D wpa_driver_wext_event_rtm_newlink;
+	cfg->dellink_cb =3D wpa_driver_wext_event_rtm_dellink;
+	drv->netlink =3D netlink_init(cfg);
+	if (drv->netlink =3D=3D NULL) {
+		os_free(cfg);
+		goto err2;
+	}
+
+	rcfg =3D os_zalloc(sizeof(*rcfg));
+	if (rcfg =3D=3D NULL)
+		goto err3;
+	rcfg->ctx =3D drv;
+	os_strlcpy(rcfg->ifname, ifname, sizeof(rcfg->ifname));
+	rcfg->blocked_cb =3D wpa_driver_wext_rfkill_blocked;
+	rcfg->unblocked_cb =3D wpa_driver_wext_rfkill_unblocked;
+	drv->rfkill =3D rfkill_init(rcfg);
+	if (drv->rfkill =3D=3D NULL) {
+		wpa_printf(MSG_DEBUG, "WEXT: RFKILL status not available");
+		os_free(rcfg);
+	}
+
+	drv->mlme_sock =3D -1;
+
+	if (wpa_driver_wext_finish_drv_init(drv) < 0)
+		goto err3;
+
+	wpa_driver_wext_set_auth_param(drv, IW_AUTH_WPA_ENABLED, 1);
+
+	return drv;
+
+err3:
+	rfkill_deinit(drv->rfkill);
+	netlink_deinit(drv->netlink);
+err2:
+	close(drv->ioctl_sock);
+err1:
