+static void init_channel_list(_adapter *padapter, RT_CHANNEL_INFO *channel=
_set,
+			      u8 chanset_size,
+			      struct p2p_channels *channel_list)
+{
+	struct registry_priv *regsty =3D adapter_to_regsty(padapter);
+
+	struct p2p_oper_class_map op_class[] =3D {
+		{ IEEE80211G,  81,   1,  13,  1, BW20 },
+		{ IEEE80211G,  82,  14,  14,  1, BW20 },
+		{ IEEE80211A, 115,  36,  48,  4, BW20 },
+		{ IEEE80211A, 116,  36,  44,  8, BW40PLUS },
+		{ IEEE80211A, 117,  40,  48,  8, BW40MINUS },
+		{ IEEE80211A, 124, 149, 161,  4, BW20 },
+		{ IEEE80211A, 125, 149, 169,  4, BW20 },
+		{ IEEE80211A, 126, 149, 157,  8, BW40PLUS },
+		{ IEEE80211A, 127, 153, 161,  8, BW40MINUS },
+		{ -1, 0, 0, 0, 0, BW20 }
+	};
+
+	int cla, op;
+
+	cla =3D 0;
+
+	for (op =3D 0; op_class[op].op_class; op++) {
+		u8 ch;
+		struct p2p_oper_class_map *o =3D &op_class[op];
+		struct p2p_reg_class *reg =3D NULL;
+
+		for (ch =3D o->min_chan; ch <=3D o->max_chan; ch +=3D o->inc) {
+			if (!has_channel(channel_set, chanset_size, ch))
+				continue;
+
+			if ((0 =3D=3D padapter->registrypriv.ht_enable) && (8 =3D=3D o->inc))
+				continue;
+
+			if ((REGSTY_IS_BW_5G_SUPPORT(regsty, CHANNEL_WIDTH_40)) &&
+			    ((BW40MINUS =3D=3D o->bw) || (BW40PLUS =3D=3D o->bw)))
+				continue;
+
+			if (reg =3D=3D NULL) {
+				reg =3D &channel_list->reg_class[cla];
+				cla++;
+				reg->reg_class =3D o->op_class;
+				reg->channels =3D 0;
+			}
+			reg->channel[reg->channels] =3D ch;
+			reg->channels++;
+		}
+	}
+	channel_list->reg_classes =3D cla;
+
+}
