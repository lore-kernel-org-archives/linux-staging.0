+void rtw_reordering_ctrl_timeout_handler(void *pcontext)
+{
+	unsigned long irql;
+	struct recv_reorder_ctrl *preorder_ctrl =3D (struct recv_reorder_ctrl *)p=
context;
+	_adapter *padapter =3D preorder_ctrl->padapter;
+	_queue *ppending_recvframe_queue =3D &preorder_ctrl->pending_recvframe_qu=
eue;
+
+
+	if (RTW_CANNOT_RUN(padapter))
+		return;
+
+	/* RTW_INFO("+rtw_reordering_ctrl_timeout_handler()=3D>\n"); */
+
+	_enter_critical_bh(&ppending_recvframe_queue->lock, &irql);
