+/*
+* rtw_get_cur_max_rate -
+* @adapter: pointer to _adapter structure
+*
+* Return 0 or 100Kbps
+*/
+u16 rtw_get_cur_max_rate(_adapter *adapter)
+{
+	int	i =3D 0;
+	u16	rate =3D 0, max_rate =3D 0;
+	struct mlme_priv	*pmlmepriv =3D &adapter->mlmepriv;
+	WLAN_BSSID_EX	*pcur_bss =3D &pmlmepriv->cur_network.network;
+	struct sta_info *psta =3D NULL;
+	u8	short_GI =3D 0;
+	u8	rf_type =3D 0;
+
+#ifdef CONFIG_MP_INCLUDED
+	if (adapter->registrypriv.mp_mode =3D=3D 1) {
+		if (check_fwstate(pmlmepriv, WIFI_MP_STATE) )
+			return 0;
+	}
+#endif
+
+	if ((check_fwstate(pmlmepriv, _FW_LINKED) !=3D true)
+	    && (check_fwstate(pmlmepriv, WIFI_ADHOC_MASTER_STATE) !=3D true))
+		return 0;
+
+	psta =3D rtw_get_stainfo(&adapter->stapriv, get_bssid(pmlmepriv));
+	if (psta =3D=3D NULL)
+		return 0;
+
+	short_GI =3D query_ra_short_GI(psta, psta->bw_mode);
+
+	if (is_supported_ht(psta->wireless_mode)) {
+		rtw_hal_get_hwreg(adapter, HW_VAR_RF_TYPE, (u8 *)(&rf_type));
+		max_rate =3D rtw_mcs_rate(rf_type
+			, (psta->bw_mode =3D=3D CHANNEL_WIDTH_40) ? 1 : 0
+			, short_GI
+			, psta->htpriv.ht_cap.supp_mcs_set
+		);
+	} else {
+		while ((pcur_bss->SupportedRates[i] !=3D 0) && (pcur_bss->SupportedRates=
[i] !=3D 0xFF)) {
+			rate =3D pcur_bss->SupportedRates[i] & 0x7F;
+			if (rate > max_rate)
+				max_rate =3D rate;
+			i++;
+		}
+
+		max_rate =3D max_rate * 10 / 2;
+	}
+
+	return max_rate;
+}
