+static u8 sitesurvey_pick_ch_behavior(_adapter *padapter, u8 *ch, RT_SCAN_=
TYPE *type)
+{
+	u8 next_state;
+	u8 scan_ch =3D 0;
+	RT_SCAN_TYPE scan_type =3D SCAN_PASSIVE;
+	struct mlme_ext_priv *pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info *pmlmeinfo =3D &pmlmeext->mlmext_info;
+	struct ss_res *ss =3D &pmlmeext->sitesurvey_res;
+
+#ifdef CONFIG_P2P
+	struct wifidirect_info *pwdinfo =3D &padapter->wdinfo;
+#endif
+
+	/* handle scan abort request */
+	scan_abort_hdl(padapter);
+
+#ifdef CONFIG_P2P
+	if (pwdinfo->rx_invitereq_info.scan_op_ch_only || pwdinfo->p2p_info.scan_=
op_ch_only) {
+		if (pwdinfo->rx_invitereq_info.scan_op_ch_only)
+			scan_ch =3D pwdinfo->rx_invitereq_info.operation_ch[ss->channel_idx];
+		else
+			scan_ch =3D pwdinfo->p2p_info.operation_ch[ss->channel_idx];
+		scan_type =3D SCAN_ACTIVE;
+	} else if (rtw_p2p_findphase_ex_is_social(pwdinfo)) {
+		/*
+		* Commented by Albert 2011/06/03
+		* The driver is in the find phase, it should go through the social chann=
el.
+		*/
+		int ch_set_idx;
+
+		scan_ch =3D pwdinfo->social_chan[ss->channel_idx];
+		ch_set_idx =3D rtw_ch_set_search_ch(pmlmeext->channel_set, scan_ch);
+		if (ch_set_idx >=3D 0)
+			scan_type =3D pmlmeext->channel_set[ch_set_idx].ScanType;
+		else
+			scan_type =3D SCAN_ACTIVE;
+	} else
+#endif /* CONFIG_P2P */
+	{
+		struct rtw_ieee80211_channel *ch;
+
+		if (ss->channel_idx < ss->ch_num) {
+			ch =3D &ss->ch[ss->channel_idx];
+			scan_ch =3D ch->hw_value;
+			scan_type =3D (ch->flags & RTW_IEEE80211_CHAN_PASSIVE_SCAN) ? SCAN_PASS=
IVE : SCAN_ACTIVE;
+		}
+	}
+
+	if (scan_ch !=3D 0) {
+		next_state =3D SCAN_PROCESS;
+#ifdef CONFIG_SCAN_BACKOP
+		{
+			struct mi_state mstate;
+			u8 backop_flags =3D 0;
+
+			rtw_mi_status(padapter, &mstate);
+
+			if ((MSTATE_STA_LD_NUM(&mstate) && mlmeext_chk_scan_backop_flags_sta(pm=
lmeext, SS_BACKOP_EN))
+				|| (MSTATE_STA_NUM(&mstate) && mlmeext_chk_scan_backop_flags_sta(pmlme=
ext, SS_BACKOP_EN_NL)))
+				backop_flags |=3D mlmeext_scan_backop_flags_sta(pmlmeext);
+
+			if ((MSTATE_AP_LD_NUM(&mstate) && mlmeext_chk_scan_backop_flags_ap(pmlm=
eext, SS_BACKOP_EN))
+				|| (MSTATE_AP_NUM(&mstate) && mlmeext_chk_scan_backop_flags_ap(pmlmeex=
t, SS_BACKOP_EN_NL)))
+				backop_flags |=3D mlmeext_scan_backop_flags_ap(pmlmeext);
+
+			if (backop_flags) {
+				if (ss->scan_cnt < ss->scan_cnt_max)
+					ss->scan_cnt++;
+				else {
+					mlmeext_assign_scan_backop_flags(pmlmeext, backop_flags);
+					next_state =3D SCAN_BACKING_OP;
+				}
+			}
+		}
+#endif /* CONFIG_SCAN_BACKOP */
+	} else if (rtw_p2p_findphase_ex_is_needed(pwdinfo)) {
+		/* go p2p listen */
+		next_state =3D SCAN_TO_P2P_LISTEN;
+
+#ifdef CONFIG_ANTENNA_DIVERSITY
+	} else if (rtw_hal_antdiv_before_linked(padapter)) {
+		/* go sw antdiv before link */
+		next_state =3D SCAN_SW_ANTDIV_BL;
+#endif
+	} else {
+		next_state =3D SCAN_COMPLETE;
+
+#if defined(DBG_SCAN_SW_ANTDIV_BL)
+		{
+			/* for SCAN_SW_ANTDIV_BL state testing */
+			struct dvobj_priv *dvobj =3D adapter_to_dvobj(padapter);
+			int i;
+			bool is_linked =3D false;
+
+			for (i =3D 0; i < dvobj->iface_nums; i++) {
+				if (rtw_linked_check(dvobj->padapters[i]))
+					is_linked =3D true;
+			}
+
+			if (!is_linked) {
+				static bool fake_sw_antdiv_bl_state =3D 0;
+
+				if (fake_sw_antdiv_bl_state =3D=3D 0) {
+					next_state =3D SCAN_SW_ANTDIV_BL;
+					fake_sw_antdiv_bl_state =3D 1;
+				} else
+					fake_sw_antdiv_bl_state =3D 0;
+			}
+		}
+#endif /* defined(DBG_SCAN_SW_ANTDIV_BL) */
+	}
+
+#ifdef CONFIG_SCAN_BACKOP
+	if (next_state !=3D SCAN_PROCESS)
+		ss->scan_cnt =3D 0;
+#endif
+
+
+#ifdef DBG_FIXED_CHAN
+	if (pmlmeext->fixed_chan !=3D 0xff && next_state =3D=3D SCAN_PROCESS)
+		scan_ch =3D pmlmeext->fixed_chan;
+#endif
+
+	if (ch)
+		*ch =3D scan_ch;
+	if (type)
+		*type =3D scan_type;
+
+	return next_state;
+}
