+int getopt(int argc, char *const argv[], const char *optstring)
+{
+	static int optchr =3D 1;
+	char *cp;
+
+	if (optchr =3D=3D 1) {
+		if (optind >=3D argc) {
+			/* all arguments processed */
+			return EOF;
+		}
+
+		if (argv[optind][0] !=3D '-' || argv[optind][1] =3D=3D '\0') {
+			/* no option characters */
+			return EOF;
+		}
+	}
+
+	if (os_strcmp(argv[optind], "--") =3D=3D 0) {
+		/* no more options */
+		optind++;
+		return EOF;
+	}
+
+	optopt =3D argv[optind][optchr];
+	cp =3D os_strchr(optstring, optopt);
+	if (cp =3D=3D NULL || optopt =3D=3D ':') {
+		if (argv[optind][++optchr] =3D=3D '\0') {
+			optchr =3D 1;
+			optind++;
+		}
+		return '?';
+	}
+
+	if (cp[1] =3D=3D ':') {
+		/* Argument required */
+		optchr =3D 1;
+		if (argv[optind][optchr + 1]) {
+			/* No space between option and argument */
+			optarg =3D &argv[optind++][optchr + 1];
+		} else if (++optind >=3D argc) {
+			/* option requires an argument */
+			return '?';
+		} else {
+			/* Argument in the next argv */
+			optarg =3D argv[optind++];
+		}
+	} else {
+		/* No argument */
+		if (argv[optind][++optchr] =3D=3D '\0') {
+			optchr =3D 1;
+			optind++;
+		}
+		optarg =3D NULL;
+	}
+	return *cp;
+}
