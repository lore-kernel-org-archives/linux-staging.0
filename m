+u64
+phydm_get_rate_bitmap_ex(
+	void		*p_dm_void,
+	u32		macid,
+	u64		ra_mask,
+	u8		rssi_level,
+	u64	*dm_ra_mask,
+	u8	*dm_rte_id
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct sta_info	*p_entry;
+	u64	rate_bitmap =3D 0;
+	u8	wireless_mode;
+
+	p_entry =3D p_dm_odm->p_odm_sta_info[macid];
+	if (!IS_STA_VALID(p_entry))
+		return ra_mask;
+	wireless_mode =3D p_entry->wireless_mode;
+	switch (wireless_mode) {
+	case ODM_WM_B:
+		if (ra_mask & 0x000000000000000c) /* 11M or 5.5M enable */
+			rate_bitmap =3D 0x000000000000000d;
+		else
+			rate_bitmap =3D 0x000000000000000f;
+		break;
+
+	case (ODM_WM_G):
+	case (ODM_WM_A):
+		if (rssi_level =3D=3D DM_RATR_STA_HIGH)
+			rate_bitmap =3D 0x0000000000000f00;
+		else
+			rate_bitmap =3D 0x0000000000000ff0;
+		break;
+
+	case (ODM_WM_B|ODM_WM_G):
+		if (rssi_level =3D=3D DM_RATR_STA_HIGH)
+			rate_bitmap =3D 0x0000000000000f00;
+		else if (rssi_level =3D=3D DM_RATR_STA_MIDDLE)
+			rate_bitmap =3D 0x0000000000000ff0;
+		else
+			rate_bitmap =3D 0x0000000000000ff5;
+		break;
+
+	case (ODM_WM_B|ODM_WM_G|ODM_WM_N24G):
+	case (ODM_WM_B|ODM_WM_N24G):
+	case (ODM_WM_G|ODM_WM_N24G):
+	case (ODM_WM_A|ODM_WM_N5G):
+	{
+		if (p_dm_odm->rf_type =3D=3D ODM_1T2R || p_dm_odm->rf_type =3D=3D ODM_1T=
1R) {
+			if (rssi_level =3D=3D DM_RATR_STA_HIGH)
+				rate_bitmap =3D 0x00000000000f0000;
+			else if (rssi_level =3D=3D DM_RATR_STA_MIDDLE)
+				rate_bitmap =3D 0x00000000000ff000;
+			else {
+				if (*(p_dm_odm->p_band_width) =3D=3D ODM_BW40M)
+					rate_bitmap =3D 0x00000000000ff015;
+				else
+					rate_bitmap =3D 0x00000000000ff005;
+			}
+		} else if (p_dm_odm->rf_type =3D=3D ODM_2T2R  || p_dm_odm->rf_type =3D=
=3D ODM_2T3R  || p_dm_odm->rf_type =3D=3D ODM_2T4R) {
+			if (rssi_level =3D=3D DM_RATR_STA_HIGH)
+				rate_bitmap =3D 0x000000000f8f0000;
+			else if (rssi_level =3D=3D DM_RATR_STA_MIDDLE)
+				rate_bitmap =3D 0x000000000f8ff000;
+			else {
+				if (*(p_dm_odm->p_band_width) =3D=3D ODM_BW40M)
+					rate_bitmap =3D 0x000000000f8ff015;
+				else
+					rate_bitmap =3D 0x000000000f8ff005;
+			}
+		} else {
+			if (rssi_level =3D=3D DM_RATR_STA_HIGH)
+				rate_bitmap =3D 0x0000000f0f0f0000L;
+			else if (rssi_level =3D=3D DM_RATR_STA_MIDDLE)
+				rate_bitmap =3D 0x0000000fcfcfe000L;
+			else {
+				if (*(p_dm_odm->p_band_width) =3D=3D ODM_BW40M)
+					rate_bitmap =3D 0x0000000ffffff015L;
+				else
+					rate_bitmap =3D 0x0000000ffffff005L;
+			}
+		}
+	}
+	break;
+
+	case (ODM_WM_AC|ODM_WM_G):
+		if (rssi_level =3D=3D 1)
+			rate_bitmap =3D 0x00000000fc3f0000L;
+		else if (rssi_level =3D=3D 2)
+			rate_bitmap =3D 0x00000000fffff000L;
+		else
+			rate_bitmap =3D 0x00000000ffffffffL;
+		break;
+
+	case (ODM_WM_AC|ODM_WM_A):
+
+		if (p_dm_odm->rf_type =3D=3D ODM_1T2R || p_dm_odm->rf_type =3D=3D ODM_1T=
1R) {
+			if (rssi_level =3D=3D 1)				/* add by Gary for ac-series */
+				rate_bitmap =3D 0x00000000003f8000L;
+			else if (rssi_level =3D=3D 2)
+				rate_bitmap =3D 0x00000000003fe000L;
+			else
+				rate_bitmap =3D 0x00000000003ff010L;
+		} else if (p_dm_odm->rf_type =3D=3D ODM_2T2R  || p_dm_odm->rf_type =3D=
=3D ODM_2T3R  || p_dm_odm->rf_type =3D=3D ODM_2T4R) {
+			if (rssi_level =3D=3D 1)				/* add by Gary for ac-series */
+				rate_bitmap =3D 0x00000000fe3f8000L;       /* VHT 2SS MCS3~9 */
+			else if (rssi_level =3D=3D 2)
+				rate_bitmap =3D 0x00000000fffff000L;       /* VHT 2SS MCS0~9 */
+			else
+				rate_bitmap =3D 0x00000000fffff010L;       /* All */
+		} else {
+			if (rssi_level =3D=3D 1)				/* add by Gary for ac-series */
+				rate_bitmap =3D 0x000003f8fe3f8000ULL;       /* VHT 3SS MCS3~9 */
+			else if (rssi_level =3D=3D 2)
+				rate_bitmap =3D 0x000003fffffff000ULL;       /* VHT3SS MCS0~9 */
+			else
+				rate_bitmap =3D 0x000003fffffff010ULL;       /* All */
+		}
+		break;
+
+	default:
+		if (p_dm_odm->rf_type =3D=3D ODM_1T2R || p_dm_odm->rf_type =3D=3D ODM_1T=
1R)
+			rate_bitmap =3D 0x00000000000fffff;
+		else if (p_dm_odm->rf_type =3D=3D ODM_2T2R  || p_dm_odm->rf_type =3D=3D =
ODM_2T3R  || p_dm_odm->rf_type =3D=3D ODM_2T4R)
+			rate_bitmap =3D 0x000000000fffffff;
+		else
+			rate_bitmap =3D 0x0000003fffffffffULL;
+		break;
+
+	}
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_RA_MASK, ODM_DBG_LOUD, (" =3D=3D> rssi_le=
vel:0x%02x, wireless_mode:0x%02x, rate_bitmap:0x%016llx\n", rssi_level, wir=
eless_mode, rate_bitmap));
+
+	return ra_mask & rate_bitmap;
+}
