+
+	case LED_BLINK_WPS_STOP:	/* WPS authentication fail */
+		if (check_fwstate(pmlmepriv, _FW_LINKED) =3D=3D true) {
+			if (pLed->bLedOn)
+				pLed->BlinkingLedState =3D RTW_LED_OFF;
