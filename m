+	/*	The upper application should pass the SSID to driver by using this rtw=
_p2p_profilefound function. */
+	if (!rtw_p2p_chk_state(pwdinfo, P2P_STATE_NONE)) {
+		if (extra[0] =3D=3D '0') {
+			/*	Remove all the profile information of wifidirect_info structure. */
+			memset(&pwdinfo->profileinfo[0], 0x00, sizeof(struct profile_info) * P2=
P_MAX_PERSISTENT_GROUP_NUM);
+			pwdinfo->profileindex =3D 0;
+		} else {
+			if (pwdinfo->profileindex >=3D P2P_MAX_PERSISTENT_GROUP_NUM)
+				ret =3D -1;
+			else {
+				int jj, kk;
+
+				/*	Add this profile information into pwdinfo->profileinfo */
+				/*	Ex:  1XX:XX:XX:XX:XX:XXYYSSID */
+				for (jj =3D 0, kk =3D 1; jj < ETH_ALEN; jj++, kk +=3D 3)
+					pwdinfo->profileinfo[pwdinfo->profileindex].peermac[jj] =3D key_2char=
2num(extra[kk], extra[kk + 1]);
