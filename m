+/* for non-agg data frame or  management frame */
+static s32 rtw_dump_xframe(_adapter *padapter, struct xmit_frame *pxmitfra=
me)
+{
+	s32 ret =3D _SUCCESS;
+	s32 inner_ret =3D _SUCCESS;
+	int t, sz, w_sz, pull =3D 0;
+	u8 *mem_addr;
+	u32 ff_hwaddr;
+	struct xmit_buf *pxmitbuf =3D pxmitframe->pxmitbuf;
+	struct pkt_attrib *pattrib =3D &pxmitframe->attrib;
+	struct xmit_priv *pxmitpriv =3D &padapter->xmitpriv;
+	struct security_priv *psecuritypriv =3D &padapter->securitypriv;
+	if ((pxmitframe->frame_tag =3D=3D DATA_FRAMETAG) &&
+	    (pxmitframe->attrib.ether_type !=3D 0x0806) &&
+	    (pxmitframe->attrib.ether_type !=3D 0x888e) &&
+	    (pxmitframe->attrib.ether_type !=3D 0x88b4) &&
+	    (pxmitframe->attrib.dhcp_pkt !=3D 1))
+		rtw_issue_addbareq_cmd(padapter, pxmitframe);
+	mem_addr =3D pxmitframe->buf_addr;
+
+
+	for (t =3D 0; t < pattrib->nr_frags; t++) {
+		if (inner_ret !=3D _SUCCESS && ret =3D=3D _SUCCESS)
+			ret =3D _FAIL;
+
+		if (t !=3D (pattrib->nr_frags - 1)) {
+
+			sz =3D pxmitpriv->frag_len;
+			sz =3D sz - 4 - (psecuritypriv->sw_encrypt ? 0 : pattrib->icv_len);
+		} else /* no frag */
+			sz =3D pattrib->last_txcmdsz;
+
+		pull =3D update_txdesc(pxmitframe, mem_addr, sz, false);
+
+		if (pull) {
+			mem_addr +=3D PACKET_OFFSET_SZ; /* pull txdesc head */
+
+			/* pxmitbuf->pbuf =3D mem_addr;			 */
+			pxmitframe->buf_addr =3D mem_addr;
+
+			w_sz =3D sz + TXDESC_SIZE;
+		} else
+			w_sz =3D sz + TXDESC_SIZE + PACKET_OFFSET_SZ;
+#ifdef CONFIG_IOL_IOREG_CFG_DBG
+		rtw_IOL_cmd_buf_dump(padapter, w_sz, pxmitframe->buf_addr);
+#endif
+		ff_hwaddr =3D rtw_get_ff_hwaddr(pxmitframe);
+
+#ifdef CONFIG_XMIT_THREAD_MODE
+		pxmitbuf->len =3D w_sz;
+		pxmitbuf->ff_hwaddr =3D ff_hwaddr;
+		enqueue_pending_xmitbuf(pxmitpriv, pxmitbuf);
+#else
+		/*	RTW_INFO("%s:  rtw_write_port size =3D%d\n", __func__,w_sz); */
+		inner_ret =3D rtw_write_port(padapter, ff_hwaddr, w_sz, (unsigned char *=
)pxmitbuf);
+#endif
+
+		rtw_count_tx_stats(padapter, pxmitframe, sz);
+
+		/* RTW_INFO("rtw_write_port, w_sz=3D%d, sz=3D%d, txdesc_sz=3D%d, tid=3D%=
d\n", w_sz, sz, w_sz-sz, pattrib->priority);       */
+
+		mem_addr +=3D w_sz;
+
+		mem_addr =3D (u8 *)RND4(((SIZE_PTR)(mem_addr)));
+
+	}
+
+	rtw_free_xmitframe(pxmitpriv, pxmitframe);
+
+	if (ret !=3D _SUCCESS)
+		rtw_sctx_done_err(&pxmitbuf->sctx, RTW_SCTX_DONE_UNKNOWN);
+
+	return ret;
+}
