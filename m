+#else /* !LPS_RPWM_WAIT_MS */
+	timeout =3D 30;
+#endif /* !LPS_RPWM_WAIT_MS */
+
+	if (GLBtcBtCoexAliveRegistered =3D=3D true)
+		return;
+
+	stime =3D jiffies;
+	do {
