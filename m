+	int ret;
+
+	if (hwaddr_aton(txtaddr, addr) ||
+	    (sta =3D ap_get_sta(hapd, addr)) =3D=3D NULL) {
+		ret =3D os_snprintf(buf, buflen, "FAIL\n");
+		if (ret < 0 || (size_t) ret >=3D buflen)
+			return 0;
+		return ret;
+	}=09=09
+	return hostapd_ctrl_iface_sta_mib(hapd, sta->next, buf, buflen);
