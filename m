+
+static void
+odm_auto_channel_select_setting(
+	void			*p_dm_void,
+	bool			is_enable
+)
+{
+	struct PHY_DM_STRUCT					*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u16						period =3D 0x2710;/* 40ms in default */
+	u16						nhm_type =3D 0x7;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ACS, ODM_DBG_LOUD, ("odm_auto_channel_sel=
ect_setting()=3D=3D=3D=3D=3D=3D=3D=3D=3D>\n"));
+
+	if (is_enable) {
+		/* 20 ms */
+		period =3D 0x1388;
+		nhm_type =3D 0x1;
+	}
+
+	if (p_dm_odm->support_ic_type & ODM_IC_11AC_SERIES) {
+		/* PHY parameters initialize for ac series */
+		odm_write_2byte(p_dm_odm, ODM_REG_CCX_PERIOD_11AC + 2, period);	/* 0x990=
[31:16]=3D0x2710	Time duration for NHM unit: 4us, 0x2710=3D40ms */
+		/* odm_set_bb_reg(p_dm_odm, ODM_REG_NHM_TH9_TH10_11AC, BIT(8)|BIT9|BIT10=
, nhm_type);	 */ /* 0x994[9:8]=3D3			enable CCX */
+	} else if (p_dm_odm->support_ic_type & ODM_IC_11N_SERIES) {
+		/* PHY parameters initialize for n series */
+		odm_write_2byte(p_dm_odm, ODM_REG_CCX_PERIOD_11N + 2, period);	/* 0x894[=
31:16]=3D0x2710	Time duration for NHM unit: 4us, 0x2710=3D40ms */
+		/* odm_set_bb_reg(p_dm_odm, ODM_REG_NHM_TH9_TH10_11N, BIT(10)|BIT9|BIT8,=
 nhm_type);	 */ /* 0x890[9:8]=3D3			enable CCX */
+	}
+}
+
+void
+odm_auto_channel_select_init(
+	void			*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT					*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _ACS_						*p_acs =3D &p_dm_odm->dm_acs;
+	u8						i;
+
+	if (!(p_dm_odm->support_ability & ODM_BB_NHM_CNT))
+		return;
+
+	if (p_acs->is_force_acs_result)
+		return;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ACS, ODM_DBG_LOUD, ("odm_auto_channel_sel=
ect_init()=3D=3D=3D=3D=3D=3D=3D=3D=3D>\n"));
+
+	p_acs->clean_channel_2g =3D 1;
+	p_acs->clean_channel_5g =3D 36;
+
+	for (i =3D 0; i < ODM_MAX_CHANNEL_2G; ++i) {
+		p_acs->channel_info_2g[0][i] =3D 0;
+		p_acs->channel_info_2g[1][i] =3D 0;
+	}
+
+	if (p_dm_odm->support_ic_type & ODM_IC_11AC_SERIES) {
+		for (i =3D 0; i < ODM_MAX_CHANNEL_5G; ++i) {
+			p_acs->channel_info_5g[0][i] =3D 0;
+			p_acs->channel_info_5g[1][i] =3D 0;
+		}
+	}
+}
+
+void
+odm_auto_channel_select_reset(
+	void			*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT					*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _ACS_						*p_acs =3D &p_dm_odm->dm_acs;
+
+	if (!(p_dm_odm->support_ability & ODM_BB_NHM_CNT))
+		return;
+
+	if (p_acs->is_force_acs_result)
+		return;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ACS, ODM_DBG_LOUD, ("odm_auto_channel_sel=
ect_reset()=3D=3D=3D=3D=3D=3D=3D=3D=3D>\n"));
+
+	odm_auto_channel_select_setting(p_dm_odm, true); /* for 20ms measurement =
*/
+	phydm_nhm_counter_statistics_reset(p_dm_odm);
+}
+
+void
+odm_auto_channel_select(
+	void			*p_dm_void,
+	u8			channel
+)
+{
+	struct PHY_DM_STRUCT					*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _ACS_						*p_acs =3D &p_dm_odm->dm_acs;
+	u8						channel_idx =3D 0, search_idx =3D 0;
+	u16						max_score =3D 0;
+
+	if (!(p_dm_odm->support_ability & ODM_BB_NHM_CNT)) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_DIG, ODM_DBG_LOUD, ("odm_auto_channel_se=
lect(): Return: support_ability ODM_BB_NHM_CNT is disabled\n"));
+		return;
+	}
+
+	if (p_acs->is_force_acs_result) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_DIG, ODM_DBG_LOUD, ("odm_auto_channel_se=
lect(): Force 2G clean channel =3D %d, 5G clean channel =3D %d\n",
+			p_acs->clean_channel_2g, p_acs->clean_channel_5g));
+		return;
+	}
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ACS, ODM_DBG_LOUD, ("odm_auto_channel_sel=
ect(): channel =3D %d=3D=3D=3D=3D=3D=3D=3D=3D=3D>\n", channel));
+
+	phydm_get_nhm_counter_statistics(p_dm_odm);
+	odm_auto_channel_select_setting(p_dm_odm, false);
+
+	if (channel >=3D 1 && channel <=3D 14) {
+		channel_idx =3D channel - 1;
+		p_acs->channel_info_2g[1][channel_idx]++;
+
+		if (p_acs->channel_info_2g[1][channel_idx] >=3D 2)
+			p_acs->channel_info_2g[0][channel_idx] =3D (p_acs->channel_info_2g[0][c=
hannel_idx] >> 1) +
+				(p_acs->channel_info_2g[0][channel_idx] >> 2) + (p_dm_odm->nhm_cnt_0 >=
> 2);
+		else
+			p_acs->channel_info_2g[0][channel_idx] =3D p_dm_odm->nhm_cnt_0;
+
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ACS, ODM_DBG_LOUD, ("odm_auto_channel_se=
lect(): nhm_cnt_0 =3D %d\n", p_dm_odm->nhm_cnt_0));
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ACS, ODM_DBG_LOUD, ("odm_auto_channel_se=
lect(): Channel_Info[0][%d] =3D %d, Channel_Info[1][%d] =3D %d\n", channel_=
idx, p_acs->channel_info_2g[0][channel_idx], channel_idx, p_acs->channel_in=
fo_2g[1][channel_idx]));
+
+		for (search_idx =3D 0; search_idx < ODM_MAX_CHANNEL_2G; search_idx++) {
+			if (p_acs->channel_info_2g[1][search_idx] !=3D 0) {
+				if (p_acs->channel_info_2g[0][search_idx] >=3D max_score) {
+					max_score =3D p_acs->channel_info_2g[0][search_idx];
+					p_acs->clean_channel_2g =3D search_idx + 1;
+				}
+			}
+		}
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ACS, ODM_DBG_LOUD, ("(1)odm_auto_channel=
_select(): 2G: clean_channel_2g =3D %d, max_score =3D %d\n",
+				p_acs->clean_channel_2g, max_score));
+
+	} else if (channel >=3D 36) {
+		/* Need to do */
+		p_acs->clean_channel_5g =3D channel;
+	}
+}
