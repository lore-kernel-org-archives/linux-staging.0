@@ -0,0 +1,594 @@
+#include "mp_precomp.h"
+#include "phydm_precomp.h"
+
+
+#if (PHYDM_LA_MODE_SUPPORT =3D=3D 1)
+
+bool
+phydm_la_buffer_allocate(
+	void			*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _RT_ADCSMP		*adc_smp =3D &(p_dm_odm->adcsmp);
+	struct _ADAPTER		*adapter =3D p_dm_odm->adapter;
+	struct _RT_ADCSMP_STRING	*adc_smp_buf =3D &(adc_smp->adc_smp_buf);
+	bool	ret =3D false;
+
+	dbg_print("[LA mode BufferAllocate]\n");
+
+	if (adc_smp_buf->length =3D=3D 0) {
+
+		odm_allocate_memory(p_dm_odm, (void **)&adc_smp_buf->octet, adc_smp_buf-=
>buffer_size);
+		if (!adc_smp_buf->octet)	{
+			ret =3D false;
+		} else
+			adc_smp_buf->length =3D adc_smp_buf->buffer_size;
+			ret =3D true;
+	}
+
+	return ret;
+}
+
+void
+phydm_la_get_tx_pkt_buf(
+	void			*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT			*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _RT_ADCSMP			*adc_smp =3D &(p_dm_odm->adcsmp);
+	struct _RT_ADCSMP_STRING	*adc_smp_buf =3D &(adc_smp->adc_smp_buf);
+	u32				i =3D 0, value32, data_l =3D 0, data_h =3D 0;
+	u32				addr, finish_addr;
+	u32				end_addr =3D (adc_smp_buf->start_pos  + adc_smp_buf->buffer_size) =
- 1;	/*end_addr =3D 0x3ffff;*/
+	bool				is_round_up;
+	static u32			page =3D 0xFF;
+	u32				smp_cnt =3D 0, smp_number =3D 0, addr_8byte =3D 0;
+
+	odm_memory_set(p_dm_odm, adc_smp_buf->octet, 0, adc_smp_buf->length);
+	odm_write_1byte(p_dm_odm, 0x0106, 0x69);
+
+	dbg_print("GetTxPktBuf\n");
+
+	value32 =3D odm_read_4byte(p_dm_odm, 0x7c0);
+	is_round_up =3D (bool)((value32 & BIT(31)) >> 31);
+	finish_addr =3D (value32 & 0x7FFF0000) >> 16;	/*Reg7C0[30:16]: finish add=
r (unit: 8byte)*/
+
+	if (is_round_up) {
+		addr =3D (finish_addr + 1) << 3;
+		dbg_print("is_round_up =3D ((%d)), finish_addr=3D((0x%x)), 0x7c0=3D((0x%=
x))\n", is_round_up, finish_addr, value32);
+		smp_number =3D ((adc_smp_buf->buffer_size) >> 3);	/*Byte to 64Byte*/
+	} else	 {
+		addr =3D adc_smp_buf->start_pos;
+
+		addr_8byte =3D addr >> 3;
+		if (addr_8byte > finish_addr)
+			smp_number =3D addr_8byte - finish_addr;
+		else
+			smp_number =3D finish_addr - addr_8byte;
+
+		dbg_print("is_round_up =3D ((%d)), finish_addr=3D((0x%x * 8Byte)), Start=
_Addr =3D ((0x%x * 8Byte)), smp_number =3D ((%d))\n", is_round_up, finish_a=
ddr, addr_8byte, smp_number);
+
+	}
+	if (p_dm_odm->support_ic_type & ODM_RTL8197F) {
+		for (addr =3D 0x0, i =3D 0; addr < end_addr; addr +=3D 8, i +=3D 2) {	/*=
64K byte*/
+			if ((addr & 0xfff) =3D=3D 0)
+				odm_set_bb_reg(p_dm_odm, 0x0140, MASKLWORD, 0x780 + (addr >> 12));
+			data_l =3D odm_get_bb_reg(p_dm_odm, 0x8000 + (addr & 0xfff), MASKDWORD);
+			data_h =3D odm_get_bb_reg(p_dm_odm, 0x8000 + (addr & 0xfff) + 4, MASKDW=
ORD);
+
+			dbg_print("%08x%08x\n", data_h, data_l);
+		}
+	} else {
+		while (addr !=3D (finish_addr << 3)) {
+			if (page !=3D (addr >> 12)) {
+				/*Reg140=3D0x780+(addr>>12), addr=3D0x30~0x3F, total 16 pages*/
+				page =3D (addr >> 12);
+			}
+			odm_set_bb_reg(p_dm_odm, 0x0140, MASKLWORD, 0x780 + page);
+
+			/*pDataL =3D 0x8000+(addr&0xfff);*/
+			data_l =3D odm_get_bb_reg(p_dm_odm, 0x8000 + (addr & 0xfff), MASKDWORD);
+			data_h =3D odm_get_bb_reg(p_dm_odm, 0x8000 + (addr & 0xfff) + 4, MASKDW=
ORD);
+
+			adc_smp_buf->octet[i] =3D data_h;
+			adc_smp_buf->octet[i + 1] =3D data_l;
+
+#if DBG
+			dbg_print("%08x%08x\n", data_h, data_l);
+#endif
+			i =3D i + 2;
+
+			if ((addr + 8) >=3D end_addr)
+				addr =3D adc_smp_buf->start_pos;
+			else
+				addr =3D addr + 8;
+
+			smp_cnt++;
+			if (smp_cnt >=3D (smp_number - 1))
+				break;
+		}
+		dbg_print("smp_cnt =3D ((%d))\n", smp_cnt);
+	}
+}
+
+void
+phydm_la_mode_set_mac_iq_dump(
+	void		*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _RT_ADCSMP		*adc_smp =3D &(p_dm_odm->adcsmp);
+	u32			reg_value;
+
+	odm_write_1byte(p_dm_odm, 0x7c0, 0);		/*clear all 0x7c0*/
+	odm_set_mac_reg(p_dm_odm, 0x7c0, BIT(0), 1);  /*Enable LA mode HW block*/
+
+	if (adc_smp->la_trig_mode =3D=3D PHYDM_MAC_TRIG) {
+
+		adc_smp->is_bb_trigger =3D 0;
+		odm_set_mac_reg(p_dm_odm, 0x7c0, BIT(2), 1); /*polling bit for MAC mode*/
+		odm_set_mac_reg(p_dm_odm, 0x7c0, BIT(4) | BIT3, adc_smp->la_trigger_edge=
); /*trigger mode for MAC*/
+
+		dbg_print("[MAC_trig] ref_mask =3D ((0x%x)), ref_value =3D ((0x%x)), dbg=
_port =3D ((0x%x))\n", adc_smp->la_mac_ref_mask, adc_smp->la_trig_sig_sel, =
adc_smp->la_dbg_port);
+		/*[Set MAC Debug Port]*/
+		odm_set_mac_reg(p_dm_odm, 0xF4, BIT(16), 1);
+		odm_set_mac_reg(p_dm_odm, 0x38, 0xff0000, adc_smp->la_dbg_port);
+		odm_set_mac_reg(p_dm_odm, 0x7c4, MASKDWORD, adc_smp->la_mac_ref_mask);
+		odm_set_mac_reg(p_dm_odm, 0x7c8, MASKDWORD, adc_smp->la_trig_sig_sel);
+
+	} else {
+
+		adc_smp->is_bb_trigger =3D 1;
+		odm_set_mac_reg(p_dm_odm, 0x7c0, BIT(1), 1); /*polling bit for BB ADC mo=
de*/
+
+		if (adc_smp->la_trig_mode =3D=3D PHYDM_ADC_MAC_TRIG) {
+
+			odm_set_mac_reg(p_dm_odm, 0x7c0, BIT(3), 1); /*polling bit for MAC trig=
ger event*/
+			odm_set_mac_reg(p_dm_odm, 0x7c0, BIT(7) | BIT(6), adc_smp->la_trig_sig_=
sel);
+
+			if (adc_smp->la_trig_sig_sel =3D=3D ADCSMP_TRIG_REG)
+				odm_set_mac_reg(p_dm_odm, 0x7c0, BIT(5), 1); /* manual trigger 0x7C0[5=
] =3D 0->1*/
+		}
+	}
+
+	reg_value =3D odm_get_bb_reg(p_dm_odm, 0x7c0, 0xff);
+	dbg_print("4. [Set MAC IQ dump] 0x7c0[7:0] =3D ((0x%x))\n", reg_value);
+}
+
+void
+phydm_la_mode_set_dma_type(
+	void		*p_dm_void,
+	u8		la_dma_type
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+
+	dbg_print("2. [LA mode DMA setting] Dma_type =3D ((%d))\n", la_dma_type);
+	if (p_dm_odm->support_ic_type & ODM_N_ANTDIV_SUPPORT)
+		odm_set_bb_reg(p_dm_odm, 0x9a0, 0xf00, la_dma_type);	/*0x9A0[11:8]*/
+	else
+		odm_set_bb_reg(p_dm_odm, odm_adc_trigger_jaguar2, 0xf00, la_dma_type);	/=
*0x95C[11:8]*/
+}
+
+void
+phydm_adc_smp_start(
+	void			*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT				*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _RT_ADCSMP				*adc_smp =3D &(p_dm_odm->adcsmp);
+	u8					tmp_u1b;
+	u8					backup_DMA, while_cnt =3D 0;
+	u8					polling_ok =3D false, target_polling_bit;
+
+	phydm_la_mode_bb_setting(p_dm_odm);
+	phydm_la_mode_set_dma_type(p_dm_odm, adc_smp->la_dma_type);
+	phydm_la_mode_set_trigger_time(p_dm_odm, adc_smp->la_trigger_time);
+
+	if (p_dm_odm->support_ic_type & ODM_RTL8197F)
+		odm_set_bb_reg(p_dm_odm, 0xd00, BIT(26), 0x1);
+	else {	/*for 8814A and 8822B?*/
+		odm_write_1byte(p_dm_odm, 0x198c, 0x7);
+		odm_write_1byte(p_dm_odm, 0x8b4, 0x80);
+		/* odm_set_bb_reg(p_dm_odm, 0x8b4, BIT7, 1); */
+	}
+
+	phydm_la_mode_set_mac_iq_dump(p_dm_odm);
+	/* return; */
+
+	target_polling_bit =3D (adc_smp->is_bb_trigger) ? BIT(1) : BIT(2);
+	do { /*Polling time always use 100ms, when it exceed 2s, break while loop=
*/
+		tmp_u1b =3D odm_read_1byte(p_dm_odm, 0x7c0);
+
+		if (adc_smp->adc_smp_state !=3D ADCSMP_STATE_SET) {
+			dbg_print("[state Error] adc_smp_state !=3D ADCSMP_STATE_SET\n");
+			break;
+
+		} else if (tmp_u1b & target_polling_bit) {
+			ODM_delay_ms(100);
+			while_cnt =3D while_cnt + 1;
+			continue;
+		} else {
+			dbg_print("[LA Query OK] polling_bit=3D((0x%x))\n", target_polling_bit);
+			polling_ok =3D true;
+			if (p_dm_odm->support_ic_type & ODM_RTL8197F)
+				odm_set_bb_reg(p_dm_odm, 0x7c0, BIT(0), 0x0);
+			break;
+		}
+	} while (while_cnt < 20);
+
+	if (adc_smp->adc_smp_state =3D=3D ADCSMP_STATE_SET) {
+
+		if (polling_ok)
+			phydm_la_get_tx_pkt_buf(p_dm_odm);
+		else
+			dbg_print("[Polling timeout]\n");
+	}
+
+	if (adc_smp->adc_smp_state =3D=3D ADCSMP_STATE_SET)
