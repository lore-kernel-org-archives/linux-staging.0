+void
+phydm_get_rx_phy_status_type2(
+	struct PHY_DM_STRUCT						*p_dm_odm,
+	u8							*p_phy_status,
+	struct _odm_per_pkt_info_				*p_pktinfo,
+	struct _odm_phy_status_info_				*p_phy_info
+)
+{
+	struct _phy_status_rpt_jaguar2_type2	*p_phy_sta_rpt =3D (struct _phy_stat=
us_rpt_jaguar2_type2 *)p_phy_status;
+	s8							rx_pwr_db =3D -120;
+	u8							i, rxsc, bw =3D ODM_BW20M, rx_count =3D 0;
+
+	/* Update OFDM packet counter */
+	p_dm_odm->phy_dbg_info.num_qry_phy_status_ofdm++;
+
+	/* Update per-path information */
+	for (i =3D ODM_RF_PATH_A; i < ODM_RF_PATH_MAX_JAGUAR; i++) {
+		if (p_dm_odm->rx_ant_status & BIT(i)) {
+			s8	rx_path_pwr_db;
+
+			/* RX path counter */
+			rx_count++;
+
+			/* Update per-path information (RSSI_dB RSSI_percentage EVM SNR CFO SQ)=
 */
+#if (RTL8197F_SUPPORT =3D=3D 1)
+			if ((p_dm_odm->support_ic_type & ODM_RTL8197F) && (p_phy_sta_rpt->pwdb[=
i] =3D=3D 0x7f)) { /*for 97f workaround*/
+
+				if (i =3D=3D ODM_RF_PATH_A) {
+					rx_path_pwr_db =3D (p_phy_sta_rpt->gain_a) << 1;
+					rx_path_pwr_db =3D rx_path_pwr_db - 110;
+				} else if (i =3D=3D ODM_RF_PATH_B) {
+					rx_path_pwr_db =3D (p_phy_sta_rpt->gain_b) << 1;
+					rx_path_pwr_db =3D rx_path_pwr_db - 110;
+				} else
+					rx_path_pwr_db =3D 0;
+			} else
+#endif
+				rx_path_pwr_db =3D p_phy_sta_rpt->pwdb[i] - 110;					/* per-path pwdb =
in dB domain */
+
+			phydm_set_per_path_phy_info(i, rx_path_pwr_db, 0, 0, 0, p_phy_info);
+
+			/* search maximum pwdb */
+			if (rx_path_pwr_db > rx_pwr_db)
+				rx_pwr_db =3D rx_path_pwr_db;
+		}
+	}
+
+	/* mapping RX counter from 1~4 to 0~3 */
+	if (rx_count > 0)
+		p_phy_info->rx_count =3D rx_count - 1;
+
+	/* Check RX sub-channel */
+	if ((p_pktinfo->data_rate > ODM_RATE11M) && (p_pktinfo->data_rate < ODM_R=
ATEMCS0))
+		rxsc =3D p_phy_sta_rpt->l_rxsc;
+	else
+		rxsc =3D p_phy_sta_rpt->ht_rxsc;
+
+	/*STBC or LDPC pkt*/
+	p_dm_odm->phy_dbg_info.is_ldpc_pkt =3D p_phy_sta_rpt->ldpc;
+	p_dm_odm->phy_dbg_info.is_stbc_pkt =3D p_phy_sta_rpt->stbc;
+
+	/* Check RX bandwidth */
+	/* the BW information of sc=3D0 is useless, because there is no informati=
on of RF mode*/
+
+	if (p_dm_odm->support_ic_type & ODM_RTL8822B) {
+		if ((rxsc >=3D 1) && (rxsc <=3D 8))
+			bw =3D ODM_BW20M;
+		else if ((rxsc >=3D 9) && (rxsc <=3D 12))
+			bw =3D ODM_BW40M;
+		else if (rxsc >=3D 13)
+			bw =3D ODM_BW80M;
+		else
+			bw =3D ODM_BW20M;
+	} else if (p_dm_odm->support_ic_type & (ODM_RTL8197F | ODM_RTL8723D)) {
+		if (rxsc =3D=3D 3)
+			bw =3D ODM_BW40M;
+		else if ((rxsc =3D=3D 1) || (rxsc =3D=3D 2))
+			bw =3D ODM_BW20M;
+		else
+			bw =3D ODM_BW20M;
+	}
+
+	/* Update packet information */
+	phydm_set_common_phy_info(rx_pwr_db, p_phy_sta_rpt->channel, (bool)p_phy_=
sta_rpt->beamformed,
+				  false, bw, 0, rxsc, p_phy_info);
+
+}
