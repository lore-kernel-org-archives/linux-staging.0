+			DECISION_UNCOND_SUCC : DECISION_COND_SUCC;
+		ret->methodState =3D data->use_result_ind ?
+			METHOD_DONE : METHOD_MAY_CONT;
+	} else if (data->state =3D=3D RESULT_FAILURE)
+		ret->methodState =3D METHOD_CONT;
+	else if (data->state =3D=3D RESULT_SUCCESS)
+		ret->methodState =3D METHOD_CONT;
+
+	if (ret->methodState =3D=3D METHOD_DONE) {
+		ret->allowNotifications =3D FALSE;
+	}
+
+	return res;
+}
+
+
+static Boolean eap_sim_has_reauth_data(struct eap_sm *sm, void *priv)
+{
