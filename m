+			    (beamforming_entry.beamforming_entry_cap & BEAMFORMER_CAP_HT_EXPLIC=
IT))
+				bSelfBeamformer =3D true;
+		}
+
+		if (bSelfBeamformer && bSelfBeamformee)
+			i =3D BEAMFORMING_ENTRY_NUM;
