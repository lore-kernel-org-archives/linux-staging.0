len);
+#endif /* CONFIG_MCC_MODE*/
+
+#ifdef CONFIG_WFD
+			len =3D rtw_append_beacon_wfd_ie(padapter, pframe);
+			pframe +=3D len;
+			pattrib->pktlen +=3D len;
+#endif
+		}
+#endif /* CONFIG_P2P */
+
+#ifdef CONFIG_APPEND_VENDOR_IE_ENABLE
+		pattrib->pktlen +=3D rtw_build_vendor_ie(padapter , pframe , WIFI_BEACON=
_VENDOR_IE_BIT);
+#endif
+		goto _issue_bcn;
+
+	}
+
+	/* below for ad-hoc mode */
+
+	/* timestamp will be inserted by hardware */
+	pframe +=3D 8;
+	pattrib->pktlen +=3D 8;
+
+	/* beacon interval: 2 bytes */
+
+	memcpy(pframe, (unsigned char *)(rtw_get_beacon_interval_from_ie(cur_netw=
ork->IEs)), 2);
+
+	pframe +=3D 2;
+	pattrib->pktlen +=3D 2;
+
+	/* capability info: 2 bytes */
+
+	memcpy(pframe, (unsigned char *)(rtw_get_capability_from_ie(cur_network->=
IEs)), 2);
+
+	pframe +=3D 2;
+	pattrib->pktlen +=3D 2;
+
+	/* SSID */
+	pframe =3D rtw_set_ie(pframe, _SSID_IE_, cur_network->Ssid.SsidLength, cu=
r_network->Ssid.Ssid, &pattrib->pktlen);
+
+	/* supported rates... */
+	rate_len =3D rtw_get_rateset_len(cur_network->SupportedRates);
+	pframe =3D rtw_set_ie(pframe, _SUPPORTEDRATES_IE_, ((rate_len > 8) ? 8 : =
rate_len), cur_network->SupportedRates, &pattrib->pktlen);
+
+	/* DS parameter set */
+	pframe =3D rtw_set_ie(pframe, _DSSET_IE_, 1, (unsigned char *)&(cur_netwo=
rk->Configuration.DSConfig), &pattrib->pktlen);
+
+	/* if( (pmlmeinfo->state&0x03) =3D=3D WIFI_FW_ADHOC_STATE) */
+	{
+		u8 erpinfo =3D 0;
+		u32 ATIMWindow;
+		/* IBSS Parameter Set... */
+		/* ATIMWindow =3D cur->Configuration.ATIMWindow; */
+		ATIMWindow =3D 0;
+		pframe =3D rtw_set_ie(pframe, _IBSS_PARA_IE_, 2, (unsigned char *)(&ATIM=
Window), &pattrib->pktlen);
+
+		/* ERP IE */
+		pframe =3D rtw_set_ie(pframe, _ERPINFO_IE_, 1, &erpinfo, &pattrib->pktle=
n);
+	}
+
+
+	/* EXTERNDED SUPPORTED RATE */
+	if (rate_len > 8)
+		pframe =3D rtw_set_ie(pframe, _EXT_SUPPORTEDRATES_IE_, (rate_len - 8), (=
cur_network->SupportedRates + 8), &pattrib->pktlen);
+
+
+	/* todo:HT for adhoc */
+
+_issue_bcn:
+
+#if defined(CONFIG_AP_MODE) && defined (CONFIG_NATIVEAP_MLME)
+	pmlmepriv->update_bcn =3D false;
+
+	_exit_critical_bh(&pmlmepriv->bcn_update_lock, &irqL);
+#endif /* #if defined (CONFIG_AP_MODE) && defined (CONFIG_NATIVEAP_MLME) */
+
+	if ((pattrib->pktlen + TXDESC_SIZE) > 512) {
+		RTW_INFO("beacon frame too large\n");
+		return;
+	}
+
+	pattrib->last_txcmdsz =3D pattrib->pktlen;
+
+	/* RTW_INFO("issue bcn_sz=3D%d\n", pattrib->last_txcmdsz); */
+	if (timeout_ms > 0)
+		dump_mgntframe_and_wait(padapter, pmgntframe, timeout_ms);
+	else
+		dump_mgntframe(padapter, pmgntframe);
+
+}
