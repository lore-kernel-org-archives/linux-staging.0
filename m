+ * Called once during program shutdown and once for each RSN pre-authentic=
ation
+ * session. If global library deinitialization is needed (i.e., one that is
+ * shared between both authentication types), the TLS library wrapper shou=
ld
+ * maintain a reference counter and do global deinitialization only when m=
oving
+ * from 1 to 0 references.
+ */
+void tls_deinit(void *tls_ctx);
+
+/**
+ * tls_get_errors - Process pending errors
