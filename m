+/* perform defrag */
+static union recv_frame *recvframe_defrag(_adapter *adapter, _queue *defra=
g_q)
+{
+	_list	*plist, *phead;
+	u8	*data, wlanhdr_offset;
+	u8	curfragnum;
+	struct recv_frame_hdr *pfhdr, *pnfhdr;
+	union recv_frame *prframe, *pnextrframe;
+	_queue	*pfree_recv_queue;
+
+	curfragnum =3D 0;
+	pfree_recv_queue =3D &adapter->recvpriv.free_recv_queue;
+
+	phead =3D get_list_head(defrag_q);
+	plist =3D get_next(phead);
+	prframe =3D LIST_CONTAINOR(plist, union recv_frame, u);
+	pfhdr =3D &prframe->u.hdr;
+	list_del_init(&(prframe->u.list));
+
+	if (curfragnum !=3D pfhdr->attrib.frag_num) {
+		/* the first fragment number must be 0 */
+		/* free the whole queue */
+		rtw_free_recvframe(prframe, pfree_recv_queue);
+		rtw_free_recvframe_queue(defrag_q, pfree_recv_queue);
+
+		return NULL;
+	}
+	curfragnum++;
+
+	plist =3D get_list_head(defrag_q);
+
+	plist =3D get_next(plist);
+
+	data =3D get_recvframe_data(prframe);
+
+	while (rtw_end_of_queue_search(phead, plist) =3D=3D false) {
+		pnextrframe =3D LIST_CONTAINOR(plist, union recv_frame , u);
+		pnfhdr =3D &pnextrframe->u.hdr;
+
+
+		/* check the fragment sequence  (2nd ~n fragment frame) */
+
+		if (curfragnum !=3D pnfhdr->attrib.frag_num) {
+			/* the fragment number must be increasing  (after decache) */
+			/* release the defrag_q & prframe */
+			rtw_free_recvframe(prframe, pfree_recv_queue);
+			rtw_free_recvframe_queue(defrag_q, pfree_recv_queue);
+			return NULL;
+		}
+
+		curfragnum++;
+
+		/* copy the 2nd~n fragment frame's payload to the first fragment */
+		/* get the 2nd~last fragment frame's payload */
+
+		wlanhdr_offset =3D pnfhdr->attrib.hdrlen + pnfhdr->attrib.iv_len;
+
+		recvframe_pull(pnextrframe, wlanhdr_offset);
+
+		/* append  to first fragment frame's tail (if privacy frame, pull the IC=
V) */
+		recvframe_pull_tail(prframe, pfhdr->attrib.icv_len);
+
+		/* memcpy */
+		memcpy(pfhdr->rx_tail, pnfhdr->rx_data, pnfhdr->len);
+
+		recvframe_put(prframe, cpu_to_le16(pnfhdr->len));
+
+		pfhdr->attrib.icv_len =3D pnfhdr->attrib.icv_len;
+		plist =3D get_next(plist);
+
+	};
+
+	/* free the defrag_q queue and return the prframe */
+	rtw_free_recvframe_queue(defrag_q, pfree_recv_queue);
+
+	return prframe;
+}
