+#define	CSCAN_TLV_TYPE_SSID_IE	'S'
+#define CIPHER_IE "key_mgmt=3D"
+#define CIPHER_NONE "NONE"
+#define CIPHER_WPA_PSK "WPA-PSK"
+#define CIPHER_WPA_EAP "WPA-EAP IEEE8021X"
+/*
+ *  SSIDs list parsing from cscan tlv list
+ */
+int rtw_parse_ssid_list_tlv(char **list_str, pno_ssid_t *ssid,
+			    int max, int *bytes_left)
+{
+	char *str;
+
+	int idx =3D 0;
+
+	if ((list_str =3D=3D NULL) || (*list_str =3D=3D NULL) || (*bytes_left < 0=
)) {
+		RTW_INFO("%s error paramters\n", __func__);
+		return -1;
+	}
+
+	str =3D *list_str;
+	while (*bytes_left > 0) {
+
+		if (str[0] !=3D CSCAN_TLV_TYPE_SSID_IE) {
+			*list_str =3D str;
+			RTW_INFO("nssid=3D%d left_parse=3D%d %d\n", idx, *bytes_left, str[0]);
+			return idx;
+		}
+
+		/* Get proper CSCAN_TLV_TYPE_SSID_IE */
+		*bytes_left -=3D 1;
+		str +=3D 1;
+
+		if (str[0] =3D=3D 0) {
+			/* Broadcast SSID */
+			ssid[idx].SSID_len =3D 0;
+			memset((char *)ssid[idx].SSID, 0x0, WLAN_SSID_MAXLEN);
+			*bytes_left -=3D 1;
+			str +=3D 1;
+
+			RTW_INFO("BROADCAST SCAN  left=3D%d\n", *bytes_left);
+		} else if (str[0] <=3D WLAN_SSID_MAXLEN) {
+			/* Get proper SSID size */
+			ssid[idx].SSID_len =3D str[0];
+			*bytes_left -=3D 1;
+			str +=3D 1;
+
+			/* Get SSID */
+			if (ssid[idx].SSID_len > *bytes_left) {
+				RTW_INFO("%s out of memory range len=3D%d but left=3D%d\n",
+					__func__, ssid[idx].SSID_len, *bytes_left);
+				return -1;
+			}
+
+			memcpy((char *)ssid[idx].SSID, str, ssid[idx].SSID_len);
+
+			*bytes_left -=3D ssid[idx].SSID_len;
+			str +=3D ssid[idx].SSID_len;
+
+			RTW_INFO("%s :size=3D%d left=3D%d\n",
+				(char *)ssid[idx].SSID, ssid[idx].SSID_len, *bytes_left);
+		} else {
+			RTW_INFO("### SSID size more that %d\n", str[0]);
+			return -1;
+		}
+
+		if (idx++ >  max) {
+			RTW_INFO("%s number of SSIDs more that %d\n", __func__, idx);
+			return -1;
+		}
+	}
+
+	*list_str =3D str;
+	return idx;
+}
