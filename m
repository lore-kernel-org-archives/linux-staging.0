+	u8 physaddr[DLPI_PHYSADDR_MAX];
+	int retval;
+
+	retval =3D dlpi_open(device, &dh, 0);
+	if (retval !=3D DLPI_SUCCESS) {
+		wpa_printf(MSG_ERROR, "dlpi_open error: %s",
+			   dlpi_strerror(retval));
