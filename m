+
+int wpa_parse_wpa_ie_wpa(const u8 *wpa_ie, size_t wpa_ie_len,
+			 struct wpa_ie_data *data)
+{
+	const struct wpa_ie_hdr *hdr;
+	const u8 *pos;
+	int left;
+	int i, count;
+
+	os_memset(data, 0, sizeof(*data));
+	data->proto =3D WPA_PROTO_WPA;
+	data->pairwise_cipher =3D WPA_CIPHER_TKIP;
+	data->group_cipher =3D WPA_CIPHER_TKIP;
+	data->key_mgmt =3D WPA_KEY_MGMT_IEEE8021X;
+	data->capabilities =3D 0;
+	data->pmkid =3D NULL;
+	data->num_pmkid =3D 0;
+	data->mgmt_group_cipher =3D 0;
+
+	if (wpa_ie_len =3D=3D 0) {
+		/* No WPA IE - fail silently */
+		return -1;
+	}
+
+	if (wpa_ie_len < sizeof(struct wpa_ie_hdr)) {
+		wpa_printf(MSG_DEBUG, "%s: ie len too short %lu",
+			   __func__, (unsigned long) wpa_ie_len);
+		return -1;
+	}
+
+	hdr =3D (const struct wpa_ie_hdr *) wpa_ie;
+
+	if (hdr->elem_id !=3D WLAN_EID_VENDOR_SPECIFIC ||
+	    hdr->len !=3D wpa_ie_len - 2 ||
+	    RSN_SELECTOR_GET(hdr->oui) !=3D WPA_OUI_TYPE ||
+	    WPA_GET_LE16(hdr->version) !=3D WPA_VERSION) {
+		wpa_printf(MSG_DEBUG, "%s: malformed ie or unknown version",
+			   __func__);
+		return -2;
+	}
+
+	pos =3D (const u8 *) (hdr + 1);
+	left =3D wpa_ie_len - sizeof(*hdr);
+
+	if (left >=3D WPA_SELECTOR_LEN) {
+		data->group_cipher =3D wpa_selector_to_bitfield(pos);
+		pos +=3D WPA_SELECTOR_LEN;
+		left -=3D WPA_SELECTOR_LEN;
+	} else if (left > 0) {
+		wpa_printf(MSG_DEBUG, "%s: ie length mismatch, %u too much",
+			   __func__, left);
+		return -3;
+	}
+
+	if (left >=3D 2) {
+		data->pairwise_cipher =3D 0;
+		count =3D WPA_GET_LE16(pos);
+		pos +=3D 2;
+		left -=3D 2;
+		if (count =3D=3D 0 || left < count * WPA_SELECTOR_LEN) {
+			wpa_printf(MSG_DEBUG, "%s: ie count botch (pairwise), "
+				   "count %u left %u", __func__, count, left);
+			return -4;
+		}
+		for (i =3D 0; i < count; i++) {
+			data->pairwise_cipher |=3D wpa_selector_to_bitfield(pos);
+			pos +=3D WPA_SELECTOR_LEN;
+			left -=3D WPA_SELECTOR_LEN;
+		}
+	} else if (left =3D=3D 1) {
+		wpa_printf(MSG_DEBUG, "%s: ie too short (for key mgmt)",
+			   __func__);
+		return -5;
+	}
+
+	if (left >=3D 2) {
+		data->key_mgmt =3D 0;
+		count =3D WPA_GET_LE16(pos);
+		pos +=3D 2;
+		left -=3D 2;
+		if (count =3D=3D 0 || left < count * WPA_SELECTOR_LEN) {
+			wpa_printf(MSG_DEBUG, "%s: ie count botch (key mgmt), "
+				   "count %u left %u", __func__, count, left);
+			return -6;
+		}
+		for (i =3D 0; i < count; i++) {
+			data->key_mgmt |=3D wpa_key_mgmt_to_bitfield(pos);
+			pos +=3D WPA_SELECTOR_LEN;
+			left -=3D WPA_SELECTOR_LEN;
+		}
+	} else if (left =3D=3D 1) {
+		wpa_printf(MSG_DEBUG, "%s: ie too short (for capabilities)",
+			   __func__);
+		return -7;
+	}
+
+	if (left >=3D 2) {
+		data->capabilities =3D WPA_GET_LE16(pos);
+		pos +=3D 2;
+		left -=3D 2;
+	}
+
+	if (left > 0) {
+		wpa_printf(MSG_DEBUG, "%s: ie has %u trailing bytes - ignored",
+			   __func__, left);
+	}
+
+	return 0;
+}
