+	UPNP_ARG_VALUE_OUT_OF_RANGE =3D 601,
+	UPNP_OUT_OF_MEMORY =3D 603
+};
+
+#endif /* HTTP_H */
diff --git a/drivers/staging/rtl8188eu/hostapd-0.8/src/wps/http_client.c b/=
