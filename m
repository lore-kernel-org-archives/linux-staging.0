+static void rtw_hal_update_tx_iv(_adapter *adapter)
+{
+	struct pwrctrl_priv *pwrctl =3D adapter_to_pwrctl(adapter);
+	struct aoac_report *paoac_rpt =3D &pwrctl->wowlan_aoac_rpt;
+	struct sta_info	*psta;
+	struct mlme_ext_priv	*pmlmeext =3D &(adapter->mlmeextpriv);
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	struct security_priv	*psecpriv =3D &adapter->securitypriv;
+
+	u16 val16 =3D 0;
+	u32 val32 =3D 0;
+	u64 txiv =3D 0;
+	u8 *pval =3D NULL;
+
+	psta =3D rtw_get_stainfo(&adapter->stapriv,
+			       get_my_bssid(&pmlmeinfo->network));
+
+	/* Update TX iv data. */
+	pval =3D (u8 *)&paoac_rpt->iv;
+
+	if (psecpriv->dot11PrivacyAlgrthm =3D=3D _TKIP_) {
+		val16 =3D ((u16)(paoac_rpt->iv[2]) << 0) +
+			((u16)(paoac_rpt->iv[0]) << 8);
+		val32 =3D ((u32)(paoac_rpt->iv[4]) << 0) +
+			((u32)(paoac_rpt->iv[5]) << 8) +
+			((u32)(paoac_rpt->iv[6]) << 16) +
+			((u32)(paoac_rpt->iv[7]) << 24);
+	} else if (psecpriv->dot11PrivacyAlgrthm =3D=3D _AES_) {
+		val16 =3D ((u16)(paoac_rpt->iv[0]) << 0) +
+			((u16)(paoac_rpt->iv[1]) << 8);
+		val32 =3D ((u32)(paoac_rpt->iv[4]) << 0) +
+			((u32)(paoac_rpt->iv[5]) << 8) +
+			((u32)(paoac_rpt->iv[6]) << 16) +
+			((u32)(paoac_rpt->iv[7]) << 24);
+	}
+
+	if (psta) {
+		txiv =3D val16 + ((u64)val32 << 16);
+		if (txiv !=3D 0)
+			psta->dot11txpn.val =3D txiv;
+	}
+}
