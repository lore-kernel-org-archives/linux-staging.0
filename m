+int wps_attr_text(struct wpabuf *data, char *buf, char *end)
+{
+	struct wps_parse_attr attr;
+	char *pos =3D buf;
+	int ret;
+
+	if (wps_parse_msg(data, &attr) < 0)
+		return -1;
+
+	if (attr.wps_state) {
+		if (*attr.wps_state =3D=3D WPS_STATE_NOT_CONFIGURED)
+			ret =3D os_snprintf(pos, end - pos,
+					  "wps_state=3Dunconfigured\n");
+		else if (*attr.wps_state =3D=3D WPS_STATE_CONFIGURED)
+			ret =3D os_snprintf(pos, end - pos,
+					  "wps_state=3Dconfigured\n");
+		else
+			ret =3D 0;
+		if (ret < 0 || ret >=3D end - pos)
+			return pos - buf;
+		pos +=3D ret;
+	}
+
+	if (attr.ap_setup_locked && *attr.ap_setup_locked) {
+		ret =3D os_snprintf(pos, end - pos,
+				  "wps_ap_setup_locked=3D1\n");
+		if (ret < 0 || ret >=3D end - pos)
+			return pos - buf;
+		pos +=3D ret;
+	}
+
+	if (attr.selected_registrar && *attr.selected_registrar) {
+		ret =3D os_snprintf(pos, end - pos,
+				  "wps_selected_registrar=3D1\n");
+		if (ret < 0 || ret >=3D end - pos)
+			return pos - buf;
+		pos +=3D ret;
+	}
+
+	if (attr.dev_password_id) {
+		ret =3D os_snprintf(pos, end - pos,
+				  "wps_device_password_id=3D%u\n",
+				  WPA_GET_BE16(attr.dev_password_id));
+		if (ret < 0 || ret >=3D end - pos)
+			return pos - buf;
+		pos +=3D ret;
+	}
+
+	if (attr.sel_reg_config_methods) {
+		ret =3D os_snprintf(pos, end - pos,
+				  "wps_selected_registrar_config_methods=3D"
+				  "0x%04x\n",
+				  WPA_GET_BE16(attr.sel_reg_config_methods));
+		if (ret < 0 || ret >=3D end - pos)
+			return pos - buf;
+		pos +=3D ret;
+	}
+
+	if (attr.primary_dev_type) {
+		char devtype[WPS_DEV_TYPE_BUFSIZE];
+		ret =3D os_snprintf(pos, end - pos,
+				  "wps_primary_device_type=3D%s\n",
+				  wps_dev_type_bin2str(attr.primary_dev_type,
+						       devtype,
+						       sizeof(devtype)));
+		if (ret < 0 || ret >=3D end - pos)
+			return pos - buf;
+		pos +=3D ret;
+	}
+
+	if (attr.dev_name) {
+		char *str =3D os_malloc(attr.dev_name_len + 1);
+		size_t i;
+		if (str =3D=3D NULL)
+			return pos - buf;
+		for (i =3D 0; i < attr.dev_name_len; i++) {
+			if (attr.dev_name[i] < 32)
+				str[i] =3D '_';
+			else
+				str[i] =3D attr.dev_name[i];
+		}
+		str[i] =3D '\0';
+		ret =3D os_snprintf(pos, end - pos, "wps_device_name=3D%s\n", str);
+		os_free(str);
+		if (ret < 0 || ret >=3D end - pos)
+			return pos - buf;
+		pos +=3D ret;
+	}
+
+	if (attr.config_methods) {
+		ret =3D os_snprintf(pos, end - pos,
+				  "wps_config_methods=3D0x%04x\n",
+				  WPA_GET_BE16(attr.config_methods));
+		if (ret < 0 || ret >=3D end - pos)
+			return pos - buf;
+		pos +=3D ret;
+	}
+
+	return pos - buf;
+}
