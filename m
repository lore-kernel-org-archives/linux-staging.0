+static __inline__ int __nat25_add_pppoe_tag(struct sk_buff *skb, struct pp=
poe_tag *tag)
+{
+	struct pppoe_hdr *ph =3D (struct pppoe_hdr *)(skb->data + ETH_HLEN);
+	int data_len;
+
+	data_len =3D be16_to_cpu(tag->tag_len) + TAG_HDR_LEN;
+	if (skb_tailroom(skb) < data_len) {
+		_DEBUG_ERR("skb_tailroom() failed in add SID tag!\n");
+		return -1;
+	}
+
+	skb_put(skb, data_len);
+	/* have a room for new tag */
+	memmove(((unsigned char *)ph->tag + data_len), (unsigned char *)ph->tag, =
ntohs(ph->length));
+	ph->length =3D htons(ntohs(ph->length) + data_len);
+	memcpy((unsigned char *)ph->tag, tag, data_len);
+	return data_len;
+}
