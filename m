+)
+{
+	if (BW =3D=3D CHANNEL_WIDTH_20)
+		BW =3D PHYDM_BW_20;
+
+	else if (BW =3D=3D CHANNEL_WIDTH_40)
+		BW =3D PHYDM_BW_40;
+
+	else if (BW =3D=3D CHANNEL_WIDTH_80)
+		BW =3D PHYDM_BW_80;
+
+	else if (BW =3D=3D CHANNEL_WIDTH_160)
+		BW =3D PHYDM_BW_160;
+
+	else if (BW =3D=3D CHANNEL_WIDTH_80_80)
+		BW =3D PHYDM_BW_80_80;
+
+	return BW;
