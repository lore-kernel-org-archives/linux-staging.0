+/**
+ * rtw_ies_remove_ie - Find matching IEs and remove
+ * @ies: Address of IEs to search
+ * @ies_len: Pointer of length of ies, will update to new length
+ * @offset: The offset to start scarch
+ * @eid: Element ID to match
+ * @oui: OUI to match
+ * @oui_len: OUI length
+ *
+ * Returns: _SUCCESS: ies is updated, _FAIL: not updated
+ */
+int rtw_ies_remove_ie(u8 *ies, uint *ies_len, uint offset, u8 eid, u8 *oui=
, u8 oui_len)
+{
+	int ret =3D _FAIL;
+	u8 *target_ie;
+	u32 target_ielen;
+	u8 *start;
+	uint search_len;
+
+	if (!ies || !ies_len || *ies_len <=3D offset)
+		goto exit;
+
+	start =3D ies + offset;
+	search_len =3D *ies_len - offset;
+
+	while (1) {
+		target_ie =3D rtw_get_ie_ex(start, search_len, eid, oui, oui_len, NULL, =
&target_ielen);
+		if (target_ie && target_ielen) {
+			u8 *remain_ies =3D target_ie + target_ielen;
+			uint remain_len =3D search_len - (remain_ies - start);
+
+			memmove(target_ie, remain_ies, remain_len);
+			*ies_len =3D *ies_len - target_ielen;
+			ret =3D _SUCCESS;
+
+			start =3D target_ie;
+			search_len =3D remain_len;
+		} else
+			break;
+	}
+exit:
+	return ret;
+}
