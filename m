+#ifdef CONFIG_IEEE80211W
+static u8 * wpa_ft_igtk_subelem(struct wpa_state_machine *sm, size_t *len)
+{
+	u8 *subelem, *pos;
+	struct wpa_group *gsm =3D sm->group;
+	size_t subelem_len;
+
+	/* Sub-elem ID[1] | Length[1] | KeyID[2] | IPN[6] | Key Length[1] |
+	 * Key[16+8] */
+	subelem_len =3D 1 + 1 + 2 + 6 + 1 + WPA_IGTK_LEN + 8;
+	subelem =3D os_zalloc(subelem_len);
+	if (subelem =3D=3D NULL)
+		return NULL;
+
+	pos =3D subelem;
+	*pos++ =3D FTIE_SUBELEM_IGTK;
+	*pos++ =3D subelem_len - 2;
+	WPA_PUT_LE16(pos, gsm->GN_igtk);
+	pos +=3D 2;
+	wpa_auth_get_seqnum(sm->wpa_auth, NULL, gsm->GN_igtk, pos);
+	pos +=3D 6;
+	*pos++ =3D WPA_IGTK_LEN;
+	if (aes_wrap(sm->PTK.kek, WPA_IGTK_LEN / 8,
+		     gsm->IGTK[gsm->GN_igtk - 4], pos)) {
+		os_free(subelem);
+		return NULL;
+	}
+
+	*len =3D subelem_len;
+	return subelem;
+}
+#endif /* CONFIG_IEEE80211W */
