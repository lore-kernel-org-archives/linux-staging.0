+	}
+
+	if (found_name < 0 && found_desc >=3D 0) {
+		wpa_printf(MSG_DEBUG, "NDIS: Matched interface '%s' based on "
+			   "description '%s'",
+			   name[found_desc], desc[found_desc]);
+		found_name =3D found_desc;
+		os_strlcpy(drv->ifname,
+			   os_strncmp(name[found_desc], "\\Device\\NPF_", 12)
+			   =3D=3D 0 ? name[found_desc] + 12 : name[found_desc],
+			   sizeof(drv->ifname));
+	}
+
+	if (found_name < 0) {
+		wpa_printf(MSG_DEBUG, "NDIS: Could not find interface '%s'",
+			   drv->ifname);
+		os_free(names);
+		return -1;
+	}
+
+	i =3D found_name;
+	pos =3D os_strrchr(desc[i], '(');
+	if (pos) {
+		dlen =3D pos - desc[i];
+		pos--;
+		if (pos > desc[i] && *pos =3D=3D ' ')
+			dlen--;
+	} else {
+		dlen =3D os_strlen(desc[i]);
+	}
+	drv->adapter_desc =3D os_malloc(dlen + 1);
+	if (drv->adapter_desc) {
+		os_memcpy(drv->adapter_desc, desc[i], dlen);
+		drv->adapter_desc[dlen] =3D '\0';
+	}
+
+	os_free(names);
+
+	if (drv->adapter_desc =3D=3D NULL)
+		return -1;
+
+	wpa_printf(MSG_DEBUG, "NDIS: Adapter description prefix '%s'",
+		   drv->adapter_desc);
+
+	return 0;
+#endif /* CONFIG_USE_NDISUIO */
+}
