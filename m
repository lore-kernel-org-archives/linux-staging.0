+	msg->buf =3D wpabuf_alloc(RADIUS_DEFAULT_MSG_SIZE);
+	if (msg->buf =3D=3D NULL || radius_msg_initialize(msg)) {
+		radius_msg_free(msg);
+		return NULL;
