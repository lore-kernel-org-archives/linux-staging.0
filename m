+	/* wdev->iftype =3D NL80211_IFTYPE_MONITOR; */ /* for rtw_setopmode_cmd()=
 in cfg80211_rtw_change_iface() */
+	padapter->rtw_wdev =3D wdev;
+	pnetdev->ieee80211_ptr =3D wdev;
