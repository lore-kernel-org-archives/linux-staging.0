+u16 rtw_btcoex_parse_recv_data(u8 *msg, u8 msg_size)
+{
+	u8 cmp_msg1[32] =3D attend_ack;
+	u8 cmp_msg2[32] =3D leave_ack;
+	u8 cmp_msg3[32] =3D bt_leave;
+	u8 cmp_msg4[32] =3D invite_req;
+	u8 cmp_msg5[32] =3D attend_req;
+	u8 cmp_msg6[32] =3D invite_rsp;
+	u8 res =3D OTHER;
+
+	if (!memcmp(cmp_msg1, msg, msg_size) =3D=3D true) {
+		/*RTW_INFO("%s, msg:%s\n",__func__,msg);*/
+		res =3D RX_ATTEND_ACK;
+	} else if (!memcmp(cmp_msg2, msg, msg_size) =3D=3D true) {
+		/*RTW_INFO("%s, msg:%s\n",__func__,msg);*/
+		res =3D RX_LEAVE_ACK;
+	} else if (!memcmp(cmp_msg3, msg, msg_size) =3D=3D true) {
+		/*RTW_INFO("%s, msg:%s\n",__func__,msg);*/
+		res =3D RX_BT_LEAVE;
+	} else if (!memcmp(cmp_msg4, msg, msg_size) =3D=3D true) {
+		/*RTW_INFO("%s, msg:%s\n",__func__,msg);*/
+		res =3D RX_INVITE_REQ;
+	} else if (!memcmp(cmp_msg5, msg, msg_size) =3D=3D true)
+		res =3D RX_ATTEND_REQ;
+	else if (!memcmp(cmp_msg6, msg, msg_size) =3D=3D true)
+		res =3D RX_INVITE_RSP;
+	else {
+		/*RTW_INFO("%s, %s\n", __func__, msg);*/
+		res =3D OTHER;
+	}
+
+	/*RTW_INFO("%s, res:%d\n", __func__, res);*/
+
+	return res;
+}
