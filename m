+ */
+
+#ifndef LIST_H
+#define LIST_H
+
+/**
+ * struct dl_list - Doubly-linked list
+ */
+struct dl_list {
+	struct dl_list *next;
+	struct dl_list *prev;
+};
+
+static inline void dl_list_init(struct dl_list *list)
+{
+	list->next =3D list;
+	list->prev =3D list;
+}
+
+static inline void dl_list_add(struct dl_list *list, struct dl_list *item)
+{
+	item->next =3D list->next;
+	item->prev =3D list;
+	list->next->prev =3D item;
+	list->next =3D item;
+}
+
+static inline void dl_list_add_tail(struct dl_list *list, struct dl_list *=
item)
+{
+	dl_list_add(list->prev, item);
+}
+
+static inline void dl_list_del(struct dl_list *item)
+{
+	item->next->prev =3D item->prev;
+	item->prev->next =3D item->next;
+	item->next =3D NULL;
+	item->prev =3D NULL;
+}
+
+static inline int dl_list_empty(struct dl_list *list)
+{
+	return list->next =3D=3D list;
+}
+
+static inline unsigned int dl_list_len(struct dl_list *list)
+{
+	struct dl_list *item;
+	int count =3D 0;
+	for (item =3D list->next; item !=3D list; item =3D item->next)
+		count++;
+	return count;
+}
+
+#ifndef offsetof
+#define offsetof(type, member) ((long) &((type *) 0)->member)
+#endif
+
+#define dl_list_entry(item, type, member) \
+	((type *) ((char *) item - offsetof(type, member)))
+
+#define dl_list_first(list, type, member) \
+	(dl_list_empty((list)) ? NULL : \
+	 dl_list_entry((list)->next, type, member))
+
+#define dl_list_last(list, type, member) \
+	(dl_list_empty((list)) ? NULL : \
+	 dl_list_entry((list)->prev, type, member))
+
+#define dl_list_for_each(item, list, type, member) \
+	for (item =3D dl_list_entry((list)->next, type, member); \
+	     &item->member !=3D (list); \
+	     item =3D dl_list_entry(item->member.next, type, member))
+
+#define dl_list_for_each_safe(item, n, list, type, member) \
+	for (item =3D dl_list_entry((list)->next, type, member), \
+		     n =3D dl_list_entry(item->member.next, type, member); \
+	     &item->member !=3D (list); \
+	     item =3D n, n =3D dl_list_entry(n->member.next, type, member))
+
+#define dl_list_for_each_reverse(item, list, type, member) \
+	for (item =3D dl_list_entry((list)->prev, type, member); \
+	     &item->member !=3D (list); \
+	     item =3D dl_list_entry(item->member.prev, type, member))
+
+#endif /* LIST_H */
