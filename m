+static void phy_CrossReferenceHTAndVHTTxPowerLimit(PADAPTER pAdapter)
+{
+	HAL_DATA_TYPE *pHalData =3D GET_HAL_DATA(pAdapter);
+	u8 regulation, bw, channel, rs, ref_rs;
+	int ht_ref_vht_5g_20_40 =3D 0;
+	int vht_ref_ht_5g_20_40 =3D 0;
+	int ht_has_ref_5g_20_40 =3D 0;
+	int vht_has_ref_5g_20_40 =3D 0;
+
+	pHalData->tx_pwr_lmt_5g_20_40_ref =3D 0;
+
+	for (regulation =3D 0; regulation < MAX_REGULATION_NUM; ++regulation) {
+
+		for (bw =3D 0; bw < MAX_5G_BANDWIDTH_NUM; ++bw) {
+
+			for (channel =3D 0; channel < CENTER_CH_5G_ALL_NUM; ++channel) {
+
+				for (rs =3D 0; rs < MAX_RATE_SECTION_NUM; ++rs) {
+
+					/* 5G 20M 40M VHT and HT can cross reference */
+					if (bw =3D=3D CHANNEL_WIDTH_20 || bw =3D=3D CHANNEL_WIDTH_40) {
+						if (rs =3D=3D HT_1SS)
+							ref_rs =3D VHT_1SS;
+						else if (rs =3D=3D HT_2SS)
+							ref_rs =3D VHT_2SS;
+						else if (rs =3D=3D HT_3SS)
+							ref_rs =3D VHT_3SS;
+						else if (rs =3D=3D HT_4SS)
+							ref_rs =3D VHT_4SS;
+						else if (rs =3D=3D VHT_1SS)
+							ref_rs =3D HT_1SS;
+						else if (rs =3D=3D VHT_2SS)
+							ref_rs =3D HT_2SS;
+						else if (rs =3D=3D VHT_3SS)
+							ref_rs =3D HT_3SS;
+						else if (rs =3D=3D VHT_4SS)
+							ref_rs =3D HT_4SS;
+						else
+							continue;
+
+						if (pHalData->TxPwrLimit_5G[regulation][bw][ref_rs][channel][RF_PATH=
_A] =3D=3D MAX_POWER_INDEX)
+							continue;
+
+						if (IS_HT_RATE_SECTION(rs))
+							ht_has_ref_5g_20_40++;
+						else if (IS_VHT_RATE_SECTION(rs))
+							vht_has_ref_5g_20_40++;
+						else
+							continue;
+
+						if (pHalData->TxPwrLimit_5G[regulation][bw][rs][channel][RF_PATH_A] =
!=3D MAX_POWER_INDEX)
+							continue;
+
+						if (IS_HT_RATE_SECTION(rs) && IS_VHT_RATE_SECTION(ref_rs))
+							ht_ref_vht_5g_20_40++;
+						else if (IS_VHT_RATE_SECTION(rs) && IS_HT_RATE_SECTION(ref_rs))
+							vht_ref_ht_5g_20_40++;
+
+						if (0)
+							RTW_INFO("reg:%u, bw:%u, ch:%u, %s ref %s\n"
+								, regulation, bw, channel
+								, rate_section_str(rs), rate_section_str(ref_rs));
+
+						pHalData->TxPwrLimit_5G[regulation][bw][rs][channel][RF_PATH_A] =3D
+							pHalData->TxPwrLimit_5G[regulation][bw][ref_rs][channel][RF_PATH_A];
+					}
+
+				}
+			}
+		}
+	}
+
+	if (0) {
+		RTW_INFO("ht_ref_vht_5g_20_40:%d, ht_has_ref_5g_20_40:%d\n", ht_ref_vht_=
5g_20_40, ht_has_ref_5g_20_40);
+		RTW_INFO("vht_ref_hht_5g_20_40:%d, vht_has_ref_5g_20_40:%d\n", vht_ref_h=
t_5g_20_40, vht_has_ref_5g_20_40);
+	}
+
+	/* 5G 20M&40M HT all come from VHT*/
+	if (ht_ref_vht_5g_20_40 && ht_has_ref_5g_20_40 =3D=3D ht_ref_vht_5g_20_40)
+		pHalData->tx_pwr_lmt_5g_20_40_ref |=3D TX_PWR_LMT_REF_HT_FROM_VHT;
+
+	/* 5G 20M&40M VHT all come from HT*/
+	if (vht_ref_ht_5g_20_40 && vht_has_ref_5g_20_40 =3D=3D vht_ref_ht_5g_20_4=
0)
+		pHalData->tx_pwr_lmt_5g_20_40_ref |=3D TX_PWR_LMT_REF_VHT_FROM_HT;
+}
