+static u32 sta_flags_nl80211(int flags)
+{
+	u32 f =3D 0;
+
+	if (flags & WPA_STA_AUTHORIZED)
+		f |=3D BIT(NL80211_STA_FLAG_AUTHORIZED);
+	if (flags & WPA_STA_WMM)
+		f |=3D BIT(NL80211_STA_FLAG_WME);
+	if (flags & WPA_STA_SHORT_PREAMBLE)
+		f |=3D BIT(NL80211_STA_FLAG_SHORT_PREAMBLE);
+	if (flags & WPA_STA_MFP)
+		f |=3D BIT(NL80211_STA_FLAG_MFP);
+
+	return f;
+}
