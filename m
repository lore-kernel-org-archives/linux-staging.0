+static int rtw_add_beacon(_adapter *adapter, const u8 *head, size_t head_l=
en, const u8 *tail, size_t tail_len)
+{
+	int ret =3D 0;
+	u8 *pbuf =3D NULL;
+	uint len, wps_ielen =3D 0;
+	uint p2p_ielen =3D 0;
+	u8 *p2p_ie;
+	u8 got_p2p_ie =3D false;
+	struct mlme_priv *pmlmepriv =3D &(adapter->mlmepriv);
+	/* struct sta_priv *pstapriv =3D &padapter->stapriv; */
+
+
+	RTW_INFO("%s beacon_head_len=3D%zu, beacon_tail_len=3D%zu\n", __func__, h=
ead_len, tail_len);
+
+
+	if (check_fwstate(pmlmepriv, WIFI_AP_STATE) !=3D true)
+		return -EINVAL;
+
+	if (head_len < 24)
+		return -EINVAL;
+
+
+	pbuf =3D rtw_zmalloc(head_len + tail_len);
+	if (!pbuf)
+		return -ENOMEM;
+
+
+	/* memcpy(&pstapriv->max_num_sta, param->u.bcn_ie.reserved, 2); */
+
+	/* if((pstapriv->max_num_sta>NUM_STA) || (pstapriv->max_num_sta<=3D0)) */
+	/*	pstapriv->max_num_sta =3D NUM_STA; */
+
+
+	memcpy(pbuf, (void *)head + 24, head_len - 24); /* 24=3Dbeacon header len=
. */
+	memcpy(pbuf + head_len - 24, (void *)tail, tail_len);
+
+	len =3D head_len + tail_len - 24;
+
+	/* check wps ie if inclued */
+	if (rtw_get_wps_ie(pbuf + _FIXED_IE_LENGTH_, len - _FIXED_IE_LENGTH_, NUL=
L, &wps_ielen))
+		RTW_INFO("add bcn, wps_ielen=3D%d\n", wps_ielen);
+
+#ifdef CONFIG_P2P
+	if (adapter->wdinfo.driver_interface =3D=3D DRIVER_CFG80211) {
+		/* check p2p if enable */
+		if (rtw_get_p2p_ie(pbuf + _FIXED_IE_LENGTH_, len - _FIXED_IE_LENGTH_, NU=
LL, &p2p_ielen)) {
+			struct mlme_ext_priv *pmlmeext =3D &adapter->mlmeextpriv;
+			struct wifidirect_info *pwdinfo =3D &(adapter->wdinfo);
+
+			RTW_INFO("got p2p_ie, len=3D%d\n", p2p_ielen);
+
+			got_p2p_ie =3D true;
+
+			if (rtw_p2p_chk_state(pwdinfo, P2P_STATE_NONE)) {
+				RTW_INFO("Enable P2P function for the first time\n");
+				rtw_p2p_enable(adapter, P2P_ROLE_GO);
+
+				adapter->stapriv.expire_to =3D 3; /* 3x2 =3D 6 sec in p2p mode */
+			} else {
+				RTW_INFO("enter GO Mode, p2p_ielen=3D%d\n", p2p_ielen);
+
+				rtw_p2p_set_role(pwdinfo, P2P_ROLE_GO);
+				rtw_p2p_set_state(pwdinfo, P2P_STATE_GONEGO_OK);
+				pwdinfo->intent =3D 15;
+			}
+		}
+	}
+#endif /* CONFIG_P2P */
+
+	/* pbss_network->IEs will not include p2p_ie, wfd ie */
+	rtw_ies_remove_ie(pbuf, &len, _BEACON_IE_OFFSET_, _VENDOR_SPECIFIC_IE_, P=
2P_OUI, 4);
+	rtw_ies_remove_ie(pbuf, &len, _BEACON_IE_OFFSET_, _VENDOR_SPECIFIC_IE_, W=
FD_OUI, 4);
+
+	if (rtw_check_beacon_data(adapter, pbuf,  len) =3D=3D _SUCCESS) {
+#ifdef CONFIG_P2P
+		/* check p2p if enable */
+		if (got_p2p_ie ) {
+			struct mlme_ext_priv *pmlmeext =3D &adapter->mlmeextpriv;
+			struct wifidirect_info *pwdinfo =3D &(adapter->wdinfo);
+			pwdinfo->operating_channel =3D pmlmeext->cur_channel;
+		}
+#endif /* CONFIG_P2P */
+		ret =3D 0;
+	} else
+		ret =3D -EINVAL;
+
+
+	rtw_mfree(pbuf, head_len + tail_len);
+
+	return ret;
+}
