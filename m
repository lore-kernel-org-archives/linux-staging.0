+static int tls_load_ca_der(void *_ssl_ctx, const char *ca_cert)
+{
+	SSL_CTX *ssl_ctx =3D _ssl_ctx;
+	X509_LOOKUP *lookup;
+	int ret =3D 0;
+
+	lookup =3D X509_STORE_add_lookup(ssl_ctx->cert_store,
+				       X509_LOOKUP_file());
+	if (lookup =3D=3D NULL) {
