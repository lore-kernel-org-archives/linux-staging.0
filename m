+static struct dvobj_priv *usb_dvobj_init(struct usb_interface *usb_intf, c=
onst struct usb_device_id *pdid)
+{
+	int	i;
+	u8	val8;
+	int	status =3D _FAIL;
+	struct dvobj_priv *pdvobjpriv;
+	struct usb_device_descriptor	*pdev_desc;
+	struct usb_host_config			*phost_conf;
+	struct usb_config_descriptor		*pconf_desc;
+	struct usb_host_interface		*phost_iface;
+	struct usb_interface_descriptor	*piface_desc;
+	struct usb_host_endpoint		*phost_endp;
+	struct usb_endpoint_descriptor	*pendp_desc;
+	struct usb_device				*pusbd;
+
+
+
+	pdvobjpriv =3D devobj_init();
+	if (pdvobjpriv =3D=3D NULL)
+		goto exit;
+
+
+	pdvobjpriv->pusbintf =3D usb_intf ;
+	pusbd =3D pdvobjpriv->pusbdev =3D interface_to_usbdev(usb_intf);
+	usb_set_intfdata(usb_intf, pdvobjpriv);
+
+	pdvobjpriv->RtNumInPipes =3D 0;
+	pdvobjpriv->RtNumOutPipes =3D 0;
+
+	pdev_desc =3D &pusbd->descriptor;
+
+	phost_conf =3D pusbd->actconfig;
+	pconf_desc =3D &phost_conf->desc;
+
+	phost_iface =3D &usb_intf->altsetting[0];
+	piface_desc =3D &phost_iface->desc;
+
+	pdvobjpriv->NumInterfaces =3D pconf_desc->bNumInterfaces;
+	pdvobjpriv->InterfaceNumber =3D piface_desc->bInterfaceNumber;
+	pdvobjpriv->nr_endpoint =3D piface_desc->bNumEndpoints;
+
+	for (i =3D 0; i < pdvobjpriv->nr_endpoint; i++) {
+		phost_endp =3D phost_iface->endpoint + i;
+		if (phost_endp) {
+			pendp_desc =3D &phost_endp->desc;
+
+			RTW_INFO("\nusb_endpoint_descriptor(%d):\n", i);
+			RTW_INFO("bLength=3D%x\n", pendp_desc->bLength);
+			RTW_INFO("bDescriptorType=3D%x\n", pendp_desc->bDescriptorType);
+			RTW_INFO("bEndpointAddress=3D%x\n", pendp_desc->bEndpointAddress);
+			RTW_INFO("wMaxPacketSize=3D%d\n", le16_to_cpu(pendp_desc->wMaxPacketSiz=
e));
+			RTW_INFO("bInterval=3D%x\n", pendp_desc->bInterval);
+
+			if (RT_usb_endpoint_is_bulk_in(pendp_desc)) {
+				RTW_INFO("RT_usb_endpoint_is_bulk_in =3D %x\n", RT_usb_endpoint_num(pe=
ndp_desc));
+				pdvobjpriv->RtInPipe[pdvobjpriv->RtNumInPipes] =3D RT_usb_endpoint_num=
(pendp_desc);
+				pdvobjpriv->RtNumInPipes++;
+			} else if (RT_usb_endpoint_is_int_in(pendp_desc)) {
+				RTW_INFO("RT_usb_endpoint_is_int_in =3D %x, Interval =3D %x\n", RT_usb=
_endpoint_num(pendp_desc), pendp_desc->bInterval);
+				pdvobjpriv->RtInPipe[pdvobjpriv->RtNumInPipes] =3D RT_usb_endpoint_num=
(pendp_desc);
+				pdvobjpriv->RtNumInPipes++;
+			} else if (RT_usb_endpoint_is_bulk_out(pendp_desc)) {
+				RTW_INFO("RT_usb_endpoint_is_bulk_out =3D %x\n", RT_usb_endpoint_num(p=
endp_desc));
+				pdvobjpriv->RtOutPipe[pdvobjpriv->RtNumOutPipes] =3D RT_usb_endpoint_n=
um(pendp_desc);
+				pdvobjpriv->RtNumOutPipes++;
+			}
+			pdvobjpriv->ep_num[i] =3D RT_usb_endpoint_num(pendp_desc);
+		}
+	}
+
+	RTW_INFO("nr_endpoint=3D%d, in_num=3D%d, out_num=3D%d\n\n", pdvobjpriv->n=
r_endpoint, pdvobjpriv->RtNumInPipes, pdvobjpriv->RtNumOutPipes);
+
+	switch (pusbd->speed) {
+	case USB_SPEED_LOW:
+		RTW_INFO("USB_SPEED_LOW\n");
+		pdvobjpriv->usb_speed =3D RTW_USB_SPEED_1_1;
+		break;
+	case USB_SPEED_FULL:
+		RTW_INFO("USB_SPEED_FULL\n");
+		pdvobjpriv->usb_speed =3D RTW_USB_SPEED_1_1;
+		break;
+	case USB_SPEED_HIGH:
+		RTW_INFO("USB_SPEED_HIGH\n");
+		pdvobjpriv->usb_speed =3D RTW_USB_SPEED_2;
+		break;
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 31))
+	case USB_SPEED_SUPER:
+		RTW_INFO("USB_SPEED_SUPER\n");
+		pdvobjpriv->usb_speed =3D RTW_USB_SPEED_3;
+		break;
+#endif
+	default:
+		RTW_INFO("USB_SPEED_UNKNOWN(%x)\n", pusbd->speed);
+		pdvobjpriv->usb_speed =3D RTW_USB_SPEED_UNKNOWN;
+		break;
+	}
+
+	if (pdvobjpriv->usb_speed =3D=3D RTW_USB_SPEED_UNKNOWN) {
+		RTW_INFO("UNKNOWN USB SPEED MODE, ERROR !!!\n");
+		goto free_dvobj;
+	}
+
+	if (rtw_init_intf_priv(pdvobjpriv) =3D=3D _FAIL) {
+		goto free_dvobj;
+	}
+
+	/*step 1-1., decide the chip_type via driver_info*/
+	pdvobjpriv->interface_type =3D RTW_USB;
+	rtw_decide_chip_type_by_usb_info(pdvobjpriv, pdid);
+
+	/* .3 misc */
+	sema_init(&(pdvobjpriv->usb_suspend_sema), 0);
+	rtw_reset_continual_io_error(pdvobjpriv);
+
+	usb_get_dev(pusbd);
+
+	status =3D _SUCCESS;
+
+free_dvobj:
+	if (status !=3D _SUCCESS && pdvobjpriv) {
+		usb_set_intfdata(usb_intf, NULL);
+
+		devobj_deinit(pdvobjpriv);
+
+		pdvobjpriv =3D NULL;
+	}
+exit:
+	return pdvobjpriv;
+}
