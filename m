+static void session_tracker_chk_for_sta(_adapter *adapter, struct sta_info=
 *sta)
+{
+	struct st_ctl_t *st_ctl =3D &sta->st_ctl;
+	int i;
+	unsigned long irqL;
+	_list *plist, *phead, *pnext;
+	_list dlist;
+	struct session_tracker *st =3D NULL;
+	u8 op_wfd_mode =3D MIRACAST_DISABLED;
+
+	if (DBG_SESSION_TRACKER)
+		RTW_INFO(FUNC_ADPT_FMT" sta:%p\n", FUNC_ADPT_ARG(adapter), sta);
+
+	if (!(sta->state & _FW_LINKED))
+		goto exit;
+
+	for (i =3D 0; i < SESSION_TRACKER_REG_ID_NUM; i++) {
+		if (st_ctl->reg[i].s_proto !=3D 0)
+			break;
+	}
+	if (i >=3D SESSION_TRACKER_REG_ID_NUM)
+		goto chk_sta;
+
+	INIT_LIST_HEAD(&dlist);
+
+	_enter_critical_bh(&st_ctl->tracker_q.lock, &irqL);
+
+	phead =3D &st_ctl->tracker_q.queue;
+	plist =3D get_next(phead);
+	pnext =3D get_next(plist);
+	while (rtw_end_of_queue_search(phead, plist) =3D=3D false) {
+		st =3D LIST_CONTAINOR(plist, struct session_tracker, list);
+		plist =3D pnext;
+		pnext =3D get_next(pnext);
+
+		if (st->status !=3D ST_STATUS_ESTABLISH
+			&& rtw_get_passing_time_ms(st->set_time) > ST_EXPIRE_MS
+		) {
+			list_del_init(&st->list);
+			list_add_tail(&st->list, &dlist);
+		}
+
+		/* TODO: check OS for status update */
+		if (st->status =3D=3D ST_STATUS_CHECK)
+			st->status =3D ST_STATUS_ESTABLISH;
+
+		if (st->status !=3D ST_STATUS_ESTABLISH)
+			continue;
+
+		#ifdef CONFIG_WFD
+		if (ntohs(st->local_port) =3D=3D adapter->wfd_info.rtsp_ctrlport)
+			op_wfd_mode |=3D MIRACAST_SINK;
+		if (ntohs(st->local_port) =3D=3D adapter->wfd_info.tdls_rtsp_ctrlport)
+			op_wfd_mode |=3D MIRACAST_SINK;
+		if (ntohs(st->remote_port) =3D=3D adapter->wfd_info.peer_rtsp_ctrlport)
+			op_wfd_mode |=3D MIRACAST_SOURCE;
+		#endif
+	}
+
+	_exit_critical_bh(&st_ctl->tracker_q.lock, &irqL);
+
+	plist =3D get_next(&dlist);
+	while (rtw_end_of_queue_search(&dlist, plist) =3D=3D false) {
+		st =3D LIST_CONTAINOR(plist, struct session_tracker, list);
+		plist =3D get_next(plist);
+		rtw_mfree((u8 *)st, sizeof(struct session_tracker));
+	}
+
+chk_sta:
+	if (STA_OP_WFD_MODE(sta) !=3D op_wfd_mode) {
+		STA_SET_OP_WFD_MODE(sta, op_wfd_mode);
+		rtw_sta_media_status_rpt_cmd(adapter, sta, 1);
+	}
+
+exit:
+	return;
+}
+
+static void session_tracker_chk_for_adapter(_adapter *adapter)
+{
+	struct sta_priv *stapriv =3D &adapter->stapriv;
+	struct sta_info *sta;
+	int i;
+	unsigned long irqL;
+	_list *plist, *phead;
+	u8 op_wfd_mode =3D MIRACAST_DISABLED;
+
+	_enter_critical_bh(&stapriv->sta_hash_lock, &irqL);
+
+	for (i =3D 0; i < NUM_STA; i++) {
+		phead =3D &(stapriv->sta_hash[i]);
+		plist =3D get_next(phead);
+
+		while ((rtw_end_of_queue_search(phead, plist)) =3D=3D false) {
+			sta =3D LIST_CONTAINOR(plist, struct sta_info, hash_list);
+			plist =3D get_next(plist);
+
+			session_tracker_chk_for_sta(adapter, sta);
+
+			op_wfd_mode |=3D STA_OP_WFD_MODE(sta);
+		}
+	}
+
+	_exit_critical_bh(&stapriv->sta_hash_lock, &irqL);
+
+#ifdef CONFIG_WFD
+	adapter->wfd_info.op_wfd_mode =3D MIRACAST_MODE_REVERSE(op_wfd_mode);
+#endif
+}
