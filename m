+void rtw_report_sec_ie(_adapter *adapter, u8 authmode, u8 *sec_ie)
+{
+	uint	len;
+	u8	*buff, *p, i;
+	union iwreq_data wrqu;
+
+
+
+	buff =3D NULL;
+	if (authmode =3D=3D _WPA_IE_ID_) {
+
+		buff =3D rtw_zmalloc(IW_CUSTOM_MAX);
+		if (NULL =3D=3D buff) {
+			RTW_INFO(FUNC_ADPT_FMT ": alloc memory FAIL!!\n",
+				 FUNC_ADPT_ARG(adapter));
+			return;
+		}
+		p =3D buff;
+
+		p +=3D sprintf(p, "ASSOCINFO(ReqIEs=3D");
+
+		len =3D sec_ie[1] + 2;
+		len =3D (len < IW_CUSTOM_MAX) ? len : IW_CUSTOM_MAX;
+
+		for (i =3D 0; i < len; i++)
+			p +=3D sprintf(p, "%02x", sec_ie[i]);
+
+		p +=3D sprintf(p, ")");
+
+		memset(&wrqu, 0, sizeof(wrqu));
+
+		wrqu.data.length =3D p - buff;
+
+		wrqu.data.length =3D (wrqu.data.length < IW_CUSTOM_MAX) ? wrqu.data.leng=
th : IW_CUSTOM_MAX;
+
+#ifndef CONFIG_IOCTL_CFG80211
+		wireless_send_event(adapter->pnetdev, IWEVCUSTOM, &wrqu, buff);
+#endif
+
+		rtw_mfree(buff, IW_CUSTOM_MAX);
