+static int tncs_get_type(char *start, unsigned int *type)
+{
+	char *pos =3D os_strstr(start, "<Type>");
+	if (pos =3D=3D NULL)
+		return -1;
+	pos +=3D 6;
+	*type =3D strtoul(pos, NULL, 16);
+	return 0;
+}
