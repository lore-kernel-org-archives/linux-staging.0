+static u8 _rtw_set_chplan_cmd(_adapter *adapter, int flags, u8 chplan, con=
st struct country_chplan *country_ent, u8 swconfig)
+{
+	struct cmd_obj *cmdobj;
+	struct	SetChannelPlan_param *parm;
+	struct cmd_priv *pcmdpriv =3D &adapter->cmdpriv;
+	struct mlme_priv *pmlmepriv =3D &adapter->mlmepriv;
+	struct submit_ctx sctx;
+	u8 res =3D _SUCCESS;
+
+
+	/* check if allow software config */
+	if (swconfig && rtw_hal_is_disable_sw_channel_plan(adapter)) {
+		res =3D _FAIL;
+		goto exit;
+	}
+
+	/* if country_entry is provided, replace chplan */
+	if (country_ent)
+		chplan =3D country_ent->chplan;
+
+	/* check input parameter */
+	if (!rtw_is_channel_plan_valid(chplan)) {
+		res =3D _FAIL;
+		goto exit;
+	}
+
+	/* prepare cmd parameter */
+	parm =3D (struct SetChannelPlan_param *)rtw_zmalloc(sizeof(*parm));
+	if (!parm) {
+		res =3D _FAIL;
+		goto exit;
+	}
+	parm->country_ent =3D country_ent;
+	parm->channel_plan =3D chplan;
+
+	if (flags & RTW_CMDF_DIRECTLY) {
+		/* no need to enqueue, do the cmd hdl directly and free cmd parameter */
+		if (set_chplan_hdl(adapter, (u8 *)parm) !=3D H2C_SUCCESS)
+			res =3D _FAIL;
+		rtw_mfree((u8 *)parm, sizeof(*parm));
+	} else {
+		/* need enqueue, prepare cmd_obj and enqueue */
+		cmdobj =3D (struct cmd_obj *)rtw_zmalloc(sizeof(*cmdobj));
+		if (!cmdobj) {
+			res =3D _FAIL;
+			rtw_mfree((u8 *)parm, sizeof(*parm));
+			goto exit;
+		}
+
+		init_h2fwcmd_w_parm_no_rsp(cmdobj, parm, GEN_CMD_CODE(_SetChannelPlan));
+
+		if (flags & RTW_CMDF_WAIT_ACK) {
+			cmdobj->sctx =3D &sctx;
+			rtw_sctx_init(&sctx, 2000);
+		}
+
+		res =3D rtw_enqueue_cmd(pcmdpriv, cmdobj);
+
+		if (res =3D=3D _SUCCESS && (flags & RTW_CMDF_WAIT_ACK)) {
+			rtw_sctx_wait(&sctx, __func__);
+			_enter_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+			if (sctx.status =3D=3D RTW_SCTX_SUBMITTED)
+				cmdobj->sctx =3D NULL;
+			_exit_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+		}
+	}
+
+exit:
+	return res;
+}
