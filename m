+			/*	Match the device address located in the P2P IE */
+			/*	This is for the case that the P2P device address is not the same as =
the P2P interface address. */
+
+			p2pie =3D rtw_bss_ex_get_p2p_ie(&pnetwork->network, NULL, &p2pielen);
+			if (p2pie) {
+				while (p2pie) {
+					/* memset( attr_content, 0x00, 2); */
+					if (rtw_get_p2p_attr_content(p2pie, p2pielen, P2P_ATTR_CAPABILITY, at=
tr_content, &attr_contentlen)) {
+						/*	Handle the P2P capability attribute */
+						blnMatch =3D 1;
+						break;
+
+					}
+
+					/* Get the next P2P IE */
+					p2pie =3D rtw_get_p2p_ie(p2pie + p2pielen, BSS_EX_TLV_IES_LEN(&pnetwo=
rk->network) - (p2pie + p2pielen - BSS_EX_TLV_IES(&pnetwork->network)), NUL=
L, &p2pielen);
+				}
+			}
+		}
+
+		plist =3D get_next(plist);
+
+	}
+
+	_exit_critical_bh(&(pmlmepriv->scanned_queue.lock), &irqL);
+
+	if (!blnMatch)
+		sprintf(inv_proc_str, "\nIP=3D-1");
+	else {
+		if ((attr_content[0] & 0x20) =3D=3D 0x20)
+			sprintf(inv_proc_str, "\nIP=3D1");
+		else
+			sprintf(inv_proc_str, "\nIP=3D0");
+	}
+
+	wrqu->data.length =3D strlen(inv_proc_str);
+	memcpy(extra, inv_proc_str, wrqu->data.length);
+
+	return ret;
+
