+static int cfg80211_rtw_add_key(struct wiphy *wiphy, struct net_device *nd=
ev,
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 37)) || defined(COMPAT_K=
ERNEL_RELEASE)
+	u8 key_index, bool pairwise, const u8 *mac_addr,
+#else	/* (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 37)) */
+	u8 key_index, const u8 *mac_addr,
+#endif /* (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 37)) */
+	struct key_params *params)
+{
+	char *alg_name;
+	u32 param_len;
+	struct ieee_param *param =3D NULL;
+	int ret =3D 0;
+	_adapter *padapter =3D (_adapter *)rtw_netdev_priv(ndev);
+	struct wireless_dev *rtw_wdev =3D padapter->rtw_wdev;
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+#ifdef CONFIG_TDLS
+	struct sta_info *ptdls_sta;
+#endif /* CONFIG_TDLS */
+
+	RTW_INFO(FUNC_NDEV_FMT" adding key for %pM\n", FUNC_NDEV_ARG(ndev), mac_a=
ddr);
+	RTW_INFO("cipher=3D0x%x\n", params->cipher);
+	RTW_INFO("key_len=3D0x%x\n", params->key_len);
+	RTW_INFO("seq_len=3D0x%x\n", params->seq_len);
+	RTW_INFO("key_index=3D%d\n", key_index);
+#if (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 37)) || defined(COMPAT_K=
ERNEL_RELEASE)
+	RTW_INFO("pairwise=3D%d\n", pairwise);
+#endif /* (LINUX_VERSION_CODE >=3D KERNEL_VERSION(2, 6, 37)) */
+
+	param_len =3D sizeof(struct ieee_param) + params->key_len;
+	param =3D (struct ieee_param *)rtw_malloc(param_len);
+	if (param =3D=3D NULL)
+		return -1;
+
+	memset(param, 0, param_len);
+
+	param->cmd =3D IEEE_CMD_SET_ENCRYPTION;
+	memset(param->sta_addr, 0xff, ETH_ALEN);
+
+	switch (params->cipher) {
+	case IW_AUTH_CIPHER_NONE:
+		/* todo: remove key */
+		/* remove =3D 1;	 */
+		alg_name =3D "none";
+		break;
+	case WLAN_CIPHER_SUITE_WEP40:
+	case WLAN_CIPHER_SUITE_WEP104:
+		alg_name =3D "WEP";
+		break;
+	case WLAN_CIPHER_SUITE_TKIP:
+		alg_name =3D "TKIP";
+		break;
+	case WLAN_CIPHER_SUITE_CCMP:
+		alg_name =3D "CCMP";
+		break;
+#ifdef CONFIG_IEEE80211W
+	case WLAN_CIPHER_SUITE_AES_CMAC:
+		alg_name =3D "BIP";
+		break;
+#endif /* CONFIG_IEEE80211W */
+#ifdef CONFIG_WAPI_SUPPORT
+	case WLAN_CIPHER_SUITE_SMS4:
+		alg_name =3D "SMS4";
+		if (pairwise =3D=3D NL80211_KEYTYPE_PAIRWISE) {
+			if (key_index !=3D 0 && key_index !=3D 1) {
+				ret =3D -ENOTSUPP;
+				goto addkey_end;
+			}
+			memcpy((void *)param->sta_addr, (void *)mac_addr, ETH_ALEN);
+		} else
+			RTW_INFO("mac_addr is null\n");
+		RTW_INFO("rtw_wx_set_enc_ext: SMS4 case\n");
+		break;
+#endif
+
+	default:
+		ret =3D -ENOTSUPP;
+		goto addkey_end;
+	}
+
+	strncpy((char *)param->u.crypt.alg, alg_name, IEEE_CRYPT_ALG_NAME_LEN);
+
+
+	if (!mac_addr || is_broadcast_ether_addr(mac_addr)) {
+		param->u.crypt.set_tx =3D 0; /* for wpa/wpa2 group key */
+	} else {
+		param->u.crypt.set_tx =3D 1; /* for wpa/wpa2 pairwise key */
+	}
+
+
+	/* param->u.crypt.idx =3D key_index - 1; */
+	param->u.crypt.idx =3D key_index;
+
+	if (params->seq_len && params->seq)
+		memcpy(param->u.crypt.seq, (u8 *)params->seq, params->seq_len);
+
+	if (params->key_len && params->key) {
+		param->u.crypt.key_len =3D params->key_len;
+		memcpy(param->u.crypt.key, (u8 *)params->key, params->key_len);
+	}
+
+	if (check_fwstate(pmlmepriv, WIFI_STATION_STATE) ) {
+#ifdef CONFIG_TDLS
+		if (rtw_tdls_is_driver_setup(padapter) =3D=3D false && mac_addr) {
+			ptdls_sta =3D rtw_get_stainfo(&padapter->stapriv, (void *)mac_addr);
+			if (ptdls_sta !=3D NULL && ptdls_sta->tdls_sta_state) {
+				memcpy(ptdls_sta->tpk.tk, params->key, params->key_len);
+				rtw_tdls_set_key(padapter, ptdls_sta);
+				goto addkey_end;
+			}
+		}
+#endif /* CONFIG_TDLS */
+
+		ret =3D  rtw_cfg80211_set_encryption(ndev, param, param_len);
+	} else if (check_fwstate(pmlmepriv, WIFI_AP_STATE) ) {
+#ifdef CONFIG_AP_MODE
+		if (mac_addr)
+			memcpy(param->sta_addr, (void *)mac_addr, ETH_ALEN);
+
+		ret =3D rtw_cfg80211_ap_set_encryption(ndev, param, param_len);
+#endif
+	} else if (check_fwstate(pmlmepriv, WIFI_ADHOC_STATE)=20
+		|| check_fwstate(pmlmepriv, WIFI_ADHOC_MASTER_STATE)=20
+	) {
+		/* RTW_INFO("@@@@@@@@@@ fw_state=3D0x%x, iftype=3D%d\n", pmlmepriv->fw_s=
tate, rtw_wdev->iftype); */
+		ret =3D  rtw_cfg80211_set_encryption(ndev, param, param_len);
+	} else
+		RTW_INFO("error! fw_state=3D0x%x, iftype=3D%d\n", pmlmepriv->fw_state, r=
tw_wdev->iftype);
+
+
+addkey_end:
+	if (param)
+		rtw_mfree((u8 *)param, param_len);
+
+	return ret;
+
+}
