+void rtw_sec_write_cam_ent(_adapter *adapter, u8 id, u16 ctrl, u8 *mac, u8=
 *key)
+{
+	unsigned int i;
+	int j;
+	u8 addr;
+	u32 wdata;
+
+	/* TODO: consider other key length accordingly */
+	j =3D 7;
+
+	for (; j >=3D 0; j--) {
+		switch (j) {
+		case 0:
+			wdata =3D (ctrl | (mac[0] << 16) | (mac[1] << 24));
+			break;
+		case 1:
+			wdata =3D (mac[2] | (mac[3] << 8) | (mac[4] << 16) | (mac[5] << 24));
+			break;
+		case 6:
+		case 7:
+			wdata =3D 0;
+			break;
+		default:
+			i =3D (j - 2) << 2;
+			wdata =3D (key[i] | (key[i + 1] << 8) | (key[i + 2] << 16) | (key[i + 3=
] << 24));
+			break;
+		}
+
+		addr =3D (id << 3) + j;
+
+		rtw_sec_write_cam(adapter, addr, wdata);
+	}
+}
