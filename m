+	HAL_DATA_TYPE *pHalData =3D GET_HAL_DATA(Adapter);
+	struct mlme_priv *pmlmepriv =3D &(Adapter->mlmepriv);
+
+	if (*((u8 *)val) =3D=3D _HW_STATE_MONITOR_) {
+
+		/* Receive all type */
+		rcr_bits =3D RCR_AAP | RCR_APM | RCR_AM | RCR_AB | RCR_APWRMGT | RCR_ADF=
 | RCR_ACF | RCR_AMF | RCR_APP_PHYST_RXFF;
+
+		/* Append FCS */
+		rcr_bits |=3D RCR_APPFCS;
+
+		/* Receive all data frames */
+		value_rxfltmap2 =3D 0xFFFF;
+
+		value_rcr =3D rcr_bits;
+		rtw_write32(Adapter, REG_RCR, value_rcr);
+
+		rtw_write16(Adapter, REG_RXFLTMAP2, value_rxfltmap2);
+	} else {
+		/* do nothing */
+	}
