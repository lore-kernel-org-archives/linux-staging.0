+u16 hostapd_own_capab_info(struct hostapd_data *hapd, struct sta_info *sta,
+			   int probe)
+{
+	int capab =3D WLAN_CAPABILITY_ESS;
+	int privacy;
+
+	if (hapd->iface->num_sta_no_short_preamble =3D=3D 0 &&
+	    hapd->iconf->preamble =3D=3D SHORT_PREAMBLE)
+		capab |=3D WLAN_CAPABILITY_SHORT_PREAMBLE;
+
+	privacy =3D hapd->conf->ssid.wep.keys_set;
+
+	if (hapd->conf->ieee802_1x &&
+	    (hapd->conf->default_wep_key_len ||
+	     hapd->conf->individual_wep_key_len))
+		privacy =3D 1;
+
+	if (hapd->conf->wpa)
+		privacy =3D 1;
+
+	if (sta) {
+		int policy, def_klen;
+		if (probe && sta->ssid_probe) {
+			policy =3D sta->ssid_probe->security_policy;
+			def_klen =3D sta->ssid_probe->wep.default_len;
+		} else {
+			policy =3D sta->ssid->security_policy;
+			def_klen =3D sta->ssid->wep.default_len;
+		}
+		privacy =3D policy !=3D SECURITY_PLAINTEXT;
+		if (policy =3D=3D SECURITY_IEEE_802_1X && def_klen =3D=3D 0)
+			privacy =3D 0;
+	}
+
+	if (privacy)
+		capab |=3D WLAN_CAPABILITY_PRIVACY;
+
+	if (hapd->iface->current_mode &&
+	    hapd->iface->current_mode->mode =3D=3D HOSTAPD_MODE_IEEE80211G &&
+	    hapd->iface->num_sta_no_short_slot_time =3D=3D 0)
+		capab |=3D WLAN_CAPABILITY_SHORT_SLOT_TIME;
+
+	return capab;
+}
+
+
+u8 * hostapd_eid_ext_capab(struct hostapd_data *hapd, u8 *eid)
+{
+	u8 *pos =3D eid;
+
+	if ((hapd->conf->tdls & (TDLS_PROHIBIT | TDLS_PROHIBIT_CHAN_SWITCH)) =3D=
=3D
+	    0)
+		return eid;
+
+	*pos++ =3D WLAN_EID_EXT_CAPAB;
+	*pos++ =3D 5;
+	*pos++ =3D 0x00;
+	*pos++ =3D 0x00;
+	*pos++ =3D 0x00;
+	*pos++ =3D 0x00;
+	*pos =3D 0x00;
+	if (hapd->conf->tdls & TDLS_PROHIBIT)
+		*pos |=3D 0x40; /* Bit 38 - TDLS Prohibited */
+	if (hapd->conf->tdls & TDLS_PROHIBIT_CHAN_SWITCH)
+		*pos |=3D 0x80; /* Bit 39 - TDLS Channel Switching Prohibited */
+	pos++;
+
+	return pos;
+}
