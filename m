+static void radius_retry_primary_timer(void *eloop_ctx, void *timeout_ctx)
+{
+	struct radius_client_data *radius =3D eloop_ctx;
+	struct hostapd_radius_servers *conf =3D radius->conf;
+	struct hostapd_radius_server *oserv;
+
+	if (radius->auth_sock >=3D 0 && conf->auth_servers &&
+	    conf->auth_server !=3D conf->auth_servers) {
+		oserv =3D conf->auth_server;
+		conf->auth_server =3D conf->auth_servers;
+		radius_change_server(radius, conf->auth_server, oserv,
+				     radius->auth_serv_sock,
+				     radius->auth_serv_sock6, 1);
+	}
+
+	if (radius->acct_sock >=3D 0 && conf->acct_servers &&
+	    conf->acct_server !=3D conf->acct_servers) {
+		oserv =3D conf->acct_server;
+		conf->acct_server =3D conf->acct_servers;
+		radius_change_server(radius, conf->acct_server, oserv,
+				     radius->acct_serv_sock,
+				     radius->acct_serv_sock6, 0);
+	}
+
+	if (conf->retry_primary_interval)
+		eloop_register_timeout(conf->retry_primary_interval, 0,
+				       radius_retry_primary_timer, radius,
+				       NULL);
+}
