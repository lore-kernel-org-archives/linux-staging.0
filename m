+void rtw_sta_media_status_rpt(_adapter *adapter, struct sta_info *sta, boo=
l connected)
+{
+	struct macid_ctl_t *macid_ctl =3D &adapter->dvobj->macid_ctl;
+	bool miracast_enabled =3D 0;
+	bool miracast_sink =3D 0;
+	u8 role =3D H2C_MSR_ROLE_RSVD;
+
+	if (sta =3D=3D NULL) {
+		RTW_PRINT(FUNC_ADPT_FMT" sta is NULL\n"
+			  , FUNC_ADPT_ARG(adapter));
+		rtw_warn_on(1);
+		return;
+	}
+
+	if (sta->mac_id >=3D macid_ctl->num) {
+		RTW_PRINT(FUNC_ADPT_FMT" invalid macid:%u\n"
+			  , FUNC_ADPT_ARG(adapter), sta->mac_id);
+		rtw_warn_on(1);
+		return;
+	}
+
+	if (!rtw_macid_is_used(macid_ctl, sta->mac_id)) {
+		RTW_PRINT(FUNC_ADPT_FMT" macid:%u not is used, set connected to 0\n"
+			  , FUNC_ADPT_ARG(adapter), sta->mac_id);
+		connected =3D 0;
+		rtw_warn_on(1);
+	}
+
+	if (connected && !rtw_macid_is_bmc(macid_ctl, sta->mac_id)) {
+		miracast_enabled =3D STA_OP_WFD_MODE(sta) !=3D 0 && is_miracast_enabled(=
adapter);
+		miracast_sink =3D miracast_enabled && (STA_OP_WFD_MODE(sta) & MIRACAST_S=
INK);
+
+#ifdef CONFIG_TDLS
+		if (sta->tdls_sta_state & TDLS_LINKED_STATE)
+			role =3D H2C_MSR_ROLE_TDLS;
+		else
+#endif
+			if (MLME_IS_STA(adapter)) {
+				if (MLME_IS_GC(adapter))
+					role =3D H2C_MSR_ROLE_GO;
+				else
+					role =3D H2C_MSR_ROLE_AP;
+			} else if (MLME_IS_AP(adapter)) {
+				if (MLME_IS_GO(adapter))
+					role =3D H2C_MSR_ROLE_GC;
+				else
+					role =3D H2C_MSR_ROLE_STA;
+			} else if (MLME_IS_ADHOC(adapter) || MLME_IS_ADHOC_MASTER(adapter))
+				role =3D H2C_MSR_ROLE_ADHOC;
+
+#ifdef CONFIG_WFD
+		if (role =3D=3D H2C_MSR_ROLE_GC
+		    || role =3D=3D H2C_MSR_ROLE_GO
+		    || role =3D=3D H2C_MSR_ROLE_TDLS
+		   ) {
+			if (adapter->wfd_info.rtsp_ctrlport
+			    || adapter->wfd_info.tdls_rtsp_ctrlport
+			    || adapter->wfd_info.peer_rtsp_ctrlport)
+				rtw_wfd_st_switch(sta, 1);
+		}
+#endif
+	}
+
+	rtw_hal_set_FwMediaStatusRpt_single_cmd(adapter
+						, connected
+						, miracast_enabled
+						, miracast_sink
+						, role
+						, sta->mac_id
+					       );
+}
