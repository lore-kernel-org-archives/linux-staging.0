+void rtw_secmicappendbyte(struct mic_data *pmicdata, u8 b)
+{
+	/* Append the byte to our word-sized buffer */
+	pmicdata->M |=3D ((unsigned long)b) << (8 * pmicdata->nBytesInM);
+	pmicdata->nBytesInM++;
+	/* Process the word if it is full. */
+	if (pmicdata->nBytesInM >=3D 4) {
+		pmicdata->L ^=3D pmicdata->M;
+		pmicdata->R ^=3D ROL32(pmicdata->L, 17);
+		pmicdata->L +=3D pmicdata->R;
+		pmicdata->R ^=3D ((pmicdata->L & 0xff00ff00) >> 8) | ((pmicdata->L & 0x0=
0ff00ff) << 8);
+		pmicdata->L +=3D pmicdata->R;
