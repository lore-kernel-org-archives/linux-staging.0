+static int hapd_wps_cred_cb(struct hostapd_data *hapd, void *ctx)
+{
+	const struct wps_credential *cred =3D ctx;
+	FILE *oconf, *nconf;
+	size_t len, i;
+	char *tmp_fname;
+	char buf[1024];
+	int multi_bss;
+	int wpa;
+
+	if (hapd->wps =3D=3D NULL)
+		return 0;
+
+	wpa_hexdump_key(MSG_DEBUG, "WPS: Received Credential attribute",
+			cred->cred_attr, cred->cred_attr_len);
+
+	wpa_printf(MSG_DEBUG, "WPS: Received new AP Settings");
+	wpa_hexdump_ascii(MSG_DEBUG, "WPS: SSID", cred->ssid, cred->ssid_len);
+	wpa_printf(MSG_DEBUG, "WPS: Authentication Type 0x%x",
+		   cred->auth_type);
+	wpa_printf(MSG_DEBUG, "WPS: Encryption Type 0x%x", cred->encr_type);
+	wpa_printf(MSG_DEBUG, "WPS: Network Key Index %d", cred->key_idx);
+	wpa_hexdump_key(MSG_DEBUG, "WPS: Network Key",
+			cred->key, cred->key_len);
+	wpa_printf(MSG_DEBUG, "WPS: MAC Address " MACSTR,
+		   MAC2STR(cred->mac_addr));
+
+	if ((hapd->conf->wps_cred_processing =3D=3D 1 ||
+	     hapd->conf->wps_cred_processing =3D=3D 2) && cred->cred_attr) {
+		size_t blen =3D cred->cred_attr_len * 2 + 1;
+		char *_buf =3D os_malloc(blen);
+		if (_buf) {
+			wpa_snprintf_hex(_buf, blen,
+					 cred->cred_attr, cred->cred_attr_len);
+			wpa_msg(hapd->msg_ctx, MSG_INFO, "%s%s",
+				WPS_EVENT_NEW_AP_SETTINGS, _buf);
+			os_free(_buf);
+		}
+	} else
+		wpa_msg(hapd->msg_ctx, MSG_INFO, WPS_EVENT_NEW_AP_SETTINGS);
+
+	if (hapd->conf->wps_cred_processing =3D=3D 1)
+		return 0;
+
+	os_memcpy(hapd->wps->ssid, cred->ssid, cred->ssid_len);
+	hapd->wps->ssid_len =3D cred->ssid_len;
+	hapd->wps->encr_types =3D cred->encr_type;
+	hapd->wps->auth_types =3D cred->auth_type;
+	if (cred->key_len =3D=3D 0) {
+		os_free(hapd->wps->network_key);
+		hapd->wps->network_key =3D NULL;
+		hapd->wps->network_key_len =3D 0;
+	} else {
+		if (hapd->wps->network_key =3D=3D NULL ||
+		    hapd->wps->network_key_len < cred->key_len) {
+			hapd->wps->network_key_len =3D 0;
+			os_free(hapd->wps->network_key);
+			hapd->wps->network_key =3D os_malloc(cred->key_len);
+			if (hapd->wps->network_key =3D=3D NULL)
+				return -1;
+		}
+		hapd->wps->network_key_len =3D cred->key_len;
+		os_memcpy(hapd->wps->network_key, cred->key, cred->key_len);
+	}
+	hapd->wps->wps_state =3D WPS_STATE_CONFIGURED;
+
+	len =3D os_strlen(hapd->iface->config_fname) + 5;
+	tmp_fname =3D os_malloc(len);
+	if (tmp_fname =3D=3D NULL)
+		return -1;
+	os_snprintf(tmp_fname, len, "%s-new", hapd->iface->config_fname);
+
+	oconf =3D fopen(hapd->iface->config_fname, "r");
+	if (oconf =3D=3D NULL) {
+		wpa_printf(MSG_WARNING, "WPS: Could not open current "
+			   "configuration file");
+		os_free(tmp_fname);
+		return -1;
+	}
+
+	nconf =3D fopen(tmp_fname, "w");
+	if (nconf =3D=3D NULL) {
+		wpa_printf(MSG_WARNING, "WPS: Could not write updated "
+			   "configuration file");
+		os_free(tmp_fname);
+		fclose(oconf);
+		return -1;
+	}
+
+	fprintf(nconf, "# WPS configuration - START\n");
+
+	fprintf(nconf, "wps_state=3D2\n");
+
+	fprintf(nconf, "ssid=3D");
+	for (i =3D 0; i < cred->ssid_len; i++)
+		fputc(cred->ssid[i], nconf);
+	fprintf(nconf, "\n");
+
+	if ((cred->auth_type & (WPS_AUTH_WPA2 | WPS_AUTH_WPA2PSK)) &&
+	    (cred->auth_type & (WPS_AUTH_WPA | WPS_AUTH_WPAPSK)))
+		wpa =3D 3;
+	else if (cred->auth_type & (WPS_AUTH_WPA2 | WPS_AUTH_WPA2PSK))
+		wpa =3D 2;
+	else if (cred->auth_type & (WPS_AUTH_WPA | WPS_AUTH_WPAPSK))
+		wpa =3D 1;
+	else
+		wpa =3D 0;
+
+	if (wpa) {
+		char *prefix;
+		fprintf(nconf, "wpa=3D%d\n", wpa);
+
+		fprintf(nconf, "wpa_key_mgmt=3D");
+		prefix =3D "";
+		if (cred->auth_type & (WPS_AUTH_WPA2 | WPS_AUTH_WPA)) {
+			fprintf(nconf, "WPA-EAP");
+			prefix =3D " ";
+		}
+		if (cred->auth_type & (WPS_AUTH_WPA2PSK | WPS_AUTH_WPAPSK))
+			fprintf(nconf, "%sWPA-PSK", prefix);
+		fprintf(nconf, "\n");
+
+		fprintf(nconf, "wpa_pairwise=3D");
+		prefix =3D "";
+		if (cred->encr_type & WPS_ENCR_AES) {
+			fprintf(nconf, "CCMP");
+			prefix =3D " ";
+		}
+		if (cred->encr_type & WPS_ENCR_TKIP) {
+			fprintf(nconf, "%sTKIP", prefix);
+		}
+		fprintf(nconf, "\n");
+
+		if (cred->key_len >=3D 8 && cred->key_len < 64) {
+			fprintf(nconf, "wpa_passphrase=3D");
+			for (i =3D 0; i < cred->key_len; i++)
+				fputc(cred->key[i], nconf);
+			fprintf(nconf, "\n");
+		} else if (cred->key_len =3D=3D 64) {
+			fprintf(nconf, "wpa_psk=3D");
+			for (i =3D 0; i < cred->key_len; i++)
+				fputc(cred->key[i], nconf);
+			fprintf(nconf, "\n");
+		} else {
+			wpa_printf(MSG_WARNING, "WPS: Invalid key length %lu "
+				   "for WPA/WPA2",
+				   (unsigned long) cred->key_len);
+		}
+
+		fprintf(nconf, "auth_algs=3D1\n");
+	} else {
+		if ((cred->auth_type & WPS_AUTH_OPEN) &&
+		    (cred->auth_type & WPS_AUTH_SHARED))
+			fprintf(nconf, "auth_algs=3D3\n");
+		else if (cred->auth_type & WPS_AUTH_SHARED)
+			fprintf(nconf, "auth_algs=3D2\n");
+		else
+			fprintf(nconf, "auth_algs=3D1\n");
+
+		if (cred->encr_type & WPS_ENCR_WEP && cred->key_idx <=3D 4) {
+			int key_idx =3D cred->key_idx;
+			if (key_idx)
+				key_idx--;
+			fprintf(nconf, "wep_default_key=3D%d\n", key_idx);
+			fprintf(nconf, "wep_key%d=3D", key_idx);
+			if (cred->key_len =3D=3D 10 || cred->key_len =3D=3D 26) {
+				/* WEP key as a hex string */
+				for (i =3D 0; i < cred->key_len; i++)
+					fputc(cred->key[i], nconf);
+			} else {
+				/* Raw WEP key; convert to hex */
+				for (i =3D 0; i < cred->key_len; i++)
+					fprintf(nconf, "%02x", cred->key[i]);
+			}
+			fprintf(nconf, "\n");
+		}
+	}
+
+	fprintf(nconf, "# WPS configuration - END\n");
+
+	multi_bss =3D 0;
+	while (fgets(buf, sizeof(buf), oconf)) {
+		if (os_strncmp(buf, "bss=3D", 4) =3D=3D 0)
+			multi_bss =3D 1;
+		if (!multi_bss &&
+		    (str_starts(buf, "ssid=3D") ||
+		     str_starts(buf, "auth_algs=3D") ||
+		     str_starts(buf, "wep_default_key=3D") ||
+		     str_starts(buf, "wep_key") ||
+		     str_starts(buf, "wps_state=3D") ||
+		     str_starts(buf, "wpa=3D") ||
+		     str_starts(buf, "wpa_psk=3D") ||
+		     str_starts(buf, "wpa_pairwise=3D") ||
+		     str_starts(buf, "rsn_pairwise=3D") ||
+		     str_starts(buf, "wpa_key_mgmt=3D") ||
+		     str_starts(buf, "wpa_passphrase=3D"))) {
+			fprintf(nconf, "#WPS# %s", buf);
+		} else
+			fprintf(nconf, "%s", buf);
+	}
+
+	fclose(nconf);
+	fclose(oconf);
+
+	if (rename(tmp_fname, hapd->iface->config_fname) < 0) {
+		wpa_printf(MSG_WARNING, "WPS: Failed to rename the updated "
+			   "configuration file: %s", strerror(errno));
+		os_free(tmp_fname);
+		return -1;
+	}
+
+	os_free(tmp_fname);
+
+	/* Schedule configuration reload after short period of time to allow
+	 * EAP-WSC to be finished.
+	 */
+	eloop_register_timeout(0, 100000, wps_reload_config, hapd->iface,
+			       NULL);
+
+	wpa_printf(MSG_DEBUG, "WPS: AP configuration updated");
+
+	return 0;
+}
