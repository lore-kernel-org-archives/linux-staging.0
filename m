+	while (1) {
+		if (*p =3D=3D index) {
+			*len =3D *(p + 1);
+			return p;
+		} else {
+			tmp =3D *(p + 1);
+			p +=3D (tmp + 2);
+			i +=3D (tmp + 2);
+		}
