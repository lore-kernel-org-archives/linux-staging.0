+	u8		ant
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _FAST_ANTENNA_TRAINNING_			*p_dm_fat_table =3D &p_dm_odm->dm_fat_t=
able;
+	u32			default_ant, optional_ant, value32, default_tx_ant;
+
+	if (p_dm_fat_table->rx_idle_ant !=3D ant) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[ Update Rx-Idl=
e-ant ] rx_idle_ant =3D%s\n", (ant =3D=3D MAIN_ANT) ? "MAIN_ANT" : "AUX_ANT=
"));
+
+		if (!(p_dm_odm->support_ic_type & ODM_RTL8723B))
+			p_dm_fat_table->rx_idle_ant =3D ant;
+
+		if (ant =3D=3D MAIN_ANT) {
+			default_ant   =3D  ANT1_2G;
+			optional_ant =3D  ANT2_2G;
+		} else {
+			default_ant  =3D   ANT2_2G;
+			optional_ant =3D  ANT1_2G;
+		}
+
+		if (p_dm_fat_table->b_fix_tx_ant !=3D NO_FIX_TX_ANT)
+			default_tx_ant =3D (p_dm_fat_table->b_fix_tx_ant =3D=3D FIX_TX_AT_MAIN)=
 ? 0 : 1;
+		else
+			default_tx_ant =3D default_ant;
+
+		if (p_dm_odm->support_ic_type & ODM_N_ANTDIV_SUPPORT) {
+			if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8192E) {
+				odm_set_bb_reg(p_dm_odm, 0xB38, BIT(5) | BIT4 | BIT3, default_ant); /*=
 Default RX */
+				odm_set_bb_reg(p_dm_odm, 0xB38, BIT(8) | BIT7 | BIT6, optional_ant); /=
* Optional RX */
+				odm_set_bb_reg(p_dm_odm, 0x860, BIT(14) | BIT13 | BIT12, default_ant);=
 /* Default TX */
+			}
+#if (RTL8723B_SUPPORT =3D=3D 1)
+			else if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8723B) {
+
+				value32 =3D odm_get_bb_reg(p_dm_odm, 0x948, 0xFFF);
+
+				if (value32 !=3D 0x280)
+					odm_update_rx_idle_ant_8723b(p_dm_odm, ant, default_ant, optional_ant=
);
+				else
+					ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[ Update Rx-=
Idle-ant ] 8723B: Fail to set RX antenna due to 0x948 =3D 0x280\n"));
+			}
+#endif
+			else { /*8188E & 8188F*/
+
+				if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8723D) {
+#if (RTL8723D_SUPPORT =3D=3D 1)
+					phydm_set_tx_ant_pwr_8723d(p_dm_odm, ant);
+#endif
+				}
+#if (RTL8188F_SUPPORT =3D=3D 1)
+				else if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8188F) {
+					phydm_update_rx_idle_antenna_8188F(p_dm_odm, default_ant);
+					/**/
+				}
+#endif
+
+				odm_set_bb_reg(p_dm_odm, 0x864, BIT(5) | BIT4 | BIT3, default_ant);		/=
*Default RX*/
+				odm_set_bb_reg(p_dm_odm, 0x864, BIT(8) | BIT7 | BIT6, optional_ant);	/=
*Optional RX*/
+				odm_set_bb_reg(p_dm_odm, 0x860, BIT(14) | BIT13 | BIT12, default_tx_an=
t);	/*Default TX*/
+			}
+		} else if (p_dm_odm->support_ic_type & ODM_AC_ANTDIV_SUPPORT) {
+			u16	value16 =3D odm_read_2byte(p_dm_odm, ODM_REG_TRMUX_11AC + 2);
+			/*  */
+			/* 2014/01/14 MH/Luke.Lee Add direct write for register 0xc0a to prevnt=
 */
+			/* incorrect 0xc08 bit0-15 .We still not know why it is changed. */
+			/*  */
+			value16 &=3D ~(BIT(11) | BIT(10) | BIT(9) | BIT(8) | BIT(7) | BIT(6) | =
BIT(5) | BIT(4) | BIT(3));
+			value16 |=3D ((u16)default_ant << 3);
+			value16 |=3D ((u16)optional_ant << 6);
+			value16 |=3D ((u16)default_ant << 9);
+			odm_write_2byte(p_dm_odm, ODM_REG_TRMUX_11AC + 2, value16);
+		}
+
+		if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8188E) {
+			odm_set_mac_reg(p_dm_odm, 0x6D8, BIT(7) | BIT6, default_tx_ant);		/*Pat=
hA Resp Tx*/
+			/**/
+		} else {
+			odm_set_mac_reg(p_dm_odm, 0x6D8, BIT(10) | BIT9 | BIT8, default_tx_ant)=
;	/*PathA Resp Tx*/
+			/**/
+		}
+
+	} else { /* p_dm_fat_table->rx_idle_ant =3D=3D ant */
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[ Stay in Ori-a=
nt ]  rx_idle_ant =3D%s\n", (ant =3D=3D MAIN_ANT) ? "MAIN_ANT" : "AUX_ANT")=
);
+		p_dm_fat_table->rx_idle_ant =3D ant;
+	}
+}
