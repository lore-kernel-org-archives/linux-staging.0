+
+#ifdef CONFIG_CMCC_TEST
+#ifdef CONFIG_BT_COEXIST
+	if (pmlmeext->cur_wireless_mode & WIRELESS_11G) {
+		if (mac_id =3D=3D 0) {
+			RTW_INFO("CMCC_BT update raid entry, mask=3D0x%x\n", mask);
+			/*mask &=3D0xffffffc0; //disable CCK & <12M OFDM rate for 11G mode for =
CMCC */
+			mask &=3D 0xffffff00; /*disable CCK & <24M OFDM rate for 11G mode for C=
MCC */
+			RTW_INFO("CMCC_BT update raid entry, mask=3D0x%x\n", mask);
+		}
+	}
+#endif
+#endif
+
+	/*set correct initial date rate for each mac_id */
+	hal_data->INIDATA_RATE[mac_id] =3D psta->init_rate;
+
+
+	RTW_INFO("%s =3D> mac_id:%d, networkType:0x%02x, mask:0x%016llx\n\t =3D=
=3D> rssi_level:%d, rate_bitmap:0x%016llx, shortGIrate=3D%d\n\t =3D=3D> bw:=
%d, ignore_bw:0x%d\n",
+			__func__, mac_id, psta->wireless_mode, mask, rssi_level, rate_bitmap, s=
hort_gi, bw, (!is_update_bw));
+
+	rtw_macid_ctl_set_bw(macid_ctl, mac_id, bw);
+	rtw_macid_ctl_set_vht_en(macid_ctl, mac_id, is_supported_vht(psta->wirele=
ss_mode));
+	rtw_macid_ctl_set_rate_bmp0(macid_ctl, mac_id, mask);
+	rtw_macid_ctl_set_rate_bmp1(macid_ctl, mac_id, mask >> 32);
+	rtw_update_tx_rate_bmp(adapter_to_dvobj(padapter));
+
+	h2c_macid_cfg.mac_id =3D mac_id;
+	h2c_macid_cfg.rate_id =3D psta->raid;
+	h2c_macid_cfg.bandwidth =3D bw;
+	h2c_macid_cfg.ignore_bw =3D (!is_update_bw);
+	h2c_macid_cfg.short_gi =3D short_gi;
+	h2c_macid_cfg.ra_mask =3D mask;
