+static int hostapd_ctrl_iface_detach(struct hostapd_data *hapd,
+				     struct sockaddr_un *from,
+				     socklen_t fromlen)
+{
+	struct wpa_ctrl_dst *dst, *prev =3D NULL;
+
+	dst =3D hapd->ctrl_dst;
+	while (dst) {
+		if (fromlen =3D=3D dst->addrlen &&
+		    os_memcmp(from->sun_path, dst->addr.sun_path,
+			      fromlen - offsetof(struct sockaddr_un, sun_path))
+		    =3D=3D 0) {
+			if (prev =3D=3D NULL)
+				hapd->ctrl_dst =3D dst->next;
+			else
+				prev->next =3D dst->next;
+			os_free(dst);
+			wpa_hexdump(MSG_DEBUG, "CTRL_IFACE monitor detached",
+				    (u8 *) from->sun_path,
+				    fromlen -
+				    offsetof(struct sockaddr_un, sun_path));
+			return 0;
+		}
+		prev =3D dst;
+		dst =3D dst->next;
+	}
+	return -1;
+}
