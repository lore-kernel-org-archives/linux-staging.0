+			/* Check P2P Capability ATTR */
+			if (rtw_get_p2p_attr_content(p2p_ie, p2p_ielen, P2P_ATTR_CAPABILITY, (u=
8 *)&le_tmp, (uint *)&attr_contentlen)) {
+				u8 grp_cap =3D 0;
+				/* RTW_INFO( "[%s] Got P2P Capability Attr!!\n", __func__ ); */
+				cap_attr =3D le16_to_cpu(le_tmp);
+				grp_cap =3D (u8)((cap_attr >> 8) & 0xff);
+
+				is_GO =3D (grp_cap & BIT(0)) ? true : false;
+
+				if (is_GO)
+					RTW_INFO("Got P2P Capability Attr, grp_cap=3D0x%x, is_GO\n", grp_cap);
+			}
