+#ifdef CONFIG_P2P_PS
+void process_p2p_ps_ie(PADAPTER padapter, u8 *IEs, u32 IELength)
+{
+	u8 *ies;
+	u32 ies_len;
+	u8 *p2p_ie;
+	u32	p2p_ielen =3D 0;
+	u8	noa_attr[MAX_P2P_IE_LEN] =3D { 0x00 };/* NoA length should be n*(13) +=
 2 */
+	u32	attr_contentlen =3D 0;
+
+	struct wifidirect_info	*pwdinfo =3D &(padapter->wdinfo);
+	u8	find_p2p =3D false, find_p2p_ps =3D false;
+	u8	noa_offset, noa_num, noa_index;
+
+
+	if (rtw_p2p_chk_state(pwdinfo, P2P_STATE_NONE))
+		return;
+#ifdef CONFIG_CONCURRENT_MODE
+#ifndef CONFIG_FW_MULTI_PORT_SUPPORT
+	if (padapter->hw_port !=3D HW_PORT0)
+		return;
+#endif
+#endif
+	if (IELength <=3D _BEACON_IE_OFFSET_)
+		return;
+
+	ies =3D IEs + _BEACON_IE_OFFSET_;
+	ies_len =3D IELength - _BEACON_IE_OFFSET_;
+
+	p2p_ie =3D rtw_get_p2p_ie(ies, ies_len, NULL, &p2p_ielen);
+
+	while (p2p_ie) {
+		find_p2p =3D true;
+		/* Get Notice of Absence IE. */
+		if (rtw_get_p2p_attr_content(p2p_ie, p2p_ielen, P2P_ATTR_NOA, noa_attr, =
&attr_contentlen)) {
+			find_p2p_ps =3D true;
+			noa_index =3D noa_attr[0];
+
+			if ((pwdinfo->p2p_ps_mode =3D=3D P2P_PS_NONE) ||
+			    (noa_index !=3D pwdinfo->noa_index)) { /* if index change, driver s=
hould reconfigure related setting. */
+				pwdinfo->noa_index =3D noa_index;
+				pwdinfo->opp_ps =3D noa_attr[1] >> 7;
+				pwdinfo->ctwindow =3D noa_attr[1] & 0x7F;
+
+				noa_offset =3D 2;
+				noa_num =3D 0;
+				/* NoA length should be n*(13) + 2 */
+				if (attr_contentlen > 2) {
+					while (noa_offset < attr_contentlen) {
+						/* memcpy(&wifidirect_info->noa_count[noa_num], &noa_attr[noa_offset=
], 1); */
+						pwdinfo->noa_count[noa_num] =3D noa_attr[noa_offset];
+						noa_offset +=3D 1;
+
+						memcpy(&pwdinfo->noa_duration[noa_num], &noa_attr[noa_offset], 4);
+						noa_offset +=3D 4;
+
+						memcpy(&pwdinfo->noa_interval[noa_num], &noa_attr[noa_offset], 4);
+						noa_offset +=3D 4;
+
+						memcpy(&pwdinfo->noa_start_time[noa_num], &noa_attr[noa_offset], 4);
+						noa_offset +=3D 4;
+
+						noa_num++;
+					}
+				}
+				pwdinfo->noa_num =3D noa_num;
+
+				if (pwdinfo->opp_ps =3D=3D 1) {
+					pwdinfo->p2p_ps_mode =3D P2P_PS_CTWINDOW;
+					/* driver should wait LPS for entering CTWindow */
+					if (adapter_to_pwrctl(padapter)->bFwCurrentInPSMode)
+						p2p_ps_wk_cmd(padapter, P2P_PS_ENABLE, 1);
+				} else if (pwdinfo->noa_num > 0) {
+					pwdinfo->p2p_ps_mode =3D P2P_PS_NOA;
+					p2p_ps_wk_cmd(padapter, P2P_PS_ENABLE, 1);
+				} else if (pwdinfo->p2p_ps_mode > P2P_PS_NONE)
+					p2p_ps_wk_cmd(padapter, P2P_PS_DISABLE, 1);
+			}
+
+			break; /* find target, just break. */
+		}
+
+		/* Get the next P2P IE */
+		p2p_ie =3D rtw_get_p2p_ie(p2p_ie + p2p_ielen, ies_len - (p2p_ie - ies + =
p2p_ielen), NULL, &p2p_ielen);
+
+	}
+
+	if (find_p2p) {
+		if ((pwdinfo->p2p_ps_mode > P2P_PS_NONE) && (find_p2p_ps =3D=3D false))
+			p2p_ps_wk_cmd(padapter, P2P_PS_DISABLE, 1);
+	}
+
+}
