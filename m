+unsigned int OnAuth(_adapter *padapter, union recv_frame *precv_frame)
+{
+#ifdef CONFIG_AP_MODE
+	unsigned long irqL;
+	unsigned int	auth_mode, seq, ie_len;
+	unsigned char	*sa, *p;
+	u16	algorithm;
+	int	status;
+	static struct sta_info stat;
+	struct	sta_info	*pstat =3D NULL;
+	struct	sta_priv *pstapriv =3D &padapter->stapriv;
+	struct security_priv *psecuritypriv =3D &padapter->securitypriv;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	u8 *pframe =3D precv_frame->u.hdr.rx_data;
+	uint len =3D precv_frame->u.hdr.len;
+	u8	offset =3D 0;
+
+
+#ifdef CONFIG_CONCURRENT_MODE
+	if (((pmlmeinfo->state & 0x03) =3D=3D WIFI_FW_AP_STATE) &&
+	    rtw_mi_buddy_check_fwstate(padapter, _FW_UNDER_LINKING | _FW_UNDER_SU=
RVEY)) {
+		/* don't process auth request; */
+		return _SUCCESS;
+	}
+#endif /* CONFIG_CONCURRENT_MODE */
+
+	if ((pmlmeinfo->state & 0x03) !=3D WIFI_FW_AP_STATE)
+		return _FAIL;
+
+	RTW_INFO("+OnAuth\n");
+
+	sa =3D get_addr2_ptr(pframe);
+
+	auth_mode =3D psecuritypriv->dot11AuthAlgrthm;
+
+	if (GetPrivacy(pframe)) {
+		u8	*iv;
+		struct rx_pkt_attrib	*prxattrib =3D &(precv_frame->u.hdr.attrib);
+
+		prxattrib->hdrlen =3D WLAN_HDR_A3_LEN;
+		prxattrib->encrypt =3D _WEP40_;
+
+		iv =3D pframe + prxattrib->hdrlen;
+		prxattrib->key_index =3D ((iv[3] >> 6) & 0x3);
+
+		prxattrib->iv_len =3D 4;
+		prxattrib->icv_len =3D 4;
+
+		rtw_wep_decrypt(padapter, (u8 *)precv_frame);
+
+		offset =3D 4;
+	}
+
+	algorithm =3D le16_to_cpu(*(__le16 *)((SIZE_PTR)pframe + WLAN_HDR_A3_LEN =
+ offset));
+	seq	=3D le16_to_cpu(*(__le16 *)((SIZE_PTR)pframe + WLAN_HDR_A3_LEN + offs=
et + 2));
+
+	RTW_INFO("auth alg=3D%x, seq=3D%X\n", algorithm, seq);
+
+	if (auth_mode =3D=3D 2 &&
+	    psecuritypriv->dot11PrivacyAlgrthm !=3D _WEP40_ &&
+	    psecuritypriv->dot11PrivacyAlgrthm !=3D _WEP104_)
+		auth_mode =3D 0;
+
+	if ((algorithm > 0 && auth_mode =3D=3D 0) ||	/* rx a shared-key auth but =
shared not enabled */
+	    (algorithm =3D=3D 0 && auth_mode =3D=3D 1)) {	/* rx a open-system aut=
h but shared-key is enabled */
+		RTW_INFO("auth rejected due to bad alg [alg=3D%d, auth_mib=3D%d] %02X%02=
X%02X%02X%02X%02X\n",
+			algorithm, auth_mode, sa[0], sa[1], sa[2], sa[3], sa[4], sa[5]);
+
+		status =3D _STATS_NO_SUPP_ALG_;
+
+		goto auth_fail;
+	}
+
+#if CONFIG_RTW_MACADDR_ACL
+	if (rtw_access_ctrl(padapter, sa) =3D=3D false) {
+		status =3D _STATS_UNABLE_HANDLE_STA_;
+		goto auth_fail;
+	}
+#endif
+
+	pstat =3D rtw_get_stainfo(pstapriv, sa);
+	if (pstat =3D=3D NULL) {
+
+		/* allocate a new one */
+		RTW_INFO("going to alloc stainfo for sa=3D"MAC_FMT"\n",  MAC_ARG(sa));
+		pstat =3D rtw_alloc_stainfo(pstapriv, sa);
+		if (pstat =3D=3D NULL) {
+			RTW_INFO(" Exceed the upper limit of supported clients...\n");
+			status =3D _STATS_UNABLE_HANDLE_STA_;
+			goto auth_fail;
+		}
+
+		pstat->state =3D WIFI_FW_AUTH_NULL;
+		pstat->auth_seq =3D 0;
+
+		/* pstat->flags =3D 0; */
+		/* pstat->capability =3D 0; */
+	} else {
+#ifdef CONFIG_IEEE80211W
+		if (pstat->bpairwise_key_installed !=3D true && !(pstat->state & WIFI_FW=
_ASSOC_SUCCESS))
+#endif /* CONFIG_IEEE80211W */
+		{
+
+			_enter_critical_bh(&pstapriv->asoc_list_lock, &irqL);
+			if (list_empty(&pstat->asoc_list) =3D=3D false) {
+				list_del_init(&pstat->asoc_list);
+				pstapriv->asoc_list_cnt--;
+				if (pstat->expire_to > 0)
+					;/* TODO: STA re_auth within expire_to */
+			}
+			_exit_critical_bh(&pstapriv->asoc_list_lock, &irqL);
+
+			if (seq =3D=3D 1)
+				; /* TODO: STA re_auth and auth timeout */
+
+		}
+	}
+
+#ifdef CONFIG_IEEE80211W
+	if (pstat->bpairwise_key_installed !=3D true && !(pstat->state & WIFI_FW_=
ASSOC_SUCCESS))
+#endif /* CONFIG_IEEE80211W */
+	{
+		_enter_critical_bh(&pstapriv->auth_list_lock, &irqL);
+		if (list_empty(&pstat->auth_list)) {
+
+			list_add_tail(&pstat->auth_list, &pstapriv->auth_list);
+			pstapriv->auth_list_cnt++;
+		}
+		_exit_critical_bh(&pstapriv->auth_list_lock, &irqL);
+	}
+
+	if (pstat->auth_seq =3D=3D 0)
+		pstat->expire_to =3D pstapriv->auth_to;
+
+
+	if ((pstat->auth_seq + 1) !=3D seq) {
+		RTW_INFO("(1)auth rejected because out of seq [rx_seq=3D%d, exp_seq=3D%d=
]!\n",
+			 seq, pstat->auth_seq + 1);
+		status =3D _STATS_OUT_OF_AUTH_SEQ_;
+		goto auth_fail;
+	}
+
+	if (algorithm =3D=3D 0 && (auth_mode =3D=3D 0 || auth_mode =3D=3D 2 || au=
th_mode =3D=3D 3)) {
+		if (seq =3D=3D 1) {
+#ifdef CONFIG_IEEE80211W
+			if (pstat->bpairwise_key_installed !=3D true && !(pstat->state & WIFI_F=
W_ASSOC_SUCCESS))
+#endif /* CONFIG_IEEE80211W */
+			{
+				pstat->state &=3D ~WIFI_FW_AUTH_NULL;
+				pstat->state |=3D WIFI_FW_AUTH_SUCCESS;
+				pstat->expire_to =3D pstapriv->assoc_to;
+			}
+			pstat->authalg =3D algorithm;
+		} else {
+			RTW_INFO("(2)auth rejected because out of seq [rx_seq=3D%d, exp_seq=3D%=
d]!\n",
+				 seq, pstat->auth_seq + 1);
+			status =3D _STATS_OUT_OF_AUTH_SEQ_;
+			goto auth_fail;
+		}
+	} else { /* shared system or auto authentication */
+		if (seq =3D=3D 1) {
+			/* prepare for the challenging txt... */
+
+			/* get_random_bytes((void *)pstat->chg_txt, 128); */ /* TODO: */
+			memset((void *)pstat->chg_txt, 78, 128);
+#ifdef CONFIG_IEEE80211W
+			if (pstat->bpairwise_key_installed !=3D true && !(pstat->state & WIFI_F=
W_ASSOC_SUCCESS))
+#endif /* CONFIG_IEEE80211W */
+			{
+				pstat->state &=3D ~WIFI_FW_AUTH_NULL;
+				pstat->state |=3D WIFI_FW_AUTH_STATE;
+			}
+			pstat->authalg =3D algorithm;
+			pstat->auth_seq =3D 2;
+		} else if (seq =3D=3D 3) {
+			/* checking for challenging txt... */
+			RTW_INFO("checking for challenging txt...\n");
+
+			p =3D rtw_get_ie(pframe + WLAN_HDR_A3_LEN + 4 + _AUTH_IE_OFFSET_ , _CHL=
GETXT_IE_, (int *)&ie_len,
+				len - WLAN_HDR_A3_LEN - _AUTH_IE_OFFSET_ - 4);
+
+			if ((p =3D=3D NULL) || (ie_len <=3D 0)) {
+				RTW_INFO("auth rejected because challenge failure!(1)\n");
+				status =3D _STATS_CHALLENGE_FAIL_;
+				goto auth_fail;
+			}
+
+			if (!memcmp((void *)(p + 2), pstat->chg_txt, 128)) {
+#ifdef CONFIG_IEEE80211W
+				if (pstat->bpairwise_key_installed !=3D true && !(pstat->state & WIFI_=
FW_ASSOC_SUCCESS))
+#endif /* CONFIG_IEEE80211W */
+				{
+					pstat->state &=3D (~WIFI_FW_AUTH_STATE);
+					pstat->state |=3D WIFI_FW_AUTH_SUCCESS;
+					/* challenging txt is correct... */
+					pstat->expire_to =3D  pstapriv->assoc_to;
+				}
+			} else {
+				RTW_INFO("auth rejected because challenge failure!\n");
+				status =3D _STATS_CHALLENGE_FAIL_;
+				goto auth_fail;
+			}
+		} else {
+			RTW_INFO("(3)auth rejected because out of seq [rx_seq=3D%d, exp_seq=3D%=
d]!\n",
+				 seq, pstat->auth_seq + 1);
+			status =3D _STATS_OUT_OF_AUTH_SEQ_;
+			goto auth_fail;
+		}
+	}
+
+
+	/* Now, we are going to issue_auth... */
+	pstat->auth_seq =3D seq + 1;
+
+#ifdef CONFIG_NATIVEAP_MLME
+	issue_auth(padapter, pstat, (unsigned short)(_STATS_SUCCESSFUL_));
+#endif
+
+	if ((pstat->state & WIFI_FW_AUTH_SUCCESS) || (pstat->state & WIFI_FW_ASSO=
C_SUCCESS))
+		pstat->auth_seq =3D 0;
+
+
+	return _SUCCESS;
+
+auth_fail:
+
+	if (pstat)
+		rtw_free_stainfo(padapter , pstat);
+
+	pstat =3D &stat;
+	memset((char *)pstat, '\0', sizeof(stat));
+	pstat->auth_seq =3D 2;
+	memcpy(pstat->hwaddr, sa, 6);
+
+#ifdef CONFIG_NATIVEAP_MLME
+	issue_auth(padapter, pstat, (unsigned short)status);
+#endif
+
+#endif
+	return _FAIL;
+
+}
