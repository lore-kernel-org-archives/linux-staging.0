+
+static unsigned char * tncs_get_base64(char *start, size_t *decoded_len)
+{
+	char *pos, *pos2;
+	unsigned char *decoded;
+
+	pos =3D os_strstr(start, "<Base64>");
+	if (pos =3D=3D NULL)
+		return NULL;
+
+	pos +=3D 8;
+	pos2 =3D os_strstr(pos, "</Base64>");
+	if (pos2 =3D=3D NULL)
+		return NULL;
+	*pos2 =3D '\0';
+
+	decoded =3D base64_decode((unsigned char *) pos, os_strlen(pos),
+				decoded_len);
+	*pos2 =3D '<';
+	if (decoded =3D=3D NULL) {
+		wpa_printf(MSG_DEBUG, "TNC: Failed to decode Base64 data");
+	}
+
+	return decoded;
+}
