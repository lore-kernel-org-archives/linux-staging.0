+static struct hostapd_iface * hostapd_init(const char *config_file)
+{
+	struct hostapd_iface *hapd_iface =3D NULL;
+	struct hostapd_config *conf =3D NULL;
+	struct hostapd_data *hapd;
+	size_t i;
+
+	hapd_iface =3D os_zalloc(sizeof(*hapd_iface));
+	if (hapd_iface =3D=3D NULL)
+		goto fail;
+
+	hapd_iface->reload_config =3D hostapd_reload_config;
+	hapd_iface->config_read_cb =3D hostapd_config_read;
+	hapd_iface->config_fname =3D os_strdup(config_file);
+	if (hapd_iface->config_fname =3D=3D NULL)
+		goto fail;
+	hapd_iface->ctrl_iface_init =3D hostapd_ctrl_iface_init;
+	hapd_iface->ctrl_iface_deinit =3D hostapd_ctrl_iface_deinit;
+	hapd_iface->for_each_interface =3D hostapd_for_each_interface;
+
+	conf =3D hostapd_config_read(hapd_iface->config_fname);
+	if (conf =3D=3D NULL)
+		goto fail;
+	hapd_iface->conf =3D conf;
+
+	hapd_iface->num_bss =3D conf->num_bss;
+	hapd_iface->bss =3D os_zalloc(conf->num_bss *
+				    sizeof(struct hostapd_data *));
+	if (hapd_iface->bss =3D=3D NULL)
+		goto fail;
+
+	for (i =3D 0; i < conf->num_bss; i++) {
+		hapd =3D hapd_iface->bss[i] =3D
+			hostapd_alloc_bss_data(hapd_iface, conf,
+					       &conf->bss[i]);
+		if (hapd =3D=3D NULL)
+			goto fail;
+		hapd->msg_ctx =3D hapd;
+	}
+
+	return hapd_iface;
+
+fail:
+	if (conf)
+		hostapd_config_free(conf);
+	if (hapd_iface) {
+		os_free(hapd_iface->config_fname);
+		os_free(hapd_iface->bss);
+		os_free(hapd_iface);
+	}
