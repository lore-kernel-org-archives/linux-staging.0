+static void rtw_hal_get_aoac_rpt(_adapter *adapter)
+{
+	struct pwrctrl_priv *pwrctl =3D adapter_to_pwrctl(adapter);
+	struct aoac_report *paoac_rpt =3D &pwrctl->wowlan_aoac_rpt;
+	u32 page_offset =3D 0, page_number =3D 0;
+	u32 page_size =3D 0, buf_size =3D 0;
+	u8 *buffer =3D NULL;
+	u8 i =3D 0, tmp =3D 0;
+	int ret =3D -1;
+
+	/* read aoac report from rsvd page */
+	page_offset =3D pwrctl->wowlan_aoac_rpt_loc;
+	page_number =3D 1;
+
+	rtw_hal_get_def_var(adapter, HAL_DEF_TX_PAGE_SIZE, &page_size);
+	buf_size =3D page_size * page_number;
+
+	buffer =3D rtw_zvmalloc(buf_size);
+
+	if (NULL =3D=3D buffer) {
+		RTW_ERR("%s buffer allocate failed size(%d)\n",
+			__func__, buf_size);
+		return;
+	}
+
+	RTW_INFO("Get AOAC Report from rsvd page_offset:%d\n", page_offset);
+
+	ret =3D rtw_hal_get_rsvd_page(adapter, page_offset,
+		page_number, buffer, buf_size);
+
+	if (ret =3D=3D false) {
+		RTW_ERR("%s get aoac report failed\n", __func__);
+		rtw_warn_on(1);
+		goto _exit;
+	}
+
+	memset(paoac_rpt, 0, sizeof(struct aoac_report));
+	memcpy(paoac_rpt, buffer, sizeof(struct aoac_report));
+
+	for (i =3D 0 ; i < 4 ; i++) {
+		tmp =3D paoac_rpt->replay_counter_eapol_key[i];
+		paoac_rpt->replay_counter_eapol_key[i] =3D
+			paoac_rpt->replay_counter_eapol_key[7 - i];
+		paoac_rpt->replay_counter_eapol_key[7 - i] =3D tmp;
+	}
+
+	/* rtw_dump_aoac_rpt(adapter); */
+
+_exit:
+	if (buffer)
+		rtw_vmfree(buffer, buf_size);
+}
