+	pmlmeinfo->candidate_tid_bitmap =3D 0;
+	pmlmeinfo->bwmode_updated =3D false;
+	/* pmlmeinfo->assoc_AP_vendor =3D HT_IOT_PEER_MAX; */
+	pmlmeinfo->VHT_enable =3D 0;
+
+	memcpy(pnetwork, pbuf, FIELD_OFFSET(WLAN_BSSID_EX, IELength));
+	pnetwork->IELength =3D ((WLAN_BSSID_EX *)pbuf)->IELength;
+
+	if (pnetwork->IELength > MAX_IE_SZ) /* Check pbuf->IELength */
+		return H2C_PARAMETERS_ERROR;
+
+	if (pnetwork->IELength < 2) {
+		report_join_res(padapter, (-4));
