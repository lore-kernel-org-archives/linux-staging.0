+static u8 rtw_createbss_cmd(_adapter  *adapter, int flags, bool adhoc,
+			    s16 req_ch, s8 req_bw, s8 req_offset)
+{
+	struct cmd_obj *cmdobj;
+	struct createbss_parm *parm;
+	struct cmd_priv *pcmdpriv =3D &adapter->cmdpriv;
+	struct mlme_priv *pmlmepriv =3D &adapter->mlmepriv;
+	struct submit_ctx sctx;
+	u8 res =3D _SUCCESS;
+
+	if (req_ch > 0 && req_bw >=3D 0 && req_offset >=3D 0) {
+		if (!rtw_chset_is_chbw_valid(adapter->mlmeextpriv.channel_set, req_ch, r=
eq_bw, req_offset)) {
+			res =3D _FAIL;
+			goto exit;
+		}
+	}
+
+	/* prepare cmd parameter */
+	parm =3D (struct createbss_parm *)rtw_zmalloc(sizeof(*parm));
+	if (!parm) {
+		res =3D _FAIL;
+		goto exit;
+	}
+	if (adhoc) {
+		/* for now, adhoc doesn't support ch,bw,offset request */
+		parm->adhoc =3D 1;
+	} else {
+		parm->adhoc =3D 0;
+		parm->req_ch =3D req_ch;
+		parm->req_bw =3D req_bw;
+		parm->req_offset =3D req_offset;
+	}
+
+	if (flags & RTW_CMDF_DIRECTLY) {
+		/* no need to enqueue, do the cmd hdl directly and free cmd parameter */
+		if (createbss_hdl(adapter, (u8 *)parm) !=3D H2C_SUCCESS)
+			res =3D _FAIL;
+		rtw_mfree((u8 *)parm, sizeof(*parm));
+	} else {
+		/* need enqueue, prepare cmd_obj and enqueue */
+		cmdobj =3D (struct cmd_obj *)rtw_zmalloc(sizeof(*cmdobj));
+		if (cmdobj =3D=3D NULL) {
+			res =3D _FAIL;
+			rtw_mfree((u8 *)parm, sizeof(*parm));
+			goto exit;
+		}
+
+		init_h2fwcmd_w_parm_no_rsp(cmdobj, parm, GEN_CMD_CODE(_CreateBss));
+
+		if (flags & RTW_CMDF_WAIT_ACK) {
+			cmdobj->sctx =3D &sctx;
+			rtw_sctx_init(&sctx, 2000);
+		}
+
+		res =3D rtw_enqueue_cmd(pcmdpriv, cmdobj);
+
+		if (res =3D=3D _SUCCESS && (flags & RTW_CMDF_WAIT_ACK)) {
+			rtw_sctx_wait(&sctx, __func__);
+			_enter_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+			if (sctx.status =3D=3D RTW_SCTX_SUBMITTED)
+				cmdobj->sctx =3D NULL;
+			_exit_critical_mutex(&pcmdpriv->sctx_mutex, NULL);
+		}
+	}
+
+exit:
+	return res;
+}
