+/*
+ * wait_ms =3D=3D 0 means that there is no need to wait ack through C2H_CC=
X_TX_RPT
+ * wait_ms > 0 means you want to wait ack through C2H_CCX_TX_RPT, and the =
value of wait_ms means the interval between each TX
+ * try_cnt means the maximal TX count to try
+ */
+int issue_probereq_ex(_adapter *padapter, NDIS_802_11_SSID *pssid, u8 *da,=
 u8 ch, bool append_wps,
+		      int try_cnt, int wait_ms)
+{
+	int ret =3D _FAIL;
+	int i =3D 0;
+	u32 start =3D jiffies;
+
+	if (rtw_rfctl_is_tx_blocked_by_ch_waiting(adapter_to_rfctl(padapter)))
+		goto exit;
+
+	do {
+		ret =3D _issue_probereq(padapter, pssid, da, ch, append_wps, wait_ms > 0=
 ? true : false);
+
+		i++;
+
+		if (RTW_CANNOT_RUN(padapter))
+			break;
+
+		if (i < try_cnt && wait_ms > 0 && ret =3D=3D _FAIL)
+			rtw_msleep_os(wait_ms);
+
+	} while ((i < try_cnt) && ((ret =3D=3D _FAIL) || (wait_ms =3D=3D 0)));
+
+	if (ret !=3D _FAIL) {
+		ret =3D _SUCCESS;
+#ifndef DBG_XMIT_ACK
+		goto exit;
+#endif
+	}
+
+	if (try_cnt && wait_ms) {
+		if (da)
+			RTW_INFO(FUNC_ADPT_FMT" to "MAC_FMT", ch:%u%s, %d/%d in %u ms\n",
+				FUNC_ADPT_ARG(padapter), MAC_ARG(da), rtw_get_oper_ch(padapter),
+				ret =3D=3D _SUCCESS ? ", acked" : "", i, try_cnt, rtw_get_passing_time=
_ms(start));
+		else
+			RTW_INFO(FUNC_ADPT_FMT", ch:%u%s, %d/%d in %u ms\n",
+				FUNC_ADPT_ARG(padapter), rtw_get_oper_ch(padapter),
+				ret =3D=3D _SUCCESS ? ", acked" : "", i, try_cnt, rtw_get_passing_time=
_ms(start));
+	}
+exit:
+	return ret;
+}
