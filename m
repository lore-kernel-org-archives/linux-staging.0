N_BSSID_EX *bssid)
+{
+	int	i;
+	u32	len;
+	u8	*p;
+	u16	val16, subtype;
+	u8	*pframe =3D precv_frame->u.hdr.rx_data;
+	u32	packet_len =3D precv_frame->u.hdr.len;
+	u8 ie_offset;
+	struct registry_priv	*pregistrypriv =3D &padapter->registrypriv;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+
+	len =3D packet_len - sizeof(struct rtw_ieee80211_hdr_3addr);
+
+	if (len > MAX_IE_SZ) {
+		/* RTW_INFO("IE too long for survey event\n"); */
+		return _FAIL;
+	}
+
+	memset(bssid, 0, sizeof(WLAN_BSSID_EX));
+
+	subtype =3D get_frame_sub_type(pframe);
+
+	if (subtype =3D=3D WIFI_BEACON) {
+		bssid->Reserved[0] =3D 1;
+		ie_offset =3D _BEACON_IE_OFFSET_;
+	} else {
+		/* FIXME : more type */
+		if (subtype =3D=3D WIFI_PROBERSP) {
+			ie_offset =3D _PROBERSP_IE_OFFSET_;
+			bssid->Reserved[0] =3D 3;
+		} else if (subtype =3D=3D WIFI_PROBEREQ) {
+			ie_offset =3D _PROBEREQ_IE_OFFSET_;
+			bssid->Reserved[0] =3D 2;
+		} else {
+			bssid->Reserved[0] =3D 0;
+			ie_offset =3D _FIXED_IE_LENGTH_;
+		}
+	}
+
+	bssid->Length =3D sizeof(WLAN_BSSID_EX) - MAX_IE_SZ + len;
+
+	/* below is to copy the information element */
+	bssid->IELength =3D len;
+	memcpy(bssid->IEs, (pframe + sizeof(struct rtw_ieee80211_hdr_3addr)), bss=
id->IELength);
+
+	/* get the signal strength */
+	/* bssid->Rssi =3D precv_frame->u.hdr.attrib.SignalStrength; */ /* 0-100 =
index. */
+	bssid->Rssi =3D precv_frame->u.hdr.attrib.phy_info.RecvSignalPower; /* in=
 dBM.raw data	 */
+	bssid->PhyInfo.SignalQuality =3D precv_frame->u.hdr.attrib.phy_info.Signa=
lQuality;/* in percentage */
+	bssid->PhyInfo.SignalStrength =3D precv_frame->u.hdr.attrib.phy_info.Sign=
alStrength;/* in percentage */
+#ifdef CONFIG_ANTENNA_DIVERSITY
+	rtw_hal_get_odm_var(padapter, HAL_ODM_ANTDIV_SELECT, &(bssid->PhyInfo.Opt=
imum_antenna), NULL);
+#endif
+
+	/* checking SSID */
+	p =3D rtw_get_ie(bssid->IEs + ie_offset, _SSID_IE_, &len, bssid->IELength=
 - ie_offset);
+	if (p =3D=3D NULL) {
+		RTW_INFO("marc: cannot find SSID for survey event\n");
+		return _FAIL;
+	}
+
+	if (*(p + 1)) {
+		if (len > NDIS_802_11_LENGTH_SSID) {
+			RTW_INFO("%s()-%d: IE too long (%d) for survey event\n", __func__, __LI=
NE__, len);
+			return _FAIL;
+		}
+		memcpy(bssid->Ssid.Ssid, (p + 2), *(p + 1));
+		bssid->Ssid.SsidLength =3D *(p + 1);
+	} else
+		bssid->Ssid.SsidLength =3D 0;
+
+	memset(bssid->SupportedRates, 0, NDIS_802_11_LENGTH_RATES_EX);
+
+	/* checking rate info... */
+	i =3D 0;
+	p =3D rtw_get_ie(bssid->IEs + ie_offset, _SUPPORTEDRATES_IE_, &len, bssid=
->IELength - ie_offset);
+	if (p !=3D NULL) {
+		if (len > NDIS_802_11_LENGTH_RATES_EX) {
+			RTW_INFO("%s()-%d: IE too long (%d) for survey event\n", __func__, __LI=
NE__, len);
+			return _FAIL;
+		}
+		memcpy(bssid->SupportedRates, (p + 2), len);
+		i =3D len;
+	}
+
+	p =3D rtw_get_ie(bssid->IEs + ie_offset, _EXT_SUPPORTEDRATES_IE_, &len, b=
ssid->IELength - ie_offset);
+	if (p !=3D NULL) {
+		if (len > (NDIS_802_11_LENGTH_RATES_EX - i)) {
+			RTW_INFO("%s()-%d: IE too long (%d) for survey event\n", __func__, __LI=
NE__, len);
+			return _FAIL;
+		}
+		memcpy(bssid->SupportedRates + i, (p + 2), len);
+	}
+
+	/* todo: */
+	bssid->NetworkTypeInUse =3D Ndis802_11OFDM24;
+
+#ifdef CONFIG_P2P
+	if (subtype =3D=3D WIFI_PROBEREQ) {
+		u8 *p2p_ie;
+		u32	p2p_ielen;
+		/* Set Listion Channel */
+		p2p_ie =3D rtw_get_p2p_ie(bssid->IEs, bssid->IELength, NULL, &p2p_ielen);
+		if (p2p_ie) {
