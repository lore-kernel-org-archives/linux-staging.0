+		for (i =3D 0; i < 4; ++i) {
+			PwrByRateVal[i] =3D (s8)((((Value >> (i * 8 + 4)) & 0xF)) * 10 +
+					       ((Value >> (i * 8)) & 0xF));
+		}
+		*RateNum =3D 4;
+		break;
+
+	case 0xCD8:
+	case 0xED8:
+	case 0x18D8:
+	case 0x1aD8:
+		Rate[0] =3D MGN_MCS16;
+		Rate[1] =3D MGN_MCS17;
+		Rate[2] =3D MGN_MCS18;
+		Rate[3] =3D MGN_MCS19;
+		for (i =3D 0; i < 4; ++i) {
+			PwrByRateVal[i] =3D (s8)((((Value >> (i * 8 + 4)) & 0xF)) * 10 +
+					       ((Value >> (i * 8)) & 0xF));
+		}
+		*RateNum =3D 4;
+		break;
+
+	case 0xCDC:
+	case 0xEDC:
+	case 0x18DC:
+	case 0x1aDC:
+		Rate[0] =3D MGN_MCS20;
+		Rate[1] =3D MGN_MCS21;
+		Rate[2] =3D MGN_MCS22;
+		Rate[3] =3D MGN_MCS23;
+		for (i =3D 0; i < 4; ++i) {
+			PwrByRateVal[i] =3D (s8)((((Value >> (i * 8 + 4)) & 0xF)) * 10 +
+					       ((Value >> (i * 8)) & 0xF));
+		}
+		*RateNum =3D 4;
+		break;
+
+	case 0xCE0:
+	case 0xEE0:
+	case 0x18E0:
+	case 0x1aE0:
+		Rate[0] =3D MGN_VHT3SS_MCS0;
+		Rate[1] =3D MGN_VHT3SS_MCS1;
+		Rate[2] =3D MGN_VHT3SS_MCS2;
+		Rate[3] =3D MGN_VHT3SS_MCS3;
+		for (i =3D 0; i < 4; ++i) {
+			PwrByRateVal[i] =3D (s8)((((Value >> (i * 8 + 4)) & 0xF)) * 10 +
+					       ((Value >> (i * 8)) & 0xF));
+		}
+		*RateNum =3D 4;
+		break;
+
+	case 0xCE4:
+	case 0xEE4:
+	case 0x18E4:
+	case 0x1aE4:
+		Rate[0] =3D MGN_VHT3SS_MCS4;
+		Rate[1] =3D MGN_VHT3SS_MCS5;
+		Rate[2] =3D MGN_VHT3SS_MCS6;
+		Rate[3] =3D MGN_VHT3SS_MCS7;
+		for (i =3D 0; i < 4; ++i) {
+			PwrByRateVal[i] =3D (s8)((((Value >> (i * 8 + 4)) & 0xF)) * 10 +
+					       ((Value >> (i * 8)) & 0xF));
+		}
+		*RateNum =3D 4;
+		break;
+
+	case 0xCE8:
+	case 0xEE8:
+	case 0x18E8:
+	case 0x1aE8:
+		Rate[0] =3D MGN_VHT3SS_MCS8;
+		Rate[1] =3D MGN_VHT3SS_MCS9;
+		for (i =3D 0; i < 2; ++i) {
+			PwrByRateVal[i] =3D (s8)((((Value >> (i * 8 + 4)) & 0xF)) * 10 +
+					       ((Value >> (i * 8)) & 0xF));
+		}
+		*RateNum =3D 2;
+		break;
+
+	default:
+		RTW_PRINT("Invalid RegAddr 0x%x in %s()\n", RegAddr, __func__);
+		break;
+	};
