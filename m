+void
+PHY_ConvertTxPowerLimitToPowerIndex(
+	PADAPTER			Adapter
+)
+{
+	HAL_DATA_TYPE *pHalData =3D GET_HAL_DATA(Adapter);
+	u8 base;
+	u8 regulation, bw, channel, rateSection;
+	s8 tempValue =3D 0, tempPwrLmt =3D 0;
+	u8 rfPath =3D 0;
+
+	if (pHalData->odmpriv.phy_reg_pg_value_type !=3D PHY_REG_PG_EXACT_VALUE) {
+		rtw_warn_on(1);
+		return;
+	}
+
+	phy_CrossReferenceHTAndVHTTxPowerLimit(Adapter);
+
+	for (regulation =3D 0; regulation < MAX_REGULATION_NUM; ++regulation) {
+
+		for (bw =3D 0; bw < MAX_2_4G_BANDWIDTH_NUM; ++bw) {
+
+			for (channel =3D 0; channel < CENTER_CH_2G_NUM; ++channel) {
+
+				for (rateSection =3D CCK; rateSection <=3D HT_4SS; ++rateSection) {
+					tempPwrLmt =3D pHalData->TxPwrLimit_2_4G[regulation][bw][rateSection]=
[channel][RF_PATH_A];
+
+					if (tempPwrLmt !=3D MAX_POWER_INDEX) {
+
+						for (rfPath =3D RF_PATH_A; rfPath < MAX_RF_PATH; ++rfPath) {
+							base =3D PHY_GetTxPowerByRateBase(Adapter, BAND_ON_2_4G, rfPath, ra=
te_section_to_tx_num(rateSection), rateSection);
+							tempValue =3D tempPwrLmt - base;
+							pHalData->TxPwrLimit_2_4G[regulation][bw][rateSection][channel][rfP=
ath] =3D tempValue;
+						}
+					}
+				}
+			}
+		}
+	}
+}
