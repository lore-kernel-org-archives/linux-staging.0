+
+static struct xmit_frame *alloc_mp_xmitframe(struct xmit_priv *pxmitpriv)
+{
+	struct xmit_frame	*pmpframe;
+	struct xmit_buf	*pxmitbuf;
+
+	pmpframe =3D rtw_alloc_xmitframe(pxmitpriv);
+	if (pmpframe =3D=3D NULL)
+		return NULL;
+
+	pxmitbuf =3D rtw_alloc_xmitbuf(pxmitpriv);
+	if (pxmitbuf =3D=3D NULL) {
+		rtw_free_xmitframe(pxmitpriv, pmpframe);
+		return NULL;
+	}
+
+	pmpframe->frame_tag =3D MP_FRAMETAG;
+
+	pmpframe->pxmitbuf =3D pxmitbuf;
+
+	pmpframe->buf_addr =3D pxmitbuf->pbuf;
+
+	pxmitbuf->priv_data =3D pmpframe;
+
+	return pmpframe;
+
+}
