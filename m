+#ifdef CONFIG_EFUSE_CONFIG_FILE
+u32 rtw_read_efuse_from_file(const char *path, u8 *buf, int map_size)
+{
+	u32 i;
+	u8 c;
+	u8 temp[3];
+	u8 temp_i;
+	u8 end =3D false;
+	u32 ret =3D _FAIL;
+
+	u8 *file_data =3D NULL;
+	u32 file_size, read_size, pos =3D 0;
+	u8 *map =3D NULL;
+
+	if (rtw_is_file_readable_with_size(path, &file_size) !=3D true) {
+		RTW_PRINT("%s %s is not readable\n", __func__, path);
+		goto exit;
+	}
+
+	file_data =3D vmalloc(file_size);
+	if (!file_data) {
+		RTW_ERR("%s vmalloc(%d) fail\n", __func__, file_size);
+		goto exit;
+	}
+
+	read_size =3D rtw_retrieve_from_file(path, file_data, file_size);
+	if (read_size =3D=3D 0) {
+		RTW_ERR("%s read from %s fail\n", __func__, path);
+		goto exit;
+	}
+
+	map =3D vmalloc(map_size);
+	if (!map) {
+		RTW_ERR("%s vmalloc(%d) fail\n", __func__, map_size);
+		goto exit;
+	}
+	memset(map, 0xff, map_size);
+
+	temp[2] =3D 0; /* end of string '\0' */
+
+	for (i =3D 0 ; i < map_size ; i++) {
+		temp_i =3D 0;
+
+		while (1) {
+			if (pos >=3D read_size) {
+				end =3D true;
+				break;
+			}
+			c =3D file_data[pos++];
+
+			/* bypass spece or eol or null before first hex digit */
+			if (temp_i =3D=3D 0 && (is_eol(c) =3D=3D true || is_space(c) =3D=3D tru=
e || is_null(c) =3D=3D true))
+				continue;
+
+			if (IsHexDigit(c) =3D=3D false) {
+				RTW_ERR("%s invalid 8-bit hex format for offset:0x%03x\n", __func__, i=
);
+				goto exit;
+			}
+
+			temp[temp_i++] =3D c;
+
+			if (temp_i =3D=3D 2) {
+				/* parse value */
+				if (sscanf(temp, "%hhx", &map[i]) !=3D 1) {
+					RTW_ERR("%s sscanf fail for offset:0x%03x\n", __func__, i);
+					goto exit;
+				}
+				break;
+			}
+		}
+
+		if (end =3D=3D true) {
+			if (temp_i !=3D 0) {
+				RTW_ERR("%s incomplete 8-bit hex format for offset:0x%03x\n", __func__=
, i);
+				goto exit;
+			}
+			break;
+		}
+	}
+
+	RTW_PRINT("efuse file:%s, 0x%03x byte content read\n", path, i);
+
+	memcpy(buf, map, map_size);
+
+	ret =3D _SUCCESS;
+
+exit:
+	if (file_data)
+		rtw_vmfree(file_data, file_size);
+	if (map)
+		rtw_vmfree(map, map_size);
+
+	return ret;
+}
+
+u32 rtw_read_macaddr_from_file(const char *path, u8 *buf)
+{
+	u32 i;
+	u8 temp[3];
+	u32 ret =3D _FAIL;
+
+	u8 file_data[17];
+	u32 read_size, pos =3D 0;
+	u8 addr[ETH_ALEN];
+
+	if (rtw_is_file_readable(path) !=3D true) {
+		RTW_PRINT("%s %s is not readable\n", __func__, path);
+		goto exit;
+	}
+
+	read_size =3D rtw_retrieve_from_file(path, file_data, 17);
+	if (read_size !=3D 17) {
+		RTW_ERR("%s read from %s fail\n", __func__, path);
+		goto exit;
+	}
+
+	temp[2] =3D 0; /* end of string '\0' */
+
+	for (i =3D 0 ; i < ETH_ALEN ; i++) {
+		if (IsHexDigit(file_data[i * 3]) =3D=3D false || IsHexDigit(file_data[i =
* 3 + 1]) =3D=3D false) {
+			RTW_ERR("%s invalid 8-bit hex format for address offset:%u\n", __func__=
, i);
+			goto exit;
+		}
+
+		if (i < ETH_ALEN - 1 && file_data[i * 3 + 2] !=3D ':') {
+			RTW_ERR("%s invalid separator after address offset:%u\n", __func__, i);
+			goto exit;
+		}
+
+		temp[0] =3D file_data[i * 3];
+		temp[1] =3D file_data[i * 3 + 1];
+		if (sscanf(temp, "%hhx", &addr[i]) !=3D 1) {
+			RTW_ERR("%s sscanf fail for address offset:0x%03x\n", __func__, i);
+			goto exit;
+		}
+	}
+
+	memcpy(buf, addr, ETH_ALEN);
+
+	RTW_PRINT("wifi_mac file: %s\n", path);
+#ifdef CONFIG_RTW_DEBUG
+	RTW_INFO(MAC_FMT"\n", MAC_ARG(buf));
+#endif
+
+	ret =3D _SUCCESS;
+
+exit:
+	return ret;
+}
