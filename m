+ * See README and COPYING for more details.
+ */
+
+#include "includes.h"
+
+#include "common.h"
+#include "ieee802_11_defs.h"
+#include "ieee802_11_common.h"
+
+
+static int ieee802_11_parse_vendor_specific(const u8 *pos, size_t elen,
+					    struct ieee802_11_elems *elems,
+					    int show_errors)
+{
+	unsigned int oui;
+
+	/* first 3 bytes in vendor specific information element are the IEEE
+	 * OUI of the vendor. The following byte is used a vendor specific
+	 * sub-type. */
+	if (elen < 4) {
+		if (show_errors) {
+			wpa_printf(MSG_MSGDUMP, "short vendor specific "
+				   "information element ignored (len=3D%lu)",
+				   (unsigned long) elen);
+		}
+		return -1;
+	}
+
+	oui =3D WPA_GET_BE24(pos);
+	switch (oui) {
+	case OUI_MICROSOFT:
+		/* Microsoft/Wi-Fi information elements are further typed and
+		 * subtyped */
+		switch (pos[3]) {
+		case 1:
+			/* Microsoft OUI (00:50:F2) with OUI Type 1:
+			 * real WPA information element */
+			elems->wpa_ie =3D pos;
+			elems->wpa_ie_len =3D elen;
+			break;
+		case WMM_OUI_TYPE:
+			/* WMM information element */
+			if (elen < 5) {
+				wpa_printf(MSG_MSGDUMP, "short WMM "
+					   "information element ignored "
+					   "(len=3D%lu)",
+					   (unsigned long) elen);
+				return -1;
+			}
+			switch (pos[4]) {
+			case WMM_OUI_SUBTYPE_INFORMATION_ELEMENT:
+			case WMM_OUI_SUBTYPE_PARAMETER_ELEMENT:
+				/*
+				 * Share same pointer since only one of these
+				 * is used and they start with same data.
+				 * Length field can be used to distinguish the
+				 * IEs.
+				 */
+				elems->wmm =3D pos;
+				elems->wmm_len =3D elen;
+				break;
+			case WMM_OUI_SUBTYPE_TSPEC_ELEMENT:
+				elems->wmm_tspec =3D pos;
+				elems->wmm_tspec_len =3D elen;
+				break;
+			default:
+				wpa_printf(MSG_EXCESSIVE, "unknown WMM "
+					   "information element ignored "
+					   "(subtype=3D%d len=3D%lu)",
+					   pos[4], (unsigned long) elen);
+				return -1;
+			}
+			break;
+		case 4:
+			/* Wi-Fi Protected Setup (WPS) IE */
+			elems->wps_ie =3D pos;
+			elems->wps_ie_len =3D elen;
+			break;
+		default:
+			wpa_printf(MSG_EXCESSIVE, "Unknown Microsoft "
+				   "information element ignored "
+				   "(type=3D%d len=3D%lu)",
+				   pos[3], (unsigned long) elen);
+			return -1;
+		}
+		break;
+
+	case OUI_WFA:
+		switch (pos[3]) {
+		case P2P_OUI_TYPE:
+			/* Wi-Fi Alliance - P2P IE */
+			elems->p2p =3D pos;
+			elems->p2p_len =3D elen;
+			break;
+		default:
+			wpa_printf(MSG_MSGDUMP, "Unknown WFA "
+				   "information element ignored "
+				   "(type=3D%d len=3D%lu)\n",
+				   pos[3], (unsigned long) elen);
+			return -1;
+		}
+		break;
+
+	case OUI_BROADCOM:
+		switch (pos[3]) {
+		case VENDOR_HT_CAPAB_OUI_TYPE:
+			elems->vendor_ht_cap =3D pos;
+			elems->vendor_ht_cap_len =3D elen;
+			break;
+		default:
+			wpa_printf(MSG_EXCESSIVE, "Unknown Broadcom "
+				   "information element ignored "
+				   "(type=3D%d len=3D%lu)",
+				   pos[3], (unsigned long) elen);
+			return -1;
+		}
+		break;
+
+	default:
+		wpa_printf(MSG_EXCESSIVE, "unknown vendor specific "
+			   "information element ignored (vendor OUI "
+			   "%02x:%02x:%02x len=3D%lu)",
+			   pos[0], pos[1], pos[2], (unsigned long) elen);
+		return -1;
+	}
+
+	return 0;
+}
+
+
+/**
+ * ieee802_11_parse_elems - Parse information elements in management frames
+ * @start: Pointer to the start of IEs
+ * @len: Length of IE buffer in octets
+ * @elems: Data structure for parsed elements
+ * @show_errors: Whether to show parsing errors in debug log
+ * Returns: Parsing result
+ */
+ParseRes ieee802_11_parse_elems(const u8 *start, size_t len,
+				struct ieee802_11_elems *elems,
+				int show_errors)
+{
+	size_t left =3D len;
+	const u8 *pos =3D start;
+	int unknown =3D 0;
+
+	os_memset(elems, 0, sizeof(*elems));
+
+	while (left >=3D 2) {
+		u8 id, elen;
+
+		id =3D *pos++;
+		elen =3D *pos++;
+		left -=3D 2;
+
+		if (elen > left) {
+			if (show_errors) {
+				wpa_printf(MSG_DEBUG, "IEEE 802.11 element "
+					   "parse failed (id=3D%d elen=3D%d "
+					   "left=3D%lu)",
+					   id, elen, (unsigned long) left);
+				wpa_hexdump(MSG_MSGDUMP, "IEs", start, len);
+			}
+			return ParseFailed;
+		}
+
+		switch (id) {
+		case WLAN_EID_SSID:
+			elems->ssid =3D pos;
+			elems->ssid_len =3D elen;
+			break;
+		case WLAN_EID_SUPP_RATES:
+			elems->supp_rates =3D pos;
+			elems->supp_rates_len =3D elen;
+			break;
+		case WLAN_EID_FH_PARAMS:
+			elems->fh_params =3D pos;
+			elems->fh_params_len =3D elen;
+			break;
+		case WLAN_EID_DS_PARAMS:
+			elems->ds_params =3D pos;
+			elems->ds_params_len =3D elen;
+			break;
+		case WLAN_EID_CF_PARAMS:
+			elems->cf_params =3D pos;
+			elems->cf_params_len =3D elen;
+			break;
+		case WLAN_EID_TIM:
+			elems->tim =3D pos;
+			elems->tim_len =3D elen;
+			break;
+		case WLAN_EID_IBSS_PARAMS:
+			elems->ibss_params =3D pos;
+			elems->ibss_params_len =3D elen;
+			break;
+		case WLAN_EID_CHALLENGE:
+			elems->challenge =3D pos;
+			elems->challenge_len =3D elen;
+			break;
+		case WLAN_EID_ERP_INFO:
+			elems->erp_info =3D pos;
+			elems->erp_info_len =3D elen;
+			break;
+		case WLAN_EID_EXT_SUPP_RATES:
+			elems->ext_supp_rates =3D pos;
+			elems->ext_supp_rates_len =3D elen;
+			break;
+		case WLAN_EID_VENDOR_SPECIFIC:
+			if (ieee802_11_parse_vendor_specific(pos, elen,
+							     elems,
+							     show_errors))
+				unknown++;
+			break;
+		case WLAN_EID_RSN:
+			elems->rsn_ie =3D pos;
+			elems->rsn_ie_len =3D elen;
+			break;
+		case WLAN_EID_PWR_CAPABILITY:
+			elems->power_cap =3D pos;
+			elems->power_cap_len =3D elen;
+			break;
+		case WLAN_EID_SUPPORTED_CHANNELS:
+			elems->supp_channels =3D pos;
+			elems->supp_channels_len =3D elen;
+			break;
+		case WLAN_EID_MOBILITY_DOMAIN:
+			elems->mdie =3D pos;
+			elems->mdie_len =3D elen;
+			break;
+		case WLAN_EID_FAST_BSS_TRANSITION:
+			elems->ftie =3D pos;
+			elems->ftie_len =3D elen;
+			break;
+		case WLAN_EID_TIMEOUT_INTERVAL:
+			elems->timeout_int =3D pos;
+			elems->timeout_int_len =3D elen;
+			break;
+		case WLAN_EID_HT_CAP:
+			elems->ht_capabilities =3D pos;
+			elems->ht_capabilities_len =3D elen;
+			break;
+		case WLAN_EID_HT_OPERATION:
+			elems->ht_operation =3D pos;
+			elems->ht_operation_len =3D elen;
+			break;
+		case WLAN_EID_LINK_ID:
+			if (elen < 18)
+				break;
+			elems->link_id =3D pos;
+			break;
+		default:
+			unknown++;
+			if (!show_errors)
+				break;
+			wpa_printf(MSG_MSGDUMP, "IEEE 802.11 element parse "
+				   "ignored unknown element (id=3D%d elen=3D%d)",
+				   id, elen);
+			break;
+		}
+
+		left -=3D elen;
+		pos +=3D elen;
+	}
+
+	if (left)
+		return ParseFailed;
+
+	return unknown ? ParseUnknown : ParseOK;
+}
+
+
+int ieee802_11_ie_count(const u8 *ies, size_t ies_len)
+{
+	int count =3D 0;
+	const u8 *pos, *end;
+
+	if (ies =3D=3D NULL)
+		return 0;
+
+	pos =3D ies;
+	end =3D ies + ies_len;
+
+	while (pos + 2 <=3D end) {
+		if (pos + 2 + pos[1] > end)
+			break;
+		count++;
+		pos +=3D 2 + pos[1];
+	}
+
+	return count;
+}
+
+
+struct wpabuf * ieee802_11_vendor_ie_concat(const u8 *ies, size_t ies_len,
+					    u32 oui_type)
+{
+	struct wpabuf *buf;
+	const u8 *end, *pos, *ie;
+
+	pos =3D ies;
+	end =3D ies + ies_len;
+	ie =3D NULL;
+
+	while (pos + 1 < end) {
+		if (pos + 2 + pos[1] > end)
+			return NULL;
+		if (pos[0] =3D=3D WLAN_EID_VENDOR_SPECIFIC && pos[1] >=3D 4 &&
+		    WPA_GET_BE32(&pos[2]) =3D=3D oui_type) {
+			ie =3D pos;
+			break;
+		}
+		pos +=3D 2 + pos[1];
+	}
+
+	if (ie =3D=3D NULL)
+		return NULL; /* No specified vendor IE found */
+
+	buf =3D wpabuf_alloc(ies_len);
+	if (buf =3D=3D NULL)
+		return NULL;
+
+	/*
+	 * There may be multiple vendor IEs in the message, so need to
+	 * concatenate their data fields.
+	 */
+	while (pos + 1 < end) {
+		if (pos + 2 + pos[1] > end)
+			break;
+		if (pos[0] =3D=3D WLAN_EID_VENDOR_SPECIFIC && pos[1] >=3D 4 &&
+		    WPA_GET_BE32(&pos[2]) =3D=3D oui_type)
+			wpabuf_put_data(buf, pos + 6, pos[1] - 4);
+		pos +=3D 2 + pos[1];
+	}
+
+	return buf;
+}
