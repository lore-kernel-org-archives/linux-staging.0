+#define RND(a,b,c,d,e,f,g,h,i)                          \
+	t0 =3D h + Sigma1(e) + Ch(e, f, g) + K[i] + W[i];	\
+	t1 =3D Sigma0(a) + Maj(a, b, c);			\
+	d +=3D t0;					\
+	h  =3D t0 + t1;
+
+	for (i =3D 0; i < 64; ++i) {
+		RND(S[0], S[1], S[2], S[3], S[4], S[5], S[6], S[7], i);
+		t =3D S[7]; S[7] =3D S[6]; S[6] =3D S[5]; S[5] =3D S[4];=20
+		S[4] =3D S[3]; S[3] =3D S[2]; S[2] =3D S[1]; S[1] =3D S[0]; S[0] =3D t;
+	}
+
+	/* feedback */
+	for (i =3D 0; i < 8; i++) {
+		md->state[i] =3D md->state[i] + S[i];
+	}
+	return 0;
+}
+
+
+/* Initialize the hash state */
