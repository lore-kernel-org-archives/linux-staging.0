+	u32					addr,
+	u32					data,
+	enum odm_rf_radio_path_e     RF_PATH,
+	u32				    reg_addr
+)
+{
+	if (addr =3D=3D 0xffe) {
+#ifdef CONFIG_LONG_DELAY_ISSUE
+		ODM_sleep_ms(50);
+#else
+		ODM_delay_ms(50);
+#endif
+	} else if (addr =3D=3D 0xfd)
+		ODM_delay_ms(5);
+	else if (addr =3D=3D 0xfc)
+		ODM_delay_ms(1);
+	else if (addr =3D=3D 0xfb)
+		ODM_delay_us(50);
+	else if (addr =3D=3D 0xfa)
+		ODM_delay_us(5);
+	else if (addr =3D=3D 0xf9)
+		ODM_delay_us(1);
+	else {
+		odm_set_rf_reg(p_dm_odm, RF_PATH, reg_addr, RFREGOFFSETMASK, data);
+		/* Add 1us delay between BB/RF register setting. */
+		ODM_delay_us(1);
+	}
