+bool rtw_ap_chbw_decision(_adapter *adapter, s16 req_ch, s8 req_bw, s8 req=
_offset
+			  , u8 *ch, u8 *bw, u8 *offset, u8 *chbw_allow)
+{
+	u8 cur_ie_ch, cur_ie_bw, cur_ie_offset;
+	u8 dec_ch, dec_bw, dec_offset;
+	u8 u_ch =3D 0, u_offset, u_bw;
+	bool changed =3D false;
+	struct mlme_ext_priv *mlmeext =3D &(adapter->mlmeextpriv);
