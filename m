+
+				/* RTW_INFO("After send deauth , %u ms has elapsed.\n", rtw_get_passin=
g_time_ms(send_issue_deauth_time)); */
+
+				if (rtw_get_passing_time_ms(send_issue_deauth_time) > 10000 || send_is=
sue_deauth_time =3D=3D 0) {
+					send_issue_deauth_time =3D jiffies;
+
+					RTW_INFO("issue_deauth to the ap=3D" MAC_FMT " for the reason(7)\n", =
MAC_ARG(pattrib->bssid));
