+static void add_ifidx(struct wpa_driver_nl80211_data *drv, int ifidx)
+{
+	int i;
+	int *old;
+
+	wpa_printf(MSG_DEBUG, "nl80211: Add own interface ifindex %d",
+		   ifidx);
+	for (i =3D 0; i < drv->num_if_indices; i++) {
+		if (drv->if_indices[i] =3D=3D 0) {
+			drv->if_indices[i] =3D ifidx;
+			return;
+		}
+	}
+
+	if (drv->if_indices !=3D drv->default_if_indices)
+		old =3D drv->if_indices;
+	else
+		old =3D NULL;
+
+	drv->if_indices =3D os_realloc(old,
+				     sizeof(int) * (drv->num_if_indices + 1));
+	if (!drv->if_indices) {
+		if (!old)
+			drv->if_indices =3D drv->default_if_indices;
+		else
+			drv->if_indices =3D old;
+		wpa_printf(MSG_ERROR, "Failed to reallocate memory for "
+			   "interfaces");
+		wpa_printf(MSG_ERROR, "Ignoring EAPOL on interface %d", ifidx);
+		return;
+	} else if (!old)
+		os_memcpy(drv->if_indices, drv->default_if_indices,
+			  sizeof(drv->default_if_indices));
+	drv->if_indices[drv->num_if_indices] =3D ifidx;
+	drv->num_if_indices++;
+}
