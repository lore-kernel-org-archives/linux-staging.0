+static int wpa_supplicant_ioctl(struct net_device *dev, struct iw_point *p)
+{
+	struct ieee_param *param;
+	uint ret =3D 0;
+
+	/* down(&ieee->wx_sem);	 */
+
+	if (!p->pointer || p->length !=3D sizeof(struct ieee_param))
+		return -EINVAL;
+
+	param =3D (struct ieee_param *)rtw_malloc(p->length);
+	if (param =3D=3D NULL)
+		return -ENOMEM;
+
+	if (copy_from_user(param, p->pointer, p->length)) {
+		rtw_mfree((u8 *)param, p->length);
+		return -EFAULT;
+	}
+
+	switch (param->cmd) {
+
+	case IEEE_CMD_SET_WPA_PARAM:
+		ret =3D wpa_set_param(dev, param->u.wpa_param.name, param->u.wpa_param.v=
alue);
+		break;
+
+	case IEEE_CMD_SET_WPA_IE:
+		/* ret =3D wpa_set_wpa_ie(dev, param, p->length); */
+		ret =3D  rtw_set_wpa_ie((_adapter *)rtw_netdev_priv(dev), (char *)param-=
>u.wpa_ie.data, (u16)param->u.wpa_ie.len);
+		break;
+
+	case IEEE_CMD_SET_ENCRYPTION:
+		ret =3D wpa_set_encryption(dev, param, p->length);
+		break;
+
+	case IEEE_CMD_MLME:
+		ret =3D wpa_mlme(dev, param->u.mlme.command, param->u.mlme.reason_code);
+		break;
+
+	default:
+		RTW_INFO("Unknown WPA supplicant request: %d\n", param->cmd);
+		ret =3D -EOPNOTSUPP;
+		break;
+
+	}
+
+	if (ret =3D=3D 0 && copy_to_user(p->pointer, param, p->length))
+		ret =3D -EFAULT;
+
+	rtw_mfree((u8 *)param, p->length);
+	return ret;
+}
