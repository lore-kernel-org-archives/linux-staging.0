+	HTTPREAD_EVENT_FILE_READY =3D 1,        /* including reply ready */
+	HTTPREAD_EVENT_TIMEOUT =3D 2,
+	HTTPREAD_EVENT_ERROR =3D 3      /* misc. error, esp malloc error */
+};
