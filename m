+static void ieee80211n_switch_pri_sec(struct hostapd_iface *iface)
+{
+	if (iface->conf->secondary_channel > 0) {
+		iface->conf->channel +=3D 4;
+		iface->conf->secondary_channel =3D -1;
+	} else {
+		iface->conf->channel -=3D 4;
+		iface->conf->secondary_channel =3D 1;
+	}
+}
