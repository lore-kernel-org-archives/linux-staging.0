+static int tncs_supported_type(struct tnc_if_imv *imv, unsigned int type)
+{
+	size_t i;
+	unsigned int vendor, subtype;
+
+	if (imv =3D=3D NULL || imv->supported_types =3D=3D NULL)
+		return 0;
+
+	vendor =3D type >> 8;
+	subtype =3D type & 0xff;
+
+	for (i =3D 0; i < imv->num_supported_types; i++) {
+		unsigned int svendor, ssubtype;
+		svendor =3D imv->supported_types[i] >> 8;
+		ssubtype =3D imv->supported_types[i] & 0xff;
+		if ((vendor =3D=3D svendor || svendor =3D=3D TNC_VENDORID_ANY) &&
+		    (subtype =3D=3D ssubtype || ssubtype =3D=3D TNC_SUBTYPE_ANY))
+			return 1;
+	}
+
+	return 0;
+}
