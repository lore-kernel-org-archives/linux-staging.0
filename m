+	eloop.signaled++;
+	for (i =3D 0; i < eloop.signal_count; i++) {
+		if (eloop.signals[i].sig =3D=3D sig) {
+			eloop.signals[i].signaled++;
+			break;
+		}
+	}
+}
+
+
+static void eloop_process_pending_signals(void)
+{
+	int i;
+
+	if (eloop.signaled =3D=3D 0)
+		return;
+	eloop.signaled =3D 0;
+
+	if (eloop.pending_terminate) {
+#ifndef CONFIG_NATIVE_WINDOWS
+		alarm(0);
+#endif /* CONFIG_NATIVE_WINDOWS */
+		eloop.pending_terminate =3D 0;
+	}
+
+	for (i =3D 0; i < eloop.signal_count; i++) {
+		if (eloop.signals[i].signaled) {
+			eloop.signals[i].signaled =3D 0;
+			eloop.signals[i].handler(eloop.signals[i].sig,
+						 eloop.signals[i].user_data);
+		}
+	}
+}
+
+
+int eloop_register_signal(int sig, eloop_signal_handler handler,
+			  void *user_data)
+{
+	struct eloop_signal *tmp;
+
+	tmp =3D (struct eloop_signal *)
+		os_realloc(eloop.signals,
+			   (eloop.signal_count + 1) *
+			   sizeof(struct eloop_signal));
+	if (tmp =3D=3D NULL)
+		return -1;
+
+	tmp[eloop.signal_count].sig =3D sig;
+	tmp[eloop.signal_count].user_data =3D user_data;
+	tmp[eloop.signal_count].handler =3D handler;
+	tmp[eloop.signal_count].signaled =3D 0;
+	eloop.signal_count++;
