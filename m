+static sint recv_bcast_pn_decache(union recv_frame *precv_frame)
+{
+	_adapter *padapter =3D precv_frame->u.hdr.adapter;
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+	struct security_priv *psecuritypriv =3D &padapter->securitypriv;
+	struct rx_pkt_attrib *pattrib =3D &precv_frame->u.hdr.attrib;
+	u8 *pdata =3D precv_frame->u.hdr.rx_data;
+	u32 data_len =3D precv_frame->u.hdr.len;
+	u64 tmp_iv_hdr =3D 0;
+	u64 curr_pn =3D 0, pkt_pn =3D 0;
+	u8 key_id;
+
+	if ((pattrib->encrypt =3D=3D _AES_) &&
+		(check_fwstate(pmlmepriv, WIFI_STATION_STATE))) {=09=09
+
+		tmp_iv_hdr =3D le64_to_cpu(*(__le64*)(pdata + pattrib->hdrlen));
+		key_id =3D CCMPH_2_KEYID(tmp_iv_hdr);
+		pkt_pn =3D CCMPH_2_PN(tmp_iv_hdr);
+=09
+		curr_pn =3D le64_to_cpu(*(__le64*)psecuritypriv->iv_seq[key_id]);
+		curr_pn &=3D 0x0000ffffffffffffL;
+
+		if (!VALID_PN_CHK(pkt_pn, curr_pn))
+			return _FAIL;
+
+		*(__le64*)psecuritypriv->iv_seq[key_id] =3D cpu_to_le64(pkt_pn);
+	}
+
+	return _SUCCESS;
+}
