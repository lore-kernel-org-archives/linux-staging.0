+{
+	md->curlen =3D 0;
+	md->length =3D 0;
+	md->state[0] =3D 0x6A09E667UL;
+	md->state[1] =3D 0xBB67AE85UL;
+	md->state[2] =3D 0x3C6EF372UL;
+	md->state[3] =3D 0xA54FF53AUL;
+	md->state[4] =3D 0x510E527FUL;
+	md->state[5] =3D 0x9B05688CUL;
+	md->state[6] =3D 0x1F83D9ABUL;
+	md->state[7] =3D 0x5BE0CD19UL;
+}
+
+/**
+   Process a block of memory though the hash
+   @param md     The hash state
+   @param in     The data to hash
+   @param inlen  The length of the data (octets)
+   @return CRYPT_OK if successful
+*/
+static int sha256_process(struct sha256_state *md, const unsigned char *in,
+			  unsigned long inlen)
+{
+	unsigned long n;
+#define block_size 64
+
+	if (md->curlen > sizeof(md->buf))
+		return -1;
+
+	while (inlen > 0) {
+		if (md->curlen =3D=3D 0 && inlen >=3D block_size) {
+			if (sha256_compress(md, (unsigned char *) in) < 0)
+				return -1;
+			md->length +=3D block_size * 8;
+			in +=3D block_size;
+			inlen -=3D block_size;
+		} else {
+			n =3D MIN(inlen, (block_size - md->curlen));
+			os_memcpy(md->buf + md->curlen, in, n);
+			md->curlen +=3D n;
+			in +=3D n;
+			inlen -=3D n;
+			if (md->curlen =3D=3D block_size) {
+				if (sha256_compress(md, md->buf) < 0)
+					return -1;
+				md->length +=3D 8 * block_size;
+				md->curlen =3D 0;
+			}
+		}
+	}
+
+	return 0;
+}
+
+
+/**
+   Terminate the hash to get the digest
+   @param md  The hash state
+   @param out [out] The destination of the hash (32 bytes)
+   @return CRYPT_OK if successful
+*/
+static int sha256_done(struct sha256_state *md, unsigned char *out)
+{
+	int i;
+
+	if (md->curlen >=3D sizeof(md->buf))
+		return -1;
+
+	/* increase the length of the message */
+	md->length +=3D md->curlen * 8;
+
+	/* append the '1' bit */
+	md->buf[md->curlen++] =3D (unsigned char) 0x80;
+
+	/* if the length is currently above 56 bytes we append zeros
+	 * then compress.  Then we can fall back to padding zeros and length
+	 * encoding like normal.
+	 */
+	if (md->curlen > 56) {
+		while (md->curlen < 64) {
+			md->buf[md->curlen++] =3D (unsigned char) 0;
+		}
+		sha256_compress(md, md->buf);
+		md->curlen =3D 0;
+	}
+
+	/* pad upto 56 bytes of zeroes */
+	while (md->curlen < 56) {
+		md->buf[md->curlen++] =3D (unsigned char) 0;
+	}
+
+	/* store length */
+	WPA_PUT_BE64(md->buf + 56, md->length);
+	sha256_compress(md, md->buf);
+
+	/* copy output */
+	for (i =3D 0; i < 8; i++)
+		WPA_PUT_BE32(out + (4 * i), md->state[i]);
+
+	return 0;
+}
+
+/* =3D=3D=3D=3D=3D end - public domain SHA256 implementation =3D=3D=3D=3D=
=3D */
