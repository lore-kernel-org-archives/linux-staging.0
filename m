+
+	pframe +=3D sizeof(struct rtw_ieee80211_hdr_3addr);
+	pattrib->pktlen =3D sizeof(struct rtw_ieee80211_hdr_3addr);
+
+	pframe =3D rtw_set_fixed_ie(pframe, 1, &(category), &(pattrib->pktlen));
+	pframe =3D rtw_set_fixed_ie(pframe, 1, &(action), &(pattrib->pktlen));
+
+	if (category =3D=3D 3) {
