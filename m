+static void efuse_read_phymap_from_txpktbuf(
+	ADAPTER *adapter,
+	int bcnhead,	/* beacon head, where FW store len(2-byte) and efuse physica=
l map. */
+	u8 *content,	/* buffer to store efuse physical map */
+	u16 *size	/* for efuse content: the max byte to read. will update to byte=
 read */
+)
+{
+	u16 dbg_addr =3D 0;
+	u32 start  =3D 0, passing_time =3D 0;
+	u8 reg_0x143 =3D 0;
+	u8 reg_0x106 =3D 0;
+	u32 lo32 =3D 0, hi32 =3D 0;
+	u16 len =3D 0, count =3D 0;
+	int i =3D 0;
+	u16 limit =3D *size;
+
+	u8 *pos =3D content;
+
+	if (bcnhead < 0) /* if not valid */
+		bcnhead =3D rtw_read8(adapter, REG_TDECTRL + 1);
+
+	RTW_INFO("%s bcnhead:%d\n", __func__, bcnhead);
+
+	/* reg_0x106 =3D rtw_read8(adapter, REG_PKT_BUFF_ACCESS_CTRL); */
+	/* RTW_INFO("%s reg_0x106:0x%02x, write 0x%02x\n", __func__, reg_0x106, 0=
x69); */
+	rtw_write8(adapter, REG_PKT_BUFF_ACCESS_CTRL, TXPKT_BUF_SELECT);
+	/* RTW_INFO("%s reg_0x106:0x%02x\n", __func__, rtw_read8(adapter, 0x106))=
; */
+
+	dbg_addr =3D bcnhead * 128 / 8; /* 8-bytes addressing */
+
+	while (1) {
+		/* RTW_INFO("%s dbg_addr:0x%x\n", __func__, dbg_addr+i); */
+		rtw_write16(adapter, REG_PKTBUF_DBG_ADDR, dbg_addr + i);
+
+		/* RTW_INFO("%s write reg_0x143:0x00\n", __func__); */
+		rtw_write8(adapter, REG_TXPKTBUF_DBG, 0);
+		start =3D jiffies;
+		while (!(reg_0x143 =3D rtw_read8(adapter, REG_TXPKTBUF_DBG)) /* dbg */
+		       /* while(rtw_read8(adapter, REG_TXPKTBUF_DBG) & BIT0 */
+		       && (passing_time =3D rtw_get_passing_time_ms(start)) < 1000
+		      ) {
+			RTW_INFO("%s polling reg_0x143:0x%02x, reg_0x106:0x%02x\n", __func__, r=
eg_0x143, rtw_read8(adapter, 0x106));
+			rtw_usleep_os(100);
+		}
+
+
+		lo32 =3D rtw_read32(adapter, REG_PKTBUF_DBG_DATA_L);
+		hi32 =3D rtw_read32(adapter, REG_PKTBUF_DBG_DATA_H);
+
+		if (i =3D=3D 0) {
+			u8 lenc[2];
+			u16 lenbak, aaabak;
+			u16 aaa;
+			lenc[0] =3D rtw_read8(adapter, REG_PKTBUF_DBG_DATA_L);
+			lenc[1] =3D rtw_read8(adapter, REG_PKTBUF_DBG_DATA_L + 1);
+
+			aaabak =3D le16_to_cpup((__le16 *)lenc);
+			lenbak =3D le16_to_cpu(*((__le16 *)lenc));
+			aaa =3D le16_to_cpup((__le16 *)&lo32);
+			len =3D le16_to_cpu(*((__le16 *)&lo32));
+
+			limit =3D (len - 2 < limit) ? len - 2 : limit;
+
+			RTW_INFO("%s len:%u, lenbak:%u, aaa:%u, aaabak:%u\n", __func__, len, le=
nbak, aaa, aaabak);
+
+			memcpy(pos, ((u8 *)&lo32) + 2, (limit >=3D count + 2) ? 2 : limit - cou=
nt);
+			count +=3D (limit >=3D count + 2) ? 2 : limit - count;
+			pos =3D content + count;
+
+		} else {
+			memcpy(pos, ((u8 *)&lo32), (limit >=3D count + 4) ? 4 : limit - count);
+			count +=3D (limit >=3D count + 4) ? 4 : limit - count;
+			pos =3D content + count;
+
+
+		}
+
+		if (limit > count && len - 2 > count) {
+			memcpy(pos, (u8 *)&hi32, (limit >=3D count + 4) ? 4 : limit - count);
+			count +=3D (limit >=3D count + 4) ? 4 : limit - count;
+			pos =3D content + count;
+		}
+
+		if (limit <=3D count || len - 2 <=3D count)
+			break;
+
+		i++;
+	}
+
+	rtw_write8(adapter, REG_PKT_BUFF_ACCESS_CTRL, DISABLE_TRXPKT_BUF_ACCESS);
+
+	RTW_INFO("%s read count:%u\n", __func__, count);
+	*size =3D count;
+
+}
