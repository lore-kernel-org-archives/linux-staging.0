+			}
+		} else if (os_strcmp(buf, "ap_pin") =3D=3D 0) {
+			os_free(bss->ap_pin);
+			bss->ap_pin =3D os_strdup(pos);
+		} else if (os_strcmp(buf, "skip_cred_build") =3D=3D 0) {
+			bss->skip_cred_build =3D atoi(pos);
+		} else if (os_strcmp(buf, "extra_cred") =3D=3D 0) {
+			os_free(bss->extra_cred);
+			bss->extra_cred =3D
+				(u8 *) os_readfile(pos, &bss->extra_cred_len);
+			if (bss->extra_cred =3D=3D NULL) {
+				wpa_printf(MSG_ERROR, "Line %d: could not "
+					   "read Credentials from '%s'",
+					   line, pos);
+				errors++;
+			}
+		} else if (os_strcmp(buf, "wps_cred_processing") =3D=3D 0) {
+			bss->wps_cred_processing =3D atoi(pos);
+		} else if (os_strcmp(buf, "ap_settings") =3D=3D 0) {
+			os_free(bss->ap_settings);
+			bss->ap_settings =3D
+				(u8 *) os_readfile(pos, &bss->ap_settings_len);
+			if (bss->ap_settings =3D=3D NULL) {
+				wpa_printf(MSG_ERROR, "Line %d: could not "
+					   "read AP Settings from '%s'",
+					   line, pos);
+				errors++;
+			}
+		} else if (os_strcmp(buf, "upnp_iface") =3D=3D 0) {
+			bss->upnp_iface =3D os_strdup(pos);
+		} else if (os_strcmp(buf, "friendly_name") =3D=3D 0) {
+			os_free(bss->friendly_name);
+			bss->friendly_name =3D os_strdup(pos);
+		} else if (os_strcmp(buf, "manufacturer_url") =3D=3D 0) {
+			os_free(bss->manufacturer_url);
+			bss->manufacturer_url =3D os_strdup(pos);
+		} else if (os_strcmp(buf, "model_description") =3D=3D 0) {
+			os_free(bss->model_description);
+			bss->model_description =3D os_strdup(pos);
+		} else if (os_strcmp(buf, "model_url") =3D=3D 0) {
+			os_free(bss->model_url);
+			bss->model_url =3D os_strdup(pos);
+		} else if (os_strcmp(buf, "upc") =3D=3D 0) {
+			os_free(bss->upc);
+			bss->upc =3D os_strdup(pos);
+#endif /* CONFIG_WPS */
+#ifdef CONFIG_P2P_MANAGER
+		} else if (os_strcmp(buf, "manage_p2p") =3D=3D 0) {
+			int manage =3D atoi(pos);
+			if (manage)
+				bss->p2p |=3D P2P_MANAGE;
+			else
+				bss->p2p &=3D ~P2P_MANAGE;
+		} else if (os_strcmp(buf, "allow_cross_connection") =3D=3D 0) {
+			if (atoi(pos))
+				bss->p2p |=3D P2P_ALLOW_CROSS_CONNECTION;
+			else
+				bss->p2p &=3D ~P2P_ALLOW_CROSS_CONNECTION;
+#endif /* CONFIG_P2P_MANAGER */
+		} else if (os_strcmp(buf, "disassoc_low_ack") =3D=3D 0) {
+			bss->disassoc_low_ack =3D atoi(pos);
+		} else if (os_strcmp(buf, "tdls_prohibit") =3D=3D 0) {
+			int val =3D atoi(pos);
+			if (val)
+				bss->tdls |=3D TDLS_PROHIBIT;
+			else
+				bss->tdls &=3D ~TDLS_PROHIBIT;
+		} else if (os_strcmp(buf, "tdls_prohibit_chan_switch") =3D=3D 0) {
+			int val =3D atoi(pos);
+			if (val)
+				bss->tdls |=3D TDLS_PROHIBIT_CHAN_SWITCH;
+			else
+				bss->tdls &=3D ~TDLS_PROHIBIT_CHAN_SWITCH;
+#ifdef CONFIG_RSN_TESTING
+		} else if (os_strcmp(buf, "rsn_testing") =3D=3D 0) {
+			extern int rsn_testing;
+			rsn_testing =3D atoi(pos);
+#endif /* CONFIG_RSN_TESTING */
+		} else {
+			wpa_printf(MSG_ERROR, "Line %d: unknown configuration "
+				   "item '%s'", line, buf);
+			errors++;
+		}
+	}
+
+	fclose(f);
+
+	for (i =3D 0; i < conf->num_bss; i++) {
+		bss =3D &conf->bss[i];
+
+		if (bss->individual_wep_key_len =3D=3D 0) {
+			/* individual keys are not use; can use key idx0 for
+			 * broadcast keys */
+			bss->broadcast_key_idx_min =3D 0;
+		}
+
+		/* Select group cipher based on the enabled pairwise cipher
+		 * suites */
+		pairwise =3D 0;
+		if (bss->wpa & 1)
+			pairwise |=3D bss->wpa_pairwise;
+		if (bss->wpa & 2) {
+			if (bss->rsn_pairwise =3D=3D 0)
+				bss->rsn_pairwise =3D bss->wpa_pairwise;
+			pairwise |=3D bss->rsn_pairwise;
+		}
+		if (pairwise & WPA_CIPHER_TKIP)
+			bss->wpa_group =3D WPA_CIPHER_TKIP;
+		else
+			bss->wpa_group =3D WPA_CIPHER_CCMP;
+
+		bss->radius->auth_server =3D bss->radius->auth_servers;
+		bss->radius->acct_server =3D bss->radius->acct_servers;
+
+		if (bss->wpa && bss->ieee802_1x) {
+			bss->ssid.security_policy =3D SECURITY_WPA;
+		} else if (bss->wpa) {
+			bss->ssid.security_policy =3D SECURITY_WPA_PSK;
+		} else if (bss->ieee802_1x) {
+			bss->ssid.security_policy =3D SECURITY_IEEE_802_1X;
+			bss->ssid.wep.default_len =3D bss->default_wep_key_len;
+		} else if (bss->ssid.wep.keys_set)
+			bss->ssid.security_policy =3D SECURITY_STATIC_WEP;
+		else
+			bss->ssid.security_policy =3D SECURITY_PLAINTEXT;
+	}
+
+	if (hostapd_config_check(conf))
+		errors++;
+
+#ifndef WPA_IGNORE_CONFIG_ERRORS
+	if (errors) {
+		wpa_printf(MSG_ERROR, "%d errors found in configuration file "
+			   "'%s'", errors, fname);
+		hostapd_config_free(conf);
+		conf =3D NULL;
+	}
+#endif /* WPA_IGNORE_CONFIG_ERRORS */
+
+	return conf;
+}
