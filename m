+static struct wpabuf * eap_peap_build_phase2_term(struct eap_sm *sm,
+						  struct eap_peap_data *data,
+						  u8 id, int success)
+{
+	struct wpabuf *encr_req, msgbuf;
+	size_t req_len;
+	struct eap_hdr *hdr;
+
+	req_len =3D sizeof(*hdr);
+	hdr =3D os_zalloc(req_len);
+	if (hdr =3D=3D NULL)
+		return NULL;
+
+	hdr->code =3D success ? EAP_CODE_SUCCESS : EAP_CODE_FAILURE;
+	hdr->identifier =3D id;
+	hdr->length =3D host_to_be16(req_len);
+
+	wpa_hexdump_key(MSG_DEBUG, "EAP-PEAP: Encrypting Phase 2 data",
+			(u8 *) hdr, req_len);
+
+	wpabuf_set(&msgbuf, hdr, req_len);
+	encr_req =3D eap_server_tls_encrypt(sm, &data->ssl, &msgbuf);
+	os_free(hdr);
+
+	return encr_req;
+}
