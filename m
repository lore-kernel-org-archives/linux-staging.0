+static int tncc_load_imc(struct tnc_if_imc *imc)
+{
+	if (imc->path =3D=3D NULL) {
+		wpa_printf(MSG_DEBUG, "TNC: No IMC configured");
+		return -1;
+	}
+
+	wpa_printf(MSG_DEBUG, "TNC: Opening IMC: %s (%s)",
+		   imc->name, imc->path);
+#ifdef CONFIG_NATIVE_WINDOWS
+#ifdef UNICODE
+	{
+		TCHAR *lib =3D wpa_strdup_tchar(imc->path);
+		if (lib =3D=3D NULL)
+			return -1;
+		imc->dlhandle =3D LoadLibrary(lib);
+		os_free(lib);
