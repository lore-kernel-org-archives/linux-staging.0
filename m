+#ifdef CONFIG_IEEE80211R
+int wpa_insert_pmkid(u8 *ies, size_t ies_len, const u8 *pmkid)
+{
+	u8 *start, *end, *rpos, *rend;
+	int added =3D 0;
+
+	start =3D ies;
+	end =3D ies + ies_len;
+
+	while (start < end) {
+		if (*start =3D=3D WLAN_EID_RSN)
+			break;
+		start +=3D 2 + start[1];
+	}
+	if (start >=3D end) {
+		wpa_printf(MSG_ERROR, "FT: Could not find RSN IE in "
+			   "IEs data");
+		return -1;
+	}
+	wpa_hexdump(MSG_DEBUG, "FT: RSN IE before modification",
+		    start, 2 + start[1]);
+
+	/* Find start of PMKID-Count */
+	rpos =3D start + 2;
+	rend =3D rpos + start[1];
+
+	/* Skip Version and Group Data Cipher Suite */
+	rpos +=3D 2 + 4;
+	/* Skip Pairwise Cipher Suite Count and List */
+	rpos +=3D 2 + WPA_GET_LE16(rpos) * RSN_SELECTOR_LEN;
+	/* Skip AKM Suite Count and List */
+	rpos +=3D 2 + WPA_GET_LE16(rpos) * RSN_SELECTOR_LEN;
+
+	if (rpos =3D=3D rend) {
+		/* Add RSN Capabilities */
+		os_memmove(rpos + 2, rpos, end - rpos);
+		*rpos++ =3D 0;
+		*rpos++ =3D 0;
+	} else {
+		/* Skip RSN Capabilities */
+		rpos +=3D 2;
+		if (rpos > rend) {
+			wpa_printf(MSG_ERROR, "FT: Could not parse RSN IE in "
+				   "IEs data");
+			return -1;
+		}
+	}
+
+	if (rpos =3D=3D rend) {
+		/* No PMKID-Count field included; add it */
+		os_memmove(rpos + 2 + PMKID_LEN, rpos, end - rpos);
+		WPA_PUT_LE16(rpos, 1);
+		rpos +=3D 2;
+		os_memcpy(rpos, pmkid, PMKID_LEN);
+		added +=3D 2 + PMKID_LEN;
+		start[1] +=3D 2 + PMKID_LEN;
+	} else {
+		/* PMKID-Count was included; use it */
+		if (WPA_GET_LE16(rpos) !=3D 0) {
+			wpa_printf(MSG_ERROR, "FT: Unexpected PMKID "
+				   "in RSN IE in EAPOL-Key data");
+			return -1;
+		}
+		WPA_PUT_LE16(rpos, 1);
+		rpos +=3D 2;
+		os_memmove(rpos + PMKID_LEN, rpos, end - rpos);
+		os_memcpy(rpos, pmkid, PMKID_LEN);
+		added +=3D PMKID_LEN;
+		start[1] +=3D PMKID_LEN;
+	}
+
+	wpa_hexdump(MSG_DEBUG, "FT: RSN IE after modification "
+		    "(PMKID inserted)", start, 2 + start[1]);
+
+	return added;
+}
