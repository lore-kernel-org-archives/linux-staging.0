+/*
+
+This sub-routine will perform all the following:
+
+1. remove 802.3 header.
+2. create wlan_header, based on the info in pxmitframe
+3. append sta's iv/ext-iv
+4. append LLC
+5. move frag chunk from pframe to pxmitframe->mem
+6. apply sw-encrypt, if necessary.
+
+*/
+s32 rtw_xmitframe_coalesce(_adapter *padapter, _pkt *pkt, struct xmit_fram=
e *pxmitframe)
+{
+	struct pkt_file pktfile;
+
+	s32 frg_inx, frg_len, mpdu_len, llc_sz, mem_sz;
+
+	SIZE_PTR addr;
+
+	u8 *pframe, *mem_start;
+	u8 hw_hdr_offset;
+
+	/* struct sta_info		*psta; */
+	/* struct sta_priv		*pstapriv =3D &padapter->stapriv; */
+	/* struct mlme_priv	*pmlmepriv =3D &padapter->mlmepriv; */
+	struct xmit_priv	*pxmitpriv =3D &padapter->xmitpriv;
+
+	struct pkt_attrib	*pattrib =3D &pxmitframe->attrib;
+
+	u8 *pbuf_start;
+
+	s32 bmcst =3D IS_MCAST(pattrib->ra);
+	s32 res =3D _SUCCESS;
+
+	/*
+		if (pattrib->psta)
+		{
+			psta =3D pattrib->psta;
+		} else
+		{
+			RTW_INFO("%s, call rtw_get_stainfo()\n", __func__);
+			psta =3D rtw_get_stainfo(&padapter->stapriv, pattrib->ra);
+		}
+
+		if(psta=3D=3DNULL)
+		{
+
+			RTW_INFO("%s, psta=3D=3DNUL\n", __func__);
+			return _FAIL;
+		}
+
+		if(!(psta->state &_FW_LINKED))
+		{
+			RTW_INFO("%s, psta->state(0x%x) !=3D _FW_LINKED\n", __func__, psta->sta=
te);
+			return _FAIL;
+		}
+	*/
+	if (pxmitframe->buf_addr =3D=3D NULL) {
+		RTW_INFO("=3D=3D> %s buf_addr=3D=3DNULL\n", __func__);
+		return _FAIL;
+	}
+
+	pbuf_start =3D pxmitframe->buf_addr;
+
+#ifdef CONFIG_USB_TX_AGGREGATION
+	hw_hdr_offset =3D  TXDESC_SIZE + (pxmitframe->pkt_offset * PACKET_OFFSET_=
SZ);
+#else
+#ifdef CONFIG_TX_EARLY_MODE /* for SDIO && Tx Agg */
+	hw_hdr_offset =3D TXDESC_OFFSET + EARLY_MODE_INFO_SIZE;
+#else
+	hw_hdr_offset =3D TXDESC_OFFSET;
+#endif
+#endif
+
+	mem_start =3D pbuf_start +	hw_hdr_offset;
+
+	if (rtw_make_wlanhdr(padapter, mem_start, pattrib) =3D=3D _FAIL) {
+		RTW_INFO("rtw_xmitframe_coalesce: rtw_make_wlanhdr fail; drop pkt\n");
+		res =3D _FAIL;
+		goto exit;
+	}
+
+	_rtw_open_pktfile(pkt, &pktfile);
+	_rtw_pktfile_read(&pktfile, NULL, pattrib->pkt_hdrlen);
+
+	frg_inx =3D 0;
+	frg_len =3D pxmitpriv->frag_len - 4;/* 2346-4 =3D 2342 */
+
+	while (1) {
+		llc_sz =3D 0;
+
+		mpdu_len =3D frg_len;
+
+		pframe =3D mem_start;
+
+		SetMFrag(mem_start);
+
+		pframe +=3D pattrib->hdrlen;
+		mpdu_len -=3D pattrib->hdrlen;
+
+		/* adding icv, if necessary... */
+		if (pattrib->iv_len) {
+			memcpy(pframe, pattrib->iv, pattrib->iv_len);
+
+			pframe +=3D pattrib->iv_len;
+
+			mpdu_len -=3D pattrib->iv_len;
+		}
+
+		if (frg_inx =3D=3D 0) {
+			llc_sz =3D rtw_put_snap(pframe, pattrib->ether_type);
+			pframe +=3D llc_sz;
+			mpdu_len -=3D llc_sz;
+		}
+
+		if ((pattrib->icv_len > 0) && (pattrib->bswenc))
+			mpdu_len -=3D pattrib->icv_len;
+
+		if (bmcst) {
+			/* don't do fragment to broadcat/multicast packets */
+			mem_sz =3D _rtw_pktfile_read(&pktfile, pframe, pattrib->pktlen);
+		} else
+			mem_sz =3D _rtw_pktfile_read(&pktfile, pframe, mpdu_len);
+
+		pframe +=3D mem_sz;
+
+		if ((pattrib->icv_len > 0) && (pattrib->bswenc)) {
+			memcpy(pframe, pattrib->icv, pattrib->icv_len);
+			pframe +=3D pattrib->icv_len;
+		}
+
+		frg_inx++;
+
+		if (bmcst || (rtw_endofpktfile(&pktfile))) {
+			pattrib->nr_frags =3D frg_inx;
+
+			pattrib->last_txcmdsz =3D pattrib->hdrlen + pattrib->iv_len + ((pattrib=
->nr_frags =3D=3D 1) ? llc_sz : 0) +
+				((pattrib->bswenc) ? pattrib->icv_len : 0) + mem_sz;
+
+			ClearMFrag(mem_start);
+
+			break;
+		}
+
+		addr =3D (SIZE_PTR)(pframe);
+
+		mem_start =3D (unsigned char *)RND4(addr) + hw_hdr_offset;
+		memcpy(mem_start, pbuf_start + hw_hdr_offset, pattrib->hdrlen);
+
+	}
+
+	if (xmitframe_addmic(padapter, pxmitframe) =3D=3D _FAIL) {
+		RTW_INFO("xmitframe_addmic(padapter, pxmitframe)=3D=3D_FAIL\n");
+		res =3D _FAIL;
+		goto exit;
+	}
+
+	xmitframe_swencrypt(padapter, pxmitframe);
+
+	if (bmcst =3D=3D false)
+		update_attrib_vcs_info(padapter, pxmitframe);
+	else
+		pattrib->vcs_mode =3D NONE_VCS;
+
+exit:
+
+	return res;
+}
