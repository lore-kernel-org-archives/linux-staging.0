+void
+odm_fast_ant_training(
+	void		*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	struct _FAST_ANTENNA_TRAINNING_	*p_dm_fat_table =3D &p_dm_odm->dm_fat_tab=
le;
+
+	u32	max_rssi_path_a =3D 0, pckcnt_path_a =3D 0;
+	u8	i, target_ant_path_a =3D 0;
+	bool	is_pkt_filter_macth_path_a =3D false;
+#if (RTL8192E_SUPPORT =3D=3D 1)
+	u32	max_rssi_path_b =3D 0, pckcnt_path_b =3D 0;
+	u8	target_ant_path_b =3D 0;
+	bool	is_pkt_filter_macth_path_b =3D false;
+#endif
+
+
+	if (!p_dm_odm->is_linked) { /* is_linked=3D=3DFalse */
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[No Link!!!]\n"=
));
+
+		if (p_dm_fat_table->is_become_linked =3D=3D true) {
+			odm_ant_div_on_off(p_dm_odm, ANTDIV_OFF);
+			phydm_fast_training_enable(p_dm_odm, FAT_OFF);
+			odm_tx_by_tx_desc_or_reg(p_dm_odm, TX_BY_REG);
+			p_dm_fat_table->is_become_linked =3D p_dm_odm->is_linked;
+		}
+		return;
+	} else {
+		if (p_dm_fat_table->is_become_linked =3D=3D false) {
+			ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[Linked!!!]\n"=
));
+			p_dm_fat_table->is_become_linked =3D p_dm_odm->is_linked;
+		}
+	}
+
+	if (*(p_dm_fat_table->p_force_tx_ant_by_desc) =3D=3D false) {
+		if (p_dm_odm->is_one_entry_only =3D=3D true)
+			odm_tx_by_tx_desc_or_reg(p_dm_odm, TX_BY_REG);
+		else
+			odm_tx_by_tx_desc_or_reg(p_dm_odm, TX_BY_DESC);
+	}
+
+
+	if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8188E)
+		odm_set_bb_reg(p_dm_odm, 0x864, BIT(2) | BIT(1) | BIT(0), ((p_dm_odm->fa=
t_comb_a) - 1));
+#if (RTL8192E_SUPPORT =3D=3D 1)
+	else if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8192E) {
+		odm_set_bb_reg(p_dm_odm, 0xB38, BIT(2) | BIT1 | BIT0, ((p_dm_odm->fat_co=
mb_a) - 1));	   /* path-A  */ /* ant combination=3DregB38[2:0]+1 */
+		odm_set_bb_reg(p_dm_odm, 0xB38, BIT(18) | BIT17 | BIT16, ((p_dm_odm->fat=
_comb_b) - 1));  /* path-B  */ /* ant combination=3DregB38[18:16]+1 */
+	}
+#endif
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("=3D=3D>odm_fast_=
ant_training()\n"));
+
+	/* 1 TRAINING STATE */
+	if (p_dm_fat_table->fat_state =3D=3D FAT_TRAINING_STATE) {
+		/* 2 Caculate RSSI per Antenna */
+
+		/* 3 [path-A]--------------------------- */
+		for (i =3D 0; i < (p_dm_odm->fat_comb_a); i++) { /* i : antenna index */
+			if (p_dm_fat_table->ant_rssi_cnt[i] =3D=3D 0)
+				p_dm_fat_table->ant_ave_rssi[i] =3D 0;
+			else {
+				p_dm_fat_table->ant_ave_rssi[i] =3D p_dm_fat_table->ant_sum_rssi[i] / =
p_dm_fat_table->ant_rssi_cnt[i];
+				is_pkt_filter_macth_path_a =3D true;
+			}
+
+			if (p_dm_fat_table->ant_ave_rssi[i] > max_rssi_path_a) {
+				max_rssi_path_a =3D p_dm_fat_table->ant_ave_rssi[i];
+				pckcnt_path_a =3D p_dm_fat_table->ant_rssi_cnt[i];
+				target_ant_path_a =3D  i ;
+			} else if (p_dm_fat_table->ant_ave_rssi[i] =3D=3D max_rssi_path_a) {
+				if ((p_dm_fat_table->ant_rssi_cnt[i])   >   pckcnt_path_a) {
+					max_rssi_path_a =3D p_dm_fat_table->ant_ave_rssi[i];
+					pckcnt_path_a =3D p_dm_fat_table->ant_rssi_cnt[i];
+					target_ant_path_a =3D i ;
+				}
+			}
+
+			ODM_RT_TRACE("*** ant-index : [ %d ],      counter =3D (( %d )),     Av=
g RSSI =3D (( %d ))\n", i, p_dm_fat_table->ant_rssi_cnt[i],  p_dm_fat_table=
->ant_ave_rssi[i]);
+		}
+
+		/* 1 DECISION STATE */
+
+		/* 2 Select TRX Antenna */
+
+		phydm_fast_training_enable(p_dm_odm, FAT_OFF);
+
+		/* 3 [path-A]--------------------------- */
+		if (is_pkt_filter_macth_path_a  =3D=3D false) {
+			/* ODM_RT_TRACE(p_dm_odm,ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("{path-A}: No=
ne Packet is matched\n")); */
+			ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("{path-A}: None=
 Packet is matched\n"));
+			odm_ant_div_on_off(p_dm_odm, ANTDIV_OFF);
+		} else {
+			ODM_RT_TRACE("target_ant_path_a =3D (( %d )) , max_rssi_path_a =3D (( %=
d ))\n", target_ant_path_a, max_rssi_path_a);
+
+			/* 3 [ update RX-optional ant ]        Default RX is Omni, Optional RX =
is the best decision by FAT */
+			if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8188E)
+				odm_set_bb_reg(p_dm_odm, 0x864, BIT(8) | BIT(7) | BIT(6), target_ant_p=
ath_a);
+			else if (p_dm_odm->support_ic_type =3D=3D ODM_RTL8192E) {
+				odm_set_bb_reg(p_dm_odm, 0xB38, BIT(8) | BIT7 | BIT6, target_ant_path_=
a); /* Optional RX [pth-A] */
+			}
+			/* 3 [ update TX ant ] */
+			odm_update_tx_ant(p_dm_odm, target_ant_path_a, (p_dm_fat_table->train_i=
dx));
+
+			if (target_ant_path_a =3D=3D 0)
+				odm_ant_div_on_off(p_dm_odm, ANTDIV_OFF);
+		}
+
+		/* 2 Reset counter */
+		for (i =3D 0; i < (p_dm_odm->fat_comb_a); i++) {
+			p_dm_fat_table->ant_sum_rssi[i] =3D 0;
+			p_dm_fat_table->ant_rssi_cnt[i] =3D 0;
+		}
+
+		p_dm_fat_table->fat_state =3D FAT_PREPARE_STATE;
+		return;
+	}
+
+	/* 1 NORMAL STATE */
+	if (p_dm_fat_table->fat_state =3D=3D FAT_PREPARE_STATE) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[ Start Prepare=
 state ]\n"));
+
+		odm_set_next_mac_addr_target(p_dm_odm);
+
+		/* 2 Prepare Training */
+		p_dm_fat_table->fat_state =3D FAT_TRAINING_STATE;
+		phydm_fast_training_enable(p_dm_odm, FAT_ON);
+		odm_ant_div_on_off(p_dm_odm, ANTDIV_ON);		/* enable HW AntDiv */
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[Start Training=
 state]\n"));
+
+		odm_set_timer(p_dm_odm, &p_dm_odm->fast_ant_training_timer, p_dm_odm->an=
tdiv_intvl); /* ms */
+	}
+
+}
