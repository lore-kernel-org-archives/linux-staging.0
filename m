+		else if (path =3D=3D RF_PATH_D)
+			target_tx_pwr =3D rtw_target_tx_pwr_5g_d;
+
+		for (rs =3D OFDM; rs < RATE_SECTION_NUM; rs++)
+			regsty->target_tx_pwr_5g[path][rs - 1] =3D target_tx_pwr[rs - 1];
