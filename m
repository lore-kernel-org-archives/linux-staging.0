al(erq->length=3D=3D0). */
+			padapter->securitypriv.dot11PrivacyKeyIndex =3D key;
+
+			RTW_INFO("(keyindex_provided =3D=3D 1), keyid=3D%d, key_len=3D%d\n", ke=
y, padapter->securitypriv.dot11DefKeylen[key]);
