+
+u32
+odm_get_psd_data(
+	void			*p_dm_void,
+	u16			point,
+	u8		initial_gain)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u32			psd_report;
+
+	odm_set_bb_reg(p_dm_odm, 0x808, 0x3FF, point);
+	odm_set_bb_reg(p_dm_odm, 0x808, BIT(22), 1);  /* Start PSD calculation, R=
eg808[22]=3D0->1 */
+	odm_stall_execution(150);/* Wait for HW PSD report */
+	odm_set_bb_reg(p_dm_odm, 0x808, BIT(22), 0);/* Stop PSD calculation,  Reg=
808[22]=3D1->0 */
+	psd_report =3D odm_get_bb_reg(p_dm_odm, 0x8B4, MASKDWORD) & 0x0000FFFF; /=
* Read PSD report, Reg8B4[15:0] */
+
+	psd_report =3D (u32)(odm_convert_to_db(psd_report)); /* +(u32)(initial_ga=
in); */
+	return psd_report;
+}
+
+
+
+void
+odm_single_dual_antenna_detection_psd(
+	void	*p_dm_void
+)
+{
+	struct PHY_DM_STRUCT		*p_dm_odm =3D (struct PHY_DM_STRUCT *)p_dm_void;
+	u32	channel_ori;
+	u8	initial_gain =3D 0x36;
+	u8	tone_idx;
+	u8	tone_lenth_1 =3D 7, tone_lenth_2 =3D 4;
+	u16	tone_idx_1[7] =3D {88, 104, 120, 8, 24, 40, 56};
+	u16	tone_idx_2[4] =3D {8, 24, 40, 56};
+	u32	psd_report_main[11] =3D {0}, psd_report_aux[11] =3D {0};
+	/* u8	tone_lenth_1=3D4, tone_lenth_2=3D2; */
+	/* u16	tone_idx_1[4]=3D{88, 120, 24, 56}; */
+	/* u16	tone_idx_2[2]=3D{ 24,  56}; */
+	/* u32	psd_report_main[6]=3D{0}, psd_report_aux[6]=3D{0}; */
+
+	u32	PSD_report_temp, max_psd_report_main =3D 0, max_psd_report_aux =3D 0;
+	u32	PSD_power_threshold;
+	u32	main_psd_result =3D 0, aux_psd_result =3D 0;
+	u32	regc50, reg948, regb2c, regc14, reg908;
+	u32	i =3D 0, test_num =3D 8;
+
+
+	if (p_dm_odm->support_ic_type !=3D ODM_RTL8723B)
+		return;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("odm_single_dual_=
antenna_detection_psd()=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D>\n"));
+
+	/* 2 [ Backup Current RF/BB Settings ] */
+
+	channel_ori =3D odm_get_rf_reg(p_dm_odm, ODM_RF_PATH_A, ODM_CHANNEL, RFRE=
GOFFSETMASK);
+	reg948 =3D odm_get_bb_reg(p_dm_odm, REG_S0_S1_PATH_SWITCH, MASKDWORD);
+	regb2c =3D  odm_get_bb_reg(p_dm_odm, REG_AGC_TABLE_SELECT, MASKDWORD);
+	regc50 =3D odm_get_bb_reg(p_dm_odm, REG_OFDM_0_XA_AGC_CORE1, MASKDWORD);
+	regc14 =3D odm_get_bb_reg(p_dm_odm, 0xc14, MASKDWORD);
+	reg908 =3D odm_get_bb_reg(p_dm_odm, 0x908, MASKDWORD);
+
+	/* 2 [ setting for doing PSD function (CH4)] */
+	odm_set_bb_reg(p_dm_odm, REG_FPGA0_RFMOD, BIT(24), 0); /* disable whole C=
CK block */
+	odm_write_1byte(p_dm_odm, REG_TXPAUSE, 0xFF); /* Turn off TX  ->  Pause T=
X Queue */
+	odm_set_bb_reg(p_dm_odm, 0xC14, MASKDWORD, 0x0); /* [ Set IQK Matrix =3D =
0 ] equivalent to [ Turn off CCA] */
+
+	/* PHYTXON while loop */
+	odm_set_bb_reg(p_dm_odm, 0x908, MASKDWORD, 0x803);
+	while (odm_get_bb_reg(p_dm_odm, 0xdf4, BIT(6))) {
+		i++;
+		if (i > 1000000) {
+			ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("Wait in %s() m=
ore than %d times!\n", __func__, i));
+			break;
+		}
+	}
+
+	odm_set_bb_reg(p_dm_odm, 0xc50, 0x7f, initial_gain);
+	odm_set_rf_reg(p_dm_odm, ODM_RF_PATH_A, ODM_CHANNEL, 0x7ff, 0x04);     /*=
 Set RF to CH4 & 40M */
+	odm_set_bb_reg(p_dm_odm, REG_FPGA0_ANALOG_PARAMETER4, 0xf00000, 0xf);	/* =
3 wire Disable    88c[23:20]=3D0xf */
+	odm_set_bb_reg(p_dm_odm, REG_FPGA0_PSD_FUNCTION, BIT(14) | BIT15, 0x0);  =
/* 128 pt	 */ /* Set PSD 128 ptss */
+	odm_stall_execution(3000);
+
+
+	/* 2 [ Doing PSD Function in (CH4)] */
+
+	/* Antenna A */
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("Switch to Main-a=
nt   (CH4)\n"));
+	odm_set_bb_reg(p_dm_odm, 0x948, 0xfff, 0x200);
+	odm_stall_execution(10);
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("dbg\n"));
+	for (i =3D 0; i < test_num; i++) {
+		for (tone_idx =3D 0; tone_idx < tone_lenth_1; tone_idx++) {
+			PSD_report_temp =3D odm_get_psd_data(p_dm_odm, tone_idx_1[tone_idx], in=
itial_gain);
+			/* if(  PSD_report_temp>psd_report_main[tone_idx]  ) */
+			psd_report_main[tone_idx] +=3D PSD_report_temp;
+		}
+	}
+	/* Antenna B */
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("Switch to Aux-an=
t   (CH4)\n"));
+	odm_set_bb_reg(p_dm_odm, 0x948, 0xfff, 0x280);
+	odm_stall_execution(10);
+	for (i =3D 0; i < test_num; i++) {
+		for (tone_idx =3D 0; tone_idx < tone_lenth_1; tone_idx++) {
+			PSD_report_temp =3D odm_get_psd_data(p_dm_odm, tone_idx_1[tone_idx], in=
itial_gain);
+			/* if(  PSD_report_temp>psd_report_aux[tone_idx]  ) */
+			psd_report_aux[tone_idx] +=3D PSD_report_temp;
+		}
+	}
+	/* 2 [ Doing PSD Function in (CH8)] */
+
+	odm_set_bb_reg(p_dm_odm, REG_FPGA0_ANALOG_PARAMETER4, 0xf00000, 0x0);	/* =
3 wire enable    88c[23:20]=3D0x0 */
+	odm_stall_execution(3000);
+
+	odm_set_bb_reg(p_dm_odm, 0xc50, 0x7f, initial_gain);
+	odm_set_rf_reg(p_dm_odm, ODM_RF_PATH_A, ODM_CHANNEL, 0x7ff, 0x04);     /*=
 Set RF to CH8 & 40M */
+
+	odm_set_bb_reg(p_dm_odm, REG_FPGA0_ANALOG_PARAMETER4, 0xf00000, 0xf);	/* =
3 wire Disable    88c[23:20]=3D0xf */
+	odm_stall_execution(3000);
+
+	/* Antenna A */
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("Switch to Main-a=
nt   (CH8)\n"));
+	odm_set_bb_reg(p_dm_odm, 0x948, 0xfff, 0x200);
+	odm_stall_execution(10);
+
+	for (i =3D 0; i < test_num; i++) {
+		for (tone_idx =3D 0; tone_idx < tone_lenth_2; tone_idx++) {
+			PSD_report_temp =3D odm_get_psd_data(p_dm_odm, tone_idx_2[tone_idx], in=
itial_gain);
+			/* if(  PSD_report_temp>psd_report_main[tone_idx]  ) */
+			psd_report_main[tone_lenth_1 + tone_idx] +=3D PSD_report_temp;
+		}
+	}
+
+	/* Antenna B */
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("Switch to Aux-an=
t   (CH8)\n"));
+	odm_set_bb_reg(p_dm_odm, 0x948, 0xfff, 0x280);
+	odm_stall_execution(10);
+
+	for (i =3D 0; i < test_num; i++) {
+		for (tone_idx =3D 0; tone_idx < tone_lenth_2; tone_idx++) {
+			PSD_report_temp =3D odm_get_psd_data(p_dm_odm, tone_idx_2[tone_idx], in=
itial_gain);
+			/* if(  PSD_report_temp>psd_report_aux[tone_idx]  ) */
+			psd_report_aux[tone_lenth_1 + tone_idx] +=3D PSD_report_temp;
+		}
+	}
+
+	/* 2 [ Calculate Result ] */
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("\nMain PSD Resul=
t: (ALL)\n"));
+	for (tone_idx =3D 0; tone_idx < (tone_lenth_1 + tone_lenth_2); tone_idx++=
) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[Tone-%d]: %d,\=
n", (tone_idx + 1), psd_report_main[tone_idx]));
+		main_psd_result +=3D psd_report_main[tone_idx];
+		if (psd_report_main[tone_idx] > max_psd_report_main)
+			max_psd_report_main =3D psd_report_main[tone_idx];
+	}
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("----------------=
----------- \nTotal_Main=3D (( %d ))\n", main_psd_result));
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("MAX_Main =3D (( =
%d ))\n", max_psd_report_main));
+
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("\nAux PSD Result=
: (ALL)\n"));
+	for (tone_idx =3D 0; tone_idx < (tone_lenth_1 + tone_lenth_2); tone_idx++=
) {
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[Tone-%d]: %d,\=
n", (tone_idx + 1), psd_report_aux[tone_idx]));
+		aux_psd_result +=3D psd_report_aux[tone_idx];
+		if (psd_report_aux[tone_idx] > max_psd_report_aux)
+			max_psd_report_aux =3D psd_report_aux[tone_idx];
+	}
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("----------------=
----------- \nTotal_Aux=3D (( %d ))\n", aux_psd_result));
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("MAX_Aux =3D (( %=
d ))\n\n", max_psd_report_aux));
+
+	/* main_psd_result=3Dmain_psd_result-max_psd_report_main; */
+	/* aux_psd_result=3Daux_psd_result-max_psd_report_aux; */
+	PSD_power_threshold =3D (main_psd_result * 7) >> 3;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("[ Main_result, A=
ux_result ] =3D [ %d , %d ], PSD_power_threshold=3D(( %d ))\n", main_psd_re=
sult, aux_psd_result, PSD_power_threshold));
+
+	/* 3 [ Dual Antenna ] */
+	if (aux_psd_result >=3D PSD_power_threshold) {
+		if (p_dm_odm->dm_swat_table.ANTB_ON =3D=3D false) {
+			p_dm_odm->dm_swat_table.ANTA_ON =3D true;
+			p_dm_odm->dm_swat_table.ANTB_ON =3D true;
+		}
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("odm_sw_ant_div_=
check_before_link(): Dual antenna\n"));
+
+		/* set bt coexDM from 1ant coexDM to 2ant coexDM */
+		/* bt_set_bt_coex_ant_num(p_adapter, BT_COEX_ANT_TYPE_DETECTED, 2); */
+
+		/* Init antenna diversity */
+		p_dm_odm->support_ability |=3D ODM_BB_ANT_DIV;
+		odm_ant_div_init(p_dm_odm);
+	}
+	/* 3 [ Single Antenna ] */
+	else {
+		if (p_dm_odm->dm_swat_table.ANTB_ON =3D=3D true) {
+			p_dm_odm->dm_swat_table.ANTA_ON =3D true;
+			p_dm_odm->dm_swat_table.ANTB_ON =3D false;
+		}
+		ODM_RT_TRACE(p_dm_odm, ODM_COMP_ANT_DIV, ODM_DBG_LOUD, ("odm_sw_ant_div_=
check_before_link(): Single antenna\n"));
+	}
+
+	/* 2 [ Recover all parameters ] */
+
+	odm_set_rf_reg(p_dm_odm, ODM_RF_PATH_A, RF_CHNLBW, RFREGOFFSETMASK, chann=
el_ori);
+	odm_set_bb_reg(p_dm_odm, REG_FPGA0_ANALOG_PARAMETER4, 0xf00000, 0x0);	/* =
3 wire enable    88c[23:20]=3D0x0 */
+	odm_set_bb_reg(p_dm_odm, 0xc50, 0x7f, regc50);
+
+	odm_set_bb_reg(p_dm_odm, REG_S0_S1_PATH_SWITCH, MASKDWORD, reg948);
+	odm_set_bb_reg(p_dm_odm, REG_AGC_TABLE_SELECT, MASKDWORD, regb2c);
+
+	odm_set_bb_reg(p_dm_odm, REG_FPGA0_RFMOD, BIT(24), 1); /* enable whole CC=
K block */
+	odm_write_1byte(p_dm_odm, REG_TXPAUSE, 0x0); /* Turn on TX	 */ /* Resume =
TX Queue */
+	odm_set_bb_reg(p_dm_odm, 0xC14, MASKDWORD, regc14); /* [ Set IQK Matrix =
=3D 0 ] equivalent to [ Turn on CCA] */
+	odm_set_bb_reg(p_dm_odm, 0x908, MASKDWORD, reg908);
+
+	return;
+
+}
