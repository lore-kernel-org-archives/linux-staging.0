+static void * eap_aka_init(struct eap_sm *sm)
+{
+	struct eap_aka_data *data;
+
+	if (sm->eap_sim_db_priv =3D=3D NULL) {
+		wpa_printf(MSG_WARNING, "EAP-AKA: eap_sim_db not configured");
+		return NULL;
+	}
+
+	data =3D os_zalloc(sizeof(*data));
+	if (data =3D=3D NULL)
+		return NULL;
+
+	data->eap_method =3D EAP_TYPE_AKA;
+
+	data->state =3D IDENTITY;
+	eap_aka_determine_identity(sm, data, 1, 0);
+	data->pending_id =3D -1;
+
+	return data;
+}
