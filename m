+void SetPacketTx(PADAPTER padapter)
+{
+	u8 *ptr, *pkt_start, *pkt_end, *fctrl;
+	u32 pkt_size, offset, startPlace, i;
+	struct rtw_ieee80211_hdr *hdr;
+	u8 payload;
+	s32 bmcast;
+	struct pkt_attrib *pattrib;
+	struct mp_priv *pmp_priv;
+
+	pmp_priv =3D &padapter->mppriv;
+
+	if (pmp_priv->tx.stop)
+		return;
+	pmp_priv->tx.sended =3D 0;
+	pmp_priv->tx.stop =3D 0;
+	pmp_priv->tx_pktcount =3D 0;
+
+	/* 3 1. update_attrib() */
+	pattrib =3D &pmp_priv->tx.attrib;
+	memcpy(pattrib->src, adapter_mac_addr(padapter), ETH_ALEN);
+	memcpy(pattrib->ta, pattrib->src, ETH_ALEN);
+	memcpy(pattrib->ra, pattrib->dst, ETH_ALEN);
+	bmcast =3D IS_MCAST(pattrib->ra);
+	if (bmcast) {
+		pattrib->mac_id =3D 1;
+		pattrib->psta =3D rtw_get_bcmc_stainfo(padapter);
+	} else {
+		pattrib->mac_id =3D 0;
+		pattrib->psta =3D rtw_get_stainfo(&padapter->stapriv, get_bssid(&padapte=
r->mlmepriv));
+	}
+	pattrib->mbssid =3D 0;
+
+	pattrib->last_txcmdsz =3D pattrib->hdrlen + pattrib->pktlen;
+
+	/* 3 2. allocate xmit buffer */
+	pkt_size =3D pattrib->last_txcmdsz;
+
+	if (pmp_priv->tx.pallocated_buf)
+		rtw_mfree(pmp_priv->tx.pallocated_buf, pmp_priv->tx.buf_size);
+	pmp_priv->tx.write_size =3D pkt_size;
+	pmp_priv->tx.buf_size =3D pkt_size + XMITBUF_ALIGN_SZ;
+	pmp_priv->tx.pallocated_buf =3D rtw_zmalloc(pmp_priv->tx.buf_size);
+	if (pmp_priv->tx.pallocated_buf =3D=3D NULL) {
+		RTW_INFO("%s: malloc(%d) fail!!\n", __func__, pmp_priv->tx.buf_size);
+		return;
+	}
+	pmp_priv->tx.buf =3D (u8 *)N_BYTE_ALIGMENT((SIZE_PTR)(pmp_priv->tx.palloc=
ated_buf), XMITBUF_ALIGN_SZ);
+	ptr =3D pmp_priv->tx.buf;
+
+	memset(pmp_priv->tx.desc, 0, TXDESC_SIZE);
+	pkt_start =3D ptr;
+	pkt_end =3D pkt_start + pkt_size;
+
+	/* 3 3. init TX descriptor */
+	if (IS_HARDWARE_TYPE_8188E(padapter))
+		fill_tx_desc_8188e(padapter);
+
+	/* 3 4. make wlan header, make_wlanhdr() */
+	hdr =3D (struct rtw_ieee80211_hdr *)pkt_start;
+	set_frame_sub_type(&hdr->frame_ctl, pattrib->subtype);
+
+	memcpy(hdr->addr1, pattrib->dst, ETH_ALEN); /* DA */
+	memcpy(hdr->addr2, pattrib->src, ETH_ALEN); /* SA */
+	memcpy(hdr->addr3, get_bssid(&padapter->mlmepriv), ETH_ALEN); /* RA, BSSI=
D */
+
+	/* 3 5. make payload */
+	ptr =3D pkt_start + pattrib->hdrlen;
+
+	switch (pmp_priv->tx.payload) {
+	case 0:
+		payload =3D 0x00;
+		break;
+	case 1:
+		payload =3D 0x5a;
+		break;
+	case 2:
+		payload =3D 0xa5;
+		break;
+	case 3:
+		payload =3D 0xff;
+		break;
+	default:
+		payload =3D 0x00;
+		break;
+	}
+	pmp_priv->TXradomBuffer =3D rtw_zmalloc(4096);
+	if (pmp_priv->TXradomBuffer =3D=3D NULL) {
+		RTW_INFO("mp create random buffer fail!\n");
+		goto exit;
+	}
+
+
+	for (i =3D 0; i < 4096; i++)
+		pmp_priv->TXradomBuffer[i] =3D rtw_random32() % 0xFF;
+
+	/* startPlace =3D (u32)(rtw_random32() % 3450); */
+	memcpy(ptr, pmp_priv->TXradomBuffer, pkt_end - ptr);
+	/* memset(ptr, payload, pkt_end - ptr); */
+	rtw_mfree(pmp_priv->TXradomBuffer, 4096);
+
+	/* 3 6. start thread */
+	pmp_priv->tx.PktTxThread =3D kthread_run(mp_xmit_packet_thread, pmp_priv,=
 "RTW_MP_THREAD");
+	if (IS_ERR(pmp_priv->tx.PktTxThread))
+		RTW_INFO("Create PktTx Thread Fail !!!!!\n");
+
+	Rtw_MPSetMacTxEDCA(padapter);
+exit:
+	return;
+}
