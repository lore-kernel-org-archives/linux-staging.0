+int rtw_efuse_mask_file(struct net_device *dev,
+			struct iw_request_info *info,
+			union iwreq_data *wrqu, char *extra)
+{
+	char *rtw_efuse_mask_file_path;
+	u8 Status;
+	PADAPTER padapter =3D rtw_netdev_priv(dev);
+
+	memset(maskfileBuffer, 0x00, sizeof(maskfileBuffer));
+
+	if (copy_from_user(extra, wrqu->data.pointer, wrqu->data.length))
+		return -EFAULT;
+
+	if (strncmp(extra, "off", 3) =3D=3D 0 && strlen(extra) < 4) {
+		padapter->registrypriv.boffefusemask =3D 1;
+		sprintf(extra, "Turn off Efuse Mask\n");
+		wrqu->data.length =3D strlen(extra);
+		return 0;
+	}
+	if (strncmp(extra, "on", 2) =3D=3D 0 && strlen(extra) < 3) {
+		padapter->registrypriv.boffefusemask =3D 0;
+		sprintf(extra, "Turn on Efuse Mask\n");
+		wrqu->data.length =3D strlen(extra);
+		return 0;
+	}
+	if (strncmp(extra, "data,", 5) =3D=3D 0) {
+		u8	*pch, *pdata;
+		char	*ptmp, tmp;
+		u8	count =3D 0;
+		u8	i =3D 0;
+		u32	datalen =3D 0;
+
+		ptmp =3D extra;
+		pch =3D strsep(&ptmp, ",");
+
+		if ((pch =3D=3D NULL) || (strlen(pch) =3D=3D 0)) {
+			RTW_INFO("%s: parameter error(no cmd)!\n", __func__);
+			return -EFAULT;
+		}
+
+		do {
+			pch =3D strsep(&ptmp, ":");
+			if ((pch =3D=3D NULL) || (strlen(pch) =3D=3D 0))
+				break;
+			if (strlen(pch) !=3D 2
+				|| IsHexDigit(*pch) =3D=3D false
+				|| IsHexDigit(*(pch + 1)) =3D=3D false
+				|| sscanf(pch, "%hhx", &tmp) !=3D 1
+			) {
+				RTW_INFO("%s: invalid 8-bit hex! input format: data,01:23:45:67:89:ab:=
cd:ef...\n", __func__);
+				return -EFAULT;
+			}
+			maskfileBuffer[count++] =3D tmp;
+
+		 } while (count < 64);
+
+		for (i =3D 0; i < count; i++)
+			sprintf(extra + strlen(extra), ":%02x", maskfileBuffer[i]);
+
+		padapter->registrypriv.bFileMaskEfuse =3D true;
+
+		sprintf(extra + strlen(extra), "\nLoad Efuse Mask data %d hex ok\n", cou=
nt);
+		wrqu->data.length =3D strlen(extra);
+		return 0;
+	}
+	rtw_efuse_mask_file_path =3D extra;
+
+	if (rtw_is_file_readable(rtw_efuse_mask_file_path) =3D=3D true) {
+		RTW_INFO("%s do rtw_efuse_mask_file_read =3D %s! ,sizeof maskfileBuffer =
%zu\n", __func__, rtw_efuse_mask_file_path, sizeof(maskfileBuffer));
+		Status =3D rtw_efuse_file_read(padapter, rtw_efuse_mask_file_path, maskf=
ileBuffer, sizeof(maskfileBuffer));
+		if (Status =3D=3D true)
+			padapter->registrypriv.bFileMaskEfuse =3D true;
+		sprintf(extra, "efuse mask file read OK\n");
+	} else {
+		padapter->registrypriv.bFileMaskEfuse =3D false;
+		sprintf(extra, "efuse mask file readable FAIL\n");
+		RTW_INFO("%s rtw_is_file_readable fail!\n", __func__);
+	}
+	wrqu->data.length =3D strlen(extra);
+	return 0;
+}
+
