+static int rtw_wx_set_pmkid(struct net_device *dev,
+			    struct iw_request_info *a,
+			    union iwreq_data *wrqu, char *extra)
+{
+	_adapter *padapter =3D (_adapter *)rtw_netdev_priv(dev);
+	u8          j, blInserted =3D false;
+	int         intReturn =3D false;
+	struct mlme_priv  *pmlmepriv =3D &padapter->mlmepriv;
+	struct security_priv *psecuritypriv =3D &padapter->securitypriv;
+	struct iw_pmksa  *pPMK =3D (struct iw_pmksa *) extra;
+	u8     strZeroMacAddress[ETH_ALEN] =3D { 0x00 };
+	u8     strIssueBssid[ETH_ALEN] =3D { 0x00 };
+
+	memcpy(strIssueBssid, pPMK->bssid.sa_data, ETH_ALEN);
+	if (pPMK->cmd =3D=3D IW_PMKSA_ADD) {
+		RTW_INFO("[rtw_wx_set_pmkid] IW_PMKSA_ADD!\n");
+		if (!memcmp(strIssueBssid, strZeroMacAddress, ETH_ALEN) )
+			return intReturn ;
+		else
+			intReturn =3D true;
+		blInserted =3D false;
+
+		/* overwrite PMKID */
+		for (j =3D 0 ; j < NUM_PMKID_CACHE; j++) {
+			if (!memcmp(psecuritypriv->PMKIDList[j].Bssid, strIssueBssid, ETH_ALEN)=
 ) {
+				/* BSSID is matched, the same AP =3D> rewrite with new PMKID. */
+
+				RTW_INFO("[rtw_wx_set_pmkid] BSSID exists in the PMKList.\n");
+
+				memcpy(psecuritypriv->PMKIDList[j].PMKID, pPMK->pmkid, IW_PMKID_LEN);
+				psecuritypriv->PMKIDList[j].bUsed =3D true;
+				psecuritypriv->PMKIDIndex =3D j + 1;
+				blInserted =3D true;
+				break;
+			}
+		}
+
+		if (!blInserted) {
+			/* Find a new entry */
+			RTW_INFO("[rtw_wx_set_pmkid] Use the new entry index =3D %d for this PM=
KID.\n",
+				 psecuritypriv->PMKIDIndex);
+
+			memcpy(psecuritypriv->PMKIDList[psecuritypriv->PMKIDIndex].Bssid, strIs=
sueBssid, ETH_ALEN);
+			memcpy(psecuritypriv->PMKIDList[psecuritypriv->PMKIDIndex].PMKID, pPMK-=
>pmkid, IW_PMKID_LEN);
+
+			psecuritypriv->PMKIDList[psecuritypriv->PMKIDIndex].bUsed =3D true;
+			psecuritypriv->PMKIDIndex++ ;
+			if (psecuritypriv->PMKIDIndex =3D=3D 16)
+				psecuritypriv->PMKIDIndex =3D 0;
+		}
+	} else if (pPMK->cmd =3D=3D IW_PMKSA_REMOVE) {
+		RTW_INFO("[rtw_wx_set_pmkid] IW_PMKSA_REMOVE!\n");
+		intReturn =3D true;
+		for (j =3D 0 ; j < NUM_PMKID_CACHE; j++) {
+			if (!memcmp(psecuritypriv->PMKIDList[j].Bssid, strIssueBssid, ETH_ALEN)=
 ) {
+				/* BSSID is matched, the same AP =3D> Remove this PMKID information an=
d reset it. */
+				memset(psecuritypriv->PMKIDList[j].Bssid, 0x00, ETH_ALEN);
+				psecuritypriv->PMKIDList[j].bUsed =3D false;
+				break;
+			}
+		}
+	} else if (pPMK->cmd =3D=3D IW_PMKSA_FLUSH) {
+		RTW_INFO("[rtw_wx_set_pmkid] IW_PMKSA_FLUSH!\n");
+		memset(&psecuritypriv->PMKIDList[0], 0x00, sizeof(RT_PMKID_LIST) * NUM_P=
MKID_CACHE);
+		psecuritypriv->PMKIDIndex =3D 0;
+		intReturn =3D true;
+	}
+	return intReturn ;
+}
