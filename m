+static struct wpabuf * eap_fast_tlv_result(int status, int intermediate)
+{
+	struct wpabuf *buf;
+	struct eap_tlv_intermediate_result_tlv *result;
+	buf =3D wpabuf_alloc(sizeof(*result));
+	if (buf =3D=3D NULL)
+		return NULL;
+	wpa_printf(MSG_DEBUG, "EAP-FAST: Add %sResult TLV(status=3D%d)",
+		   intermediate ? "Intermediate " : "", status);
+	result =3D wpabuf_put(buf, sizeof(*result));
+	result->tlv_type =3D host_to_be16(EAP_TLV_TYPE_MANDATORY |
+					(intermediate ?
+					 EAP_TLV_INTERMEDIATE_RESULT_TLV :
+					 EAP_TLV_RESULT_TLV));
+	result->length =3D host_to_be16(2);
+	result->status =3D host_to_be16(status);
+	return buf;
+}
