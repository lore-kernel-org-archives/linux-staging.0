+	os_free(conf->radius);
+	hostapd_config_free_vlan(conf);
+	if (conf->ssid.dyn_vlan_keys) {
+		struct hostapd_ssid *ssid =3D &conf->ssid;
+		size_t i;
+		for (i =3D 0; i <=3D ssid->max_dyn_vlan_keys; i++) {
+			if (ssid->dyn_vlan_keys[i] =3D=3D NULL)
