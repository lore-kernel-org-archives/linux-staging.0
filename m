+static void p2p_device_free(struct p2p_data *p2p, struct p2p_device *dev)
+{
+	int i;
+
+	if (p2p->go_neg_peer =3D=3D dev)
+		p2p->go_neg_peer =3D NULL;
+	if (p2p->invite_peer =3D=3D dev)
+		p2p->invite_peer =3D NULL;
+	if (p2p->sd_peer =3D=3D dev)
+		p2p->sd_peer =3D NULL;
+	if (p2p->pending_client_disc_go =3D=3D dev)
+		p2p->pending_client_disc_go =3D NULL;
+
+	p2p->cfg->dev_lost(p2p->cfg->cb_ctx, dev->info.p2p_device_addr);
+
+	for (i =3D 0; i < P2P_MAX_WPS_VENDOR_EXT; i++) {
+		wpabuf_free(dev->info.wps_vendor_ext[i]);
+		dev->info.wps_vendor_ext[i] =3D NULL;
+	}
+
+	os_free(dev);
+}
