+static int
+rtbuf_len(void)
+{
+	size_t len;
+
+	int mib[6] =3D {CTL_NET, AF_ROUTE, 0, AF_INET, NET_RT_DUMP, 0};
+
+	if (sysctl(mib, 6, NULL, &len, NULL, 0) < 0) {
+		wpa_printf(MSG_WARNING, "%s failed: %s\n", __func__,
+			   strerror(errno));
+		len =3D 2048;
+	}
+
+	return len;
+}
