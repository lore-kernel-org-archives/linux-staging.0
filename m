+static int mac_in_conf(struct hostapd_config *conf, const void *a)
+{
+	size_t i;
+
+	for (i =3D 0; i < conf->num_bss; i++) {
+		if (hostapd_mac_comp(conf->bss[i].bssid, a) =3D=3D 0) {
+			return 1;
+		}
+	}
+
+	return 0;
+}
