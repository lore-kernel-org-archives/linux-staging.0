+void	rtw_beamforming_get_ndpa_frame(PADAPTER	 Adapter, union recv_frame *p=
recv_frame)
+{
+#if (BEAMFORMING_SUPPORT =3D=3D 1)
+	PHAL_DATA_TYPE	pHalData =3D GET_HAL_DATA(Adapter);
+	struct PHY_DM_STRUCT		*pDM_Odm =3D &(pHalData->odmpriv);
+
+	beamforming_get_ndpa_frame(pDM_Odm, precv_frame);
+
+#else /*(BEAMFORMING_SUPPORT =3D=3D 0)- for drv beamfoming*/
+	u8	*ta;
+	u8	idx, Sequence;
+	u8	*pframe =3D precv_frame->u.hdr.rx_data;
+	struct mlme_priv			*pmlmepriv =3D &(Adapter->mlmepriv);
+	struct beamforming_entry	*pBeamformEntry =3D NULL;
+
+	/*RTW_INFO("rtw_beamforming_get_ndpa_frame\n");*/
+
+	if (IS_HARDWARE_TYPE_8812(Adapter) =3D=3D false)
+		return;
+	else if (get_frame_sub_type(pframe) !=3D WIFI_NDPA)
+		return;
+
+	ta =3D get_addr2_ptr(pframe);
+	/*Remove signaling TA. */
+	ta[0] =3D ta[0] & 0xFE;
+
+	pBeamformEntry =3D beamforming_get_entry_by_addr(pmlmepriv, ta, &idx);
+
+	if (pBeamformEntry =3D=3D NULL)
+		return;
+	else if (!(pBeamformEntry->beamforming_entry_cap & BEAMFORMEE_CAP_VHT_SU))
+		return;
+	/*LogSuccess: As long as 8812A receive NDPA and feedback CSI succeed once=
, clock reset is NO LONGER needed !2015-04-10, Jeffery*/
+	/*ClockResetTimes: While BFer entry always doesn't receive our CSI, clock=
 will reset again and again.So ClockResetTimes is limited to 5 times.2015-0=
4-13, Jeffery*/
+	else if ((pBeamformEntry->LogSuccess =3D=3D 1) || (pBeamformEntry->ClockR=
esetTimes =3D=3D 5)) {
+		RTW_INFO("[%s] LogSeq=3D%d, PreLogSeq=3D%d\n", __func__, pBeamformEntry-=
>LogSeq, pBeamformEntry->PreLogSeq);
+		return;
+	}
+
+	Sequence =3D (pframe[16]) >> 2;
+	RTW_INFO("[%s] Start, Sequence=3D%d, LogSeq=3D%d, PreLogSeq=3D%d, LogRetr=
yCnt=3D%d, ClockResetTimes=3D%d, LogSuccess=3D%d\n",
+		__func__, Sequence, pBeamformEntry->LogSeq, pBeamformEntry->PreLogSeq, p=
BeamformEntry->LogRetryCnt, pBeamformEntry->ClockResetTimes, pBeamformEntry=
->LogSuccess);
+
+	if ((pBeamformEntry->LogSeq !=3D 0) && (pBeamformEntry->PreLogSeq !=3D 0)=
) {
+		/*Success condition*/
+		if ((pBeamformEntry->LogSeq !=3D Sequence) && (pBeamformEntry->PreLogSeq=
 !=3D pBeamformEntry->LogSeq)) {
+			/* break option for clcok reset, 2015-03-30, Jeffery */
+			pBeamformEntry->LogRetryCnt =3D 0;
+			/*As long as 8812A receive NDPA and feedback CSI succeed once, clock re=
set is no longer needed.*/
+			/*That is, LogSuccess is NOT needed to be reset to zero, 2015-04-13, Je=
ffery*/
+			pBeamformEntry->LogSuccess =3D 1;
+
+		} else {/*Fail condition*/
+
+			if (pBeamformEntry->LogRetryCnt =3D=3D 5) {
+				pBeamformEntry->ClockResetTimes++;
+				pBeamformEntry->LogRetryCnt =3D 0;
+
+				RTW_INFO("[%s] Clock Reset!!! ClockResetTimes=3D%d\n",  __func__, pBea=
mformEntry->ClockResetTimes);
+				beamforming_wk_cmd(Adapter, BEAMFORMING_CTRL_SOUNDING_CLK, NULL, 0, 1);
+
+			} else
+				pBeamformEntry->LogRetryCnt++;
+		}
+	}
+
+	/*Update LogSeq & PreLogSeq*/
+	pBeamformEntry->PreLogSeq =3D pBeamformEntry->LogSeq;
+	pBeamformEntry->LogSeq =3D Sequence;
+
+#endif
+
+}
