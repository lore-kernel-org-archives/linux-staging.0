+	struct security_priv *psecuritypriv =3D &adapter->securitypriv;
+	struct mlme_priv *pmlmepriv =3D &adapter->mlmepriv;
+	struct pwrctrl_priv *pwrctl =3D adapter_to_pwrctl(adapter);
+	struct mlme_ext_priv	*pmlmeext;
+	struct mlme_ext_info	*pmlmeinfo;
+	u32	ARPLength =3D 0, GTKLength =3D 0, PNOLength =3D 0, ScanInfoLength =3D=
 0;
+	u32	SSIDLegnth =3D 0, ProbeReqLength =3D 0;
+	u8 CurtPktPageNum =3D 0;
+	u8 currentip[4];
+	u8 cur_dot11txpn[8];
+
+#ifdef CONFIG_GTK_OL
+	struct sta_priv *pstapriv =3D &adapter->stapriv;
+	struct sta_info *psta;
+	struct security_priv *psecpriv =3D &adapter->securitypriv;
+	u8 kek[RTW_KEK_LEN];
+	u8 kck[RTW_KCK_LEN];
+#endif /* CONFIG_GTK_OL */
+#ifdef CONFIG_PNO_SUPPORT
+	int pno_index;
+	u8 ssid_num;
+#endif /* CONFIG_PNO_SUPPORT */
+
+	pmlmeext =3D &adapter->mlmeextpriv;
+	pmlmeinfo =3D &pmlmeext->mlmext_info;
+
+	if (pwrctl->wowlan_pno_enable =3D=3D false) {
+		/* ARP RSP * 1 page */
+		rtw_get_current_ip_address(adapter, currentip);
+
+		rsvd_page_loc->LocArpRsp =3D *page_num;
+
+		RTW_INFO("LocArpRsp: %d\n", rsvd_page_loc->LocArpRsp);
+
+		rtw_hal_construct_ARPRsp(adapter, &pframe[index],
+					 &ARPLength, currentip);
+
+		rtw_hal_fill_fake_txdesc(adapter,
+					 &pframe[index - tx_desc],
+					 ARPLength, false, false, true);
+
+		CurtPktPageNum =3D (u8)PageNum(tx_desc + ARPLength, page_size);
+
+		*page_num +=3D CurtPktPageNum;
+
+		index +=3D (CurtPktPageNum * page_size);
+
+		/* 3 SEC IV * 1 page */
+		rtw_get_sec_iv(adapter, cur_dot11txpn,
+			       get_my_bssid(&pmlmeinfo->network));
+
+		rsvd_page_loc->LocRemoteCtrlInfo =3D *page_num;
+
+		RTW_INFO("LocRemoteCtrlInfo: %d\n", rsvd_page_loc->LocRemoteCtrlInfo);
+
+		memcpy(pframe + index - tx_desc, cur_dot11txpn, _AES_IV_LEN_);
+
+		CurtPktPageNum =3D (u8)PageNum(_AES_IV_LEN_, page_size);
+
+		*page_num +=3D CurtPktPageNum;
+
+		*total_pkt_len =3D index + _AES_IV_LEN_;
+#ifdef CONFIG_GTK_OL
+		index +=3D (CurtPktPageNum * page_size);
+
+		/* if the ap staion info. exists, get the kek, kck from staion info. */
+		psta =3D rtw_get_stainfo(pstapriv, get_bssid(pmlmepriv));
+		if (psta =3D=3D NULL) {
+			memset(kek, 0, RTW_KEK_LEN);
+			memset(kck, 0, RTW_KCK_LEN);
+			RTW_INFO("%s, KEK, KCK download rsvd page all zero\n",
+				 __func__);
+		} else {
+			memcpy(kek, psta->kek, RTW_KEK_LEN);
+			memcpy(kck, psta->kck, RTW_KCK_LEN);
+		}
+
+		/* 3 KEK, KCK */
+		rsvd_page_loc->LocGTKInfo =3D *page_num;
+		RTW_INFO("LocGTKInfo: %d\n", rsvd_page_loc->LocGTKInfo);
+
+		if (IS_HARDWARE_TYPE_8188E(adapter)) {
+			struct security_priv *psecpriv =3D NULL;
+
+			psecpriv =3D &adapter->securitypriv;
+			memcpy(pframe + index - tx_desc,
+				    &psecpriv->dot11PrivacyAlgrthm, 1);
+			memcpy(pframe + index - tx_desc + 1,
+				    &psecpriv->dot118021XGrpPrivacy, 1);
+			memcpy(pframe + index - tx_desc + 2,
+				    kck, RTW_KCK_LEN);
+			memcpy(pframe + index - tx_desc + 2 + RTW_KCK_LEN,
+				    kek, RTW_KEK_LEN);
+			CurtPktPageNum =3D (u8)PageNum(tx_desc + 2 + RTW_KCK_LEN + RTW_KEK_LEN,=
 page_size);
+		} else {
+
+			memcpy(pframe + index - tx_desc, kck, RTW_KCK_LEN);
+			memcpy(pframe + index - tx_desc + RTW_KCK_LEN,
+				    kek, RTW_KEK_LEN);
+			GTKLength =3D tx_desc + RTW_KCK_LEN + RTW_KEK_LEN;
+
+			if (psta !=3D NULL &&
+				psecuritypriv->dot118021XGrpPrivacy =3D=3D _TKIP_) {
+				memcpy(pframe + index - tx_desc + 56,
+					&psta->dot11tkiptxmickey, RTW_TKIP_MIC_LEN);
+				GTKLength +=3D RTW_TKIP_MIC_LEN;
+			}
+			CurtPktPageNum =3D (u8)PageNum(GTKLength, page_size);
+		}
+		*page_num +=3D CurtPktPageNum;
+
+		index +=3D (CurtPktPageNum * page_size);
+
+		/* 3 GTK Response */
+		rsvd_page_loc->LocGTKRsp =3D *page_num;
+		RTW_INFO("LocGTKRsp: %d\n", rsvd_page_loc->LocGTKRsp);
+		rtw_hal_construct_GTKRsp(adapter, &pframe[index], &GTKLength);
+
+		rtw_hal_fill_fake_txdesc(adapter, &pframe[index - tx_desc],
+					 GTKLength, false, false, true);
+
+		CurtPktPageNum =3D (u8)PageNum(tx_desc + GTKLength, page_size);
+
+		*page_num +=3D CurtPktPageNum;
+
+		index +=3D (CurtPktPageNum * page_size);
+
+		/* below page is empty for GTK extension memory */
+		/* 3(11) GTK EXT MEM */
+		rsvd_page_loc->LocGTKEXTMEM =3D *page_num;
+		RTW_INFO("LocGTKEXTMEM: %d\n", rsvd_page_loc->LocGTKEXTMEM);
+		CurtPktPageNum =3D 2;
+
+		if (page_size >=3D 256)
+			CurtPktPageNum =3D 1;
+
+		*page_num +=3D CurtPktPageNum;
+		/* extension memory for FW */
+		*total_pkt_len =3D index + (page_size * CurtPktPageNum);
+#endif /* CONFIG_GTK_OL */
+
+		index +=3D (CurtPktPageNum * page_size);
+
+		/*Reserve 1 page for AOAC report*/
+		rsvd_page_loc->LocAOACReport =3D *page_num;
+		RTW_INFO("LocAOACReport: %d\n", rsvd_page_loc->LocAOACReport);
+		*page_num +=3D 1;
+		*total_pkt_len =3D index + (page_size * 1);
+	} else {
+#ifdef CONFIG_PNO_SUPPORT
+		if (pwrctl->wowlan_in_resume =3D=3D false &&
+		    pwrctl->pno_inited =3D=3D true) {
+
+			/* Broadcast Probe Request */
+			rsvd_page_loc->LocProbePacket =3D *page_num;
+
+			RTW_INFO("loc_probe_req: %d\n",
+				 rsvd_page_loc->LocProbePacket);
+
+			rtw_hal_construct_ProbeReq(
+				adapter,
+				&pframe[index],
+				&ProbeReqLength,
+				NULL);
+
+			rtw_hal_fill_fake_txdesc(adapter,
+						 &pframe[index - tx_desc],
+				 ProbeReqLength, false, false, false);
+
+			CurtPktPageNum =3D
+				(u8)PageNum(tx_desc + ProbeReqLength, page_size);
+
+			*page_num +=3D CurtPktPageNum;
+
+			index +=3D (CurtPktPageNum * page_size);
+
+			/* Hidden SSID Probe Request */
+			ssid_num =3D pwrctl->pnlo_info->hidden_ssid_num;
+
+			for (pno_index =3D 0 ; pno_index < ssid_num ; pno_index++) {
+				pwrctl->pnlo_info->loc_probe_req[pno_index] =3D
+					*page_num;
+
+				rtw_hal_construct_ProbeReq(
+					adapter,
+					&pframe[index],
+					&ProbeReqLength,
+					&pwrctl->pno_ssid_list->node[pno_index]);
+
+				rtw_hal_fill_fake_txdesc(adapter,
+						 &pframe[index - tx_desc],
+					ProbeReqLength, false, false, false);
+
+				CurtPktPageNum =3D
+					(u8)PageNum(tx_desc + ProbeReqLength, page_size);
+
+				*page_num +=3D CurtPktPageNum;
+
+				index +=3D (CurtPktPageNum * page_size);
+			}
+
+			/* PNO INFO Page */
+			rsvd_page_loc->LocPNOInfo =3D *page_num;
+			RTW_INFO("LocPNOInfo: %d\n", rsvd_page_loc->LocPNOInfo);
+			rtw_hal_construct_PNO_info(adapter,
+						   &pframe[index - tx_desc],
+						   &PNOLength);
+
+			CurtPktPageNum =3D (u8)PageNum(PNOLength, page_size);
+			*page_num +=3D CurtPktPageNum;
+			index +=3D (CurtPktPageNum * page_size);
+
+			/* Scan Info Page */
+			rsvd_page_loc->LocScanInfo =3D *page_num;
+			RTW_INFO("LocScanInfo: %d\n", rsvd_page_loc->LocScanInfo);
+			rtw_hal_construct_scan_info(adapter,
+						    &pframe[index - tx_desc],
+						    &ScanInfoLength);
+
+			CurtPktPageNum =3D (u8)PageNum(ScanInfoLength, page_size);
+			*page_num +=3D CurtPktPageNum;
+			*total_pkt_len =3D index + ScanInfoLength;
+			index +=3D (CurtPktPageNum * page_size);
+		}
+#endif /* CONFIG_PNO_SUPPORT */
+	}
+}
