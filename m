+static void eap_sm_parseEapResp(struct eap_sm *sm, const struct wpabuf *re=
sp)
+{
+	const struct eap_hdr *hdr;
+	size_t plen;
+
+	/* parse rxResp, respId, respMethod */
+	sm->rxResp =3D FALSE;
+	sm->respId =3D -1;
+	sm->respMethod =3D EAP_TYPE_NONE;
+	sm->respVendor =3D EAP_VENDOR_IETF;
+	sm->respVendorMethod =3D EAP_TYPE_NONE;
+
+	if (resp =3D=3D NULL || wpabuf_len(resp) < sizeof(*hdr)) {
+		wpa_printf(MSG_DEBUG, "EAP: parseEapResp: invalid resp=3D%p "
+			   "len=3D%lu", resp,
+			   resp ? (unsigned long) wpabuf_len(resp) : 0);
+		return;
+	}
+
+	hdr =3D wpabuf_head(resp);
+	plen =3D be_to_host16(hdr->length);
+	if (plen > wpabuf_len(resp)) {
+		wpa_printf(MSG_DEBUG, "EAP: Ignored truncated EAP-Packet "
+			   "(len=3D%lu plen=3D%lu)",
+			   (unsigned long) wpabuf_len(resp),
+			   (unsigned long) plen);
+		return;
+	}
+
+	sm->respId =3D hdr->identifier;
+
+	if (hdr->code =3D=3D EAP_CODE_RESPONSE)
+		sm->rxResp =3D TRUE;
+
+	if (plen > sizeof(*hdr)) {
+		u8 *pos =3D (u8 *) (hdr + 1);
+		sm->respMethod =3D *pos++;
+		if (sm->respMethod =3D=3D EAP_TYPE_EXPANDED) {
+			if (plen < sizeof(*hdr) + 8) {
+				wpa_printf(MSG_DEBUG, "EAP: Ignored truncated "
+					   "expanded EAP-Packet (plen=3D%lu)",
+					   (unsigned long) plen);
+				return;
+			}
+			sm->respVendor =3D WPA_GET_BE24(pos);
+			pos +=3D 3;
+			sm->respVendorMethod =3D WPA_GET_BE32(pos);
+		}
+	}
+
+	wpa_printf(MSG_DEBUG, "EAP: parseEapResp: rxResp=3D%d respId=3D%d "
+		   "respMethod=3D%u respVendor=3D%u respVendorMethod=3D%u",
+		   sm->rxResp, sm->respId, sm->respMethod, sm->respVendor,
+		   sm->respVendorMethod);
+}
