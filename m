+
+				RTW_INFO("BA_starting_seqctrl =3D %d for TID=3D%d\n", start_seq, tid &=
 0x07);
+
+				psta->BA_starting_seqctrl[tid & 0x07] =3D start_seq;
+
+				BA_starting_seqctrl =3D start_seq << 4;
+			} else {
+				BA_starting_seqctrl =3D 0;
+			}
+			le_val =3D cpu_to_le16(BA_starting_seqctrl);
+			pframe =3D rtw_set_fixed_ie(pframe, 2, (unsigned char *)(&(le_val)), &(=
pattrib->pktlen));
+			break;
+
+		case RTW_WLAN_ACTION_ADDBA_RESP:
+			pframe =3D rtw_set_fixed_ie(pframe, 1, &(pmlmeinfo->ADDBA_req.dialog_to=
ken), &(pattrib->pktlen));
+			le_val =3D cpu_to_le16(status);
