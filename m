+	struct rtw_wdev_priv *pwdev_priv =3D adapter_wdev_data(padapter);
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+		struct mlme_priv *buddy_mlmepriv;
+		struct rtw_wdev_priv *buddy_wdev_priv;
+
+		iface =3D dvobj->padapters[i];
+		if (iface =3D=3D NULL)
+			continue;
+
+		if (iface =3D=3D padapter)
+			continue;
+
+		if (rtw_is_adapter_up(iface) =3D=3D false)
+			continue;
+
+		buddy_mlmepriv =3D &iface->mlmepriv;
+		if (!check_fwstate(buddy_mlmepriv, _FW_UNDER_SURVEY))
+			continue;
+
+		buddy_wdev_priv =3D adapter_wdev_data(iface);
+		_enter_critical_bh(&pwdev_priv->scan_req_lock, &irqL);
+		_enter_critical_bh(&buddy_wdev_priv->scan_req_lock, &irqL);
+		if (buddy_wdev_priv->scan_request) {
+			pmlmepriv->scanning_via_buddy_intf =3D true;
+			_enter_critical_bh(&pmlmepriv->lock, &irqL);
+			set_fwstate(pmlmepriv, _FW_UNDER_SURVEY);
+			_exit_critical_bh(&pmlmepriv->lock, &irqL);
+			pwdev_priv->scan_request =3D request;
+			ret =3D true;
