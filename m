=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D */
+	/* return value: */
+	/* [31:16]=3D> connected port number */
+	/* [15:0]=3D> port connected bit define */
+	/* =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D */
+
+	PADAPTER padapter;
+	u32 retVal;
+	u32 portConnectedStatus, numOfConnectedPort;
+	struct dvobj_priv *dvobj;
+	_adapter *iface;
+	int i;
+
+	padapter =3D pBtCoexist->Adapter;
+	retVal =3D 0;
+	portConnectedStatus =3D 0;
+	numOfConnectedPort =3D 0;
+	dvobj =3D adapter_to_dvobj(padapter);
+
+	for (i =3D 0; i < dvobj->iface_nums; i++) {
+		iface =3D dvobj->padapters[i];
+		if ((iface) && rtw_is_adapter_up(iface)) {
+			retVal =3D _halbtcoutsrc_GetWifiLinkStatus(iface);
+			if (retVal) {
+				portConnectedStatus |=3D retVal;
+				numOfConnectedPort++;
+			}
+		}
+	}
+	retVal =3D (numOfConnectedPort << 16) | portConnectedStatus;
+
+	return retVal;
