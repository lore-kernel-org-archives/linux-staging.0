+
+	wpabuf_free(wps->dh_pubkey_e);
+	wps->dh_pubkey_e =3D wpabuf_alloc_copy(pk, pk_len);
+	if (wps->dh_pubkey_e =3D=3D NULL)
+		return -1;
+
+	return 0;
