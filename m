+struct wpabuf * wps_decrypt_encr_settings(struct wps_data *wps, const u8 *=
encr,
+					  size_t encr_len)
+{
+	struct wpabuf *decrypted;
+	const size_t block_size =3D 16;
+	size_t i;
+	u8 pad;
+	const u8 *pos;
+
+	/* AES-128-CBC */
+	if (encr =3D=3D NULL || encr_len < 2 * block_size || encr_len % block_siz=
e)
+	{
+		wpa_printf(MSG_DEBUG, "WPS: No Encrypted Settings received");
+		return NULL;
+	}
+
+	decrypted =3D wpabuf_alloc(encr_len - block_size);
+	if (decrypted =3D=3D NULL)
+		return NULL;
+
+	wpa_hexdump(MSG_MSGDUMP, "WPS: Encrypted Settings", encr, encr_len);
+	wpabuf_put_data(decrypted, encr + block_size, encr_len - block_size);
+	if (aes_128_cbc_decrypt(wps->keywrapkey, encr, wpabuf_mhead(decrypted),
+				wpabuf_len(decrypted))) {
+		wpabuf_free(decrypted);
+		return NULL;
+	}
+
+	wpa_hexdump_buf_key(MSG_MSGDUMP, "WPS: Decrypted Encrypted Settings",
+			    decrypted);
+
+	pos =3D wpabuf_head_u8(decrypted) + wpabuf_len(decrypted) - 1;
+	pad =3D *pos;
+	if (pad > wpabuf_len(decrypted)) {
+		wpa_printf(MSG_DEBUG, "WPS: Invalid PKCS#5 v2.0 pad value");
+		wpabuf_free(decrypted);
+		return NULL;
+	}
+	for (i =3D 0; i < pad; i++) {
+		if (*pos-- !=3D pad) {
+			wpa_printf(MSG_DEBUG, "WPS: Invalid PKCS#5 v2.0 pad "
+				   "string");
+			wpabuf_free(decrypted);
+			return NULL;
+		}
+	}
+	decrypted->used -=3D pad;
+
+	return decrypted;
+}
