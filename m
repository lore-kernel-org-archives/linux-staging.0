+++ b/drivers/staging/rtl8188eu/hal/HalPwrSeqCmd.c
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Copyright(c) 2007 - 2016 Realtek Corporation. All rights reserved. */
+
+/*++
+Copyright (c) Realtek Semiconductor Corp. All rights reserved.
+
+Module Name:
+	HalPwrSeqCmd.c
+
+Abstract:
+	Implement HW Power sequence configuration CMD handling routine for Realte=
k devices.
+
+Major Change History:
+	When       Who               What
+	---------- ---------------   -------------------------------
+	2011-10-26 Lucas            Modify to be compatible with SD4-CE driver.
+	2011-07-07 Roger            Create.
+
+--*/
+#include <HalPwrSeqCmd.h>
+
+
+/*
+ *	Description:
+ *		This routine deal with the Power Configuration CMDs parsing for RTL872=
3/RTL8188E Series IC.
+ *
+ *	Assumption:
+ *		We should follow specific format which was released from HW SD.
+ *
+ *	2011.07.07, added by Roger.
+ *   */
+u8 HalPwrSeqCmdParsing(
+	PADAPTER		padapter,
+	u8				CutVersion,
+	u8				FabVersion,
+	u8				InterfaceType,
+	WLAN_PWR_CFG	PwrSeqCmd[])
+{
+	WLAN_PWR_CFG	PwrCfgCmd =3D {0};
+	u8				bPollingBit =3D false;
+	u32				AryIdx =3D 0;
+	u8				value =3D 0;
+	u32				offset =3D 0;
+	u32				pollingCount =3D 0; /* polling autoload done. */
+	u32				maxPollingCnt =3D 5000;
+
+	do {
+		PwrCfgCmd =3D PwrSeqCmd[AryIdx];
+
+
+		/* 2 Only Handle the command whose FAB, CUT, and Interface are matched */
+		if ((GET_PWR_CFG_FAB_MASK(PwrCfgCmd) & FabVersion) &&
+		    (GET_PWR_CFG_CUT_MASK(PwrCfgCmd) & CutVersion) &&
+		    (GET_PWR_CFG_INTF_MASK(PwrCfgCmd) & InterfaceType)) {
+			switch (GET_PWR_CFG_CMD(PwrCfgCmd)) {
+			case PWR_CMD_READ:
+				break;
+
+			case PWR_CMD_WRITE:
+				offset =3D GET_PWR_CFG_OFFSET(PwrCfgCmd);
+
+#ifdef CONFIG_SDIO_HCI
+				/*  */
+				/* <Roger_Notes> We should deal with interface specific address mappin=
g for some interfaces, e.g., SDIO interface */
+				/* 2011.07.07. */
+				/*  */
+				if (GET_PWR_CFG_BASE(PwrCfgCmd) =3D=3D PWR_BASEADDR_SDIO) {
+					/* Read Back SDIO Local value */
+					value =3D SdioLocalCmd52Read1Byte(padapter, offset);
+
+					value &=3D ~(GET_PWR_CFG_MASK(PwrCfgCmd));
+					value |=3D (GET_PWR_CFG_VALUE(PwrCfgCmd) & GET_PWR_CFG_MASK(PwrCfgCmd=
));
+
+					/* Write Back SDIO Local value */
+					SdioLocalCmd52Write1Byte(padapter, offset, value);
+				} else
+#endif
+				{
+#ifdef CONFIG_GSPI_HCI
+					if (GET_PWR_CFG_BASE(PwrCfgCmd) =3D=3D PWR_BASEADDR_SDIO)
+						offset =3D SPI_LOCAL_OFFSET | offset;
+#endif
+					/* Read the value from system register */
+					value =3D rtw_read8(padapter, offset);
+
+					value =3D value & (~(GET_PWR_CFG_MASK(PwrCfgCmd)));
+					value =3D value | (GET_PWR_CFG_VALUE(PwrCfgCmd) & GET_PWR_CFG_MASK(Pw=
rCfgCmd));
+
+					/* Write the value back to sytem register */
+					rtw_write8(padapter, offset, value);
+				}
+				break;
+
+			case PWR_CMD_POLLING:
+
+				bPollingBit =3D false;
+				offset =3D GET_PWR_CFG_OFFSET(PwrCfgCmd);
+#ifdef CONFIG_GSPI_HCI
+				if (GET_PWR_CFG_BASE(PwrCfgCmd) =3D=3D PWR_BASEADDR_SDIO)
+					offset =3D SPI_LOCAL_OFFSET | offset;
+#endif
+				do {
+#ifdef CONFIG_SDIO_HCI
+					if (GET_PWR_CFG_BASE(PwrCfgCmd) =3D=3D PWR_BASEADDR_SDIO)
+						value =3D SdioLocalCmd52Read1Byte(padapter, offset);
+					else
+#endif
+						value =3D rtw_read8(padapter, offset);
+
+					value =3D value & GET_PWR_CFG_MASK(PwrCfgCmd);
+					if (value =3D=3D (GET_PWR_CFG_VALUE(PwrCfgCmd) & GET_PWR_CFG_MASK(Pwr=
CfgCmd)))
+						bPollingBit =3D true;
+					else
+						rtw_udelay_os(10);
+
+					if (pollingCount++ > maxPollingCnt) {
+						RTW_ERR("HalPwrSeqCmdParsing: Fail to polling Offset[%#x]=3D%02x\n",=
 offset, value);
+						return false;
+					}
+				} while (!bPollingBit);
+
+				break;
+
