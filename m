+
+static void radius_client_list_add(struct radius_client_data *radius,
+				   struct radius_msg *msg,
+				   RadiusType msg_type,
+				   const u8 *shared_secret,
+				   size_t shared_secret_len, const u8 *addr)
+{
+	struct radius_msg_list *entry, *prev;
+
+	if (eloop_terminated()) {
+		/* No point in adding entries to retransmit queue since event
+		 * loop has already been terminated. */
+		radius_msg_free(msg);
+		return;
+	}
+
+	entry =3D os_zalloc(sizeof(*entry));
+	if (entry =3D=3D NULL) {
+		printf("Failed to add RADIUS packet into retransmit list\n");
+		radius_msg_free(msg);
+		return;
+	}
+
+	if (addr)
+		os_memcpy(entry->addr, addr, ETH_ALEN);
+	entry->msg =3D msg;
+	entry->msg_type =3D msg_type;
+	entry->shared_secret =3D shared_secret;
+	entry->shared_secret_len =3D shared_secret_len;
+	os_get_time(&entry->last_attempt);
+	entry->first_try =3D entry->last_attempt.sec;
+	entry->next_try =3D entry->first_try + RADIUS_CLIENT_FIRST_WAIT;
+	entry->attempts =3D 1;
+	entry->next_wait =3D RADIUS_CLIENT_FIRST_WAIT * 2;
+	entry->next =3D radius->msgs;
+	radius->msgs =3D entry;
+	radius_client_update_timeout(radius);
+
+	if (radius->num_msgs >=3D RADIUS_CLIENT_MAX_ENTRIES) {
+		printf("Removing the oldest un-ACKed RADIUS packet due to "
+		       "retransmit list limits.\n");
+		prev =3D NULL;
+		while (entry->next) {
+			prev =3D entry;
+			entry =3D entry->next;
+		}
+		if (prev) {
+			prev->next =3D NULL;
+			radius_client_msg_free(entry);
+		}
+	} else
+		radius->num_msgs++;
+}
+
+
+static void radius_client_list_del(struct radius_client_data *radius,
+				   RadiusType msg_type, const u8 *addr)
+{
+	struct radius_msg_list *entry, *prev, *tmp;
+
+	if (addr =3D=3D NULL)
+		return;
+
+	entry =3D radius->msgs;
+	prev =3D NULL;
+	while (entry) {
+		if (entry->msg_type =3D=3D msg_type &&
+		    os_memcmp(entry->addr, addr, ETH_ALEN) =3D=3D 0) {
+			if (prev)
+				prev->next =3D entry->next;
+			else
+				radius->msgs =3D entry->next;
+			tmp =3D entry;
+			entry =3D entry->next;
+			hostapd_logger(radius->ctx, addr,
+				       HOSTAPD_MODULE_RADIUS,
+				       HOSTAPD_LEVEL_DEBUG,
+				       "Removing matching RADIUS message");
+			radius_client_msg_free(tmp);
+			radius->num_msgs--;
+			continue;
+		}
+		prev =3D entry;
+		entry =3D entry->next;
+	}
+}
