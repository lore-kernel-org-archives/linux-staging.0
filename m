+int wpa_driver_wext_get_ssid(void *priv, u8 *ssid)
+{
+	struct wpa_driver_wext_data *drv =3D priv;
+	struct iwreq iwr;
+	int ret =3D 0;
+
+	os_memset(&iwr, 0, sizeof(iwr));
