+static u32 go_add_group_info_attr(struct wifidirect_info *pwdinfo, u8 *pbu=
f)
+{
+	unsigned long irqL;
+	_list	*phead, *plist;
+	u32 len =3D 0;
+	u16 attr_len =3D 0;
+	u8 tmplen, *pdata_attr, *pstart, *pcur;
+	struct sta_info *psta =3D NULL;
+	_adapter *padapter =3D pwdinfo->padapter;
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+
+	RTW_INFO(FUNC_ADPT_FMT"\n", FUNC_ADPT_ARG(padapter));
+
+	pdata_attr =3D rtw_zmalloc(MAX_P2P_IE_LEN);
+
+	if (NULL =3D=3D pdata_attr) {
+		RTW_INFO("%s pdata_attr malloc failed\n", __func__);
+		goto _exit;
+	}
+
+	pstart =3D pdata_attr;
+	pcur =3D pdata_attr;
+
+	_enter_critical_bh(&pstapriv->asoc_list_lock, &irqL);
+	phead =3D &pstapriv->asoc_list;
+	plist =3D get_next(phead);
+
+	/* look up sta asoc_queue */
+	while ((rtw_end_of_queue_search(phead, plist)) =3D=3D false) {
+		psta =3D LIST_CONTAINOR(plist, struct sta_info, asoc_list);
+
+		plist =3D get_next(plist);
+
+
+		if (psta->is_p2p_device) {
+			tmplen =3D 0;
+
+			pcur++;
+
+			/* P2P device address */
+			memcpy(pcur, psta->dev_addr, ETH_ALEN);
+			pcur +=3D ETH_ALEN;
+
+			/* P2P interface address */
+			memcpy(pcur, psta->hwaddr, ETH_ALEN);
+			pcur +=3D ETH_ALEN;
+
+			*pcur =3D psta->dev_cap;
+			pcur++;
+
+			/* *(u16*)(pcur) =3D cpu_to_be16(psta->config_methods); */
+			RTW_PUT_BE16(pcur, psta->config_methods);
+			pcur +=3D 2;
+
+			memcpy(pcur, psta->primary_dev_type, 8);
+			pcur +=3D 8;
+
+			*pcur =3D psta->num_of_secdev_type;
+			pcur++;
+
+			memcpy(pcur, psta->secdev_types_list, psta->num_of_secdev_type * 8);
+			pcur +=3D psta->num_of_secdev_type * 8;
+
+			if (psta->dev_name_len > 0) {
+				/* *(u16*)(pcur) =3D cpu_to_be16( WPS_ATTR_DEVICE_NAME ); */
+				RTW_PUT_BE16(pcur, WPS_ATTR_DEVICE_NAME);
+				pcur +=3D 2;
+
+				/* *(u16*)(pcur) =3D cpu_to_be16( psta->dev_name_len ); */
+				RTW_PUT_BE16(pcur, psta->dev_name_len);
+				pcur +=3D 2;
+
+				memcpy(pcur, psta->dev_name, psta->dev_name_len);
+				pcur +=3D psta->dev_name_len;
+			}
+
+
+			tmplen =3D (u8)(pcur - pstart);
+
+			*pstart =3D (tmplen - 1);
+
+			attr_len +=3D tmplen;
+
+			/* pstart +=3D tmplen; */
+			pstart =3D pcur;
+
+		}
+
+
+	}
+	_exit_critical_bh(&pstapriv->asoc_list_lock, &irqL);
+
+	if (attr_len > 0)
+		len =3D rtw_set_p2p_attr_content(pbuf, P2P_ATTR_GROUP_INFO, attr_len, pd=
ata_attr);
+
+	rtw_mfree(pdata_attr, MAX_P2P_IE_LEN);
+
+_exit:
+	return len;
+
+}
