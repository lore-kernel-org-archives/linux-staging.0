+void des_encrypt(const u8 *clear, const u8 *key, u8 *cypher)
+{
+	PK11Context *ctx =3D NULL;
+	PK11SlotInfo *slot;
+	SECItem *param =3D NULL;
+	PK11SymKey *symkey =3D NULL;
+	SECItem item;
+	int olen;
+	u8 pkey[8], next, tmp;
+	int i;
+
+	/* Add parity bits to the key */
+	next =3D 0;
+	for (i =3D 0; i < 7; i++) {
+		tmp =3D key[i];
+		pkey[i] =3D (tmp >> i) | next | 1;
+		next =3D tmp << (7 - i);
+	}
+	pkey[i] =3D next | 1;
+
+	slot =3D PK11_GetBestSlot(CKM_DES_ECB, NULL);
+	if (slot =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "NSS: PK11_GetBestSlot failed");
+		goto out;
+	}
+
+	item.type =3D siBuffer;
+	item.data =3D pkey;
+	item.len =3D 8;
+	symkey =3D PK11_ImportSymKey(slot, CKM_DES_ECB, PK11_OriginDerive,
+				   CKA_ENCRYPT, &item, NULL);
+	if (symkey =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "NSS: PK11_ImportSymKey failed");
+		goto out;
+	}
+
+	param =3D PK11_GenerateNewParam(CKM_DES_ECB, symkey);
+	if (param =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "NSS: PK11_GenerateNewParam failed");
+		goto out;
+	}
+
+	ctx =3D PK11_CreateContextBySymKey(CKM_DES_ECB, CKA_ENCRYPT,
+					 symkey, param);
+	if (ctx =3D=3D NULL) {
+		wpa_printf(MSG_ERROR, "NSS: PK11_CreateContextBySymKey("
+			   "CKM_DES_ECB) failed");
+		goto out;
+	}
+
+	if (PK11_CipherOp(ctx, cypher, &olen, 8, (void *) clear, 8) !=3D
+	    SECSuccess) {
+		wpa_printf(MSG_ERROR, "NSS: PK11_CipherOp failed");
+		goto out;
+	}
+
+out:
+	if (ctx)
+		PK11_DestroyContext(ctx, PR_TRUE);
+	if (symkey)
+		PK11_FreeSymKey(symkey);
+	if (param)
+		SECITEM_FreeItem(param, PR_TRUE);
+}
