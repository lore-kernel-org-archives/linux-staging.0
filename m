+/********************************************************************
+
+When station does not receive any packet in MAX_CONTINUAL_NORXPACKET_COUNT=
*2 seconds,
+recipient station will teardown the block ack by issuing DELBA frame.
+
+*********************************************************************/
+static void rtw_delba_check(_adapter *padapter, struct sta_info *psta, u8 =
from_timer)
+{
+	int	i =3D 0;
+	int ret =3D _SUCCESS;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+
+	/*
+		IOT issue,occur Broadcom ap(Buffalo WZR-D1800H,Netgear R6300).
+		AP is originator.AP does not transmit unicast packets when STA response =
its BAR.
+		This case probably occur ap issue BAR after AP builds BA.
+
+		Follow 802.11 spec, STA shall maintain an inactivity timer for every neg=
otiated Block Ack setup.
+		The inactivity timer is not reset when MPDUs corresponding to other TIDs=
 are received.
+	*/
+	if (pmlmeinfo->assoc_AP_vendor =3D=3D HT_IOT_PEER_BROADCOM) {
+		for (i =3D 0; i < TID_NUM ; i++) {
+			if ((psta->recvreorder_ctrl[i].enable) &&=20
+                        (sta_rx_data_qos_pkts(psta, i) =3D=3D sta_last_rx_=
data_qos_pkts(psta, i)) ) {=09=09=09
+					if (rtw_inc_and_chk_continual_no_rx_packet(psta, i)) {=09=09=09=09=09
+						/* send a DELBA frame to the peer STA with the Reason Code field set=
 to TIMEOUT */
+						if (!from_timer)
+							ret =3D issue_del_ba_ex(padapter, psta->hwaddr, i, 39, 0, 3, 1);
+						else
+							issue_del_ba(padapter,  psta->hwaddr, i, 39, 0);
+						psta->recvreorder_ctrl[i].enable =3D false;
+						if (ret !=3D _FAIL)
+							psta->recvreorder_ctrl[i].ampdu_size =3D RX_AMPDU_SIZE_INVALID;
+						rtw_reset_continual_no_rx_packet(psta, i);
+					}=09=09=09=09
+			} else {
+				/* The inactivity timer is reset when MPDUs to the TID is received. */
+				rtw_reset_continual_no_rx_packet(psta, i);
+			}
+		}
+	}
+}
