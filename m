+	s32 curr_sig
+)
+{
+	s32 ret_sig =3D 0;
+
+	if ((p_dm_odm->support_interface  =3D=3D ODM_ITRF_USB) || (p_dm_odm->supp=
ort_interface  =3D=3D ODM_ITRF_SDIO)) {
+		if (curr_sig >=3D 51 && curr_sig <=3D 100)
+			ret_sig =3D 100;
+		else if (curr_sig >=3D 41 && curr_sig <=3D 50)
+			ret_sig =3D 80 + ((curr_sig - 40) * 2);
+		else if (curr_sig >=3D 31 && curr_sig <=3D 40)
+			ret_sig =3D 66 + (curr_sig - 30);
+		else if (curr_sig >=3D 21 && curr_sig <=3D 30)
+			ret_sig =3D 54 + (curr_sig - 20);
+		else if (curr_sig >=3D 10 && curr_sig <=3D 20)
+			ret_sig =3D 42 + (((curr_sig - 10) * 2) / 3);
+		else if (curr_sig >=3D 5 && curr_sig <=3D 9)
+			ret_sig =3D 22 + (((curr_sig - 5) * 3) / 2);
+		else if (curr_sig >=3D 1 && curr_sig <=3D 4)
+			ret_sig =3D 6 + (((curr_sig - 1) * 3) / 2);
+		else
+			ret_sig =3D curr_sig;
+	}
+
+	return ret_sig;
