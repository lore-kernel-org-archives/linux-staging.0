+		if (1 <=3D ch && ch <=3D 2)
+			gp =3D 0;
+		else if (3  <=3D ch && ch <=3D 5)
+			gp =3D 1;
+		else if (6  <=3D ch && ch <=3D 8)
+			gp =3D 2;
+		else if (9  <=3D ch && ch <=3D 11)
+			gp =3D 3;
+		else if (12 <=3D ch && ch <=3D 14)
