+	_adapter *padapter =3D (_adapter *)rtw_netdev_priv(dev);
+	struct tdls_info	*ptdlsinfo =3D &padapter->tdlsinfo;
+	unsigned long	 irqL;
+	_list	*plist, *phead;
+	s32	index;
+	struct sta_info *psta =3D NULL;
+	struct	sta_priv *pstapriv =3D &padapter->stapriv;
+	u8 tdls_sta[NUM_STA][ETH_ALEN];
+	u8 empty_hwaddr[ETH_ALEN] =3D { 0x00 };
+	struct tdls_txmgmt txmgmt;
+
+	RTW_INFO("[%s] %s %d\n", __func__, extra, wrqu->data.length - 1);
+
+	memset(tdls_sta, 0x00, sizeof(tdls_sta));
+	memset(&txmgmt, 0x00, sizeof(struct tdls_txmgmt));
+
+	if (extra[0] =3D=3D '0') {
+		ptdlsinfo->tdls_enable =3D 0;
+
+		if (pstapriv->asoc_sta_count =3D=3D 1)
+			return ret;
+
+		_enter_critical_bh(&pstapriv->sta_hash_lock, &irqL);
+		for (index =3D 0; index < NUM_STA; index++) {
+			phead =3D &(pstapriv->sta_hash[index]);
+			plist =3D get_next(phead);
+
+			while (rtw_end_of_queue_search(phead, plist) =3D=3D false) {
+				psta =3D LIST_CONTAINOR(plist, struct sta_info , hash_list);
+
+				plist =3D get_next(plist);
+
+				if (psta->tdls_sta_state !=3D TDLS_STATE_NONE)
+					memcpy(tdls_sta[index], psta->hwaddr, ETH_ALEN);
+			}
+		}
+		_exit_critical_bh(&pstapriv->sta_hash_lock, &irqL);
+
+		for (index =3D 0; index < NUM_STA; index++) {
+			if (memcmp(tdls_sta[index], empty_hwaddr, ETH_ALEN)) {
+				RTW_INFO("issue tear down to "MAC_FMT"\n", MAC_ARG(tdls_sta[index]));
+				txmgmt.status_code =3D _RSON_TDLS_TEAR_UN_RSN_;
+				memcpy(txmgmt.peer, tdls_sta[index], ETH_ALEN);
+				issue_tdls_teardown(padapter, &txmgmt, true);
+			}
+		}
+		rtw_tdls_cmd(padapter, NULL, TDLS_RS_RCR);
+		rtw_reset_tdls_info(padapter);
+	}	else if (extra[0] =3D=3D '1')
+		ptdlsinfo->tdls_enable =3D 1;
+#endif /* CONFIG_TDLS */
+
+	return ret;
+}
