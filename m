+void rtw_buf_update(u8 **buf, u32 *buf_len, u8 *src, u32 src_len)
+{
+	u32 ori_len =3D 0, dup_len =3D 0;
+	u8 *ori =3D NULL;
+	u8 *dup =3D NULL;
+
+	if (!buf || !buf_len)
+		return;
+
+	if (!src || !src_len)
+		goto keep_ori;
+
+	/* duplicate src */
+	dup =3D rtw_malloc(src_len);
+	if (dup) {
+		dup_len =3D src_len;
+		memcpy(dup, src, dup_len);
+	}
+
+keep_ori:
+	ori =3D *buf;
+	ori_len =3D *buf_len;
+
+	/* replace buf with dup */
+	*buf_len =3D 0;
+	*buf =3D dup;
+	*buf_len =3D dup_len;
+
+	/* free ori */
+	if (ori && ori_len > 0)
+		rtw_mfree(ori, ori_len);
