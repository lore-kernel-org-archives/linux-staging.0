+struct wpabuf * wps_registrar_get_msg(struct wps_data *wps,
+				      enum wsc_op_code *op_code)
+{
+	struct wpabuf *msg;
+
+#ifdef CONFIG_WPS_UPNP
+	if (!wps->int_reg && wps->wps->wps_upnp) {
+		struct upnp_pending_message *p, *prev =3D NULL;
+		if (wps->ext_reg > 1)
+			wps_registrar_free_pending_m2(wps->wps);
+		p =3D wps->wps->upnp_msgs;
+		/* TODO: check pending message MAC address */
+		while (p && p->next) {
+			prev =3D p;
+			p =3D p->next;
+		}
+		if (p) {
+			wpa_printf(MSG_DEBUG, "WPS: Use pending message from "
+				   "UPnP");
+			if (prev)
+				prev->next =3D NULL;
+			else
+				wps->wps->upnp_msgs =3D NULL;
+			msg =3D p->msg;
+			switch (p->type) {
+			case WPS_WSC_ACK:
+				*op_code =3D WSC_ACK;
+				break;
+			case WPS_WSC_NACK:
+				*op_code =3D WSC_NACK;
+				break;
+			default:
+				*op_code =3D WSC_MSG;
+				break;
+			}
+			os_free(p);
+			if (wps->ext_reg =3D=3D 0)
+				wps->ext_reg =3D 1;
+			return msg;
+		}
+	}
+	if (wps->ext_reg) {
+		wpa_printf(MSG_DEBUG, "WPS: Using external Registrar, but no "
+			   "pending message available");
+		return NULL;
+	}
+#endif /* CONFIG_WPS_UPNP */
+
+	switch (wps->state) {
+	case SEND_M2:
+		if (wps_get_dev_password(wps) < 0)
+			msg =3D wps_build_m2d(wps);
+		else
+			msg =3D wps_build_m2(wps);
+		*op_code =3D WSC_MSG;
+		break;
+	case SEND_M2D:
+		msg =3D wps_build_m2d(wps);
+		*op_code =3D WSC_MSG;
+		break;
+	case SEND_M4:
+		msg =3D wps_build_m4(wps);
+		*op_code =3D WSC_MSG;
+		break;
+	case SEND_M6:
+		msg =3D wps_build_m6(wps);
+		*op_code =3D WSC_MSG;
+		break;
+	case SEND_M8:
+		msg =3D wps_build_m8(wps);
+		*op_code =3D WSC_MSG;
+		break;
+	case RECV_DONE:
+		msg =3D wps_build_wsc_ack(wps);
+		*op_code =3D WSC_ACK;
+		break;
+	case SEND_WSC_NACK:
+		msg =3D wps_build_wsc_nack(wps);
+		*op_code =3D WSC_NACK;
+		break;
+	default:
+		wpa_printf(MSG_DEBUG, "WPS: Unsupported state %d for building "
+			   "a message", wps->state);
+		msg =3D NULL;
+		break;
+	}
+
+	if (*op_code =3D=3D WSC_MSG && msg) {
+		/* Save a copy of the last message for Authenticator derivation
+		 */
+		wpabuf_free(wps->last_msg);
+		wps->last_msg =3D wpabuf_dup(msg);
+	}
+
+	return msg;
+}
