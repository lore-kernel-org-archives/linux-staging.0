+static int rtw_tdls(struct net_device *dev,
+		    struct iw_request_info *info,
+		    union iwreq_data *wrqu, char *extra)
+{
+	int ret =3D 0;
+
+#ifdef CONFIG_TDLS
+
+	_adapter *padapter =3D (_adapter *)rtw_netdev_priv(dev);
+
+	RTW_INFO("[%s] extra =3D %s\n", __func__, extra);
+
+	if (hal_chk_wl_func(padapter, WL_FUNC_TDLS) =3D=3D false) {
+		RTW_INFO("Discard tdls oper since hal doesn't support tdls\n");
+		return 0;
+	}
+
+	if (padapter->tdlsinfo.tdls_enable =3D=3D 0) {
+		RTW_INFO("tdls haven't enabled\n");
+		return 0;
+	}
+
+	/* WFD Sigma will use the tdls enable command to let the driver know we w=
ant to test the tdls now! */
