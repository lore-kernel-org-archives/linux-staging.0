+static struct wpabuf * eap_fast_tlv_nak(int vendor_id, int tlv_type)
+{
+	struct wpabuf *buf;
+	struct eap_tlv_nak_tlv *nak;
+	buf =3D wpabuf_alloc(sizeof(*nak));
+	if (buf =3D=3D NULL)
+		return NULL;
+	nak =3D wpabuf_put(buf, sizeof(*nak));
+	nak->tlv_type =3D host_to_be16(EAP_TLV_TYPE_MANDATORY | EAP_TLV_NAK_TLV);
+	nak->length =3D host_to_be16(6);
+	nak->vendor_id =3D host_to_be32(vendor_id);
+	nak->nak_type =3D host_to_be16(tlv_type);
+	return buf;
+}
