+bool
+GetFractionValueFromString(
+		char			*szStr,
+	u8				*pInteger,
+	u8				*pFraction,
+	u32			*pu4bMove
+)
+{
+	char	*szScan =3D szStr;
+
+	/* Initialize output. */
+	*pu4bMove =3D 0;
+	*pInteger =3D 0;
+	*pFraction =3D 0;
+
+	/* Skip leading space. */
+	while (*szScan !=3D '\0' &&	(*szScan =3D=3D ' ' || *szScan =3D=3D '\t')) {
+		++szScan;
+		++(*pu4bMove);
+	}
+
+	/* Parse each digit. */
+	do {
+		(*pInteger) *=3D 10;
+		*pInteger +=3D (*szScan - '0');
+
+		++szScan;
+		++(*pu4bMove);
+
+		if (*szScan =3D=3D '.') {
+			++szScan;
+			++(*pu4bMove);
+
+			if (*szScan < '0' || *szScan > '9')
+				return false;
+			else {
+				*pFraction =3D *szScan - '0';
+				++szScan;
+				++(*pu4bMove);
+				return true;
+			}
+		}
+	} while (*szScan >=3D '0' && *szScan <=3D '9');
+
+	return true;
+}
