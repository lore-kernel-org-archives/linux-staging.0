+static int os_memcmp(void *s1, void *s2, u8 n)
+{
+	unsigned char *p1 =3D s1, *p2 =3D s2;
+
+	if (n =3D=3D 0)
+		return 0;
+
+	while (*p1 =3D=3D *p2) {
+		p1++;
+		p2++;
+		n--;
+		if (n =3D=3D 0)
+			return 0;
+	}
+
+	return *p1 - *p2;
+}
