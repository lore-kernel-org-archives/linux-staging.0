+			BA_para_set =3D le16_to_cpu(pmlmeinfo->ADDBA_req.BA_para_set);
+
+			BA_para_set &=3D ~IEEE80211_ADDBA_PARAM_TID_MASK;
+			BA_para_set |=3D (tid << 2) & IEEE80211_ADDBA_PARAM_TID_MASK;
