+static void trunc_nl(char *str)
+{
+	char *pos =3D str;
+	while (*pos !=3D '\0') {
+		if (*pos =3D=3D '\n') {
+			*pos =3D '\0';
+			break;
+		}
+		pos++;
+	}
+}
+
+
+static void readline_cmd_handler(char *cmd)
+{
+	if (cmd && *cmd) {
+		HIST_ENTRY *h;
+		while (next_history())
+			;
+		h =3D previous_history();
+		if (h =3D=3D NULL || os_strcmp(cmd, h->line) !=3D 0)
+			add_history(cmd);
+		next_history();
+	}
+	if (cmd =3D=3D NULL) {
+		edit_eof_cb(edit_cb_ctx);
+		return;
+	}
+	trunc_nl(cmd);
+	edit_cmd_cb(edit_cb_ctx, cmd);
+}
+
+
+int edit_init(void (*cmd_cb)(void *ctx, char *cmd),
+	      void (*eof_cb)(void *ctx),
+	      char ** (*completion_cb)(void *ctx, const char *cmd, int pos),
+	      void *ctx, const char *history_file)
+{
+	edit_cb_ctx =3D ctx;
+	edit_cmd_cb =3D cmd_cb;
+	edit_eof_cb =3D eof_cb;
+	edit_completion_cb =3D completion_cb;
+
+	rl_attempted_completion_function =3D readline_completion;
+	if (history_file) {
