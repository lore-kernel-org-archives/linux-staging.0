+static int wpa_driver_iphone_get_scan_results(void *priv,
+					      struct wpa_scan_result *results,
+					      size_t max_size)
+{
+	struct wpa_driver_iphone_data *drv =3D priv;
+	size_t i, num;
+
+	if (drv->scan_results =3D=3D NULL)
+		return 0;
+
+	num =3D CFArrayGetCount(drv->scan_results);
+	if (num > max_size)
+		num =3D max_size;
+	os_memset(results, 0, num * sizeof(struct wpa_scan_result));
+
+	for (i =3D 0; i < num; i++) {
+		struct wpa_scan_result *res =3D &results[i];
+		CFDictionaryRef dict =3D
+			CFArrayGetValueAtIndex(drv->scan_results, i);
+		CFDataRef data;
+		CFStringRef str;
+		CFNumberRef num;
+		int val;
+
+		data =3D cfdict_get_key_str(dict, "SSID");
+		if (data) {
+			res->ssid_len =3D CFDataGetLength(data);
+			if (res->ssid_len > 32)
+				res->ssid_len =3D 32;
+			os_memcpy(res->ssid, CFDataGetBytePtr(data),
+				  res->ssid_len);
+		}
+
+		str =3D cfdict_get_key_str(dict, "BSSID");
+		if (str) {
+			int a1, a2, a3, a4, a5, a6;
+			sscanf(CFStringGetCStringPtr(
+				       str, kCFStringEncodingMacRoman),
+			       "%x:%x:%x:%x:%x:%x",
+			       &a1, &a2, &a3, &a4, &a5, &a6);
+			res->bssid[0] =3D a1;
+			res->bssid[1] =3D a2;
+			res->bssid[2] =3D a3;
+			res->bssid[3] =3D a4;
+			res->bssid[4] =3D a5;
+			res->bssid[5] =3D a6;
+		}
+
+		num =3D cfdict_get_key_str(dict, "CAPABILITIES");
+		if (num) {
+			if (CFNumberGetValue(num, kCFNumberSInt32Type, &val))
+				res->caps =3D val;
+		}
+
+		num =3D cfdict_get_key_str(dict, "CHANNEL");
+		if (num) {
+			if (CFNumberGetValue(num, kCFNumberSInt32Type, &val))
+				res->freq =3D 2407 + val * 5;
+		}
+
+		num =3D cfdict_get_key_str(dict, "RSSI");
+		if (num) {
+			if (CFNumberGetValue(num, kCFNumberSInt32Type, &val))
+				res->level =3D val;
+		}
+
+		num =3D cfdict_get_key_str(dict, "NOISE");
+		if (num) {
+			if (CFNumberGetValue(num, kCFNumberSInt32Type, &val))
+				res->noise =3D val;
+		}
+
+		data =3D cfdict_get_key_str(dict, "IE");
+		if (data) {
+			u8 *ptr =3D (u8 *) CFDataGetBytePtr(data);
+			int len =3D CFDataGetLength(data);
+			u8 *pos =3D ptr, *end =3D ptr + len;
+
+			while (pos + 2 < end) {
+				if (pos + 2 + pos[1] > end)
+					break;
+				if (pos[0] =3D=3D WLAN_EID_RSN &&
+				    pos[1] <=3D SSID_MAX_WPA_IE_LEN) {
+					os_memcpy(res->rsn_ie, pos,
+						  2 + pos[1]);
+					res->rsn_ie_len =3D 2 + pos[1];
+				}
+				if (pos[0] =3D=3D WLAN_EID_VENDOR_SPECIFIC &&
+				    pos[1] > 4 && pos[2] =3D=3D 0x00 &&
+				    pos[3] =3D=3D 0x50 && pos[4] =3D=3D 0xf2 &&
+				    pos[5] =3D=3D 0x01) {
+					os_memcpy(res->wpa_ie, pos,
+						  2 + pos[1]);
+					res->wpa_ie_len =3D 2 + pos[1];
+				}
+
+				pos =3D pos + 2 + pos[1];
+			}
+		}
+	}
+
+	return num;
+}
