+s16 rtw_camid_alloc(_adapter *adapter, struct sta_info *sta, u8 kid, bool =
*used)
+{
+	struct mlme_ext_info *mlmeinfo =3D &adapter->mlmeextpriv.mlmext_info;
+	struct dvobj_priv *dvobj =3D adapter_to_dvobj(adapter);
+	struct cam_ctl_t *cam_ctl =3D &dvobj->cam_ctl;
+	unsigned long irqL;
+	s16 cam_id =3D -1;
+
+	*used =3D false;
+
+	_enter_critical_bh(&cam_ctl->lock, &irqL);
+
+	if ((((mlmeinfo->state & 0x03) =3D=3D WIFI_FW_AP_STATE) || ((mlmeinfo->st=
ate & 0x03) =3D=3D WIFI_FW_ADHOC_STATE))
+	    && !sta) {
+#ifndef CONFIG_CONCURRENT_MODE
+		/* AP/Ad-hoc mode group key static alloction to default key by key ID on=
 Non-concurrent*/
+		if (kid > 3) {
+			RTW_PRINT(FUNC_ADPT_FMT" group key with invalid key id:%u\n"
+				  , FUNC_ADPT_ARG(adapter), kid);
+			rtw_warn_on(1);
+			goto bitmap_handle;
+		}
+		cam_id =3D kid;
+#else
+		u8 *addr =3D adapter_mac_addr(adapter);
+
+		cam_id =3D rtw_get_camid(adapter, sta, addr, kid);
+		if (1)
+			RTW_PRINT(FUNC_ADPT_FMT" group key with "MAC_FMT" assigned cam_id:%u\n"
+				, FUNC_ADPT_ARG(adapter), MAC_ARG(addr), cam_id);
+#endif
+	} else {
+		u8 *addr =3D sta ? sta->hwaddr : NULL;
+
+		if (!sta) {
+			if (!(mlmeinfo->state & WIFI_FW_ASSOC_SUCCESS)) {
+				/* bypass STA mode group key setting before connected(ex:WEP) because =
bssid is not ready */
+				goto bitmap_handle;
+			}
+			addr =3D get_bssid(&adapter->mlmepriv);/*A2*/
+		}
+		cam_id =3D rtw_get_camid(adapter, sta, addr, kid);
+	}
+
+
+bitmap_handle:
+	if (cam_id >=3D 0) {
+		*used =3D _rtw_sec_camid_is_used(cam_ctl, cam_id);
+		rtw_sec_cam_map_set(&cam_ctl->used, cam_id);
+	}
+
+	_exit_critical_bh(&cam_ctl->lock, &irqL);
+
+	return cam_id;
+}
