+	u8 *frame_body =3D frame + sizeof(struct rtw_ieee80211_hdr_3addr);
+	u8 *frame_tail =3D frame + xframe->attrib.pktlen;
+	u8 category, action, OUI_Subtype;
+	u8 *ies =3D NULL;
+	uint ies_len_ori =3D 0;
+	uint ies_len =3D 0;
+
+	category =3D frame_body[0];
+	if (category =3D=3D RTW_WLAN_CATEGORY_PUBLIC) {
+		action =3D frame_body[1];
+		if (action =3D=3D ACT_PUBLIC_VENDOR
+		    && !memcmp(frame_body + 2, P2P_OUI, 4)
+		   ) {
