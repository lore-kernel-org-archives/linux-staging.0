+static u8 rtw_p2p_get_peer_ch_list(struct wifidirect_info *pwdinfo, u8 *ch=
_content, u8 ch_cnt, u8 *peer_ch_list)
+{
+	u8 i =3D 0, j =3D 0;
+	u8 temp =3D 0;
+	u8 ch_no =3D 0;
+	ch_content +=3D 3;
+	ch_cnt -=3D 3;
+
+	while (ch_cnt > 0) {
+		ch_content +=3D 1;
+		ch_cnt -=3D 1;
+		temp =3D *ch_content;
+		for (i =3D 0 ; i < temp ; i++, j++)
