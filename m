+static bool
+wordEnMatched(
+	PPGPKT_STRUCT	pTargetPkt,
+	PPGPKT_STRUCT	pCurPkt,
+	u8				*pWden
+)
+{
+	u8	match_word_en =3D 0x0F;	/* default all words are disabled */
+	u8	i;
+
+	/* check if the same words are enabled both target and current PG packet =
*/
+	if (((pTargetPkt->word_en & BIT0) =3D=3D 0) &&
+	    ((pCurPkt->word_en & BIT0) =3D=3D 0)) {
+		match_word_en &=3D ~BIT0;				/* enable word 0 */
+	}
+	if (((pTargetPkt->word_en & BIT1) =3D=3D 0) &&
+	    ((pCurPkt->word_en & BIT1) =3D=3D 0)) {
+		match_word_en &=3D ~BIT1;				/* enable word 1 */
+	}
+	if (((pTargetPkt->word_en & BIT2) =3D=3D 0) &&
+	    ((pCurPkt->word_en & BIT2) =3D=3D 0)) {
+		match_word_en &=3D ~BIT2;				/* enable word 2 */
+	}
+	if (((pTargetPkt->word_en & BIT3) =3D=3D 0) &&
+	    ((pCurPkt->word_en & BIT3) =3D=3D 0)) {
+		match_word_en &=3D ~BIT3;				/* enable word 3 */
+	}
+
+	*pWden =3D match_word_en;
+
+	if (match_word_en !=3D 0xf)
+		return true;
+	else
+		return false;
+}
