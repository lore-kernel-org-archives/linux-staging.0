dated rx_end to the caller */
+	/* after pulling, rx_end must be still larger than rx_data. */
+
+	if (precvframe =3D=3D NULL)
+		return NULL;
+
+	precvframe->u.hdr.rx_tail -=3D sz;
+
+	if (precvframe->u.hdr.rx_tail < precvframe->u.hdr.rx_data) {
+		precvframe->u.hdr.rx_tail +=3D sz;
+		return NULL;
+	}
+
