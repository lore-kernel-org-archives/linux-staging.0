+inline bool xmitframe_hiq_filter(struct xmit_frame *xmitframe)
+{
+	bool allow =3D false;
+	_adapter *adapter =3D xmitframe->padapter;
+	struct registry_priv *registry =3D &adapter->registrypriv;
+
+	if (rtw_get_intf_type(adapter) !=3D RTW_PCIE) {
+
+		if (adapter->registrypriv.wifi_spec =3D=3D 1)
+			allow =3D true;
+		else if (registry->hiq_filter =3D=3D RTW_HIQ_FILTER_ALLOW_SPECIAL) {
+
+			struct pkt_attrib *attrib =3D &xmitframe->attrib;
+
+			if (attrib->ether_type =3D=3D 0x0806
+			    || attrib->ether_type =3D=3D 0x888e
+#ifdef CONFIG_WAPI_SUPPORT
+			    || attrib->ether_type =3D=3D 0x88B4
+#endif
+			    || attrib->dhcp_pkt
+			   ) {
+				if (0)
+					RTW_INFO(FUNC_ADPT_FMT" ether_type:0x%04x%s\n", FUNC_ADPT_ARG(xmitfra=
me->padapter)
+						, attrib->ether_type, attrib->dhcp_pkt ? " DHCP" : "");
+				allow =3D true;
+			}
+		} else if (registry->hiq_filter =3D=3D RTW_HIQ_FILTER_ALLOW_ALL)
+			allow =3D true;
+		else if (registry->hiq_filter =3D=3D RTW_HIQ_FILTER_DENY_ALL) {
+		} else
+			rtw_warn_on(1);
+	}
+	return allow;
+}
