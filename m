+		data->phase2_method->reset(sm, data->phase2_priv);
+		data->phase2_method =3D NULL;
+		data->phase2_priv =3D NULL;
+	}
+	data->phase2_method =3D eap_server_get_eap_method(EAP_VENDOR_IETF,
+							eap_type);
