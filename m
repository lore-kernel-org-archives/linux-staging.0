+u32 mp_join(PADAPTER padapter, u8 mode)
+{
+	WLAN_BSSID_EX bssid;
+	struct sta_info *psta;
+	u32 length;
+	u8 val8, join_type;
+	unsigned long irqL;
+	s32 res =3D _SUCCESS;
+
+	struct mp_priv *pmppriv =3D &padapter->mppriv;
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+	struct wlan_network *tgt_network =3D &pmlmepriv->cur_network;
+	struct mlme_ext_priv	*pmlmeext =3D &padapter->mlmeextpriv;
+	struct mlme_ext_info	*pmlmeinfo =3D &(pmlmeext->mlmext_info);
+	WLAN_BSSID_EX		*pnetwork =3D (WLAN_BSSID_EX *)(&(pmlmeinfo->network));
+
+#ifdef CONFIG_IOCTL_CFG80211
+	struct wireless_dev *pwdev =3D padapter->rtw_wdev;
+#endif /* #ifdef CONFIG_IOCTL_CFG80211 */
+	/* 1. initialize a new WLAN_BSSID_EX */
+	memset(&bssid, 0, sizeof(WLAN_BSSID_EX));
+	RTW_INFO("%s ,pmppriv->network_macaddr=3D%x %x %x %x %x %x\n", __func__,
+		pmppriv->network_macaddr[0], pmppriv->network_macaddr[1], pmppriv->netwo=
rk_macaddr[2], pmppriv->network_macaddr[3], pmppriv->network_macaddr[4],
+		 pmppriv->network_macaddr[5]);
+	memcpy(bssid.MacAddress, pmppriv->network_macaddr, ETH_ALEN);
+
+	if (mode =3D=3D WIFI_FW_ADHOC_STATE) {
+		bssid.Ssid.SsidLength =3D strlen("mp_pseudo_adhoc");
+		memcpy(bssid.Ssid.Ssid, (u8 *)"mp_pseudo_adhoc", bssid.Ssid.SsidLength);
+		bssid.InfrastructureMode =3D Ndis802_11IBSS;
+		bssid.NetworkTypeInUse =3D Ndis802_11DS;
+		bssid.IELength =3D 0;
+		bssid.Configuration.DSConfig =3D pmppriv->channel;
+
+	} else if (mode =3D=3D WIFI_FW_STATION_STATE) {
+		bssid.Ssid.SsidLength =3D strlen("mp_pseudo_STATION");
+		memcpy(bssid.Ssid.Ssid, (u8 *)"mp_pseudo_STATION", bssid.Ssid.SsidLength=
);
+		bssid.InfrastructureMode =3D Ndis802_11Infrastructure;
+		bssid.NetworkTypeInUse =3D Ndis802_11DS;
+		bssid.IELength =3D 0;
+	}
+
+	length =3D get_WLAN_BSSID_EX_sz(&bssid);
+	if (length % 4)
+		bssid.Length =3D ((length >> 2) + 1) << 2; /* round up to multiple of 4 =
bytes. */
+	else
+		bssid.Length =3D length;
+
+	_enter_critical_bh(&pmlmepriv->lock, &irqL);
+
+	if (check_fwstate(pmlmepriv, WIFI_MP_STATE) =3D=3D true)
+		goto end_of_mp_start_test;
+
+	/* init mp_start_test status */
+	if (check_fwstate(pmlmepriv, _FW_LINKED) =3D=3D true) {
+		rtw_disassoc_cmd(padapter, 500, true);
+		rtw_indicate_disconnect(padapter, 0, false);
+		rtw_free_assoc_resources(padapter, 1);
+	}
+	pmppriv->prev_fw_state =3D get_fwstate(pmlmepriv);
+	/*pmlmepriv->fw_state =3D WIFI_MP_STATE;*/
+	init_fwstate(pmlmepriv, WIFI_MP_STATE);
+
+	set_fwstate(pmlmepriv, _FW_UNDER_LINKING);
+
+	/* 3 2. create a new psta for mp driver */
+	/* clear psta in the cur_network, if any */
+	psta =3D rtw_get_stainfo(&padapter->stapriv, tgt_network->network.MacAddr=
ess);
+	if (psta)
+		rtw_free_stainfo(padapter, psta);
+
+	psta =3D rtw_alloc_stainfo(&padapter->stapriv, bssid.MacAddress);
+	if (psta =3D=3D NULL) {
+		/*pmlmepriv->fw_state =3D pmppriv->prev_fw_state;*/
+		init_fwstate(pmlmepriv, pmppriv->prev_fw_state);
+		res =3D _FAIL;
+		goto end_of_mp_start_test;
+	}
+	if (mode =3D=3D WIFI_FW_ADHOC_STATE)
+	set_fwstate(pmlmepriv, WIFI_ADHOC_MASTER_STATE);
+	else
+		set_fwstate(pmlmepriv, WIFI_STATION_STATE);
+	/* 3 3. join psudo AdHoc */
+	tgt_network->join_res =3D 1;
+	tgt_network->aid =3D psta->aid =3D 1;
+
+	memcpy(&padapter->registrypriv.dev_network, &bssid, length);
+	rtw_update_registrypriv_dev_network(padapter);
+	memcpy(&tgt_network->network, &padapter->registrypriv.dev_network, padapt=
er->registrypriv.dev_network.Length);
+	memcpy(pnetwork, &padapter->registrypriv.dev_network, padapter->registryp=
riv.dev_network.Length);
+
+	rtw_indicate_connect(padapter);
+	_clr_fwstate_(pmlmepriv, _FW_UNDER_LINKING);
+	set_fwstate(pmlmepriv, _FW_LINKED);
+
+end_of_mp_start_test:
+
+	_exit_critical_bh(&pmlmepriv->lock, &irqL);
+
+	if (1) { /* (res =3D=3D _SUCCESS) */
+		/* set MSR to WIFI_FW_ADHOC_STATE */
+		if (mode =3D=3D WIFI_FW_ADHOC_STATE) {
+			/* set msr to WIFI_FW_ADHOC_STATE */
+			pmlmeinfo->state =3D WIFI_FW_ADHOC_STATE;
+			Set_MSR(padapter, (pmlmeinfo->state & 0x3));
+
+			rtw_hal_set_hwreg(padapter, HW_VAR_BSSID, padapter->registrypriv.dev_ne=
twork.MacAddress);
+			join_type =3D 0;
+			rtw_hal_set_hwreg(padapter, HW_VAR_MLME_JOIN, (u8 *)(&join_type));
+
+			report_join_res(padapter, 1);
+			pmlmeinfo->state |=3D WIFI_FW_ASSOC_SUCCESS;
+		} else {
+			Set_MSR(padapter, WIFI_FW_STATION_STATE);
+
+			RTW_INFO("%s , pmppriv->network_macaddr =3D%x %x %x %x %x %x\n", __func=
__,
+				pmppriv->network_macaddr[0], pmppriv->network_macaddr[1], pmppriv->net=
work_macaddr[2], pmppriv->network_macaddr[3], pmppriv->network_macaddr[4],
+				 pmppriv->network_macaddr[5]);
+
+			rtw_hal_set_hwreg(padapter, HW_VAR_BSSID, pmppriv->network_macaddr);
+		}
+	}
+
+	return res;
+}
+/* This function initializes the DUT to the MP test mode */
+s32 mp_start_test(PADAPTER padapter)
+{
+	struct mp_priv *pmppriv =3D &padapter->mppriv;
+	s32 res =3D _SUCCESS;
+
+	padapter->registrypriv.mp_mode =3D 1;
+
+	/* 3 disable dynamic mechanism */
+	disable_dm(padapter);
+	rtl8188e_InitHalDm(padapter);
+	/* 3 0. update mp_priv */
+
+	if (!RF_TYPE_VALID(padapter->registrypriv.rf_config)) {
+		/*		switch (phal->rf_type) { */
+		switch (GET_RF_TYPE(padapter)) {
+		case RF_1T1R:
+			pmppriv->antenna_tx =3D ANTENNA_A;
+			pmppriv->antenna_rx =3D ANTENNA_A;
+			break;
+		case RF_1T2R:
+		default:
+			pmppriv->antenna_tx =3D ANTENNA_A;
+			pmppriv->antenna_rx =3D ANTENNA_AB;
+			break;
+		case RF_2T2R:
+		case RF_2T2R_GREEN:
+			pmppriv->antenna_tx =3D ANTENNA_AB;
+			pmppriv->antenna_rx =3D ANTENNA_AB;
+			break;
+		case RF_2T4R:
+			pmppriv->antenna_tx =3D ANTENNA_AB;
+			pmppriv->antenna_rx =3D ANTENNA_ABCD;
+			break;
+		}
+	}
+
+	mpt_ProStartTest(padapter);
+
+	mp_join(padapter, WIFI_FW_ADHOC_STATE);
+
+	return res;
+}
+/* -----------------------------------------------------------------------=
-------
+ * This function change the DUT from the MP test mode into normal mode */
+void mp_stop_test(PADAPTER padapter)
+{
+	struct mp_priv *pmppriv =3D &padapter->mppriv;
+	struct mlme_priv *pmlmepriv =3D &padapter->mlmepriv;
+	struct wlan_network *tgt_network =3D &pmlmepriv->cur_network;
+	struct sta_info *psta;
+
+	unsigned long irqL;
+
+	if (pmppriv->mode =3D=3D MP_ON) {
+		pmppriv->bSetTxPower =3D 0;
+		_enter_critical_bh(&pmlmepriv->lock, &irqL);
+		if (check_fwstate(pmlmepriv, WIFI_MP_STATE) =3D=3D false)
+			goto end_of_mp_stop_test;
+
+		/* 3 1. disconnect psudo AdHoc */
+		rtw_indicate_disconnect(padapter, 0, false);
+
+		/* 3 2. clear psta used in mp test mode.
+		*	rtw_free_assoc_resources(padapter, 1); */
+		psta =3D rtw_get_stainfo(&padapter->stapriv, tgt_network->network.MacAdd=
ress);
+		if (psta)
+			rtw_free_stainfo(padapter, psta);
+
+		/* 3 3. return to normal state (default:station mode) */
+		/*pmlmepriv->fw_state =3D pmppriv->prev_fw_state; */ /* WIFI_STATION_STA=
TE;*/
+		init_fwstate(pmlmepriv, pmppriv->prev_fw_state);
+
+		/* flush the cur_network */
+		memset(tgt_network, 0, sizeof(struct wlan_network));
+
+		_clr_fwstate_(pmlmepriv, WIFI_MP_STATE);
+
+end_of_mp_stop_test:
+
+		_exit_critical_bh(&pmlmepriv->lock, &irqL);
+	}
