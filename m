+int eap_peer_vendor_test_register(void)
+{
+	struct eap_method *eap;
+	int ret;
+
+	eap =3D eap_peer_method_alloc(EAP_PEER_METHOD_INTERFACE_VERSION,
+				    EAP_VENDOR_ID, EAP_VENDOR_TYPE,
+				    "VENDOR-TEST");
+	if (eap =3D=3D NULL)
+		return -1;
+
+	eap->init =3D eap_vendor_test_init;
+	eap->deinit =3D eap_vendor_test_deinit;
+	eap->process =3D eap_vendor_test_process;
+	eap->isKeyAvailable =3D eap_vendor_test_isKeyAvailable;
+	eap->getKey =3D eap_vendor_test_getKey;
+
+	ret =3D eap_peer_method_register(eap);
+	if (ret)
+		eap_peer_method_free(eap);
+	return ret;
+}
