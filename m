UNT);
+	for (i =3D 0; i < request->n_channels && i < RTW_CHANNEL_SCAN_AMOUNT; i++=
) {
+		#ifdef CONFIG_DEBUG_CFG80211
+		RTW_INFO(FUNC_ADPT_FMT CHAN_FMT"\n", FUNC_ADPT_ARG(padapter), CHAN_ARG(r=
equest->channels[i]));
+		#endif
+		ch[i].hw_value =3D request->channels[i]->hw_value;
+		ch[i].flags =3D request->channels[i]->flags;
+	}
+
+	if (request->n_channels =3D=3D 1) {
+		for (i =3D 1; i < survey_times_for_one_ch; i++)
