+static bool phy_simularity_compare_8188e(
+	struct _ADAPTER	*p_adapter,
+	s32		result[][8],
+	u8		 c1,
+	u8		 c2
+)
+{
+	u32		i, j, diff, simularity_bit_map, bound;
+	HAL_DATA_TYPE	*p_hal_data =3D GET_HAL_DATA(p_adapter);
+	struct PHY_DM_STRUCT		*p_dm_odm =3D &p_hal_data->odmpriv;
+	u8		final_candidate[2] =3D {0xFF, 0xFF};	/* for path A and path B */
+	bool		is_result =3D true;
+	bool		is2T =3D IS_2T2R(p_hal_data->version_id);
+
+	if (is2T)
+		bound =3D 8;
+	else
+		bound =3D 4;
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("=3D=3D=3D> I=
QK:phy_simularity_compare_8188e c1 %d c2 %d!!!\n", c1, c2));
+
+	simularity_bit_map =3D 0;
+
+	for (i =3D 0; i < bound; i++) {
+		diff =3D (result[c1][i] > result[c2][i]) ? (result[c1][i] - result[c2][i=
]) : (result[c2][i] - result[c1][i]);
+		if (diff > MAX_TOLERANCE) {
+			ODM_RT_TRACE(p_dm_odm, ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("IQK:phy_si=
mularity_compare_8188e differnece overflow index %d compare1 0x%x compare2 =
0x%x!!!\n",  i, result[c1][i], result[c2][i]));
+
+			if ((i =3D=3D 2 || i =3D=3D 6) && !simularity_bit_map) {
+				if (result[c1][i] + result[c1][i + 1] =3D=3D 0)
+					final_candidate[(i / 4)] =3D c2;
+				else if (result[c2][i] + result[c2][i + 1] =3D=3D 0)
+					final_candidate[(i / 4)] =3D c1;
+				else
+					simularity_bit_map =3D simularity_bit_map | (1 << i);
+			} else
+				simularity_bit_map =3D simularity_bit_map | (1 << i);
+		}
+	}
+
+	ODM_RT_TRACE(p_dm_odm, ODM_COMP_CALIBRATION, ODM_DBG_LOUD, ("IQK:phy_simu=
larity_compare_8188e simularity_bit_map   %d !!!\n", simularity_bit_map));
+
+	if (simularity_bit_map =3D=3D 0) {
+		for (i =3D 0; i < (bound / 4); i++) {
+			if (final_candidate[i] !=3D 0xFF) {
+				for (j =3D i * 4; j < (i + 1) * 4 - 2; j++)
+					result[3][j] =3D result[final_candidate[i]][j];
+				is_result =3D false;
+			}
+		}
+		return is_result;
+	} else if (!(simularity_bit_map & 0x0F)) {		/* path A OK */
+		for (i =3D 0; i < 4; i++)
+			result[3][i] =3D result[c1][i];
+		return false;
+	} else if (!(simularity_bit_map & 0xF0) && is2T) {	/* path B OK */
+		for (i =3D 4; i < 8; i++)
+			result[3][i] =3D result[c1][i];
+		return false;
+	} else
+		return false;
+
+}
