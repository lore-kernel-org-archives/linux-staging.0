+static int rtw_test(
+	struct net_device *dev,
+	struct iw_request_info *info,
+	union iwreq_data *wrqu, char *extra)
+{
+	u32 len;
+	u8 *pbuf, *pch;
+	char *ptmp;
+	u8 *delim =3D ",";
+	PADAPTER padapter =3D rtw_netdev_priv(dev);
+
+
+	RTW_INFO("+%s\n", __func__);
+	len =3D wrqu->data.length;
+
+	pbuf =3D (u8 *)rtw_zmalloc(len);
+	if (pbuf =3D=3D NULL) {
+		RTW_INFO("%s: no memory!\n", __func__);
+		return -ENOMEM;
+	}
+
+	if (copy_from_user(pbuf, wrqu->data.pointer, len)) {
+		rtw_mfree(pbuf, len);
+		RTW_INFO("%s: copy from user fail!\n", __func__);
+		return -EFAULT;
+	}
+	RTW_INFO("%s: string=3D\"%s\"\n", __func__, pbuf);
+
+	ptmp =3D (char *)pbuf;
+	pch =3D strsep(&ptmp, delim);
+	if ((pch =3D=3D NULL) || (strlen(pch) =3D=3D 0)) {
+		rtw_mfree(pbuf, len);
+		RTW_INFO("%s: parameter error(level 1)!\n", __func__);
+		return -EFAULT;
+	}
+
+#ifdef CONFIG_MAC_LOOPBACK_DRIVER
+	if (strcmp(pch, "loopback") =3D=3D 0) {
+		s32 cnt =3D 0;
+		u32 size =3D 64;
+
+		pch =3D strsep(&ptmp, delim);
+		if ((pch =3D=3D NULL) || (strlen(pch) =3D=3D 0)) {
+			rtw_mfree(pbuf, len);
+			RTW_INFO("%s: parameter error(level 2)!\n", __func__);
+			return -EFAULT;
+		}
+
+		sscanf(pch, "%d", &cnt);
+		RTW_INFO("%s: loopback cnt=3D%d\n", __func__, cnt);
+
+		pch =3D strsep(&ptmp, delim);
+		if ((pch =3D=3D NULL) || (strlen(pch) =3D=3D 0)) {
+			rtw_mfree(pbuf, len);
+			RTW_INFO("%s: parameter error(level 2)!\n", __func__);
+			return -EFAULT;
+		}
+
+		sscanf(pch, "%d", &size);
+		RTW_INFO("%s: loopback size=3D%d\n", __func__, size);
+
+		loopbackTest(padapter, cnt, size, extra);
+		wrqu->data.length =3D strlen(extra) + 1;
+
+		goto free_buf;
+	}
+#endif
+
+
+#ifdef CONFIG_BT_COEXIST
+	if (strcmp(pch, "bton") =3D=3D 0) {
+		rtw_btcoex_SetManualControl(padapter, false);
+		goto free_buf;
+	} else if (strcmp(pch, "btoff") =3D=3D 0) {
+		rtw_btcoex_SetManualControl(padapter, true);
+		goto free_buf;
+	}
+#endif
+
+	if (strcmp(pch, "h2c") =3D=3D 0) {
+		u8 param[8];
+		u8 count =3D 0;
+		u32 tmp;
+		u8 i;
+		u32 pos;
+		u8 ret;
+
+		do {
+			pch =3D strsep(&ptmp, delim);
+			if ((pch =3D=3D NULL) || (strlen(pch) =3D=3D 0))
+				break;
+
+			sscanf(pch, "%x", &tmp);
+			param[count++] =3D (u8)tmp;
+		} while (count < 8);
+
+		if (count =3D=3D 0) {
+			rtw_mfree(pbuf, len);
+			RTW_INFO("%s: parameter error(level 2)!\n", __func__);
+			return -EFAULT;
+		}
+
+		ret =3D rtw_test_h2c_cmd(padapter, param, count);
+
+		pos =3D sprintf(extra, "H2C ID=3D0x%02x content=3D", param[0]);
+		for (i =3D 1; i < count; i++)
+			pos +=3D sprintf(extra + pos, "%02x,", param[i]);
+		extra[pos] =3D 0;
+		pos--;
+		pos +=3D sprintf(extra + pos, " %s", ret =3D=3D _FAIL ? "FAIL" : "OK");
+
+		wrqu->data.length =3D strlen(extra) + 1;
+
+		goto free_buf;
+	}
+
+free_buf:
+	rtw_mfree(pbuf, len);
+	return 0;
+}
