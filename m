+static void wpa_driver_test_scan_cmd(struct wpa_driver_test_data *drv,
+				     struct sockaddr *from,
+				     socklen_t fromlen,
+				     const u8 *data, size_t data_len)
+{
+	char buf[512], *pos, *end;
+	int ret;
+	struct test_driver_bss *bss;
+
+	bss =3D dl_list_first(&drv->bss, struct test_driver_bss, list);
+
+	/* data: optional [ STA-addr | ' ' | IEs(hex) ] */
+#ifdef CONFIG_P2P
+	if (drv->probe_req_report && drv->p2p && data_len) {
+		const char *d =3D (const char *) data;
+		u8 sa[ETH_ALEN];
+		u8 ie[512];
+		size_t ielen;
+
+		if (hwaddr_aton(d, sa))
+			return;
+		d +=3D 18;
+		while (*d =3D=3D ' ')
+			d++;
+		ielen =3D os_strlen(d) / 2;
+		if (ielen > sizeof(ie))
+			ielen =3D sizeof(ie);
+		if (hexstr2bin(d, ie, ielen) < 0)
+			ielen =3D 0;
+		drv->probe_from =3D from;
+		drv->probe_from_len =3D fromlen;
+		p2p_probe_req_rx(drv->p2p, sa, ie, ielen);
+		drv->probe_from =3D NULL;
+	}
+#endif /* CONFIG_P2P */
+
+	if (!drv->ibss)
+		return;
+
+	pos =3D buf;
+	end =3D buf + sizeof(buf);
+
+	/* reply: SCANRESP BSSID SSID IEs */
+	ret =3D snprintf(pos, end - pos, "SCANRESP " MACSTR " ",
+		       MAC2STR(bss->bssid));
+	if (ret < 0 || ret >=3D end - pos)
+		return;
+	pos +=3D ret;
+	pos +=3D wpa_snprintf_hex(pos, end - pos,
+				bss->ssid, bss->ssid_len);
+	ret =3D snprintf(pos, end - pos, " ");
+	if (ret < 0 || ret >=3D end - pos)
+		return;
+	pos +=3D ret;
+	pos +=3D wpa_snprintf_hex(pos, end - pos, drv->assoc_wpa_ie,
+				drv->assoc_wpa_ie_len);
+
+	if (bss->privacy) {
+		ret =3D snprintf(pos, end - pos, " PRIVACY");
+		if (ret < 0 || ret >=3D end - pos)
+			return;
+		pos +=3D ret;
+	}
+
+	ret =3D snprintf(pos, end - pos, " IBSS");
+	if (ret < 0 || ret >=3D end - pos)
+		return;
+	pos +=3D ret;
+
+	sendto(drv->test_socket, buf, pos - buf, 0,
+	       (struct sockaddr *) from, fromlen);
+}
