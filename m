+	else if (key_mgmt & WPA_KEY_MGMT_FT_PSK)
+		sm->wpa_key_mgmt =3D WPA_KEY_MGMT_FT_PSK;
+#endif /* CONFIG_IEEE80211R */
+#ifdef CONFIG_IEEE80211W
+	else if (key_mgmt & WPA_KEY_MGMT_IEEE8021X_SHA256)
+		sm->wpa_key_mgmt =3D WPA_KEY_MGMT_IEEE8021X_SHA256;
+	else if (key_mgmt & WPA_KEY_MGMT_PSK_SHA256)
+		sm->wpa_key_mgmt =3D WPA_KEY_MGMT_PSK_SHA256;
+#endif /* CONFIG_IEEE80211W */
+	else if (key_mgmt & WPA_KEY_MGMT_IEEE8021X)
+		sm->wpa_key_mgmt =3D WPA_KEY_MGMT_IEEE8021X;
+	else
+		sm->wpa_key_mgmt =3D WPA_KEY_MGMT_PSK;
+
+	if (version =3D=3D WPA_PROTO_RSN)
+		ciphers =3D data.pairwise_cipher & wpa_auth->conf.rsn_pairwise;
+	else
+		ciphers =3D data.pairwise_cipher & wpa_auth->conf.wpa_pairwise;
+	if (!ciphers) {
+		wpa_printf(MSG_DEBUG, "Invalid %s pairwise cipher (0x%x) "
+			   "from " MACSTR,
+			   version =3D=3D WPA_PROTO_RSN ? "RSN" : "WPA",
+			   data.pairwise_cipher, MAC2STR(sm->addr));
+		return WPA_INVALID_PAIRWISE;
+	}
+
+#ifdef CONFIG_IEEE80211W
+	if (wpa_auth->conf.ieee80211w =3D=3D MGMT_FRAME_PROTECTION_REQUIRED) {
+		if (!(data.capabilities & WPA_CAPABILITY_MFPC)) {
+			wpa_printf(MSG_DEBUG, "Management frame protection "
+				   "required, but client did not enable it");
+			return WPA_MGMT_FRAME_PROTECTION_VIOLATION;
+		}
+
+		if (ciphers & WPA_CIPHER_TKIP) {
+			wpa_printf(MSG_DEBUG, "Management frame protection "
+				   "cannot use TKIP");
+			return WPA_MGMT_FRAME_PROTECTION_VIOLATION;
+		}
+
+		if (data.mgmt_group_cipher !=3D WPA_CIPHER_AES_128_CMAC) {
+			wpa_printf(MSG_DEBUG, "Unsupported management group "
+				   "cipher %d", data.mgmt_group_cipher);
+			return WPA_INVALID_MGMT_GROUP_CIPHER;
+		}
+	}
+
+	if (wpa_auth->conf.ieee80211w =3D=3D NO_MGMT_FRAME_PROTECTION ||
+	    !(data.capabilities & WPA_CAPABILITY_MFPC))
+		sm->mgmt_frame_prot =3D 0;
+	else
+		sm->mgmt_frame_prot =3D 1;
+#endif /* CONFIG_IEEE80211W */
+
+#ifdef CONFIG_IEEE80211R
+	if (wpa_key_mgmt_ft(sm->wpa_key_mgmt)) {
+		if (mdie =3D=3D NULL || mdie_len < MOBILITY_DOMAIN_ID_LEN + 1) {
+			wpa_printf(MSG_DEBUG, "RSN: Trying to use FT, but "
+				   "MDIE not included");
+			return WPA_INVALID_MDIE;
+		}
+		if (os_memcmp(mdie, wpa_auth->conf.mobility_domain,
+			      MOBILITY_DOMAIN_ID_LEN) !=3D 0) {
+			wpa_hexdump(MSG_DEBUG, "RSN: Attempted to use unknown "
+				    "MDIE", mdie, MOBILITY_DOMAIN_ID_LEN);
+			return WPA_INVALID_MDIE;
+		}
+	}
+#endif /* CONFIG_IEEE80211R */
+
+	if (ciphers & WPA_CIPHER_CCMP)
+		sm->pairwise =3D WPA_CIPHER_CCMP;
+	else
+		sm->pairwise =3D WPA_CIPHER_TKIP;
+
+	/* TODO: clear WPA/WPA2 state if STA changes from one to another */
+	if (wpa_ie[0] =3D=3D WLAN_EID_RSN)
+		sm->wpa =3D WPA_VERSION_WPA2;
+	else
+		sm->wpa =3D WPA_VERSION_WPA;
+
+	sm->pmksa =3D NULL;
+	for (i =3D 0; i < data.num_pmkid; i++) {
+		wpa_hexdump(MSG_DEBUG, "RSN IE: STA PMKID",
+			    &data.pmkid[i * PMKID_LEN], PMKID_LEN);
+		sm->pmksa =3D pmksa_cache_auth_get(wpa_auth->pmksa, sm->addr,
+						 &data.pmkid[i * PMKID_LEN]);
+		if (sm->pmksa) {
+			pmkid =3D sm->pmksa->pmkid;
+			break;
+		}
+	}
+	for (i =3D 0; sm->pmksa =3D=3D NULL && wpa_auth->conf.okc &&
+		     i < data.num_pmkid; i++) {
+		struct wpa_auth_okc_iter_data idata;
+		idata.pmksa =3D NULL;
+		idata.aa =3D wpa_auth->addr;
+		idata.spa =3D sm->addr;
+		idata.pmkid =3D &data.pmkid[i * PMKID_LEN];
+		wpa_auth_for_each_auth(wpa_auth, wpa_auth_okc_iter, &idata);
+		if (idata.pmksa) {
+			wpa_auth_vlogger(wpa_auth, sm->addr, LOGGER_DEBUG,
+					 "OKC match for PMKID");
+			sm->pmksa =3D pmksa_cache_add_okc(wpa_auth->pmksa,
+							idata.pmksa,
+							wpa_auth->addr,
+							idata.pmkid);
+			pmkid =3D idata.pmkid;
+			break;
+		}
+	}
+	if (sm->pmksa) {
+		wpa_auth_vlogger(wpa_auth, sm->addr, LOGGER_DEBUG,
+				 "PMKID found from PMKSA cache "
+				 "eap_type=3D%d vlan_id=3D%d",
+				 sm->pmksa->eap_type_authsrv,
+				 sm->pmksa->vlan_id);
+		os_memcpy(wpa_auth->dot11RSNAPMKIDUsed, pmkid, PMKID_LEN);
+	}
+
+	if (sm->wpa_ie =3D=3D NULL || sm->wpa_ie_len < wpa_ie_len) {
+		os_free(sm->wpa_ie);
+		sm->wpa_ie =3D os_malloc(wpa_ie_len);
+		if (sm->wpa_ie =3D=3D NULL)
+			return WPA_ALLOC_FAIL;
+	}
+	os_memcpy(sm->wpa_ie, wpa_ie, wpa_ie_len);
+	sm->wpa_ie_len =3D wpa_ie_len;
+
+	return WPA_IE_OK;
+}
+
+
+/**
+ * wpa_parse_generic - Parse EAPOL-Key Key Data Generic IEs
+ * @pos: Pointer to the IE header
+ * @end: Pointer to the end of the Key Data buffer
+ * @ie: Pointer to parsed IE data
+ * Returns: 0 on success, 1 if end mark is found, -1 on failure
+ */
+static int wpa_parse_generic(const u8 *pos, const u8 *end,
+			     struct wpa_eapol_ie_parse *ie)
+{
+	if (pos[1] =3D=3D 0)
+		return 1;
+
+	if (pos[1] >=3D 6 &&
+	    RSN_SELECTOR_GET(pos + 2) =3D=3D WPA_OUI_TYPE &&
+	    pos[2 + WPA_SELECTOR_LEN] =3D=3D 1 &&
+	    pos[2 + WPA_SELECTOR_LEN + 1] =3D=3D 0) {
+		ie->wpa_ie =3D pos;
+		ie->wpa_ie_len =3D pos[1] + 2;
+		return 0;
+	}
+
+	if (pos + 1 + RSN_SELECTOR_LEN < end &&
+	    pos[1] >=3D RSN_SELECTOR_LEN + PMKID_LEN &&
+	    RSN_SELECTOR_GET(pos + 2) =3D=3D RSN_KEY_DATA_PMKID) {
+		ie->pmkid =3D pos + 2 + RSN_SELECTOR_LEN;
+		return 0;
+	}
+
+	if (pos[1] > RSN_SELECTOR_LEN + 2 &&
+	    RSN_SELECTOR_GET(pos + 2) =3D=3D RSN_KEY_DATA_GROUPKEY) {
+		ie->gtk =3D pos + 2 + RSN_SELECTOR_LEN;
+		ie->gtk_len =3D pos[1] - RSN_SELECTOR_LEN;
+		return 0;
+	}
+
+	if (pos[1] > RSN_SELECTOR_LEN + 2 &&
+	    RSN_SELECTOR_GET(pos + 2) =3D=3D RSN_KEY_DATA_MAC_ADDR) {
+		ie->mac_addr =3D pos + 2 + RSN_SELECTOR_LEN;
+		ie->mac_addr_len =3D pos[1] - RSN_SELECTOR_LEN;
+		return 0;
+	}
+
+#ifdef CONFIG_PEERKEY
+	if (pos[1] > RSN_SELECTOR_LEN + 2 &&
+	    RSN_SELECTOR_GET(pos + 2) =3D=3D RSN_KEY_DATA_SMK) {
+		ie->smk =3D pos + 2 + RSN_SELECTOR_LEN;
+		ie->smk_len =3D pos[1] - RSN_SELECTOR_LEN;
+		return 0;
+	}
+
+	if (pos[1] > RSN_SELECTOR_LEN + 2 &&
+	    RSN_SELECTOR_GET(pos + 2) =3D=3D RSN_KEY_DATA_NONCE) {
+		ie->nonce =3D pos + 2 + RSN_SELECTOR_LEN;
+		ie->nonce_len =3D pos[1] - RSN_SELECTOR_LEN;
+		return 0;
+	}
+
+	if (pos[1] > RSN_SELECTOR_LEN + 2 &&
+	    RSN_SELECTOR_GET(pos + 2) =3D=3D RSN_KEY_DATA_LIFETIME) {
+		ie->lifetime =3D pos + 2 + RSN_SELECTOR_LEN;
+		ie->lifetime_len =3D pos[1] - RSN_SELECTOR_LEN;
+		return 0;
+	}
+
+	if (pos[1] > RSN_SELECTOR_LEN + 2 &&
+	    RSN_SELECTOR_GET(pos + 2) =3D=3D RSN_KEY_DATA_ERROR) {
+		ie->error =3D pos + 2 + RSN_SELECTOR_LEN;
+		ie->error_len =3D pos[1] - RSN_SELECTOR_LEN;
+		return 0;
+	}
+#endif /* CONFIG_PEERKEY */
+
+#ifdef CONFIG_IEEE80211W
+	if (pos[1] > RSN_SELECTOR_LEN + 2 &&
+	    RSN_SELECTOR_GET(pos + 2) =3D=3D RSN_KEY_DATA_IGTK) {
+		ie->igtk =3D pos + 2 + RSN_SELECTOR_LEN;
+		ie->igtk_len =3D pos[1] - RSN_SELECTOR_LEN;
+		return 0;
+	}
+#endif /* CONFIG_IEEE80211W */
+
+	return 0;
+}
+
+
+/**
+ * wpa_parse_kde_ies - Parse EAPOL-Key Key Data IEs
+ * @buf: Pointer to the Key Data buffer
+ * @len: Key Data Length
+ * @ie: Pointer to parsed IE data
+ * Returns: 0 on success, -1 on failure
+ */
+int wpa_parse_kde_ies(const u8 *buf, size_t len, struct wpa_eapol_ie_parse=
 *ie)
+{
+	const u8 *pos, *end;
+	int ret =3D 0;
+
+	os_memset(ie, 0, sizeof(*ie));
+	for (pos =3D buf, end =3D pos + len; pos + 1 < end; pos +=3D 2 + pos[1]) {
+		if (pos[0] =3D=3D 0xdd &&
+		    ((pos =3D=3D buf + len - 1) || pos[1] =3D=3D 0)) {
+			/* Ignore padding */
+			break;
+		}
+		if (pos + 2 + pos[1] > end) {
+			wpa_printf(MSG_DEBUG, "WPA: EAPOL-Key Key Data "
+				   "underflow (ie=3D%d len=3D%d pos=3D%d)",
+				   pos[0], pos[1], (int) (pos - buf));
+			wpa_hexdump_key(MSG_DEBUG, "WPA: Key Data",
+					buf, len);
+			ret =3D -1;
+			break;
+		}
+		if (*pos =3D=3D WLAN_EID_RSN) {
+			ie->rsn_ie =3D pos;
+			ie->rsn_ie_len =3D pos[1] + 2;
+#ifdef CONFIG_IEEE80211R
+		} else if (*pos =3D=3D WLAN_EID_MOBILITY_DOMAIN) {
+			ie->mdie =3D pos;
+			ie->mdie_len =3D pos[1] + 2;
+		} else if (*pos =3D=3D WLAN_EID_FAST_BSS_TRANSITION) {
+			ie->ftie =3D pos;
+			ie->ftie_len =3D pos[1] + 2;
+#endif /* CONFIG_IEEE80211R */
+		} else if (*pos =3D=3D WLAN_EID_VENDOR_SPECIFIC) {
+			ret =3D wpa_parse_generic(pos, end, ie);
+			if (ret < 0)
+				break;
+			if (ret > 0) {
+				ret =3D 0;
+				break;
+			}
+		} else {
+			wpa_hexdump(MSG_DEBUG, "WPA: Unrecognized EAPOL-Key "
+				    "Key Data IE", pos, 2 + pos[1]);
+		}
+	}
+
+	return ret;
+}
+
+
+int wpa_auth_uses_mfp(struct wpa_state_machine *sm)
+{
+	return sm ? sm->mgmt_frame_prot : 0;
+}
