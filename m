+/* We process buffered data for 1. U-APSD, 2. ch. switch, 3. U-APSD + ch. =
switch here */
+int On_TDLS_Peer_Traffic_Rsp(_adapter *padapter, union recv_frame *precv_f=
rame)
+{
+	struct tdls_info *ptdlsinfo =3D &padapter->tdlsinfo;
+	struct mlme_ext_priv *pmlmeext =3D &padapter->mlmeextpriv;
+	struct rx_pkt_attrib	*pattrib =3D &precv_frame->u.hdr.attrib;
+	struct sta_priv *pstapriv =3D &padapter->stapriv;
+	struct sta_info *ptdls_sta =3D rtw_get_stainfo(pstapriv, pattrib->src);
+	u8 wmmps_ac =3D 0;
+	/* u8 state=3DTDLS_check_ch_state(ptdls_sta->tdls_sta_state); */
+	int i;
+
+	ptdls_sta->sta_stats.rx_data_pkts++;
+
+	ptdls_sta->tdls_sta_state &=3D ~(TDLS_WAIT_PTR_STATE);
+
+	/* Check 4-AC queue bit */
+	if (ptdls_sta->uapsd_vo || ptdls_sta->uapsd_vi || ptdls_sta->uapsd_be || =
ptdls_sta->uapsd_bk)
+		wmmps_ac =3D 1;
+
+	/* If it's a direct link and have buffered frame */
+	if (ptdls_sta->tdls_sta_state & TDLS_LINKED_STATE) {
+		if (wmmps_ac) {
+			unsigned long irqL;
+			_list	*xmitframe_plist, *xmitframe_phead;
+			struct xmit_frame *pxmitframe =3D NULL;
+
+			_enter_critical_bh(&ptdls_sta->sleep_q.lock, &irqL);
+
+			xmitframe_phead =3D get_list_head(&ptdls_sta->sleep_q);
+			xmitframe_plist =3D get_next(xmitframe_phead);
+
+			/* transmit buffered frames */
+			while (rtw_end_of_queue_search(xmitframe_phead, xmitframe_plist) =3D=3D=
 false) {
+				pxmitframe =3D LIST_CONTAINOR(xmitframe_plist, struct xmit_frame, list=
);
+				xmitframe_plist =3D get_next(xmitframe_plist);
+				list_del_init(&pxmitframe->list);
+
+				ptdls_sta->sleepq_len--;
+				ptdls_sta->sleepq_ac_len--;
+				if (ptdls_sta->sleepq_len > 0) {
+					pxmitframe->attrib.mdata =3D 1;
+					pxmitframe->attrib.eosp =3D 0;
+				} else {
+					pxmitframe->attrib.mdata =3D 0;
+					pxmitframe->attrib.eosp =3D 1;
+				}
+				pxmitframe->attrib.triggered =3D 1;
+
+				rtw_hal_xmitframe_enqueue(padapter, pxmitframe);
+			}
+
+			if (ptdls_sta->sleepq_len =3D=3D 0)
+				RTW_INFO("no buffered packets for tdls to xmit\n");
+			else {
+				RTW_INFO("error!psta->sleepq_len=3D%d\n", ptdls_sta->sleepq_len);
+				ptdls_sta->sleepq_len =3D 0;
+			}
+
+			_exit_critical_bh(&ptdls_sta->sleep_q.lock, &irqL);
+
+		}
+
+	}
+
+	return _SUCCESS;
+}
