+/* any station allocated can be searched by hash list */
+struct sta_info *rtw_get_stainfo(struct sta_priv *pstapriv, u8 *hwaddr)
+{
+
+	unsigned long	 irqL;
+
+	_list	*plist, *phead;
+
+	struct sta_info *psta =3D NULL;
+
+	u32	index;
+
+	u8 *addr;
+
+	u8 bc_addr[ETH_ALEN] =3D {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+
+
+	if (hwaddr =3D=3D NULL)
+		return NULL;
+
+	if (IS_MCAST(hwaddr))
+		addr =3D bc_addr;
+	else
+		addr =3D hwaddr;
+
+	index =3D wifi_mac_hash(addr);
+
+	_enter_critical_bh(&pstapriv->sta_hash_lock, &irqL);
+
+	phead =3D &(pstapriv->sta_hash[index]);
+	plist =3D get_next(phead);
+
+
+	while ((rtw_end_of_queue_search(phead, plist)) =3D=3D false) {
+
+		psta =3D LIST_CONTAINOR(plist, struct sta_info, hash_list);
+
+		if ((!memcmp(psta->hwaddr, addr, ETH_ALEN)) =3D=3D true) {
+			/* if found the matched address */
+			break;
+		}
+		psta =3D NULL;
+		plist =3D get_next(plist);
+	}
+
+	_exit_critical_bh(&pstapriv->sta_hash_lock, &irqL);
+	return psta;
+
+}
