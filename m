+static struct wpabuf * get_x509_cert(X509 *cert)
+{
+	struct wpabuf *buf;
+	u8 *tmp;
+
+	int cert_len =3D i2d_X509(cert, NULL);
+	if (cert_len <=3D 0)
+		return NULL;
+
+	buf =3D wpabuf_alloc(cert_len);
+	if (buf =3D=3D NULL)
+		return NULL;
+
+	tmp =3D wpabuf_put(buf, cert_len);
+	i2d_X509(cert, &tmp);
+	return buf;
+}
